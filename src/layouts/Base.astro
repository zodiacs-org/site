---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/prose.css';
import '../styles/kit.css';
import ArticleContents from '../components/ArticleContents.astro';
import SEO from '../components/SEO.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SourcesLine, { type SourceLink } from '../components/SourcesLine.astro';
import EditorialLine from '../components/EditorialLine.astro';
import GlassDefs from '../components/GlassDefs.astro';
import EditionFreshnessGuard from '../components/EditionFreshnessGuard.astro';
import { ANALYTICS_EVENT_PROPS, ANALYTICS_EVENT_VALUES } from '../lib/analytics';
import { hasDailyChartEmailProvider } from '../lib/email/daily-config';
import { BRAND_ICON_PATHS } from '../lib/brand-icons.mjs';
import { LOCALE_META, UI, normalizeCatalogLocale, t, type CatalogLocale as Locale } from '../lib/i18n';
import { RUSSIAN_RUNTIME } from '../lib/i18n/ru-runtime/server';
import AccountProfileAccessBootstrap from '../islands/AccountProfileAccessBootstrap';
import { accountSyncV2Enabled as isAccountSyncV2Enabled } from '../lib/account-v2/feature-flags';
import { ACCOUNT_V2_PROFILE_ACCESS_KEY } from '../lib/account-v2/profile-access';
import { GUIDE_PRIVATE_SESSION_KEY } from '../lib/assistant/guide-loader.mjs';
import { webAnalyticsEnabled as vercelWebAnalyticsFlag } from '../lib/web-analytics.mjs';
import { calculatorToolForPath } from '../lib/webmcp/calculator-tools';
import {
  ACCOUNT_V2_LOCAL_OWNER_KEY,
  ACCOUNT_V2_RETAINED_OWNER_KEY,
} from '../lib/account-v2/storage-identity';

interface Props {
  title: string;
  description: string;
  path: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** Keep the editorial disclosure visible on curated collection pages. */
  editorialLine?: boolean;
  noindex?: boolean;
  /** Pair with noindex for routes that must not pass discovery onward. */
  nofollow?: boolean;
  /** Keep privacy-bounded analytics on a public noindex campaign surface. */
  analyticsOnNoindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  locale?: Locale;
  sources?: SourceLink[];
  /** Optional route-specific RSS autodiscovery in addition to the global feeds. */
  rssFeed?: { href: string; title: string };
  /** Include the liquid-glass lens defs so `.btn--glass` refracts on Chromium. */
  glass?: boolean;
  /** Embed this page's one-locale UI catalog before hydrating client islands. */
  clientUi?: boolean;
  /** Inline this route's emitted CSS at postbuild for latency-sensitive entry pages. */
  inlineCriticalCss?: boolean;
  /** Use optional font aliases so a cold font can never shift this page. */
  stableTypography?: boolean;
  /** Use metric-matched local faces for route content. */
  localTypography?: boolean;
  /** Keep shared chrome faces optional when nonessential font preloads are omitted. */
  stableChromeTypography?: boolean;
  /** Keep shared chrome on the local tier and omit font preloads for a cold-load gate. */
  localChromeTypography?: boolean;
  /** Keep non-LCP chrome preloads desktop-only so mobile can paint without a font race. */
  minimalNavFontPreloads?: boolean;
  /** Discover the existing mono face before CSS on routes with above-fold data text. */
  preloadMonoFont?: boolean;
  /** UTC edition rendered by a daily surface; relative wording is enabled only while current. */
  editionDate?: string;
  /** Suppress third-party runtime scripts on pages handling private account data. */
  privateSurface?: boolean;
  /**
   * Do not register the PWA worker on this route.
   *
   * For a surface that must be able to say it stores nothing: the worker's
   * install precaches the app shell into Cache Storage, which is storage,
   * and it fires a burst of same-origin requests the route never asked
   * for. Set only where that claim is made and tested.
   */
  noServiceWorker?: boolean;
  /**
   * Do not load the Guide assistant on this route.
   *
   * The footer's inline loader fetches the assistant shell half a second
   * after `load`, on every page, and the mounted widget can send typed
   * text to the server. On a surface whose whole claim is that nothing
   * entered there goes anywhere, an inherited same-origin component that
   * CAN transmit is not made harmless by being off by default. This also
   * drops the footer's Guide button, which without the loader would be a
   * control that does nothing, and the WebMCP registration, which hands a
   * browser agent a tool from the same route. Set only where that claim
   * is made and tested; the footer itself stays.
   */
  noAssistant?: boolean;
  /** Render the Terminal-only market and venue boundary in the shared footer. */
  terminalMarketNotice?: boolean;
}

const props = Astro.props;
const locale = normalizeCatalogLocale(props.locale);
// WebMCP (Track A2): Search on English pages, and on a calculator page, in every locale, the page's own tool.
const webMcpSearch = locale === 'en';
const webMcpCalculator = calculatorToolForPath(Astro.url.pathname) !== null;
// The daily-sky feed is English; its link title is localized so feed readers list it in the page's language.
const FEED_TITLES: Record<typeof locale, { sky: string; horoscopes: string; almanac: string }> = {
  en: { sky: 'Zodiacs.org | the sky, daily', horoscopes: 'Zodiacs.org daily horoscopes', almanac: 'The Zodiacs.org Almanac' },
  es: { sky: 'Zodiacs.org | el cielo, cada día (en inglés)', horoscopes: 'Horóscopos diarios de Zodiacs.org (en inglés)', almanac: 'Almanaque de Zodiacs.org (en inglés)' },
  pt: { sky: 'Zodiacs.org | o céu, todo dia (em inglês)', horoscopes: 'Horóscopos diários do Zodiacs.org (em inglês)', almanac: 'Almanaque do Zodiacs.org (em inglês)' },
  fr: { sky: 'Zodiacs.org | le ciel, chaque jour (en anglais)', horoscopes: 'Horoscopes quotidiens de Zodiacs.org (en anglais)', almanac: 'Almanach de Zodiacs.org (en anglais)' },
  it: { sky: 'Zodiacs.org | il cielo, ogni giorno (in inglese)', horoscopes: 'Oroscopi quotidiani di Zodiacs.org (in inglese)', almanac: 'Almanacco di Zodiacs.org (in inglese)' },
  ru: { sky: 'Zodiacs.org | небо каждый день (по-английски)', horoscopes: 'Ежедневные гороскопы Zodiacs.org (по-английски)', almanac: 'Альманах Zodiacs.org (по-английски)' },
};
const clientUi = props.clientUi ? UI[locale] : null;
const russianRuntime = props.clientUi && locale === 'ru' ? RUSSIAN_RUNTIME : null;
const plausibleScriptUrl = import.meta.env.PUBLIC_PLAUSIBLE_SCRIPT_URL?.trim();
const plausibleEndpoint = import.meta.env.PUBLIC_PLAUSIBLE_ENDPOINT?.trim() ?? '';
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN?.trim() ?? '';
const accountSyncV2Enabled = isAccountSyncV2Enabled({
  PUBLIC_ACCOUNT_SYNC_V2_ENABLED: process.env.PUBLIC_ACCOUNT_SYNC_V2_ENABLED,
  PUBLIC_ACCOUNT_SYNC_V2_PREVIEW_ACK: process.env.PUBLIC_ACCOUNT_SYNC_V2_PREVIEW_ACK,
});
const plausibleEnabled = Boolean(
  plausibleScriptUrl && (!props.noindex || props.analyticsOnNoindex) && !props.privateSurface
  && !accountSyncV2Enabled,
);
const webAnalyticsEnabled = Boolean(
  vercelWebAnalyticsFlag(import.meta.env) && (!props.noindex || props.analyticsOnNoindex) && !props.privateSurface
  && !accountSyncV2Enabled,
);
const dailyEmailLifecycleEnabled = hasDailyChartEmailProvider(process.env);
const rtlDocumentDirection = (direction: 'ltr' | 'rtl') => direction === 'rtl' ? direction : undefined;

---
<!doctype html>
<html
  lang={LOCALE_META[locale].htmlLang}
  dir={rtlDocumentDirection(LOCALE_META[locale].dir)}
  data-edition-date={props.editionDate || undefined}
  data-inline-critical-css={props.inlineCriticalCss ? '' : undefined}
  data-no-service-worker={props.noServiceWorker ? '' : undefined}
  data-stable-typography={props.stableTypography ? '' : undefined}
  data-local-typography={props.localTypography ? '' : undefined}
  data-stable-chrome-typography={props.stableChromeTypography ? '' : undefined}
  data-local-chrome-typography={props.localChromeTypography ? '' : undefined}
  data-daily-email-lifecycle={dailyEmailLifecycleEnabled ? '' : undefined}
  data-account-sync-v2={accountSyncV2Enabled ? '' : undefined}
  data-guide-analytics-boundary={plausibleEnabled || webAnalyticsEnabled ? '' : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#060709" />
    <meta name="color-scheme" content="dark" />
    {accountSyncV2Enabled && (
      <script is:inline define:vars={{
        profileAccessKey: ACCOUNT_V2_PROFILE_ACCESS_KEY,
        profileOwnerKey: ACCOUNT_V2_LOCAL_OWNER_KEY,
        profileRetainedOwnerKey: ACCOUNT_V2_RETAINED_OWNER_KEY,
      }}>
        /* A full navigation always starts locked. The auth bootstrap below
           re-grants this tab only after it verifies signed-out or matching-owner state. */
        try { sessionStorage.removeItem(profileAccessKey); } catch (error) {}
        var profileAccountId = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
        var exactProfileRecord = function (value, expectedLength) {
          return Boolean(value && typeof value === 'object' && !Array.isArray(value)
            && Object.keys(value).length === expectedLength);
        };
        var profileLeaseActive = false;
        window.zodiacsProfileAccess = Object.freeze({
          activateLease: function () { profileLeaseActive = true; },
          revokeLease: function () { profileLeaseActive = false; },
          canRead: function () {
            try {
              if (!profileLeaseActive) return false;
              var grant = JSON.parse(sessionStorage.getItem(profileAccessKey) || 'null');
              var ownerRaw = localStorage.getItem(profileOwnerKey);
              var retainedRaw = localStorage.getItem(profileRetainedOwnerKey);
              if (exactProfileRecord(grant, 2)
                && grant.version === 1 && grant.mode === 'unowned') {
                return ownerRaw === null && retainedRaw === null;
              }
              if (!exactProfileRecord(grant, 3) || grant.version !== 1
                || !profileAccountId.test(grant.accountId)) return false;
              var owner = JSON.parse(ownerRaw || 'null');
              if (!exactProfileRecord(owner, 2) || owner.version !== 1
                || !profileAccountId.test(owner.accountId)
                || owner.accountId !== grant.accountId) return false;
              if (grant.mode === 'account') return true;
              if (grant.mode !== 'retained') return false;
              var retained = JSON.parse(retainedRaw || 'null');
              return Boolean(exactProfileRecord(retained, 2) && retained.version === 1
                && profileAccountId.test(retained.accountId)
                && retained.accountId === grant.accountId);
            } catch (error) { return false; }
          }
        });
      </script>
    )}
    <script is:inline>
      /* Chromium paints SVG url() backdrop filters; Safari reports support but
         renders nothing. Mark Chromium so the glass lens applies only there —
         Safari/iOS keep the frosted -webkit-backdrop-filter blur floor instead
         of a flat, transparent capsule. Runs in <head> so there's no flash. */
      try {
        if (window.chrome && window.CSS && CSS.supports('backdrop-filter', "url('#zdx-lens-cta')")) {
          document.documentElement.classList.add('zdx-lens');
        }
      } catch (e) {}
    </script>
    {props.editionDate && <EditionFreshnessGuard editionDate={props.editionDate} locale={locale} />}
    <script is:inline>
      // The footer's stylesheet loads late (see the loader after the footer).
      // Hold the footer hidden from its first layout until the loader decides:
      // one in or near the first viewport waits for its styles, so it never
      // paints unstyled and then moves; any other is shown at once.
      document.documentElement.setAttribute('data-footer-styles-pending', '');
    </script>
    <script is:inline>
      // Capture Chromium's one-shot install event before calculator islands
      // hydrate. The prompt itself stays hidden until two successful charts.
      window.addEventListener('beforeinstallprompt', function (event) {
        event.preventDefault();
        window.zodiacsInstallPrompt = event;
        window.dispatchEvent(new Event('zodiacs:install-prompt-ready'));
      });
    </script>
    <link rel="icon" type="image/svg+xml" sizes="any" href={BRAND_ICON_PATHS.faviconSvg} />
    <link rel="icon" type="image/png" sizes="16x16" href={BRAND_ICON_PATHS.favicon16} />
    <link rel="icon" type="image/png" sizes="32x32" href={BRAND_ICON_PATHS.favicon32} />
    <link rel="icon" type="image/png" sizes="96x96" href={BRAND_ICON_PATHS.favicon} />
    <link rel="apple-touch-icon" sizes="180x180" href={BRAND_ICON_PATHS.appleTouch} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={FEED_TITLES[locale].sky} href="/feeds/daily-sky.xml" />
    <link rel="alternate" type="application/rss+xml" title={FEED_TITLES[locale].horoscopes} href="/feeds/horoscopes.xml" />
    <link rel="alternate" type="application/rss+xml" title={FEED_TITLES[locale].almanac} href="/feeds/almanac.xml" />
    {props.rssFeed && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={props.rssFeed.title}
        href={props.rssFeed.href}
      />
    )}
    {locale === 'ru' ? (
      !props.localChromeTypography && <>
        <link rel="preload" href="/fonts/golos-text-cyr-a.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/golos-text-cyr-b.woff2" as="font" type="font/woff2" crossorigin />
        {props.path !== '/ru/' && (
          <link rel="preload" href="/fonts/eb-garamond-cyrillic-500-normal.woff2" as="font" type="font/woff2" crossorigin />
        )}
      </>
    ) : (
      !props.localChromeTypography && <>
        {(!props.minimalNavFontPreloads || props.stableChromeTypography) && (
          <link
            rel="preload"
            href="/fonts/instrument-sans-latin-wght-normal.woff2"
            as="font"
            type="font/woff2"
            crossorigin
            media={props.minimalNavFontPreloads ? '(min-width: 782px)' : undefined}
          />
        )}
        <link
          rel="preload"
          href="/fonts/eb-garamond-latin-400-normal.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
        {(!props.minimalNavFontPreloads || props.stableChromeTypography) && (
          <link
            rel="preload"
            href="/fonts/eb-garamond-latin-500-normal.woff2"
            as="font"
            type="font/woff2"
            crossorigin
            media={props.minimalNavFontPreloads ? '(min-width: 782px)' : undefined}
          />
        )}
        {(props.preloadMonoFont || (props.minimalNavFontPreloads && props.stableChromeTypography)) && (
          <link
            rel="preload"
            href="/fonts/jetbrains-mono-latin-wght-normal.woff2"
            as="font"
            type="font/woff2"
            crossorigin
            media={props.preloadMonoFont ? undefined : '(min-width: 782px)'}
          />
        )}
      </>
    )}
    <!-- Most routes let CSS discover the mono metadata face. Today keeps its
         preload desktop-only; People profiles opt in at every width because
         late font discovery extends their measured first-render path. -->
    <SEO {...props} />
    {(webMcpSearch || webMcpCalculator) && !props.noAssistant && (
      <script is:inline define:vars={{ webMcpSearch }}>
        (function () {
          var context = document.modelContext || Reflect.get(navigator, 'modelContext');
          if (!context || typeof context.registerTool !== 'function') return;
          // The bundle registers Search and the calculator tools; bypass the previous immutable URL.
          import('/assets/webmcp-register.js?v=calculators-1')
            .then(function (module) {
              return module.registerWebMcpPage(context, { path: location.pathname, search: webMcpSearch });
            })
            .catch(function () {});
        })();
      </script>
    )}
    <script is:inline>window.zodiacsAnalytics = window.zodiacsAnalytics || Object.freeze({ track: function () {} });
      // Links from the Zodiacs app in an assistant carry ?ref=chatgpt or ?ref=assistant. Note which,
      // then take it out of the address so it is not copied into links people share.
      (function () {
        try {
          var url = new URL(location.href);
          var ref = url.searchParams.get('ref');
          if (ref === null) return;
          window.zodiacsArrival = ref === 'chatgpt' || ref === 'assistant' ? ref : null;
          url.searchParams.delete('ref');
          history.replaceState(history.state, '', url.pathname + url.search + url.hash);
        } catch (error) {}
      })();
    </script>
    {plausibleEnabled && (
      <>
        <script is:inline define:vars={{
          plausibleScriptUrl,
          plausibleEndpoint,
          plausibleDomain,
          guidePrivateSessionKey: GUIDE_PRIVATE_SESSION_KEY,
          analyticsEventProps: ANALYTICS_EVENT_PROPS,
          analyticsEventValues: ANALYTICS_EVENT_VALUES,
        }}>
          (function () {
            try {
              if (sessionStorage.getItem(guidePrivateSessionKey) === '1') return;
            } catch (error) {}

            window.plausible = window.plausible || function () {
              (window.plausible.q = window.plausible.q || []).push(arguments);
            };
            window.plausible.init = window.plausible.init || function (options) {
              window.plausible.o = options || {};
            };
            var options = {
              hashBasedRouting: false,
              transformRequest: function (payload) {
                var canonical = document.querySelector('link[rel="canonical"]');
                payload.u = canonical ? canonical.href : location.origin + location.pathname;
                payload.r = null;
                if (payload.p && payload.p.url) delete payload.p.url;
                return payload;
              }
            };
            if (plausibleEndpoint) options.endpoint = plausibleEndpoint;
            window.plausible.init(options);
            var eventProps = Object.freeze(analyticsEventProps);
            window.zodiacsAnalytics = Object.freeze({
              track: function (name, props) {
                var allowed = eventProps[name];
                if (!allowed) return;
                var safe = {};
                allowed.forEach(function (key) {
                  var value = (props || {})[key];
                  var enumValues = analyticsEventValues[name] && analyticsEventValues[name][key];
                  if (enumValues && (typeof value !== 'string' || enumValues.indexOf(value) === -1)) return;
                  if (typeof value === 'number' || typeof value === 'boolean' ||
                      (typeof value === 'string' && value.length <= 32)) safe[key] = value;
                });
                window.plausible(name, { props: safe });
              }
            });
            document.addEventListener('click', function (event) {
              var target = event.target;
              var link = target && target.closest ? target.closest('a[href]') : null;
              if (!link) return;
              var href = link.getAttribute('href') || '';
              var destination = href.indexOf('/sdk/') === 0 ? 'docs'
                : href.indexOf('npmjs.com/package/@zodiacs/sdk') !== -1 ? 'npm'
                : href.indexOf('github.com/zodiacs-org/sdk') !== -1 ? 'github' : '';
              if (destination) window.zodiacsAnalytics.track('sdk_click', {
                source: 'astrology', destination: destination
              });
            });
            if (window.zodiacsArrival) window.zodiacsAnalytics.track('assistant_arrival', { assistant: window.zodiacsArrival });
            var remoteScript = document.createElement('script');
            remoteScript.defer = true;
            remoteScript.dataset.zodiacsRemoteAnalytics = '';
            if (plausibleDomain) remoteScript.dataset.domain = plausibleDomain;
            remoteScript.src = plausibleScriptUrl;
            document.head.appendChild(remoteScript);
          })();
        </script>
      </>
    )}
    {webAnalyticsEnabled && (
      <script is:inline define:vars={{ guidePrivateSessionKey: GUIDE_PRIVATE_SESSION_KEY }}>
        (function () {
          try {
            if (sessionStorage.getItem(guidePrivateSessionKey) === '1') return;
          } catch (error) {}
          window.va = window.va || function () {
            (window.vaq = window.vaq || []).push(arguments);
          };
          window.va('beforeSend', function (event) {
            if (!event || typeof event.url !== 'string') return event;
            try {
              var url = new URL(event.url, location.origin);
              url.search = '';
              url.hash = '';
              event.url = url.toString();
            } catch (error) {}
            return event;
          });
          var insights = document.createElement('script');
          insights.defer = true;
          insights.dataset.zodiacsRemoteAnalytics = 'vercel';
          insights.src = '/_vercel/insights/script.js';
          document.head.appendChild(insights);
        })();
      </script>
    )}
    <slot name="head" />
  </head>
  <body>
    {accountSyncV2Enabled && <AccountProfileAccessBootstrap client:load />}
    <!-- Keep the route catalog ahead of every island, but out of <head> so
         its ~20KB inline payload cannot delay CSS and LCP-font discovery. -->
    {clientUi && (
      <script is:inline define:vars={{ uiLocale: locale, uiMessages: clientUi }}>
        globalThis.__ZDX_UI__ = { locale: uiLocale, messages: uiMessages };
      </script>
    )}
    {russianRuntime && (
      <script is:inline define:vars={{ russianRuntime }}>
        globalThis.__ZDX_RU__ = { locale: 'ru', data: russianRuntime };
      </script>
    )}
    <a href="#main" class="skip">{t(locale, 'skipContent')}</a>
    <div class="orbs" aria-hidden="true"></div>
    <div class="dust" aria-hidden="true"></div>

    <SiteNav locale={locale} />

    {props.glass && <GlassDefs />}

    <main id="main">
      <slot />
      {/* Sign guides carry their own contents rail (src/pages/[sign]/index.astro). */}
      <ArticleContents enabled={locale === 'en' && (props.path.startsWith('/learn/') || props.path === '/methodology/') && props.path !== '/learn/glossary/'} />
    </main>

    {(props.editorialLine ?? props.type === 'article') && <EditorialLine locale={locale} />}
    <SourcesLine sources={props.sources} locale={locale} />
    <SiteFooter locale={locale} terminalMarketNotice={props.terminalMarketNotice} noAssistant={props.noAssistant} />

    <!-- The canonical footer sits below every route's primary content, so its
         sizeable shared stylesheet must not delay the first viewport. Keep the
         request non-render-blocking, and start it when the footer approaches
         the viewport even if other page resources have not finished loading.
         The no-script import preserves a fully styled document for readers who
         disable JavaScript without making Astro's critical-CSS pass inline it. -->
    <script is:inline>
      (function loadFooterStyles() {
        var requested = false;
        var observer;
        function appendStylesheet() {
          if (requested) return;
          requested = true;
          if (observer) observer.disconnect();
          var stylesheet = document.createElement('link');
          stylesheet.rel = 'stylesheet';
          stylesheet.href = '/assets/site-footer.css?v=20261006';
          // A held footer is shown by these styles; the hold goes once they
          // have loaded, or if they fail or take over 3 s.
          if (root.hasAttribute('data-footer-styles-pending')) {
            var reveal = function () { root.removeAttribute('data-footer-styles-pending'); };
            stylesheet.addEventListener('load', reveal);
            stylesheet.addEventListener('error', reveal);
            window.setTimeout(reveal, 3000);
          }
          document.head.appendChild(stylesheet);
        }
        function appendAfterLoad() {
          window.setTimeout(appendStylesheet, 250);
        }
        var root = document.documentElement;
        var footer = document.querySelector('.zfooter');
        var nearViewport = footer && footer.getBoundingClientRect().top <= window.innerHeight + 200;
        if (!nearViewport) root.removeAttribute('data-footer-styles-pending');
        if (nearViewport) appendStylesheet();
        else {
          if (footer && 'IntersectionObserver' in window) {
            try {
              observer = new IntersectionObserver(function (entries) {
                for (var index = 0; index < entries.length; index += 1) {
                  if (entries[index].isIntersecting) { appendStylesheet(); return; }
                }
              }, { threshold: 0, rootMargin: '0px 0px 200px 0px' });
              observer.observe(footer);
            } catch (_) {
              if (observer) observer.disconnect();
              observer = null;
            }
          }
          if (document.readyState === 'complete') appendAfterLoad();
          else window.addEventListener('load', appendAfterLoad, { once: true });
        }
      })();
    </script>
    <noscript><style>@import url('/assets/site-footer.css?v=20261006');</style></noscript>

    {props.localTypography && locale === 'en' && (
      <script is:inline>
        /* Pages on the local type tier paint their body copy in the metric-
           matched local face, so a late webfont can never move the first
           screen. Once the page has loaded, the brand face is fetched once and
           handed to each section only while that section is off screen, so
           visible text never changes face and nothing a reader sees shifts. */
        (function upgradeBodyFace() {
          if (!('FontFace' in window) || !document.fonts || !('IntersectionObserver' in window)) return;
          var family = "'Instrument Sans Body', 'Instrument Sans Fallback', 'Instrument Sans Fallback Android', system-ui, -apple-system, sans-serif";
          // The home page's display serif is its own preloaded subset; other
          // pages on this tier fall back to Georgia and take EB Garamond too.
          var serifIsLocal = /^['"]?EB Garamond Fallback/.test(getComputedStyle(document.documentElement).getPropertyValue('--font-serif').trim());
          var serif = "'EB Garamond', 'EB Garamond Fallback', 'EB Garamond Fallback Android', Georgia, serif";
          function start() {
            var upright = new FontFace('Instrument Sans Body', 'url(/fonts/instrument-sans-latin-wght-normal.woff2) format("woff2-variations")', { weight: '400 700', style: 'normal', display: 'swap' });
            var italic = new FontFace('Instrument Sans Body', 'url(/fonts/instrument-sans-latin-wght-italic.woff2) format("woff2-variations")', { weight: '400 700', style: 'italic', display: 'swap' });
            document.fonts.add(italic);
            upright.load().then(function (face) {
              document.fonts.add(face);
              var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                  // A zero-area box (an island's display:contents wrapper, a
                  // hidden block) says nothing about where its children are.
                  var box = entry.boundingClientRect;
                  if (entry.isIntersecting || box.width === 0 || box.height === 0) return;
                  entry.target.style.setProperty('--font-sans', family);
                  if (serifIsLocal) entry.target.style.setProperty('--font-serif', serif);
                  // Re-declare the inherited body face only on blocks that
                  // wear it. A serif heading at this depth keeps its own rule,
                  // which reads the upgraded --font-serif set just above.
                  if (/Instrument Sans/.test(getComputedStyle(entry.target).fontFamily)) {
                    entry.target.style.fontFamily = 'var(--font-sans)';
                  }
                  observer.unobserve(entry.target);
                });
              });
              // Sections and their direct blocks: a section taller than the
              // screen never leaves it while it is being read, its blocks do.
              var blocks = document.querySelectorAll('main > *, main > * > *, main > * > * > *, .zfooter');
              blocks.forEach(function (block) { observer.observe(block); });
              // While the tab is hidden nothing can be seen to move, so the
              // rest of the page takes the brand face then.
              document.addEventListener('visibilitychange', function () {
                if (document.visibilityState !== 'hidden') return;
                observer.disconnect();
                var main = document.querySelector('main');
                [main, document.querySelector('.zfooter')].forEach(function (block) {
                  if (!block) return;
                  block.style.setProperty('--font-sans', family);
                  if (serifIsLocal) block.style.setProperty('--font-serif', serif);
                  block.style.fontFamily = 'var(--font-sans)';
                });
              }, { once: true });
            }).catch(function () {});
          }
          if (document.readyState === 'complete') window.setTimeout(start, 400);
          else window.addEventListener('load', function () { window.setTimeout(start, 400); }, { once: true });
        })();
      </script>
    )}

    <script>
      // A small heading entrance, once, before it enters the reading area.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reveals = document.querySelectorAll('.reveal');
      if (!reduced && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          // threshold 0: tall blocks (full articles) must still reveal —
          // a ratio threshold never fires for elements taller than the
          // viewport.
          { threshold: 0, rootMargin: '0px 0px 48px 0px' }
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-in'));
      }

      // The worker owns only a versioned astrology app shell. Registry
      // identity JSON bypasses its caches in public/sw.js. Registration
      // holds back a beat past load: install precaches fifteen routes, and
      // that burst must never share the window where the page is still
      // painting its largest content.
      if ('serviceWorker' in navigator && !document.documentElement.hasAttribute('data-no-service-worker')) {
        window.addEventListener('load', () => {
          window.setTimeout(() => {
            navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {});
          }, 3000);
        }, { once: true });
      }
    </script>
  </body>
</html>

