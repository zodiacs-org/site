---
import Base from '../../../layouts/Base.astro';
import LocalizedBirthChart from '../../../components/localized/LocalizedBirthChart.astro';
import birthChartCss from '../../../components/localized/LocalizedBirthChart.css?inline';
import calculatorFirstPaintCss from '../../../styles/calculator-first-paint.css?inline';

const faq = [
  {
    q: 'Что такое натальная карта?',
    a: 'Натальная карта представляет собой схему положения планет, если смотреть с Земли, в точный момент и в точном месте вашего рождения. Она показывает Солнце, Луну, асцендент, планеты от Меркурия до Плутона и двенадцать домов.',
  },
  {
    q: 'Нужно ли знать точное время рождения?',
    a: 'Да, для асцендента и домов: асцендент меняется примерно каждые два часа. Если время неизвестно, мы используем 12:00 местного гражданского времени как ориентир для положений и не показываем асцендент, углы и дома. Поскольку Луна может сменить знак в течение дня, результат помечает лунный знак как неподтверждённый, пока вы не укажете время. Лучшие источники: свидетельство о рождении, медицинская запись или семья.',
  },
  {
    q: 'Насколько точен расчёт?',
    a: 'Положения планет рассчитываются астрономическим движком и сверяются с эталонными данными NASA JPL с точностью до сотых долей градуса. Исторические изменения часов с 1970 года берутся из истории IANA, предоставленной браузером или системой устройства, а более ранние берутся из зафиксированного выпуска базы IANA вместе со старыми записями, которые база хранит отдельно для мест, чьи часы позже совпали с часами другого города; её составители считают эти записи менее надёжными. Для рождений до введения поясного времени используется местное среднее время места рождения, вычисленное по его долготе.',
  },
  {
    q: 'Что происходит с моими данными рождения?',
    a: 'Вся карта рассчитывается в вашем браузере: калькулятор не обращается к серверному API для карт, аккаунт не нужен. Сохранённая карта сначала остаётся на этом устройстве. Необязательная синхронизация отправляет только выбранные сохранённые карты и только после входа.',
  },
  {
    q: 'Дома целых знаков или Плацидус: что выбрать?',
    a: 'Система целых знаков древнее и проще для чтения: каждый дом занимает целый знак. Плацидус делит дома по времени их восхождения, поэтому их размер различается. Попробуйте обе: планеты не двигаются, меняются только границы домов.',
    id: 'houses',
  },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    name: 'Бесплатная натальная карта',
    url: 'https://zodiacs.org/ru/birth-chart/',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: 'Солнце, Луна, асцендент, планеты от Меркурия до Плутона, Истинный узел, дома целых знаков и Плацидус, аспекты',
    inLanguage: 'ru',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
  {
    '@type': 'FAQPage',
    inLanguage: 'ru',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org на русском', item: 'https://zodiacs.org/ru/' },
      { '@type': 'ListItem', position: 2, name: 'Инструменты', item: 'https://zodiacs.org/ru/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Натальная карта', item: 'https://zodiacs.org/ru/birth-chart/' },
    ],
  },
];
---
<Base
  clientUi
  glass
  inlineCriticalCss
  localTypography
  localChromeTypography
  title="Натальная карта онлайн бесплатно: Солнце, Луна, асцендент"
  description="Рассчитайте натальную карту: Солнце, Луна, асцендент, планеты, дома и их значение. Приватно в браузере, объяснено простым языком."
  path="/ru/birth-chart/"
  locale="ru"
  image="/assets/og/v2/tool/birth-chart.png"
  imageAlt="Бесплатная натальная карта, Zodiacs.org"
  jsonLd={jsonLd}
>
  <script slot="head" is:inline>
    try {
      var chartShareParams = new URLSearchParams(location.hash.slice(1));
      if (chartShareParams.has('p') || chartShareParams.has('c')) {
        document.documentElement.dataset.chartShareReceiver = '';
        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('a[href="/astrofolio/"],a[href^="/registry/"],a[href^="/sdk/"]').forEach(function (element) {
            if (element.closest('[data-nav], [data-mobile-menu]')) return;
            var footerWing = element.closest('.footer__col, .zfooter__group');
            (footerWing || element).remove();
          });
        }, { once: true });
      }
    } catch (error) {}
  </script>
  <style slot="head" is:inline>
    html[data-chart-share-receiver] a[href="/astrofolio/"]:not([data-nav] a, [data-mobile-menu] a),
    html[data-chart-share-receiver] a[href^="/registry/"],
    html[data-chart-share-receiver] a[href^="/sdk/"],
    html[data-chart-share-receiver] .calc__record,
    html[data-chart-share-receiver] [data-registry-aura-chart-link],
    html[data-chart-share-receiver] .footer__col:has(a[href^="/registry/"]),
    html[data-chart-share-receiver] .zfooter__group:has(a[href^="/registry/"]) { display: none !important; }
  </style>
  <style
    slot="head"
    is:inline
    data-zdx-calculator-first-paint
    set:html={calculatorFirstPaintCss}
  />
  <style slot="head" is:inline data-zdx-birth-chart-route set:html={birthChartCss} />

  <LocalizedBirthChart locale="ru" faq={faq} />
</Base>
