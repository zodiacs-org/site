---
import Base from '../../../layouts/Base.astro';
import Faq from '../../../components/Faq.astro';
import ChartCalculator from '../../../islands/ChartCalculator';
import calculatorFirstPaintCss from '../../../styles/calculator-first-paint.css?inline';
import '../../../styles/calculator.css';
import '../../../styles/explorer.css';

const faq = [
  {
    q: 'Что такое натальная карта?',
    a: 'Натальная карта — это схема положения планет, если смотреть с Земли, в точный момент и в точном месте вашего рождения. Она показывает Солнце, Луну, асцендент, планеты от Меркурия до Плутона и двенадцать домов.',
  },
  {
    q: 'Нужно ли знать точное время рождения?',
    a: 'Для асцендента и домов — да: асцендент меняется примерно каждые два часа. Если время неизвестно, мы используем 12:00 местного гражданского времени как ориентир для положений и не показываем асцендент, углы и дома. Поскольку Луна может сменить знак в течение дня, результат помечает лунный знак как неподтверждённый, пока вы не укажете время. Лучшие источники — свидетельство о рождении, медицинская запись или семья.',
  },
  {
    q: 'Насколько точен расчёт?',
    a: 'Положения планет рассчитываются астрономическим движком и сверяются с эталонными данными NASA JPL с точностью до сотых долей градуса. Исторические изменения часов с 1970 года берутся из истории IANA, предоставленной браузером или системой устройства, а более ранние — из зафиксированного выпуска базы IANA вместе со старыми записями, которые база хранит отдельно для мест, чьи часы позже совпали с часами другого города; её составители считают эти записи менее надёжными. Для рождений до введения поясного времени используется местное среднее время места рождения, вычисленное по его долготе.',
  },
  {
    q: 'Что происходит с моими данными рождения?',
    a: 'Вся карта рассчитывается в вашем браузере: калькулятор не обращается к серверному API для карт, аккаунт не нужен. Сохранённая карта сначала остаётся на этом устройстве. Необязательная синхронизация отправляет только выбранные сохранённые карты и только после входа.',
  },
  {
    q: 'Дома целых знаков или Плацидус: что выбрать?',
    a: 'Система целых знаков — более древняя и простая для чтения: каждый дом занимает целый знак. Плацидус делит дома по времени их восхождения, поэтому их размер различается. Попробуйте обе: планеты не двигаются, меняются только границы домов.',
  },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    name: 'Бесплатная натальная карта',
    url: 'https://zodiacs.org/ru/birth-chart/',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: 'Солнце, Луна, асцендент, планеты от Меркурия до Плутона, Истинный узел, дома целых знаков и Плацидус, аспекты',
    inLanguage: 'ru',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
  {
    '@type': 'FAQPage',
    inLanguage: 'ru',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org на русском', item: 'https://zodiacs.org/ru/' },
      { '@type': 'ListItem', position: 2, name: 'Инструменты', item: 'https://zodiacs.org/ru/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Натальная карта', item: 'https://zodiacs.org/ru/birth-chart/' },
    ],
  },
];
---
<Base
  clientUi
  glass
  inlineCriticalCss
  localTypography
  localChromeTypography
  title="Натальная карта онлайн бесплатно — Солнце, Луна, асцендент"
  description="Рассчитайте натальную карту: Солнце, Луна, асцендент, планеты, дома и их значение. Приватно в браузере, объяснено простым языком."
  path="/ru/birth-chart/"
  locale="ru"
  image="/assets/og/v2/tool/birth-chart.png"
  imageAlt="Бесплатная натальная карта — Zodiacs.org"
  jsonLd={jsonLd}
>
  <script slot="head" is:inline>
    try {
      var chartShareParams = new URLSearchParams(location.hash.slice(1));
      if (chartShareParams.has('p') || chartShareParams.has('c')) {
        document.documentElement.dataset.chartShareReceiver = '';
        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('a[href="/astrofolio/"],a[href^="/registry/"],a[href^="/sdk/"]').forEach(function (element) {
            var footerWing = element.closest('.footer__col, .zfooter__group');
            (footerWing || element).remove();
          });
        }, { once: true });
      }
    } catch (error) {}
  </script>
  <style slot="head" is:inline>
    html[data-chart-share-receiver] a[href="/astrofolio/"],
    html[data-chart-share-receiver] a[href^="/registry/"],
    html[data-chart-share-receiver] a[href^="/sdk/"],
    html[data-chart-share-receiver] .calc__record,
    html[data-chart-share-receiver] [data-registry-aura-chart-link],
    html[data-chart-share-receiver] .footer__col:has(a[href^="/registry/"]),
    html[data-chart-share-receiver] .zfooter__group:has(a[href^="/registry/"]) { display: none !important; }
  </style>
  <style
    slot="head"
    is:inline
    data-zdx-calculator-first-paint
    set:html={calculatorFirstPaintCss}
  />
  <section class="section--tight container">
    <div class="tool-hero">
      <h1 class="display">Постройте бесплатную натальную карту.</h1>
      <p>Введите дату, время и место рождения, чтобы увидеть Солнце, Луну, асцендент, планеты, дома и их значение.</p>
    </div>
    <ChartCalculator mode="full" locale="ru" client:interaction={{ eagerHash: true }} />
    <noscript>
      <p>Для расчёта натальной карты нужен JavaScript. Включите его и перезагрузите страницу, чтобы рассчитать Солнце, Луну, асцендент, планеты и дома в вашем браузере.</p>
    </noscript>
  </section>

  <section class="section--tight container container--narrow">
    <div class="prose">
      <h2>Что перед вами</h2>
      <p>Натальная карта — снимок неба из места вашего рождения в момент рождения. Она показывает знаки, дома и планеты в точных градусах.</p>
      <p>Начните с Солнца, Луны и асцендента: это идентичность, эмоциональная жизнь и первое впечатление. Затем карту можно сохранить и вернуться к ней в любое время.</p>
      <p>Подробности — в разделе <a href="/ru/methodology/">«Как мы считаем»</a>.</p>
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <Faq items={faq} heading="Вопросы о натальной карте" />
  </section>
</Base>

<style>
  .tool-hero { max-width: 62ch; margin-bottom: clamp(28px, 5vw, 44px); }
  .tool-hero h1 { margin: 0 0 16px; font-size: var(--text-2xl); line-height: 1.04; }
  .tool-hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }
</style>
