---
import Base from '../../../layouts/Base.astro';
import SignIcon from '../../../components/SignIcon.astro';
import SignGuideHero from '../../../components/SignGuideHero.astro';
import SignGuideFacts from '../../../components/SignGuideFacts.astro';
import Faq from '../../../components/Faq.astro';
import { SIGNS, SIGN_SLUGS, elementLabel, signBySlug, signName } from '../../../lib/signs';
import { signDateRange } from '../../../lib/sign-display';
import { t } from '../../../lib/i18n';
import { planetLabel } from '../../../lib/i18n/astrology';
import { russianGuideFor } from '../../../data/ru-guides';
import { pairSlug } from '../../../lib/compat';
import { EDITOR_AUTHOR } from '../../../lib/editorial';

export function getStaticPaths() {
  return SIGN_SLUGS.map((sign) => ({ params: { sign } }));
}

const sign = signBySlug(Astro.params.sign!);
const guide = russianGuideFor(sign);
const idx = SIGNS.findIndex((s) => s.slug === sign.slug);
const prev = SIGNS[(idx + 11) % 12];
const next = SIGNS[(idx + 1) % 12];
const metaTitle = `${signName(sign, 'ru')}: даты, характер, совместимость`;
const metaDescription = `Гид по знаку ${signName(sign, 'ru')}: даты, стихия, управитель, сильные стороны и как знак ведёт себя в отношениях.`;
const pluralSign = ['gemini', 'libra', 'pisces'].includes(sign.slug);
// The facts line is sentence case; the Russian element labels are lowercase.
const elementFact = elementLabel(sign.element, 'ru').replace(/^./u, (letter) => letter.toLocaleUpperCase('ru'));
const easeful = {
  aries: ['leo', 'sagittarius', 'gemini'],
  taurus: ['virgo', 'capricorn', 'cancer'],
  gemini: ['libra', 'aquarius', 'aries'],
  cancer: ['scorpio', 'pisces', 'taurus'],
  leo: ['aries', 'sagittarius', 'libra'],
  virgo: ['taurus', 'capricorn', 'cancer'],
  libra: ['gemini', 'aquarius', 'leo'],
  scorpio: ['cancer', 'pisces', 'virgo'],
  sagittarius: ['aries', 'leo', 'aquarius'],
  capricorn: ['taurus', 'virgo', 'scorpio'],
  aquarius: ['gemini', 'libra', 'sagittarius'],
  pisces: ['cancer', 'scorpio', 'capricorn'],
}[sign.slug]!;

// The hero's quick answers, in the labels this locale's catalogue already
// carries for the chart inspector (dates, element, ruler).
const upperFirst = (value: string) => value.replace(/^\p{L}/u, (letter) => letter.toLocaleUpperCase('ru'));
const heroFacts = [
  { label: t('ru', 'dates'), value: upperFirst(signDateRange(sign, 'ru')) },
  { label: t('ru', 'element'), value: elementFact },
  { label: t('ru', 'ruler'), value: planetLabel('ru', sign.ruler), glyph: sign.ruler },
];

const jsonLd = [
  {
    '@type': 'Article',
    headline: guide.title,
    description: metaDescription,
    url: `https://zodiacs.org/ru/${sign.slug}/`,
    datePublished: '2026-07-07T03:45:11+07:00',
    dateModified: '2026-07-11T00:00:00+07:00',
    author: EDITOR_AUTHOR,
    publisher: { '@id': 'https://zodiacs.org/#org' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://zodiacs.org/ru/${sign.slug}/` },
    image: `https://zodiacs.org/assets/og/v2/ru/sign/${sign.slug}.png`,
    inLanguage: 'ru',
    about: { '@type': 'Thing', name: `${signName(sign, 'ru')} (астрология)` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org на русском', item: 'https://zodiacs.org/ru/' },
      { '@type': 'ListItem', position: 2, name: 'Знаки зодиака', item: 'https://zodiacs.org/ru/#signs' },
      { '@type': 'ListItem', position: 3, name: signName(sign, 'ru'), item: `https://zodiacs.org/ru/${sign.slug}/` },
    ],
  },
  {
    '@type': 'FAQPage',
    inLanguage: 'ru',
    mainEntity: guide.faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title={metaTitle}
  description={metaDescription}
  path={`/ru/${sign.slug}/`}
  image={`/assets/og/v2/ru/sign/${sign.slug}.png`}
  imageAlt={`${signName(sign, 'ru')}, гид по знаку на Zodiacs.org`}
  type="article"
  locale="ru"
  noindex
  jsonLd={jsonLd}
>
  <article style={`--sign:${sign.hue}`}>
    <SignGuideHero sign={sign.slug} locale="ru" title={signName(sign, 'ru')} sub={guide.intro[0]}>
      <a class="btn btn--primary btn--lg" href="/ru/birth-chart/"><span>Постройте бесплатную натальную карту</span><span class="orb" aria-hidden="true">↗</span></a>
      <a class="btn btn--glass btn--lg" href="/ru/compatibility/"><span>Проверить совместимость</span></a>
    </SignGuideHero>
    <div class="kwrap guide-locale-facts">
      <SignGuideFacts facts={heroFacts} />
    </div>

    <div class="container container--narrow guide-ru-body">
      <aside class="collect-band reveal">
        <span class="collect-band__label">Реестр</span>
        <span class="collect-band__text">{signName(sign, 'ru')} — одна из двенадцати записей.</span>
        <a class="collect-band__link" href={`/registry/${sign.slug}/`} hreflang="en" title="Материал пока доступен по-английски">Открыть запись (пока по-английски)</a>
      </aside>

      <div class="prose reveal">
        {guide.intro.slice(1).map((p) => <p>{p}</p>)}
        {guide.sections.map((section) => (
          <>
            <h2>{section.heading}</h2>
            {section.body.map((p) => <p>{p}</p>)}
            {section.risingProfile && (
              <p>
                <a href={`/rising-sign/${sign.slug}/`} hreflang="en" title="Материал пока доступен по-английски" aria-label={`Полный профиль асцендента «${signName(sign, 'ru')}». Материал пока доступен по-английски`}>
                  Полный профиль асцендента «{signName(sign, 'ru')}» (пока по-английски) →
                </a>
              </p>
            )}
          </>
        ))}
      </div>

      <section class="guide-ru-panel shell tinted reveal" style={`--sign:${sign.hue}`}>
        <div class="core tinted guide-ru-panel__core">
          <h2>Быстрая совместимость</h2>
          <p>
            Связь двух солнечных знаков — только начало. С этими знаками
            {signName(sign, 'ru')} часто {pluralSign ? 'находят' : 'находит'} общий ритм; для точного разбора сравните две карты.
          </p>
          <p class="guide-ru-panel__note">Материалы о сочетаниях пока доступны по-английски.</p>
          <div class="guide-ru-panel__chips">
            {easeful.map((slug) => {
              const s = signBySlug(slug);
              return (
                <a class="chip" href={`/compatibility/${pairSlug(sign.slug, s.slug)}/`} hreflang="en" title="Материал пока доступен по-английски" aria-label={`${signName(sign, 'ru')} и ${signName(s, 'ru')}. Материал пока доступен по-английски`} style={`--sign:${s.hue}`}>
                  <SignIcon sign={s.slug} size={18} class="chip__icon" /> {signName(sign, 'ru')} и {signName(s, 'ru')}<span class="sr-only"> (пока по-английски)</span>
                </a>
              );
            })}
          </div>
        </div>
      </section>

      <section class="reveal">
        <Faq items={guide.faq} heading={`${signName(sign, 'ru')}: частые вопросы`} />
      </section>

      <p class="identity-share">
        Отправить эту страницу:{' '}
        <a href={`https://x.com/intent/post?text=${encodeURIComponent(`${signName(sign, 'ru')} — полный гид https://zodiacs.org/ru/${sign.slug}/`)}`} target="_blank" rel="noopener noreferrer">X</a>{' · '}
        <a href={`https://t.me/share/url?url=${encodeURIComponent(`https://zodiacs.org/ru/${sign.slug}/`)}&text=${encodeURIComponent(`${signName(sign, 'ru')} — полный гид`)}`} target="_blank" rel="noopener noreferrer">Telegram</a>{' · '}
        <a href={`mailto:?subject=${encodeURIComponent(`${signName(sign, 'ru')} — полный гид`)}&body=${encodeURIComponent(`https://zodiacs.org/ru/${sign.slug}/`)}`}>Почта</a>
      </p>
    </div>

    <nav class="container guide-ru-nav reveal" aria-label="Другие знаки">
      <a class="guide-ru-nav__link" href={`/ru/${prev.slug}/`} style={`--sign:${prev.hue}`}>
        <span class="mono--label">← Предыдущий</span>
        <span><SignIcon sign={prev.slug} size={22} /> {signName(prev, 'ru')}</span>
      </a>
      <a class="guide-ru-nav__link guide-ru-nav__link--next" href={`/ru/${next.slug}/`} style={`--sign:${next.hue}`}>
        <span class="mono--label">Следующий →</span>
        <span><SignIcon sign={next.slug} size={22} /> {signName(next, 'ru')}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .guide-locale-facts { margin-bottom: clamp(36px, 5vw, 56px); }
  .guide-ru-body { display: grid; gap: clamp(28px, 5vw, 46px); }
  .collect-band { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; padding: 12px 18px; border: 1px solid var(--hair-1); border-radius: var(--r-md); background: var(--void-1); transition: border-color var(--dur-1) var(--ease), background-color var(--dur-1) var(--ease); }
  .collect-band:focus-within { border-color: var(--hair-3); }
  @media (hover: hover) and (pointer: fine) {
    .collect-band:hover { border-color: var(--hair-2); background: var(--void-2); }
    .collect-band:hover .collect-band__link { color: var(--text); transform: translateX(2px); }
  }
  .collect-band__label { font-family: var(--font-sans); font-size: 12.5px; letter-spacing: 0; text-transform: none; font-variant-numeric: tabular-nums; color: var(--faint); }
  .collect-band__text { font-size: 13px; color: var(--muted); }
  .collect-band__link { margin-inline-start: auto; font-size: 13px; font-weight: 550; color: var(--text-2); text-decoration: none; transition: color var(--dur-1) var(--ease), transform var(--dur-1) var(--ease); }
  @media (prefers-reduced-motion: reduce) { .collect-band, .collect-band__link { transition: none; } .collect-band:hover .collect-band__link { transform: none; } }
  .identity-share { margin: 0; font-family: var(--font-sans); font-size: 13px; line-height: 1.8; letter-spacing: 0; word-spacing: 0.1em; color: var(--faint); }
  .identity-share a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--hair-1); }
  .guide-ru-panel__core { padding: clamp(22px, 4vw, 32px); display: grid; gap: 12px; }
  .guide-ru-panel h2 { margin: 0; font-size: var(--text-xl); }
  .guide-ru-panel p { margin: 0; max-width: 58ch; color: var(--text-2); line-height: 1.65; }
  .guide-ru-panel .guide-ru-panel__note { color: var(--faint); font-size: var(--text-sm); }
  .guide-ru-panel__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .guide-ru-nav {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-block: clamp(34px, 6vw, 70px) 0;
  }
  .guide-ru-nav__link {
    display: grid;
    gap: 7px;
    min-width: 0;
    color: var(--text);
    text-decoration: none;
  }
  .guide-ru-nav__link span:last-child {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }
  .guide-ru-nav__link--next { text-align: end; justify-items: end; }
</style>
