---
import Base from '../../layouts/Base.astro';
import LocalizedHome from '../../components/localized/LocalizedHome.astro';
import LocalizedHomeHead from '../../components/localized/LocalizedHomeHead.astro';
import { localizedHomeFaq, localizedHomeFaqSchema } from '../../components/localized/home-copy';

// The English homepage's two own questions, in Russian. The data answer is
// the birth chart page's, as published there. The hero and its media
// contract live in src/components/localized/RuHomeHero.astro.
const faq = localizedHomeFaq('ru', [
  {
    q: 'Что происходит с моими данными рождения?',
    a: 'Вся карта рассчитывается в вашем браузере: калькулятор не обращается к серверному API для карт, аккаунт не нужен. Сохранённая карта сначала остаётся на этом устройстве. Необязательная синхронизация отправляет только выбранные сохранённые карты и только после входа.',
  },
  {
    q: 'А если я не знаю время рождения?',
    a: 'Выберите «Не знаю время». Калькулятор берёт 12:00 как ориентир, не показывает асцендент и дома, чтобы не придумывать их, и помечает лунный знак как неподтверждённый, пока вы не укажете время: Луна может сменить знак в течение дня.',
  },
]);

const jsonLd = [
  localizedHomeFaqSchema(faq),
  {
    '@type': 'WebSite',
    '@id': 'https://zodiacs.org/#site',
    url: 'https://zodiacs.org/',
    name: 'Zodiacs.org',
    description: 'Бесплатные натальные карты, совместимость и гиды по знакам, приватно и простым языком.',
    publisher: { '@id': 'https://zodiacs.org/#org' },
    inLanguage: ['en', 'ru'],
  },
];
---
<Base
  clientUi
  inlineCriticalCss
  title="Zodiacs.org | натальные карты и астрология без мистики"
  description="Бесплатные натальные карты, совместимость и гиды по знакам. Всё считается приватно в вашем браузере и объясняется простым языком."
  path="/ru/"
  locale="ru"
  jsonLd={jsonLd}
>
  <LocalizedHomeHead slot="head" locale="ru" />
  <LocalizedHome locale="ru" faq={faq} />
</Base>
