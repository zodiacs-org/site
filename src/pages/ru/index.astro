---
import HomeTrustFaq from '../../components/HomeTrustFaq.astro';
import { homeTrustSchema } from '../../lib/home-trust';
import Base from '../../layouts/Base.astro';
import SignIcon from '../../components/SignIcon.astro';
import ToolGlyph from '../../components/ToolGlyph.astro';
import SkyTicker from '../../islands/SkyTicker';
import WelcomeBack from '../../islands/WelcomeBack';
import { SIGNS, signDates, signName } from '../../lib/signs';
import glassMaps from '../../data/glass-maps.json';
import '../../styles/today.css';

const tools = [
  { href: '/ru/birth-chart/', title: 'Натальная карта', promise: 'Солнце, Луна, асцендент, планеты, дома и их значение.', hue: 'var(--sign-cancer)', kind: 'birth' as const },
  { href: '/ru/moon-sign/', title: 'Лунный знак', promise: 'Как вы чувствуете, что вас успокаивает и что даёт ощущение дома.', hue: 'var(--sign-pisces)', kind: 'moon' as const },
  { href: '/ru/rising-sign/', title: 'Асцендент', promise: 'Первое впечатление и то, как выстроена вся карта.', hue: 'var(--sign-libra)', kind: 'rising' as const },
  { href: '/ru/compatibility/', title: 'Совместимость', promise: 'Сравните две карты и увидьте, где они сходятся, спорят и растут.', hue: 'var(--sign-leo)', kind: 'compat' as const },
];

const jsonLd = [
  homeTrustSchema('ru'),
  {
    '@type': 'WebSite',
    '@id': 'https://zodiacs.org/#site',
    url: 'https://zodiacs.org/',
    name: 'Zodiacs.org',
    description: 'Бесплатные натальные карты, совместимость и гиды по знакам — приватно и простым языком.',
    publisher: { '@id': 'https://zodiacs.org/#org' },
    inLanguage: ['en', 'ru'],
  },
];
---
<Base
  clientUi
  inlineCriticalCss
  title="Zodiacs.org — натальные карты и астрология без мистики"
  description="Бесплатные натальные карты, совместимость и гиды по знакам. Всё считается приватно в вашем браузере и объясняется простым языком."
  path="/ru/"
  locale="ru"
  jsonLd={jsonLd}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/assets/hero/zodiacs-hero-poster-ru-mobile.avif"
    media="(max-width: 719px)"
    fetchpriority="high"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/assets/hero/zodiacs-hero-poster-ru.avif"
    media="(min-width: 720px)"
    fetchpriority="high"
  />
  <section class="hero-ru container">
    <div class="hero-ru__frame">
      <picture>
        <source
          media="(max-width: 719px)"
          srcset="/assets/hero/zodiacs-hero-poster-ru-mobile.avif"
          type="image/avif"
        />
        <img
          class="hero-ru__poster"
          src="/assets/hero/zodiacs-hero-poster-ru.avif"
          width="1440"
          height="810"
          loading="eager"
          fetchpriority="high"
          alt=""
          aria-hidden="true"
          data-hero-poster-ru
        />
      </picture>
      <video
        class="hero-ru__video"
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        aria-hidden="true"
        tabindex="-1"
        data-hero-video-ru
      >
        <source data-src="/assets/hero/zodiacs-hero-av1.mp4" type='video/mp4; codecs="av01.0.08M.08"' />
        <source data-src="/assets/hero/zodiacs-hero.mp4" type="video/mp4" />
      </video>
      <div class="hero-ru__scrim" aria-hidden="true"></div>
      <div class="hero-ru__content">
        <h1>Натальные карты и астрология без мистики.</h1>
        <div class="hero-ru__foot">
          <p>Бесплатные натальные карты, совместимость и гиды по знакам. Всё считается приватно в вашем браузере и объясняется простым языком.</p>
          <div class="hero-ru__ctas">
            <a class="btn btn--primary" href="/ru/birth-chart/"><span>Постройте бесплатную натальную карту</span><span class="orb">↗</span></a>
            <a class="btn btn--ghost hero-ru__ghost" href="/horoscopes/" hreflang="en" title="Материал пока доступен по-английски" aria-label="Сегодняшний гороскоп. Материал пока доступен по-английски"><span>Гороскопы — пока по-английски</span></a>
          </div>
          <div class="hero-ru__trustlines">
            <p class="hero-ru__trust">Бесплатно · Без регистрации · Расчёт в вашем браузере</p>
            <p class="hero-ru__trust">Положения сверены с NASA JPL Horizons · <a href="/ru/methodology/">Как мы считаем</a></p>
          </div>
        </div>
      </div>
    </div>
    <script is:inline>
      // The poster remains the LCP and the complete reduced-motion or
      // constrained-data experience. Video sources attach only after a real
      // interaction; offscreen ambient work pauses and resumes safely.
      (function () {
        var v = document.querySelector('[data-hero-video-ru]');
        var p = document.querySelector('[data-hero-poster-ru]');
        if (!v || !p) return;
        var frame = v.closest('.hero-ru__frame');
        var connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
        var reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
        var constrained = connection && (
          connection.saveData ||
          ['slow-2g', '2g'].indexOf(connection.effectiveType) !== -1
        );
        var visible = true;
        var interacted = false;
        var playbackRequested = false;
        var playPending = false;
        var posterFallback = false;
        var playAttempt = 0;
        var abortRetried = false;

        var detachSources = function () {
          playAttempt += 1;
          playPending = false;
          v.querySelectorAll('source[data-src]').forEach(function (source) {
            source.removeAttribute('src');
          });
          delete v.dataset.sourcesAttached;
          v.preload = 'none';
          v.load();
        };
        var attachSources = function () {
          if (!v.dataset.sourcesAttached) {
            v.querySelectorAll('source[data-src]').forEach(function (source) {
              source.src = source.dataset.src;
            });
            v.dataset.sourcesAttached = 'true';
            v.preload = 'auto';
            v.load();
          }
        };
        var usePosterFallback = function () {
          if (posterFallback) return;
          posterFallback = true;
          playAttempt += 1;
          playPending = false;
          v.dataset.heroPlayback = 'poster-fallback';
          v.classList.remove('is-playing');
          v.pause();
          detachSources();
        };
        var tryPlay = function () {
          if (!playbackRequested || !visible || document.hidden || constrained || reducedQuery.matches || posterFallback || playPending) return;
          attachSources();
          var attempt = ++playAttempt;
          playPending = true;
          v.dataset.heroPlayback = 'loading';
          var promise;
          try {
            promise = v.play();
          } catch (error) {
            usePosterFallback();
            return;
          }
          if (!promise || !promise.then) {
            playPending = false;
            abortRetried = false;
            v.dataset.heroPlayback = 'playing';
            v.classList.add('is-playing');
            return;
          }
          promise.then(function () {
            if (attempt !== playAttempt) return;
            playPending = false;
            abortRetried = false;
            if (!visible || document.hidden) {
              v.pause();
              v.dataset.heroPlayback = 'paused';
              return;
            }
            v.dataset.heroPlayback = 'playing';
            v.classList.add('is-playing');
          }).catch(function (error) {
            if (attempt !== playAttempt) return;
            playPending = false;
            if (error && error.name === 'AbortError') {
              v.dataset.heroPlayback = 'paused';
              if (visible && !document.hidden && !abortRetried) {
                abortRetried = true;
                window.setTimeout(tryPlay, 0);
              }
              return;
            }
            usePosterFallback();
          });
        };

        var setVisible = function (nextVisible) {
          visible = Boolean(nextVisible) && !document.hidden;
          p.dataset.heroVisible = String(visible);
          v.dataset.heroVisible = String(visible);
          if (!visible) {
            playAttempt += 1;
            playPending = false;
            if (playbackRequested) v.pause();
            if (v.dataset.heroPlayback === 'playing' || v.dataset.heroPlayback === 'loading') v.dataset.heroPlayback = 'paused';
            return;
          }
          tryPlay();
        };

        var beginPlayback = function () {
          if (interacted) return;
          interacted = true;
          v.dataset.heroInteracted = 'true';
          if (constrained || reducedQuery.matches) return;
          playbackRequested = true;
          tryPlay();
        };

        p.dataset.heroMotion = reducedQuery.matches ? 'static' : 'drift';
        v.dataset.heroPlayback = 'poster';
        setVisible(!frame || frame.getBoundingClientRect().bottom > 0);

        ['pointerdown', 'touchstart', 'keydown'].forEach(function (eventName) {
          window.addEventListener(eventName, beginPlayback, { once: true, passive: true, capture: true });
        });

        if (frame && 'IntersectionObserver' in window) {
          var observer = new IntersectionObserver(function (entries) {
            setVisible(entries[0] && entries[0].isIntersecting);
          }, { threshold: 0.01 });
          observer.observe(frame);
        }

        document.addEventListener('visibilitychange', function () {
          if (document.hidden) setVisible(false);
          else setVisible(!frame || frame.getBoundingClientRect().bottom > 0);
        });

        reducedQuery.addEventListener && reducedQuery.addEventListener('change', function () {
          p.dataset.heroMotion = reducedQuery.matches ? 'static' : 'drift';
          if (reducedQuery.matches) {
            playAttempt += 1;
            playPending = false;
            if (playbackRequested) v.pause();
            v.dataset.heroPlayback = 'paused';
            v.classList.remove('is-playing');
            return;
          }
          if (interacted && !constrained && !posterFallback) {
            playbackRequested = true;
            tryPlay();
          }
        });

        v.addEventListener('error', function () {
          if (constrained || posterFallback || !playbackRequested || !v.dataset.sourcesAttached) return;
          if (v.dataset.sourceRetry === 'true') {
            usePosterFallback();
            return;
          }
          v.dataset.sourceRetry = 'true';
          playPending = false;
          detachSources();
          window.setTimeout(function () {
            if (posterFallback || !visible) return;
            attachSources();
            tryPlay();
          }, 0);
        });
        window.addEventListener('pagehide', function () {
          playAttempt += 1;
          playPending = false;
          if (playbackRequested) v.pause();
        });
        window.addEventListener('pageshow', function (event) {
          if (event.persisted) setVisible(!frame || frame.getBoundingClientRect().bottom > 0);
        });
      })();
    </script>

    <!-- Lens filters for the glass chrome: capsule displacement maps ride
         inline so nothing is fetched. Browsers without url() backdrop
         filters never leave the blur floor. -->
    <svg class="glass-defs" aria-hidden="true" focusable="false">
      <filter id="zdx-lens-cta" color-interpolation-filters="sRGB" primitiveUnits="objectBoundingBox" x="-0.1" y="-0.2" width="1.2" height="1.4">
        <feImage href={glassMaps.cta} x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="map" />
        <feDisplacementMap in="SourceGraphic" in2="map" scale="0.5" xChannelSelector="R" yChannelSelector="G" result="disp" />
        <feGaussianBlur in="disp" stdDeviation="0.009 0.038" result="soft" />
        <feColorMatrix in="soft" type="saturate" values="1.4" />
      </filter>
      <filter id="zdx-lens-nav" color-interpolation-filters="sRGB" primitiveUnits="objectBoundingBox" x="-0.1" y="-0.2" width="1.2" height="1.4">
        <feImage href={glassMaps.nav} x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="map" />
        <feDisplacementMap in="SourceGraphic" in2="map" scale="0.35" xChannelSelector="R" yChannelSelector="G" result="disp" />
        <feGaussianBlur in="disp" stdDeviation="0.005 0.038" result="soft" />
        <feColorMatrix in="soft" type="saturate" values="1.35" />
      </filter>
    </svg>
  </section>

  <!-- The empty SSR island still hydrates automatically, 600ms after load,
       while its profile modules leave the poster's first paint clear. -->
  <WelcomeBack client:interaction locale="ru" />

  <section class="container ticker-band reveal">
    <SkyTicker client:visible locale="ru" />
  </section>

  <section class="container pace-act">
    <div class="section-head reveal">
      <h2>Начните со своей карты</h2>
      <p>Найдите натальную карту, лунный знак, асцендент и совместимость, а затем посмотрите на сегодняшнее небо.</p>
    </div>
    <div class="home-tools-ru">
      {tools.map((tool, i) => (
        <a class="tile reveal" href={tool.href} style={`--sign:${tool.hue};--reveal-delay:${i * 60}ms`}>
          <div class="home-tool-ru">
            <ToolGlyph kind={tool.kind} />
            <h3>{tool.title}</h3>
            <p>{tool.promise}</p>
            <span class="home-tool-ru__go">Открыть →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="container pace-tight" id="signs">
    <div class="section-head reveal">
      <h2>Двенадцать знаков</h2>
      <p>Ясные гиды по каждому знаку: характер, отношения, совместимость и его роль в вашей карте.</p>
    </div>
    <div class="twelve-ru">
      {SIGNS.map((sign, i) => (
        <a class="tile reveal" href={`/ru/${sign.slug}/`} style={`--sign:${sign.hue};--reveal-delay:${(i % 6) * 45}ms`}>
          <div class="twelve-ru__card">
            <SignIcon sign={sign.slug} size={64} />
            <strong>{signName(sign, 'ru')}</strong>
            <span class="mono twelve-ru__dates">{signDates(sign, 'ru')}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="container close-ru pace-sec pace-end">
    <h2 class="display reveal">Начните со своей натальной карты.</h2>
    <div class="reveal" style="--reveal-delay:120ms">
      <a class="btn btn--primary" href="/ru/birth-chart/"><span>Постройте бесплатную натальную карту</span><span class="orb">↗</span></a>
    </div>
  </section>
  <HomeTrustFaq locale="ru" />
</Base>

<style>
  /* ── Vertical rhythm — one-sided padding in three tiers; the hairline
     marks the act break. Mirrors the EN homepage scale. ── */
  .pace-act { padding-top: clamp(72px, 9.5vw, 132px); }
  .pace-act--rule {
    margin-top: clamp(40px, 5vw, 64px);
    border-top: 1px solid var(--hair-1);
    padding-top: clamp(44px, 5.5vw, 72px);
  }
  .pace-tight { padding-top: clamp(36px, 4.5vw, 60px); }
  .pace-sec { padding-top: clamp(48px, 6.5vw, 88px); }
  .pace-end { padding-bottom: clamp(80px, 10vw, 132px); }


  .hero-ru {
    /* Rise behind the fixed nav so the glass refracts the footage on
       first paint (matches the English homepage). */
    margin-top: calc(-1 * var(--nav-space, 96px));
    width: min(100% - 32px, 1440px);
    padding-block: 0 clamp(14px, 2vw, 22px);
  }
  .hero-ru__frame {
    position: relative;
    overflow: hidden;
    border-radius: clamp(18px, 2.6vw, 30px);
    min-height: clamp(560px, calc(100svh - 40px), 900px);
    background: var(--void-1);
    box-shadow: inset 0 0 0 1px rgba(198, 204, 218, 0.10), 0 30px 80px -40px rgba(0, 0, 0, 0.8);
    isolation: isolate;
  }
  .hero-ru__poster,
  .hero-ru__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    transform: scale(1.035);
    transform-origin: center;
  }
  .hero-ru__poster { display: block; }
  .hero-ru__video {
    opacity: 0;
    transition: opacity 420ms ease;
  }
  .hero-ru__video.is-playing { opacity: 1; }
  @keyframes hero-poster-drift {
    0% { transform: scale(1.035) translate3d(0, 0, 0); }
    100% { transform: scale(1.06) translate3d(-0.55%, 0.4%, 0); }
  }
  @media (max-width: 719px) and (prefers-reduced-motion: no-preference) {
    .hero-ru__poster[data-hero-motion='drift'] {
      animation: hero-poster-drift 18s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
      will-change: transform;
    }
    .hero-ru__poster[data-hero-visible='false'] { animation-play-state: paused; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-ru__video { transition: none; }
  }
  .hero-ru__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(6, 7, 9, 0.62) 0%, rgba(6, 7, 9, 0.34) 36%, rgba(6, 7, 9, 0.72) 100%);
  }
  .hero-ru__content {
    position: relative;
    z-index: 2;
    min-height: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: calc(clamp(100px, 13svh, 132px) + env(safe-area-inset-top)) clamp(22px, 4vw, 56px) clamp(28px, 5vw, 64px);
    text-align: center;
  }
  .hero-ru h1 {
    margin: 0 0 clamp(14px, 2vw, 20px);
    max-width: 9.53em; /* 14ch of Instrument — font-independent so fallback text can't resize the box */
    font-family: var(--font-sans);
    font-size: clamp(2.35rem, 0.95rem + 5.8vw, 5.9rem);
    line-height: 0.95;
    font-weight: 690;
    text-transform: uppercase;
    color: var(--ink-0, #EEF1F7);
    text-wrap: balance;
    text-shadow: 0 2px 28px rgba(6, 7, 9, 0.55);
  }
  /* Caption and buttons sink to the base of the frame; the headline
     stays pinned at the top. */
  .hero-ru__foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(20px, 3vw, 28px);
  }
  .hero-ru p {
    margin: 0;
    max-width: 33.3em; /* 50ch of Instrument */
    color: var(--ink-1, #C6CCDA);
    font-size: clamp(0.95rem, 0.85rem + 0.5vw, 1.125rem);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .hero-ru__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .hero-ru__trustlines { margin: -2px 0 0; display: grid; gap: 4px; justify-items: center; }
  .hero-ru__foot .hero-ru__trust { margin: 0; max-width: none; font-family: var(--font-mono); font-size: 10.5px; line-height: 1.45; letter-spacing: 0.055em; color: var(--faint); text-shadow: 0 1px 14px rgba(6, 7, 9, 0.72); text-align: center; }
  .hero-ru__trust a { color: inherit; text-underline-offset: 2px; }
  .hero-ru__ghost {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0) 46%),
      rgba(10, 12, 17, 0.46);
    backdrop-filter: blur(14px) saturate(150%) brightness(1.12);
    -webkit-backdrop-filter: blur(14px) saturate(150%) brightness(1.12);
    border-color: rgba(238, 241, 247, 0.42);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 -12px 22px -14px rgba(255, 255, 255, 0.08),
      0 8px 26px -12px rgba(0, 0, 0, 0.5);
  }
  .hero-ru__ghost:hover { background: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0) 46%), rgba(10, 12, 17, 0.6); }

  /* Primary CTA glass — arrow disc stays a solid white token (matches EN). */
  .hero-ru__ctas .btn--primary {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0) 46%),
      rgba(10, 12, 17, 0.46);
    backdrop-filter: blur(14px) saturate(150%) brightness(1.12);
    -webkit-backdrop-filter: blur(14px) saturate(150%) brightness(1.12);
    border-color: rgba(238, 241, 247, 0.46);
    color: var(--ink-0, #EEF1F7);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.34),
      inset 0 -12px 22px -14px rgba(255, 255, 255, 0.08),
      0 8px 26px -12px rgba(0, 0, 0, 0.5);
  }
  .hero-ru__ctas .btn--primary:hover {
    background: rgba(10, 12, 17, 0.6);
    border-color: rgba(238, 241, 247, 0.42);
  }
  .hero-ru__ctas .btn--primary .orb {
    background: var(--ink-0, #EEF1F7);
    border-color: rgba(238, 241, 247, 0.5);
    color: var(--void-0, #060709);
  }
  .hero-ru__ctas .btn--primary:hover .orb { background: #ffffff; }

  /* ── Liquid glass (homepage chrome only) — matches the English hero. ── */
  .glass-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  /* Chromium-only refraction lens (.zdx-lens set by Base.astro's inline
     script); Safari/iOS keep the frosted blur floor above. */
  :global(html.zdx-lens) .hero-ru__ghost {
    background: rgba(10, 12, 17, 0.34);
    backdrop-filter: url(#zdx-lens-cta);
    -webkit-backdrop-filter: url(#zdx-lens-cta);
    border-color: rgba(238, 241, 247, 0.28);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.20),
      inset 0 -1px 0 rgba(255, 255, 255, 0.06),
      0 10px 30px -12px rgba(0, 0, 0, 0.55);
  }
  :global(html.zdx-lens) .hero-ru__ghost:hover { background: rgba(10, 12, 17, 0.5); }
  :global(html.zdx-lens) .hero-ru__ctas .btn--primary {
    background: rgba(10, 12, 17, 0.34);
    backdrop-filter: url(#zdx-lens-cta);
    -webkit-backdrop-filter: url(#zdx-lens-cta);
    border-color: rgba(238, 241, 247, 0.30);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.20),
      inset 0 -1px 0 rgba(255, 255, 255, 0.06),
      0 10px 30px -12px rgba(0, 0, 0, 0.55);
  }
  :global(html.zdx-lens) .hero-ru__ctas .btn--primary:hover { background: rgba(10, 12, 17, 0.5); }
  :global(html.zdx-lens .nav-wrap .nav) {
    background: rgba(10, 12, 17, 0.56);
    backdrop-filter: url(#zdx-lens-nav);
    -webkit-backdrop-filter: url(#zdx-lens-nav);
    box-shadow:
      inset 0 1px 0 rgba(238, 241, 247, 0.10),
      inset 0 -1px 0 rgba(238, 241, 247, 0.04),
      0 12px 32px -14px rgba(0, 0, 0, 0.7);
  }
  @media (prefers-reduced-transparency: reduce) {
    .hero-ru__ghost,
    .hero-ru__ctas .btn--primary {
