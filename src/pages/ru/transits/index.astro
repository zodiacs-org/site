---
import Base from '../../../layouts/Base.astro';
import Faq from '../../../components/Faq.astro';
import TransitTracker from '../../../islands/TransitTracker';
import '../../../styles/calculator.css';

const faq = [
  {
    q: 'Что такое транзит?',
    a: 'После вашего рождения планеты продолжили движение. Транзит — это текущее положение планеты по отношению к точке натальной карты. Например, квадратура транзитного Сатурна к натальной Луне означает, что сейчас Сатурн находится под углом 90 градусов к положению Луны при вашем рождении.',
  },
  {
    q: 'Какие транзиты показывает страница?',
    a: 'Она показывает аспекты десяти планет неба к десяти планетам вашей карты при орбисе не больше 3 градусов. Дату можно двигать на год вперёд или назад. Транзитная Луна остаётся на внешнем кольце, но не входит в список: за месяц она проходит всю карту.',
  },
  {
    q: 'Почему медленные транзиты важнее?',
    a: 'Скорость определяет длительность. Солнце проходит натальную точку примерно за два дня, Марс — за неделю или две, а Сатурн может оставаться в пределах 3 градусов месяцами, Плутон — годами. Ретроградные петли часто дают три прохода, поэтому такие транзиты читаются как главы, а не мимолётное настроение.',
  },
  {
    q: 'Нужно ли точное время рождения?',
    a: 'Для большинства транзитов — нет: аспектам между планетами достаточно даты и места. Исключение — Луна. Без времени она считается на полдень и может сместиться до шести градусов; инструмент предупредит о такой неопределённости.',
  },
];

const jsonLd = [
  {
    '@type': 'WebPage',
    name: 'Транзиты сегодня на фоне вашей карты',
    url: 'https://zodiacs.org/ru/transits/',
    description: 'Движущееся небо на фоне натальной карты: транзиты с орбисом до 3 градусов сегодня или на дату в пределах года.',
    inLanguage: 'ru',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
  {
    '@type': 'FAQPage',
    inLanguage: 'ru',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  clientUi
  title="Транзиты планет сегодня — к вашей натальной карте"
  description="Постройте карту и смотрите сегодняшние транзиты к ней — с орбисами, градусами и временем UTC."
  path="/ru/transits/"
  locale="ru"
  image="/assets/og/v2/tool/transits.png"
  imageAlt="Транзиты на фоне натальной карты — Zodiacs.org"
  jsonLd={jsonLd}
  glass
>
  <section class="section--tight container container--narrow">
    <div class="tool-hero reveal">
      <h1 class="display">Небо на фоне вашей карты.</h1>
      <p>Сегодняшние планеты в сравнении с вашими, орбис до 3° и ползунок на год вперёд или назад. Посмотрите, как транзит складывается, становится точным и расходится. Выберите сохранённую карту или введите данные — они не покидают устройство.</p>
    </div>
    <TransitTracker locale="ru" client:load />
    <noscript>
      <p>Для расчёта транзитов нужен JavaScript. Включите его и перезагрузите страницу, чтобы сравнить текущее небо с натальной картой в вашем браузере.</p>
    </noscript>
  </section>

  <section class="section--tight container container--narrow">
    <Faq items={faq} heading="Вопросы о транзитах" />
  </section>
</Base>

<style>
  .tool-hero { max-width: 62ch; margin-bottom: clamp(24px, 4vw, 36px); }
  .tool-hero h1 { margin: 0 0 16px; font-size: var(--text-2xl); line-height: 1.04; }
  .tool-hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }
</style>
