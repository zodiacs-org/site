---
import Base from '../../../layouts/Base.astro';
import Faq from '../../../components/Faq.astro';
import BabyZodiac from '../../../islands/BabyZodiac';
import '../../../styles/calculator.css';

const faq = [
  {
    q: 'Какой знак зодиака будет у ребёнка?',
    a: 'Введите предполагаемую дату родов. Солнечный знак на эту дату почти наверняка известен, потому что Солнце проводит в каждом знаке около месяца. Честные исключения — границы знаков и рождение на несколько недель раньше или позже; инструмент рассчитывает варианты, а не угадывает.',
  },
  {
    q: 'Можно ли узнать лунный знак до рождения?',
    a: 'Только как короткий список. Луна меняет знак каждые два-три дня, поэтому неделя вокруг даты родов обычно охватывает два-три лунных знака. День и час рождения решат, какой именно.',
  },
  {
    q: 'А асцендент?',
    a: 'Его нельзя предсказать. Асцендент меняется примерно каждые два часа и полностью зависит от минуты и места рождения. Поэтому для расчёта важна запись точного времени.',
  },
  {
    q: 'Ретроградная планета при рождении — это плохо?',
    a: 'Нет. Ретроградности нормальны: Меркурий ретрограден примерно пятую часть времени. В натальной карте ретроградную планету обычно читают как более обращённую внутрь энергию. Это нюанс, а не дефект.',
  },
  {
    q: 'Когда строить настоящую натальную карту?',
    a: 'Когда у вас будет записано время рождения. Дата, точное время и место позволяют рассчитать лунный знак, асцендент, дома и аспекты. Расчёт выполняется на вашем устройстве.',
  },
];

const jsonLd = [
  {
    '@type': 'WebPage',
    name: 'Знак ребёнка по дате родов',
    url: 'https://zodiacs.org/ru/baby-zodiac/',
    description: 'Предполагаемый солнечный знак, возможные лунные знаки недели и то, что нельзя узнать до точной минуты рождения.',
    inLanguage: 'ru',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
  {
    '@type': 'FAQPage',
    inLanguage: 'ru',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  clientUi
  title="Какой знак зодиака будет у ребёнка — по дате родов"
  description="Что можно знать о знаках ребёнка до рождения — честно: Солнце почти наверняка, Луна — один из нескольких, асцендент ждёт минуты."
  path="/ru/baby-zodiac/"
  locale="ru"
  image="/assets/og/v2/tool/baby-zodiac.png"
  imageAlt="Знак ребёнка по дате родов — Zodiacs.org"
  jsonLd={jsonLd}
>
  <section class="section--tight container container--narrow">
    <div class="tool-hero reveal">
      <h1 class="display">Какой знак будет у ребёнка?</h1>
      <p>
        Введите предполагаемую дату родов и получите честный ответ:
        солнечный знак почти наверняка известен, лунный — короткий список,
        а асцендент ждёт точной минуты. Всё считается на вашем устройстве.
      </p>
    </div>
    <BabyZodiac locale="ru" client:load />
    <noscript>
      <p>Для этого расчёта нужен JavaScript. Включите его и перезагрузите страницу, чтобы увидеть варианты Солнца, диапазон Луны и ретроградности рядом с датой родов.</p>
    </noscript>
  </section>

  <section class="section--tight container container--narrow">
    <div class="prose reveal">
      <p>
        Солнце проводит в каждом знаке около месяца, поэтому предполагаемая
        дата обычно даёт уверенный ответ. Исключения — граница знаков и более
        ранние роды — рассчитываются выше. Луна меняет знак каждые два-три
        дня, асцендент — примерно каждые два часа. После рождения{' '}
        <a href="/ru/birth-chart/">полная натальная карта</a> рассчитает всё.
      </p>
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <Faq items={faq} heading="Вопросы о знаках ребёнка" />
  </section>
</Base>

<style>
  .tool-hero { max-width: 62ch; margin-bottom: clamp(24px, 4vw, 36px); }
  .tool-hero h1 {
    margin: 0 0 16px;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1.04;
    text-wrap: balance;
  }
  .tool-hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }
</style>
