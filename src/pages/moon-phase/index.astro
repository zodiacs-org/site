---
import Base from '../../layouts/Base.astro';
import MoonPhaseTool from '../../islands/MoonPhaseTool';
import sky from '../../data/sky.json';
import { bodyLongitude } from '../../lib/engine/full';
import { formatLongitude } from '../../lib/signs';
import { formatShortDate } from '../../lib/i18n/dates';
import '../../styles/calculator.css';

// Build-time: the next lunations from the committed sky data, with the
// Moon's exact position computed here in Node — no client ephemeris.
const buildNow = new Date();
const upcoming = (sky.moons as { type: string; at: string }[])
  .filter((m) => new Date(m.at) >= buildNow)
  .slice(0, 8)
  .map((m) => {
    const at = new Date(m.at);
    return {
      type: m.type === 'new' ? 'New moon' : 'Full moon',
      when: formatShortDate('en', at),
      where: formatLongitude(bodyLongitude('Moon', at)),
    };
  });

const faq = [
  {
    q: 'What phase is the moon in tonight?',
    a: 'The dial at the top of this page computes it live on your device: the current phase name, the illuminated percentage, and the sign the Moon occupies right now, timestamped in universal time.',
  },
  {
    q: 'What was the moon phase on my birthday?',
    a: 'Enter your birth date in the lookup above. Without a time, the result describes a reference moment; the phase can change within the date. Add a time and place to calculate the phase for your local birth moment. Astrologers read a birth phase as a temperament note: new-moon people start things, full-moon people are said to live more publicly.',
  },
  {
    q: 'How often is there a full moon?',
    a: 'Every 29.5 days on average — the synodic month. That drift against the calendar is why the full moon wanders through the month, and why a second full moon occasionally lands in one calendar month: the blue moon.',
  },
  {
    q: 'Does the moon phase affect my moon sign?',
    a: 'They are two different measurements. The phase compares the Moon to the Sun; the moon sign is where the Moon stood in the zodiac. You can have a full moon in any of the twelve signs. Your moon sign is the one astrologers read for emotional temperament.',
  },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    name: 'Moon Phase Tool',
    url: 'https://zodiacs.org/moon-phase/',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  clientUi
  title="Moon Phase Today & On Your Birthday | Zodiacs.org"
  description="See tonight's moon phase or look up any date you care about: phase, illumination, and moon sign, free."
  path="/moon-phase/"
  image="/assets/og/v2/tool/moon-phase.png"
  imageAlt="Moon phase, tonight and any night — Zodiacs.org"
  jsonLd={jsonLd}
>
  <section class="section--tight container">
    <div class="tool-hero">
      <h1 class="display">The moon, tonight and any night.</h1>
      <p>
        Tonight’s <a href="/learn/glossary/#moon-phase">phase</a>, illumination, and sign. Below it, a lookup for
        the <a href="/learn/glossary/#moon">moon</a> you were born under, or any date that matters to you.
      </p>
    </div>

    <MoonPhaseTool client:load />
    <noscript>
      <p>This Moon phase calculator needs JavaScript. Enable it and reload to see tonight's phase or look up the Moon phase for another date.</p>
    </noscript>
  </section>

  <section class="section--tight container container--narrow">
    <div class="section-head">
      <h2>Upcoming lunations</h2>
      <p>
        New and <a href="/learn/glossary/#full-moon">full moons</a> over the months ahead, with the Moon’s
        sign and degree. Every full moon through 2027 — dates, <a href="/learn/glossary/#zodiac-sign">signs</a>, and names —
        is on <a href="/full-moon-calendar/">the full moon calendar</a>.
      </p>
    </div>
    <ul class="lunations">
      {upcoming.map((m) => (
        <li class="lunations__row">
          <span class="lunations__type">{m.type}</span>
          <span class="lunations__when mono">{m.when}</span>
          <span class="lunations__where mono">{m.where}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section--tight container container--narrow">
    <div class="prose">
      <h2>Reading a birthday moon</h2>
      <p>
        The Moon runs its full cycle in about 29.5 days, but its phase can
        change within a date. Without a birth time, the result describes a
        reference moment. Astrologers treat
        the birth phase as a note on temperament — the new-moon start, the
        first-quarter push, the full-moon glare, the balsamic wind-down — and
        it pairs naturally with your <a href="/moon-sign/">moon sign</a>, which
        describes what the Moon was doing in the <a href="/learn/glossary/#zodiac">zodiac</a> rather than against
        the Sun.
      </p>
      <p>
        Both are two lines of a much longer document. When you’re ready for
        the whole thing, <a href="/birth-chart/">run your birth chart</a> —
        every planet, the houses, and the aspects between them.
      </p>
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <div class="section-head"><h2>Questions, answered</h2></div>
    <div class="faq">
      {faq.map(({ q, a }) => (
        <details class="faq__item">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .tool-hero { max-width: 62ch; margin-bottom: clamp(28px, 5vw, 44px); }
  .tool-hero h1 {
    margin: 0 0 16px;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1.04;
    font-variant-numeric: oldstyle-figures;
    text-wrap: balance;
  }
  .tool-hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }

  .lunations { margin: 0; padding: 0; list-style: none; display: grid; }
  .lunations__row {
    display: grid;
    grid-template-columns: 110px 150px minmax(0, 1fr);
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--hair-1);
    align-items: baseline;
  }
  .lunations__row:first-child { border-top: 1px solid var(--hair-1); }
  .lunations__type { font-weight: 600; font-size: var(--text-sm); color: var(--text); }
  .lunations__when, .lunations__where { font-size: 12px; color: var(--muted); }

  @media (max-width: 540px) {
    .lunations__row { grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); gap: 4px 12px; }
    .lunations__where { grid-column: 2; }
  }
  .faq { display: grid; gap: 8px; }
  .faq__item {
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: var(--void-1);
    padding: 4px 18px;
  }
  .faq__item summary { cursor: pointer; padding: 12px 0; font-weight: 550; color: var(--text); }
  .faq__item p { margin: 2px 0 16px; color: var(--text-2); font-size: var(--text-sm); line-height: 1.65; }
</style>
