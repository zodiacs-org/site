---
import Base from '../layouts/Base.astro';
import HomeShareTools from '../components/sharing/HomeShareTools.astro';
import { homeTrustFaq } from '../lib/home-trust';
import AstroTerm from '../components/AstroTerm.astro';
import RaceRamp from '../components/RaceRamp.astro';
import SignIcon from '../components/SignIcon.astro';
import ToolGlyph from '../components/ToolGlyph.astro';
import SkyTicker from '../islands/SkyTicker';
import TodayBySign from '../islands/TodayBySign';
import DemoChart from '../islands/DemoChart';
import WelcomeBack from '../islands/WelcomeBack';
import glassMaps from '../data/glass-maps.json';
import { absoluteBrandIconUrl, BRAND_ICON_PATHS } from '../lib/brand-icons.mjs';
import { UI } from '../lib/i18n';
import { SIGNS } from '../lib/signs';
import { ORGANIZATION_NAME, SOCIAL_PROFILES } from '../strings/seo.en.mjs';
import homeFirstPaintCss from '../home/home-first-paint.css?inline';
import '../styles/today.css';

const faq = [
  ...homeTrustFaq('en'),
  {
    q: 'What happens to my birth data?',
    a: 'The calculation runs entirely in your browser. Saving a chart stores it on this device first; if you choose account sync, your saved charts upload to your account (stored with row-level security) so they can follow you across devices.',
  },
  {
    q: "What if I don't know my birth time?",
    a: 'Choose “I don’t know it.” The calculator uses 12:00 as a reference, leaves out the rising sign and houses instead of inventing them, and marks the Moon sign as unverified until you add a time, because the Moon can change sign during a day.',
  },
];

const jsonLd = [
  {
    '@type': 'Organization',
    '@id': 'https://zodiacs.org/#org',
    name: ORGANIZATION_NAME,
    legalName: 'Zodiacs LLC',
    alternateName: 'Zodiacs.org',
    url: 'https://zodiacs.org/',
    email: 'admin@zodiacs.org',
    foundingDate: '2026-08-11',
    logo: {
      '@type': 'ImageObject',
      url: absoluteBrandIconUrl(BRAND_ICON_PATHS.icon512),
      width: 512,
      height: 512,
    },
    sameAs: SOCIAL_PROFILES,
  },
  {
    '@type': 'WebSite',
    '@id': 'https://zodiacs.org/#site',
    url: 'https://zodiacs.org/',
    name: 'Zodiacs.org',
    description: 'Free birth charts, moon signs, compatibility, horoscopes, and sign guides — private in your browser.',
    publisher: { '@id': 'https://zodiacs.org/#org' },
    inLanguage: 'en',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a, ...rest }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];

const tools = [
  { href: '/birth-chart/', title: 'Birth chart', promise: 'Your sun, moon, rising, planets, houses, and what they mean.', hue: 'var(--sign-cancer)', kind: 'birth' as const },
  { href: '/moon-sign/', title: 'Moon sign', promise: 'How you feel — and what helps you feel at home.', hue: 'var(--sign-pisces)', kind: 'moon' as const },
  { href: '/rising-sign/', title: 'Rising sign', promise: 'How people first meet you.', hue: 'var(--sign-libra)', kind: 'rising' as const },
  { href: '/compatibility/', title: 'Compatibility', promise: 'See how two charts connect.', hue: 'var(--sign-leo)', kind: 'compat' as const },
];
---
<Base
  inlineCriticalCss
  stableTypography
  localTypography
  localChromeTypography
  title="Zodiacs.org — Free Birth Charts, Sign Guides & Astrology Tools"
  description="Free birth charts calculated in your browser, plus moon signs, compatibility, horoscopes, and sign guides with clear explanations."
  path="/"
  image="/assets/og/v2/share-pastel-wheel-20260809.png"
  imageAlt="Zodiacs homepage preview on black with a large ring of twelve pastel zodiac symbols and the headline “Your whole chart, not just your sign.”"
  jsonLd={jsonLd}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/assets/hero/zodiacs-hero-poster-mobile-v2.avif"
    media="(max-width: 719px)"
    fetchpriority="high"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/assets/hero/zodiacs-hero-poster.avif"
    media="(min-width: 720px)"
    fetchpriority="high"
  />
  <!-- The hero's two optional faces. Chromium holds the first frame for a
       preloaded optional font, for at most its 100 ms block period, so the
       hero is laid out once, in whichever face is ready. Without the preload
       a face that arrived inside the block period re-laid the hero foot out
       after the first frame: CLS 0.056 in one of three CI samples on
       2026-09-29. After the poster hints, so the poster stays first. -->
  <link
    slot="head"
    rel="preload"
    as="font"
    type="font/woff2"
    href="/assets/home/instrument-sans-home-nav-core.woff2"
    crossorigin
  />
  <link
    slot="head"
    rel="preload"
    as="font"
    type="font/woff2"
    href="/assets/home/eb-garamond-home-400-core.woff2"
    crossorigin
  />
  <style
    slot="head"
    is:inline
    data-zdx-home-first-paint
    set:html={homeFirstPaintCss}
  />
  <!-- Legacy hash deep-links from the old homepage SPA → their new homes. -->
  <script is:inline>
    (function () {
      var h = location.hash;
      if (['#verify', '#registry', '#official-twelve', '#faq-registry', '#identity'].indexOf(h) !== -1) location.replace('/registry/' + h);
      else if (['#market', '#pulse', '#standings'].indexOf(h) !== -1) location.replace('/terminal/' + h);
      else if (h === '#sdk') location.replace('/sdk/');
    })();
  </script>

  <!-- 01 · Hero — one rounded cinematic frame, headline over the footage. -->
  <section class="hero container">
    {/* No reveal on the hero frame: the poster is the LCP and must paint
        before any script runs — the RU release set this pattern. */}
    <div class="hero__frame">
      <picture>
        <source
          media="(max-width: 719px)"
          srcset="/assets/hero/zodiacs-hero-poster-mobile-v2.avif"
          type="image/avif"
        />
        <img
          class="hero__poster"
          src="/assets/hero/zodiacs-hero-poster.avif"
          width="1600"
          height="900"
          loading="eager"
          fetchpriority="high"
          alt=""
          aria-hidden="true"
          data-hero-poster
        />
      </picture>
      <video
        class="hero__video"
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        aria-hidden="true"
        tabindex="-1"
        data-hero-video
      >
        <source data-src="/assets/hero/zodiacs-hero-av1.mp4" type='video/mp4; codecs="av01.0.08M.08"' />
        <source data-src="/assets/hero/zodiacs-hero.mp4" type="video/mp4" />
      </video>
      <button class="hero-motion" type="button" data-hero-motion-toggle aria-pressed="false">Pause motion</button>
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="hero__content">
        <h1 class="hero__title">Your whole chart, <em>not just your sign.</em></h1>
        <div class="hero__foot">
          <p class="hero__sub">
            Birth charts calculated in your browser.
            Clear astrology readings and tools, free to explore.
          </p>
          <div class="hero__ctas">
            <a class="btn btn--primary" href="/birth-chart/"><span>Get your free birth chart</span><span class="orb">↗</span></a>
            <a class="btn btn--ghost hero__ghost" href="/horoscopes/"><span>Your horoscope</span></a>
          </div>
          <p class="hero__trust">Free · No signup · Calculated in your browser</p>
        </div>
      </div>
    </div>
    <script is:inline>
      // The poster is the LCP and the complete reduced-motion / constrained-data
      // experience. Mobile video remains detached until the first interaction;
      // desktop preserves its released autoplay. Offscreen ambient work pauses.
      (function () {
        var v = document.querySelector('[data-hero-video]');
        var p = document.querySelector('[data-hero-poster]');
        if (!v || !p) return;
        var frame = v.closest('.hero__frame');
        var connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
        var reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
        var compactViewport = window.matchMedia('(max-width: 719px)').matches;
        var constrained = connection && (
          connection.saveData ||
          ['slow-2g', '2g'].indexOf(connection.effectiveType) !== -1
        );
        var manuallyPaused = false;
        try { manuallyPaused = sessionStorage.getItem('zodiacs:motion-paused') === '1'; } catch (_) {}
        var toggle = document.querySelector('[data-hero-motion-toggle]');
        var visible = true;
        var interacted = false;
        var playbackRequested = false;
        var playPending = false;
        var posterFallback = false;
        var playAttempt = 0;
        var abortRetried = false;

        var detachSources = function () {
          playAttempt += 1;
          playPending = false;
          v.querySelectorAll('source[data-src]').forEach(function (source) {
            source.removeAttribute('src');
          });
          delete v.dataset.sourcesAttached;
          v.preload = 'none';
          v.load();
        };
        var attachSources = function () {
          if (!v.dataset.sourcesAttached) {
            v.querySelectorAll('source[data-src]').forEach(function (source) {
              source.src = source.dataset.src;
            });
            v.dataset.sourcesAttached = 'true';
            v.preload = 'auto';
            v.load();
          }
        };
        var usePosterFallback = function () {
          if (posterFallback) return;
          posterFallback = true;
          playAttempt += 1;
          playPending = false;
          v.dataset.heroPlayback = 'poster-fallback';
          v.classList.remove('is-playing');
          v.pause();
          detachSources();
        };
        var tryPlay = function () {
          if (manuallyPaused || !playbackRequested || !visible || document.hidden || constrained || reducedQuery.matches || posterFallback || playPending) return;
          attachSources();
          var attempt = ++playAttempt;
          playPending = true;
          v.dataset.heroPlayback = 'loading';
          var promise;
          try {
            promise = v.play();
          } catch (error) {
            usePosterFallback();
            return;
          }
          if (!promise || !promise.then) {
            playPending = false;
            abortRetried = false;
            v.dataset.heroPlayback = 'playing';
            v.classList.add('is-playing');
            return;
          }
          promise.then(function () {
            if (attempt !== playAttempt) return;
            playPending = false;
            abortRetried = false;
            if (!visible || document.hidden) {
              v.pause();
              v.dataset.heroPlayback = 'paused';
              return;
            }
            v.dataset.heroPlayback = 'playing';
            v.classList.add('is-playing');
          }).catch(function (error) {
            if (attempt !== playAttempt) return;
            playPending = false;
            if (error && error.name === 'AbortError') {
              v.dataset.heroPlayback = 'paused';
              if (visible && !document.hidden && !abortRetried) {
                abortRetried = true;
                window.setTimeout(tryPlay, 0);
              }
              return;
            }
            usePosterFallback();
          });
        };

        var setVisible = function (nextVisible) {
          visible = Boolean(nextVisible) && !document.hidden;
          v.dataset.heroVisible = String(visible);
          p.dataset.heroVisible = String(visible);
          if (!visible) {
            playAttempt += 1;
            playPending = false;
            if (playbackRequested) v.pause();
            if (v.dataset.heroPlayback === 'playing' || v.dataset.heroPlayback === 'loading') v.dataset.heroPlayback = 'paused';
            return;
          }
          tryPlay();
        };

        var beginPlayback = function () {
          if (interacted) return;
          interacted = true;
          v.dataset.heroInteracted = 'true';
          if (constrained || reducedQuery.matches) return;
          if (playbackRequested) return;
          playbackRequested = true;
          tryPlay();
        };

        if (toggle && manuallyPaused) { toggle.setAttribute('aria-pressed', 'true'); toggle.textContent = 'Resume motion'; }
        toggle && toggle.addEventListener('click', function () {
          manuallyPaused = !manuallyPaused;
          try { sessionStorage.setItem('zodiacs:motion-paused', manuallyPaused ? '1' : '0'); } catch (_) {}
          toggle.setAttribute('aria-pressed', String(manuallyPaused));
          toggle.textContent = manuallyPaused ? 'Resume motion' : 'Pause motion';
          v.dataset.heroMotion = manuallyPaused || reducedQuery.matches ? 'static' : 'drift';
          p.dataset.heroMotion = v.dataset.heroMotion;
          if (manuallyPaused) { playAttempt += 1; playPending = false; v.pause(); v.classList.remove('is-playing'); v.dataset.heroPlayback = 'paused'; }
          else { playbackRequested = true; tryPlay(); }
        });
        v.dataset.heroMotion = reducedQuery.matches || manuallyPaused ? 'static' : 'drift';
        p.dataset.heroMotion = v.dataset.heroMotion;
        v.dataset.heroPlayback = 'poster';
        setVisible(!frame || frame.getBoundingClientRect().bottom > 0);

        // Preserve the released desktop experience. The interaction gate is for
        // compact viewports, where the poster must remain the LCP surface.
        if (!compactViewport && !constrained && !reducedQuery.matches) {
          playbackRequested = true;
          tryPlay();
        }

        ['pointerdown', 'touchstart', 'keydown'].forEach(function (eventName) {
          window.addEventListener(eventName, beginPlayback, { once: true, passive: true, capture: true });
        });

        if (frame && 'IntersectionObserver' in window) {
          var observer = new IntersectionObserver(function (entries) {
            setVisible(entries[0] && entries[0].isIntersecting);
          }, { threshold: 0.01 });
          observer.observe(frame);
        }

        document.addEventListener('visibilitychange', function () {
          if (document.hidden) setVisible(false);
          else setVisible(!frame || frame.getBoundingClientRect().bottom > 0);
        });

        reducedQuery.addEventListener && reducedQuery.addEventListener('change', function () {
          v.dataset.heroMotion = reducedQuery.matches || manuallyPaused ? 'static' : 'drift';
          p.dataset.heroMotion = v.dataset.heroMotion;
          if (reducedQuery.matches) {
            playAttempt += 1;
            playPending = false;
            if (playbackRequested) v.pause();
            v.dataset.heroPlayback = 'paused';
            return;
          }
          if ((!compactViewport || interacted) && !constrained && !posterFallback) {
            playbackRequested = true;
            tryPlay();
          }
        });

        v.addEventListener('error', function () {
          if (constrained || posterFallback || !playbackRequested || !v.dataset.sourcesAttached) return;
          if (v.dataset.sourceRetry === 'true') {
            usePosterFallback();
            return;
          }
          v.dataset.sourceRetry = 'true';
          playPending = false;
          detachSources();
          window.setTimeout(function () {
            if (posterFallback || !visible) return;
            attachSources();
            tryPlay();
          }, 0);
        });
        window.addEventListener('pagehide', function () {
          playAttempt += 1;
          playPending = false;
          if (playbackRequested) v.pause();
        });
        window.addEventListener('pageshow', function (event) {
          if (event.persisted) setVisible(!frame || frame.getBoundingClientRect().bottom > 0);
        });
      })();
    </script>

    <!-- Lens filters for the glass chrome: capsule displacement maps ride
         inline so nothing is fetched. Browsers without url() backdrop
         filters never leave the blur floor. -->
    <svg class="glass-defs" aria-hidden="true" focusable="false">
      <filter id="zdx-lens-cta" color-interpolation-filters="sRGB" primitiveUnits="objectBoundingBox" x="-0.1" y="-0.2" width="1.2" height="1.4">
        <feImage href={glassMaps.cta} x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="map" />
        <feDisplacementMap in="SourceGraphic" in2="map" scale="0.5" xChannelSelector="R" yChannelSelector="G" result="disp" />
        <feGaussianBlur in="disp" stdDeviation="0.009 0.038" result="soft" />
        <feColorMatrix in="soft" type="saturate" values="1.4" />
      </filter>
      <filter id="zdx-lens-nav" color-interpolation-filters="sRGB" primitiveUnits="objectBoundingBox" x="-0.1" y="-0.2" width="1.2" height="1.4">
        <feImage href={glassMaps.nav} x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="map" />
        <feDisplacementMap in="SourceGraphic" in2="map" scale="0.35" xChannelSelector="R" yChannelSelector="G" result="disp" />
        <feGaussianBlur in="disp" stdDeviation="0.005 0.038" result="soft" />
        <feColorMatrix in="soft" type="saturate" values="1.35" />
      </filter>
    </svg>
  </section>

  <!-- This page's first hydrated island follows the hero. Install the shared
       English catalogue here so its sizeable inline payload cannot delay the
       poster element, while it still precedes every island module. -->
  <script is:inline define:vars={{ homeUiMessages: UI.en }}>
    globalThis.__ZDX_UI__ = { locale: 'en', messages: homeUiMessages };
  </script>

  <!-- 01b · Returning visitors with a saved chart get greeted; everyone else sees nothing here.
       The shared intent/load directive reaches the empty SSR island automatically
       after load, keeping its module tree out of the poster's initial fetches. -->
  <WelcomeBack client:interaction />

  <!-- 02 · The sky, right now -->
  <section class="container ticker-band reveal">
    <!-- The committed sky receipt has no client interactions or live-clock
         state. Its complete server-rendered markup needs no hydration. -->
    <SkyTicker />
  </section>

  <!-- 02b · Interactive proof of the hero promise -->
  <section class="container chart-preview pace-act" id="chart-preview">
    <div class="section-head reveal">
      <em class="kicker">Interactive preview</em>
      <h2>See how a birth chart becomes a story.</h2>
      <p>Explore a real chart without entering anything. Select a sign, planet, house, or connection to see what it means.</p>
    </div>
    <div class="reveal">
      <DemoChart />
      <script is:inline>
        (function () {
          var root = document.querySelector('[data-demo-preview]');
          if (!root) return;

          // The wheel's twelve sign discs ship as data-href (Wheel
          // deferIcons) so they cost nothing while the hero paints; lift
          // them to real hrefs as the section approaches. The 200px margin
          // keeps the swap invisible without pulling the fetches back into
          // the initial load on tall phone viewports.
          var discs = root.querySelectorAll('image[data-href]');
          function liftDiscs() {
            for (var i = 0; i < discs.length; i += 1) {
              discs[i].setAttribute('href', discs[i].getAttribute('data-href'));
              discs[i].removeAttribute('data-href');
            }
          }
          if (discs.length) {
            if ('IntersectionObserver' in window) {
              var discWatch = new IntersectionObserver(function (entries) {
                for (var i = 0; i < entries.length; i += 1) {
                  if (entries[i].isIntersecting) {
                    liftDiscs();
                    discWatch.disconnect();
                    return;
                  }
                }
              }, { rootMargin: '200px 0px' });
              discWatch.observe(root);
            } else {
              liftDiscs();
            }
          }

          var caption = root.querySelector('[data-demo-caption]');
          var title = root.querySelector('[data-demo-title-output]');
          var kind = root.querySelector('[data-demo-kind-output]');
          var targets = root.querySelectorAll('[data-demo-target]');
          var jumps = root.querySelectorAll('[data-demo-jump]');
          var highlights = root.querySelectorAll('[data-demo-highlight]');
          var selector = root.querySelector('[data-demo-select]');
          var enterFrame = 0;
          var settleFrame = 0;
          if (!caption || !title || !kind || !targets.length) return;

          var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
          var targetFor = function (id) {
            return Array.prototype.find.call(targets, function (target) {
              return target.dataset.demoId === id;
            });
          };

          var activate = function (target, event) {
            if (!target) return;
            window.cancelAnimationFrame(enterFrame);
            window.cancelAnimationFrame(settleFrame);
            var instant = !event || event.detail === 0;
            var reducedMotion = !instant && reduced.matches;
            var id = target.dataset.demoId;
            var nextHighlight = null;

            targets.forEach(function (item) {
              item.dataset.selected = item === target ? 'true' : 'false';
              if (item.tagName === 'BUTTON') item.setAttribute('aria-pressed', item === target ? 'true' : 'false');
            });
            if (selector) selector.value = id;
            jumps.forEach(function (item) {
              item.setAttribute('aria-pressed', item.dataset.demoJump === id ? 'true' : 'false');
            });
            highlights.forEach(function (item) {
              item.dataset.active = 'false';
              if (item.dataset.demoHighlight === id) nextHighlight = item;
            });

            root.dataset.demoMotion = instant ? 'instant' : reducedMotion ? 'reduced' : 'animated';
            root.dataset.activeLayer = target.dataset.demoLayer;
            root.dataset.activeId = id;
            kind.textContent = target.dataset.demoKind;
            title.textContent = target.dataset.demoTitle;
            caption.textContent = target.dataset.demoCopy;

            if (!nextHighlight) return;
            if (instant || reducedMotion) {
              nextHighlight.dataset.active = 'true';
              return;
            }
            enterFrame = window.requestAnimationFrame(function () {
              settleFrame = window.requestAnimationFrame(function () {
                nextHighlight.dataset.active = 'true';
              });
            });
          };

          targets.forEach(function (target) {
            target.addEventListener('click', function (event) { activate(target, event); });
          });
          if (selector) selector.addEventListener('change', function () {
            activate(targetFor(selector.value));
          });
          jumps.forEach(function (jump) {
            jump.addEventListener('click', function (event) {
              activate(targetFor(jump.dataset.demoJump), event);
            });
          });
        })();
      </script>
    </div>
  </section>

  <!-- 03 · Zero-input value: tap your sign, see today -->
  <!-- client:visible, not client:idle: on a fast connection idle fires while
       the hero poster (the LCP element) is still painting, and the preact
       module cascade lands in the paint window. The strip sits ~1400px down,
       so hydrate it on approach instead. -->
  <section class="container reveal pace-sec">
    <TodayBySign client:visible={{ rootMargin: '240px' }} />
  </section>

  <!-- 04 · Tools -->
  <section class="container pace-act pace-act--rule">
    <div class="section-head reveal">
      <h2>Start with your chart</h2>
      <p>Find your birth chart, moon sign, rising sign, compatibility, and what the sky is doing now.</p>
    </div>
    <div class="home-tools">
      {tools.map((t, i) => (
        <a class="tile reveal" href={t.href} style={`--sign:${t.hue};--reveal-delay:${i * 60}ms`}>
          <div class="home-tool">
            <ToolGlyph kind={t.kind} />
            <h3>{t.title}</h3>
            <p>{t.promise}</p>
            <span class="home-tool__go">Open →</span>
          </div>
        </a>
      ))}
    </div>
    <div class="tools-upcoming reveal">
      <em class="kicker">And for the month ahead</em>
      <ul>
        <li>
          <strong>Eclipses.</strong> Every solar and lunar eclipse through
          2028, with peak times in UTC — <a href="/eclipses/">see the dates</a>.
        </li>
      </ul>
    </div>
  </section>

  <HomeShareTools locale="en" />

  <!-- 05 · The Twelve -->
  <section class="container pace-tight" id="signs">
    <div class="section-head reveal">
      <h2>The twelve signs</h2>
      <p>A full guide to each: character, relationships, history, and what the sign means across your chart.</p>
    </div>
    <div class="twelve">
      {SIGNS.map((s, i) => (
        <a class="tile reveal" href={`/${s.slug}/`} style={`--sign:${s.hue};--reveal-delay:${(i % 6) * 45}ms`}>
          <div class="twelve__card">
            <SignIcon sign={s.slug} size={64} />
            <strong>{s.name}</strong>
            <span class="mono twelve__dates">{s.dates}</span>
          </div>
        </a>
      ))}
    </div>
    <RaceRamp class="reveal" gap="28px" />
  </section>

  <!-- 06 · Three pillars -->
  <section class="container pace-act pace-act--rule">
    <div class="section-head reveal">
      <h2>Learn your signs. Save what matters.</h2>
      <p>Three parts to the site, and you can start anywhere.</p>
    </div>
    <div class="pillars">
      <div class="pillar reveal">
        <em class="kicker">Learn</em>
        <h3>A guide to every sign</h3>
        <p>Twelve sign guides, the <AstroTerm term="big-three" label="big three" surface="home-pillars" /> explained, and plain-language help for reading your chart.</p>
        <a href="/learn/">Learn astrology →</a>
      </div>
      <div class="pillar reveal" style="--reveal-delay:80ms">
        <em class="kicker">Calculate</em>
        <h3>Free astrology tools</h3>
        <p>Birth chart, moon, rising, compatibility, and <AstroTerm term="transit" label="transits" surface="home-pillars" />, calculated privately in your browser.</p>
