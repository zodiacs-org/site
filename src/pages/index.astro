</Base>

<style>
  /* ── Vertical rhythm — the page reads as four acts, and the seams carry
     that structure: one-sided padding in three tiers instead of the global
     .section's doubled uniform gap. Act breaks may carry a hairline. ── */
  .pace-act { padding-top: clamp(72px, 9.5vw, 132px); }
  .pace-act--rule {
    margin-top: clamp(40px, 5vw, 64px);
    border-top: 1px solid var(--hair-1);
    padding-top: clamp(44px, 5.5vw, 72px);
  }
  .pace-sec { padding-top: clamp(48px, 6.5vw, 88px); }
  .pace-tight { padding-top: clamp(36px, 4.5vw, 60px); }
  .pace-end { padding-bottom: clamp(80px, 10vw, 132px); }

  /* ── Hero — the rounded cinematic frame ── */
  .hero {
    /* Cancel main's nav clearance so the frame rises behind the fixed
       nav pill — the liquid-glass capsule then refracts the footage from
       the first paint instead of empty void. The headline keeps clear of
       the nav via the content padding below. */
    margin-top: calc(-1 * var(--nav-space, 96px));
    width: min(100% - 32px, 1440px);
    padding-block: 0 clamp(14px, 2vw, 22px);
  }
  .hero__frame {
    position: relative;
    overflow: hidden;
    border-radius: clamp(18px, 2.6vw, 30px);
    /* Frame now starts at the top of the viewport; fill it, leaving a
       small peek of the ticker waiting below. */
    min-height: clamp(600px, calc(100svh - 40px), 900px);
    background: var(--void-1);
    /* A hairline ring keeps the frame editorial rather than app-like. */
    box-shadow:
      inset 0 0 0 1px rgba(198, 204, 218, 0.10),
      0 30px 80px -40px rgba(0, 0, 0, 0.8);
    isolation: isolate;
  }
  .hero-motion { position: absolute; z-index: 5; top: 14px; right: 14px; min-height: 44px; padding: 0 14px; border: 1px solid var(--hair-2); border-radius: 999px; background: rgba(6,7,9,.85); color: var(--text); font: 500 12px var(--font-sans); cursor: pointer; }
  @media (max-width: 959px) { .hero-motion { top: calc(60px + env(safe-area-inset-top)); } }
  @media (prefers-reduced-motion: reduce) { .hero-motion { display: none; } }
  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    transform: scale(1.035);
    transform-origin: center;
  }
  .hero__poster { display: block; }
  .hero__video {
    opacity: 0;
    transition: opacity 420ms ease;
  }
  .hero__video.is-playing { opacity: 1; }
  @keyframes hero-poster-drift {
    0% { transform: scale(1.035) translate3d(0, 0, 0); }
    100% { transform: scale(1.06) translate3d(-0.55%, 0.4%, 0); }
  }
  @media (max-width: 719px) and (prefers-reduced-motion: no-preference) {
    .hero__poster[data-hero-motion='drift'] {
      animation: hero-poster-drift 18s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
      will-change: transform;
