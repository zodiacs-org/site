  }

  /* ── Liquid glass (homepage chrome) ──
     Everyone gets the frosted blur floor above — it renders on Safari/iOS via
     -webkit-backdrop-filter, so the buttons and nav read as real glass there.
     Chromium additionally refracts the backdrop through the SVG capsule lens,
     gated by the .zdx-lens class (added by a tiny inline script only on
     Chromium): Safari reports support for url() backdrop filters but paints
     nothing, which would otherwise leave these controls flat and transparent. */
  .glass-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  :global(html.zdx-lens) .hero__ctas .hero__ghost {
    background: rgba(10, 12, 17, 0.56);
    backdrop-filter: url(#zdx-lens-nav);
    -webkit-backdrop-filter: url(#zdx-lens-nav);
    box-shadow:
      inset 0 1px 0 rgba(238, 241, 247, 0.10),
      inset 0 -1px 0 rgba(238, 241, 247, 0.04),
      0 12px 32px -14px rgba(0, 0, 0, 0.7);
  }
  :global(html.zdx-lens) .hero__ctas .hero__ghost:hover { background: rgba(10, 12, 17, 0.66); }
  :global(html:not(.zdx-lens)) .hero__ctas .hero__ghost {
    background: rgba(10, 12, 17, 0.58);
    backdrop-filter: saturate(165%) blur(20px) brightness(1.1);
    -webkit-backdrop-filter: saturate(165%) blur(20px) brightness(1.1);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.24),
      inset 0 10px 22px -16px rgba(255, 255, 255, 0.10),
      0 14px 34px -14px rgba(0, 0, 0, 0.72);
  }
  :global(html.zdx-lens .nav-wrap .nav) {
    background: rgba(10, 12, 17, 0.56);
    backdrop-filter: url(#zdx-lens-nav);
    -webkit-backdrop-filter: url(#zdx-lens-nav);
    box-shadow:
      inset 0 1px 0 rgba(238, 241, 247, 0.10),
      inset 0 -1px 0 rgba(238, 241, 247, 0.04),
      0 12px 32px -14px rgba(0, 0, 0, 0.7);
  }
  /* Reduced transparency: solid, no blur — applies to the frosted floor and
     the Chromium lens alike. */
  @media (prefers-reduced-transparency: reduce) {
    .hero__ctas .hero__ghost {
      background: rgba(10, 12, 17, 0.86);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    :global(html .nav-wrap .nav) {
