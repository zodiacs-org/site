---
import Base from '../../../layouts/Base.astro';
import GoodDayOutcome from '../../../islands/GoodDayOutcome.tsx';
import '../../../styles/calculator.css';
import '../../../styles/good-days.css';

// The follow-up is off unless PUBLIC_GOOD_DAYS_OUTCOMES_ENABLED=1 at build time. Off, the page says so and runs no script.
const outcomesEnabled = (import.meta.env.PUBLIC_GOOD_DAYS_OUTCOMES_ENABLED ?? process.env.PUBLIC_GOOD_DAYS_OUTCOMES_ENABLED) === '1';
---
<Base
  clientUi
  noindex
  privateSurface
  title="How Did Your Day Go? | Zodiacs.org"
  description="Tell us how a day you picked with the good day finder went: a rating and an optional note, kept anonymously."
  path="/good-days/how-did-it-go/"
>
  <section class="section--tight container container--narrow">
    {outcomesEnabled ? (
      <>
        <GoodDayOutcome client:load />
        <noscript><p>This form needs JavaScript. Enable it and reload.</p></noscript>
      </>
    ) : (
      <div class="outcome shell">
        <div class="core outcome__core">
          <h1 class="display outcome__title">How did your day go?</h1>
          <p class="outcome__day">Follow-ups are not open yet.</p>
          <div class="outcome__body"><p><a class="btn" href="/good-days/">Find good days</a></p></div>
        </div>
      </div>
    )}
  </section>
</Base>
