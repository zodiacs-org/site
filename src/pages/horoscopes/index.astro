---
import Base from '../../layouts/Base.astro';
import EditionText from '../../components/EditionText.astro';
import RaceRamp from '../../components/RaceRamp.astro';
import SignIcon from '../../components/SignIcon.astro';
import AskGuideLine from '../../components/AskGuideLine.astro';
import GuideQuickPrompts from '../../components/GuideQuickPrompts.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import programData from '../../data/horoscope-program.json';
import { horoscopeHubTeaser, pageReadingFromProgram } from '../../lib/horoscope-page-data';
import type { HoroscopeProgram } from '../../lib/horoscope-program';
import { SIGNS } from '../../lib/signs';

const program = programData as HoroscopeProgram;
const dateLabel = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${program.anchorDate}T12:00:00.000Z`));

const cards = SIGNS.map((sign) => {
  const reading = pageReadingFromProgram(program, sign.slug, 'today');
  return { sign, reading, teaser: horoscopeHubTeaser(reading.sections[0]?.body ?? reading.intro) };
});

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: `Daily horoscopes — ${dateLabel}`,
    url: 'https://zodiacs.org/horoscopes/',
    description: `Daily horoscopes for all twelve signs on ${dateLabel}, with a clear theme and one useful move for each sign.`,
    dateModified: `${program.anchorDate}T00:00:00.000Z`,
  },
  {
    '@type': 'ItemList',
    numberOfItems: 12,
    itemListElement: cards.map(({ sign }, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `${sign.name} daily horoscope`,
      url: `https://zodiacs.org/horoscopes/${sign.slug}/`,
    })),
  },
];
---
<Base
  stableTypography
  localTypography
  title={`Daily Horoscopes — ${dateLabel}, All 12 Signs | Zodiacs.org`}
  description={`Daily horoscopes for all twelve signs on ${dateLabel}, with a clear theme and one useful move for each sign.`}
  path="/horoscopes/"
  editionDate={program.anchorDate}
  image="/assets/og/v2/tool/horoscopes.png"
  imageAlt="Daily horoscopes for all twelve signs — Zodiacs.org"
  jsonLd={jsonLd}
>
  <section class="section--tight container container--narrow" data-edition-content="true">
    <div class="horo-hero">
      <em class="kicker">Daily edition · {dateLabel}</em>
      <h1 class="display">Daily horoscopes</h1>
      <p>
        Find your sign for <EditionText current="today’s" editionDate={program.anchorDate} /> focus, pressure point, and most useful move.
        Read your Sun sign first—and your rising sign too, if you know it.
      </p>
      <span class="horo-hero__stamp mono">Updated daily · {dateLabel}</span>
    </div>

    <p class="horo-jump-label">Jump to your sign</p>
    <nav class="horo-picker" aria-label="Choose your horoscope sign">
      {cards.map(({ sign }) => (
        <a href={`/horoscopes/${sign.slug}/`} style={`--sign:${sign.hue}`}>
          <SignIcon sign={sign.slug} size={24} webpOnly fetchPriority="low" />
          <span>{sign.name}</span>
        </a>
      ))}
    </nav>

    <h2 class="display horo-preview-title">A look at today’s readings</h2>
    <div class="horo-grid">
      {cards.map(({ sign, reading, teaser }) => (
        <a class="tile horo-card" href={`/horoscopes/${sign.slug}/`} style={`--sign:${sign.hue}`}>
          <SignIcon sign={sign.slug} size={48} class="horo-card__icon" />
          <span class="horo-card__name">{sign.name}</span>
          <span class="horo-card__dates mono">{sign.dates}</span>
          <span class="horo-card__today">
            <span class="horo-card__today-label mono">{reading.label}</span>
            <EditionText current={teaser} editionDate={program.anchorDate} />
          </span>
          <span class="horo-card__go mono"><EditionText current="Read today →" editionDate={program.anchorDate} /></span>
        </a>
      ))}
    </div>

    <EmailCapture placement="horoscopes" />

    <p class="horo-note">
      For a reading alongside your own birth chart, <a href="/today/">open Today</a>. New here? <a href="/birth-chart/">Get your free birth chart</a>.
    </p>

    <div class="horo-ask">
      <AskGuideLine lead="Not sure where to start?" />
      <GuideQuickPrompts
        prompts={[
          'Should I read my Sun sign or my rising sign?',
          'What does today’s sky mean for everyone?',
          'How are these horoscopes computed?',
        ]}
      />
    </div>

    <RaceRamp gap="28px" />

    <details class="horo-method">
      <summary>Behind these readings</summary>
      <p>
        This is the {dateLabel} UTC edition; the underlying positions use the
        recorded noon-UTC sky. Sun-sign horoscopes give the broad view. See the
        <a href="/methodology/">astrology, sources, and checks behind each edition</a>.
      </p>
    </details>
  </section>
</Base>

<style>
  .horo-hero { max-width: 62ch; margin-bottom: clamp(26px, 5vw, 42px); }
  .horo-jump-label { margin: 0 0 8px; font-size: 13px; color: var(--muted); }
  .horo-preview-title { margin: 28px 0 18px; font-size: 30px; font-weight: 400; }
  .horo-hero h1 { margin: 14px 0; font-size: var(--text-2xl); line-height: 1.04; }
  .horo-hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }
  .horo-hero__stamp {
    display: block;
    margin-top: 14px;
    color: var(--faint);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .horo-picker { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-bottom: 28px; }
  .horo-picker a { display: flex; align-items: center; justify-content: center; gap: 7px; min-height: 48px; border: 1px solid var(--hair-2); border-radius: var(--r-md); color: var(--text-2); font-size: 13px; text-decoration: none; }
  .horo-picker a:hover { border-color: var(--sign); background: var(--void-2); }
  .horo-picker a:focus-visible { outline: 2px solid var(--sign); outline-offset: 3px; }
  @media (max-width: 359px) { .horo-picker { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 700px) { .horo-picker { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  .horo-grid {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 700px) { .horo-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .horo-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .horo-card {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    justify-items: center;
    gap: 8px;
    min-width: 0;
    padding: 22px 14px 17px;
    color: var(--text);
    text-align: center;
    text-decoration: none;
  }
  .horo-card :global(img) { border-radius: 50%; }
  .horo-card__name { font-weight: 650; letter-spacing: -0.01em; }
  .horo-card__dates { color: var(--faint); font-size: 12px; letter-spacing: 0.03em; }
  .horo-card__today {
    margin-top: 6px;
    padding-top: 10px;
    border-top: 1px solid var(--hair-1);
    color: var(--text-2);
    font-size: 12px;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .horo-card__today-label {
    display: block;
    margin-bottom: 5px;
    color: var(--faint);
    font-size: 9px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .horo-card__go {
    margin-top: 4px;
    color: var(--faint);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .horo-card:hover .horo-card__go { color: var(--text); }

  .horo-note { margin-top: clamp(22px, 4vw, 34px); color: var(--muted); font-size: var(--text-sm); }
  .horo-note a { color: var(--text); }
  .horo-ask { margin-top: clamp(18px, 3vw, 26px); }
  .horo-method { margin-top: 12px; border-top: 1px solid var(--hair-1); color: var(--muted); font-size: var(--text-sm); }
  .horo-method summary { min-height: 44px; padding: 11px 0; color: var(--muted); cursor: pointer; }
  .horo-method summary:focus-visible { outline: 2px solid var(--ink-0); outline-offset: 3px; }
  .horo-method p { margin: 0 0 14px; }
  .horo-method a { color: var(--text); }

  @media (max-width: 460px) {
    .horo-grid { grid-template-columns: 1fr; }
    .horo-card { padding-inline: 18px; }
  }
</style>
