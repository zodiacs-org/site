---
/**
 * The sign-season hub: the season under way, the next one, and all twelve in
 * the order the Sun will reach them. Dates are the ingress table's, in UTC;
 * each season's own page shows them in the visitor's time zone.
 */
import Base from '../../layouts/Base.astro';
import SignIcon from '../../components/SignIcon.astro';
import { SIGNS, signBySlug } from '../../lib/signs';
import { seasonFocus } from '../../lib/seasons/clock';
import { currentSunSeason, seasonWindowsFor, sunSeasons } from '../../lib/seasons/windows';
import { seasonCopy, seasonUi } from '../../lib/seasons/copy';

const ui = seasonUi();
const buildNow = new Date();
const current = currentSunSeason(buildNow);
const upcoming = sunSeasons().find((window) => Date.parse(window.start) > buildNow.getTime()) ?? null;
const currentIndex = current ? SIGNS.findIndex((sign) => sign.slug === current.sign) : 0;
const day = (iso: string, year = false) => new Intl.DateTimeFormat('en-US', {
  month: 'long', day: 'numeric', ...(year ? { year: 'numeric' } : {}), timeZone: 'UTC',
}).format(new Date(iso));
const order = SIGNS.map((_, offset) => SIGNS[(currentIndex + offset) % 12]).map((sign) => {
  const focus = seasonFocus(seasonWindowsFor(sign.slug), buildNow);
  return { sign, focus, theme: seasonCopy(sign.slug).theme };
});
const featured = [current, upcoming].filter((window): window is NonNullable<typeof window> => Boolean(window));
const description = current
  ? `It is ${signBySlug(current.sign).name} season until ${day(current.end, true)}. When each of the twelve sign seasons starts and ends, and what each one asks of every sign.`
  : 'When each of the twelve sign seasons starts and ends, and what each one asks of every sign.';
---
<Base
  title="Sign Seasons: When Each Zodiac Season Starts and Ends | Zodiacs.org"
  description={description}
  path="/seasons/"
  image={current ? `/assets/og/v8/sign/${current.sign}.jpg` : undefined}
  imageAlt="Sign seasons, Zodiacs.org"
  jsonLd={[{ '@type': 'CollectionPage', name: ui.hubTitle, url: 'https://zodiacs.org/seasons/', description }]}
>
  <section class="kwrap seasons-hero">
    <h1 class="display">{ui.hubTitle}</h1>
    <p>{ui.hubLede}</p>
  </section>

  <section class="kwrap seasons-sec" aria-label={`${ui.hubNow} and ${ui.hubNext.toLowerCase()}`}>
    <div class="seasons-feature">
      {featured.map((window, index) => {
        const sign = signBySlug(window.sign);
        return (
          <a class="seasons-feature__card" href={`/seasons/${sign.slug}/`} style={`--sign:${sign.hue}`}>
            <SignIcon sign={sign.slug} size={72} loading="eager" />
            <span class="seasons-feature__tag">{index === 0 && current ? ui.hubNow : ui.hubNext}</span>
            <span class="seasons-feature__name">{ui.title(sign.name)}</span>
            <span class="seasons-feature__dates">{day(window.start)} to {day(window.end, true)}</span>
            <span class="seasons-feature__theme">{seasonCopy(sign.slug).theme}</span>
          </a>
        );
      })}
    </div>
  </section>

  <section class="kwrap seasons-sec" aria-labelledby="seasons-all">
    <h2 id="seasons-all" class="h-2 seasons-h2">All twelve, in the order the Sun reaches them</h2>
    <ul class="seasons-list">
      {order.map(({ sign, focus, theme }) => (
        <li>
          <a class="tile seasons-item" href={`/seasons/${sign.slug}/`} style={`--sign:${sign.hue}`}>
            <SignIcon sign={sign.slug} size={40} />
            <span class="seasons-item__name">{ui.title(sign.name)}</span>
            {focus && <span class="seasons-item__dates">{day(focus.window.start)} to {day(focus.window.end, true)}</span>}
            <span class="seasons-item__theme">{theme}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="seasons-note">Dates are in UTC. Each season’s page gives the exact times in your own time zone, with a countdown.</p>
  </section>
</Base>

<style>
  .seasons-hero { padding-block: clamp(28px, 6vw, 56px) 8px; }
  .seasons-hero h1 { margin: 0 0 14px; font-size: var(--text-2xl); font-weight: 500; line-height: 1.04; }
  .seasons-hero p { margin: 0; max-width: 60ch; color: var(--muted); font-size: var(--text-lg); line-height: 1.5; }
  .seasons-sec { padding-block: clamp(18px, 4vw, 32px); }
  .seasons-h2 { margin: 0 0 18px; font-family: var(--font-serif); font-size: var(--text-xl); font-weight: 500; }
  .seasons-feature { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 12px; }
  .seasons-feature__card {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: clamp(20px, 4vw, 28px);
    border: 1px solid color-mix(in srgb, var(--sign) 45%, var(--hair-2));
    border-radius: var(--r-xl);
    background: var(--void-1);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--dur-1) var(--ease);
  }
  .seasons-feature__card:hover { border-color: var(--sign); }
  .seasons-feature__tag { color: var(--sign); font-family: var(--font-serif); font-style: italic; font-size: var(--text-lg); }
  .seasons-feature__name { font-family: var(--font-serif); font-size: var(--text-xl); font-weight: 500; line-height: 1.1; }
  .seasons-feature__dates { color: var(--text-2); font-size: var(--text-sm); }
  .seasons-feature__theme { color: var(--muted); line-height: 1.55; }
  .seasons-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .seasons-item { display: grid; gap: 6px; height: 100%; padding: 16px; color: inherit; text-decoration: none; }
  .seasons-item__name { font-family: var(--font-serif); font-size: var(--text-lg); font-weight: 500; }
  .seasons-item__dates { color: var(--sign); font-size: 13px; }
  .seasons-item__theme { color: var(--muted); font-size: var(--text-sm); line-height: 1.55; }
  .seasons-note { margin: 18px 0 0; color: var(--faint); font-size: 13px; }
</style>
