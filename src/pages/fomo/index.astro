  </article>

  <script is:inline type="application/json" id="fomo-records" set:html={recordsJson}></script>

<script>
  type FomoRecord = {
    slug: string;
    name: string;
    symbol: string;
    dates: string;
    start: [number, number];
    end: [number, number];
    hue: string;
    mint: string;
    fomo: string;
    icon: string;
    price: number | null;
    change: number | null;
    marketCap: number | null;
    sparkLine: string;
    sparkArea: string;
    cardLine: string;
    cardArea: string;
  };
  type FomoPayload = { readAt: string; provider: string; days: number; records: FomoRecord[] };
  type DexPair = {
    baseToken?: { address?: string };
    priceUsd?: string | number;
    priceChange?: { h24?: number | string };
    marketCap?: number | string;
    liquidity?: { usd?: number | string };
  };
  type NetworkInformation = { saveData?: boolean; effectiveType?: string };

  const dataNode = document.querySelector<HTMLScriptElement>('#fomo-records');
  const payload = JSON.parse(dataNode?.textContent || '{"records":[]}') as FomoPayload;
  const records = payload.records ?? [];
  const page = document.querySelector<HTMLElement>('[data-fomo-page]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelector<HTMLAnchorElement>('.nav__chip[href="/astrofolio/"]')?.setAttribute('aria-current', 'page');

  function fmtPrice(value: number | null): string {
    if (value == null || !Number.isFinite(value) || value <= 0) return '—';
    if (value >= 1) return `$${value.toFixed(2)}`;
    if (value >= 0.01) return `$${value.toFixed(4)}`;
    if (value >= 0.000001) return `$${value.toFixed(6)}`;
    return `$${value.toFixed(9)}`;
  }
  function fmtCompact(value: number | null): string {
    if (value == null || !Number.isFinite(value) || value <= 0) return '—';
    if (value >= 1e9) return `$${(value / 1e9).toFixed(2)}B`;
    if (value >= 1e6) return `$${(value / 1e6).toFixed(2)}M`;
    if (value >= 1e3) return `$${(value / 1e3).toFixed(1)}K`;
    return `$${value.toFixed(0)}`;
  }
  function fmtChange(value: number | null): string {
    if (value == null || !Number.isFinite(value)) return '—';
    const magnitude = Math.abs(value).toFixed(2);
    if (value > 0) return `▲ ${magnitude}%`;
    if (value < 0) return `▼ ${magnitude}%`;
    return `${magnitude}%`;
  }
  function paintDelta(node: HTMLElement | null, value: number | null, suffix = '') {
    if (!node) return;
    node.textContent = `${fmtChange(value)}${suffix}`;
    node.classList.toggle('is-up', value != null && value > 0);
    node.classList.toggle('is-down', value != null && value < 0);
  }
  function setText(selector: string, text: string, scope: ParentNode = document) {
    scope.querySelectorAll<HTMLElement>(selector).forEach((node) => { node.textContent = text; });
  }

  /* Sparkline draw-in: the dash length is the path's own length, so the
     line traces itself from the oldest read to the newest. */
  function drawSpark(line: SVGPathElement | null, area: SVGPathElement | null, animate: boolean) {
    if (!line) return;
    line.style.transition = 'none';
    if (area) area.style.transition = 'none';
    if (!animate || reducedMotion.matches) {
      line.style.strokeDasharray = '';
      line.style.strokeDashoffset = '';
      if (area) area.style.opacity = '';
      return;
    }
    const length = line.getTotalLength();
    line.style.strokeDasharray = `${length}`;
    line.style.strokeDashoffset = `${length}`;
    if (area) area.style.opacity = '0';
    void line.getBoundingClientRect();
    line.style.transition = 'stroke-dashoffset 900ms cubic-bezier(0.22, 1, 0.36, 1)';
    line.style.strokeDashoffset = '0';
    if (area) {
      area.style.transition = 'opacity 700ms ease 300ms';
      area.style.opacity = '';
    }
  }

  /* Card sparklines trace once, when their card first scrolls into view. */
  const cardSparks = Array.from(document.querySelectorAll<SVGSVGElement>('[data-card-spark]'));
  if (!reducedMotion.matches && 'IntersectionObserver' in window && cardSparks.length) {
    cardSparks.forEach((spark) => {
      const line = spark.querySelector<SVGPathElement>('.fomo-spark__line');
      if (line) {
        const length = line.getTotalLength();
        line.style.strokeDasharray = `${length}`;
        line.style.strokeDashoffset = `${length}`;
      }
      const area = spark.querySelector<SVGPathElement>('.fomo-spark__area');
      if (area) area.style.opacity = '0';
    });
    const sparkObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const spark = entry.target as SVGSVGElement;
        drawSpark(spark.querySelector('.fomo-spark__line'), spark.querySelector('.fomo-spark__area'), true);
        sparkObserver.unobserve(spark);
      }
    }, { threshold: 0.4 });
    cardSparks.forEach((spark) => sparkObserver.observe(spark));
  }

  /* Store badges: lead with the visitor's own store. Desktop keeps the published order. */
  const agent = navigator.userAgent;
  const ownStore = /iPhone|iPad|iPod/iu.test(agent) ? 'apple' : /Android/iu.test(agent) ? 'google' : '';
  if (ownStore) {
    document.querySelectorAll<HTMLElement>('[data-fomo-stores]').forEach((row) => {
      const first = row.querySelector<HTMLElement>(`[data-store="${ownStore}"]`);
      if (first) row.prepend(first);
    });
  }

  /* Films: the poster is the complete reduced-motion and constrained-data
     experience. Sources attach only once a film is on screen (on phones the
     hero waits for the load event, so its poster stays the LCP), and
     playback rests whenever the film scrolls away or the tab hides. */
  const connection = (navigator as Navigator & { connection?: NetworkInformation }).connection;
  const constrained = Boolean(connection && (connection.saveData || ['slow-2g', '2g'].includes(connection.effectiveType ?? '')));
  function runFilm(video: HTMLVideoElement | null, stage: HTMLElement | null, options: { threshold: number; afterLoad: boolean }) {
    if (!video || !stage || reducedMotion.matches || constrained || !('IntersectionObserver' in window)) return;
    let attached = false;
    let onScreen = false;
    let ready = !options.afterLoad || document.readyState === 'complete';
    const settle = (state: string) => { video.dataset.playback = state; stage.dataset.playing = String(state === 'playing'); };
    const attach = () => {
      if (attached) return;
      attached = true;
      video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((source) => {
        source.src = source.dataset.src ?? '';
        source.removeAttribute('data-src');
      });
      video.load();
      settle('loading');
    };
    const play = () => {
      if (!ready || !onScreen || document.hidden) return;
      attach();
      video.play().then(() => settle('playing')).catch(() => settle('poster'));
    };
    const rest = () => {
      if (!attached || video.paused) return;
      video.pause();
      settle('paused');
    };
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        onScreen = entry.isIntersecting;
        if (onScreen) play();
        else rest();
      }
    }, { threshold: options.threshold });
    observer.observe(stage);
    if (!ready) window.addEventListener('load', () => { ready = true; play(); }, { once: true });
    video.addEventListener('playing', () => settle('playing'));
    video.addEventListener('error', () => settle('poster'), true);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) rest();
      else play();
    });
    window.addEventListener('pageshow', (event) => { if (event.persisted) play(); });
    reducedMotion.addEventListener('change', () => {
      if (!reducedMotion.matches) return;
      observer.disconnect();
      if (!video.paused) video.pause();
      settle('poster');
    });
  }
  runFilm(
    document.querySelector<HTMLVideoElement>('[data-fomo-film-video]'),
    document.querySelector<HTMLElement>('[data-fomo-film]'),
    { threshold: 0.01, afterLoad: window.matchMedia('(max-width: 900px)').matches },
  );
  runFilm(
    document.querySelector<HTMLVideoElement>('[data-fomo-video]'),
    document.querySelector<HTMLElement>('[data-fomo-stage]'),
    { threshold: 0.25, afterLoad: false },
  );

  /* Find your sign by birthday. Tropical dates from the site's sign table. */
  const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const MONTH_LENGTHS = [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
  const finderForm = document.querySelector<HTMLFormElement>('[data-fomo-finder-form]');
  const finderMonth = document.querySelector<HTMLSelectElement>('[data-finder-month]');
  const finderDay = document.querySelector<HTMLSelectElement>('[data-finder-day]');
  const finderNote = document.querySelector<HTMLElement>('[data-finder-note]');
  const finderCard = document.querySelector<HTMLElement>('[data-finder-card]');
  let found: FomoRecord | null = null;

  function signForDate(month: number, day: number): FomoRecord | undefined {
    const value = month * 100 + day;
    return records.find((record) => {
      const start = record.start[0] * 100 + record.start[1];
      const end = record.end[0] * 100 + record.end[1];
      return start <= end ? value >= start && value <= end : value >= start || value <= end;
    });
  }
  function paintFinder(record: FomoRecord) {
    if (!finderCard) return;
    const icon = finderCard.querySelector<HTMLImageElement>('[data-finder-icon]');
    if (icon && icon.getAttribute('src') !== record.icon) icon.src = record.icon;
    setText('[data-finder-name]', record.name, finderCard);
    setText('[data-finder-dates]', record.dates, finderCard);
    setText('[data-finder-symbol]', record.symbol, finderCard);
    setText('[data-finder-price]', fmtPrice(record.price), finderCard);
    paintDelta(finderCard.querySelector<HTMLElement>('[data-finder-change]'), record.change, ' · 24h');
    const open = finderCard.querySelector<HTMLAnchorElement>('[data-finder-open]');
    if (open) open.href = record.fomo;
    const jump = finderCard.querySelector<HTMLAnchorElement>('[data-finder-jump]');
    if (jump) jump.href = `#sign-${record.slug}`;
    const area = finderCard.querySelector<SVGPathElement>('[data-finder-area]');
    const line = finderCard.querySelector<SVGPathElement>('[data-finder-line]');
    area?.setAttribute('d', record.sparkArea);
    line?.setAttribute('d', record.sparkLine);
    drawSpark(line, area, true);
  }
  function runFinder() {
    if (!finderNote || !finderCard) return;
    const month = Number(finderMonth?.value);
    const day = Number(finderDay?.value);
    if (!month || !day) {
      finderNote.textContent = '';
      finderCard.hidden = true;
      found = null;
      return;
    }
    if (day > MONTH_LENGTHS[month - 1]) {
      finderNote.textContent = `${MONTHS[month - 1]} has ${MONTH_LENGTHS[month - 1]} days.`;
      finderCard.hidden = true;
      found = null;
      return;
    }
    const record = signForDate(month, day);
    if (!record) return;
    found = record;
    finderNote.textContent = '';
    finderCard.hidden = false;
    finderCard.style.setProperty('--sign', record.hue);
    page?.style.setProperty('--fomo-sign', record.hue);
    paintFinder(record);
  }
  finderForm?.addEventListener('submit', (event) => event.preventDefault());
  finderMonth?.addEventListener('change', runFinder);
  finderDay?.addEventListener('change', runFinder);

  /* One public read of the same DexScreener batch the daily snapshot uses.
     A failure leaves the dated figures and their caption exactly as built. */
  async function refreshLive() {
    if (!records.length || !navigator.onLine) return;
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 8000);
    try {
      const mints = records.map((record) => record.mint).join(',');
      const response = await fetch(`https://api.dexscreener.com/tokens/v1/solana/${mints}`, {
        signal: controller.signal,
        headers: { accept: 'application/json' },
      });
      if (!response.ok) return;
      const pairs = await response.json() as unknown;
      if (!Array.isArray(pairs)) return;
      const deepest = new Map<string, DexPair>();
      for (const pair of pairs as DexPair[]) {
        const mint = pair?.baseToken?.address;
        if (!mint) continue;
        const liquidity = Number(pair.liquidity?.usd ?? 0);
        const current = deepest.get(mint);
        if (!current || liquidity > Number(current.liquidity?.usd ?? 0)) deepest.set(mint, pair);
      }
      let updated = 0;
      for (const record of records) {
        const pair = deepest.get(record.mint);
        if (!pair) continue;
        const price = Number(pair.priceUsd);
        const change = pair.priceChange?.h24 == null ? null : Number(pair.priceChange.h24);
        const marketCap = pair.marketCap == null ? null : Number(pair.marketCap);
        if (!Number.isFinite(price) || price <= 0) continue;
        record.price = price;
        record.change = change != null && Number.isFinite(change) ? change : null;
        record.marketCap = marketCap != null && Number.isFinite(marketCap) ? marketCap : null;
        updated += 1;
        const card = document.querySelector<HTMLElement>(`[data-sign-card="${record.slug}"]`);
        if (card) {
          setText('[data-card-price]', fmtPrice(record.price), card);
          setText('[data-card-mcap]', fmtCompact(record.marketCap), card);
          paintDelta(card.querySelector<HTMLElement>('[data-card-change]'), record.change);
        }
        document.querySelectorAll<HTMLElement>(`[data-tape-price="${record.slug}"]`).forEach((node) => { node.textContent = fmtPrice(record.price); });
        document.querySelectorAll<HTMLElement>(`[data-tape-change="${record.slug}"]`).forEach((node) => paintDelta(node, record.change));
      }
      if (!updated) return;
      if (found && finderCard) {
        setText('[data-finder-price]', fmtPrice(found.price), finderCard);
        paintDelta(finderCard.querySelector<HTMLElement>('[data-finder-change]'), found.change, ' · 24h');
      }
      const now = new Date();
      const hh = String(now.getUTCHours()).padStart(2, '0');
      const mm = String(now.getUTCMinutes()).padStart(2, '0');
      setText('[data-fomo-live-note]', `Prices: ${payload.provider}, live at ${hh}:${mm} UTC; the ${payload.days}-day lines are its daily reads.`);
    } catch {
      /* Offline, blocked, or slow: the dated snapshot stands. */
    } finally {
      window.clearTimeout(timeout);
    }
  }
  const scheduleRefresh = typeof window.requestIdleCallback === 'function'
    ? (callback: () => void) => { window.requestIdleCallback(callback); }
    : (callback: () => void) => { window.setTimeout(callback, 1200); };
  scheduleRefresh(() => { void refreshLive(); });
</script>
