---
import Base from '../../../layouts/Base.astro';
import '../../../styles/rx-table.css';
import sky from '../../../data/sky.json';
import { bodyLongitude } from '../../../lib/engine/full';
import { formatLongitude, signForLongitude } from '../../../lib/signs';
import { formatDate, formatTime } from '../../../lib/i18n/dates';
import { publishedEventById } from '../../../lib/events/publication';

// The 2027 full moons, cut from the same committed sky data the hub renders,
// with the Moon's sign computed at each instant — receipts, no client
// ephemeris. The year page exists so a search for the year lands on the
// year, with a calendar file beside it.
const YEAR = 2027;
const buildNow = new Date();

const sources = [
  { label: 'Astronomy Engine', href: 'https://github.com/cosinekitty/astronomy' },
  { label: 'IANA Time Zone Database', href: 'https://www.iana.org/time-zones' },
];

const MONTH_NAMES = [
  'Wolf', 'Snow', 'Worm', 'Pink', 'Flower', 'Strawberry',
  'Buck', 'Sturgeon', 'Corn', 'Hunter’s', 'Beaver', 'Cold',
];

const seen = new Set<string>();
const fulls = (sky.moons as { type: string; at: string }[])
  .filter((m) => m.type === 'full')
  .map(({ at }) => {
    const date = new Date(at);
    const monthKey = at.slice(0, 7);
    const second = seen.has(monthKey);
    seen.add(monthKey);
    return { at, date, monthKey, second };
  })
  .filter(({ date }) => date.getUTCFullYear() === YEAR)
  .map(({ at, date, second }) => {
    const lon = bodyLongitude('Moon', date);
    const id = `full-moon-${at.slice(0, 10)}`;
    return {
      id,
      at: date,
      name: second ? 'Blue' : MONTH_NAMES[date.getUTCMonth()],
      position: formatLongitude(lon),
      sign: signForLongitude(lon),
      past: date < buildNow,
      path: publishedEventById.get(id)?.path ?? null,
    };
  });

if (fulls.length !== 12) throw new Error(`Expected 12 full moons in ${YEAR}, found ${fulls.length}; update the page copy`);

const fmtDay = (d: Date) =>
  formatDate('en', d, { weekday: 'short', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const fmtTime = (d: Date) =>
  formatTime('en', d, { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'UTC' });
const fmtMonthDay = (d: Date) => formatDate('en', d, { month: 'long', day: 'numeric', timeZone: 'UTC' });

const first = fulls[0];
const last = fulls[fulls.length - 1];
const blue = fulls.find((f) => f.name === 'Blue');
const signCounts = new Map<string, number>();
for (const f of fulls) signCounts.set(f.sign.name, (signCounts.get(f.sign.name) ?? 0) + 1);
const repeated = [...signCounts.entries()].filter(([, n]) => n > 1).map(([name]) => name);

const description = `All 12 full moons of 2027 with exact universal time, the Moon's zodiac sign and degree, and the almanac name, plus a calendar file you can subscribe to.`;

const faq = [
  {
    q: `How many full moons are there in ${YEAR}?`,
    a: `${fulls.length}, from the ${first.name} Moon on ${fmtMonthDay(first.at)} to the ${last.name} Moon on ${fmtMonthDay(last.at)}.${blue ? ` ${fmtMonthDay(blue.at)} is a blue moon, the second full moon inside one calendar month.` : ' No calendar month holds two, so 2027 has no blue moon by the modern definition.'}`,
  },
  {
    q: 'Why is the time given in UTC?',
    a: 'A full moon is one instant for the whole planet, the moment the Moon stands exactly opposite the Sun, so the table lists that instant once, in universal time. Subtract or add your own offset; in the Americas an early-morning UTC time is the previous evening.',
  },
  {
    q: 'How do I add these dates to my calendar?',
    a: `The calendar file linked at the top holds all ${fulls.length} instants as one-minute events with the sign and degree in each description. Most calendar apps open it directly, and it carries no personal data because there is none to carry.`,
  },
];

const jsonLd = [
  {
    '@type': 'WebPage',
    name: `Full moon calendar ${YEAR}`,
    url: `https://zodiacs.org/full-moon-calendar/${YEAR}/`,
    description,
    isPartOf: { '@type': 'WebPage', url: 'https://zodiacs.org/full-moon-calendar/' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title="Full Moon Calendar 2027: Every Date, Time, and Sign | Zodiacs.org"
  description="All 12 full moons of 2027 with exact universal time, the Moon's zodiac sign and degree, and the almanac name, plus a calendar file you can subscribe to."
  path={`/full-moon-calendar/${YEAR}/`}
  image="/assets/og/v2/tool/full-moon-calendar.png"
  imageAlt="Full moon calendar 2027, Zodiacs.org"
  jsonLd={jsonLd}
  sources={sources}
>
  <section class="section--tight container container--narrow">
    <div class="tool-hero reveal">
      <a class="crumb" href="/full-moon-calendar/"><span class="crumb__arrow" aria-hidden="true">←</span>Full moon calendar</a>
      <h1 class="display">The full moons of {YEAR}.</h1>
      <p>
        {fulls.length} full moons, each listed at the exact instant the <a href="/learn/glossary/#moon">Moon</a> stands
        opposite the <a href="/learn/glossary/#sun">Sun</a>, with the <a href="/learn/glossary/#zodiac-sign">sign</a> and
        degree it happens in. {blue ? `The second full moon of ${fmtMonthDay(blue.at).split(' ')[0]} is the year’s blue moon.` : 'No month holds two, so there is no blue moon this year.'}
        {repeated.length > 0 && ` ${repeated.join(' and ')} ${repeated.length > 1 ? 'each host' : 'hosts'} two full moons in ${YEAR}.`}
      </p>
    </div>

    <div class="rx-now shell tinted reveal" style="--sign:var(--sign-cancer)">
      <div class="core tinted rx-now__core">
        <span class="mono--label">Calendar file</span>
        <strong class="rx-now__line">
          <a href={`/full-moon-calendar/${YEAR}.ics`}>Add the {YEAR} full moons to your calendar</a>
        </strong>
        <span class="rx-now__all mono">
          One-minute events in universal time · every year from 2026 on <a href="/full-moon-calendar/">the full moon calendar</a>
        </span>
      </div>
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <div class="section-head reveal">
      <h2>Full moons of {YEAR}</h2>
      <p>Times are universal time. In the Americas the instant often falls the evening before.</p>
    </div>
    <div class="table-wrap reveal">
      <table class="rx-table">
        <thead>
          <tr><th>Date</th><th>Time UTC</th><th>Moon stands at</th><th>Name</th></tr>
        </thead>
        <tbody>
          {fulls.map((f) => (
            <tr id={f.id} class={f.past ? 'rx-table__past' : ''}>
              <td data-label="Date">
                {f.path ? <a href={f.path}>{fmtDay(f.at)}</a> : fmtDay(f.at)}
              </td>
              <td class="mono" data-label="Time UTC">{fmtTime(f.at)}</td>
              <td class="mono" data-label="Moon stands at">{f.position}</td>
              <td data-label="Name">{f.name === 'Blue' ? 'Blue moon' : `${f.name} Moon`}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <div class="prose reveal">
      <h2>Reading the table</h2>
      <p>
        The sign column is where the Moon stands at the instant of opposition; the Sun is in the opposite sign at the
        same moment, which is why a full moon in {first.sign.name} arrives while the Sun moves through
        {' '}{signForLongitude((fulls[0] ? bodyLongitude('Sun', fulls[0].at) : 0)).name}. A full moon lights the
        <a href="/learn/houses/"> house</a> of your own chart that holds that degree; the birth-chart calculator shows
        which one.
      </p>
      <p>
        Names follow the North American almanac sequence, Wolf through Cold; the second full moon inside one calendar
        month is called a blue moon instead. Neither has astrological weight. The sign and degree do.
      </p>
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <div class="section-head reveal"><h2>Questions</h2></div>
    <div class="prose reveal">
      {faq.map(({ q, a }) => (
        <details class="faq-item">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
    <p class="year-page__links reveal">
      <a href="/full-moon-calendar/">All years</a> · <a href={`/eclipses/${YEAR}/`}>Eclipses {YEAR}</a> ·
      <a href={`/mercury-retrograde/${YEAR}/`}>Mercury retrograde {YEAR}</a> · <a href="/moon-phase/">Tonight's phase</a>
    </p>
  </section>
</Base>

<style>
  .tool-hero .kicker { display: block; margin-bottom: 10px; }
  .year-page__links { margin-top: 18px; color: var(--muted); font-size: var(--text-sm); }
  .year-page__links a { color: var(--text-2); }
  .faq-item { border-top: 1px solid var(--hair-1); }
  .faq-item summary { min-height: 44px; padding: 12px 0; cursor: pointer; color: var(--text); }
  .faq-item p { margin: 0 0 14px; color: var(--muted); }
</style>
