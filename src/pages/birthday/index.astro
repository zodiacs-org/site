---
import Base from '../../layouts/Base.astro';
import EvidenceDisclosure from '../../components/EvidenceDisclosure.astro';
import SignIcon from '../../components/SignIcon.astro';
import { SIGNS, signBySlug } from '../../lib/signs';
import { MONTH_NAMES, MONTH_SLUGS, DAYS_IN_MONTH, birthdaySlug, type BirthdayEntry } from '../../lib/birthdays';
import birthdays from '../../data/birthdays.json';
import { launchFlagOn } from '../../lib/launch-flags';
import { BIRTHDAY_HUB_UPDATED as UPDATED, updatedIso, updatedLabel } from '../../world-times/updated';
import { worldTimesSentence } from '../../world-times/world-times';
import sunIngresses from '../../data/sun-ingresses.json';

const days = birthdays.days as Record<string, BirthdayEntry>;

// Per month: the signs it passes through and which days sit on the boundary.
const months = MONTH_NAMES.map((name, i) => {
  const m = i + 1;
  const list = Array.from({ length: DAYS_IN_MONTH[i] }, (_, d) => {
    const slug = birthdaySlug(m, d + 1);
    const entry = days[slug];
    return {
      day: d + 1,
      slug,
      sign: entry.sign ?? null,
      cusp: !!entry.cusp,
      hue: entry.sign ? signBySlug(entry.sign).hue : 'var(--faint)',
    };
  });
  const signs = [...new Set(list.filter((d) => d.sign).map((d) => d.sign as string))];
  return { name, m, list, signs: signs.map((s) => signBySlug(s)) };
});

// Questions: every answer comes from birthdays.json and sun-ingresses.json.
const [yearFrom, yearTo] = birthdays.yearRange as [number, number];
const listJoin = (items: string[]) => items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}`;
const cuspGroups: { a: string; b: string; days: string[] }[] = [];
for (const { name, list } of months) {
  for (const d of list.filter((x) => x.cusp)) {
    const { a, b } = days[d.slug].cusp!;
    const group = cuspGroups.find((g) => g.a === a && g.b === b);
    const dayLabel = `${name} ${d.day}`;
    if (group) group.days.push(dayLabel);
    else cuspGroups.push({ a, b, days: [dayLabel] });
  }
}
const cuspCount = cuspGroups.reduce((n, g) => n + g.days.length, 0);
const ariesIngress = (sunIngresses.windows as { sign: string; from: string }[]).find((w) => w.sign === 'aries' && w.from.startsWith('2027-'));
if (!ariesIngress) throw new Error('No 2027 Aries ingress in sun-ingresses.json');

const faq = [
  {
    q: 'How do I find my zodiac sign from my birthday?',
    a: `Choose the date above. Each page gives the Sun sign for that date, checked at noon universal time in every year from ${yearFrom} to ${yearTo}. For ${cuspCount} of the 366 dates the answer depends on the birth year, and sometimes the birth time; those pages carry a year-by-year table.`,
  },
  {
    q: 'Which birthdays are on the cusp?',
    a: `${listJoin(cuspGroups.map((g) => `${listJoin(g.days)} (${signBySlug(g.a).name} or ${signBySlug(g.b).name})`))}. On these dates the Sun sign depends on the birth year, and in years when the Sun changes sign during the day, on the birth time too.`,
  },
  {
    q: 'Why do websites give different dates for the same sign?',
    a: `The Sun enters each sign at a different hour every year, and a birthday is a date on a local clock. In 2027, for example, the Sun enters Aries at ${worldTimesSentence(new Date(ariesIngress.from))}. A fixed list of sign dates has to round that away; these pages check every year instead.`,
  },
  {
    q: 'What does the birthday alone not tell me?',
    a: 'The Moon sign needs the full date and often the birth time, because the Moon changes sign every two to three days. The rising sign and the houses need the birth time and place. The birth chart calculator takes all three.',
  },
];

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'Birthday astrology, date by date',
    description: 'A date-specific astrology reading for every birthday, with character, relationships, work, growth, Sun sign, and exact cusp answers when the year matters.',
    url: 'https://zodiacs.org/birthday/',
    dateModified: updatedIso(UPDATED),
    hasPart: SIGNS.map((s) => ({ '@type': 'Thing', name: `${s.name} birthdays` })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Birthdays', item: 'https://zodiacs.org/birthday/' },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title="Birthday Astrology by Date: Signs, Traits & Cusp Answers"
  description="Choose your birthday for a date-specific reading of character, relationships, work, and growth, with an exact Sun-sign answer when the birth year matters."
  path="/birthday/"
  image="/assets/og/v2/tool/birthday.png"
  imageAlt="Birthday astrology, Zodiacs.org"
  jsonLd={jsonLd}
>
  <div class="container bday-hub">
    <header class="bday-hub__hero reveal">
      <h1 class="display">Your birthday, read closely.</h1>
      <p class="bday-hub__lede">
        Choose a date for a distinct reading of character, love, work, and growth.
        You’ll also get the <a href="/learn/glossary/#sun-sign">Sun sign</a> and{' '}
        <a href="/learn/glossary/#decan">decan</a>; if the birthday falls on a{' '}
        <a href="/learn/glossary/#cusp">sign boundary</a>, the page checks the birth year too.{launchFlagOn('PUBLIC_BIRTHDAY_REPORT_ENABLED') && (
          <> For the year your birthday opens, make a <a href="/birthday-report/">birthday report</a>.</>
        )}
      </p>
      <p class="bday-hub__updated">Updated <time datetime={UPDATED}>{updatedLabel(UPDATED)}</time></p>
      <EvidenceDisclosure label="What each birthday page verifies">
        <p>
          Each date also tracks the <a href="/learn/glossary/#sun">Sun</a>’s exact{' '}
          <a href="/learn/glossary/#degree">degree</a> span and shows a year-by-year answer when
          the sign changes during that day.
        </p>
      </EvidenceDisclosure>
    </header>

    {months.map(({ name, m, list, signs }) => (
      <section class="bday-hub__month reveal" aria-labelledby={`m-${MONTH_SLUGS[m - 1]}`}>
        <div class="bday-hub__month-head">
          <h2 id={`m-${MONTH_SLUGS[m - 1]}`}>{name}</h2>
          <span class="bday-hub__signs">
            {signs.map((s, i) => (
              <>
                {i > 0 && <span class="bday-hub__arrow" aria-hidden="true">→</span>}
                <a class="bday-hub__sign" href={`/${s.slug}/`}>
                  <SignIcon sign={s.slug} size={20} />
                  {s.name}
                </a>
              </>
            ))}
          </span>
        </div>
        <div class="bday-hub__grid" role="list">
          {list.map((d) => (
            <a
              class={`bday-day mono${d.cusp ? ' bday-day--cusp' : ''}`}
              href={`/birthday/${d.slug}/`}
              style={`--dot:${d.hue}`}
              role="listitem"
              title={d.cusp ? `${name} ${d.day}, cusp date` : `${name} ${d.day}`}
            >
              <span class="bday-day__dot" aria-hidden="true"></span>
              {d.day}
            </a>
          ))}
        </div>
      </section>
    ))}

    <p class="bday-hub__note mono reveal">
      A hollow dot marks a date whose Sun sign can change with the year. Open it for the
      exact answer; if the change happened during that day, your birth time settles it.
      The same date and time can be used in the <a href="/birth-chart/">birth chart calculator</a>.
    </p>

    <section class="bday-hub__faq reveal" aria-labelledby="bday-hub-faq">
      <h2 id="bday-hub-faq">Questions</h2>
      <p class="bday-hub__check">
        The Sun's positions are calculated with Astronomy Engine, and our November 2026 audit checked the sign and
        degrees on every birthday page against NASA JPL Horizons. <a href="/methodology/">How the positions are calculated</a>
      </p>
      {faq.map(({ q, a }) => (
        <details class="bday-hub__faq-item">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </section>
  </div>
</Base>

<style>
  .bday-hub { display: grid; gap: clamp(28px, 5vw, 44px); padding-block: clamp(24px, 5vw, 56px) clamp(36px, 6vw, 72px); }
  .bday-hub__hero { display: grid; gap: 14px; max-width: 760px; }
  .bday-hub__hero h1 { margin: 0; font-size: clamp(2.2rem, 1.5rem + 3.6vw, 3.8rem); line-height: 1.02; }
  .bday-hub__lede { margin: 0; color: var(--text-2); font-size: var(--text-md); line-height: 1.6; }

  .bday-hub__month { display: grid; gap: 14px; }
  .bday-hub__month-head { display: flex; align-items: baseline; gap: 18px; flex-wrap: wrap; }
  .bday-hub__month-head h2 { margin: 0; font-family: var(--font-serif); font-weight: 500; font-size: clamp(1.4rem, 1.1rem + 1.4vw, 1.9rem); }
  .bday-hub__signs { display: inline-flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--muted); }
  .bday-hub__sign { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); text-decoration: none; }
  .bday-hub__sign:hover { color: var(--text); }
  .bday-hub__sign :global(img) { border-radius: 50%; }
  .bday-hub__arrow { color: var(--faint); }

  .bday-hub__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(52px, 1fr));
    gap: 4px;
  }
  .bday-day {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 4px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-sm);
    color: var(--text-2);
    font-size: 12.5px;
    text-decoration: none;
    transition: border-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease), background var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
  }
  .bday-day:hover { color: var(--text); border-color: var(--hair-2); background: var(--void-1); transform: translateY(-1px); }
  @media (prefers-reduced-motion: reduce) { .bday-day { transition: none; } .bday-day:hover { transform: none; } }
  .bday-day__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--dot); opacity: 0.85; }
  .bday-day--cusp .bday-day__dot { background: transparent; border: 1px solid var(--faint); }

  .bday-hub__updated { margin: 0; color: var(--muted); font-size: var(--text-sm); }

  .bday-hub__faq { display: grid; max-width: 760px; }
  .bday-hub__faq h2 { margin: 0 0 8px; font-family: var(--font-serif); font-weight: 500; font-size: clamp(1.4rem, 1.1rem + 1.4vw, 1.9rem); }
  .bday-hub__check { margin: 0 0 12px; color: var(--muted); font-size: var(--text-sm); line-height: 1.6; }
  .bday-hub__check a { color: var(--text-2); }
  .bday-hub__faq-item { border-top: 1px solid var(--hair-1); }
  .bday-hub__faq-item summary { min-height: 44px; padding: 12px 0; cursor: pointer; color: var(--text); }
  .bday-hub__faq-item p { margin: 0 0 14px; color: var(--muted); line-height: 1.6; }

  .bday-hub__note { margin: 0; max-width: 640px; font-size: 11.5px; color: var(--faint); line-height: 1.6; }
  .bday-hub__note a { color: var(--muted); }
</style>
