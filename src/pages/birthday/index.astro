---
import Base from '../../layouts/Base.astro';
import EvidenceDisclosure from '../../components/EvidenceDisclosure.astro';
import Faq from '../../components/Faq.astro';
import SignIcon from '../../components/SignIcon.astro';
import { SIGNS, signBySlug } from '../../lib/signs';
import { MONTH_NAMES, MONTH_SLUGS, DAYS_IN_MONTH, birthdaySlug, type BirthdayEntry } from '../../lib/birthdays';
import birthdays from '../../data/birthdays.json';

const days = birthdays.days as Record<string, BirthdayEntry>;
const modifiedAt = '2026-09-07T00:00:00.000Z';

// Per month: the signs it passes through and which days sit on the boundary.
const months = MONTH_NAMES.map((name, i) => {
  const m = i + 1;
  const list = Array.from({ length: DAYS_IN_MONTH[i] }, (_, d) => {
    const slug = birthdaySlug(m, d + 1);
    const entry = days[slug];
    return {
      day: d + 1,
      slug,
      sign: entry.sign ?? null,
      cusp: !!entry.cusp,
      hue: entry.sign ? signBySlug(entry.sign).hue : 'var(--faint)',
    };
  });
  const signs = [...new Set(list.filter((d) => d.sign).map((d) => d.sign as string))];
  return { name, m, list, signs: signs.map((s) => signBySlug(s)) };
});

const faq = [
  {
    q: 'What does this birthday page do?',
    a: 'Pick a month and day for a date-specific astrology reading of character, relationships, work, and growth. Each page includes Sun-sign information and year-by-year guidance for birthdays near a sign change.',
  },
  {
    q: 'What’s a cusp, and why does year matter?',
    a: 'A cusp is a boundary between two zodiac signs. Around a sign-change date, your Sun sign can depend on the birth year and exact time, with the local time zone taken into account. For your Sun’s precise degree, use the free birth chart with your full birth date, time, and birthplace. If the time is unknown, the chart uses local noon as a reference; it cannot settle every sign-boundary question.',
  },
  {
    q: 'Do I need birth time here?',
    a: 'You do not need a birth time to browse this birthday guide. Time can matter for your Sun sign near a sign change, and it is needed for rising sign and houses. Use the birth chart or rising-sign calculator when you want those placements.',
  },
  {
    q: 'Is this the same as a full natal chart?',
    a: 'No. This is a birthday and Sun-date guide. A full birth chart adds your Moon, rising sign, planets, houses, and aspects; rising sign and houses require birth time and place. You can also use the moon-sign calculator on its own. Birth time may be needed if the Moon changed signs that day.',
  },
  {
    q: 'Is it free? Do I need an account?',
    a: 'Yes, it is free. No account is required to read birthday pages or run the calculators. You can save charts on this device without signing in; sign in only if you want saved charts to sync across devices.',
  },
];

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'Birthday astrology, date by date',
    description: 'A date-specific astrology reading for every birthday, with character, relationships, work, growth, Sun-sign information, and year-by-year guidance near sign changes.',
    url: 'https://zodiacs.org/birthday/',
    dateModified: modifiedAt,
    hasPart: SIGNS.map((s) => ({ '@type': 'Thing', name: `${s.name} birthdays` })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Birthdays', item: 'https://zodiacs.org/birthday/' },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title="Birthday Astrology by Date — Signs, Traits & Cusp Answers"
  description="Choose your birthday for a date-specific astrology reading, with Sun-sign information and year-by-year guidance for birthdays near a sign change."
  path="/birthday/"
  image="/assets/og/v2/tool/birthday.png"
  imageAlt="Birthday astrology — Zodiacs.org"
  jsonLd={jsonLd}
>
  <div class="container bday-hub">
    <header class="bday-hub__hero reveal">
      <em class="kicker">Birthdays</em>
      <h1 class="display">Your birthday, read closely.</h1>
      <p class="bday-hub__lede">
        Choose a date for a distinct reading of character, love, work, and growth.
        You’ll also get the <a href="/learn/glossary/#sun-sign">Sun sign</a> and{' '}
        <a href="/learn/glossary/#decan">decan</a>; if the birthday falls on a{' '}
        <a href="/learn/glossary/#cusp">sign boundary</a>, the page checks the birth year too.
      </p>
      <p class="bday-hub__related">
        For your other placements, use the free <a href="/birth-chart/">birth chart</a>,{' '}
        <a href="/moon-sign/">moon-sign calculator</a>, or{' '}
        <a href="/rising-sign/">rising-sign calculator</a>.
      </p>
      <EvidenceDisclosure label="What each birthday page verifies">
        <p>
          Each date also tracks the <a href="/learn/glossary/#sun">Sun</a>’s exact{' '}
          <a href="/learn/glossary/#degree">degree</a> span and shows a year-by-year answer when
          the sign changes during that day.
        </p>
      </EvidenceDisclosure>
    </header>

    {months.map(({ name, m, list, signs }) => (
      <section class="bday-hub__month reveal" aria-labelledby={`m-${MONTH_SLUGS[m - 1]}`}>
        <div class="bday-hub__month-head">
          <h2 id={`m-${MONTH_SLUGS[m - 1]}`}>{name}</h2>
          <span class="bday-hub__signs">
            {signs.map((s, i) => (
              <>
                {i > 0 && <span class="bday-hub__arrow" aria-hidden="true">→</span>}
                <a class="bday-hub__sign" href={`/${s.slug}/`}>
                  <SignIcon sign={s.slug} size={20} />
                  {s.name}
                </a>
              </>
            ))}
          </span>
        </div>
        <div class="bday-hub__grid" role="list">
          {list.map((d) => (
            <a
              class={`bday-day mono${d.cusp ? ' bday-day--cusp' : ''}`}
              href={`/birthday/${d.slug}/`}
              style={`--dot:${d.hue}`}
              role="listitem"
              title={d.cusp ? `${name} ${d.day} — cusp date` : `${name} ${d.day}`}
            >
              <span class="bday-day__dot" aria-hidden="true"></span>
              {d.day}
            </a>
          ))}
        </div>
      </section>
    ))}

    <p class="bday-hub__note mono reveal">
      A hollow dot marks a date whose Sun sign can change with the year. Open it for the
      exact answer; if the change happened during that day, your birth time settles it.
      The same date and time can be used in the <a href="/birth-chart/">birth chart calculator</a>.
    </p>

    <section class="bday-hub__faq reveal" aria-labelledby="questions-answered">
      <Faq items={faq} />
      <p class="bday-hub__related">
        Read <a href="/methodology/">how chart positions are calculated</a>, including
        time zones and the limits of an unknown birth time.
      </p>
    </section>
  </div>
</Base>

<style>
  .bday-hub { display: grid; gap: clamp(28px, 5vw, 44px); padding-block: clamp(24px, 5vw, 56px) clamp(36px, 6vw, 72px); }
  .bday-hub__hero { display: grid; gap: 14px; max-width: 760px; }
  .bday-hub__hero h1 { margin: 0; font-size: clamp(2.2rem, 1.5rem + 3.6vw, 3.8rem); line-height: 1.02; }
  .bday-hub__lede { margin: 0; color: var(--text-2); font-size: var(--text-md); line-height: 1.6; }
  .bday-hub__related { margin: 0; color: var(--muted); font-size: var(--text-sm); line-height: 1.65; }
  .bday-hub__related a { color: var(--text-2); }
  .bday-hub__hero .bday-hub__related a { white-space: nowrap; }
  .bday-hub__faq { max-width: 760px; }
  .bday-hub__faq > .bday-hub__related { margin-top: 20px; }

  .bday-hub__month { display: grid; gap: 14px; }
  .bday-hub__month-head { display: flex; align-items: baseline; gap: 18px; flex-wrap: wrap; }
  .bday-hub__month-head h2 { margin: 0; font-family: var(--font-serif); font-weight: 500; font-size: clamp(1.4rem, 1.1rem + 1.4vw, 1.9rem); }
  .bday-hub__signs { display: inline-flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--muted); }
  .bday-hub__sign { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); text-decoration: none; }
  .bday-hub__sign:hover { color: var(--text); }
  .bday-hub__sign :global(img) { border-radius: 50%; }
  .bday-hub__arrow { color: var(--faint); }

  .bday-hub__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(52px, 1fr));
    gap: 4px;
  }
  .bday-day {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 4px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-sm);
    color: var(--text-2);
    font-size: 12.5px;
    text-decoration: none;
    transition: border-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }
  .bday-day:hover { color: var(--text); border-color: var(--hair-2); background: var(--void-1); }
  .bday-day__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--dot); opacity: 0.85; }
  .bday-day--cusp .bday-day__dot { background: transparent; border: 1px solid var(--faint); }

  .bday-hub__note { margin: 0; max-width: 640px; font-size: 11.5px; color: var(--faint); line-height: 1.6; }
  .bday-hub__note a { color: var(--muted); }
</style>
