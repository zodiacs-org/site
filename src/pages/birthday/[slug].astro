---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import ShareRow from '../../components/ShareRow.astro';
import SignIcon from '../../components/SignIcon.astro';
import CollectBand from '../../components/CollectBand.astro';
import PeopleCard from '../../components/people/PeopleCard.astro';
import '../../styles/people.css';
import { signBySlug, formatLongitude } from '../../lib/signs';
import { signTagline } from '../../lib/sign-display';
import {
  birthdaySlug, birthdayLabel, prevDate, nextDate,
  decanSpan, decanOrdinal, cuspSummary, cuspYearReading, boundaryDistance,
  type BirthdayEntry,
} from '../../lib/birthdays';
import birthdays from '../../data/birthdays.json';
import { EDITOR_AUTHOR } from '../../lib/editorial';
import { BIRTHDAY_PEOPLE_VISIBLE, peopleForBirthday } from '../../lib/people';
import { BIRTHDAY_CUSP_OG_MODIFIED_AT, latestModifiedAt } from '../../lib/seo-lastmod';

export async function getStaticPaths() {
  const entries = await getCollection('birthdays', (e) => !e.data.draft);
  // Filenames must be true to their frontmatter — a mismatch names itself.
  const seen = new Set<string>();
  for (const entry of entries) {
    const expected = birthdaySlug(entry.data.month, entry.data.day);
    if (entry.id !== expected) {
      throw new Error(`Birthday file ${entry.id}.mdx declares ${entry.data.month}/${entry.data.day} — expected ${expected}.mdx`);
    }
    if (seen.has(entry.id)) throw new Error(`Duplicate birthday: ${entry.id}`);
    seen.add(entry.id);
  }
  // Every calendar date, exactly once — a missing or extra file fails the build.
  if (entries.length !== 366) {
    throw new Error(`Expected 366 birthday pages, found ${entries.length}`);
  }
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { month, day } = entry.data;
const slug = entry.id;
const label = birthdayLabel(month, day);
const { Content } = await render(entry);

const data = (birthdays.days as Record<string, BirthdayEntry>)[slug];
if (!data) throw new Error(`No computed data for ${slug} — rerun scripts/build-birthdays.mjs`);
const [yearFrom, yearTo] = birthdays.yearRange as [number, number];

// ── Computed facts ─────────────────────────────────────────────────────
const sign = data.sign ? signBySlug(data.sign) : null;
const cusp = data.cusp ? cuspSummary(data.cusp) : null;
const nowReading = data.cusp ? cuspYearReading(data.cusp, data.now.year) : null;
const decan = sign ? decanSpan(data) : null;
const spanLabel = `${formatLongitude(data.lonMin)} – ${formatLongitude(data.lonMax)}`;
const moonSign = signBySlug(data.now.moonSign);

// Nearest-boundary honesty for non-cusp dates.
const dist = sign ? boundaryDistance(data) : 0;
const inLo = ((data.lonMin % 360) + 360) % 360 % 30;
const nearPrev = sign ? inLo <= 30 - (((data.lonMax % 360) + 360) % 360 % 30) : false;

// Split-year range for cusp dates ("between 20:37 and 23:55 UTC").
const splitTimes = cusp ? cusp.splitYears.map((s) => s.at).sort() : [];

const heroSign = sign ?? (cusp ? cusp.majority ?? cusp.a : null);
const hue = heroSign?.hue ?? 'var(--text-2)';

// ── Template-computed FAQ (every answer is a receipt) ─────────────────
const faq: { q: string; a: string }[] = [];
if (sign && decan) {
  faq.push({
    q: `What zodiac sign is ${label}?`,
    a: `${sign.name}. In every year from ${yearFrom} through ${yearTo}, the Sun is in ${sign.name} on ${label} — between ${formatLongitude(data.lonMin)} and ${formatLongitude(data.lonMax)} at noon universal time.`,
  });
  faq.push({
    q: `Is ${label} on the cusp?`,
    a: dist >= 1.5
      ? `No. Across ${yearFrom}–${yearTo} the Sun sits at least ${dist}° inside ${sign.name} on ${label}, so the sign never changes with the year.`
      : `It sits close to the ${nearPrev ? 'previous' : 'next'} sign's boundary — about ${dist}° at the nearest — but it stays on the ${sign.name} side in every year from ${yearFrom} to ${yearTo}. Your sun sign is ${sign.name} regardless of birth year.`,
  });
  faq.push({
    q: `What decan is ${label}?`,
    a: decan.lo === decan.hi
      ? `The ${decanOrdinal(decan.lo)} decan of ${sign.name} (${(decan.lo - 1) * 10}°–${decan.lo * 10}°), whose traditional ruler is ${decan.ruler}.`
      : `The date straddles the ${decan.lo * 10}° line: depending on your birth year and hour, the Sun falls in the ${decanOrdinal(decan.lo)} or ${decanOrdinal(decan.hi)} decan of ${sign.name} (traditional rulers ${decan.ruler} and ${decan.hiRuler}). A birth chart pins the exact degree.`,
  });
} else if (cusp) {
  faq.push({
    q: `What zodiac sign is ${label}?`,
    a: `${cusp.a.name} or ${cusp.b.name} — this date sits on the boundary. In ${cusp.wholeA} of the years from ${yearFrom} to ${yearTo} the whole day belonged to ${cusp.a.name}; in ${cusp.wholeB} it belonged to ${cusp.b.name}; in ${cusp.split} the Sun crossed over during the day. The year table above gives your answer, and a birth chart settles it to the minute.`,
  });
  faq.push({
    q: `What time does the sign change on ${label}?`,
    a: splitTimes.length > 0
      ? `In years when the ingress lands on ${label}, it falls between ${splitTimes[0]} and ${splitTimes[splitTimes.length - 1]} universal time. In the other years the whole day is one sign. Convert your birth time to UTC before reading the table.`
      : `In the ${yearFrom}–${yearTo} range the ingress never lands inside this date — each year the whole day belongs to one sign, listed in the table above.`,
  });
  faq.push({
    q: `Which sign should I read?`,
    a: `Check your birth year in the table. If your year is a split year, the deciding fact is your birth time converted to universal time — or skip the table and compute your chart, which reads the Sun's exact degree for your birth moment.`,
  });
}
faq.push({
  q: `What degree is the Sun on ${label}?`,
  a: `Between ${formatLongitude(data.lonMin)} and ${formatLongitude(data.lonMax)} at noon universal time, depending on the year — the calendar drifts about a quarter degree per year against the Sun and resets on leap years. Your exact degree needs your birth date, year, and time.`,
});

// ── Links ──────────────────────────────────────────────────────────────
const prev = prevDate(month, day);
const next = nextDate(month, day);
const prevSlug = birthdaySlug(prev.month, prev.day);
const nextSlug = birthdaySlug(next.month, next.day);
const linkSigns = sign ? [sign] : cusp ? [cusp.a, cusp.b] : [];
const birthdayPeople = peopleForBirthday(`/birthday/${slug}/`);
const birthdayPeopleVisible = birthdayPeople.slice(0, BIRTHDAY_PEOPLE_VISIBLE);
const birthdayPeopleMore = birthdayPeople.slice(BIRTHDAY_PEOPLE_VISIBLE);

// A one-sign share card contradicts a boundary page such as August 23,
// whose answer is explicitly year-and-time dependent. Use the birthday card
// for every computed cusp and advance schema/sitemap freshness together.
const ogImage = cusp
  ? '/assets/og/v2/tool/birthday.png'
  : `/assets/og/v2/sign/${heroSign!.slug}.png`;
const pageModifiedAt = latestModifiedAt(
  entry.data.updated,
  ...(cusp ? [BIRTHDAY_CUSP_OG_MODIFIED_AT] : []),
);

const jsonLd = [
  {
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    url: `https://zodiacs.org/birthday/${slug}/`,
    datePublished: entry.data.published.toISOString(),
    dateModified: pageModifiedAt,
    author: EDITOR_AUTHOR,
    publisher: { '@id': 'https://zodiacs.org/#org' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://zodiacs.org/birthday/${slug}/` },
    inLanguage: 'en',
    image: `https://zodiacs.org${ogImage}`,
    about: { '@type': 'Thing', name: `${label} birthday astrology` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Birthdays', item: 'https://zodiacs.org/birthday/' },
      { '@type': 'ListItem', position: 3, name: label, item: `https://zodiacs.org/birthday/${slug}/` },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title={entry.data.title}
  description={entry.data.description}
  path={`/birthday/${slug}/`}
  image={ogImage}
  imageAlt={`${label} birthday astrology — Zodiacs.org`}
  type="article"
  jsonLd={jsonLd}
>
  <article class="container container--narrow bday" style={`--sign:${hue}`}>
    <header class="bday__hero reveal">
      <em class="kicker">Birthdays</em>
      <div class="bday-lockup">
        {heroSign && <SignIcon sign={heroSign.slug} size={128} class="bday-disc" />}
        {cusp && <SignIcon sign={cusp.b.slug} size={128} class="bday-disc bday-disc--b" />}
        <h1 class="display">Born on {label}</h1>
      </div>

      <p class="bday__lede">{entry.data.description}</p>

      <p class="bday__identity">
        <span class="mono">Sun sign</span>
        {sign ? (
          <>
            <strong><a href={`/${sign.slug}/`}>{sign.name}</a></strong>
            <span>{signTagline(sign)}</span>
          </>
        ) : cusp && (
          <>
            <strong>
              <a href={`/${cusp.a.slug}/`}>{cusp.a.name}</a>{' '}or{' '}
              <a href={`/${cusp.b.slug}/`}>{cusp.b.name}</a>
            </strong>
            <span>Your birth year and time decide.</span>
          </>
        )}
      </p>

      <details class="bday-facts">
        <summary>
          <span>
            <strong>Exact date &amp; cusp check</strong>
            <small>{cusp ? 'Sun sign by year, degrees, decan, and this year’s sky' : 'Sun degrees, decan, and this year’s sky'}</small>
          </span>
          <span class="bday-facts__mark" aria-hidden="true"></span>
        </summary>
        <div class="bday-facts__body">
          <dl class="bday-panel mono">
            {sign ? (
              <div class="bday-panel__row">
                <dt>Sun sign</dt>
                <dd><strong><a href={`/${sign.slug}/`}>{sign.name}</a></strong> — every year, {yearFrom}–{yearTo}</dd>
              </div>
            ) : cusp && (
              <>
                <div class="bday-panel__row">
                  <dt>Sun sign</dt>
                  <dd>
                    <strong><a href={`/${cusp.a.slug}/`}>{cusp.a.name}</a></strong> or <strong><a href={`/${cusp.b.slug}/`}>{cusp.b.name}</a></strong> — the {cusp.a.name}–{cusp.b.name} boundary lands here
                  </dd>
                </div>
                <div class="bday-panel__row">
                  <dt>{yearFrom}–{yearTo}</dt>
                  <dd>whole day {cusp.a.name} in {cusp.wholeA} years · whole day {cusp.b.name} in {cusp.wholeB} · split at the ingress in {cusp.split}</dd>
                </div>
                {nowReading && (
                  <div class="bday-panel__row">
                    <dt>In {data.now.year}</dt>
                    <dd>
                      {nowReading.kind === 'whole'
                        ? `${nowReading.sign.name} all day`
                        : `${nowReading.before.name} until ${nowReading.atUtc} UTC, then ${nowReading.after.name}`}
                    </dd>
                  </div>
                )}
              </>
            )}
            <div class="bday-panel__row">
              <dt>Sun degrees</dt>
              <dd>{spanLabel} · noon UTC, {yearFrom}–{yearTo}</dd>
            </div>
            {decan && sign && (
              <div class="bday-panel__row">
                <dt>Decan</dt>
                <dd>
                  {decan.lo === decan.hi
                    ? <>{decanOrdinal(decan.lo)} decan of {sign.name} — traditional ruler <strong>{decan.ruler}</strong></>
                    : <>{decanOrdinal(decan.lo)}–{decanOrdinal(decan.hi)} decan of {sign.name} — the {decan.lo * 10}° line falls inside this date's span (rulers {decan.ruler} / {decan.hiRuler})</>}
                </dd>
              </div>
            )}
            {cusp && (
              <div class="bday-panel__row">
                <dt>Decan</dt>
                <dd>last decan of {cusp.a.name} or first of {cusp.b.name} — the ingress decides</dd>
              </div>
            )}
            <div class="bday-panel__row">
              <dt>This year</dt>
              <dd>{label}, {data.now.year}: Sun {formatLongitude(data.now.lon)} · Moon in {moonSign.name} at noon UTC</dd>
            </div>
          </dl>

          {cusp && (
            <details class="bday-years mono">
              <summary>The year-by-year table, {yearFrom}–{yearTo}</summary>
              <div class="bday-years__grid">
                {Object.entries(data.cusp!.years).map(([year, v]) => (
                  <span class="bday-years__cell">
                    <span class="bday-years__year">{year}</span>
                    {v === 'a' ? cusp.a.name : v === 'b' ? cusp.b.name : `${cusp.a.name} → ${cusp.b.name} ${v} UTC`}
                  </span>
                ))}
              </div>
              <p class="bday-years__note">Times are universal time — convert your birth time before reading your year.</p>
            </details>
          )}
        </div>
      </details>
    </header>

    <div class="prose reveal">
      <Content />
    </div>

    <section class="reveal">
      <Faq items={faq} heading="The date, answered" />
    </section>

    <div class="bday__cta shell tinted reveal">
      <div class="core tinted bday__cta-core">
        <strong>The date gives you the Sun. The rest takes a chart.</strong>
        <p>See the Moon, rising sign, houses, and aspects that make the reading unmistakably yours — free, with no signup.</p>
        <a class="btn btn--primary" href="/birth-chart/"><span>Get your free birth chart</span><span class="orb">↗</span></a>
      </div>
    </div>

    {sign && (
      <div class="reveal">
        <CollectBand signName={sign.name} slug={sign.slug} surface="birthday" />
      </div>
    )}

    <nav class="bday-more reveal" aria-label="Nearby dates and deeper reading">
      <div class="bday-more__col">
        <span class="bday-more__head">The calendar</span>
        <div class="bday-more__chips">
          <a class="bday-chip" href={`/birthday/${prevSlug}/`}>← {birthdayLabel(prev.month, prev.day)}</a>
          <a class="bday-chip" href="/birthday/">All birthdays</a>
          <a class="bday-chip" href={`/birthday/${nextSlug}/`}>{birthdayLabel(next.month, next.day)} →</a>
        </div>
      </div>
      <div class="bday-more__col">
        <span class="bday-more__head">Deeper into {linkSigns.map((s) => s.name).join(' and ')}</span>
        <div class="bday-more__chips">
          {linkSigns.map((s) => (
            <>
              <a class="bday-chip" href={`/${s.slug}/`}>{s.name} guide</a>
              <a class="bday-chip" href={`/learn/placements/sun-in-${s.slug}/`}>Sun in {s.name}</a>
              <a class="bday-chip" href={`/horoscopes/${s.slug}/`}>{s.name} horoscope</a>
            </>
          ))}
        </div>
      </div>
    </nav>

    {birthdayPeople.length > 0 && (
      <section class="bday-people reveal" aria-labelledby="bday-people-heading">
        <span class="bday-more__head" id="bday-people-heading">People born on this date</span>
        <div class="bday-people__grid">
          {birthdayPeopleVisible.map((person) => <PeopleCard person={person} compact />)}
        </div>
        {birthdayPeopleMore.length > 0 && (
          <details class="bday-people__more">
            <summary>{birthdayPeopleMore.length} more born this day</summary>
            <div class="bday-people__grid">
              {birthdayPeopleMore.map((person) => <PeopleCard person={person} compact />)}
            </div>
          </details>
        )}
      </section>
    )}

    <ShareRow text={`Born ${label} — here's what that sky says`} url={`https://zodiacs.org/birthday/${slug}/`} />
  </article>
</Base>

<style>
  .bday { display: grid; gap: clamp(28px, 5vw, 44px); padding-block: clamp(24px, 5vw, 56px) clamp(36px, 6vw, 72px); }
  .bday__hero { display: grid; gap: 18px; justify-items: start; }

  .bday-lockup { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .bday-lockup :global(.bday-disc) { border-radius: 50%; }
  .bday-lockup :global(.bday-disc--b) { margin-left: -34px; }
  .bday-lockup h1 {
    margin: 0;
    font-size: clamp(2.1rem, 1.4rem + 3.4vw, 3.6rem);
    line-height: 1.02;
    flex-basis: 100%;
  }
  @media (min-width: 700px) { .bday-lockup h1 { flex-basis: auto; } }

  .bday__lede {
    margin: 0;
    max-width: 62ch;
    color: var(--text-2);
    font-size: var(--text-lg);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .bday__identity {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 5px 12px;
    margin: 0;
    color: var(--text-2);
    font-size: var(--text-sm);
  }
  .bday__identity > .mono {
    color: var(--faint);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .bday__identity strong { font-size: var(--text-md); }
  .bday__identity a { color: var(--text); text-decoration-color: var(--hair-2); }

  .bday-people { display: grid; gap: 12px; }
  .bday-people__more { border: 1px solid var(--hair-1); border-radius: var(--r-md); padding: 2px 14px; }
  .bday-people__more > summary { cursor: pointer; padding: 9px 0; color: var(--text-2); font-size: var(--text-sm); }
  .bday-people__more > .bday-people__grid { padding: 4px 0 12px; }
  .bday-people__grid { display: grid; gap: 8px; }
  @media (min-width: 700px) {
    .bday-people__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .bday-facts {
    width: 100%;
    max-width: 640px;
    padding: 3px 16px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: var(--void-1);
  }
  .bday-facts > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 11px 0;
    cursor: pointer;
    list-style: none;
  }
  .bday-facts > summary::-webkit-details-marker { display: none; }
  .bday-facts > summary > span:first-child { display: grid; gap: 2px; }
  .bday-facts > summary strong { color: var(--text); font-size: var(--text-sm); }
  .bday-facts > summary small { color: var(--faint); font-size: var(--text-xs); }
  .bday-facts__mark::before { content: '+'; color: var(--muted); font-family: var(--font-mono); }
  .bday-facts[open] .bday-facts__mark::before { content: '−'; }
  .bday-facts__body { display: grid; gap: 14px; padding: 2px 0 13px; }

  .bday-panel { margin: 0; display: grid; width: 100%; max-width: 640px; }
  .bday-panel__row {
    display: grid;
    gap: 2px 20px;
    padding: 9px 0;
    border-bottom: 1px solid var(--hair-1);
    font-size: 11.5px;
    letter-spacing: 0.05em;
  }
  .bday-panel__row:first-child { border-top: 1px solid var(--hair-1); }
  @media (min-width: 560px) { .bday-panel__row { grid-template-columns: 150px 1fr; } }
  .bday-panel__row dt { color: var(--faint); text-transform: uppercase; font-size: 10px; letter-spacing: 0.14em; align-self: baseline; }
  .bday-panel__row dd { margin: 0; color: var(--text-2); }
  .bday-panel__row strong { color: var(--text); font-weight: 600; }
  .bday-panel__row a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--hair-2); }
  .bday-panel__row a:hover { color: var(--text); border-bottom-color: var(--sign); }

  .bday-years {
    width: 100%;
    max-width: 640px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: var(--void-1);
    padding: 4px 16px;
    font-size: 11.5px;
  }
  .bday-years summary { cursor: pointer; padding: 10px 0; color: var(--text-2); }
  .bday-years__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 4px 18px;
    padding: 8px 0 12px;
  }
  .bday-years__cell { color: var(--muted); display: flex; gap: 8px; align-items: baseline; }
  .bday-years__year { color: var(--faint); font-size: 10.5px; }
  .bday-years__note { margin: 0 0 12px; color: var(--faint); font-size: 10.5px; }

  .bday__cta-core { padding: clamp(22px, 4vw, 32px); display: grid; gap: 10px; justify-items: start; }
  .bday__cta-core strong { font-size: var(--text-lg); letter-spacing: -0.01em; }
  .bday__cta-core p { margin: 0; font-size: var(--text-sm); color: var(--text-2); max-width: 54ch; }

  .bday-more {
    display: grid;
    gap: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--hair-1);
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) { .bday-more { grid-template-columns: auto 1fr; gap: 20px 48px; } }
  .bday-more__col { display: grid; gap: 10px; align-content: start; }
  .bday-more__head { font-weight: 600; font-size: var(--text-sm); color: var(--text); }
  .bday-more__chips { display: flex; flex-wrap: wrap; gap: 4px 2px; }
  .bday-chip {
    padding: 4px 9px;
    border-radius: var(--r-full);
    font-size: 12.5px;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }
  .bday-chip:hover { color: var(--text); background: color-mix(in oklab, var(--sign) 12%, transparent); }
</style>
