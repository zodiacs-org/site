---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArtFrame from '../../components/ArtFrame.astro';
import ShareRow from '../../components/ShareRow.astro';
import SignIcon from '../../components/SignIcon.astro';
import CollectBand from '../../components/CollectBand.astro';
import PeopleCard from '../../components/people/PeopleCard.astro';
import BirthdayHero from '../../components/birthday/BirthdayHero.astro';
import BirthdayDial from '../../components/birthday/BirthdayDial.astro';
import BirthdayCalendar from '../../components/birthday/BirthdayCalendar.astro';
import BirthdayChartForm from '../../components/birthday/BirthdayChartForm.astro';
import '../../styles/people.css';
import { signBySlug, formatLongitude, seasonSign } from '../../lib/signs';
import { signDateRange } from '../../lib/sign-display';
import { BIRTHDAY_HERO_SIZES, signArtSrc, signArtSrcset } from '../../lib/sign-art';
import { HERO_CROP_SIZE, heroCropAlt, heroCropSrc, heroCropSrcset } from '../../lib/hero-crops';
import { birthdayGrowthLine, birthdayPull, parseBirthdayBody } from '../../lib/birthday-reading';
import {
  birthdaySlug, birthdayLabel, prevDate, nextDate, MONTH_NAMES,
  decanSpan, decanOrdinal, cuspSummary, cuspYearReading, boundaryDistance,
  type BirthdayEntry,
} from '../../lib/birthdays';
import birthdays from '../../data/birthdays.json';
import { EDITOR_AUTHOR } from '../../lib/editorial';
import { signArtCard } from '../../lib/og-art-cards.mjs';
import { BIRTHDAY_PEOPLE_VISIBLE, peopleForBirthday } from '../../lib/people';
import { BIRTHDAY_CUSP_OG_MODIFIED_AT, BIRTHDAY_FAMOUS_LINE_MODIFIED_AT, latestModifiedAt } from '../../lib/seo-lastmod';

export async function getStaticPaths() {
  const entries = await getCollection('birthdays', (e) => !e.data.draft);
  // Filenames must be true to their frontmatter — a mismatch names itself.
  const seen = new Set<string>();
  for (const entry of entries) {
    const expected = birthdaySlug(entry.data.month, entry.data.day);
    if (entry.id !== expected) {
      throw new Error(`Birthday file ${entry.id}.mdx declares ${entry.data.month}/${entry.data.day} — expected ${expected}.mdx`);
    }
    if (seen.has(entry.id)) throw new Error(`Duplicate birthday: ${entry.id}`);
    seen.add(entry.id);
  }
  // Every calendar date, exactly once — a missing or extra file fails the build.
  if (entries.length !== 366) {
    throw new Error(`Expected 366 birthday pages, found ${entries.length}`);
  }
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { month, day } = entry.data;
const slug = entry.id;
const label = birthdayLabel(month, day);
const { Content, headings } = await render(entry);

const data = (birthdays.days as Record<string, BirthdayEntry>)[slug];
if (!data) throw new Error(`No computed data for ${slug} — rerun scripts/build-birthdays.mjs`);
const [yearFrom, yearTo] = birthdays.yearRange as [number, number];

// ── Computed facts ─────────────────────────────────────────────────────
const sign = data.sign ? signBySlug(data.sign) : null;
const cusp = data.cusp ? cuspSummary(data.cusp) : null;
const nowReading = data.cusp ? cuspYearReading(data.cusp, data.now.year) : null;
const decan = sign ? decanSpan(data) : null;
const spanLabel = `${formatLongitude(data.lonMin)} to ${formatLongitude(data.lonMax)}`;
const moonSign = signBySlug(data.now.moonSign);

// Nearest-boundary honesty for non-cusp dates.
const dist = sign ? boundaryDistance(data) : 0;
const inLo = ((data.lonMin % 360) + 360) % 360 % 30;
const nearPrev = sign ? inLo <= 30 - (((data.lonMax % 360) + 360) % 360 % 30) : false;

// Split-year range for cusp dates ("between 20:37 and 23:55 UTC").
const splitTimes = cusp ? cusp.splitYears.map((s) => s.at).sort() : [];

const heroSign = sign ?? (cusp ? cusp.majority ?? cusp.a : null);
const hue = heroSign?.hue ?? 'var(--text-2)';

// ── Template-computed FAQ (every answer is a receipt) ─────────────────
const faq: { q: string; a: string }[] = [];
if (sign && decan) {
  faq.push({
    q: `What zodiac sign is ${label}?`,
    a: `${sign.name}. In every year from ${yearFrom} through ${yearTo}, the Sun is in ${sign.name} on ${label}, between ${formatLongitude(data.lonMin)} and ${formatLongitude(data.lonMax)} at noon universal time.`,
  });
  faq.push({
    q: `Is ${label} on the cusp?`,
    a: dist >= 1.5
      ? `No. Across ${yearFrom} to ${yearTo} the Sun sits at least ${dist}° inside ${sign.name} on ${label}, so the sign never changes with the year.`
      : `It sits close to the ${nearPrev ? 'previous' : 'next'} sign's boundary, about ${dist}° at the nearest, but it stays on the ${sign.name} side in every year from ${yearFrom} to ${yearTo}. Your sun sign is ${sign.name} regardless of birth year.`,
  });
  faq.push({
    q: `What decan is ${label}?`,
    a: decan.lo === decan.hi
      ? `The ${decanOrdinal(decan.lo)} decan of ${sign.name} (${(decan.lo - 1) * 10}° to ${decan.lo * 10}°), whose traditional ruler is ${decan.ruler}.`
      : `The date straddles the ${decan.lo * 10}° line: depending on your birth year and hour, the Sun falls in the ${decanOrdinal(decan.lo)} or ${decanOrdinal(decan.hi)} decan of ${sign.name} (traditional rulers ${decan.ruler} and ${decan.hiRuler}). A birth chart pins the exact degree.`,
  });
} else if (cusp) {
  faq.push({
    q: `What zodiac sign is ${label}?`,
    a: `${cusp.a.name} or ${cusp.b.name}. This date sits on the boundary. In ${cusp.wholeA} of the years from ${yearFrom} to ${yearTo} the whole day belonged to ${cusp.a.name}; in ${cusp.wholeB} it belonged to ${cusp.b.name}; in ${cusp.split} the Sun crossed over during the day. The year table above gives your answer, and a birth chart settles it to the minute.`,
  });
  faq.push({
    q: `What time does the sign change on ${label}?`,
    a: splitTimes.length > 0
      ? `In years when the ingress lands on ${label}, it falls between ${splitTimes[0]} and ${splitTimes[splitTimes.length - 1]} universal time. In the other years the whole day is one sign. Convert your birth time to UTC before reading the table.`
      : `In the ${yearFrom} to ${yearTo} range the ingress never lands inside this date. Each year the whole day belongs to one sign, listed in the table above.`,
  });
  faq.push({
    q: `Which sign should I read?`,
    a: `Check your birth year in the table. If your year is a split year, the deciding fact is your birth time converted to universal time, or skip the table and compute your chart, which reads the Sun's exact degree for your birth moment.`,
  });
}
faq.push({
  q: `What degree is the Sun on ${label}?`,
  a: `Between ${formatLongitude(data.lonMin)} and ${formatLongitude(data.lonMax)} at noon universal time, depending on the year. The calendar drifts about a quarter degree per year against the Sun and resets on leap years. Your exact degree needs your birth date, year, and time.`,
});


// ── The redesigned page's quick answers and reading parts ──────────────
const reading = parseBirthdayBody(entry.body ?? '');
const pull = birthdayPull(reading);
const growthLine = birthdayGrowthLine(reading);
const sections = headings.filter((h) => h.depth === 2);
const capFirst = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);
const answers = sign && decan
  ? [
      `Sun in ${sign.name}, every year`,
      dist >= 1.5 ? 'Not a cusp date' : 'Near a boundary, never across it',
      decan.lo === decan.hi
        ? `${capFirst(decanOrdinal(decan.lo))} decan · ${decan.ruler}`
        : `${capFirst(decanOrdinal(decan.lo))} or ${decanOrdinal(decan.hi)} decan`,
    ]
  : cusp
    ? [`${cusp.a.name} or ${cusp.b.name}, by year`, 'A cusp date', `Last decan of ${cusp.a.name} or first of ${cusp.b.name}`]
    : [];
const neighbourSign = (m: number, d: number) => {
  const facts = (birthdays.days as Record<string, BirthdayEntry>)[birthdaySlug(m, d)];
  if (facts?.cusp) {
    const summary = cuspSummary(facts.cusp);
    return { label: `${summary.a.name} or ${summary.b.name}`, icon: summary.a.slug };
  }
  const s = facts?.sign ? signBySlug(facts.sign) : seasonSign(m, d);
  return { label: s.name, icon: s.slug };
};
const prevInfo = neighbourSign(prevDate(month, day).month, prevDate(month, day).day);
const nextInfo = neighbourSign(nextDate(month, day).month, nextDate(month, day).day);

// ── Links ──────────────────────────────────────────────────────────────
const prev = prevDate(month, day);
const next = nextDate(month, day);
const prevSlug = birthdaySlug(prev.month, prev.day);
const nextSlug = birthdaySlug(next.month, next.day);
const linkSigns = sign ? [sign] : cusp ? [cusp.a, cusp.b] : [];
const birthdayPeople = peopleForBirthday(`/birthday/${slug}/`);
const birthdayPeopleVisible = birthdayPeople.slice(0, BIRTHDAY_PEOPLE_VISIBLE);
const birthdayPeopleMore = birthdayPeople.slice(BIRTHDAY_PEOPLE_VISIBLE);
// "You share a birthday with A, B and C" in the hero: the first people the
// page lists below, then how many more, which links to the list.
const famousItems = [
  ...birthdayPeopleVisible.map((person) => ({ label: person.displayName, href: `/people/${person.slug}/` })),
  ...(birthdayPeopleMore.length > 0
    ? [{ label: `${birthdayPeopleMore.length} ${birthdayPeopleMore.length === 1 ? 'other' : 'others'}`, href: '#bday-people-heading' }]
    : []),
];
const famousParts = famousItems.map((item, index) => ({
  ...item,
  before: index === 0 ? '' : index === famousItems.length - 1 ? ' and ' : ', ',
}));

// A one-sign share card contradicts a boundary page such as August 23,
// whose answer is explicitly year-and-time dependent. Use the birthday card
// for every computed cusp and advance schema/sitemap freshness together.
const ogImage = cusp
  ? '/assets/og/v2/tool/birthday.png'
  : signArtCard(heroSign!.slug);
const pageModifiedAt = latestModifiedAt(
  entry.data.updated,
  ...(cusp ? [BIRTHDAY_CUSP_OG_MODIFIED_AT] : []),
  ...(birthdayPeople.length > 0 ? [BIRTHDAY_FAMOUS_LINE_MODIFIED_AT] : []),
);

const jsonLd = [
  {
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    url: `https://zodiacs.org/birthday/${slug}/`,
    datePublished: entry.data.published.toISOString(),
    dateModified: pageModifiedAt,
    author: EDITOR_AUTHOR,
    publisher: { '@id': 'https://zodiacs.org/#org' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://zodiacs.org/birthday/${slug}/` },
    inLanguage: 'en',
    image: `https://zodiacs.org${ogImage}`,
    about: { '@type': 'Thing', name: `${label} birthday astrology` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Birthdays', item: 'https://zodiacs.org/birthday/' },
      { '@type': 'ListItem', position: 3, name: label, item: `https://zodiacs.org/birthday/${slug}/` },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title={entry.data.title}
  description={entry.data.description}
  path={`/birthday/${slug}/`}
  image={ogImage}
  imageAlt={`${label} birthday astrology, Zodiacs.org`}
  type="article"
  jsonLd={jsonLd}
>
  {heroSign && (
    <link
      slot="head"
      rel="preload"
      as="image"
      href={signArtSrc(heroSign.slug, 1200)}
      imagesrcset={signArtSrcset(heroSign.slug)}
      imagesizes={BIRTHDAY_HERO_SIZES}
      fetchpriority="high"
    />
  )}
  <article class="bday" style={`--sign:${hue};--hue:${hue}`}>
    {/* 1. The answer first, the sign art in the light. */}
    <BirthdayHero
      sign={heroSign!.slug}
      caption={`${heroSign!.name} · ${signDateRange(heroSign!)}`}
      stepperLabel="Other birthdays"
      prev={{ href: `/birthday/${prevSlug}/`, label: birthdayLabel(prev.month, prev.day), short: `${MONTH_NAMES[prev.month - 1].slice(0, 3)} ${prev.day}` }}
      middle={{ href: '#dates', label: 'Another date' }}
      next={{ href: `/birthday/${nextSlug}/`, label: birthdayLabel(next.month, next.day), short: `${MONTH_NAMES[next.month - 1].slice(0, 3)} ${next.day}` }}
    >
      <nav class="bday-crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/birthday/">Birthdays</a><span aria-hidden="true">/</span><span aria-current="page">{label}</span>
      </nav>
      <h1 class="display bday-title">Born on <em>{label}</em></h1>
      <p class="bday-hero__lede">{entry.data.description}</p>
      <ul class="bday-answers" aria-label="The short answer">
        {answers.map((answer, index) => (
          <li class:list={['bday-answer', index > 0 && 'bday-answer--plain']}>
            {index === 0 && sign && <SignIcon sign={sign.slug} size={22} loading="eager" fetchPriority="low" webpOnly />}
            {index === 0 && cusp && <><SignIcon sign={cusp.a.slug} size={22} loading="eager" fetchPriority="low" webpOnly /><SignIcon sign={cusp.b.slug} size={22} loading="eager" fetchPriority="low" webpOnly class="bday-answer__second" /></>}
            {answer}
          </li>
        ))}
      </ul>
      {famousParts.length > 0 && (
        <p class="bday-hero__famous">You share a birthday with {famousParts.map((part) => <>{part.before}<a href={part.href}>{part.label}</a></>)}.</p>
      )}
      <div class="btn-row bday-hero__actions">
        <a class="btn btn--primary btn--lg" href="#chart"><span>Get your free birth chart</span><span class="orb" aria-hidden="true">↗</span></a>
        <a class="btn btn--glass btn--lg" href={`/${heroSign!.slug}/`}><span>Read the {heroSign!.name} guide</span></a>
      </div>
      <p class="reassure bday-hero__reassure">Free · No signup · {label} is already filled in</p>
    </BirthdayHero>

    {/* 2. Where the Sun stands, open by default. */}
    <section class="kwrap bday-measure" id="measure" aria-labelledby="bday-measure-title">
      <div class="bday-measure__dial">
        <BirthdayDial label={label} lonMin={data.lonMin} lonMax={data.lonMax} sign={sign} cusp={cusp} decan={decan} />
      </div>
      <div class="bday-measure__head">
        <span class="kicker">Exact date and cusp check</span>
        <h2 class="h-2" id="bday-measure-title">Where the Sun stands on {label}</h2>
        <p class="klede">
          {sign
            ? `Checked for every year from ${yearFrom} to ${yearTo}, at noon universal time. The sign is the same each year; only the degree shifts a little.`
            : `Checked for every year from ${yearFrom} to ${yearTo}, at noon universal time. The Sun changes sign on or near this date, so the birth year, and sometimes the birth time, decides.`}
        </p>
      </div>
      <div class="bday-measure__list">
        <dl class="bday-factlist">
          {sign ? (
            <div>
              <dt>Sun sign</dt>
              <dd><SignIcon sign={sign.slug} size={20} /><b><a href={`/${sign.slug}/`}>{sign.name}</a></b>, every year from {yearFrom} to {yearTo}</dd>
            </div>
          ) : cusp && (
            <>
              <div>
                <dt>Sun sign</dt>
                <dd><b><a href={`/${cusp.a.slug}/`}>{cusp.a.name}</a></b> or <b><a href={`/${cusp.b.slug}/`}>{cusp.b.name}</a></b>, the {cusp.a.name} and {cusp.b.name} boundary lands here</dd>
              </div>
              <div>
                <dt>{yearFrom} to {yearTo}</dt>
                <dd>Whole day {cusp.a.name} in {cusp.wholeA} years, whole day {cusp.b.name} in {cusp.wholeB}, split at the ingress in {cusp.split}</dd>
              </div>
              {nowReading && (
                <div>
                  <dt>In {data.now.year}</dt>
                  <dd>
                    {nowReading.kind === 'whole'
                      ? `${nowReading.sign.name} all day`
                      : `${nowReading.before.name} until ${nowReading.atUtc} UTC, then ${nowReading.after.name}`}
                  </dd>
                </div>
              )}
            </>
          )}
          <div>
            <dt>Sun degrees</dt>
            <dd><b>{spanLabel}</b>, depending on the year</dd>
          </div>
          {decan && sign && (
            <div>
              <dt>Decan</dt>
              <dd>
                {decan.lo === decan.hi
                  ? <><b>{capFirst(decanOrdinal(decan.lo))} decan</b> of {sign.name} ({(decan.lo - 1) * 10}° to {decan.lo * 10}°), traditional ruler {decan.ruler}</>
                  : <><b>{capFirst(decanOrdinal(decan.lo))} or {decanOrdinal(decan.hi)} decan</b> of {sign.name}: the {decan.lo * 10}° line falls inside this date's span (traditional rulers {decan.ruler} and {decan.hiRuler})</>}
              </dd>
            </div>
          )}
          {cusp && (
            <div>
              <dt>Decan</dt>
              <dd>Last decan of {cusp.a.name} or first of {cusp.b.name}; the ingress decides</dd>
            </div>
          )}
          {sign && (
            <div>
              <dt>On the cusp?</dt>
              <dd>
                {dist >= 1.5
                  ? <><b>No.</b> The Sun sits at least {dist}° inside {sign.name}, so the sign never changes with the year.</>
                  : <><b>Close, but no.</b> About {dist}° from the {nearPrev ? 'previous' : 'next'} sign at the nearest, and on the {sign.name} side in every year.</>}
              </dd>
            </div>
          )}
          <div>
            <dt>This year</dt>
            <dd><b>{label}, {data.now.year}:</b> Sun {formatLongitude(data.now.lon)}, Moon in {moonSign.name} at noon UTC</dd>
          </div>
        </dl>
        {cusp && (
          <details class="bday-years">
            <summary>The year-by-year table, {yearFrom} to {yearTo}</summary>
            <div class="bday-years__grid">
              {Object.entries(data.cusp!.years).map(([year, v]) => (
                <span class="bday-years__cell">
                  <span class="bday-years__year">{year}</span>
                  {v === 'a' ? cusp.a.name : v === 'b' ? cusp.b.name : `${cusp.a.name} → ${cusp.b.name} ${v} UTC`}
                </span>
              ))}
            </div>
            <p class="bday-years__note">Times are universal time. Convert your birth time before reading your year.</p>
          </details>
        )}
        <p class="bday-measure__foot">
          <span>Your exact degree needs your birth year and time.</span>
          <a class="textlink" href="#chart">Find it in your chart <span class="arr" aria-hidden="true">→</span></a>
        </p>
      </div>
    </section>

    <div class="kwrap"><hr class="bday-rule" /></div>

    {/* 3. The reading, set like a magazine page. */}
    <section class="kwrap bday-reading" aria-label={`${label}, the reading`}>
      <aside class="bday-gist">
        <div class="kpanel">
          <span class="kicker">{label}, in short</span>
          <dl>
            {sections.map((section, index) => (
              <div>
                <dt>{['The character', 'Love and work', 'The growth edge'][index]}</dt>
                <dd><a href={`#${section.slug}`}>{section.text}</a></dd>
              </div>
            ))}
          </dl>
        </div>
        <div class="bday-gist__links">
          {linkSigns.map((s) => (
            <>
              <a class="textlink" href={`/learn/placements/sun-in-${s.slug}/`}>Sun in {s.name} <span class="arr" aria-hidden="true">→</span></a>
              <a class="textlink" href={`/${s.slug}/`}>The {s.name} guide <span class="arr" aria-hidden="true">→</span></a>
            </>
          ))}
        </div>
      </aside>
      <div class="bday-article">
        <span class="kicker">The character of the date</span>
        <div class="prose bday-prose">
          {pull && (
            <blockquote class="bday-pull" aria-hidden="true">
              {heroSign && <SignIcon sign={heroSign.slug} size={40} />}
              <p>“{pull}”</p>
            </blockquote>
          )}
          <Content />
        </div>
      </div>
    </section>

    {/* 4. The date gives the Sun; the chart gives the rest. */}
    <section class="kwrap bday-next" id="chart" aria-labelledby="bday-next-title">
      <div>
        <span class="kicker">Your birth chart</span>
        <h2 class="h-2" id="bday-next-title">The date gives you the Sun. The rest takes a chart.</h2>
        <p class="klede">See the Moon, rising sign, houses, and aspects that make the reading unmistakably yours, free, with no signup.</p>
        <div class="bday-layers">
          <div>
            {heroSign && <SignIcon sign={heroSign.slug} size={46} />}
            <div>
              <b>{sign ? `Sun in ${sign.name}` : `${cusp!.a.name} or ${cusp!.b.name}`}</b>
              <span>{sign ? `From the date alone. The same every year for ${label}.` : `From the date and the year: ${label} sits on the boundary.`}</span>
            </div>
            <span class="bday-tag bday-tag--on">From the date</span>
          </div>
          <div>
            <span class="bday-layers__glyph" style="--g:var(--sign-pisces)" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 4.4a8 8 0 1 0 0 15.2 6.5 6.5 0 0 1 0-15.2Z" /></svg>
            </span>
            <div>
              <b>Moon sign</b>
              <span>Needs the birth year. The Moon changes sign every two to three days.</span>
            </div>
            <span class="bday-tag">Add the year</span>
          </div>
          <div>
            <span class="bday-layers__glyph" style="--g:var(--sign-libra)" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M3 17h18M7 17a5 5 0 0 1 10 0M12 6v3M5.6 9.6l1.8 1.8M18.4 9.6l-1.8 1.8" /></svg>
            </span>
            <div>
              <b>Rising sign and houses</b>
              <span>Need the birth time and place. The rising sign moves on about every two hours.</span>
            </div>
            <span class="bday-tag">Add time and place</span>
          </div>
        </div>
      </div>
      <BirthdayChartForm month={month} day={day} label={label} />
    </section>

    {/* 5. A birthday question, from the date's own growth edge. */}
    {growthLine && (
      <section class="kwrap bday-reflect-wrap" aria-labelledby="bday-reflect-title">
        <div class="bday-reflect">
          <ArtFrame
            src={heroCropSrc('sun-moon', 560)}
            srcset={heroCropSrcset('sun-moon')}
            sizes="(min-width: 960px) 500px, calc(100vw - 60px)"
            width={HERO_CROP_SIZE.width}
            height={HERO_CROP_SIZE.height}
            alt={heroCropAlt('sun-moon')}
            class="bday-reflect__art"
          />
          <div class="bday-reflect__body">
            <span class="kicker" id="bday-reflect-title">For your birthday</span>
            <p class:list={['bday-reflect__line', growthLine.length > 120 && 'bday-reflect__line--long']}>{growthLine}</p>
            <p class="bday-reflect__from">From “{reading.sections[2].heading}”, this date’s growth edge.</p>
            <p class="bday-reflect__note">Around each birthday the Sun comes back to the degree it held when you were born, so it is a natural moment to look back. This line is offered for reflection, not as a forecast.</p>
          </div>
        </div>
      </section>
    )}

    {/* 6. Questions people search for. */}
    <section class="kwrap qa bday-questions" aria-labelledby="bday-questions-title">
      <div>
        <h2 class="h-2" id="bday-questions-title">The date, answered</h2>
        <p>Short answers to what people ask about a {label} birthday. <a href="/methodology/">How the positions are calculated</a>.</p>
      </div>
      <div class="kfaq">
        {faq.map(({ q, a }, index) => (
          <details open={index === 0}>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>

    {/* 7. Another birthday. */}
    <section class="kwrap bday-dates" id="dates" aria-labelledby="bday-dates-title">
      <div>
        <span class="kicker">Birthdays</span>
        <h2 class="h-2" id="bday-dates-title">Look up another birthday</h2>
        <p class="klede">Every date of the year has its own page, with a clear answer for the dates near a sign change.</p>
        <nav class="bday-neighbours" aria-label="Nearby dates">
          <a href={`/birthday/${prevSlug}/`}>
            <span class="bday-neighbours__dir">← Previous day</span>
            <b>{birthdayLabel(prev.month, prev.day)}</b>
            <span class="bday-neighbours__sign"><SignIcon sign={prevInfo.icon} size={18} />{prevInfo.label}</span>
          </a>
          <a class="bday-neighbours__next" href={`/birthday/${nextSlug}/`}>
            <span class="bday-neighbours__dir">Next day →</span>
            <b>{birthdayLabel(next.month, next.day)}</b>
            <span class="bday-neighbours__sign"><SignIcon sign={nextInfo.icon} size={18} />{nextInfo.label}</span>
          </a>
        </nav>
        <a class="textlink bday-dates__all" href="/birthday/">All birthdays <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <BirthdayCalendar month={month} day={day} />
    </section>

    {/* 8. Deeper into the sign, the people, sharing. */}
    {heroSign && (
      <section class="kwrap bday-deeper" aria-labelledby="bday-deeper-title">
        <div class="section-head--row bday-deeper__head">
          <div>
            <h2 class="h-2" id="bday-deeper-title">Deeper into {heroSign.name}</h2>
            <p>The sign behind the date, in more detail.</p>
          </div>
        </div>
        <div class="grid-3 bday-deeper__grid">
          <a class="bday-dcard" href={`/${heroSign.slug}/`}>
            <ArtFrame sign={heroSign.slug} src={signArtSrc(heroSign.slug, 720)} width={720} height={480} alt="" class="bday-dcard__art" />
            <span class="bday-dcard__row"><SignIcon sign={heroSign.slug} size={26} /><span class="h-4">{heroSign.name} guide</span></span>
            <span class="bday-dcard__text">Character, relationships, history, and what the sign means across a chart.</span>
          </a>
          <a class="bday-dcard" href={`/learn/placements/sun-in-${heroSign.slug}/`}>
            <ArtFrame src={heroCropSrc('sign-ring', 560)} srcset={heroCropSrcset('sign-ring')} sizes="(min-width: 960px) 380px, 112px" width={HERO_CROP_SIZE.width} height={HERO_CROP_SIZE.height} alt="" class="bday-dcard__art" />
            <span class="bday-dcard__row"><span class="bday-dcard__glyph" aria-hidden="true"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="7.4" /><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" /></svg></span><span class="h-4">Sun in {heroSign.name}</span></span>
            <span class="bday-dcard__text">What the Sun in {heroSign.name} means in any chart, for every {heroSign.name} birthday.</span>
          </a>
          <a class="bday-dcard" href={`/horoscopes/${heroSign.slug}/`}>
            <ArtFrame src={heroCropSrc('zodiac-figures', 560)} srcset={heroCropSrcset('zodiac-figures')} sizes="(min-width: 960px) 380px, 112px" width={HERO_CROP_SIZE.width} height={HERO_CROP_SIZE.height} alt="" class="bday-dcard__art" spot="30% 70%" />
            <span class="bday-dcard__row"><SignIcon sign={heroSign.slug} size={26} /><span class="h-4">{heroSign.name} horoscope</span></span>
            <span class="bday-dcard__text">The daily reading for {heroSign.name}, for reflection.</span>
          </a>
        </div>
        {cusp && (
          <p class="bday-deeper__also">
            <span>Also {cusp.a.slug === heroSign.slug ? cusp.b.name : cusp.a.name}:</span>
            {(() => {
              const other = cusp.a.slug === heroSign.slug ? cusp.b : cusp.a;
              return (
                <>
                  <a class="pill" href={`/${other.slug}/`}><SignIcon sign={other.slug} size={22} />{other.name} guide</a>
                  <a class="pill" href={`/learn/placements/sun-in-${other.slug}/`}>Sun in {other.name}</a>
                  <a class="pill" href={`/horoscopes/${other.slug}/`}>{other.name} horoscope</a>
                </>
              );
            })()}
          </p>
        )}

        {birthdayPeople.length > 0 && (
          <section class="bday-people" aria-labelledby="bday-people-heading">
            <h2 class="bday-people__head" id="bday-people-heading">People born on this date</h2>
            <div class="bday-people__grid">
              {birthdayPeopleVisible.map((person) => <PeopleCard person={person} compact />)}
            </div>
            {birthdayPeopleMore.length > 0 && (
              <details class="bday-people__more">
                <summary>{birthdayPeopleMore.length} more born this day</summary>
                <div class="bday-people__grid">
                  {birthdayPeopleMore.map((person) => <PeopleCard person={person} compact />)}
                </div>
              </details>
            )}
          </section>
        )}

        <div class="bday-share">
          <ShareRow text={`Born ${label}, here's what that sky says`} url={`https://zodiacs.org/birthday/${slug}/`} />
        </div>

        {sign && (
          <div class="bday-collect">
            <CollectBand signName={sign.name} slug={sign.slug} surface="birthday" />
          </div>
        )}
      </section>
    )}
  </article>
</Base>

<style>
  .bday { padding-bottom: clamp(48px, 6vw, 88px); }

  /* ── 1. Hero (the frame is BirthdayHero.astro) ─────────────── */
  .bday-crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 13px; color: var(--faint); }
  .bday-crumbs a { color: var(--muted); text-decoration: none; }
  .bday-crumbs a:hover { color: var(--ink-0); }
  .bday-crumbs span[aria-hidden] { opacity: 0.6; }
  .bday-title {
    margin: 26px 0 0;
    font-size: clamp(3.5rem, 1.6rem + 5vw, 6.6rem);
    line-height: 0.94;
    letter-spacing: -0.02em;
    color: var(--ink-0);
  }
  .bday-hero__lede { margin: 24px 0 0; max-width: 41ch; font-size: clamp(1.06rem, 0.98rem + 0.35vw, 1.22rem); line-height: 1.5; color: var(--ink-1); text-wrap: pretty; }
  .bday-answers { display: flex; flex-wrap: wrap; gap: 8px; margin: 26px 0 0; padding: 0; list-style: none; }
  .bday-answer {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 14px 0 6px;
    border: 1px solid var(--hair-2);
    border-radius: var(--r-full);
    background: rgba(10, 12, 17, 0.5);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-0);
  }
  .bday-answer :global(.sign-icon) { width: 22px; }
  .bday-answer :global(.bday-answer__second) { margin-left: -14px; box-shadow: 0 0 0 2px var(--void-1); border-radius: 50%; }
  .bday-answer--plain { padding-left: 14px; color: var(--ink-1); }
  .bday-hero__famous { margin: 20px 0 0; max-width: 46ch; font-size: 0.98rem; line-height: 1.5; color: var(--ink-1); text-wrap: pretty; }
  .bday-hero__famous a { color: var(--ink-0); text-decoration: underline; text-decoration-color: var(--hair-2); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .bday-hero__famous a:hover { text-decoration-color: var(--hue); }
  .bday-hero__actions { margin-top: 30px; }
  .bday-hero__reassure { margin-top: 16px; color: var(--ink-2); }

  /* ── 2. Where the Sun stands ─────────────────────────────────── */
  .bday-measure {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    grid-template-areas: 'dial head' 'dial list';
    column-gap: clamp(36px, 6vw, 96px);
    align-items: center;
    padding-top: clamp(64px, 6vw, 88px);
  }
  .bday-measure__dial {
    grid-area: dial;
    padding: clamp(10px, 2vw, 26px);
    border: 1px solid var(--hair-1);
    border-radius: var(--r-xl);
    background: var(--void-1);
  }
  .bday-measure__head { grid-area: head; align-self: end; }
  .bday-measure__head .h-2 { margin-top: 4px; color: var(--ink-0); }
  .bday-measure__head .klede { margin-top: 14px; }
  .bday-measure__list { grid-area: list; align-self: start; }
  .bday-factlist { margin: 30px 0 0; border-top: 1px solid var(--hair-1); }
  .bday-factlist > div { display: grid; grid-template-columns: 128px minmax(0, 1fr); gap: 20px; padding: 16px 0; border-bottom: 1px solid var(--hair-1); }
  .bday-factlist dt { padding-top: 1px; font-size: 0.9375rem; color: var(--muted); }
  .bday-factlist dd { margin: 0; font-size: 1rem; line-height: 1.55; color: var(--ink-1); }
  .bday-factlist dd :global(.sign-icon) { width: 20px; margin-right: 8px; vertical-align: -4px; }
  .bday-factlist b { font-weight: 600; color: var(--ink-0); }
  .bday-factlist a { color: inherit; text-decoration: underline; text-decoration-color: var(--hair-3); text-underline-offset: 3px; }
  .bday-measure__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin: 22px 0 0; font-size: 0.9375rem; color: var(--muted); }
  .bday-years { margin-top: 18px; padding: 4px 16px; border: 1px solid var(--hair-1); border-radius: var(--r-md); background: var(--void-1); font-size: 0.8125rem; }
  .bday-years summary { padding: 10px 0; cursor: pointer; color: var(--ink-1); }
  .bday-years__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 4px 18px; padding: 8px 0 12px; font-variant-numeric: tabular-nums; }
  .bday-years__cell { display: flex; align-items: baseline; gap: 8px; color: var(--muted); }
  .bday-years__year { font-size: 0.75rem; color: var(--faint); }
  .bday-years__note { margin: 0 0 12px; font-size: 0.75rem; color: var(--faint); }

  .bday-rule { margin: clamp(56px, 7vw, 104px) 0 0; border: 0; border-top: 1px solid var(--hair-1); }

  /* ── 3. The reading ──────────────────────────────────────────── */
  .bday-reading {
    display: grid;
    grid-template-columns: 300px minmax(0, 680px);
    justify-content: center;
    column-gap: clamp(40px, 7vw, 112px);
    align-items: start;
    padding-top: clamp(56px, 7vw, 104px);
  }
  .bday-gist { position: sticky; top: 96px; }
  .bday-gist .kpanel { padding: 26px; }
  .bday-gist .kicker { margin: 0; font-size: 1.05rem; color: var(--sign); }
  .bday-gist dl { margin: 10px 0 0; }
  .bday-gist dl > div { padding: 14px 0; border-top: 1px solid var(--hair-1); }
  .bday-gist dl > div:first-child { padding-top: 6px; border-top: 0; }
  .bday-gist dt { font-size: 0.875rem; color: var(--muted); }
  .bday-gist dd { margin: 2px 0 0; font-size: 1rem; font-weight: 600; line-height: 1.4; color: var(--ink-0); }
  .bday-gist dd a { color: inherit; text-decoration: none; }
  .bday-gist dd a:hover { text-decoration: underline; text-decoration-color: var(--sign); text-underline-offset: 3px; }
  .bday-gist__links { display: grid; justify-items: start; gap: 12px; margin-top: 22px; padding-left: 4px; }
  .bday-article > .kicker { margin: 0; }

  /* The date's own text, set as a feature. One flex column so the pull
     quote can sit between the love-and-work and growth-edge sections, and
     the first heading can lead, without touching the 366 source files. */
  .bday-prose { display: flex; flex-direction: column; max-width: none; margin-top: 6px; }
  .bday-prose > :global(*) { margin-top: 0; }
  .bday-prose > :global(p) { margin: 0 0 1.05em; font-size: 1.125rem; line-height: 1.75; }
  .bday-prose > :global(h2) {
    margin: 1.9em 0 0.55em;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: 0;
    color: var(--ink-0);
  }
  .bday-prose > :global(h2:first-of-type) {
    order: -1;
    margin: 0 0 30px;
    font-size: var(--text-2xl);
    line-height: 1.04;
    letter-spacing: -0.005em;
  }
  .bday-prose > :global(p:first-of-type::first-letter) {
    float: left;
    padding: 6px 10px 0 0;
    font-family: var(--font-serif);
    font-size: 4.1em;
    line-height: 0.82;
    color: var(--sign);
  }
  .bday-prose > :global(h2:nth-of-type(3)),
  .bday-prose > :global(h2:nth-of-type(3) ~ *) { order: 2; }
  .bday-prose > :global(p:last-child) {
    margin: 38px 0 0;
    padding-top: 26px;
    max-width: 40ch;
    border-top: 1px solid var(--hair-1);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.32rem;
    line-height: 1.45;
    color: var(--ink-1);
  }
  .bday-pull {
    order: 1;
    margin: clamp(40px, 5vw, 64px) 0;
    padding: clamp(36px, 4.5vw, 56px) 8px;
    border-top: 1px solid var(--hair-1);
    border-bottom: 1px solid var(--hair-1);
    border-inline-start: 0;
    font-style: normal;
    text-align: center;
  }
  .bday-pull :global(.sign-icon) { display: block; width: 40px; margin: 0 auto 22px; }
  .bday-pull p {
    margin: 0 auto;
    max-width: 23ch;
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 1.2rem + 2.2vw, 3rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--ink-0);
    text-wrap: balance;
  }

  /* ── 4. The chart ────────────────────────────────────────────── */
  .bday-next { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 470px); gap: clamp(40px, 7vw, 112px); align-items: center; padding-top: clamp(72px, 8vw, 120px); }
  .bday-next .h-2 { margin-top: 4px; color: var(--ink-0); }
  .bday-next .klede { margin-top: 14px; }
  .bday-layers { margin-top: 34px; border-top: 1px solid var(--hair-1); }
  .bday-layers > div { display: grid; grid-template-columns: 46px minmax(0, 1fr) auto; gap: 16px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--hair-1); }
  .bday-layers > div > :global(.sign-icon) { width: 46px; }
  .bday-layers__glyph { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; background: var(--g); color: #0b0d12; }
  .bday-layers b { display: block; font-size: 1.0625rem; font-weight: 600; color: var(--ink-0); }
  .bday-layers b + span { display: block; margin-top: 2px; font-size: 0.9375rem; line-height: 1.5; color: var(--muted); }
  .bday-tag { padding: 5px 12px; border: 1px solid var(--hair-2); border-radius: var(--r-full); font-size: 12.5px; font-weight: 550; color: var(--muted); white-space: nowrap; }
  .bday-tag--on { border-color: color-mix(in oklab, var(--sign) 38%, transparent); background: color-mix(in oklab, var(--sign) 8%, transparent); color: var(--sign); }

  /* ── 5. For your birthday ────────────────────────────────────── */
  .bday-reflect-wrap { padding-top: clamp(72px, 8vw, 120px); }
  .bday-reflect {
    display: grid;
    grid-template-columns: minmax(0, 500px) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    padding: clamp(16px, 2vw, 22px);
    border: 1px solid var(--hair-1);
    border-radius: var(--r-xl);
    background: color-mix(in oklab, var(--sign) 4%, var(--void-1));
  }
  .bday-reflect :global(.bday-reflect__art) { aspect-ratio: 16 / 10; border-radius: 20px; }
  .bday-reflect__body { padding: 12px clamp(0px, 3vw, 40px) 12px 0; }
  .bday-reflect .kicker { margin: 0; color: var(--sign); }
  .bday-reflect__line { margin: 14px 0 0; font-family: var(--font-serif); font-size: clamp(1.7rem, 1.2rem + 1.6vw, 2.6rem); font-weight: 500; line-height: 1.12; letter-spacing: -0.01em; color: var(--ink-0); text-wrap: pretty; }
  .bday-reflect__line--long { font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem); line-height: 1.22; }
  .bday-reflect__from { margin: 16px 0 0; font-family: var(--font-serif); font-style: italic; font-size: 1.05rem; color: var(--muted); }
  .bday-reflect__note { margin: 22px 0 0; max-width: 60ch; font-size: 13px; line-height: 1.55; color: var(--faint); }

  /* ── 6. Questions ────────────────────────────────────────────── */
  .bday-questions { padding-top: clamp(72px, 8vw, 120px); }
  .bday-questions .h-2 { color: var(--ink-0); }
  .bday-questions > div:first-child > p { max-width: 34ch; }
  .bday-questions a { color: var(--ink-1); text-decoration: underline; text-decoration-color: var(--hair-3); text-underline-offset: 3px; }

  /* ── 7. Another birthday ─────────────────────────────────────── */
  .bday-dates { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(36px, 6vw, 96px); align-items: start; padding-top: clamp(72px, 8vw, 120px); }
  .bday-dates .h-2 { margin-top: 4px; color: var(--ink-0); }
  .bday-dates .klede { margin-top: 14px; }
  .bday-neighbours { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 30px; }
  .bday-neighbours a { display: grid; gap: 6px; padding: 18px 20px; border: 1px solid var(--hair-2); border-radius: 18px; background: rgba(198, 204, 218, 0.025); color: var(--ink-0); text-decoration: none; }
  .bday-neighbours a:hover { border-color: var(--hair-3); }
  .bday-neighbours__dir { font-size: 12.5px; color: var(--faint); }
  .bday-neighbours b { font-family: var(--font-serif); font-size: 1.6rem; font-weight: 500; line-height: 1.05; }
  .bday-neighbours__sign { display: inline-flex; align-items: center; gap: 8px; font-size: 0.875rem; color: var(--muted); }
  .bday-neighbours__sign :global(.sign-icon) { width: 18px; }
  .bday-neighbours .bday-neighbours__next { justify-items: end; text-align: right; }
  .bday-dates__all { margin-top: 22px; }

  /* ── 8. Deeper, people, sharing ──────────────────────────────── */
  .bday-deeper { padding-top: clamp(72px, 8vw, 120px); }
  .bday-deeper__head { margin-bottom: clamp(28px, 4vw, 48px); }
  .bday-deeper__head .h-2 { color: var(--ink-0); }
  .bday-dcard { display: block; color: var(--ink-0); text-decoration: none; }
  .bday-dcard :global(.bday-dcard__art) { aspect-ratio: 16 / 10; border-radius: 18px; }
  .bday-dcard__row { display: flex; align-items: center; gap: 10px; margin-top: 16px; }
  .bday-dcard__row :global(.sign-icon) { width: 26px; }
  .bday-dcard__glyph { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--sign); color: #0b0d12; }
  .bday-dcard__row .h-4 { font-size: 1.15rem; }
  .bday-dcard__text { display: block; margin-top: 6px; max-width: 38ch; font-size: 0.9375rem; line-height: 1.55; color: var(--muted); }
  .bday-dcard:hover .h-4 { text-decoration: underline; text-decoration-color: var(--sign); text-underline-offset: 4px; }
  .bday-deeper__also { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin: 24px 0 0; font-size: 0.9375rem; color: var(--muted); }
  .bday-deeper__also .pill :global(.sign-icon) { width: 22px; }

  .bday-people { display: grid; gap: 12px; margin-top: clamp(48px, 6vw, 72px); }
  .bday-people__head { margin: 0; font-family: var(--font-serif); font-size: var(--text-xl); font-weight: 500; color: var(--ink-0); }
  .bday-people__more { border: 1px solid var(--hair-1); border-radius: var(--r-md); padding: 2px 14px; }
  .bday-people__more > summary { cursor: pointer; padding: 9px 0; color: var(--text-2); font-size: var(--text-sm); }
  .bday-people__more > .bday-people__grid { padding: 4px 0 12px; }
  .bday-people__grid { display: grid; gap: 8px; }
  @media (min-width: 700px) { .bday-people__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .bday-share { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--hair-1); }
  .bday-share :global(.identity-share) { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; font-size: 0.9375rem; color: var(--muted); }
  .bday-share :global(.identity-share a) {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 14px;
    border: 1px solid var(--hair-2);
    border-radius: var(--r-full);
    background: rgba(198, 204, 218, 0.03);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-1);
  }
  .bday-share :global(.identity-share a:hover) { border-color: var(--hair-3); color: var(--ink-0); }
  .bday-collect { margin-top: 32px; }

  /* ── Breakpoints ─────────────────────────────────────────────── */
  @media (max-width: 1100px) {
    .bday-reading { grid-template-columns: 260px minmax(0, 1fr); }
  }
