---
import '../../styles/people.css';
import { CheckOurMath } from '../../islands/ChartTrust';
import Base from '../../layouts/Base.astro';
import EvidenceDisclosure from '../../components/EvidenceDisclosure.astro';
import ShareRow from '../../components/ShareRow.astro';
import SignIcon from '../../components/SignIcon.astro';
import Wheel from '../../lib/wheel/Wheel';
import { PEOPLE, type PersonRecord } from '../../lib/people';
import { latestModifiedAt, PEOPLE_TEMPLATE_MODIFIED_AT } from '../../lib/seo-lastmod';
import { signBySlug } from '../../lib/signs';

export function getStaticPaths() {
  return PEOPLE.map((person) => ({
    params: { slug: person.slug },
    props: { person },
  }));
}

const { person } = Astro.props as { person: PersonRecord };
const adoptedDate = person.sourceReview?.status === 'adopted-date';
const referenceLocation = person.sourceReview?.status === 'reference-location';
const sign = signBySlug(person.sunSign.slug);
const longDate = new Intl.DateTimeFormat('en-US', {
  timeZone: 'UTC',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(new Date(`${person.birthDate.displayedDate}T12:00:00Z`));
const related = PEOPLE
  .filter((candidate) => (
    candidate.slug !== person.slug
    && candidate.indexEligibility.eligible
    && candidate.sunSign.slug === person.sunSign.slug
  ))
  .slice(0, 3);
const wheelBodies = person.placements.map((placement) => ({
  body: placement.body,
  lon: placement.longitude,
  retrograde: placement.retrograde,
}));
const wheelAspects = person.aspectsStableAcrossCivilDay.map((aspect) => ({
  a: aspect.a,
  b: aspect.b,
  type: aspect.type,
}));
const coordinates = person.birthPlace.coordinates;
const publishedTimeRecord = person.slug === 'frida-kahlo'
  ? {
      href: 'https://www.astro.com/astro-databank/Kahlo%2C_Frida',
      label: 'Astro-Databank record',
      detail: '6 July 1907, 8:30 a.m., Coyoacán · AA (birth record)',
    }
  : null;
const profileSourceNote = publishedTimeRecord
  ? 'This profile’s frozen Wikidata source does not include a birth time.'
  : 'Birth time unknown.';
const profileQualityNote = publishedTimeRecord
  ? 'Birth date sourced. No time in this profile’s Wikidata source.'
  : adoptedDate ? 'Adopted birth date; date uncertain. Birth time unknown.'
    : 'Birth date sourced. Birth time unknown.';
const metaDescription = publishedTimeRecord
  ? `${person.displayName}'s date-sourced chart: Sun at ${person.sunSign.degree.toFixed(1)}° ${person.sunSign.name}. This frozen Wikidata profile omits angles and houses; a separate published-time record is disclosed.`
  : person.copy.metaDescription;
const moonStatement = person.moon.uncertain
  ? `${publishedTimeRecord ? 'Within this date-only profile, the Moon sign is left open.' : 'Moon sign undetermined.'} The Moon crossed from ${signBySlug(person.moon.signAtCivilDayStart).name} into ${signBySlug(person.moon.signAtCivilDayEnd).name} during that civil day.`
  : `The Moon remained in ${person.moon.signName} throughout that civil day.`;
const openSignTransitions = person.copy.blocks.flatMap((block) => (
  block.facts.flatMap((fact) => {
    const match = fact.match(/^sign-uncertain:([^:]+):([a-z]+):([a-z]+)$/u);
    return match
      ? [{
          body: match[1],
          start: signBySlug(match[2]).name,
          end: signBySlug(match[3]).name,
        }]
      : [];
  })
));
const openSignStatement = openSignTransitions.map((transition) => (
  `${transition.body} crossed from ${transition.start} into ${transition.end} during that day, so its sign is left open.`
)).join(' ');
const displayBlocks = person.copy.blocks.map((block) => (
  publishedTimeRecord && block.key === 'moon'
    ? {
        ...block,
        text: `The Moon crossed from Taurus into Gemini during that civil day. This profile leaves it open because its frozen Wikidata source contains a date but no time. A separate Astro-Databank record publishes 8:30 a.m. and is disclosed below; the calculator sample uses that record, while this page keeps its independently reproducible date-only computation instead of silently merging sources.`,
      }
    : block
));
const pageUrl = `https://zodiacs.org/people/${person.slug}/`;
// The share cards whose Sun degree moved in the reference-instant migration of
// 2026-09-23 (docs/phase5/people-pilot/corrections/2026-09-23-reference-instants.json).
const REFERENCE_INSTANT_CARDS = [
  'dolores-del-rio',
  'edvard-grieg',
  'emily-bronte',
  'fanny-blankers-koen',
  'francisco-goya',
  'getulio-vargas',
  'harriet-beecher-stowe',
  'hector-berlioz',
  'jane-austen',
  'knute-rockne',
  'learie-constantine',
  'pablo-picasso',
  'raja-ravi-varma',
  'xiang-jingyu',
];
const identityCardRevision = REFERENCE_INSTANT_CARDS.includes(person.slug)
  ? '?v=instants-2026-09-23'
  : person.sourceReview
  ? `?v=facts-${person.sourceReview.reviewedOn}`
  : ['neil-armstrong', 'amelia-earhart', 'maya-angelou'].includes(person.slug)
  ? '?v=identity-2026-09-05'
  : '';
const image = `/assets/og/v2/people/${person.slug}.png${identityCardRevision}`;
const pageModifiedAt = latestModifiedAt(person.reviewedAtUtc, PEOPLE_TEMPLATE_MODIFIED_AT);

const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': `${pageUrl}#page`,
    url: pageUrl,
    name: person.copy.title,
    description: metaDescription,
    dateModified: pageModifiedAt,
    about: { '@id': `${pageUrl}#person` },
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
  {
    '@type': 'Person',
    '@id': `${pageUrl}#person`,
    name: person.displayName,
    description: person.shortDescription,
    ...(!adoptedDate ? { birthDate: person.birthDate.displayedDate } : {}),
    ...(!referenceLocation ? { birthPlace: {
      '@type': 'Place',
      name: person.birthPlace.normalisedLabel,
      sameAs: `https://www.wikidata.org/wiki/${person.birthPlace.entity}`,
    } } : {}),
    sameAs: [
      person.sources.wikidata.entityUrl,
      person.sources.wikipedia.articleUrl,
    ],
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'People', item: 'https://zodiacs.org/people/' },
      { '@type': 'ListItem', position: 3, name: person.displayName, item: pageUrl },
    ],
  },
];
---
<Base
  title={`${person.copy.title} | Zodiacs.org`}
  description={metaDescription}
  path={`/people/${person.slug}/`}
  image={image}
  imageAlt={`${person.displayName}'s ${adoptedDate ? 'adopted, uncertain birth-date' : 'sourced birth-date'} chart — ${publishedTimeRecord ? 'date-only profile source' : 'birth time unknown'}`}
  noindex={!person.indexEligibility.eligible}
  nofollow={person.living}
  jsonLd={jsonLd}
  stableTypography
  preloadMonoFont
>
  <article class="person-page" style={`--sign:${sign.hue}`}>
    <div class="person-layout">
      <header class="person-identity">
        {person.portrait.available ? (
          <>
            <figure class="person-portrait" data-person-portrait>
              <img
                src={person.portrait.assetPath}
                srcset={`/assets/people/${person.slug}-192.webp 192w, ${person.portrait.assetPath} ${person.portrait.width}w`}
                sizes="(max-width: 559px) 96px, (min-width: 1060px) 368px, calc(100vw - 60px)"
                width={person.portrait.width}
                height={person.portrait.height}
                alt={person.displayName}
                loading="eager"
                decoding="async"
                fetchpriority="high"
                data-person-portrait-image
              />
              <figcaption class="person-credit">
                <a href={person.portrait.renderedAttributionLinks.creator} target="_blank" rel="noopener noreferrer">
                  {person.portrait.creator}
                </a>
                {' · '}
                {person.portrait.licenceUrl ? (
                  <a href={person.portrait.licenceUrl} target="_blank" rel="noopener noreferrer">{person.portrait.licence}</a>
                ) : person.portrait.licence.toLowerCase()}
                {' · '}
                <a href={person.portrait.renderedAttributionLinks.source} target="_blank" rel="noopener noreferrer">
                  Wikimedia Commons
                </a>
              </figcaption>
            </figure>
            <div class="person-portrait-fallback" data-person-portrait-fallback hidden>
              <SignIcon sign={person.sunSign.slug} size={96} loading="eager" />
            </div>
          </>
        ) : (
          <div class="person-portrait-fallback person-portrait-fallback--permanent">
            <SignIcon sign={person.sunSign.slug} size={96} loading="eager" />
          </div>
        )}
        <div class="person-identity__name">
          <div class="person-identity__top">
            <SignIcon sign={person.sunSign.slug} size={28} loading="eager" />
            <h1 class="display">{person.displayName}</h1>
          </div>
        </div>
        <p class="person-identity__description">{person.shortDescription}</p>
        <p class="person-identity__meta">
          {person.sunSign.name} {person.sunSign.degree.toFixed(1)}° · {adoptedDate ? 'adopted date' : 'born'} {longDate}<br />
          {profileSourceNote}
        </p>
        {person.sourceReview && (
          <p class="person-quality" data-source-review>
            <strong>{adoptedDate ? 'About the adopted date' : referenceLocation ? 'About the reference location' : 'Source correction'}</strong>
            <span>{person.sourceReview.note} <a href="#sources">Review the sources</a>.</span>
          </p>
        )}
        <details class="person-quality person-quality--details">
          <summary>{profileQualityNote}</summary>
          <span>
            {moonStatement}
            {openSignStatement && ` ${openSignStatement}`}
            {' '}Everything below uses only what the complete {adoptedDate ? 'adopted ' : ''}civil day settles.
            {publishedTimeRecord && (
              <>{' '}A <a href={publishedTimeRecord.href} target="_blank" rel="noopener noreferrer">separate published-time record</a> is documented in the source panel.</>
            )}
          </span>
        </details>
      </header>

      <div class="person-reading">
        <p class="person-lede">{person.copy.lede}</p>
        <CheckOurMath utc={person.computation.utcInstant} basis="reference" />

        <div class="person-wheel">
          <Wheel
            bodies={wheelBodies}
            aspects={wheelAspects}
            animate
            ariaLabel={`Time-unknown chart wheel for ${person.displayName}: ten bodies at the noon reference, with no houses or angles`}
          />
          <p class="person-wheel__caption">
            Positions at 12:00 civil time in {person.birthPlace.entityLabel}—a reference instant, not a birth time.
            No houses, rising sign, angles, or sect were computed.
          </p>
        </div>

        <div class="person-blocks">
          {displayBlocks.map((block) => (
            <section class="person-block">
              <h2>{block.title}</h2>
              <p>{block.text}</p>
            </section>
          ))}
        </div>

        <nav class="person-actions" aria-label="Related readings">
          <a href={person.copy.birthdayLink.href}>{person.copy.birthdayLink.label}</a>
          <a href={person.copy.signLink.href}>{person.copy.signLink.label}</a>
          <a href="/people/">All people</a>
        </nav>

        <div id="sources">
          <EvidenceDisclosure
            class="person-evidence"
            label="Where this comes from"
            description="Sources, revisions, and exactly what this chart assumes"
            variant="panel"
          >
          <dl>
            <div>
              <dt>Source article</dt>
              <dd>
                <a href={person.sources.wikipedia.articleUrl} target="_blank" rel="noopener noreferrer">
                  {person.sources.wikipedia.title}
                </a>
                {' · revision '}{person.sources.wikipedia.revisionId}
              </dd>
            </div>
            <div>
              <dt>Wikidata</dt>
              <dd>
                <a href={person.sources.wikidata.entityUrl} target="_blank" rel="noopener noreferrer">{person.qid}</a>
                {' · revision '}{person.sources.wikidata.lastrevid}
              </dd>
            </div>
            <div><dt>Retrieved</dt><dd>{person.sources.retrievedAtUtc}</dd></div>
            <div>
              <dt>{adoptedDate ? 'Adopted birth date' : 'Birth date'}</dt>
              <dd>{person.birthDate.storedValue} · day precision · {person.birthDate.calendarModel}</dd>
            </div>
            <div>
              <dt>{referenceLocation ? 'Calculation reference location' : 'Birthplace'}</dt>
              <dd>
                {person.birthPlace.normalisedLabel} ·{' '}
                <a href={`https://www.wikidata.org/wiki/${person.birthPlace.entity}`} target="_blank" rel="noopener noreferrer">
                  {person.birthPlace.entity}
                </a>
              </dd>
            </div>
            {person.sourceReview && (
              <div>
                <dt>Reviewed source decision · {person.sourceReview.reviewedOn}</dt>
                <dd>
                  <p>{person.sourceReview.note}</p>
                  <ul>{person.sourceReview.sources.map((source) => (
                    <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a></li>
                  ))}</ul>
                  <p>The Wikidata and Wikipedia revisions above remain historical source records. Reviewed corrections are recorded separately.</p>
                </dd>
              </div>
            )}
            <div>
              <dt>Coordinates</dt>
              <dd>
                {coordinates.latitude.toFixed(4)}, {coordinates.longitude.toFixed(4)} · from{' '}
                <a href={`https://www.wikidata.org/wiki/${coordinates.sourceEntity}`} target="_blank" rel="noopener noreferrer">
                  {coordinates.sourceEntityLabel} ({coordinates.sourceEntity})
                </a>
                {coordinates.precisionDowngrade ? ` · ${coordinates.precisionDowngrade}` : ''}
              </dd>
            </div>
            <div><dt>Birth-time evidence in this profile</dt><dd>{person.birthTimeEvidence}</dd></div>
            {publishedTimeRecord && (
              <div>
                <dt>Separate published-time record</dt>
                <dd>
                  <a href={publishedTimeRecord.href} target="_blank" rel="noopener noreferrer">{publishedTimeRecord.label}</a>
                  {' · '}{publishedTimeRecord.detail}. It powers the homepage and three-dimensional sample; Zodiacs.org has not independently inspected the underlying birth record and does not merge it into this frozen Wikidata profile.
                </dd>
              </div>
            )}
            <div>
              <dt>Reference instant</dt>
              <dd>{person.computation.utcInstant} · noon civil time, not a birth time</dd>
            </div>
            <div><dt>Omitted</dt><dd>Rising sign, houses, angles, and sect—all require a birth time.</dd></div>
            <div>
              <dt>Unknown-time range</dt>
              <dd>
                Moon travelled {person.unknownTimeErrorBandDegrees.Moon.toFixed(2)}°
                {' · '}{moonStatement}
              </dd>
            </div>
            {openSignTransitions.length > 0 && (
              <div>
                <dt>Open signs</dt>
                <dd>{openSignStatement}</dd>
              </div>
            )}
            <div>
              <dt>Engine</dt>
              <dd>{person.computationInputVersion.ephemeris} · {person.computationInputVersion.aspectTable}</dd>
            </div>
            <div>
              <dt>Portrait</dt>
              <dd>
                {person.portrait.available
                  ? person.portrait.renderedAttribution
                  : `None published · ${person.portrait.reason}`}
              </dd>
            </div>
          </dl>
          <p class="person-evidence__correction">
            Something wrong here?{' '}
            <a href={`mailto:people@zodiacs.org?subject=${encodeURIComponent(`Correction or removal: ${person.displayName}`)}`}>
              Ask us to correct or remove it.
            </a>
          </p>
          </EvidenceDisclosure>
        </div>

        {related.length > 0 && (
          <section class="person-related" aria-labelledby="related-people">
            <p class="people-label" id="related-people">Also {person.sunSign.name}</p>
            <ul class="person-related__list">
              {related.map((candidate) => (
                <li><a href={`/people/${candidate.slug}/`}>{candidate.displayName}</a></li>
              ))}
            </ul>
          </section>
        )}

        <div style="margin-top:30px">
          <ShareRow
            text={`${person.displayName}'s chart, computed from ${adoptedDate ? 'an adopted, uncertain birth date' : 'a sourced birth date'}`}
            url={pageUrl}
          />
        </div>
      </div>
    </div>
  </article>

  <script>
    const image = document.querySelector<HTMLImageElement>('[data-person-portrait-image]');
    if (image) {
      const fail = () => {
        const figure = image.closest<HTMLElement>('[data-person-portrait]');
        const fallback = figure?.parentElement?.querySelector<HTMLElement>('[data-person-portrait-fallback]');
        if (figure) figure.hidden = true;
        if (fallback) fallback.hidden = false;
      };
      image.addEventListener('error', fail, { once: true });
      if (image.complete && image.naturalWidth === 0) fail();
    }
  </script>
</Base>
