---
/**
 * A public figure's Year Ahead Score (src/data/year-people.json). Living
 * people follow the protected living-person controls: noindex, nofollow,
 * outside the sitemap, search and the People directory, and the same headers
 * in vercel.json. Corrections and removals: people@zodiacs.org.
 */
import Base from '../../layouts/Base.astro';
import { YEAR_PEOPLE } from '../../lib/year-score/people';
import { yearPage } from '../../lib/year-score/page-data';
import { dayName, shortMonth } from '../../lib/year-score/reading';
import ShareRow from '../../components/ShareRow.astro';
import { figureYearScoreShareUrl } from '../../lib/year-score/share';
import { rangeWorthShowing } from '../../lib/year-score/range';
import { launchFlagOn } from '../../lib/launch-flags';

export function getStaticPaths() {
  // The people pages are built only while PUBLIC_YEAR_PEOPLE_ENABLED (and the score's own switch) is on.
  if (!launchFlagOn('PUBLIC_YEAR_PEOPLE_ENABLED')) return [];
  return YEAR_PEOPLE.map((person) => ({ params: { slug: person.slug }, props: { slug: person.slug } }));
}

const person = YEAR_PEOPLE.find((entry) => entry.slug === Astro.props.slug)!;
const page = await yearPage(person);
const { reading } = page;
// The month and transit sentences are written to the reader ("your Venus"); on a figure's page they name the figure.
const first = person.name.split(' ')[0];
const theirs = (text: string) => text
  .replace('A month to pace yourself, not to fear.', 'A month for pacing, not for fear.')
  .replace('an opening that rewards you if you take it', 'an opening that rewards whoever takes it')
  .replace(/\bYour\b/gu, `${first}'s`).replace(/\byour\b/gu, `${first}'s`);
const longDate = (iso: string) => new Intl.DateTimeFormat('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${iso}T12:00:00Z`));
const description = `${person.name}'s Year Ahead Score from ${dayName(page.from)}: ${reading.score.toFixed(1)}/10, ${reading.tier.label.toLowerCase()}, from the slow planets' transits to a ${person.birthTime ? 'timed' : 'noon'} chart.`;
---
<Base
  title={`${person.name}: Year Ahead Score | Zodiacs.org`}
  description={description}
  path={`/year/${person.slug}/`}
  noindex
  nofollow
>
  <section class="section--tight container container--narrow ypp">
    <p class="kicker">Year Ahead Score</p>
    <h1 class="display">{person.name}</h1>
    <p class="ypp__desc">{person.description}</p>

    <div class="shell tinted ypp__score" style={`--sign:${page.sun.hue}`}>
      <div class="core tinted ypp__score-core">
        <p class="ypp__number"><span>{reading.score.toFixed(1)}</span><span class="ypp__outof">/10</span></p>
        <p class="ypp__tier">{reading.tier.label}</p>
        <p class="ypp__summary">{theirs(reading.tier.summary)}</p>
        <p class="ypp__meta">{rangeWorthShowing(page.range) && `${reading.score.toFixed(1)}/10 (between ${page.range.low.toFixed(1)} and ${page.range.high.toFixed(1)} without a birth time) · `}{page.sun.name} Sun · {dayName(page.from)} to {dayName(page.to)} · Reading confidence 55%</p>
      </div>
    </div>

    {page.alternates.map((alternate) => (
      <p class="ypp__note">With the other published birth date, {longDate(alternate.birthDate)}, the score is {alternate.score.toFixed(1)}: {alternate.label.toLowerCase()}.</p>
    ))}

    <ol class="ypp__months" aria-label="Score by month" style={`--sign:${page.sun.hue}`}>
      {reading.months.map((month) => (
        <li title={`${month.name}: ${month.score.toFixed(1)}`}>
          <span class="ypp__bar" style={`--h:${Math.max(4, month.score * 10)}%`} aria-hidden="true"></span>
          <span class="ypp__month">{shortMonth(month.month)}</span>
          <span class="sr-only">{month.name}: {month.score.toFixed(1)} out of 10</span>
        </li>
      ))}
    </ol>

    <div class="ypp__picks">
      {reading.best && <div class="tile"><h2>Best month</h2><p>{theirs(reading.best.line)}</p></div>}
      {reading.hardest && <div class="tile"><h2>Hardest month</h2><p>{theirs(reading.hardest.line)}</p></div>}
    </div>

    {reading.drivers.length > 0 && (
      <div class="ypp__drivers">
        <h2>What moves the number</h2>
        <ul>
          {reading.drivers.map((driver) => (
            <li>
              <strong>{theirs(driver.title)}</strong>
              <span class="ypp__tone">{driver.tone}, {Math.round(driver.share * 100)}% of the year</span>
              <p>{theirs(driver.line)}</p>
              <p class="ypp__when">In orb {dayName(driver.inOrbFrom)} to {dayName(driver.inOrbTo)}, closest {dayName(driver.peak)}</p>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="ypp__facts">
      <h2>The chart</h2>
      <p>
        Born {longDate(person.birthDate)}, {person.birthplace}.
        {person.birthTime ? ` Birth time ${person.birthTime} from a published record.` : ' No birth time is published, so the chart is cast for noon on the birthplace clock and the Moon is left out.'}
      </p>
      {person.note && <p>{person.note}</p>}
      <p>
        Birth date source{person.sources.length > 1 ? 's' : ''}:{' '}
        {person.sources.map((source, index) => (
          <>{index ? ', ' : ''}<a href={source.url} rel="nofollow noopener" target="_blank">{source.title}</a></>
        ))}.
      </p>
      <p>Corrections or removal requests: <a href="mailto:people@zodiacs.org">people@zodiacs.org</a>.</p>
    </div>

    <p class="ypp__cta">
      <a class="btn btn--primary" href="/year-score/"><span>Score your own year</span><span class="orb" aria-hidden="true">↗</span></a>
      <a class="btn btn--ghost" href="/year/" rel="nofollow"><span>All Year Ahead scores</span><span class="orb" aria-hidden="true">→</span></a>
    </p>
    {/* The share link opens the card page, whose picture the server draws from the directory (src/server/result-preview.ts). */}
    <ShareRow text={`${person.name}'s Year Ahead Score: ${reading.score.toFixed(1)}/10`} url={figureYearScoreShareUrl('https://zodiacs.org', person.slug)!} label="Share this score:" />
  </section>
</Base>

<style>
  .ypp { display: grid; gap: 20px; }
  .ypp h1 { margin: 0; font-size: var(--text-2xl); }
  .ypp__desc { margin: -8px 0 0; color: var(--muted); }
  .ypp__score-core { display: grid; gap: 6px; padding: clamp(20px, 4vw, 30px); }
  .ypp__number { margin: 0; font-family: var(--font-serif); line-height: 1; font-size: clamp(56px, 12vw, 96px); }
  .ypp__outof { font-size: var(--text-xl); color: var(--muted); margin-left: 4px; }
  .ypp__tier { margin: 0; font-family: var(--font-serif); font-size: var(--text-xl); }
  .ypp__summary, .ypp__note { margin: 0; color: var(--text-2); }
  .ypp__meta { margin: 4px 0 0; color: var(--muted); font-family: var(--font-mono); font-size: var(--text-xs); }
  .ypp__months { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 4px; align-items: end; height: 140px; }
  .ypp__months li { display: grid; grid-template-rows: 1fr auto; height: 100%; align-items: end; text-align: center; }
  .ypp__bar { display: block; height: var(--h); background: var(--sign); opacity: 0.75; border-radius: 3px 3px 0 0; }
  .ypp__month { font-family: var(--font-mono); font-size: 10px; color: var(--muted); padding-top: 4px; }
  .ypp__cta { display: flex; flex-wrap: wrap; gap: 10px; margin: 0; }
  .ypp__picks .tile { padding: 16px 18px; }
  .ypp__picks { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .ypp h2 { margin: 0 0 6px; font-family: var(--font-serif); font-weight: 500; font-size: var(--text-lg); }
  .ypp__picks p, .ypp__drivers p, .ypp__facts p { margin: 4px 0 0; color: var(--text-2); }
  .ypp__drivers ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .ypp__tone { display: block; color: var(--muted); font-size: var(--text-sm); }
  .ypp__when { color: var(--muted) !important; font-size: var(--text-sm); }
</style>
