---
import conformance from '../../data/conformance/summary.json';
import Base from '../../layouts/Base.astro';
import { iframeEmbedCode } from '../../lib/widgets';
import { WIDGET_EN } from '../../strings/widgets';
import { completeTransitYears, yearsWithin } from '../../lib/sky-api/build';
import { PLANET_SLUGS } from '../../lib/sky-api/meta';
import skyQuickStart from '../../lib/sky-api/examples/today.mjs?raw';
import candidate from '../../data/platform-engine-candidate.json';
// The starter carries its own, separately reviewed engine pin. Labelling the
// card that opens it with the SITE's engine version told readers they would get
// rc.6 and then handed them rc.3, so the card is labelled from the starter's
// own manifest instead.
import starterEngine from '../../../examples/platform/candidate.json';
import mcp from '../../../public/examples/mcp-server.json';
import sky from '../../data/sky.json';
import eclipses from '../../data/eclipses.json';
import { FREE_OFFER, OPENAPI_URL, ORGANIZATION, SITE, SKY_DATA_LICENSE } from '../../lib/developer-structured-data.mjs';

// The same month snapshots the generator reads decide which year files exist,
// so this page and the deployed API can never disagree about coverage.
const monthKeys = Object.keys(import.meta.glob('../../data/transits-*.json'))
  .map((path) => path.slice(path.indexOf('transits-') + 'transits-'.length, -'.json'.length));
const years = completeTransitYears(monthKeys);
const firstYear = years.at(0);
const lastYear = years.at(-1);
const yearRange = `{${firstYear}–${lastYear}}`;

const dailyEndpoints = [
  ['/api/v1/sky/today.json', "Today's positions for the Sun, Moon, and eight planets (raw longitudes and formatted labels like 14°53′ Virgo), moon phase and illumination, the active retrograde windows, the next new and full moon with signs and traditional names, the day's exact events, and a plain-language summary. Positions are a 12:00 UTC snapshot. Daily publication is scheduled from 00:00 UTC; check the payload date because delivery can be delayed."],
  ['/api/v1/sky/upcoming.json', 'Every lunation, sign ingress, station, eclipse, and exact aspect in the next 60 days in order, plus the next occurrence of each kind and the current and next Mercury retrograde.'],
  [`/api/v1/planets/{${PLANET_SLUGS.join('|')}}.json`, 'One body: position at the daily snapshot, whether it is retrograde, its current and next retrograde window, every window in coverage, and its next sign ingress and station.'],
  ['/api/v1/signs.json', 'The twelve signs: element, modality, ruler and traditional ruler, polarity, house, conventional dates, the computed Sun season for this year, and which bodies occupy each sign today.'],
];

const yearlyEndpoints = [
  [`/api/v1/retrogrades/${yearRange}.json`, 'Retrograde windows intersecting the year: retrograde and direct station instants and signs, pre- and post-shadow boundaries, duration, and clipping flags where the data boundary truncates a window.'],
  [`/api/v1/stations/${yearRange}.json`, 'Every station — a planet turning retrograde or direct — with its sign and degree.'],
  [`/api/v1/ingresses/${yearRange}.json`, 'Every planetary sign ingress, with the exact instant and whether the planet entered moving retrograde.'],
  [`/api/v1/moon-phases/${yearRange}.json`, 'Every new and full moon with sign, degree, and the traditional full-moon name (Blue for a second full moon in one month).'],
  [`/api/v1/eclipses/${yearRange}.json`, 'Solar and lunar eclipses by instant of greatest eclipse: type, kind, sign, obscuration, and totality length.'],
  [`/api/v1/aspects/${yearRange}.json`, 'Exact planetary aspects (orb 0) across the year, each with a label such as Mars square Saturn.'],
];

const documents = [
  ['/api/v1/llms.txt', 'The guide for AI agents: every endpoint, every field, the caveats worth stating, and which file answers which question.'],
  ['/api/v1/openapi.json', 'OpenAPI 3.1 with every JSON Schema embedded, for tool-calling frameworks and typed clients.'],
  ['/api/v1/schema/{name}.v1.json', 'Each payload family\'s JSON Schema (draft 2020-12); every payload links its own under $schema.'],
  ['/api/v1/sky/today.md and /api/v1/sky/upcoming.md', 'The daily files rendered as Markdown for readers that fetch pages as text.'],
  ['/api/v1/index.json', 'Every endpoint and document above, with coverage and the data vintage.'],
];

const skyEmbed = iframeEmbedCode({ origin: 'https://zodiacs.org', kind: 'sky', theme: 'dark', title: WIDGET_EN.widgetTitleSky });

const description = 'Build with Zodiacs: evaluate the local TypeScript chart engine, call the compute API, fetch free shared-sky JSON, or embed a moon, sky, or mini-chart widget. Current support, release status, and calculation limits in one place.';

// The files the sky data generator writes, chosen as src/lib/sky-api/files.ts chooses them:
// retrogrades and Moon phases only for years sky.json covers, eclipses only for years eclipses.json covers.
const skyYears = yearsWithin(years, sky.from, sky.to);
const eclipseYears = yearsWithin(years, eclipses.from, eclipses.to);
const skyFiles = [
  '/api/v1/sky/today.json',
  '/api/v1/sky/upcoming.json',
  '/api/v1/signs.json',
  ...PLANET_SLUGS.map((slug) => `/api/v1/planets/${slug}.json`),
  ...['retrogrades', 'moon-phases'].flatMap((kind) => skyYears.map((year) => `/api/v1/${kind}/${year}.json`)),
  ...['stations', 'ingresses', 'aspects'].flatMap((kind) => years.map((year) => `/api/v1/${kind}/${year}.json`)),
  ...eclipseYears.map((year) => `/api/v1/eclipses/${year}.json`),
];
const jsonLd = [
  {
    '@type': 'WebPage',
    name: 'Zodiacs developer tools: charts, sky data, and embeds',
    url: 'https://zodiacs.org/developers/',
    description,
  },
  {
    '@type': 'WebAPI',
    name: 'Zodiacs sky data API',
    url: 'https://zodiacs.org/developers/#sky-data',
    description: 'Static JSON files under /api/v1/ about the sky everyone shares: today, the next 60 days, each planet, the signs, and yearly files of retrogrades, stations, ingresses, Moon phases, eclipses and exact aspects.',
    documentation: OPENAPI_URL,
    provider: ORGANIZATION,
    offers: FREE_OFFER,
  },
  {
    '@type': 'Dataset',
    name: 'Zodiacs shared sky data',
    description: `The JSON files of the Zodiacs sky data API: today's positions, the next 60 days of events, each planet, the signs, and yearly files from ${firstYear} to ${lastYear} of retrogrades, stations, ingresses, Moon phases, eclipses and exact aspects.`,
    url: 'https://zodiacs.org/developers/#sky-data',
    license: SKY_DATA_LICENSE,
    temporalCoverage: `${firstYear}-01-01/${lastYear}-12-31`,
    creator: ORGANIZATION,
    isAccessibleForFree: true,
    distribution: skyFiles.map((path) => ({ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${SITE}${path}` })),
  },
];
---
<Base
  title="Developer Tools — Local Charts, Sky Data & Embeds | Zodiacs.org"
  description={description}
  path="/developers/"
  jsonLd={jsonLd}
>
  <section class="section container container--narrow">
    <em class="kicker">For developers and AI agents</em>
    <h1 class="dev-title display">Charts, data, and embeds.</h1>

    <nav aria-label="Developer integration paths">
      <ul class="dev-paths">
        <li>
          <p class="dev-status">{candidate.releaseLabel} · engine {candidate.version}</p>
          <h2><a href="/developers/engine/">Calculate a chart</a></h2>
          <p>{candidate.name} takes an instant and coordinates and returns bodies, angles, cusps and aspects, in your own browser or Node.js process, with no network request. What it computes, what it costs to bundle, how close it is to Swiss Ephemeris, and how to install it are on its page. <a href="/developers/examples/">The starter</a> is the same job as a running project; it pins engine {starterEngine.version}, while the site runs {candidate.version}.</p>
        </li>
        <li>
          <p class="dev-status">Available · runs on our server</p>
          <h2><a href="/developers/compute/">Calculate on our server</a></h2>
          <p>Seven POST endpoints for a chart, positions, houses, the events in a window, a local time read as UTC, whether a sky fact holds, and when chosen conditions all hold, each answer with a receipt and the engine's version. No key. Birth data goes in the request body, and the function writes nothing from a request to a log, a file or a database. The endpoints answer only while their per-address rate limit is in place.</p>
        </li>
        <li>
          <p class="dev-status">Available · hosted embeds</p>
          <h2><a href="/widgets/">Embed a tool</a></h2>
          <p>Choose a Moon, sky, or mini birth-chart iframe, set its theme and size, and copy the embed. The credit link stays.</p>
        </li>
        <li>
          <p class="dev-status">{mcp.releaseStatus === 'unpublished-candidate' ? 'Unpublished candidate' : 'Available'} · {mcp.version}</p>
          <h2><a href="/developers/mcp/">Connect an AI assistant</a></h2>
          <p>A local MCP server, tested with Claude Code. It calculates a chart or compares two records on your own machine over stdio. The calculation never leaves the machine; what the assistant you connect it to does with the result is a separate question.</p>
        </li>
        <li>
          <p class="dev-status">Available · runs in your browser</p>
          <h2><a href="/developers/compare/">Compare two calculation records</a></h2>
          <p>When two runs of this engine disagree, this lists every value that differs and says which of them anything in the two files can actually explain. It reads the record format this site produces, not screenshots or another program's export.</p>
        </li>
        <li>
          <p class="dev-status">Available · suite {conformance.suiteVersion}</p>
          <h2><a href="/developers/conformance/">Check an engine against independent references</a></h2>
          <p>Test vectors for positions, houses and angles, time zones, time scales and calendars, each with an independent arbiter and a stated tolerance, with the results for @zodiacs/engine and for Swiss Ephemeris. Any engine can be run against them through a small adapter.</p>
        </li>
        <li>
          <p class="dev-status">Available · version 0</p>
          <h2><a href="/developers/sky-benchmark/">Test an assistant on questions about the sky</a></h2>
          <p>Questions a calculation settles (which sign a body was in, whether a planet was retrograde, when the Moon was full), with the engine's answer to each, a scorer that reads replies without a person, and the MCP adapter's check_sky_fact reply to each.</p>
        </li>
      </ul>
    </nav>
    <div class="prose">
      <p>
        Also here, without an account or a key: <a href="#sky-data">shared sky data</a> as
        plain JSON files, and <a href="/developers/support/">the support matrix</a> —
        runtime requirements, the runtimes actually tested and known limits — worth
        reading before you choose an integration.
      </p>
      <p>
        The <a href="/sdk/">optional ownership SDK</a> is a separate,
        read-only integration for registry verification and public ownership
        reads. Charts, sky data, and widgets do not require it or a wallet.
      </p>
    </div>

    <h2 id="sky-data" class="dev-h2">Shared sky data</h2>
    <div class="prose dev-intro">
      <p>
        The computed dates behind this site's calendars — today's sky, the
        weeks ahead, retrograde windows, stations, sign ingresses, moon phases,
        eclipses, and exact aspects — are published as versioned JSON. The
        files are static, cached at the edge, and open to any origin. There is
        no key or signup. These files contain no personal birth data: they describe
        the shared sky, and the site's own{' '}
        <a href="/methodology/">chart calculation stays on the device</a>.
      </p>
    </div>

    <h2 class="dev-h2">Quick start</h2>
    <p class="dev-note">One request returns today's sky. No key, no account:</p>
    <pre class="dev-code" tabindex="0" role="region" aria-label="Terminal quick start"><code>curl --fail --silent --show-error https://zodiacs.org/api/v1/sky/today.json</code></pre>
    <p class="dev-note">
      The payload opens with a <code>summary</code> you can read straight out,
      and names the edition it was computed for in <code>date</code> and{' '}
      <code>snapshotAt</code>. Editions change daily and delivery can be delayed,
      so read those fields rather than assuming the file you hold is current.
      Before noon, a snapshot describes positions computed for later that day.
    </p>
    <p class="dev-note">In JavaScript, with the checks worth keeping in production:</p>
    <pre class="dev-code" tabindex="0" role="region" aria-label="JavaScript quick start"><code>{skyQuickStart}</code></pre>
    <p class="dev-note">
      This one checks the payload kind, the fields it uses, and the current UTC
      edition before displaying the computed snapshot.
    </p>

    <h2 class="dev-h2">Sky data for AI agents</h2>
    <div class="prose">
      <p>
        Every payload is self-describing. It opens with a{' '}
        <code>summary</code> — one or two plain sentences that state the
        file's facts, ready to quote — and carries an <code>about</code> block
        that defines each field and its units, a <code>$schema</code> link to
        its JSON Schema, and <code>links</code> to the related files. Raw
        numbers come with formatted twins (<code>lon</code> alongside{' '}
        <code>position</code>, <code>illumination</code> alongside{' '}
        <code>illuminationPercent</code>), and every event carries a{' '}
        <code>label</code> such as "Mercury retrograde in Scorpio, October 24,
        2026 – November 13, 2026".
      </p>
      <p>
        An agent should start at{' '}
        <a href="/api/v1/llms.txt"><code>/api/v1/llms.txt</code></a>: it
        lists every endpoint, defines every field, states the caveats worth
        repeating, and maps common questions ("Is Mercury retrograde?", "When
        is the next full moon?", "When does the Sun enter Libra?") to the file
        and field that answer them. Tool-calling frameworks can load{' '}
        <a href="/api/v1/openapi.json"><code>/api/v1/openapi.json</code></a>{' '}
        directly, and the daily files have Markdown twins for readers that
        fetch pages as text.
      </p>
    </div>

    <h2 class="dev-h2">Daily endpoints</h2>
    <ul class="dev-endpoints">
      {dailyEndpoints.map(([path, text]) => (
        <li>
          <code>{path}</code>
          <p>{text}</p>
        </li>
      ))}
    </ul>

    <h2 class="dev-h2">Yearly endpoints</h2>
    <ul class="dev-endpoints">
      {yearlyEndpoints.map(([path, text]) => (
        <li>
          <code>{path}</code>
          <p>{text}</p>
        </li>
      ))}
    </ul>

    <h2 class="dev-h2">Documents and schemas</h2>
    <ul class="dev-endpoints">
      {documents.map(([path, text]) => (
        <li>
          <code>{path}</code>
          <p>{text}</p>
        </li>
      ))}
    </ul>

    <h2 class="dev-h2">The contract</h2>
    <div class="prose">
      <p>
        Positions are apparent geocentric tropical longitudes from the same
        engine the calculators use, tested against NASA JPL Horizons reference
        data at two dates, 1907 and 2020, where the largest difference is 14.8
        arcseconds. Today's positions are a single snapshot taken at 12:00 UTC
        (<code>snapshotAt</code>). Publication is scheduled from 00:00 UTC;
        jobs, deployment, or caches can delay availability. All instants are UTC in ISO 8601, and signs
        are lowercase slugs with an English <code>signName</code> beside them.
      </p>
      <p>
        A retrograde window's <code>from</code> and <code>to</code> are its
        stations unless <code>clippedStart</code> or <code>clippedEnd</code>{' '}
        is true, which means the data boundary truncated the window and the
        real station lies outside coverage. Within v1, fields are added, never
        renamed or removed; a breaking change would ship under{' '}
        <code>/api/v2/</code> and v1 would keep working. Yearly files are
        byte-stable between data refreshes, so conditional requests are cheap.
        Year files cover {firstYear}–{lastYear} today and grow as the
        underlying data is extended; read{' '}
        <a href="/api/v1/index.json"><code>index.json</code></a> rather than
        assuming which years exist.
      </p>
    </div>

    <h2 class="dev-h2">Freshness and caching</h2>
    <div class="prose">
      <p>
        Check the file you consume: <code>date</code> identifies the UTC edition
        for today's sky, planet files, and signs; <code>snapshotAt</code> is
        its noon snapshot. Upcoming events use <code>from</code> as the snapshot
        instant. <code>generatedAt</code> records the file build time and can
        change without a new edition. The index's <code>coverage.dailyDate</code>
        describes the index; separately cached files can have different dates.
        Label an older edition by its date or wait for a current one before
        presenting it as today's sky.
      </p>
      <p>
        Current cache lifetimes are 300 seconds for <code>sky/today.json</code>,
        3,600 seconds for <code>index.json</code>, and 86,400 seconds for the
        remaining API files, including upcoming events, planets, signs, and
        Markdown twins. Revalidation can refresh a cached response; always
        check its edition date as well. Yearly files remain byte-stable between
        data refreshes.
      </p>
    </div>

    <h2 class="dev-h2">License and attribution</h2>
    <div class="prose">
      <p>
        The data is free to use under{' '}
        <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener noreferrer">CC BY 4.0</a>.
        Credit "Zodiacs.org" with a link to{' '}
        <a href="/">https://zodiacs.org</a> wherever the data is shown.
      </p>
    </div>

    <h2 class="dev-h2">Widgets and feeds</h2>
    <div class="prose">
      <p>
        If you would rather embed a finished surface than consume JSON, the{' '}
        <a href="/widgets/">embeddable widgets</a> render tonight's moon,
        today's sky, and a mini birth chart inside a sandboxed iframe. Dated
        editorial is available as RSS:{' '}
        <a href="/feeds/horoscopes.xml">daily horoscopes</a> and{' '}
        <a href="/feeds/daily-sky.xml">the daily sky</a>. The site-wide guide
        for agents is <a href="/llms.txt">llms.txt</a>.
      </p>
    </div>

    <h2 class="dev-h2">Embed today's sky</h2>
    <div class="prose">
      <p>
        The same daily edition as <code>/api/v1/sky/today.json</code>, as a
        finished card: one iframe, no script on your page, and the{' '}
        <code>theme</code> and <code>accent</code> parameters are applied
        inside the frame. The card links back to zodiacs.org, which is the
        attribution.
      </p>
    </div>
    <pre class="dev-code"><code>{skyEmbed}</code></pre>
  </section>
</Base>

<style>
  .dev-title { margin: var(--s-1) 0 var(--s-4); }
  .dev-intro { max-width: 68ch; }
  .dev-paths { list-style: none; padding: 0; margin: var(--s-8) 0; display: grid; gap: var(--s-6); }
  .dev-paths li { min-width: 0; padding-top: var(--s-4); border-top: 1px solid var(--hair-2); }
  .dev-paths h2 { margin: var(--s-2) 0; font-size: var(--text-lg); }
  .dev-paths p { margin: 0; color: var(--muted); font-size: var(--text-sm); line-height: 1.65; }
  .dev-paths .dev-status { font-size: 12px; color: var(--text-2); }
  .dev-paths a:focus-visible { outline: 2px solid var(--text-2); outline-offset: 4px; }
  @media (min-width: 700px) { .dev-paths { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .dev-h2 { margin: var(--s-12) 0 var(--s-4); font-size: var(--text-lg); }
  .dev-code {
    margin: 0;
    padding: var(--s-4);
    border: 1px solid var(--hair-2);
    border-radius: var(--r-md);
    background: var(--void-1);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.65;
  }
  .dev-note { margin: var(--s-3) 0 0; color: var(--muted); font-size: var(--text-sm); }
  .dev-note code, .dev-endpoints code, .prose code {
    font-family: var(--font-mono);
    font-size: .92em;
  }
  .dev-note code { overflow-wrap: anywhere; }
  .dev-endpoints {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-4);
  }
  .dev-endpoints li {
    padding: var(--s-4);
    border: 1px solid var(--hair-2);
    border-radius: var(--r-md);
  }
  .dev-endpoints li code { font-size: 12px; overflow-wrap: anywhere; }
  .dev-endpoints li p { margin: var(--s-2) 0 0; color: var(--muted); font-size: var(--text-sm); line-height: 1.6; }
</style>
