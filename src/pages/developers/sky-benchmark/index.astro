---
import Base from '../../../layouts/Base.astro';
import items from '../../../../public/developers/sky-benchmark/v0/items.json';
import key from '../../../../public/developers/sky-benchmark/v0/key.json';
import { checks } from '../../../../public/developers/sky-benchmark/v0/tool-answers.json';

const FILES = '/developers/sky-benchmark/v0';
const SOURCE = 'https://github.com/zodiacs-org/site/blob/main';

const title = 'Sky-Fact Benchmark for AI Assistants | Zodiacs.org';
const description = '300 questions about the sky that a calculation settles, with the engine\'s answer and check_sky_fact\'s reply to each, and a scorer, for testing AI assistants.';

type Item = (typeof items.items)[number];
type Entry = (typeof key.items)[number];
const entries = new Map<string, Entry>(key.items.map((entry) => [entry.id, entry]));
const number = (value: number) => value.toLocaleString('en-US');

const familyTitles: Record<string, string> = {
  'sign-at-instant': 'A sign at an instant',
  'sign-on-date': 'A sign on a date',
  'retrograde-on-date': 'Retrograde on a date',
  'ingress-date': 'The date of an ingress',
  'lunation-date': 'The date of a lunation',
};

function mix(family: string): string {
  const answers = items.items.filter((item: Item) => item.family === family).map((item: Item) => entries.get(item.id)!.answer);
  const count = (value: string) => answers.filter((answer) => answer === value).length;
  if (family === 'sign-on-date') return `${count('DEPENDS')} DEPENDS, ${answers.length - count('DEPENDS')} a sign`;
  if (family === 'retrograde-on-date') return `${count('YES')} YES, ${count('NO')} NO, ${count('DEPENDS')} DEPENDS`;
  if (family === 'sign-at-instant') return `a sign, ${new Set(answers).size} different ones`;
  return 'a date';
}

const families = items.families.map((family) => ({
  ...family,
  title: familyTitles[family.id] ?? family.id,
  mix: mix(family.id),
  example: items.items.find((item: Item) => item.family === family.id)!,
}));
const exampleAnswer = (item: Item) => entries.get(item.id)!.accepted.join(' or ');
const twoDates = key.items.filter((entry: Entry) => entry.accepted.length === 2).length;
const dateAnswers = key.items.filter((entry: Entry) => /^\d{4}-/u.test(entry.answer)).length;

const jsonLd = [{
  '@type': 'Dataset',
  name: `${items.name}, ${items.version}`,
  description,
  url: 'https://zodiacs.org/developers/sky-benchmark/',
  version: items.version,
  temporalCoverage: `${items.dates.from}/${items.dates.to}`,
  isAccessibleForFree: true,
  creator: { '@type': 'Organization', name: 'Zodiacs.org', url: 'https://zodiacs.org/' },
  distribution: ['items.json', 'key.json', 'tool-answers.json'].map((name) => ({
    '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `https://zodiacs.org${FILES}/${name}`,
  })),
}];
---
<Base title={title} description={description} path="/developers/sky-benchmark/" jsonLd={jsonLd}>
  <section class="section container container--narrow benchmark-page">
    <em class="kicker">Sky-fact benchmark</em>
    <h1 class="display">Test an assistant on questions a calculation settles.</h1>

    <div class="prose">
      <p>
        The {items.name} is {items.count} questions about the sky: which sign a
        body was in, whether a planet was retrograde, and on what date a body
        entered a sign or the Moon reached a phase. Each asks for its answer in
        a fixed form, so a reply can be scored without a person reading it.
        Version {items.version.slice(1)} was drawn on 5 October 2026, from dates
        between {items.dates.from.slice(0, 4)} and {items.dates.to.slice(0, 4)}.
        Its files will not change: a test holds them to the bytes they were
        published with, and the generator will not draw them again with
        another engine, so a new engine or a new rule makes a new version.
      </p>
      <p>
        The answer key is the engine's: {key.engine.name} {key.engine.version},
        its longitudes, speeds and Moon phase sampled every 10 minutes to 6
        hours, depending on the body and the span searched, and narrowed to the
        second. Every answer in the key also agrees with NASA JPL Horizons.
        Beside the key are the replies of <code>check_sky_fact</code>, the{' '}
        <a href="/developers/mcp/">MCP adapter</a>'s tool for these questions,
        which runs the <a href="/developers/compute/">compute API</a>'s
        sky-fact calculation, unchanged. No assistant has been scored on it
        yet.
      </p>
    </div>

    <h2 id="questions">The questions</h2>
    <div class="benchmark-table-wrap" tabindex="0" role="region" aria-label="Questions by family">
      <table>
        <thead><tr><th scope="col">Family</th><th scope="col">Questions</th><th scope="col">Answers</th></tr></thead>
        <tbody>
          {families.map((family) => (
            <tr>
              <th scope="row">{family.title}</th>
              <td>{family.count}</td>
              <td>{family.mix}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="prose">
      <p>One from each family, with its answer:</p>
      <ul>
        {families.map((family) => (
          <li>{family.example.prompt} <span class="benchmark-answer">{exampleAnswer(family.example)}</span></li>
        ))}
      </ul>
      <p>
        A date with no time or zone is read in every UTC offset in use today
        at once, from −12:00 to +14:00: from 14 hours before its midnight UTC
        to 36 hours after. When a body changes sign or stations within those
        hours, the answer turns on the time of day or the zone, and the right
        reply is DEPENDS. For a question whose answer is a date, every date
        that holds the event in one of those offsets is right: two dates for{' '}
        {twoDates} of the {dateAnswers} such questions, and three for the
        rest. Such a question names a year, or for the Moon a month, in which
        the body enters the sign once, moving forward, or which has one
        lunation of that phase, read in every offset.
      </p>
      <p>
        A question is left out when its answer would turn on less than a
        margin: a body within 1′ of a sign boundary at the instant asked
        about, or the Moon within 30′; an event within 10 minutes of the edge
        of a date, or within the time the body takes to move 30″, more than
        the engine's largest measured error for any planet; a station within 6
        hours of one. Where the answer is that a planet stays in one sign on a
        date, or enters a sign once in a period, a station within 30″ of that
        sign's boundaries also leaves the question out. So does another entry
        of the body into the sign within those margins outside the period, for
        the Sun and the Moon too, and for a lunation, another of the same
        phase within 10 minutes outside it. ΔT is observed to 24 September
        2026, predicted to 2 October 2027 and extrapolated after that. The
        engine's estimate of its uncertainty reaches about 12 seconds by 2049,
        far inside these margins.
      </p>
    </div>

    <h2 id="scoring">Scoring</h2>
    <div class="prose">
      <p>
        <a href={`${FILES}/scorer.mjs`}>The scorer</a> reads each reply
        strictly and, only when that fails, leniently. Strictly, the reply's
        last line that is not empty, without quotes, backticks or emphasis
        around it and without full stops or exclamation marks at its end, must
        be one answer in the asked-for form: a sign's name or symbol, YES, NO
        or DEPENDS where the question allows them, or a date written
        YYYY-MM-DD. Failing that, the whole reply, with any copy of the
        question or its instruction taken out, and with "Gemini" ignored where
        it names Google's assistant in the forms the scorer lists, must name
        exactly one such answer. A date may then also be written as 7 March
        2023, as March 7, 2023 or as 2023/03/07, and YES or NO counts only as
        a word on its own, so "no idea" and "no-one" are not NO; "yes and no"
        names both, and "yes or no" neither. Letter case never matters, and a
        reply that neither reading parses counts as wrong, as does a question
        with no reply.
      </p>
      <p>
        The strict score is the benchmark's score. The lenient one counts a
        reply right under either reading, so it is a rough guide to how much
        of a gap is the form of the replies: a reply that opens with a stray
        "Yes," still reads as YES, and one that names two signs, with neither
        alone on its last line, reads as nothing.
      </p>
      <p>
        The scorer needs Node.js 18 or later and nothing else, and reads
        items.json and key.json from its own folder. The replies go in a file,
        one per line, as JSON:
      </p>
    </div>
    <pre tabindex="0" role="region" aria-label="A replies file"><code>{`{"id":"si-001","reply":"Aquarius"}
{"id":"si-002","reply":"Scorpio"}`}</code></pre>
    <div class="prose">
      <p>Then:</p>
    </div>
    <pre tabindex="0" role="region" aria-label="Running the scorer"><code>node scorer.mjs replies.jsonl</code></pre>
    <div class="prose">
      <p>
        It prints the strict and lenient scores, overall and for each family,
        how many questions had a reply, and how each reply was read.
      </p>
    </div>

    <h2 id="files">The files</h2>
    <div class="prose">
      <ul>
        <li><a href={`${FILES}/items.json`}>items.json</a>: the questions, word for word, and the form each answer takes.</li>
        <li><a href={`${FILES}/key.json`}>key.json</a>: the engine's answer to each, every answer accepted, and the values that decide it.</li>
        <li><a href={`${FILES}/tool-answers.json`}>tool-answers.json</a>: what <code>check_sky_fact</code> returned for each question when the version was drawn, with its receipt.</li>
        <li><a href={`${FILES}/scorer.mjs`}>scorer.mjs</a>: the scorer.</li>
      </ul>
      <p>
        <a href={`${SOURCE}/scripts/build-sky-benchmark.mjs`}>The generator</a>{' '}
        draws the questions from fixed rules with a seeded random number
        generator, so with {key.engine.name} {key.engine.version} it draws the
        same questions and key on every run. The site's tests fail if they
        differ from the published files, or if <code>check_sky_fact</code> no
        longer gives the published replies' answers, or the facts behind them;
        the receipts beside the replies may change. No licence has been chosen
        for these files yet; until one is, they fall under the site's
        all-rights-reserved notice.
      </p>
    </div>

    <h2 id="agreement">How the key was checked</h2>
    <div class="prose">
      <p>
        <code>check_sky_fact</code> finds sign changes, stations and lunations
        with the compute API's search, which samples every 5 days, or every
        day for the Moon; the key samples every 10 minutes to 6 hours. On every
        question the tool gives the key's answer, and{' '}
        <a href={`${SOURCE}/tests/benchmarks/sky-benchmark.test.ts`}>a test</a>{' '}
        holds it to the key on {number(checks.facts)} facts: for a question
        about a sign, each of the twelve signs; for a question about whether a
        planet was retrograde, that question; for a question whose answer is a
        date, every date the key accepts and the date either side; and, for
        each of the {checks.retrogradeEntries} entries into a sign while
        retrograde in the periods the ingress questions name, every date that
        holds it, {checks.retrogradeEntryDates} in all.
      </p>
      <p>
        Both read the same engine, so this checks the compute API's search and
        its reading of a date against a dense scan of that engine on these
        questions. It does not prove the search misses nothing, and it says
        nothing about whether the engine is right.
      </p>
      <p>
        For that, every answer in the key was checked against NASA JPL
        Horizons' apparent longitudes of date, sampled around each question,
        and all {items.count} agree. The{' '}
        <a href={`${SOURCE}/docs/platform/evidence/sky-benchmark-v0/README.md`}>evidence record</a>{' '}
        gives the differences. The engine's accuracy over many more instants
        is measured on <a href="/developers/conformance/">the conformance
        page</a>.
      </p>
    </div>

    <h2 id="limits">Limits</h2>
    <div class="prose">
      <ul>
        <li>The tropical zodiac only, and questions in English only.</li>
        <li>The questions ask for an answer in a fixed form, which is not how people usually ask.</li>
        <li>The key is public, so a model may have seen it, and a later model may have been trained on it.</li>
        <li>Three DEPENDS answers turn only on offsets more than 10 hours from UTC, and the questions do not say which offsets count: sd-001 on those east of +11:20, sd-037 on UTC+14 alone, and sd-049 on UTC−12:00 alone, an offset no inhabited place keeps.</li>
        <li><code>check_sky_fact</code> ships only in the MCP adapter's candidate 0.1.0-rc.16.2, which is not on npm.</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .benchmark-page h1 { margin: var(--s-1) 0 var(--s-4); }
  .benchmark-page h2 { margin: var(--s-12) 0 var(--s-4); font-size: var(--text-lg); scroll-margin-top: 96px; }
  .benchmark-page .prose { max-width: 68ch; }
  .benchmark-page code { font-family: var(--font-mono); font-size: .9em; overflow-wrap: anywhere; }
  .benchmark-answer { font-family: var(--font-mono); font-size: .9em; color: var(--text-2); white-space: nowrap; }
  .benchmark-answer::before { content: '→ '; }
  pre { margin: var(--s-6) 0; padding: var(--s-4); border: 1px solid var(--hair-2); border-radius: var(--radius-sm); max-width: 100%; overflow-x: auto; font-size: var(--text-sm); line-height: 1.7; }
  pre:focus-visible, .benchmark-table-wrap:focus-visible { outline: 2px solid var(--text-2); outline-offset: 4px; }
  pre code { overflow-wrap: normal; }
  .benchmark-table-wrap { overflow-x: auto; margin: var(--s-4) 0; }
  .benchmark-table-wrap table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  .benchmark-table-wrap th,
  .benchmark-table-wrap td { padding: 10px 12px; border-bottom: 1px solid var(--hair-1); text-align: left; vertical-align: top; }
  .benchmark-table-wrap thead th { color: var(--faint); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; }
  .benchmark-table-wrap tbody th { font-weight: 500; }
  .benchmark-table-wrap td { font-family: var(--font-mono); }
</style>
