---
import Base from '../../../layouts/Base.astro';
import candidate from '../../../data/platform-engine-candidate.json';
import bundle from '../../../data/engine-bundle.json';
import { engineInstallBlock } from '../../../lib/engine-install-block';
import { ENGINE_DEMO_SOURCE, ENGINE_DEMO_OUTPUT } from '../../../lib/engine-demo';
import { ENGINE_LICENSES, FREE_OFFER, ORGANIZATION, developerBreadcrumb } from '../../../lib/developer-structured-data.mjs';

const install = engineInstallBlock(candidate);
// A vendored candidate is not on npm: the registry serves an earlier version under `next`.
const published = candidate.releaseStatus === 'published';
// The package sits at the root of its repository from rc.7 (packages/engine of the SDK before).
const sourceTree = `${candidate.sourceRepository}/tree/${candidate.sourceCommit}${candidate.sourcePackagePath ? `/${candidate.sourcePackagePath}` : ''}`;

const title = 'Zodiacs Engine — Local TypeScript Chart Engine | Zodiacs.org';
// A plain literal, not a template: scripts/build-assistant-context.mjs reads
// this constant out of the source to build the committed site guide, and it
// only matches a quoted string. Keeping the measured figures out of it also
// means the meta description cannot drift away from the table below.
const description = '@zodiacs/engine is the TypeScript chart engine behind zodiacs.org, MIT code with CC BY 4.0 ΔT data: natal charts, transits, synastry, Moon phase and Saturn returns, computed in your own browser or Node process with no network request. What it computes, what it costs to bundle, how close it is to Swiss Ephemeris, and an install that verifies the archive digest.';

const kb = (n: number) => `${n} KB`;

const api = [
  ['positions(date)', 'Apparent geocentric tropical longitudes for an instant: Sun through Pluto plus the true nodes, with ecliptic latitude, daily speed, retrograde state and sign.'],
  ['natalChart(birth)', 'A full chart from a resolved UTC instant and coordinates: bodies, angles, house cusps and major aspects, plus the flags that say what was assumed. Without a known time it returns positions and leaves angles and houses null.'],
  ['transits(natal, date)', 'Current positions and their major aspects to a natal chart.'],
  ['synastry(first, second)', 'Inter-chart aspects between two charts with element and modality balances.'],
  ['moonPhase(date)', 'Phase angle, illumination and name, from the same positions a chart uses.'],
  ['saturnReturn(birth)', 'Natal Saturn and every return season to roughly age 92, each with its exact crossings.'],
  ['progressedBodies(birth, target)', 'Secondary progressions: the positions one day after birth for each tropical year of life lived to the target date. This site\'s progressed lens uses it.'],
  ['findConfiguredAspects(bodies, policy)', 'Aspects under a policy you set with createAspectPolicy: major, minor or custom angles, and orbs per aspect, per body and for applying or separating motion.'],
  ['chartDeclinations(chart)', 'Right ascension and declination of each body, parallels and contraparallels, and each body\'s signed margin to the out-of-bounds limit, in arcseconds.'],
  ['@zodiacs/engine/timing', 'Hellenistic timing, a separate import: annual profections, firdaria, zodiacal releasing and solar arc directions. This site uses none of it.'],
  ['@zodiacs/engine/vedic', 'The sidereal zodiac, a separate import: ayanamsas, sidereal charts, nakshatras, vargas, KP sub-lords and the Vimshottari, Yogini and Ashtottari dashas. This site uses none of it.'],
];

const software = 'https://zodiacs.org/developers/engine/#software';
const jsonLd = [
  {
    '@type': 'SoftwareApplication',
    '@id': software,
    name: 'Zodiacs Engine',
    alternateName: candidate.name,
    description,
    url: 'https://zodiacs.org/developers/engine/',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Node.js 20.19 or a later 20.x, Node.js 22.7 and newer, or a browser through a bundler',
    softwareVersion: candidate.version,
    // The archive this page's install block fetches and checks.
    downloadUrl: candidate.artifactUrl,
    license: ENGINE_LICENSES,
    isAccessibleForFree: true,
    offers: FREE_OFFER,
    publisher: ORGANIZATION,
  },
  {
    '@type': 'SoftwareSourceCode',
    name: 'Zodiacs Engine source code',
    codeRepository: candidate.sourceRepository,
    programmingLanguage: 'TypeScript',
    runtimePlatform: 'Node.js, browsers',
    license: ENGINE_LICENSES,
    targetProduct: { '@id': software },
  },
  developerBreadcrumb('/developers/engine/', 'Zodiacs Engine'),
];
---
<Base title={title} description={description} path="/developers/engine/" jsonLd={jsonLd}>
  <section class="section container container--narrow engine-page">
    <em class="kicker">Zodiacs Engine</em>
    <h1 class="display">Calculate charts in your own process.</h1>

    <div class="prose">
      <p>
        <code>{candidate.name}</code> is the chart engine this site runs. It
        takes an instant and a pair of coordinates and returns bodies, angles,
        house cusps and aspects. The calculation is synchronous and makes no
        network request: nothing about the birth details it is given leaves
        the process it runs in.
      </p>
      <p>
        ESM, TypeScript declarations included, for Node.js 20.19 or a later
        20.x, Node.js 22.7 and newer, or any browser with a bundler. The code
        is MIT; the package is MIT and CC BY 4.0 together, because its ΔT
        module carries 32 values from Stephenson, Morrison and Hohenkerk's
        Table S15, which are CC BY 4.0. It also carries time data: the IERS
        leap-second list and a UT1 − UTC table from IERS, and the IANA time
        zone history before 1970; its <code>NOTICE</code> names every source.
        One runtime dependency —{' '}
        <a href="https://github.com/cosinekitty/astronomy" rel="noopener noreferrer">Astronomy Engine</a>{' '}
        by Don Cross, also MIT, which supplies the planetary and lunar series.
        Zodiacs did not write those models; what is ours is the chart on top of
        them — houses, angles, aspects, the record format and the limits.
      </p>
    </div>

    <h2 id="demo">A worked example</h2>
    <div class="prose">
      <p>
        This is the whole of it. The output below is what the program prints —
        a test in this repository runs this exact source against the archive
        below and fails if the two stop matching.
      </p>
    </div>
    <pre tabindex="0" role="region" aria-label="Worked example"><code>{ENGINE_DEMO_SOURCE}</code></pre>
    <pre tabindex="0" role="region" aria-label="Output of the worked example" class="engine-output"><code>{ENGINE_DEMO_OUTPUT}</code></pre>

    <h2 id="install">Install it</h2>
    {published ? (
      <>
        <div class="prose">
          <p>
            This revision vendors {candidate.version}. The verified registry read of
            {candidate.registryObservedOn} records it under <code>next</code>;
            <code>latest</code> remains 0.1.1-rc.15. Install this exact published version:
          </p>
        </div>
        <pre tabindex="0" role="region" aria-label="Install from npm"><code>{`npm install ${candidate.name}@${candidate.version}`}</code></pre>
        <div class="prose">
          <p>
            The recorded npm release was published from the engine repository's <code>release.yml</code>{' '}
            workflow with SLSA provenance. The provenance names the source
            repository, the workflow and the commit the package was built from, and{' '}
            <code>npm audit signatures</code> verifies it. That shows where the
            package came from, not that its results are right;{' '}
            <a href="#accuracy">How close it is</a> gives the measurements.
          </p>
          <p>
            The pinned {candidate.version} archive below is byte-identical to the
            verified npm tarball. To install the same bytes through its immutable carrier,
            paste this into a POSIX shell, in your project's directory; it refuses
            to install anything whose digest does not match. It also stops if that
            directory has no package.json, because npm would otherwise install into
            the nearest directory above it that has one.
          </p>
        </div>
      </>
    ) : (
      <div class="prose">
        <p>
          This revision vendors {candidate.version}, a release candidate that is
          not on npm. To install it, paste this into a POSIX shell, in your
          project's directory: it downloads the archive from its immutable
          carrier in the engine repository and refuses to install anything whose
          digest does not match. It also stops if that directory has no
          package.json, because npm would otherwise install into the nearest
          directory above it that has one.
        </p>
      </div>
    )}
    <pre tabindex="0" role="region" aria-label="Install commands"><code>{install}</code></pre>
    <div class="prose">
      <p class="engine-hash">SHA-256: <code>{candidate.sha256}</code></p>
      {!published && (
        <p>
          On npm, the verified registry read of {candidate.registryObservedOn}{' '}
          records {candidate.registryVersion} under <code>next</code> and
          0.1.1-rc.15 under <code>latest</code>.{' '}
          <code>{`npm install ${candidate.name}@${candidate.registryVersion}`}</code>{' '}
          installs {candidate.registryVersion}, the release before this one,
          which refuses the sidereal zodiac in <code>@zodiacs/engine/calc</code>.
          It was published from the engine repository's <code>release.yml</code>{' '}
          workflow with SLSA provenance, which names the source repository, the
          workflow and the commit the package was built from;{' '}
          <code>npm audit signatures</code> verifies it.
        </p>
      )}
      <p>
        Prefer a project that already runs? <a href="/developers/examples/">The starter</a>{' '}
        has natal, transit and widget examples wired up, and{' '}
        <a href="/developers/mcp/">the MCP adapter</a> puts the same engine
        behind an assistant over stdio.
      </p>
    </div>

    <h2 id="api">What it computes</h2>
    <div class="prose">
      <p><a href="/developers/engine/reference/">Read the {candidate.version} API reference</a> for public exports, parameter and return types, and the release’s documentation comments.</p>
    </div>
    <dl class="engine-api">
      {api.map(([signature, what]) => (
        <div>
          <dt>{signature}</dt>
          <dd>{what}</dd>
        </div>
      ))}
    </dl>
    <div class="prose">
      <p>
        It computes thirteen house systems, each as Swiss Ephemeris defines it:
        whole sign, Placidus, Koch, Porphyry, Regiomontanus, Campanus,
        Topocentric (Polich–Page), Alcabitius, Equal (Ascendant), Equal-MC, Vehlow, Meridian (axial
        rotation) and Morinus. Aspects are the five major ones, with separate
        luminary orbs. A configured aspect policy, a separate function, adds
        minor and custom angles. Optional entry points ship beside the core:{' '}
        <code>@zodiacs/engine/geo</code> resolves a local wall time and IANA
        zone to an instant, <code>@zodiacs/engine/receipt</code> validates
        a portable chart record, and <code>/timing</code> and{' '}
        <code>/vedic</code> hold the techniques listed above. Each is a
        separate import, so none costs anything if you do not use it. Before
        1970, <code>/geo</code> reads a wall time on the IANA time zone
        history the package ships, in 16 files that{' '}
        <code>prepareLocalTime</code> loads first; from 1970 on, on the time
        zone data of the host.
      </p>
      <p>
        One thing to know about <code>@zodiacs/engine/geo</code> before you
        import it: the time resolver itself is offline, but the same entry
        point also exports a GeoNames place-lookup client, and that one makes
        HTTP requests to wherever you point it. Import <code>resolveBirth</code>{' '}
        by name and a bundler drops the client; import the namespace and you
        ship it. The core entry point contains no <code>fetch</code> at all.
      </p>
    </div>

    <h2 id="cost">What it costs</h2>
    <div class="prose">
      <p>
        Bundled for a browser with esbuild {bundle.esbuildVersion}, minified,
        entry <code>{`import { natalChart } from '${candidate.name}'`}</code>{' '}
        — its ephemeris included, because that is what actually ships:
      </p>
    </div>
    <div class="engine-table-wrap" tabindex="0" role="region" aria-label="Bundle size">
      <table>
        <thead><tr><th scope="col">Entry</th><th scope="col">Minified</th><th scope="col">gzip</th><th scope="col">brotli</th></tr></thead>
        <tbody>
          <tr><th scope="row">Natal charts</th><td>{kb(bundle.natal.minKb)}</td><td>{kb(bundle.natal.gzipKb)}</td><td>{kb(bundle.natal.brotliKb)}</td></tr>
          <tr><th scope="row">+ <code>resolveBirth</code>, local-time resolution alone</th><td>{kb(bundle.localTime.minKb)}</td><td>{kb(bundle.localTime.gzipKb)}</td><td>{kb(bundle.localTime.brotliKb)}</td></tr>
          <tr><th scope="row">+ the whole <code>/geo</code> entry point, GeoNames client and the 16 zone-history files included</th><td>{kb(bundle.geo.minKb)}</td><td>{kb(bundle.geo.gzipKb)}</td><td>{kb(bundle.geo.brotliKb)}</td></tr>
        </tbody>
      </table>
    </div>
    <div class="prose">
      <p>
        Most of the first row is the ephemeris series, and it is the price of
        not calling a server. The last row is mostly the time zone history
        before 1970: bundled into one file, as here, it comes along whole,
        while a bundler that splits code ships each of its 16 files as a
        separate chunk that <code>prepareLocalTime</code> loads only for a
        date that needs it. There are no data files to host or download at
        runtime, no key, and no account. This site keeps the engine out of its
        own homepage bundle and loads it only on pages that cast a chart; a
        bundler will do the same for you if you import it behind a dynamic
        import.
      </p>
    </div>

    <h2 id="accuracy">How close it is</h2>
    <div class="prose">
      <p>
        Every change runs a comparison against NASA JPL Horizons reference
        data; at the two dates it checks, 1907 and
        2020, the largest difference is 14.8 arcseconds (Neptune, 2020).
        Separately, the engine was measured against Swiss Ephemeris 2.10.03
        over a stratified set of dates written down beforehand, on 20
        September 2026 and again on 25 September: across the 160 measurements
        from 1801 to 2026 the median disagreement in ecliptic longitude is{' '}
        <strong>1.6 arcseconds</strong> and the largest is{' '}
        <strong>18.6 arcseconds</strong>. Compared every tenth day from 1800
        to 2026 instead, for the ten bodies and the North Node, the median is
        2.0 arcseconds and the largest <strong>22.9 arcseconds</strong>
        (Venus, 1878).
      </p>
      <p>
        Three caveats that matter more than the number.{' '}
        <a href="/methodology/#swiss-comparison">Swiss Ephemeris and this
        engine's planetary series both descend from JPL development
        ephemerides</a>, and the engine's Moon comes from an older lunar theory,
        so that is two implementations agreeing rather than a check against
        observation.
      </p>
      <p>
        Up to the present the clock is observed. Since 0.1.1-rc.15 the engine
        reads an instant from 1972 to 2 October 2027 as UTC: atomic time comes
        from the IERS leap seconds, and the Earth's rotation from the IERS
        values of UT1 − UTC, which its table reproduces within 0.79
        milliseconds on every day. Other instants it reads as UT1 and takes
        ΔT, the gap between atomic time and the Earth's rotation, from its
        model, as it has since 0.1.1-rc.8: Stephenson, Morrison and
        Hohenkerk's 2016 reconstruction before 1941, US Naval Observatory and
        IERS records after it, and the IERS predictions; from 1962 on it is
        within 0.09 seconds of the IERS value on every day. Every chart
        returns the ΔT it used with its one-sigma uncertainty, and says which
        way it read its instant. Past the predictions both programs
        extrapolate: from 2100 to 2199 their ΔT values differ by 14.3 to
        36.7 seconds, which alone moves the Moon by{' '}
        <strong>7.0 to 23.4 arcseconds</strong>; at the same instant of
        Terrestrial Time, which takes the clock out, it stays within 7.2
        arcseconds from 2150 to 2199. Until rc.8 the clock was a fixed
        formula: on 22 September 2026 it read 75.5 seconds where the IERS
        value is 69.2, which on its own moved the Moon about 3.5 arcseconds.
      </p>
      <p>
        And the engine bounds its input date only where its ephemeris ends:
        since rc.14 an instant outside Terrestrial Time 0001-04-30 to
        3998-09-03 throws a <code>RangeError</code>. It will compute year 900
        or year 3500 and return a chart with no error. Nothing above says
        anything about either, and since rc.8 the chart says so itself:
        outside 1800–2200 it carries the <code>outside-reference-span</code>{' '}
        flag. zodiacs.org clamps its own forms to 1800–2199; if you are taking
        dates from users, pick a bound and enforce it yourself.
      </p>
      <p>
        <a href="https://github.com/zodiacs-org/site/tree/main/docs/engine-validation" rel="noopener noreferrer">One
        report covers all of it</a> — positions, angles and houses, local time,
        event search and runtime support — with the measured residual for each,
        the oracle it came from, and what it does not establish. It also
        carries the event-search contract that is still failing, which is the
        weakest thing anyone evaluating this should know.
      </p>
    </div>

    <h2 id="limits">What it does not do</h2>
    <div class="prose">
      <ul>
        <li>The core is tropical. The sidereal zodiac, with its ayanamsas, is in the separate <code>/vedic</code> and <code>/calc</code> entry points, which this site does not use. No topocentric parallax.</li>
        <li>Sun through Pluto and the true nodes. No Chiron, no asteroids.</li>
        <li>Placidus and Koch are undefined inside the polar circle; where the absolute latitude is 90° minus the obliquity or more (66.53° to 66.59° over 1800–2200) they fall back to whole sign and flag it. The other eleven systems are defined there.</li>
        <li>Event searches sample the motion at a fixed step, so they can miss an event between samples. The solver is tested, not proven complete.</li>
        <li>No input-date bound inside the span the ephemeris covers, Terrestrial Time 0001-04-30 to 3998-09-03; outside it a calculation throws. Outside 1800–2200, the range the engine has been checked over, a chart carries the <code>outside-reference-span</code> flag; see the caveat under accuracy.</li>
        <li>The manifest declares Node 20.19 or a later 20.x, and 22.7 and newer. What has actually been executed for this candidate is Node 22.22.2 and Node 24.21.0 here, with the site's Chromium browser checks, and Node 20.19.0, 22.7.0, 22.22.2 and 24.21.0 in the engine's own packed-archive check — narrower than the declaration.</li>
        <li>No interpretation. The engine returns geometry; what it means is your problem, and not an astronomical claim.</li>
      </ul>
      <p>
        <a href="/developers/support/">The support matrix</a> states each of
        these precisely, along with the runtimes actually tested, the input
        rules, and the licensing obligations that come with the optional
        GeoNames-derived place index.
      </p>
    </div>

    <h2 id="source">Source and licence</h2>
    <div class="prose">
      <p>
        The code is MIT, in the <a href={sourceTree}>Zodiacs engine repository</a> at
        commit{' '}
        <code>{candidate.sourceCommit.slice(0, 12)}</code>; the package's
        licence expression is <code>MIT AND CC-BY-4.0</code>, for the ΔT
        values above. Keep the packaged <code>LICENSE</code>,{' '}
        <code>LICENSING.md</code> and <code>NOTICE</code> when you
        redistribute: the NOTICE carries Astronomy Engine's MIT notice, the
        attribution those ΔT values require, the sources of the time zone,
        leap-second and UT1 data and of the star values in{' '}
        <code>/vedic</code> and <code>/calc</code>, and the CC BY 4.0 attribution that
        GeoNames-derived place data requires; LICENSING.md gives the terms of
        each and three questions about them that are still open.{' '}
        <a href={`${candidate.sourceRepository}/issues`}>Report a problem</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .engine-page h1 { margin: var(--s-1) 0 var(--s-4); }
  .engine-page h2 { margin: var(--s-12) 0 var(--s-4); font-size: var(--text-lg); scroll-margin-top: 96px; }
  .engine-page .prose { max-width: 68ch; }
  .engine-page code { font-family: var(--font-mono); font-size: .9em; overflow-wrap: anywhere; }
  pre { margin: var(--s-6) 0; padding: var(--s-4); border: 1px solid var(--hair-2); border-radius: var(--radius-sm); max-width: 100%; overflow-x: auto; font-size: var(--text-sm); line-height: 1.7; }
  pre:focus-visible { outline: 2px solid var(--text-2); outline-offset: 4px; }
  pre code { overflow-wrap: normal; }
  .engine-output { color: var(--text-2); }
  .engine-hash { overflow-wrap: anywhere; color: var(--text-2); font-size: var(--text-sm); }
  .engine-api { margin: var(--s-6) 0 0; max-width: 68ch; display: grid; gap: var(--s-5); }
  .engine-api dt { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--text-1); }
  .engine-api dd { margin: var(--s-2) 0 0; color: var(--text-2); }
  .engine-table-wrap { overflow-x: auto; margin: var(--s-6) 0; }
  .engine-table-wrap table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  .engine-table-wrap th,
  .engine-table-wrap td { padding: 10px 12px; border-bottom: 1px solid var(--hair-1); text-align: left; white-space: nowrap; }
  .engine-table-wrap thead th { color: var(--faint); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; }
  .engine-table-wrap tbody th { font-weight: 500; white-space: normal; }
</style>
