---
import Base from '../../../layouts/Base.astro';
import { FREE_OFFER, OPENAPI_URL, ORGANIZATION, developerBreadcrumb } from '../../../lib/developer-structured-data.mjs';
import examples from '../../../lib/compute-api/examples.json';
import { SUCCESS_EXAMPLES } from '../../../lib/compute-api/examples';
import {
  ANGULAR_MAX_ABS_LATITUDE,
  BUDGETS,
  COMPUTE_ORIGIN,
  ELECTION_STEPS,
  EPOCH,
  ERROR_STATUS,
  FULL_CALCULATION_COST,
  HOUSE_SYSTEM_NAMES,
  MAX_BODY_BYTES,
  MAX_ELECTION_CONDITIONS,
  RETRY_AFTER_SECONDS,
  computePath,
  type ComputeEndpoint,
  type ErrorCode,
} from '../../../lib/compute-api/constants';

const title = 'Compute API — Charts, Positions and Sky Facts over HTTP | Zodiacs.org';
// A plain literal: scripts/build-assistant-context.mjs reads it from the source.
const description = 'Seven POST endpoints under /api/v1/ compute a chart, positions, houses, the events in a window, a local time as UTC and TT, whether a stated sky fact holds, and when chosen conditions all hold. Every answer names the engine and carries a receipt. No key; birth data goes in the body, and the function writes nothing from a request to a log, a file or a database.';

const backend = examples.success.chart.utc.backend;
const number = (value: number) => value.toLocaleString('en-US');

// The documented example of each endpoint, answered by the handler itself
// (src/lib/compute-api/examples.json, rebuilt by scripts/build-compute-examples.mjs).
const shown: Record<ComputeEndpoint, string> = {
  chart: 'local',
  positions: 'two',
  houses: 'koch',
  events: 'october',
  time: 'pinned',
  'sky-fact': 'retrograde',
  elections: 'london',
};
const success = examples.success as Record<string, Record<string, { result: unknown }>>;
const request = (endpoint: ComputeEndpoint) => [
  `curl --silent --show-error ${COMPUTE_ORIGIN}${computePath(endpoint)} \\`,
  "  --header 'Content-Type: application/json' \\",
  `  --data '${JSON.stringify(SUCCESS_EXAMPLES[endpoint][shown[endpoint]].body)}'`,
].join('\n');
const result = (endpoint: ComputeEndpoint) => JSON.stringify(success[endpoint][shown[endpoint]].result, null, 2);
const envelope = JSON.stringify(examples.success.time.pinned, null, 2);

const endpoints: Array<[ComputeEndpoint, string]> = [
  ['chart', 'Bodies, angles, house cusps and aspects for an instant and a place.'],
  ['positions', `Positions and speeds of the bodies you name at up to ${BUDGETS['positions.instants']} instants.`],
  ['houses', 'Angles and house cusps for an instant, a place and a house system.'],
  ['events', `Sign changes, stations and new and full moons in a window of up to ${BUDGETS['events.windowDays']} days.`],
  ['time', 'A local civil time as UTC and Terrestrial Time, with flags for skipped and repeated clock times.'],
  ['sky-fact', 'Whether a stated fact about the sky holds on a date or at an instant: true, false or depends.'],
  ['elections', `The stretches of a window of up to ${BUDGETS['elections.windowDays']} days in which up to ${MAX_ELECTION_CONDITIONS} conditions all hold: the Moon's phase or void of course, a body's sign, a planet retrograde, a body in an angular house.`],
];

const limits: Array<[string, string, string]> = [
  ['Body', `${number(MAX_BODY_BYTES)} bytes`, '413 payload-too-large'],
  ['Instants in one positions request', number(BUDGETS['positions.instants']), '422 budget-exhausted, limit positions.instants'],
  ['Length of an events window', `${number(BUDGETS['events.windowDays'])} days`, '422 budget-exhausted, limit events.windowDays'],
  ['Evaluations in one events request', number(BUDGETS['events.samples']), '422 budget-exhausted, limit events.samples'],
  ['Evaluations in one sky-fact request', number(BUDGETS['sky-fact.samples']), '422 budget-exhausted, limit sky-fact.samples'],
  ['Length of an elections window', `${number(BUDGETS['elections.windowDays'])} days`, '422 budget-exhausted, limit elections.windowDays'],
  ['Evaluations in one elections request', number(BUDGETS['elections.samples']), '422 budget-exhausted, limit elections.samples'],
  ['Requests from one IP address', 'set by the rate limit; events and elections requests count against a second, lower limit too', `429 rate-limited, Retry-After: ${RETRY_AFTER_SECONDS.rateLimited}`],
];

const refusals: Array<[ErrorCode, string]> = [
  ['method-not-allowed', 'A method other than POST. OPTIONS is answered as a CORS preflight.'],
  ['disabled', `The API is switched off. Retry-After is ${RETRY_AFTER_SECONDS.disabled} seconds.`],
  ['rate-limit-unavailable', `The rate limit is not in place, or could not be checked, so nothing was read or computed. Retry-After is ${RETRY_AFTER_SECONDS.rateLimitUnavailable} seconds.`],
  ['rate-limited', `Too many requests from one address. Retry-After is ${RETRY_AFTER_SECONDS.rateLimited} seconds.`],
  ['unsupported-media-type', 'The body is not declared as application/json in UTF-8, or it has a content encoding.'],
  ['payload-too-large', `The body is over ${number(MAX_BODY_BYTES)} bytes, declared or counted.`],
  ['invalid-json', 'The body is not JSON in UTF-8, or its length is not the one declared.'],
  ['invalid-request', 'A field is missing, out of range, of the wrong type, or not one the endpoint takes.'],
  ['budget-exhausted', 'The request is over one of the limits above; limit and max name it.'],
  ['calculation-failed', 'The engine could not complete the calculation.'],
  ['not-found', 'The request reached the function by a path that is not one of the seven endpoints.'],
];

const jsonLd = [
  {
    '@type': 'WebAPI',
    name: 'Zodiacs compute API',
    url: 'https://zodiacs.org/developers/compute/',
    description,
    documentation: OPENAPI_URL,
    provider: ORGANIZATION,
    offers: FREE_OFFER,
  },
  developerBreadcrumb('/developers/compute/', 'Compute API'),
];
---
<Base title={title} description={description} path="/developers/compute/" jsonLd={jsonLd}>
  <section class="section container container--narrow compute-page">
    <em class="kicker">Compute API</em>
    <h1 class="display">Calculate charts on our server.</h1>

    <div class="prose">
      <p>
        Seven endpoints under <code>{`${COMPUTE_ORIGIN}/api/v1/`}</code> calculate
        from a JSON body sent with POST. There is no key and no account. Each
        answer carries the result, a receipt that says how it was computed, and
        the name and version of the engine that computed it:{' '}
        <code>{backend.name}</code> {backend.version}, with{' '}
        {backend.ephemeris.name} {backend.ephemeris.version}, the engine this
        site's calculators run in the browser.
      </p>
      <p>
        The endpoints answer only while their per-address rate limit is in
        place. Until it is, and whenever it cannot be checked, every endpoint
        answers <code>503</code> with <code>Retry-After</code>, and nothing
        is read or computed.
      </p>
    </div>
    <ul class="compute-list">
      {endpoints.map(([endpoint, what]) => (
        <li>
          <a href={`#${endpoint}`}><code>POST {computePath(endpoint)}</code></a>
          <p>{what}</p>
        </li>
      ))}
    </ul>

    <h2 id="privacy">What the API receives and keeps</h2>
    <div class="prose">
      <p>
        Put birth data in the body, and only there. The API takes the
        endpoint from the path and ignores the query string, but the host's
        short-lived logs keep the full web address and the IP address of
        every request, so birth details put in a query string would be kept
        in them.
      </p>
      <p>
        The function writes nothing from a request or its result to a log, a
        file or a database. An error repeats nothing you sent: each refusal
        is a fixed sentence that names at most the field it refuses. Every
        response carries <code>Cache-Control: no-store</code>, so no cache
        keeps a copy.
      </p>
      <p>
        When a request ends, including a refused or failed request, the server
        clears its last calculated frame and epoch-selected ephemeris segments
        and discards the request's time zone lookup maps. Fixed public tables
        remain available to later calculations. This removes application-held
        references; it does not guarantee discarded memory is overwritten or
        describe every log the hosting platform may keep.
      </p>
      <p>
        To apply the rate limit, the function sends the request's headers,
        which include your IP address, to Vercel's firewall, never the body;
        the firewall counts requests from each address. The site's own
        calculators do not use this API: they compute in your browser. The{' '}
        <a href="/privacy/#compute-api">privacy page</a> covers the API too.
      </p>
    </div>

    <h2 id="requests">Requests</h2>
    <div class="prose">
      <p>
        Send <code>Content-Type: application/json</code> and a UTF-8 body of at
        most {number(MAX_BODY_BYTES)} bytes, with no content encoding. A field an
        endpoint does not take is refused rather than ignored. A key written
        twice in one object is read as <code>JSON.parse</code> reads it: the
        last value counts. Answers allow any origin and a browser's CORS
        preflight is answered, so a page on another site can call the API
        directly.
      </p>
      <p>
        An instant is ISO 8601 with <code>Z</code> or a numeric offset, to the
        second or the millisecond: <code>2026-09-29T08:15:00Z</code> or{' '}
        <code>1990-06-15T14:30:00+02:00</code>. Instants run from{' '}
        <code>{EPOCH.from}</code> to <code>{EPOCH.to}</code>, the years the
        site's own forms take. A local time is an object with a real{' '}
        <code>date</code>, a <code>time</code> in hours and minutes, and a{' '}
        <code>zone</code> named as in the IANA database, such as{' '}
        <code>Europe/Paris</code>, in any letter case: the answer names the
        zone as tzdb spells it. Its date runs from {EPOCH.firstYear}-01-01 to{' '}
        {EPOCH.lastYear}-12-31. That span is where requests are accepted,
        not a span in which every date has been checked, and every receipt
        states the engine's own coverage. A local time at either end of it
        can fall just outside the instant span, such as midnight on
        1 January 1800 in Tokyo, which is still 31 December in UTC; it is
        computed and flagged <code>outside-reference-span</code>.
      </p>
      <p>
        The engine reads an instant as a chart reads it. From 1972 to
        2 October 2027 it is UTC: Terrestrial Time is UTC plus the leap
        seconds and 32.184 seconds, and UT1 comes from the IERS measurements
        of UT1 − UTC. Before 1972 and after that date it is read as UT1, and
        Terrestrial Time is UT1 plus the engine's ΔT model. Every result that
        gives an instant's ΔT also gives its <code>timeScale</code>, which
        says which way it was read.
      </p>
      <p>
        A latitude is degrees north, greater than −90 and less than 90: the
        engine computes no angles at the poles. A longitude is degrees east,
        from −180 to 180. A house system is one of the engine's thirteen:{' '}
        {HOUSE_SYSTEM_NAMES.map((name, index) => (
          <>{index > 0 && (index === HOUSE_SYSTEM_NAMES.length - 1 ? ' and ' : ', ')}<code>{name}</code></>
        ))}, with <code>placidus</code> when none is given.
      </p>
    </div>

    <h2 id="chart">Chart</h2>
    <div class="prose">
      <p>
        <code>POST /api/v1/chart</code> takes exactly one of <code>utc</code>,
        an instant, and <code>local</code>, a local time, with a{' '}
        <code>latitude</code>, a <code>longitude</code> and an optional{' '}
        <code>houseSystem</code>. It returns what the engine's{' '}
        <code>natalChart</code> returns: twelve bodies (the Sun, the Moon, the
        eight planets and the two nodes) with longitude, latitude, speed, sign
        and degree; the four angles; the house system used and its twelve
        cusps; the aspects; flags; and the ΔT and time basis used. A local time is resolved as
        the <a href="#time">time endpoint</a> resolves it, with the place's
        longitude, and <code>result.local</code> says how it was read. The
        receipt is the engine's own chart receipt.
      </p>
      <p>
        Inside the polar circle Placidus and Koch fall back to whole sign.
        The house system in the result, its flags and the receipt's{' '}
        <code>houses.actual</code> then say so.
      </p>
    </div>
    <pre tabindex="0" role="region" aria-label="Chart request"><code>{request('chart')}</code></pre>
    <details class="compute-example">
      <summary>The answer's <code>result</code></summary>
      <pre tabindex="0" role="region" aria-label="Chart result"><code>{result('chart')}</code></pre>
    </details>

    <h2 id="positions">Positions</h2>
    <div class="prose">
      <p>
        <code>POST /api/v1/positions</code> takes <code>instants</code>, from 1
        to {BUDGETS['positions.instants']}, and optionally <code>bodies</code>,
        any of the Sun, Moon, Mercury, Venus, Mars, Jupiter, Saturn, Uranus,
        Neptune, Pluto, North Node and South Node, all twelve when omitted. At
        each instant it returns the engine's <code>positions()</code> rows for
        those bodies: tropical longitude and latitude of date, speed in degrees
        a day, whether the body is retrograde, and its sign and degree, with
        the ΔT and time basis used and any flags.
      </p>
    </div>
    <pre tabindex="0" role="region" aria-label="Positions request"><code>{request('positions')}</code></pre>
    <details class="compute-example">
      <summary>The answer's <code>result</code></summary>
      <pre tabindex="0" role="region" aria-label="Positions result"><code>{result('positions')}</code></pre>
    </details>

    <h2 id="houses">Houses</h2>
    <div class="prose">
      <p>
        <code>POST /api/v1/houses</code> takes the same fields as{' '}
        <a href="#chart">chart</a> and returns only the angles, the house system
        used and its twelve cusps, with flags and the ΔT and time basis used. Its receipt is
        the chart's.
      </p>
    </div>
    <pre tabindex="0" role="region" aria-label="Houses request"><code>{request('houses')}</code></pre>
    <details class="compute-example">
      <summary>The answer's <code>result</code></summary>
      <pre tabindex="0" role="region" aria-label="Houses result"><code>{result('houses')}</code></pre>
    </details>

    <h2 id="events">Events</h2>
    <div class="prose">
      <p>
        <code>POST /api/v1/events</code> takes a window, <code>from</code> and{' '}
        <code>to</code>, at most {BUDGETS['events.windowDays']} days long, and
        optionally <code>bodies</code>, of the ten from the Sun to Pluto, and{' '}
        <code>kinds</code>, of <code>ingress</code>, <code>station</code> and{' '}
        <code>lunation</code>; all of each when omitted. It returns, in time
        order, every sign change of those bodies, every station of the planets
        among them, and every new and full moon it finds in the window. It
        finds them with the engine's crossing search: a sign change is the
        body's longitude crossing a sign boundary, a station is its speed
        crossing zero, and a new or full moon is the Moon's distance from the
        Sun reaching 0° or 180°.
      </p>
      <p>
        The search samples every 5 days, or every day for the Moon and for new
        and full moons, and narrows each crossing it finds to the step divided
        by 2<sup>24</sup>. A window excludes its start and includes its end. The
        search can miss a pair of crossings that both fall between two samples,
        such as a body that crosses a boundary and crosses back around a
        station: it has been tested, not proven complete. A request whose
        searches would need more than {number(BUDGETS['events.samples'])}{' '}
        evaluations is refused whole, and no events are returned. The receipt
        records the step, the evaluations used and this limit. For 2026 the
        endpoint finds every station, new and full moon, and sign change of
        the Sun and planets on the site's transit calendar, each within 5
        minutes of the calendar's time, and nothing else of those kinds.
      </p>
    </div>
    <pre tabindex="0" role="region" aria-label="Events request"><code>{request('events')}</code></pre>
    <details class="compute-example">
      <summary>The answer's <code>result</code></summary>
      <pre tabindex="0" role="region" aria-label="Events result"><code>{result('events')}</code></pre>
    </details>

    <h2 id="time">Time</h2>
    <div class="prose">
      <p>
        <code>POST /api/v1/time</code> takes <code>local</code> and, optionally,
        the place's <code>longitude</code>. It returns the instant in UTC, the
        offset from UTC in minutes, flags, the local mean time used if any,
        which zone history was read, whether the zone is uncertain, the instant
        in Terrestrial Time, and ΔT. It reads the local time with the birth
        chart calculator's own resolver, built into the function with its
        tables:
      </p>
      <ul>
        <li>A clock time that happened twice takes the earlier instant and the
          flag <code>dst-fold</code>; one that was skipped moves forward by the
          gap and has <code>dst-gap</code>.</li>
        <li>With a longitude, a time before the place adopted a legal time uses
          the place's own mean time, flagged <code>lmt</code>.</li>
        <li>With a longitude, a date up to 1 January 1970 in a zone the pinned
          tzdb release 2025c keeps takes its legal offset from that release,
          backzone file included, and <code>zoneHistory</code> is{' '}
          <code>pinned</code>.</li>
        <li>Otherwise the offset comes from the time zone data of the server's
          runtime, and <code>zoneHistory</code> is <code>runtime</code>. For a
          date up to 1 January 1970 that history can differ from the pinned
          one, and <code>zoneUncertain</code> is true.</li>
        <li>Terrestrial Time and ΔT are the engine's for that instant, to the
          millisecond, read as described above. ΔT comes with its one-sigma
          band and the source it came from: the IERS measurements, or the part
          of the model.</li>
      </ul>
    </div>
    <pre tabindex="0" role="region" aria-label="Time request"><code>{request('time')}</code></pre>
    <details class="compute-example">
      <summary>The answer's <code>result</code></summary>
      <pre tabindex="0" role="region" aria-label="Time result"><code>{result('time')}</code></pre>
    </details>

    <h2 id="sky-fact">Sky facts</h2>
    <div class="prose">
      <p>
        <code>POST /api/v1/sky-fact</code> takes one fact and answers{' '}
        <code>true</code>, <code>false</code> or <code>depends</code>, with the
        computed values that decide it. It returns no interpretation. The facts
        it takes:
      </p>
      <ul>
        <li><code>sign</code>: a body is in a sign, at an <code>instant</code> or on a <code>date</code>.</li>
        <li><code>retrograde</code>: a body is retrograde, at an instant or on a date.</li>
        <li><code>ingress</code>: a body enters a sign on a date.</li>
        <li><code>phase</code>: a new moon, first quarter, full moon or last quarter falls on a date.</li>
      </ul>
      <p>
        A date is read in the <code>zone</code> you give, from its midnight to
        the next. Without a zone it is read in every UTC offset in use today, from 14
        hours before its midnight in UTC to 36 hours after. The answer is{' '}
        <code>depends</code> when it turns on the time of day, because the body
        changes sign or stations during that day, or, without a zone, on the
        zone: whether an ingress or a phase falls on a date always depends on
        where the date is read. At an instant the answer is true or false.
      </p>
      <p>
        A zone that moved across the date line skipped a whole date: Samoa
        went from 29 to 31 December 2011. A fact about a date its zone
        skipped is refused with <code>invalid-request</code> at{' '}
        <code>/date</code>, since there was no such day to hold it. The
        facts carry <code>flags</code>, with{' '}
        <code>outside-reference-span</code> when the day read reaches past
        the instant span, as the first and last accepted dates can.
      </p>
    </div>
    <pre tabindex="0" role="region" aria-label="Sky fact request"><code>{request('sky-fact')}</code></pre>
    <details class="compute-example">
      <summary>The answer's <code>result</code></summary>
      <pre tabindex="0" role="region" aria-label="Sky fact result"><code>{result('sky-fact')}</code></pre>
    </details>

    <h2 id="elections">Elections</h2>
    <div class="prose">
      <p>
        <code>POST /api/v1/elections</code> takes a window, <code>from</code>{' '}
        and <code>to</code>, at most {BUDGETS['elections.windowDays']} days
        long, and from one to {MAX_ELECTION_CONDITIONS}{' '}
        <code>conditions</code>. It returns, in time order, every stretch of
        the window in which all of them hold. The conditions it takes:
      </p>
      <ul>
        <li><code>phase</code>: the Moon <code>waxing</code>, from new moon to
          full, or <code>waning</code>, from full moon to new.</li>
        <li><code>void-of-course</code>: the Moon void of course, from its
          last exact conjunction, sextile, square, trine or opposition in a
          sign to the Sun or a planet from Mercury to Pluto, until it enters
          the next sign. This is the engine's own rule, after William
          Lilly.</li>
        <li><code>sign</code>: a <code>body</code>, of the ten from the Sun to
          Pluto, in a <code>sign</code>.</li>
        <li><code>retrograde</code>: a planet from Mercury to Pluto with its
          longitude speed below zero.</li>
        <li><code>angular</code>: a body in the 1st, 4th, 7th or 10th house at
          the request's <code>place</code>, which has a <code>latitude</code>{' '}
          within {ANGULAR_MAX_ABS_LATITUDE}° of the equator, a{' '}
          <code>longitude</code> and an optional <code>houseSystem</code>.</li>
      </ul>
      <p>
        Any condition takes <code>not</code>: with{' '}
        <code>{'"not": true'}</code> a retrograde condition asks for the planet
        direct. A condition may not be given twice, and a request has a{' '}
        <code>place</code> when it has an angular condition, and only then.
      </p>
      <p>
        Sign changes, stations and new and full moons come from the crossing
        search the <a href="#events">events endpoint</a> uses. A void period
        ends at one of the Moon's sign changes and begins at its last exact
        aspect before it, found by scanning back in 3-hour steps. Houses come
        from the engine's <code>natalChart</code>, sampled every{' '}
        {ELECTION_STEPS.houseSampleMinutes} minutes only where the other
        conditions all hold, and more often where a body passes more than one
        house between two samples. Every boundary is found to within a second,
        so two less than {ELECTION_STEPS.resolutionSeconds} seconds apart are
        taken as one instant: a gap that short between two windows is closed,
        and a window that short is not listed. A window excludes its end, and
        one that begins at <code>from</code> or ends at <code>to</code> may
        run on beyond it.
      </p>
      <p>
        A request whose searches would need more than{' '}
        {number(BUDGETS['elections.samples'])} evaluations is refused whole,
        and no windows are returned. A step of a crossing search counts as one
        evaluation. A full calculation, every body's position at an instant or
        a <code>natalChart</code> for a house, counts as{' '}
        {FULL_CALCULATION_COST}: in three runs on one machine, a step took
        0.03 to 0.06 milliseconds and a full calculation 0.7 to 1.2.
        Houses cost the most: one angular condition alone fits a window of
        about three to four days in Placidus, Koch or Campanus houses, and
        about two in whole signs, while other conditions that rule out most
        of the window leave room for a longer one. Every condition but an
        angular one is searched over the whole window, so a month of void of
        course alone can pass the limit: March 2138 needs 6,327 evaluations.
        The receipt records the steps, the evaluations used and this limit.
      </p>
      <p>
        The search has been tested, not proven complete. On 100 random
        requests with dates from 1800 to 2195, drawn by rules written down
        before the run, it found the same 206 windows as a scan of every 10
        seconds, every end within 5.4 seconds of the scan's. The rules, the
        scan and the results are in the{' '}
        <a href="https://github.com/zodiacs-org/site/tree/main/docs/platform/evidence/election-search-v0">site repository</a>.
      </p>
    </div>
    <pre tabindex="0" role="region" aria-label="Elections request"><code>{request('elections')}</code></pre>
    <details class="compute-example">
      <summary>The answer's <code>result</code></summary>
      <pre tabindex="0" role="region" aria-label="Elections result"><code>{result('elections')}</code></pre>
    </details>

    <h2 id="receipts">Receipts and citation</h2>
    <div class="prose">
      <p>Every successful answer has five fields:</p>
      <ul>
        <li><code>schema</code>, the answer's shape and version, such as <code>zodiacs.compute-api.time.v1</code>.</li>
        <li><code>result</code>, what was computed.</li>
        <li><code>receipt</code>, how. For chart and houses it is the engine's
          own chart receipt, <code>zodiacs.calculation-receipt.draft-v1</code>.
          For the other five it is <code>zodiacs.compute-receipt.v1</code>: the
          engine's conventions and coverage as its receipts state them, the two
          sources of ΔT its time basis uses, and, where they apply, the
          search's limits and how local time was read.</li>
        <li><code>backend</code>, the engine and its version, and the ephemeris it uses.</li>
        <li><code>cite</code>, what to quote beside a result: <code>url</code>,
          this page at the endpoint's section; <code>receipt</code>, a digest of
          the receipt; <code>engine</code>; and <code>version</code>.</li>
      </ul>
      <p>
        The digest is <code>sha256:</code> followed by the SHA-256, in
        hexadecimal, of the receipt written as RFC 8785 canonical JSON, with
        sorted keys and no spaces. Anyone holding the answer can compute it
        again, and anyone holding only the citation can tell which receipt it
        names. A digest keeps the citation short enough to quote, which a
        second copy of the receipt would not.
      </p>
      <p>
        A digest does not hide what it identifies. For chart and houses the
        receipt holds the instant and the coordinates, so the digest
        identifies the birth details from either side: with the date and the
        place, trying each minute of the day finds the time, and with the date
        and the time, trying places from a list of towns finds the place.
        Quote it only where the birth details may be known. An elections
        receipt holds no part of the request, but it counts the evaluations
        the search made, which depend on the request, its place included, so
        two requests that differ only in their place can give different
        digests.
      </p>
    </div>
    <details class="compute-example">
      <summary>A whole answer, from the time example above</summary>
      <pre tabindex="0" role="region" aria-label="Whole answer"><code>{envelope}</code></pre>
    </details>

    <h2 id="limits">Limits</h2>
    <div class="compute-table-wrap" tabindex="0" role="region" aria-label="Limits">
      <table>
        <thead><tr><th scope="col">Limit</th><th scope="col">At most</th><th scope="col">Over it</th></tr></thead>
        <tbody>
          {limits.map(([limit, value, over]) => (
            <tr><th scope="row">{limit}</th><td>{value}</td><td><code>{over}</code></td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="prose">
      <p>
        A request over a limit is refused whole, before anything is computed,
        except the three evaluation limits, which are counted as the searches
        run: when one is spent the request is refused and nothing is returned.
        The limits were set from local request-cost measurements in every
        year from 1800 to 2199. A fresh local run on 2026-10-07 with engine
        1.0.0-rc.2 measured 4,600 requests across nine synthetic shapes, after
        two warmups per shape. Observed CPU maxima were 1,001.5 ms for events,
        287.1 ms for positions and 1,447.5 ms for the slowest election shape.
        A separate 5,200-request houses sweep measured a 98.5 ms maximum.
        An elections request counts against the same lower limit as an events
        request. The unchanged rate rules give about 23.1 CPU-seconds per
        address per minute at these observed maxima, and 9.2 at p95.
        These finite local draws do not guarantee an upper bound or measure
        deployed cost. This run used Node 22.22.2 and a Xeon
        Platinum 8573C under a four-CPU quota. Hardware and protocol differ
        from the earlier runs, so the increase cannot be attributed to the
        engine. The{' '}
        <a href="https://github.com/zodiacs-org/site/tree/main/docs/platform/evidence/site-engine-1-0-0-rc2">current measurement record</a>{' '}
        gives each endpoint's maximum and the earlier runs' limits.
        When the API is switched off, or its rate limit is not in place, every
        endpoint answers 503.
      </p>
    </div>

    <h2 id="errors">Errors</h2>
    <div class="prose">
      <p>
        A refusal is JSON, <code>{'{"error": {"code": …, "message": …}}'}</code>,
        with the status below. The code keeps its meaning within v1; the message
        is a fixed sentence. <code>invalid-request</code> adds{' '}
        <code>pointer</code>, a JSON Pointer to the field; <code>budget-exhausted</code>{' '}
        and <code>payload-too-large</code> add <code>limit</code> and{' '}
        <code>max</code>; <code>rate-limited</code> and <code>disabled</code> add{' '}
        <code>retryAfterSeconds</code>, which the <code>Retry-After</code> header repeats.
      </p>
    </div>
    <div class="compute-table-wrap" tabindex="0" role="region" aria-label="Error codes">
      <table>
        <thead><tr><th scope="col">Code</th><th scope="col">Status</th><th scope="col">When</th></tr></thead>
        <tbody>
          {refusals.map(([code, when]) => (
            <tr><th scope="row"><code>{code}</code></th><td>{ERROR_STATUS[code]}</td><td>{when}</td></tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 id="openapi">OpenAPI and versions</h2>
    <div class="prose">
      <p>
        The seven operations are in the OpenAPI 3.1 document at{' '}
        <a href="/api/v1/openapi.json"><code>/api/v1/openapi.json</code></a>,
        tagged <code>compute</code>, with a JSON Schema for every request and
        answer and an example of each that the handler itself produced. A
        schema cannot state every rule, such as a real calendar date, a zone
        the server knows, or an events window whose <code>to</code> is after
        its <code>from</code>, so a request the schema accepts can still be
        refused with <code>invalid-request</code>.
      </p>
      <p>
        Within v1, fields are added, never renamed or removed. The engine is a
        release candidate: when the site adopts a new one, the version in{' '}
        <code>backend</code> and <code>cite</code> changes with it, and results
        can move with the engine's conventions, which the receipt names. Compare
        versions and receipts before comparing numbers from different days. The{' '}
        <a href="/developers/engine/#accuracy">engine page</a> says how close its
        positions are to Swiss Ephemeris and NASA JPL Horizons.
      </p>
    </div>
  </section>
