---
import ReturnToolLinks from "../../components/return-visits/ReturnToolLinks.astro";
import Base from '../../layouts/Base.astro';
import ProfileDashboard from '../../islands/ProfileDashboard';
import ProfileInvites from '../../islands/ProfileInvites';
import ProfileManager from '../../islands/ProfileManager';
import AccountSyncV2Panel from '../../islands/AccountSyncV2Panel';
import AccountBoundProfileSurface from '../../islands/AccountBoundProfileSurface';
import ProfileSunSignCapture from '../../islands/ProfileSunSignCapture';
import ProfileIdentity from '../../islands/ProfileIdentity';
import ProfileSafety from '../../islands/ProfileSafety';
import ProfileCardInbox from '../../islands/ProfileCardInbox';
import ProfilePeople from '../../islands/ProfilePeople';
import ProfileKeepClose from '../../islands/ProfileKeepClose';
import SavedRecordsPanel from '../../islands/SavedRecordsPanel';
import SavedPagesPanel from '../../islands/SavedPagesPanel';
import { accountSavesEnabled } from '../../lib/profile/saved-pages-config';
import { savedRecordsEnabled } from '../../lib/profile/saved-record-flags';
import LivingChartTimeline from '../../islands/living-chart/LivingChartTimeline';
import { hasDailyChartEmailProvider } from '../../lib/email/daily-config';
import { accountSyncV2Enabled as isAccountSyncV2Enabled } from '../../lib/account-v2/feature-flags';
import { livingChartSyncEnabled } from '../../lib/living-chart/feature-flags';
import '../../styles/calculator.css';
import '../../styles/profile-home.css';
import '../../styles/profile-page.css';

const dailyEmailEnabled = hasDailyChartEmailProvider(process.env);
const syncConfigured = Boolean(import.meta.env.PUBLIC_SUPABASE_URL && (import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || import.meta.env.PUBLIC_SUPABASE_ANON_KEY));
const inviteUiEnabled = process.env.PUBLIC_COMPAT_INVITES_ENABLED === '1';
const accountSyncV2Enabled = isAccountSyncV2Enabled({
  PUBLIC_ACCOUNT_SYNC_V2_ENABLED: process.env.PUBLIC_ACCOUNT_SYNC_V2_ENABLED,
  PUBLIC_ACCOUNT_SYNC_V2_PREVIEW_ACK: process.env.PUBLIC_ACCOUNT_SYNC_V2_PREVIEW_ACK,
});
const livingChartSyncPrivacyEnabled = livingChartSyncEnabled({
  PUBLIC_LIVING_CHART_SYNC_ENABLED: process.env.PUBLIC_LIVING_CHART_SYNC_ENABLED,
});
const livingChartSurfaceEnabled = true;
const accountSavesSurfaceEnabled = syncConfigured && accountSavesEnabled({
  PUBLIC_ACCOUNT_SAVES_ENABLED: process.env.PUBLIC_ACCOUNT_SAVES_ENABLED,
});
const savedRecordsSurfaceEnabled = savedRecordsEnabled({
  PUBLIC_SAVED_RECORDS_ENABLED: process.env.PUBLIC_SAVED_RECORDS_ENABLED,
});
---
<Base
  clientUi
  title="Your Charts, Today and Ahead | Zodiacs.org"
  description="Open your saved birth charts, see what is active today, and keep the people and patterns you return to in one place."
  path="/profile/"
  privateSurface={accountSyncV2Enabled || livingChartSurfaceEnabled}
>
  <section class="section--tight container pf-page">
    <ProfileCardInbox accountBound={accountSyncV2Enabled} client:load />

    <ProfileIdentity accountBound={accountSyncV2Enabled} client:load />

    <ProfileSafety syncConfigured={syncConfigured} accountBound={accountSyncV2Enabled} client:load />

    <nav class="pf-page-nav" aria-label="On your page">
      <a href="/today/">Today <span aria-hidden="true">↗</span></a>
      <a href="#saved-charts">Saved charts <span aria-hidden="true">↓</span></a>
      <a href="#living-chart">Timeline <span aria-hidden="true">↓</span></a>
    </nav>


    <ProfileKeepClose accountBound={accountSyncV2Enabled} client:idle />

    <ProfileSunSignCapture client:load />

    {accountSyncV2Enabled ? (
      <AccountBoundProfileSurface
        dailyEmailEnabled={dailyEmailEnabled}
        livingChartEnabled={livingChartSurfaceEnabled}
        livingChartSyncEnabled={livingChartSyncPrivacyEnabled}
        client:load
      />
    ) : (
      <>
        <ProfileDashboard client:load />
        <ProfilePeople client:idle />
        <LivingChartTimeline syncEnabled allowSyncGrant={livingChartSyncPrivacyEnabled} client:load />
        <ProfileInvites inviteUiEnabled={inviteUiEnabled} client:load />
        <ProfileManager dailyEmailEnabled={dailyEmailEnabled} client:load />
      </>
    )}

    {accountSyncV2Enabled && <ProfilePeople accountBound client:idle />}

    {accountSavesSurfaceEnabled && <SavedPagesPanel enabled client:load />}

    <SavedRecordsPanel enabled={savedRecordsSurfaceEnabled} locale="en" client:load />

    <AccountSyncV2Panel enabled={accountSyncV2Enabled} client:load />

    <aside class="pf-note">
      <p class="mono">
        {livingChartSurfaceEnabled
          ? livingChartSyncPrivacyEnabled
            ? 'Living Chart saves start on this device. You can separately choose account sync, turn it off again, edit or delete entries, and export at any time.'
            : 'New Living Chart sync choices are paused. Existing consent may continue syncing until you turn it off; device saves can still be exported or deleted.'
          : accountSyncV2Enabled
            ? 'On-device means: clearing browser data clears local-only saves. An optional account can encrypt and synchronize one explicitly selected self chart.'
            : 'On-device means: clearing your browser data clears local-only saves. Sign in to sync saved charts and removals across devices.'}
      </p>
    </aside>
  </section>
<section class="section--tight container"><ReturnToolLinks locale="en" /></section>
</Base>
