---
import ReturnToolLinks from "../../components/return-visits/ReturnToolLinks.astro";
import Base from '../../layouts/Base.astro';
import ProfileDashboard from '../../islands/ProfileDashboard';
import ProfileInvites from '../../islands/ProfileInvites';
import ProfileManager from '../../islands/ProfileManager';
import AccountSyncV2Panel from '../../islands/AccountSyncV2Panel';
import AccountBoundProfileSurface from '../../islands/AccountBoundProfileSurface';
import ProfileSunSignCapture from '../../islands/ProfileSunSignCapture';
import ProfileIdentity from '../../islands/ProfileIdentity';
import ProfileSafety from '../../islands/ProfileSafety';
import ProfileCardInbox from '../../islands/ProfileCardInbox';
import ProfilePeople from '../../islands/ProfilePeople';
import ProfileKeepClose from '../../islands/ProfileKeepClose';
import SavedRecordsPanel from '../../islands/SavedRecordsPanel';
import { savedRecordsEnabled } from '../../lib/profile/saved-record-flags';
import LivingChartTimeline from '../../islands/living-chart/LivingChartTimeline';
import { hasDailyChartEmailProvider } from '../../lib/email/daily-config';
import { accountSyncV2Enabled as isAccountSyncV2Enabled } from '../../lib/account-v2/feature-flags';
import { livingChartSyncEnabled } from '../../lib/living-chart/feature-flags';
import '../../styles/calculator.css';
import '../../styles/profile-home.css';

const dailyEmailEnabled = hasDailyChartEmailProvider(process.env);
const syncConfigured = Boolean(import.meta.env.PUBLIC_SUPABASE_URL && (import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY || import.meta.env.PUBLIC_SUPABASE_ANON_KEY));
const inviteUiEnabled = process.env.PUBLIC_COMPAT_INVITES_ENABLED === '1';
const accountSyncV2Enabled = isAccountSyncV2Enabled({
  PUBLIC_ACCOUNT_SYNC_V2_ENABLED: process.env.PUBLIC_ACCOUNT_SYNC_V2_ENABLED,
  PUBLIC_ACCOUNT_SYNC_V2_PREVIEW_ACK: process.env.PUBLIC_ACCOUNT_SYNC_V2_PREVIEW_ACK,
});
const livingChartSyncPrivacyEnabled = livingChartSyncEnabled({
  PUBLIC_LIVING_CHART_SYNC_ENABLED: process.env.PUBLIC_LIVING_CHART_SYNC_ENABLED,
});
const livingChartSurfaceEnabled = true;
const savedRecordsSurfaceEnabled = savedRecordsEnabled({
  PUBLIC_SAVED_RECORDS_ENABLED: process.env.PUBLIC_SAVED_RECORDS_ENABLED,
});
---
<Base
  clientUi
  title="Your Charts, Today and Ahead | Zodiacs.org"
  description="Open your saved birth charts, see what is active today, and keep the people and patterns you return to in one place."
  path="/profile/"
  privateSurface={accountSyncV2Enabled || livingChartSurfaceEnabled}
>
  <section class="section--tight container container--narrow">
    <ProfileCardInbox accountBound={accountSyncV2Enabled} client:load />

    <ProfileIdentity accountBound={accountSyncV2Enabled} client:load />

    <ProfileSafety syncConfigured={syncConfigured} accountBound={accountSyncV2Enabled} client:load />

    <nav class="pf-page-nav" aria-label="On your page">
      <a href="/today/">Today <span aria-hidden="true">↗</span></a>
      <a href="#saved-charts">Saved charts <span aria-hidden="true">↓</span></a>
      <a href="#living-chart">Timeline <span aria-hidden="true">↓</span></a>
    </nav>


    <ProfileKeepClose accountBound={accountSyncV2Enabled} client:idle />

    <ProfileSunSignCapture client:load />

    {accountSyncV2Enabled ? (
      <AccountBoundProfileSurface
        dailyEmailEnabled={dailyEmailEnabled}
        livingChartEnabled={livingChartSurfaceEnabled}
        livingChartSyncEnabled={livingChartSyncPrivacyEnabled}
        client:load
      />
    ) : (
      <>
        <ProfileDashboard client:load />
        <ProfilePeople client:idle />
        <LivingChartTimeline syncEnabled allowSyncGrant={livingChartSyncPrivacyEnabled} client:load />
        <ProfileInvites inviteUiEnabled={inviteUiEnabled} client:load />
        <ProfileManager dailyEmailEnabled={dailyEmailEnabled} client:load />
      </>
    )}

    {accountSyncV2Enabled && <ProfilePeople accountBound client:idle />}

    <SavedRecordsPanel enabled={savedRecordsSurfaceEnabled} locale="en" client:load />

    <AccountSyncV2Panel enabled={accountSyncV2Enabled} client:load />

    <aside class="pf-note">
      <p class="mono">
        {livingChartSurfaceEnabled
          ? livingChartSyncPrivacyEnabled
            ? 'Living Chart saves start on this device. You can separately choose account sync, turn it off again, edit or delete entries, and export at any time.'
            : 'New Living Chart sync choices are paused. Existing consent may continue syncing until you turn it off; device saves can still be exported or deleted.'
          : accountSyncV2Enabled
            ? 'On-device means: clearing browser data clears local-only saves. An optional account can encrypt and synchronize one explicitly selected self chart.'
            : 'On-device means: clearing your browser data clears local-only saves. Sign in to sync saved charts and removals across devices.'}
      </p>
    </aside>
  </section>
<section class="section--tight container"><ReturnToolLinks locale="en" /></section>
</Base>

<style is:global>
  .pf-saved-shortcut { margin-bottom: 24px; }
  #saved-charts { scroll-margin-top: 110px; }
  .pf-hero { max-width: 58ch; margin-bottom: clamp(26px, 5vw, 42px); }
  .pf-hero h1 {
    margin: 14px 0 14px;
    font-size: var(--text-2xl);
    line-height: 1.04;
  }
  .pf-hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }
  .pf-hero strong { color: var(--text-2); }

  .pf-sun-sign { margin-bottom: clamp(22px, 4vw, 34px); }
  .pf-sun-sign__core { display: grid; padding: clamp(18px, 4vw, 24px); gap: 9px; }
  .pf-sun-sign__core strong { color: var(--text); font-size: var(--text-lg); }
  .pf-sun-sign__core p { max-width: 58ch; margin: 0; color: var(--muted); line-height: 1.6; }
  .pf-sun-sign__core .btn { width: fit-content; margin-top: 4px; }

  .pf-invites {
    margin: clamp(18px, 4vw, 30px) 0;
    overflow: hidden;
  }
  .pf-invites__core {
    padding: clamp(18px, 4vw, 24px);
    display: grid;
    gap: 16px;
  }
  .pf-invites__head {
    display: grid;
    gap: 6px;
  }
  .pf-invites__head h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .pf-invites__head p,
  .pf-invites__empty p {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .pf-invites__notice {
    margin: 0;
    padding: 11px 13px;
    border-inline-start: 2px solid var(--hair-3);
    background: color-mix(in oklab, var(--ink-0) 3%, transparent);
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.65;
  }
  .pf-invites__empty {
    display: grid;
    gap: 8px;
    justify-items: start;
  }
  .pf-invites__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pf-invites__row {
    min-width: 0;
    padding: 14px 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 5px 14px;
    align-items: center;
    border-top: 1px solid var(--hair-1);
  }
  .pf-invites__row:first-child { border-top: 0; }
  .pf-invites__identity {
    min-width: 0;
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .pf-invites__disc {
    flex: 0 0 32px;
    width: 32px;
    height: 32px;
    line-height: 0;
  }
  .pf-invites__disc img {
    width: 32px;
    height: 32px;
    border-radius: 50%;
  }
  .pf-invites__who {
    min-width: 0;
    overflow: hidden;
    color: var(--text);
    font-size: var(--text-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pf-invites__status {
    justify-self: end;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .pf-invites__detail,
  .pf-invites__error,
  .pf-invites__actions,
  .pf-invites__manual {
    grid-column: 1 / -1;
  }
  .pf-invites__detail,
  .pf-invites__error {
    margin: 0;
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.55;
  }
  .pf-invites__error { color: var(--sign-aries); }
  .pf-invites__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .pf-invites__actions .btn,
  .pf-invites__text-action {
    min-height: 44px;
    font-size: 13px;
  }
  .pf-invites__actions .btn { padding: 8px 14px; }
  .pf-invites__text-action {
    display: inline-flex;
    align-items: center;
    padding: 8px 6px;
    color: var(--text-2);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pf-invites__text-action:disabled {
    cursor: not-allowed;
    opacity: 0.42;
  }
  .pf-invites__manual {
    width: 100%;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .pf-invites__account {
    margin: 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.65;
  }
  .pf-invites button:focus-visible,
  .pf-invites input:focus-visible,
  .pf-invites a:focus-visible {
    outline: 2px solid var(--ink-0);
    outline-offset: 3px;
  }
  @media (max-width: 420px) {
    .pf-invites__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 7px;
    }
    .pf-invites__status {
      justify-self: start;
      padding-inline-start: 42px;
    }
  }

  .pf { display: grid; gap: 16px; }
  .pf-sync__core {
    padding: 18px 20px;
    display: grid;
    gap: 14px;
  }
  @media (min-width: 680px) {
    .pf-sync__core {
      grid-template-columns: minmax(0, 1fr) minmax(0, 310px);
      align-items: center;
    }
  }
  .pf-sync__core strong { display: block; margin-bottom: 4px; font-size: var(--text-lg); }
  .pf-sync__core p { margin: 0; color: var(--text-2); font-size: var(--text-sm); line-height: 1.55; }
  .pf-sync__label { display: block; margin-bottom: 7px; color: var(--faint); }
  .pf-digest-panel {
    grid-column: 1 / -1;
    padding-top: 16px;
    border-top: 1px solid var(--hair-1);
  }
  .pf-digest {
    margin-top: 9px;
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
    color: var(--text-2);
    font-size: var(--text-sm);
  }
  .pf-digest input { margin: 3px 0 0; accent-color: var(--accent); }
  .pf-digest strong { margin: 0 0 2px; font-size: var(--text-sm); color: var(--text); }
  .pf-digest small { display: block; color: var(--muted); line-height: 1.45; }
  .pf-daily {
    grid-column: 1 / -1;
    padding-top: 18px;
    border-top: 1px solid var(--hair-1);
  }
  .pf-daily h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .pf-daily h3 { margin: 0; font-size: var(--text-lg); }
  .pf-daily__dek { margin-top: 5px !important; }
  .pf-daily__state { display: grid; gap: 12px; margin-top: 16px; }
  .pf-daily__state > p { margin: 0; }
  .pf-daily__state form { display: grid; gap: 14px; }
  .pf-daily__charts {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .pf-daily__charts legend,
  .pf-daily__timezone > span {
    margin-bottom: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pf-daily__chart {
    min-height: 52px;
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    padding: 8px 10px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    cursor: pointer;
  }
  .pf-daily__chart:has(input:checked) { border-color: var(--hair-3); }
  .pf-daily__chart input { width: 18px; height: 18px; margin: 0; accent-color: var(--accent); }
  .pf-daily__chart strong {
    display: block;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    font-size: var(--text-sm);
    font-weight: 550;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pf-daily__chart small {
    display: block;
    min-width: 0;
    margin-top: 2px;
    overflow: hidden;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pf-daily__timezone { display: grid; }
  .pf-daily__timezone select {
    width: 100%;
    min-height: 44px;
    padding: 0 38px 0 12px;
    border: 1px solid var(--hair-2);
    border-radius: var(--r-md);
    background: var(--void-1);
    color: var(--text);
    font: inherit;
  }
  .pf-daily__consent,
  .pf-daily__weekly-note {
    color: var(--muted) !important;
    font-size: 12.5px !important;
    line-height: 1.55 !important;
  }
  .pf-daily__weekly-note {
    margin: 16px 0 0 !important;
  }
  .pf-daily__message { color: var(--text-2) !important; }
  .pf-daily__actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .pf-daily__actions .btn,
  .pf-daily__stop { min-height: 44px; }
  .pf-daily__text-action {
    min-height: 44px;
    padding: 8px 4px;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pf-daily__banner {
    padding: 12px;
    border-inline-start: 2px solid var(--hair-3);
    background: color-mix(in oklab, var(--ink-0) 3%, transparent);
    color: var(--text-2) !important;
  }
  .pf-daily__active { color: var(--text) !important; }
  .pf-daily__truncate {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pf-daily a { color: var(--text-2); text-underline-offset: 3px; }
  .pf-daily button:focus-visible,
  .pf-daily input:focus-visible,
  .pf-daily select:focus-visible,
  .pf-daily a:focus-visible {
    outline: 2px solid var(--ink-0);
    outline-offset: 3px;
  }
  .pf-sync__message { margin-top: 8px !important; color: var(--muted) !important; }
  .pf-sync__message--error { color: var(--sign-aries) !important; }
  .pf-sync__form {
    display: grid;
    gap: 10px;
    min-width: 0;
  }
  .pf-sync__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: flex-start;
  }
  .pf-sync__form .btn { justify-content: space-between; }
  .pf-account-v2 { margin-top: 16px; }
  .pf-account-v2 .pf-sync__core { align-items: start; }
  .pf-account-v2__intro { min-width: 0; }
  .pf-account-v2__session {
    justify-content: flex-end;
    align-items: center;
  }
  .pf-account-v2__email {
    max-width: 240px;
    overflow: hidden;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 11px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pf-account-v2__section {
    grid-column: 1 / -1;
    display: grid;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid var(--hair-1);
  }
  .pf-account-v2__section h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 500;
  }
  .pf-account-v2__charts { display: grid; gap: 10px; }
  .pf-account-v2__chart {
    display: grid;
    gap: 11px;
    padding: 14px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: color-mix(in oklab, var(--ink-0) 2%, transparent);
  }
  .pf-account-v2__chart--selected {
    border-color: color-mix(in oklab, var(--accent) 42%, var(--hair-1));
  }
  .pf-account-v2__chart > div:first-child strong,
  .pf-account-v2__chart > div:first-child small { display: block; }
  .pf-account-v2__chart > div:first-child small {
    margin-top: 3px;
    color: var(--muted);
    font-size: 11px;
  }
  .pf-account-v2 details summary {
    cursor: pointer;
    color: var(--text-2);
    font-size: 12.5px;
    text-underline-offset: 3px;
  }
  .pf-account-v2__preview {
    display: grid;
    gap: 7px;
    margin-top: 9px;
    padding: 11px;
    border-inline-start: 2px solid var(--hair-3);
    background: color-mix(in oklab, var(--ink-0) 3%, transparent);
  }
  .pf-account-v2__preview p { font-size: 12px; overflow-wrap: anywhere; }
  .pf-account-v2__delete {
    display: grid;
    gap: 11px;
    margin-top: 4px;
    padding-top: 12px;
    border-top: 1px solid var(--hair-1);
  }
  .pf-account-v2__delete-label {
    color: var(--muted);
    font-size: 12px;
  }
  .pf-account-v2__delete .field__input { max-width: 260px; }
  .pf-account-v2 button:focus-visible,
  .pf-account-v2 input:focus-visible,
  .pf-account-v2 summary:focus-visible {
    outline: 2px solid var(--ink-0);
    outline-offset: 3px;
  }
  .pf-count { margin: 0; font-size: 11px; letter-spacing: 0.08em; color: var(--faint); }
  .pf-list { display: grid; gap: 12px; }
  .pf-privacy { margin: 0; color: var(--muted); font-size: var(--text-sm); }
  .pf-chart__core { padding: 20px; display: grid; gap: 12px; }
  .pf-chart__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; }
  .pf-chart__head h2 { margin: 0; font-size: var(--text-lg); font-weight: 620; letter-spacing: -0.015em; }
  .pf-chart__rename { display: flex; gap: 8px; flex: 1; min-width: 200px; }
  .pf-chart__rename .field__input { height: 38px; }
  .pf-chart__actions { display: flex; gap: 8px; }
  .pf-chart__action {
    padding: 6px 12px;
    border-radius: var(--r-full);
    border: 1px solid var(--hair-2);
    font-size: 12.5px;
    color: var(--text-2);
    transition: border-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
  }
  .pf-chart__action:hover { border-color: var(--hair-3); color: var(--text); }
  .pf-chart__action--danger:hover { border-color: color-mix(in oklab, var(--sign-aries) 55%, transparent); color: var(--sign-aries); }
  .pf-chart__birth { margin: 0; font-size: 11.5px; color: var(--faint); letter-spacing: 0.05em; }
  .pf-chart__three { display: flex; flex-wrap: wrap; gap: 8px; }
  .pf-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 11px 4px 6px;
    border-radius: var(--r-full);
    border: 1px solid color-mix(in oklab, var(--sign, var(--accent)) 35%, transparent);
    background: color-mix(in oklab, var(--sign, var(--accent)) 9%, transparent);
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
  }
  .pf-chip__icon { line-height: 0; }
  .pf-chip__icon img { border-radius: 50%; }
  .pf-chip__label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pf-chip--empty { border-color: var(--hair-1); background: none; color: var(--faint); }
  .pf-next__core { padding: 18px 20px; display: grid; gap: 8px; justify-items: start; }
  .pf-next__core p { margin: 0; font-size: var(--text-sm); color: var(--text-2); }
  .pf-next__core .btn { margin-top: 6px; }
  .pf-foot { display: flex; }
  .pf-note { margin-top: clamp(24px, 5vw, 40px); }
  .pf-note p { margin: 0; font-size: 12px; line-height: 1.7; color: var(--muted); letter-spacing: 0.04em; }
</style>
