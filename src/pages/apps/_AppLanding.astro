---
// The shared frame of the per-assistant landing pages (/apps/claude/, /apps/chatgpt/, /apps/cursor/, /apps/claude-code/).
// Every word a reader needs is in the HTML; the one script only copies text to the clipboard.
import Base from '../../layouts/Base.astro';

type Faq = { q: string; a: string };
type Fact = { term: string; detail: string };
interface Props {
  app: string;
  path: string;
  title: string;
  description: string;
  kicker: string;
  heading: string;
  lede: string;
  facts: Fact[];
  faq: Faq[];
  pageName: string;
}
const { app, path, title, description, kicker, heading, lede, facts, faq, pageName } = Astro.props;
const url = `https://zodiacs.org${path}`;
const prompts = [
  { id: 'chart', label: 'Your birth chart', text: 'Open Zodiacs Chart Studio so I can explore my birth chart.' },
  { id: 'comparison', label: 'Two people', text: "Use Zodiacs to compare our charts, with our first names on the card. I’m Lucía, born 14 May 1994 at 9:15 in Seville, Spain. Mateo was born 4 August 1991, time unknown." },
  { id: 'wedding', label: 'A day that matters', text: 'Use Zodiacs to make a wedding card with our names, Lucía and Mateo, for 18 September 2027 at 16:30 in Lisbon, Portugal. Tell us what the sky means in astrology.' },
  { id: 'horoscope', label: 'Your sign today', text: 'Use Zodiacs to show today’s horoscope for Leo in Mexico City.' },
  { id: 'sky', label: 'The sky right now', text: 'Use Zodiacs: is Mercury retrograde today, and which sign is the Moon in?' },
];
const others = [
  { href: '/apps/claude/', name: 'Claude' },
  { href: '/apps/chatgpt/', name: 'ChatGPT' },
  { href: '/apps/cursor/', name: 'Cursor' },
  { href: '/apps/claude-code/', name: 'Claude Code' },
].filter((entry) => entry.href !== path);
const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: pageName,
    description,
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
    inLanguage: 'en',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Apps', item: 'https://zodiacs.org/apps/' },
      { '@type': 'ListItem', position: 3, name: app, item: url },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base title={title} description={description} path={path} jsonLd={jsonLd} stableTypography minimalNavFontPreloads>
  <div class="app-landing">
    <header class="app-hero kwrap">
      <p class="kicker">{kicker}</p>
      <h1>{heading}</h1>
      <p class="app-lede">{lede}</p>
      <slot name="actions" />
    </header>

    <section class="app-facts kwrap" aria-label={`Zodiacs in ${app} at a glance`}>
      <dl>
        {facts.map((fact) => <div><dt>{fact.term}</dt><dd>{fact.detail}</dd></div>)}
      </dl>
    </section>

    <section class="app-section kwrap" id="connect" aria-labelledby="connect-title">
      <slot name="connect" />
    </section>

    <section class="app-section kwrap" id="ask" aria-labelledby="ask-title">
      <h2 id="ask-title">Things you can ask</h2>
      <p class="app-intro">Ask in your own words. These prompts use made-up names and birth details; your answer uses the details and date you give. Zodiacs answers questions about birth charts, compatibility between two people, the sky on a wedding day or anniversary, Sun-sign horoscopes, birthdays, life milestones like a Saturn return, and where the planets are on a given date.</p>
      <ul class="app-prompts">
        {prompts.map((prompt) => (
          <li>
            <p class="app-prompts__label">{prompt.label}</p>
            <blockquote id={`prompt-${prompt.id}`}>{prompt.text}</blockquote>
            <button type="button" data-copy={`prompt-${prompt.id}`} aria-label={`Copy the ${prompt.label.toLowerCase()} prompt`}>Copy prompt</button>
          </li>
        ))}
      </ul>
      <p class="app-copy-status" role="status" aria-live="polite"></p>
      <p class="app-smallprint">Astrology offers interpretation and reflection. A compatibility score or date rating does not guarantee an outcome. Each forecast carries a reading confidence label, which says how specific the details were.</p>
    </section>

    <section class="app-section kwrap" aria-labelledby="context-title">
      <h2 id="context-title">A little context before you connect.</h2>
      <p>Public sky questions and Sun-sign horoscopes need no birth details. Chart Studio calculates inside its panel and shares only selections you review. Other tools use the dates and optional details you give for the answer; those details pass through your assistant provider.</p>
      <p><a class="textlink" href="/privacy/#ai-integrations">Read about privacy <span class="arr" aria-hidden="true">→</span></a></p>
    </section>

    <section class="app-section kwrap" aria-labelledby="faq-title">
      <h2 id="faq-title">Questions</h2>
      <dl class="app-faq">
        {faq.map(({ q, a }) => <div><dt>{q}</dt><dd>{a}</dd></div>)}
      </dl>
    </section>

    <nav class="app-section app-more kwrap" aria-label="More ways to use Zodiacs">
      <p>Zodiacs in other assistants: {others.map((entry, index) => <>{index > 0 && (index === others.length - 1 ? ' and ' : ', ')}<a href={entry.href}>{entry.name}</a></>)}. All of them, with real card examples and a short tour, are on the <a href="/apps/">apps page</a>. You can also use every calculator <a href="/tools/">on the site</a>.</p>
    </nav>
  </div>
</Base>
<script>
  const status = document.querySelector<HTMLElement>('.app-copy-status');
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const source = document.getElementById(button.dataset.copy ?? '');
      if (!source) return;
      try {
        await navigator.clipboard.writeText(source.textContent?.trim() ?? '');
        if (status) status.textContent = 'Copied.';
      } catch {
        const range = document.createRange();
        range.selectNodeContents(source);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        if (status) status.textContent = 'Text selected. Use your device’s Copy command.';
      }
    });
  });
</script>
<style>
  .app-landing { --app-accent: var(--sign-libra); }
  .app-hero { padding-block: clamp(42px, 6vw, 88px) 48px; max-width: 60rem; }
  .app-hero h1 { font-family: var(--font-serif); font-size: clamp(3rem, 6vw, 5.6rem); font-weight: 400; letter-spacing: -.04em; line-height: 1; margin: 18px 0 24px; text-wrap: balance; }
  .app-lede { color: var(--ink-2); font-size: 1.125rem; line-height: 1.7; max-width: 52ch; }
  .app-landing :global(.app-actions) { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; margin-top: 28px; }
  .app-landing :global(.app-actions .btn) { min-height: 56px; }
  .app-landing :global(.app-note) { color: var(--ink-3); font-size: .8125rem; line-height: 1.6; max-width: 60ch; margin-top: 18px; }
  .app-facts { border-top: 1px solid var(--hair-2); border-bottom: 1px solid var(--hair-2); padding-block: 26px; }
  .app-facts dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin: 0; }
  .app-facts dt { font-size: 1rem; font-weight: 500; }
  .app-facts dd { color: var(--ink-3); font-size: .875rem; line-height: 1.55; margin: 6px 0 0; overflow-wrap: anywhere; }
  .app-section { padding-block: 56px 8px; max-width: 60rem; }
  .app-section :global(h2) { font-family: var(--font-serif); font-weight: 400; font-size: clamp(2rem, 3.6vw, 3rem); line-height: 1.08; letter-spacing: -.02em; margin: 0 0 18px; }
  .app-section :global(h3) { font-family: var(--font-serif); font-weight: 400; font-size: 1.5rem; margin: 32px 0 10px; }
  .app-section :global(p), .app-section :global(li) { color: var(--ink-2); font-size: .9375rem; line-height: 1.75; }
  .app-section :global(ol) { padding-left: 22px; }
  .app-section :global(ol > li) { padding: 6px 0; }
  .app-section :global(code) { font-family: var(--font-mono); font-size: .8125rem; overflow-wrap: anywhere; }
  .app-section :global(pre) { background: var(--surface); border-radius: 10px; padding: 16px 18px; overflow-x: auto; margin: 12px 0; }
  .app-section :global(.app-endpoint) { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; margin-top: 10px; padding: 10px 16px; background: var(--surface); border-radius: 9px; }
  .app-landing :global(button[data-copy]) { background: none; color: var(--ink-1); font: inherit; font-size: .8125rem; border: 0; cursor: pointer; padding: 9px 0; min-height: 44px; text-decoration: underline; text-underline-offset: 5px; }
  .app-intro { max-width: 68ch; }
  .app-prompts { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 28px 40px; }
  .app-prompts li { border-top: 1px solid var(--hair-2); padding-top: 16px; min-width: 0; }
  .app-prompts__label { color: var(--app-accent); font-size: .8125rem; margin: 0 0 8px; }
  .app-prompts blockquote { font-family: var(--font-serif); font-size: 1.125rem; font-style: italic; line-height: 1.5; color: var(--ink-2); margin: 0 0 6px; }
  .app-copy-status { min-height: 24px; font-size: .875rem; margin: 16px 0 0; color: var(--app-accent); }
  .app-smallprint { font-size: .8125rem; color: var(--ink-3); max-width: 86ch; }
  .app-faq { margin: 0; }
  .app-faq > div { border-top: 1px solid var(--hair-2); padding: 20px 0; }
  .app-faq dt { font-size: 1.0625rem; font-weight: 500; }
  .app-faq dd { margin: 8px 0 0; color: var(--ink-2); font-size: .9375rem; line-height: 1.75; max-width: 70ch; }
  .app-more { padding-bottom: 72px; }
  .app-more a { color: var(--ink-1); text-underline-offset: 4px; }
  #connect, #ask { scroll-margin-top: 110px; }
  .app-landing :is(a, button, summary):focus-visible { outline: 2px solid var(--app-accent); outline-offset: 5px; }
  @media (max-width: 640px) {
    .app-hero { padding-block: 36px 32px; }
    .app-lede { font-size: 1rem; }
    .app-facts dl { grid-template-columns: 1fr; gap: 18px; }
    .app-prompts { grid-template-columns: 1fr; }
    .app-section { padding-top: 44px; }
  }
</style>
