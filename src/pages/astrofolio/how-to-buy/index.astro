---
import Base from '../../../layouts/Base.astro';
import { t } from '../../../lib/i18n';
import { SIGNS } from '../../../lib/signs';
import registryJson from '../../../../public/registry/zodiacs.registry.json';

interface Props {
  initialSlug?: string;
  canonicalPath?: string;
}

type RegistryRepresentation = {
  chain: string;
  address: string;
  symbol?: string;
};

type RegistryAsset = {
  sign: string;
  displayName: string;
  representations: RegistryRepresentation[];
};

const registryAssets = registryJson.assets as RegistryAsset[];
const records = SIGNS.map((sign) => {
  const asset = registryAssets.find((candidate) => candidate.sign === sign.slug);
  const solana = asset?.representations.find((representation) => representation.chain === 'solana');
  if (!asset || !solana?.address) throw new Error(`How-to-buy: missing verified Solana record for ${sign.slug}`);
  return {
    slug: sign.slug,
    name: asset.displayName,
    symbol: solana.symbol ?? sign.name.toUpperCase(),
    glyph: sign.glyph,
    dates: sign.dates,
    hue: sign.hue,
    mint: solana.address,
    icon: `/assets/zodiac-icons/128/${sign.slug}.webp`,
  };
});

if (records.length !== 12 || new Set(records.map((record) => record.mint)).size !== 12) {
  throw new Error('How-to-buy: expected twelve unique verified Solana records');
}

const { initialSlug = 'leo', canonicalPath = '/astrofolio/how-to-buy/' } = Astro.props;
const defaultRecord = records.find((record) => record.slug === initialSlug)
  ?? records.find((record) => record.slug === 'leo')
  ?? records[0];
---
<Base title={t('en', 'trustAddressGuide')} description={t('en', 'trustAddressIntro')} path={canonicalPath} noindex stableTypography>
  <article class="container container--narrow section" data-initial-sign={defaultRecord.slug}>
    <h1 class="display">{t('en', 'trustAddressGuide')}</h1>
    <p>{t('en', 'trustAddressIntro')}</p>
    <p>{t('en', 'trustFreeAnswer')} <a href="/disclosure/">{t('en', 'trustDisclosure')}</a>.</p>
    <nav class="buy-signs" aria-label={t('en', 'navSigns')}>
      {records.map((record) => <a href={`/astrofolio/how-to-buy/${record.slug}/`} aria-current={record.slug === defaultRecord.slug ? 'page' : undefined}>{record.name}</a>)}
    </nav>
    <section class="buy-record shell" style={`--sign:${defaultRecord.hue}`}>
      <h2>{defaultRecord.name}</h2>
      <code>{defaultRecord.mint}</code>
      <a class="btn btn--ghost" href={`/registry/${defaultRecord.slug}/`}>{t('en', 'footerRegistry')} →</a>
      <a class="btn btn--primary" href={`https://fomo.family/coin?address=${encodeURIComponent(defaultRecord.mint)}&chainId=1399811149`} rel="noopener noreferrer external nofollow">{t('en', 'buyWithFomo')} ↗</a>
    </section>
  </article>
</Base>
<style>
.buy-signs { display:flex; flex-wrap:wrap; gap:12px 20px; margin-block:24px; }
.buy-signs a[aria-current] { color:var(--text); text-decoration-thickness:2px; }
.buy-record { padding:24px; display:flex; flex-wrap:wrap; gap:20px; align-items:center; }
.buy-record h2, .buy-record code { flex-basis:100%; margin:0; }
.buy-record code { overflow-wrap:anywhere; min-width:0; font-size:13px; color:var(--muted); }
</style>
