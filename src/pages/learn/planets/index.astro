---
import { getCollection } from 'astro:content';
import { editorialDates } from '../../../lib/editorial-metadata.mjs';
import Base from '../../../layouts/Base.astro';
import PlanetGlyph from '../../../components/PlanetGlyph';
import '../../../styles/cluster.css';

const PLANET_ORDER = [
  'Sun', 'Moon', 'Mercury', 'Venus', 'Mars',
  'Jupiter', 'Saturn', 'Uranus', 'Neptune', 'Pluto',
] as const;

const RULER_SIGN = {
  Sun: 'leo',
  Moon: 'cancer',
  Mercury: 'gemini',
  Venus: 'taurus',
  Mars: 'aries',
  Jupiter: 'sagittarius',
  Saturn: 'capricorn',
  Uranus: 'aquarius',
  Neptune: 'pisces',
  Pluto: 'scorpio',
} as const satisfies Record<(typeof PLANET_ORDER)[number], string>;

const entries = await getCollection('learn', (e) => e.data.kind === 'planet' && !e.data.draft);
const planets = PLANET_ORDER.map((name) => {
  const entry = entries.find((e) => e.data.kind === 'planet' && e.data.planet === name);
  if (!entry) throw new Error(`Missing planet page: ${name}`);
  return {
    name,
    slug: entry.id.split('/')[1],
    role: entry.data.kind === 'planet' ? entry.data.role : '',
    hue: `var(--sign-${RULER_SIGN[name]})`,
  };
});

const jsonLd = [
  {
    '@type': 'CollectionPage',
    ...editorialDates('/learn/planets/'),
    name: 'The planets in astrology',
    url: 'https://zodiacs.org/learn/planets/',
    description: 'What each planet means in a birth chart, from the Sun to Pluto, plain-language guides to all ten.',
  },
  {
    '@type': 'ItemList',
    numberOfItems: planets.length,
    itemListElement: planets.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.name,
      url: `https://zodiacs.org/learn/planets/${p.slug}/`,
    })),
  },
];
---
<Base
  type="website"
  editorialLine
  title="The Planets in Astrology: What Each One Means | Zodiacs.org"
  description="What every planet means in a birth chart: the Sun and Moon, Mercury through Mars, and the slow outer planets, each explained plainly, with its cycle and rulerships."
  path="/learn/planets/"
  jsonLd={jsonLd}
>
  <section class="section--tight container container--narrow">
    <div class="cluster-hero reveal">
      <a class="crumb" href="/learn/"><span class="crumb__arrow" aria-hidden="true">←</span>Learn</a>
      <h1 class="display">The planets</h1>
      <p>
        A <a href="/learn/glossary/#birth-chart">birth chart</a> begins with ten moving bodies, each assigned a different
        function. The <a href="/learn/glossary/#sun">Sun</a> describes identity and direction; the <a href="/learn/glossary/#moon">Moon</a>, instinct
        and comfort. <a href="/learn/glossary/#mercury">Mercury</a> handles thought and language, <a href="/learn/glossary/#venus">Venus</a> attraction,
        and Mars effort and appetite. Jupiter and Saturn widen the frame to
        growth, limits, time, and consequence. Uranus, Neptune, and Pluto move
        slowly enough to mark a generation, then become personal through the
        houses and aspects they occupy in one chart. A planet is never a
        complete reading by itself. Its sign describes how it works, its house
        shows where that work appears, and its aspects show which other parts
        of the chart support or complicate it. The ten guides below start with
        the planet’s basic job, then cover its cycle, rulerships, and the facts
        that stay useful when you move from a definition to your own chart.
        Each page also leads into that planet’s twelve possible sign
        placements for a more specific reading.
      </p>
    </div>

    <ol class="cluster-list reveal">
      {planets.map((p) => (
        <li>
          <a class="cluster-row" href={`/learn/planets/${p.slug}/`}>
            <span class="cluster-row__glyph"><PlanetGlyph body={p.name} size={18} disc hue={p.hue} /></span>
            <span class="cluster-row__name">{p.name}</span>
            <span class="cluster-row__role">{p.role}</span>
            <span class="cluster-row__go">→</span>
          </a>
        </li>
      ))}
    </ol>

    <p class="cluster-note reveal">
      Every one of them has a sign, a house, and aspects in your chart.{' '}
      <a href="/birth-chart/">Compute yours</a> to see where they landed. Or
      continue with <a href="/learn/houses/">the houses</a> and{' '}
      <a href="/learn/aspects/">the aspects</a>.
    </p>
  </section>
</Base>
