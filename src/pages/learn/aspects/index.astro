---
import { getCollection } from 'astro:content';
import { editorialDates } from '../../../lib/editorial-metadata.mjs';
import Base from '../../../layouts/Base.astro';
import AspectGlyph from '../../../components/AspectGlyph';
import NatalAspectsHubSection from '../../../components/learn/NatalAspectsHubSection.astro';
import { ASPECTS } from '../../../lib/engine/aspects';
import { natalAspectsEnabled } from '../../../lib/natal-aspect-pairs';
import '../../../styles/cluster.css';

const ASPECT_ORDER = ['conjunction', 'sextile', 'square', 'trine', 'opposition'];

const entries = await getCollection('learn', (e) => e.data.kind === 'aspect' && !e.data.draft);
const aspects = ASPECT_ORDER.map((type) => {
  const entry = entries.find((e) => e.data.kind === 'aspect' && e.data.aspect === type);
  if (!entry) throw new Error(`Missing aspect page: ${type}`);
  const def = ASPECTS.find((a) => a.type === type)!;
  return {
    type,
    name: type.charAt(0).toUpperCase() + type.slice(1),
    slug: entry.id.split('/')[1],
    theme: entry.data.kind === 'aspect' ? entry.data.theme : '',
    angle: def.angle,
  };
});

const jsonLd = [
  {
    '@type': 'CollectionPage',
    ...editorialDates('/learn/aspects/'),
    name: 'Aspects in astrology',
    url: 'https://zodiacs.org/learn/aspects/',
    description: 'The five major aspects explained: conjunction, sextile, square, trine, and opposition, what each angle means in a birth chart.',
  },
  {
    '@type': 'ItemList',
    numberOfItems: aspects.length,
    itemListElement: aspects.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.name,
      url: `https://zodiacs.org/learn/aspects/${a.slug}/`,
    })),
  },
];
---
<Base
  type="website"
  editorialLine
  title="Aspects in Astrology: Conjunction, Square, Trine & More | Zodiacs.org"
  description="The five major aspects of a birth chart explained plainly: conjunction, sextile, square, trine, and opposition, what each angle between planets means."
  path="/learn/aspects/"
  jsonLd={jsonLd}
>
  <section class="section--tight container container--narrow">
    <div class="cluster-hero reveal">
      <a class="crumb" href="/learn/"><span class="crumb__arrow" aria-hidden="true">←</span>Learn</a>
      <h1 class="display">The aspects</h1>
      <p>
        <a href="/learn/glossary/#aspect">Aspects</a> are measured angles between <a href="/learn/glossary/#planet">planets</a>, and they describe how two
        functions in a chart meet. A <a href="/learn/glossary/#conjunction">conjunction</a> puts them in the same place;
        a sextile or trine gives them an easier route to one another; a <a href="/learn/glossary/#square">square</a>{' '}
        or opposition creates tension that has to be managed. None is a simple
        promise of good or bad. Ease can go unused, while friction often becomes
        a practiced strength. The closer an aspect is to its exact angle, the
        smaller its <a href="/learn/glossary/#orb">orb</a> and the more weight astrologers usually give it. The
        Sun and Moon receive slightly wider orbs because they organize more of
        the chart. These five guides explain the geometry, the felt pattern,
        and a practical way to read each aspect without turning a chart into a
        list of isolated verdicts. Start with the tightest few in your chart;
        they usually say more than a long inventory of loose connections alone.
      </p>
    </div>

    <ol class="cluster-list reveal">
      {aspects.map((a) => (
        <li>
          <a class="cluster-row" href={`/learn/aspects/${a.slug}/`}>
            <span class="cluster-row__num mono"><AspectGlyph type={a.type} size={16} class="pg-inline" /> {a.angle}°</span>
            <span class="cluster-row__name">{a.name}</span>
            <span class="cluster-row__role">{a.theme}</span>
            <span class="cluster-row__go">→</span>
          </a>
        </li>
      ))}
    </ol>

    <p class="cluster-note reveal">
      See your own wiring: <a href="/birth-chart/">the chart calculator</a>{' '}
      lists every major aspect with its exact orb. Or continue with{' '}
      <a href="/learn/planets/">the planets</a> and{' '}
      <a href="/learn/houses/">the houses</a>.
    </p>

    {natalAspectsEnabled && <NatalAspectsHubSection />}
  </section>
</Base>
