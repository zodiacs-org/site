---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Faq from '../../../components/Faq.astro';
import AspectGlyph from '../../../components/AspectGlyph';
import AspectWheel from '../../../components/AspectWheel.astro';
import { ASPECTS } from '../../../lib/engine/aspects';
import { EDITOR_AUTHOR } from '../../../lib/editorial';

const ASPECT_ORDER = ['conjunction', 'sextile', 'square', 'trine', 'opposition'] as const;

export async function getStaticPaths() {
  const entries = await getCollection(
    'learn',
    (e) => e.data.kind === 'aspect' && !e.data.draft,
  );
  if (entries.length !== 5) {
    throw new Error(`Expected 5 aspect pages, found ${entries.length}`);
  }
  return entries.map((entry) => ({
    params: { slug: entry.id.split('/')[1] },
    props: { entry },
  }));
}

const { entry } = Astro.props;
if (entry.data.kind !== 'aspect') throw new Error('Not an aspect entry');
const type = entry.data.aspect;
const slug = entry.id.split('/')[1];
const { Content } = await render(entry);

// The calculator's own orb table — the page quotes the engine, not lore.
const def = ASPECTS.find((a) => a.type === type)!;
const name = type.charAt(0).toUpperCase() + type.slice(1);

const idx = ASPECT_ORDER.indexOf(type);
const prev = idx > 0 ? ASPECT_ORDER[idx - 1] : null;
const next = idx < ASPECT_ORDER.length - 1 ? ASPECT_ORDER[idx + 1] : null;
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const jsonLd = [
  {
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    url: `https://zodiacs.org/learn/aspects/${slug}/`,
    datePublished: entry.data.published.toISOString(),
    dateModified: entry.data.updated.toISOString(),
    author: EDITOR_AUTHOR,
    publisher: { '@id': 'https://zodiacs.org/#org' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://zodiacs.org/learn/aspects/${slug}/` },
    inLanguage: 'en',
    about: { '@type': 'Thing', name: `${name} (astrology)` },
    citation: entry.data.sources.map((source) => source.href
      ? { '@type': 'CreativeWork', name: source.label, url: source.href }
      : source.label),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Learn', item: 'https://zodiacs.org/learn/' },
      { '@type': 'ListItem', position: 3, name: 'The aspects', item: 'https://zodiacs.org/learn/aspects/' },
      { '@type': 'ListItem', position: 4, name: name, item: `https://zodiacs.org/learn/aspects/${slug}/` },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: entry.data.faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title={entry.data.title}
  description={entry.data.description}
  path={`/learn/aspects/${slug}/`}
  type="article"
  jsonLd={jsonLd}
  sources={entry.data.sources}
>
  <article class="container container--narrow learn-detail">
    <header class="learn-detail__hero learn-detail__hero--figured reveal">
      <div class="learn-detail__heroText">
        <a class="crumb" href="/learn/aspects/"><span class="crumb__arrow" aria-hidden="true">←</span>The aspects</a>
        <AspectGlyph type={type} size={46} class="learn-hero-glyph" />
        <h1 id={slug} class="display">The {type}</h1>
        <p class="learn-detail__role">{entry.data.theme}</p>
        <p class="learn-detail__facts mono">
          {def.angle}° · orb {def.orb}° · {def.orbLuminary}° with the Sun or Moon
        </p>
      </div>
      <AspectWheel angle={def.angle} size={232} class="learn-detail__figure" />
    </header>

    <div class="prose reveal">
      <Content />
    </div>

    <section class="reveal">
      <Faq items={entry.data.faq} heading="Asked and answered" />
    </section>

    <div class="learn-detail__cta shell tinted reveal">
      <div class="core tinted learn-detail__cta-core">
        <strong>Which {type}s do you have?</strong>
        <p>The chart calculator lists every major aspect in your chart, with exact orbs.</p>
        <a class="btn btn--primary" href="/birth-chart/"><span>Get your free birth chart</span><span class="orb">↗</span></a>
      </div>
    </div>

    <nav class="learn-detail__nav reveal" aria-label="More aspects">
      {prev ? <a href={`/learn/aspects/${prev}/`}>← {cap(prev)}</a> : <span />}
      <a href="/learn/aspects/">All aspects</a>
      {next ? <a href={`/learn/aspects/${next}/`}>{cap(next)} →</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .learn-detail { display: grid; gap: clamp(28px, 5vw, 44px); padding-block: clamp(24px, 5vw, 56px) clamp(36px, 6vw, 72px); }
  .learn-detail__hero { display: grid; gap: 12px; justify-items: start; }

  /* The diagram carries the geometry; the text keeps the measure it had. */
  .learn-detail__hero--figured {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(20px, 4vw, 48px);
  }
  .learn-detail__heroText { display: grid; gap: 12px; justify-items: start; min-width: 0; }
  .learn-detail__figure { justify-self: end; }

  @media (max-width: 720px) {
    .learn-detail__hero--figured { grid-template-columns: minmax(0, 1fr); }
    .learn-detail__figure { justify-self: start; margin-top: 4px; }
  }
  .learn-detail__hero h1 {
    margin: 4px 0 0;
    font-size: clamp(2.2rem, 1.5rem + 3.6vw, 3.8rem);
    line-height: 1;
  }
  .learn-detail__role { margin: 0; font-size: var(--text-lg); color: var(--muted); max-width: 52ch; text-wrap: pretty; }
  .learn-detail__facts { margin: 2px 0 0; font-family: var(--font-sans); font-size: 14px; color: var(--faint); letter-spacing: 0; font-variant-numeric: tabular-nums; }

  .learn-detail__cta-core { padding: clamp(22px, 4vw, 32px); display: grid; gap: 10px; justify-items: start; }
  .learn-detail__cta-core strong { font-size: var(--text-lg); letter-spacing: -0.01em; }
  .learn-detail__cta-core p { margin: 0; font-size: var(--text-sm); color: var(--text-2); }

  .learn-detail__nav {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid var(--hair-1);
    font-size: var(--text-sm);
  }
  .learn-detail__nav a { color: var(--text-2); text-decoration: none; }
  .learn-detail__nav a:hover { color: var(--text); }
</style>
