---
import { getCollection } from 'astro:content';
import { editorialDates } from '../../lib/editorial-metadata.mjs';
import Base from '../../layouts/Base.astro';
import SignIcon from '../../components/SignIcon.astro';
import ToolGlyph from '../../components/ToolGlyph.astro';
import PlanetGlyph from '../../components/PlanetGlyph';
import LearningPath, { type LessonDecor, type StepId } from '../../islands/LearningPath';
import { SIGNS, signBySlug } from '../../lib/signs';
import { signDateRange, signTagline } from '../../lib/sign-display';
import { GLOSSARY } from '../../data/glossary';
import { resolveContextTerm } from '../../data/context-help';
import { ART, artSrc, artSrcset } from '../../lib/art';
import { HERO_CROP_SIZE, heroCropAlt, heroCropSrc, heroCropSrcset, type HeroCropName } from '../../lib/hero-crops';
import { learnTopic } from '../../lib/learn-topics';
import dailyData from '../../data/daily.json';
import type { Daily } from '../../lib/daily';

const daily = dailyData as Daily;
const skyNow = (body: string) => {
  const found = daily.bodies.find((entry) => entry.body === body);
  if (!found) throw new Error(`daily.json has no ${body}`);
  return found.sign;
};
const sunSignNow = skyNow('Sun');

const learn = await getCollection('learn', ({ data }) => !data.draft);
const guides = await getCollection('guides', ({ data }) => !data.draft);
const words = (body = '') => body.split(/\s+/).filter(Boolean).length;
/** Average reading time of a set of guides, at 200 words a minute. */
const minutesEach = (entries: { body?: string }[]) =>
  Math.max(1, Math.round(entries.reduce((sum, entry) => sum + words(entry.body), 0) / entries.length / 200));
const slugOf = (id: string) => id.split('/').pop() ?? id;

const PLANET_ORDER = ['Sun', 'Moon', 'Mercury', 'Venus', 'Mars', 'Jupiter', 'Saturn', 'Uranus', 'Neptune', 'Pluto'] as const;
// The sign each planet rules, for its disc colour (as on /learn/planets/).
const RULER_SIGN: Record<(typeof PLANET_ORDER)[number], string> = {
  Sun: 'leo', Moon: 'cancer', Mercury: 'gemini', Venus: 'taurus', Mars: 'aries',
  Jupiter: 'sagittarius', Saturn: 'capricorn', Uranus: 'aquarius', Neptune: 'pisces', Pluto: 'scorpio',
};
const PLANET_TEXT_GLYPH: Record<(typeof PLANET_ORDER)[number], string> = {
  Sun: '☉', Moon: '☽', Mercury: '☿', Venus: '♀', Mars: '♂',
  Jupiter: '♃', Saturn: '♄', Uranus: '♅', Neptune: '♆', Pluto: '♇',
};
const planetEntries = learn.filter((entry) => entry.data.kind === 'planet');
const planets = PLANET_ORDER.map((name) => {
  const entry = planetEntries.find((candidate) => candidate.data.kind === 'planet' && candidate.data.planet === name);
  if (!entry || entry.data.kind !== 'planet') throw new Error(`Missing planet guide: ${name}`);
  const role = entry.data.role;
  return { name, href: `/learn/planets/${slugOf(entry.id)}/`, role, short: role.split(',')[0], hue: `var(--sign-${RULER_SIGN[name]})` };
});

const ORDINAL = ['First', 'Second', 'Third', 'Fourth', 'Fifth', 'Sixth', 'Seventh', 'Eighth', 'Ninth', 'Tenth', 'Eleventh', 'Twelfth'];
const houseEntries = learn.filter((entry) => entry.data.kind === 'house');
const houses = houseEntries
  .flatMap((entry) => entry.data.kind === 'house' ? [{ n: entry.data.house, theme: entry.data.theme, href: `/learn/houses/${slugOf(entry.id)}/` }] : [])
  .sort((a, b) => a.n - b.n)
  .map((house) => ({ ...house, name: `${ORDINAL[house.n - 1]} house` }));
if (houses.length !== 12) throw new Error(`Expected 12 house guides, found ${houses.length}`);

const ASPECT_HUE: Record<string, string> = {
  conjunction: 'var(--ink-1)', sextile: 'var(--sign-taurus)', square: 'var(--sign-aries)', trine: 'var(--sign-cancer)', opposition: 'var(--sign-sagittarius)',
};
const aspectEntries = learn.filter((entry) => entry.data.kind === 'aspect');
const aspects = aspectEntries
  .flatMap((entry) => entry.data.kind === 'aspect' ? [{ type: entry.data.aspect, angle: entry.data.angle, theme: entry.data.theme, href: `/learn/aspects/${slugOf(entry.id)}/` }] : [])
  .sort((a, b) => a.angle - b.angle)
  .map((aspect) => ({ ...aspect, name: aspect.type.charAt(0).toUpperCase() + aspect.type.slice(1) }));

/** Two planets on a small circle, `angle` degrees apart, with the angle marked. */
function aspectDiagram(angle: number) {
  const r = 30;
  const point = (deg: number, radius = r) => {
    const rad = ((deg - 90) * Math.PI) / 180;
    return [Number((radius * Math.cos(rad)).toFixed(2)), Number((radius * Math.sin(rad)).toFixed(2))];
  };
  const spread = angle === 0 ? 14 : angle;
  const [ax, ay] = point(-spread / 2);
  const [bx, by] = point(spread / 2);
  const [arcAx, arcAy] = point(-spread / 2, 11);
  const [arcBx, arcBy] = point(spread / 2, 11);
  return { ax, ay, bx, by, arcAx, arcAy, arcBx, arcBy, large: spread > 180 ? 1 : 0, conjunction: angle === 0 };
}

const placementEntries = learn.filter((entry) => entry.data.kind === 'placement');
const risingEntries = learn.filter((entry) => entry.data.kind === 'rising');
const splitTitle = (title: string) => {
  const [name, tagline = ''] = title.split(/:\s+/);
  return { name, tagline: tagline.charAt(0).toUpperCase() + tagline.slice(1) };
};
// Examples from today's sky: where the Sun, Moon, Mercury, Venus and Mars
// stand now, and the rising sign that matches the Sun's sign.
const placementExamples = (['Sun', 'Moon', 'Mercury', 'Venus', 'Mars'] as const).map((body) => {
  const sign = skyNow(body);
  const entry = placementEntries.find((candidate) => candidate.data.kind === 'placement' && candidate.data.planet === body && candidate.data.sign === sign);
  if (!entry) throw new Error(`Missing placement guide: ${body} in ${sign}`);
  const { tagline } = splitTitle(entry.data.title);
  return { kind: 'planet' as const, body, sign, name: `${body} in ${signBySlug(sign).name}`, tagline, href: `/learn/placements/${slugOf(entry.id)}/` };
});
const risingExample = (() => {
  const entry = risingEntries.find((candidate) => candidate.data.kind === 'rising' && candidate.data.sign === sunSignNow);
  if (!entry) throw new Error(`Missing rising guide: ${sunSignNow}`);
  return { kind: 'rising' as const, sign: sunSignNow, name: `${signBySlug(sunSignNow).name} rising`, tagline: splitTitle(entry.data.title).tagline, href: `/rising-sign/${sunSignNow}/` };
})();
const placements = [...placementExamples, risingExample];

const totalGuides = learn.length + guides.length;
const LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const glossaryLetters = new Set(GLOSSARY.map((entry) => entry.term[0].toUpperCase()));
const GLOSSARY_PAGE = '/learn/glossary/';
const glossaryLetterHref = (letter: string) => `${GLOSSARY_PAGE}#letter-${letter.toLowerCase()}`;
const sampleTerms = ['cusp', 'stellium', 'retrograde'].map((slug) => {
  const entry = GLOSSARY.find((term) => term.slug === slug);
  const plain = resolveContextTerm(slug)?.plainDefinition ?? entry?.plainDefinition;
  if (!entry || !plain) throw new Error(`Missing glossary term: ${slug}`);
  return { term: entry.term, definition: plain };
});

// The cover's rendered width: the right half of the header on wide screens,
// the full column on phones, where it is the first picture on the page.
const coverSizes = '(min-width: 1240px) 600px, (min-width: 861px) 50vw, calc(100vw - 40px)';

const crop = (name: HeroCropName) => ({
  src: heroCropSrc(name, 360),
  srcset: heroCropSrcset(name),
  alt: heroCropAlt(name),
  width: HERO_CROP_SIZE.width,
  height: HERO_CROP_SIZE.height,
});
const each = (count: number, minutes: number) => `${count} guides · ${minutes} min each`;
const lessons: Partial<Record<StepId, LessonDecor>> = {
  signs: {
    art: crop('zodiac-figures'),
    minis: { discs: SIGNS.map((sign) => ({ src: `/assets/zodiac-icons/48/${sign.slug}.webp` })) },
    meta: each(guides.length, minutesEach(guides)),
  },
  planets: {
    art: crop('sun-moon'),
    minis: { glyphs: PLANET_ORDER.map((name) => `${PLANET_TEXT_GLYPH[name]}︎`) },
    meta: each(planetEntries.length, minutesEach(planetEntries)),
  },
  'planets-houses': {
    art: crop('clock-dial'),
    minis: { text: 'Twelve life areas, counted from your rising sign' },
    meta: each(houseEntries.length, minutesEach(houseEntries)),
  },
  aspects: {
    art: crop('sign-ring-hand'),
    minis: { text: aspects.map((aspect, index) => (index === 0 ? aspect.name : aspect.type)).join(', ') },
    meta: each(aspectEntries.length, minutesEach(aspectEntries)),
  },
  'big-three': {
    art: crop('sun-moon-signs'),
    minis: { text: 'Sun, Moon and rising, worked out in seconds' },
  },
};

const reads = [
  { topic: learnTopic('/learn/how-to-read-a-birth-chart/'), kicker: 'The method', action: 'Read the method', art: 'clock-hand' as HeroCropName },
  { topic: learnTopic('/learn/communication/'), kicker: 'One theme, all the way through', action: 'Read the guide', art: 'twins' as HeroCropName },
];
const planetsTopic = learnTopic('/learn/planets/');
const housesTopic = learnTopic('/learn/houses/');
const aspectsTopic = learnTopic('/learn/aspects/');
const placementsTopic = learnTopic('/learn/placements/');
const datesTopic = learnTopic('/learn/zodiac-dates/');
const glossaryTopic = learnTopic('/learn/glossary/');

const description = 'Five short lessons on the signs, planets, houses, aspects and your big three, then a library of every guide: 12 signs, 10 planets, 12 houses, 5 aspects.';

const jsonLd = [
  {
    '@type': 'CollectionPage',
    ...editorialDates('/learn/'),
    name: 'Learn astrology',
    url: 'https://zodiacs.org/learn/',
    description,
  },
  {
    '@type': 'ItemList',
    name: 'Zodiac sign guides',
    numberOfItems: 12,
    itemListElement: SIGNS.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.name,
      url: `https://zodiacs.org/${s.slug}/`,
    })),
  },
];
---
<Base
  clientUi
  type="website"
  editorialLine
  title="Learn Astrology: Zodiac Signs, Dates & the Big Three | Zodiacs.org"
  description={description}
  path="/learn/"
  image="/assets/og/v2/tool/learn.png"
  imageAlt="Learn astrology, Zodiacs.org"
  jsonLd={jsonLd}
>
  <header class="lhero">
    <div class="kwrap lhero__grid">
      <div class="lhero__copy">
        <span class="kicker">Learn astrology</span>
        <h1 class="display">What does your chart say about you?</h1>
        <p class="klede">Short guides to the signs, planets, houses and aspects. Start with five lessons, then read your own chart.</p>
        <div class="btn-row">
          <a class="btn btn--primary btn--lg" href="#start"><span>Start with lesson one</span><span class="orb" aria-hidden="true">↓</span></a>
          <a class="textlink" href="/birth-chart/">Or get your free birth chart <span class="arr" aria-hidden="true">→</span></a>
        </div>
        <p class="kfacts lhero__facts"><span>{totalGuides} short guides</span><span class="lhero__hide-m">{GLOSSARY.length} glossary terms</span><span>Free, no signup</span></p>
      </div>
      <figure class="lhero__cover">
        <div class="lhero__art">
          <picture>
            <source type="image/avif" srcset={artSrcset('learn-atlas', 'avif')} sizes={coverSizes} />
            <img
              src={artSrc('learn-atlas')}
              srcset={artSrcset('learn-atlas')}
              sizes={coverSizes}
              width={ART['learn-atlas'].width}
              height={ART['learn-atlas'].height}
              alt="An open star atlas painted with the constellation figures, beside a brass armillary sphere"
              loading="eager"
              fetchpriority="high"
            />
          </picture>
        </div>
        <figcaption>An open star atlas, its pages painted with the zodiac constellations.</figcaption>
      </figure>
    </div>
  </header>

  <section class="learn-start" id="start">
    <div class="kwrap">
      <LearningPath client:load lessons={lessons}>
        <div class="path-end">
          <span class="path-end__trio" aria-hidden="true">
            <span style="--sign:var(--sign-leo)"><ToolGlyph kind="sun" /></span>
            <span style="--sign:var(--sign-cancer)"><ToolGlyph kind="moon" /></span>
            <span style="--sign:var(--sign-libra)"><ToolGlyph kind="rising" /></span>
          </span>
          <div>
            <h3>Then read your own chart</h3>
            <p>Your Sun, Moon, rising, planets, houses and aspects, worked out from your birth date, time and place. Calculated privately in your browser.</p>
          </div>
          <a class="btn btn--primary" href="/birth-chart/"><span>Get your free birth chart</span><span class="orb" aria-hidden="true">↗</span></a>
        </div>
      </LearningPath>
    </div>
  </section>

  <section class="kwrap library" id="library" aria-labelledby="library-title">
    <div class="lib-head">
      <div>
        <h2 class="h-1" id="library-title">The library</h2>
        <p>Every guide on Zodiacs, grouped the way a chart is read. Pick up anywhere.</p>
      </div>
      <nav class="lib-toc" aria-label="Library sections">
        <a class="pill" href="#signs">Signs</a>
        <a class="pill" href="#planets">Planets</a>
        <a class="pill" href="#houses">Houses</a>
        <a class="pill" href="#aspects">Aspects</a>
        <a class="pill" href="#placements">Placements</a>
        <a class="pill" href="#reads">Longer reads</a>
        <a class="pill" href="#glossary">Glossary</a>
      </nav>
    </div>

    <div class="grp" id="signs">
      <div class="grp__head">
        <h3 class="h-3">The twelve signs</h3>
        <p>Every guide covers personality, love, strengths, myth and history, and what the sign means as your Sun, Moon or rising.</p>
        <div class="grp__links">
          <a class="textlink" href={datesTopic.route} title={datesTopic.title}>Dates, elements and rulers <span class="arr" aria-hidden="true">→</span></a>
          <a class="textlink" href="/birthday/">Born near a sign change? <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </div>
      <ul class="signs" role="list">
        {SIGNS.map((sign) => {
          const now = sign.slug === sunSignNow;
          return (
            <li>
              <a class:list={['st', now && 'is-now']} href={`/${sign.slug}/`} style={`--sign:${sign.hue}`}>
                <SignIcon sign={sign.slug} size={44} />
                <span>
                  <b>{sign.name}</b>
                  <small>{now ? 'Sun is here now' : signDateRange(sign)}</small>
                  <span class="st__line">{signTagline(sign)}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <div class="grp" id="planets">
      <div class="grp__head">
        <h3 class="h-3">{planetsTopic.title}</h3>
        <p>{planetsTopic.description}</p>
        <p class="kfacts"><span>{planets.length} guides</span><span>About {minutesEach(planetEntries)} minutes each</span></p>
        <div class="grp__links"><a class="textlink" href={planetsTopic.route}>All planet guides <span class="arr" aria-hidden="true">→</span></a></div>
      </div>
      <ul class="plist" role="list">
        {planets.map((planet) => (
          <li>
            <a href={planet.href}>
              <PlanetGlyph body={planet.name} size={20} disc hue={planet.hue} class="plist__glyph" />
              <span><b>{planet.name}</b><span class="long">{planet.role}</span><span class="short">{planet.short}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="grp" id="houses">
      <div class="grp__head">
        <h3 class="h-3">{housesTopic.title}</h3>
        <p>{housesTopic.description}</p>
        <svg class="hwheel" viewBox="-116 -116 232 232" role="img" aria-label="The twelve houses around a chart wheel, counted from the rising sign on the left">
          <circle r="104" fill="#0F121A" stroke="rgba(198,204,218,0.22)" />
          <path d="M-104,0 A104,104 0 0 0 -90.07,52 L-43.3,25 A50,50 0 0 1 -50,0 Z" fill="var(--sign-aquarius)" fill-opacity="0.22" />
          {houses.map((house) => {
            // Houses run counter-clockwise from the ascendant on the left.
            const start = 180 + (house.n - 1) * 30;
            const rad = (deg: number) => (deg * Math.PI) / 180;
            const mid = rad(start + 15);
            const edge = rad(start);
            const strong = house.n === 1 || house.n === 4 || house.n === 7 || house.n === 10;
            return (
              <>
                <line x1={(50 * Math.cos(edge)).toFixed(2)} y1={(-50 * Math.sin(edge)).toFixed(2)} x2={(104 * Math.cos(edge)).toFixed(2)} y2={(-104 * Math.sin(edge)).toFixed(2)} stroke={strong ? 'rgba(198,204,218,0.3)' : 'rgba(198,204,218,0.14)'} />
                <text x={(77 * Math.cos(mid)).toFixed(2)} y={(-77 * Math.sin(mid)).toFixed(2)} text-anchor="middle" dominant-baseline="central" font-family="EB Garamond, serif" font-size="15" fill={house.n === 1 ? '#EEF1F7' : 'rgba(198,204,218,0.62)'}>{house.n}</text>
              </>
            );
          })}
          <circle r="50" fill="#0A0C11" stroke="rgba(198,204,218,0.18)" />
          <line x1="-112" y1="0" x2="-50" y2="0" stroke="rgba(238,241,247,0.7)" stroke-width="1.2" />
          <text x="-108" y="-7" font-family="Instrument Sans, sans-serif" font-size="9" font-weight="600" fill="rgba(238,241,247,0.75)">ASC</text>
          <text x="0" y="1" text-anchor="middle" dominant-baseline="central" font-family="EB Garamond, serif" font-style="italic" font-size="14" fill="rgba(198,204,218,0.6)">you</text>
        </svg>
        <div class="grp__links"><a class="textlink" href={housesTopic.route}>All house guides <span class="arr" aria-hidden="true">→</span></a></div>
      </div>
      <ul class="hlist" role="list">
        {houses.map((house) => (
          <li>
            <a href={house.href}>
              <span class="hn" aria-hidden="true">{house.n}</span>
              <span><b>{house.name}</b><span class="long">{house.theme}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="grp" id="aspects">
      <div class="grp__head">
        <h3 class="h-3">{aspectsTopic.title}</h3>
        <p>{aspectsTopic.description}</p>
        <div class="grp__links"><a class="textlink" href={aspectsTopic.route}>All aspect guides <span class="arr" aria-hidden="true">→</span></a></div>
      </div>
      <ul class="asps" role="list">
        {aspects.map((aspect) => {
          const d = aspectDiagram(aspect.angle);
          return (
            <li>
              <a class="asp" href={aspect.href} style={`--asp:${ASPECT_HUE[aspect.type] ?? 'var(--ink-1)'}`}>
                <svg viewBox="-42 -42 84 84" aria-hidden="true">
                  <circle r="30" fill="none" stroke="rgba(198,204,218,0.22)" />
                  {d.conjunction ? (
                    <>
                      <line x1="0" y1="0" x2="0" y2="-30" stroke="var(--asp)" stroke-width="1.5" />
                      <circle cx="0" cy="-30" r="11" fill="var(--asp)" fill-opacity="0.18" />
                    </>
                  ) : (
                    <>
                      <path d={`M0,0 L${d.arcAx},${d.arcAy} A11,11 0 ${d.large} 1 ${d.arcBx},${d.arcBy} Z`} fill="var(--asp)" fill-opacity="0.22" />
                      <path d={`M${d.arcAx},${d.arcAy} A11,11 0 ${d.large} 1 ${d.arcBx},${d.arcBy}`} stroke="var(--asp)" stroke-width="1.6" fill="none" />
                      <line x1="0" y1="0" x2={d.ax} y2={d.ay} stroke="var(--asp)" stroke-width="1.5" />
                      <line x1="0" y1="0" x2={d.bx} y2={d.by} stroke="var(--asp)" stroke-width="1.5" />
                    </>
                  )}
                  <circle r="2.2" fill="rgba(238,241,247,0.7)" />
                  <circle cx={d.ax} cy={d.ay} r="4.6" fill="#EEF1F7" stroke="#060709" stroke-width="1.4" />
                  <circle cx={d.bx} cy={d.by} r="4.6" fill="#EEF1F7" stroke="#060709" stroke-width="1.4" />
                </svg>
                <span><b>{aspect.name}</b><span class="deg">{aspect.angle}°</span><span class="t">{aspect.theme}</span></span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <div class="grp" id="placements">
      <div class="grp__head">
        <h3 class="h-3">{placementsTopic.title}</h3>
        <p>{placementsTopic.description}</p>
        <p class="kfacts"><span>{placementEntries.length} placements</span><span>{risingEntries.length} rising signs</span></p>
        <div class="grp__links"><a class="textlink" href={placementsTopic.route}>Browse all placements <span class="arr" aria-hidden="true">→</span></a></div>
      </div>
      <ul class="plcs" role="list">
        {placements.map((item) => (
          <li>
            <a class="plc" href={item.href}>
              <span class="plc__pair" aria-hidden="true">
                {item.kind === 'planet'
                  ? <PlanetGlyph body={item.body} size={18} disc hue={`var(--sign-${RULER_SIGN[item.body]})`} class="plc__glyph" />
                  : <span class="plc__asc" style="--sign:var(--void-3)"><ToolGlyph kind="rising" /></span>}
                <SignIcon sign={item.sign} size={40} />
              </span>
              <span><b>{item.name}</b><span>{item.tagline}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="grp" id="reads">
      <div class="grp__head">
        <h3 class="h-3">Longer reads</h3>
        <p>Two guides to sit with: the method for reading any chart, and one theme followed all the way through it.</p>
      </div>
      <div class="reads">
        {reads.map((read) => (
          <a class="rd" href={read.topic.route}>
            <figure class="rd__art">
              <img
                src={heroCropSrc(read.art, 560)}
                srcset={heroCropSrcset(read.art)}
                sizes="(max-width: 760px) 104px, 420px"
                width={HERO_CROP_SIZE.width}
                height={HERO_CROP_SIZE.height}
                alt={heroCropAlt(read.art)}
                loading="lazy"
                decoding="async"
              />
            </figure>
            <span class="rd__body">
              <span class="kicker">{read.kicker}</span>
              <span class="h-3 rd__title">{read.topic.title}</span>
              <span class="rd__text">{read.topic.description}</span>
              <span class="textlink">{read.action} <span class="arr" aria-hidden="true">→</span></span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <div class="grp" id="glossary">
      <div class="grp__head">
        <h3 class="h-3">{glossaryTopic.title}</h3>
        <p>{glossaryTopic.description}</p>
        <p class="kfacts"><span>{GLOSSARY.length} terms</span><span>A to Z</span></p>
        <div class="grp__links"><a class="textlink" href={glossaryTopic.route}>Open the glossary <span class="arr" aria-hidden="true">→</span></a></div>
      </div>
      <div>
        <div class="az" role="group" aria-label="Glossary by letter">
          {LETTERS.map((letter) => glossaryLetters.has(letter)
