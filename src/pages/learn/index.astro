---
import { editorialDates } from '../../lib/editorial-metadata.mjs';
import Base from '../../layouts/Base.astro';
import AskGuideLine from '../../components/AskGuideLine.astro';
import SignIcon from '../../components/SignIcon.astro';
import ToolGlyph from '../../components/ToolGlyph.astro';
import LearningPath from '../../islands/LearningPath';
import { SIGNS, ELEMENT_LABEL, MODALITY_LABEL } from '../../lib/signs';
import { GLOSSARY } from '../../data/glossary';

const jsonLd = [
  {
    '@type': 'CollectionPage',
    ...editorialDates('/learn/'),
    name: 'Learn astrology',
    url: 'https://zodiacs.org/learn/',
    description: 'Zodiac sign guides, the big three, and the full table of zodiac dates, elements, and rulers.',
  },
  {
    '@type': 'ItemList',
    name: 'Zodiac sign guides',
    numberOfItems: 12,
    itemListElement: SIGNS.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.name,
      url: `https://zodiacs.org/${s.slug}/`,
    })),
  },
];
---
<Base
  clientUi
  type="website"
  editorialLine
  title="Learn Astrology: Zodiac Signs, Dates & the Big Three | Zodiacs.org"
  description="All 12 zodiac sign guides, the sun-moon-rising big three explained, and the full table of zodiac dates, elements, and rulers."
  path="/learn/"
  image="/assets/og/v2/tool/learn.png"
  imageAlt="Learn astrology, Zodiacs.org"
  jsonLd={jsonLd}
>
  <section class="section--tight container learn-intro">
    <div class="section-head reveal">
      <h1 class="display learn-lede">What does your chart say about you?</h1>
      <p>
        Learn the basics, then read your own chart, one clear step at a time.
      </p>
    </div>
  </section>

  <section class="section--tight container learn-path-section">
    <LearningPath client:load />
  </section>

  <section class="section--tight container" id="big-three">
    <div class="bigthree reveal">
      <h2>The big three, in sixty seconds</h2>
      <div class="bigthree__grid">
        <div class="bigthree__item" style="--sign:var(--sign-leo)">
          <span class="bigthree__head"><ToolGlyph kind="sun" /><span class="mono--label">Sun</span></span>
          <p><strong>Who you are.</strong> Your core identity and engine, the sign everyone already asks about. Set by your birth <em>date</em>.</p>
        </div>
        <div class="bigthree__item" style="--sign:var(--sign-cancer)">
          <span class="bigthree__head"><ToolGlyph kind="moon" /><span class="mono--label">Moon</span></span>
          <p><strong>How you feel.</strong> Your emotional weather, comforts, and needs. Changes sign every ~2.5 days. <a href="/moon-sign/">Find yours</a>.</p>
        </div>
        <div class="bigthree__item" style="--sign:var(--sign-aries)">
          <span class="bigthree__head"><ToolGlyph kind="rising" /><span class="mono--label">Rising</span></span>
          <p><strong>How people first read you.</strong> The sign on the eastern horizon at your birth. Needs your birth time. <a href="/rising-sign/">Calculate it</a>.</p>
        </div>
      </div>
      <a class="btn btn--primary" href="/birth-chart/"><span>Get all three at once</span><span class="orb">↗</span></a>
    </div>
  </section>

  <section class="section container" id="signs">
    <div class="section-head reveal">
      <h2>The twelve signs</h2>
      <p>Every guide covers personality, love, strengths, myth and history, and what the sign means as your sun, moon, or rising.</p>
    </div>
    <div class="learn-grid">
      {SIGNS.map((s, i) => (
        <a class="shell reveal" href={`/${s.slug}/`} style={`--sign:${s.hue};--reveal-delay:${(i % 4) * 60}ms`}>
          <div class="core tinted learn-card">
            <SignIcon sign={s.slug} size={64} />
            <div>
              <strong>{s.name}</strong>
              <span class="mono learn-card__dates">{s.dates}</span>
              <p>{s.essence}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section--tight container">
    <div class="section-head reveal">
      <h2>Go deeper</h2>
      <p>The rest of the chart, cluster by cluster.</p>
    </div>
    <div class="clusters reveal">
      <a class="tile clusters__card" href="/learn/how-to-read-a-birth-chart/">
        <strong>How to read a chart</strong>
        <p>The four-step method: big three, planets by house, aspects, then the weather.</p>
        <span class="clusters__count mono">the method →</span>
      </a>
      <a class="tile clusters__card" href="/learn/communication/">
        <strong>Communication</strong>
        <p>How you think, what a conversation needs to feel like, and how you handle friction, read from Mercury, the Moon, and Mars in your birth chart.</p>
        <span class="clusters__count mono">the guide →</span>
      </a>
      <a class="tile clusters__card" href="/learn/planets/">
        <strong>The planets</strong>
        <p>Ten planets, ten jobs, from the Sun’s identity to Pluto’s slow excavations.</p>
        <span class="clusters__count mono">10 guides →</span>
      </a>
      <a class="tile clusters__card" href="/learn/houses/">
        <strong>The houses</strong>
        <p>Life’s floor plan: money, home, work, partnership, reputation, solitude.</p>
        <span class="clusters__count mono">12 guides →</span>
      </a>
      <a class="tile clusters__card" href="/learn/aspects/">
        <strong>The aspects</strong>
        <p>The angles between planets, the chart’s wiring, friendly and otherwise.</p>
        <span class="clusters__count mono">5 guides →</span>
      </a>
      <a class="tile clusters__card" href="/learn/placements/">
        <strong>The placements</strong>
        <p>Every planet in every sign, how each combination actually behaves.</p>
        <span class="clusters__count mono">120 guides →</span>
      </a>
      <a class="tile clusters__card" href="/learn/zodiac-dates/">
        <strong>The living correspondence chart</strong>
        <p>All twelve signs, exact longitude boundaries, and year-exact Sun ingress instants.</p>
        <span class="clusters__count mono">table + CSV →</span>
      </a>
      <a class="tile clusters__card" href="/learn/glossary/">
        <strong>The astrology glossary</strong>
        <p>The words used across the site, defined against the chart and timing calculations.</p>
        <span class="clusters__count mono">{GLOSSARY.length} terms · A to Z →</span>
      </a>
    </div>
  </section>

  <section class="section--tight container">
    <div class="section-head reveal">
      <h2>Zodiac dates, elements &amp; rulers</h2>
      <p>The whole system on one table. Dates shift by a day some years. Born on a boundary? <a href="/birth-chart/">Compute it exactly</a>, or <a href="/birthday/">look up your exact birthday</a>: every date has its own page, with year-by-year cusp tables where they matter.</p>
    </div>
    <div class="table-wrap reveal">
      <table class="dates-table">
        <thead>
          <tr><th>Sign</th><th>Dates</th><th>Element</th><th>Modality</th><th>Ruler</th></tr>
        </thead>
        <tbody>
          {SIGNS.map((s) => (
            <tr style={`--sign:${s.hue}`}>
              <td><a href={`/${s.slug}/`}><SignIcon sign={s.slug} size={20} /> {s.name}</a></td>
              <td class="mono">{s.dates}</td>
              <td>{ELEMENT_LABEL[s.element]}</td>
              <td>{MODALITY_LABEL[s.modality]}</td>
              <td>{s.ruler}{s.classicRuler ? ` (${s.classicRuler})` : ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="learn-note reveal">
      Curious how any of this is computed? The math is public:{' '}
      <a href="/methodology/">how we compute your chart</a>.
    </p>
    <div class="learn-note reveal">
      <AskGuideLine lead="Stuck on a term, or wondering how a piece fits your own chart?" />
    </div>
  </section>
</Base>

<style is:global>
  .learning-path__practice { margin-block: 12px 20px; }
  .learning-path__practice > summary { min-height: 44px; display: flex; align-items: center; cursor: pointer; color: var(--text-2); font-size: 14px; gap: 8px; }
  .learning-path__practice > summary::before { content: "+"; }
  .learning-path__practice[open] > summary::before { content: "−"; }
  .learn-lede {
    margin: 0;
    font-size: var(--text-xl);
    line-height: 1.1;
  }
  .learn-intro { padding-bottom: clamp(24px, 3vw, 40px); }
  .learn-intro .section-head { max-width: 50ch; margin-bottom: 0; }
  .learn-path-section { padding-top: 0; }
  .bigthree {
    border: 1px solid var(--hair-1);
    border-radius: var(--r-lg);
    background: var(--void-1);
    padding: clamp(22px, 4vw, 36px);
  }
  .bigthree h2 { margin: 0 0 20px; font-size: var(--text-xl); font-weight: 620; letter-spacing: -0.02em; }
  .bigthree__grid { display: grid; gap: 18px; grid-template-columns: 1fr; margin-bottom: 24px; }
  @media (min-width: 760px) { .bigthree__grid { grid-template-columns: repeat(3, 1fr); } }
  .bigthree__head { display: inline-flex; align-items: center; gap: 11px; }
  .bigthree__head .mono--label { color: var(--text-2); }
  .bigthree__head :global(.tool-glyph) { width: 40px; height: 40px; }
  .bigthree__item p { margin: 10px 0 0; font-size: var(--text-sm); color: var(--text-2); line-height: 1.6; }
  .bigthree__item strong { color: var(--text); }
  .bigthree__item a { color: var(--text); }

  .learning-path { --path-accent: var(--sign-cancer); }
  .learning-path__core {
    padding: clamp(22px, 4vw, 36px);
    /* Keep real lesson controls beside the fixed Guide, at every scroll
       position. The centered page gutter supplies this room on wide screens. */
    padding-right: max(clamp(22px, 4vw, 36px), calc(50% - 50vw + 136px + env(safe-area-inset-right)));
  }
  @media (max-width: 560px) {
    /* Guide is a 48px circle here, so the reading column can stay wider. */
    .learning-path__core { padding-right: max(clamp(22px, 4vw, 36px), calc(50% - 50vw + 72px + env(safe-area-inset-right))); }
  }
  .learning-path__head {
    display: grid;
    gap: 20px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--hair-1);
  }
  @media (min-width: 720px) {
    .learning-path__head { grid-template-columns: minmax(0, 1fr) 190px; align-items: end; }
  }
  .learning-path__head h2 { margin: 8px 0 6px; font-size: var(--text-xl); font-weight: 620; letter-spacing: -0.02em; }
  .learning-path__head p { margin: 0; color: var(--muted); font-size: var(--text-sm); }
  .learning-path__head .learning-path__note { margin-top: 10px; font-size: 12px; }
  .learning-path__progress { display: grid; gap: 8px; color: var(--text-2); font-size: 12px; }
  .learning-path__progress > span { justify-self: end; }
  .learning-path__bar { height: 4px; overflow: hidden; border-radius: var(--r-full); background: var(--hair-2); }
  .learning-path__bar > span { display: block; height: 100%; border-radius: inherit; background: var(--path-accent); transition: width 240ms cubic-bezier(0.22, 1, 0.36, 1); }
  .learning-path__complete {
    display: grid;
    gap: 3px;
    margin-top: 18px;
    padding: 14px 16px;
    border: 1px solid color-mix(in oklab, var(--sign-taurus) 35%, transparent);
    border-radius: var(--r-sm);
    background: color-mix(in oklab, var(--sign-taurus) 6%, var(--void-1));
  }
  .learning-path__complete span { color: var(--muted); font-size: var(--text-sm); }
  .learning-path__steps { display: grid; margin: 0; padding: 0; list-style: none; }
  .learning-step {
    position: relative;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 12px 14px;
    align-items: start;
    padding: 20px 0;
    border-bottom: 1px solid var(--hair-1);
  }
  @media (min-width: 720px) {
    .learning-step { grid-template-columns: 44px minmax(0, 1fr) auto; align-items: center; }
  }
  .learning-step__check {
    width: 44px;
    height: 44px;
    border: 1px solid var(--hair-2);
    border-radius: 50%;
    background: var(--void-0);
    color: var(--muted);
    font: 600 12px/1 var(--font-sans);
    cursor: pointer;
    transition: border-color 180ms cubic-bezier(0.22, 1, 0.36, 1), transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    button.learning-step__check:hover { border-color: var(--ink-1); }
  }
  button.learning-step__check:active { transform: scale(0.96); }
  .learning-step__check--status { display: grid; place-items: center; cursor: default; }
  .learning-step__check:focus-visible,
  .learning-path__restart:focus-visible { outline: 2px solid var(--ink-0); outline-offset: 3px; }
  .learning-step--active .learning-step__check { border-color: var(--path-accent); color: var(--text); box-shadow: 0 0 0 4px color-mix(in oklab, var(--path-accent) 12%, transparent); }
  .learning-step--active::before {
    content: '';
    position: absolute;
    inset-block: 14px;
    left: -14px;
    width: 2px;
    border-radius: var(--r-full);
    background: var(--path-accent);
  }
  .learning-step--active .learning-step__eyebrow { color: color-mix(in oklab, var(--path-accent) 72%, var(--text)); }
  .learning-step--done .learning-step__check { border-color: var(--sign-taurus); background: color-mix(in oklab, var(--sign-taurus) 14%, var(--void-0)); color: var(--text); }
  .learning-step__eyebrow { display: block; margin-bottom: 3px; color: var(--faint); font-size: 12px; letter-spacing: 0; }
  .learning-step__copy h3 { margin: 0; color: var(--text); font-size: var(--text-lg); letter-spacing: -0.015em; }
  .learning-step__copy p { margin: 5px 0 0; max-width: 61ch; color: var(--text-2); font-size: var(--text-sm); line-height: 1.55; }
  .learning-step__copy .learning-step__why {
    margin-top: 9px;
    padding-left: 10px;
    border-left: 1px solid color-mix(in oklab, var(--path-accent) 38%, var(--hair-2));
    color: var(--muted);
    font-size: 12px;
  }
  .learning-step__why strong { color: var(--text-2); font-weight: 650; }
  .learning-step__reflection { display: flex; gap: 10px; align-items: flex-start; min-height: 44px; margin-top: 12px; padding-block: 10px; color: var(--text-2); font-size: 12px; line-height: 1.5; cursor: pointer; }
  .learning-step__reflection input { flex: 0 0 auto; width: 18px; height: 18px; margin: 0; accent-color: var(--path-accent); }
  .learning-step__reflection input:focus-visible { outline: 2px solid var(--ink-0); outline-offset: 3px; }
  .learning-step__action-wrap {
    grid-column: 2;
    display: grid;
    gap: 7px;
    justify-items: start;
    justify-self: start;
  }
  .learning-step__next-cue {
    color: color-mix(in oklab, var(--path-accent) 74%, var(--text));
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1;
  }
  .learning-step__action { white-space: nowrap; }
  @media (max-width: 719.5px) {
    .learning-step__action-wrap { width: 100%; }
    .learning-step__action { box-sizing: border-box; width: 100%; max-width: 100%; justify-content: space-between; white-space: normal; }
    .learning-step__action span:first-child { min-width: 0; }
  }
  @media (min-width: 720px) {
    .learning-step__action-wrap { grid-column: auto; justify-items: end; justify-self: end; }
  }
  .learning-path__restart { min-height: 44px; margin-top: 18px; padding: 4px 0; border: 0; background: none; color: var(--muted); font: 500 12px/1.4 var(--font-sans); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .learning-path__restart:hover { color: var(--text); }
  @media (prefers-reduced-motion: reduce) {
    button.learning-step__check:active { transform: none; }
  }

  .learn-grid { display: grid; gap: 12px; grid-template-columns: 1fr; }
  @media (min-width: 680px) { .learn-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1020px) { .learn-grid { grid-template-columns: repeat(4, 1fr); } }
  .learn-card { display: flex; gap: 14px; padding: 18px; align-items: flex-start; }
  .learn-card strong { display: block; font-size: 15px; color: var(--text); }
  .learn-card__dates { display: block; margin: 2px 0 6px; font-size: 10px; color: var(--faint); letter-spacing: 0.05em; }
  .learn-card p { margin: 0; font-size: 12.5px; color: var(--text-2); line-height: 1.5; }

  .table-wrap { overflow-x: auto; }
  .dates-table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  .dates-table th {
    text-align: left;
    padding: 10px 16px 10px 0;
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 0;
    font-weight: 500;
    color: var(--faint);
    border-bottom: 1px solid var(--hair-2);
  }
  .dates-table td { padding: 10px 16px 10px 0; border-bottom: 1px solid var(--hair-1); color: var(--text-2); white-space: nowrap; }
  .dates-table td a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
    font-weight: 550;
    text-decoration: none;
  }
  .dates-table td a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .learn-note { margin-top: 18px; font-size: var(--text-sm); color: var(--muted); }
  .learn-note a { color: var(--text); }

  .clusters { display: grid; gap: 12px; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .clusters { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1020px) { .clusters { grid-template-columns: repeat(4, 1fr); } }
  .clusters__card {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 20px;
    text-decoration: none;
    color: var(--text);
  }
  .clusters__card strong { font-size: var(--text-lg); letter-spacing: -0.015em; }
  .clusters__card p { margin: 0; font-size: var(--text-sm); color: var(--text-2); line-height: 1.6; }
  .clusters__count { font-size: 10.5px; color: var(--faint); letter-spacing: 0.08em; margin-top: 4px; }
  @media (prefers-reduced-motion: reduce) {
    .learning-path__bar > span,
    .learning-step__check { transition: none; }
  }
</style>
