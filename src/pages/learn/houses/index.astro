---
import { getCollection } from 'astro:content';
import { editorialDates } from '../../../lib/editorial-metadata.mjs';
import Base from '../../../layouts/Base.astro';
import { SIGNS } from '../../../lib/signs';
import '../../../styles/cluster.css';

const ORDINALS = [
  'First', 'Second', 'Third', 'Fourth', 'Fifth', 'Sixth',
  'Seventh', 'Eighth', 'Ninth', 'Tenth', 'Eleventh', 'Twelfth',
];

const entries = await getCollection('learn', (e) => e.data.kind === 'house' && !e.data.draft);
const houses = Array.from({ length: 12 }, (_, i) => {
  const entry = entries.find((e) => e.data.kind === 'house' && e.data.house === i + 1);
  if (!entry) throw new Error(`Missing house page: ${i + 1}`);
  return {
    n: i + 1,
    slug: entry.id.split('/')[1],
    theme: entry.data.kind === 'house' ? entry.data.theme : '',
  };
});

const jsonLd = [
  {
    '@type': 'CollectionPage',
    ...editorialDates('/learn/houses/'),
    name: 'The twelve houses in astrology',
    url: 'https://zodiacs.org/learn/houses/',
    description: 'What the twelve houses of a birth chart mean, from self to solitude, each explained plainly.',
  },
  {
    '@type': 'ItemList',
    numberOfItems: 12,
    itemListElement: houses.map((h) => ({
      '@type': 'ListItem',
      position: h.n,
      name: `The ${ORDINALS[h.n - 1].toLowerCase()} house`,
      url: `https://zodiacs.org/learn/houses/${h.slug}/`,
    })),
  },
];
---
<Base
  type="website"
  editorialLine
  title="The 12 Houses in Astrology | What Each One Means | Zodiacs.org"
  description="The twelve houses of a birth chart explained plainly: money, home, work, partnership, career, and the rest of life's floor plan, house by house."
  path="/learn/houses/"
  jsonLd={jsonLd}
>
  <section class="section--tight container container--narrow">
    <div class="cluster-hero reveal">
      <a class="crumb" href="/learn/"><span class="crumb__arrow" aria-hidden="true">←</span>Learn</a>
      <h1 class="display">The twelve houses</h1>
      <p>
        Houses divide a <a href="/learn/glossary/#birth-chart">birth chart</a> into twelve areas of life. In quadrant systems such as Placidus, the first-house cusp is the exact <a href="/learn/glossary/#ascendant">ascendant</a> degree. In <a href="/learn/glossary/#whole-sign-houses">whole-sign houses</a>, the ascendant’s entire sign is the first house and the angle sits somewhere inside it. That house concerns self and approach; the sequence then
        moves through money, siblings, home, creativity, work, partnership,
        shared resources, belief, reputation, community, and retreat. <a href="/learn/glossary/#planet">Planets</a>{' '}
        describe what is happening, <a href="/learn/glossary/#zodiac-sign">signs</a> describe how, and houses locate the
        action. A Venus placement can therefore speak about partnership,
        career, family, or something else entirely depending on the house it
        occupies. Unlike the planets’ zodiac positions, houses depend on an
        accurate birth time and place because the horizon turns through the
        whole zodiac each day. The guides below explain each house’s territory,
        its opposing house, and the questions it tends to raise. They use the
        traditional first-through-twelfth order without pretending that one
        house is luckier, more important, or more difficult than the rest. Read
        them as a connected wheel: every house answers, balances, or challenges
        the one directly across from it.
      </p>
    </div>

    <ol class="cluster-list reveal">
      {houses.map((h) => (
        <li>
          <a class="cluster-row" href={`/learn/houses/${h.slug}/`}>
            <span class="cluster-row__num house-badge" style={`--sign:${SIGNS[h.n - 1].hue}`}>{h.n}</span>
            <span class="cluster-row__name">{ORDINALS[h.n - 1]} house</span>
            <span class="cluster-row__role">{h.theme}</span>
            <span class="cluster-row__go">→</span>
          </a>
        </li>
      ))}
    </ol>

    <p class="cluster-note reveal">
      Houses need your birth time. <a href="/birth-chart/">Run your chart</a>{' '}
      to see all twelve populated. Or continue with{' '}
      <a href="/learn/planets/">the planets</a> and{' '}
      <a href="/learn/aspects/">the aspects</a>.
    </p>
  </section>
</Base>
