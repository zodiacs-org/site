---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Faq from '../../../components/Faq.astro';
import HouseWheel from '../../../components/HouseWheel.astro';
import { SIGNS } from '../../../lib/signs';
import { EDITOR_AUTHOR } from '../../../lib/editorial';

const HOUSE_SLUGS = [
  'first-house', 'second-house', 'third-house', 'fourth-house',
  'fifth-house', 'sixth-house', 'seventh-house', 'eighth-house',
  'ninth-house', 'tenth-house', 'eleventh-house', 'twelfth-house',
] as const;

const ORDINALS = [
  'first', 'second', 'third', 'fourth', 'fifth', 'sixth',
  'seventh', 'eighth', 'ninth', 'tenth', 'eleventh', 'twelfth',
];

export async function getStaticPaths() {
  const entries = await getCollection(
    'learn',
    (e) => e.data.kind === 'house' && !e.data.draft,
  );
  if (entries.length !== 12) {
    throw new Error(`Expected 12 house pages, found ${entries.length}`);
  }
  return entries.map((entry) => ({
    params: { slug: entry.id.split('/')[1] },
    props: { entry },
  }));
}

const { entry } = Astro.props;
if (entry.data.kind !== 'house') throw new Error('Not a house entry');
const n = entry.data.house;
const slug = entry.id.split('/')[1];
const { Content } = await render(entry);

// The sequential palette keeps the wheel visually indexed; it is not a claim
// that the nth sign rules or determines the nth house.
const houseHue = SIGNS[n - 1].hue;
const prevSlug = n > 1 ? HOUSE_SLUGS[n - 2] : null;
const nextSlug = n < 12 ? HOUSE_SLUGS[n] : null;

const jsonLd = [
  {
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    url: `https://zodiacs.org/learn/houses/${slug}/`,
    datePublished: entry.data.published.toISOString(),
    dateModified: entry.data.updated.toISOString(),
    author: EDITOR_AUTHOR,
    publisher: { '@id': 'https://zodiacs.org/#org' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://zodiacs.org/learn/houses/${slug}/` },
    inLanguage: 'en',
    about: { '@type': 'Thing', name: `${ORDINALS[n - 1]} house (astrology)` },
    citation: entry.data.sources.map((source) => source.href
      ? { '@type': 'CreativeWork', name: source.label, url: source.href }
      : source.label),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Learn', item: 'https://zodiacs.org/learn/' },
      { '@type': 'ListItem', position: 3, name: 'The houses', item: 'https://zodiacs.org/learn/houses/' },
      { '@type': 'ListItem', position: 4, name: `The ${ORDINALS[n - 1]} house`, item: `https://zodiacs.org/learn/houses/${slug}/` },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: entry.data.faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title={entry.data.title}
  description={entry.data.description}
  path={`/learn/houses/${slug}/`}
  type="article"
  jsonLd={jsonLd}
  sources={entry.data.sources}
>
  <article class="container container--narrow learn-detail">
    <header class="learn-detail__hero learn-detail__hero--figured reveal">
      <div class="learn-detail__heroText">
      <a class="crumb" href="/learn/houses/"><span class="crumb__arrow" aria-hidden="true">←</span>The houses</a>
      <span class="learn-hero-glyph house-badge" style={`--sign:${houseHue}`} aria-hidden="true">{n}</span>
      <h1 id={slug} class="display">The {ORDINALS[n - 1]} house</h1>
      <p class="learn-detail__role">{entry.data.theme}</p>
      <p class="learn-detail__facts mono">
        House {n} of 12
        {n === 1 && ' · horizon angle: ascendant'}
        {n === 7 && ' · horizon angle: descendant'}
        {n === 10 && ' · associated angle: midheaven (MC)'}
      </p>
      </div>
      <HouseWheel house={n} hue={houseHue} size={232} class="learn-detail__figure" />
    </header>

    <div class="prose reveal">
      <Content />
    </div>

    <section class="reveal">
      <Faq items={entry.data.faq} heading="Asked and answered" />
    </section>

    <div class="learn-detail__cta shell tinted reveal">
      <div class="core tinted learn-detail__cta-core">
        <strong>What lands in your {ORDINALS[n - 1]} house?</strong>
        <p>Houses come from your birth time and place — the chart calculator computes all twelve and every planet in them.</p>
        <a class="btn btn--primary" href="/birth-chart/"><span>Get your free birth chart</span><span class="orb">↗</span></a>
      </div>
    </div>

    <nav class="learn-detail__nav reveal" aria-label="More houses">
      {prevSlug ? <a href={`/learn/houses/${prevSlug}/`}>← The {ORDINALS[n - 2]} house</a> : <span />}
      <a href="/learn/houses/">All houses</a>
      {nextSlug ? <a href={`/learn/houses/${nextSlug}/`}>The {ORDINALS[n]} house →</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .learn-detail { display: grid; gap: clamp(28px, 5vw, 44px); padding-block: clamp(24px, 5vw, 56px) clamp(36px, 6vw, 72px); }
  .learn-detail__hero { display: grid; gap: 12px; justify-items: start; }

  /* The wheel carries the sector; the text keeps the measure it had. */
  .learn-detail__hero--figured {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(20px, 4vw, 48px);
  }
  .learn-detail__heroText { display: grid; gap: 12px; justify-items: start; min-width: 0; }
  .learn-detail__figure { justify-self: end; }

  @media (max-width: 720px) {
    .learn-detail__hero--figured { grid-template-columns: minmax(0, 1fr); }
    .learn-detail__figure { justify-self: start; margin-top: 4px; }
  }
  .learn-detail__hero h1 {
    margin: 4px 0 0;
    font-size: clamp(2.2rem, 1.5rem + 3.6vw, 3.8rem);
    line-height: 1;
  }
  .learn-detail__role { margin: 0; font-size: var(--text-lg); color: var(--muted); max-width: 52ch; text-wrap: pretty; }
  .learn-detail__facts {
    margin: 2px 0 0;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--faint);
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .learn-detail__cta-core { padding: clamp(22px, 4vw, 32px); display: grid; gap: 10px; justify-items: start; }
  .learn-detail__cta-core strong { font-size: var(--text-lg); letter-spacing: -0.01em; }
  .learn-detail__cta-core p { margin: 0; font-size: var(--text-sm); color: var(--text-2); }

  .learn-detail__nav {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid var(--hair-1);
    font-size: var(--text-sm);
  }
  .learn-detail__nav a { color: var(--text-2); text-decoration: none; }
  .learn-detail__nav a:hover { color: var(--text); }
</style>
