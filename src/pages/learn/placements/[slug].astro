---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Faq from '../../../components/Faq.astro';
import SignIcon from '../../../components/SignIcon.astro';
import AstroTerm from '../../../components/AstroTerm.astro';
import { SIGNS, signBySlug } from '../../../lib/signs';
import { dignityFor, DIGNITY_GLOSS, hasClassicalDignities } from '../../../lib/dignities';
import ingresses from '../../../data/ingresses.json';
import { formatShortDate } from '../../../lib/i18n/dates';
import { EDITOR_AUTHOR } from '../../../lib/editorial';

const PLANET_GLYPHS: Record<string, string> = {
  Sun: '☉', Moon: '☽', Mercury: '☿', Venus: '♀', Mars: '♂',
  Jupiter: '♃', Saturn: '♄', Uranus: '♅', Neptune: '♆', Pluto: '♇',
};
const PLANET_ORDER = ['Sun', 'Moon', 'Mercury', 'Venus', 'Mars', 'Jupiter', 'Saturn', 'Uranus', 'Neptune', 'Pluto'];
/** Where each planet's reader most naturally goes next. */
const PLANET_CTA: Record<string, { href: string; label: string; blurb: string }> = {
  Sun: { href: '/birth-chart/', label: 'Get your free birth chart', blurb: 'Your Sun is one line of the chart — see the houses and aspects that make it yours.' },
  Moon: { href: '/moon-sign/', label: 'Find your moon sign', blurb: 'Not sure this is your Moon? The calculator reads it from your birth date — and says honestly when the day is ambiguous.' },
  Mercury: { href: '/mercury-retrograde/', label: 'See the retrograde calendar', blurb: 'Mercury’s review seasons are computed to the hour, through 2027.' },
  Venus: { href: '/compatibility/', label: 'Compare two charts', blurb: 'Venus placements matter most in synastry — see how yours meets another chart.' },
  Mars: { href: '/compatibility/', label: 'Compare two charts', blurb: 'Mars placements matter most in synastry — see how yours meets another chart.' },
  Jupiter: { href: '/birth-chart/', label: 'Get your free birth chart', blurb: 'The house Jupiter occupies says where the appetite points — that takes your birth time.' },
  Saturn: { href: '/saturn-return/', label: 'Find your Saturn return', blurb: 'The return dates this placement matures through, computed exactly.' },
  Uranus: { href: '/birth-chart/', label: 'Get your free birth chart', blurb: 'The house does the individual work for a generational planet — see yours.' },
  Neptune: { href: '/birth-chart/', label: 'Get your free birth chart', blurb: 'The house does the individual work for a generational planet — see yours.' },
  Pluto: { href: '/birth-chart/', label: 'Get your free birth chart', blurb: 'The house does the individual work for a generational planet — see yours.' },
};

export async function getStaticPaths() {
  const entries = await getCollection(
    'learn',
    (e) => e.data.kind === 'placement' && !e.data.draft,
  );
  // Coverage assert: every planet × sign exactly once, filenames true to
  // their frontmatter — a missing pair names itself in the error.
  const seen = new Set<string>();
  for (const entry of entries) {
    if (entry.data.kind !== 'placement') continue;
    const key = `${entry.data.planet.toLowerCase()}-in-${entry.data.sign}`;
    if (seen.has(key)) throw new Error(`Duplicate placement: ${key}`);
    seen.add(key);
    if (entry.id !== `placements/${key}`) {
      throw new Error(`Placement file ${entry.id}.mdx declares ${entry.data.planet}/${entry.data.sign} — expected placements/${key}.mdx`);
    }
  }
  // getStaticPaths is scope-isolated in Astro: imports are visible,
  // frontmatter consts are not — hence the local list.
  const ALL_PLANETS = ['sun', 'moon', 'mercury', 'venus', 'mars', 'jupiter', 'saturn', 'uranus', 'neptune', 'pluto'];
  for (const p of ALL_PLANETS) {
    for (const s of SIGNS) {
      const key = `${p}-in-${s.slug}`;
      if (!seen.has(key)) throw new Error(`Missing placement page: ${key}`);
    }
  }
  if (entries.length !== 120) {
    throw new Error(`Expected 120 placement pages, found ${entries.length}`);
  }
  return entries.map((entry) => ({
    params: { slug: entry.id.split('/')[1] },
    props: { entry },
  }));
}

const { entry } = Astro.props;
if (entry.data.kind !== 'placement') throw new Error('Not a placement entry');
const planet = entry.data.planet;
const sign = signBySlug(entry.data.sign);
const slug = entry.id.split('/')[1];
const { Content } = await render(entry);

// ── Computed panel: dignity + real transit windows ────────────────────
const dignity = dignityFor(planet, sign.slug);
const buildNow = new Date();
const fmt = (iso: string) => formatShortDate('en', iso);

// The ingress table holds closed windows only (the generator drops
// horizon-clamped edges), so from/to are always real boundaries.
type Win = { planet: string; sign: string; from: string; to: string };
const wins = (ingresses.windows as Win[]).filter((w) => w.planet === planet && w.sign === sign.slug);
const current = wins.find((w) => new Date(w.from) <= buildNow && new Date(w.to) >= buildNow);
const upcoming = wins.filter((w) => new Date(w.from) > buildNow).slice(0, 3);
const past = wins.filter((w) => new Date(w.to) < buildNow);
// Outer planets: the most recent completed era is the one readers were
// born in — show it when nothing is current.
const OUTER = ['Uranus', 'Neptune', 'Pluto'];
const recentEras = OUTER.includes(planet) && !current ? past.slice(-3) : [];
const windowLabel = (w: Win) => `${fmt(w.from)} – ${fmt(w.to)}`;
// A fast planet with nothing at or after the build date means the
// committed horizon has lapsed — warn loudly at build, never fail.
if (planet !== 'Moon' && !OUTER.includes(planet) && !current && upcoming.length === 0 && wins.length > 0) {
  console.warn(`INGRESSES STALE for ${planet} in ${sign.name}: no window ≥ build date — rerun scripts/build-ingresses.mjs`);
}

const others = PLANET_ORDER.filter((p) => p !== planet);
const signIdx = SIGNS.findIndex((s) => s.slug === sign.slug);
const prevSign = SIGNS[(signIdx + 11) % 12];
const nextSign = SIGNS[(signIdx + 1) % 12];
const pl = planet.toLowerCase();

const jsonLd = [
  {
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    url: `https://zodiacs.org/learn/placements/${slug}/`,
    datePublished: entry.data.published.toISOString(),
    dateModified: entry.data.updated.toISOString(),
    author: EDITOR_AUTHOR,
    publisher: { '@id': 'https://zodiacs.org/#org' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://zodiacs.org/learn/placements/${slug}/` },
    inLanguage: 'en',
    image: `https://zodiacs.org/assets/og/v2/placements/${pl}.png`,
    about: { '@type': 'Thing', name: `${planet} in ${sign.name} (astrology)` },
    citation: entry.data.sources.map((source) => source.href
      ? { '@type': 'CreativeWork', name: source.label, url: source.href }
      : source.label),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Learn', item: 'https://zodiacs.org/learn/' },
      { '@type': 'ListItem', position: 3, name: 'Placements', item: 'https://zodiacs.org/learn/placements/' },
      { '@type': 'ListItem', position: 4, name: `${planet} in ${sign.name}`, item: `https://zodiacs.org/learn/placements/${slug}/` },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: entry.data.faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title={entry.data.title}
  description={entry.data.description}
  path={`/learn/placements/${slug}/`}
  image={`/assets/og/v2/placements/${pl}.png`}
  imageAlt={`${planet} in ${sign.name} — Zodiacs.org`}
  type="article"
  jsonLd={jsonLd}
  sources={entry.data.sources}
>
  <article class="container container--narrow learn-detail" style={`--sign:${sign.hue}`}>
    <header class="learn-detail__hero reveal">
      <a class="crumb" href="/learn/placements/"><span class="crumb__arrow" aria-hidden="true">←</span>Placements</a>
      <div class="plc-lockup">
        <span class="plc-glyph mono">{PLANET_GLYPHS[planet]}</span>
        <SignIcon sign={sign.slug} size={128} class="plc-disc" />
        <h1 id={slug} class="display">{planet} in {sign.name}</h1>
      </div>

      <dl class="plc-panel mono">
        {dignity ? (
          <div class="plc-panel__row">
            <dt>Classical standing</dt>
            <dd><strong><AstroTerm term={dignity} label={dignity} surface="placement-guide" whyItMatters="A dignity is a traditional description of support, not a score for whether a placement is good or bad." /></strong> — {DIGNITY_GLOSS[dignity]}</dd>
          </div>
        ) : hasClassicalDignities(planet) ? (
          <div class="plc-panel__row">
            <dt>Classical standing</dt>
            <dd>neutral — no special <AstroTerm term="essential-dignity" label="dignity" surface="placement-guide" /> here</dd>
          </div>
        ) : (
          <div class="plc-panel__row">
            <dt>Classical standing</dt>
            <dd>none — {planet} postdates the classical dignity system</dd>
          </div>
        )}
        {planet === 'Moon' ? (
          <div class="plc-panel__row">
            <dt>Rhythm</dt>
            <dd>the Moon visits {sign.name} for about two and a half days every month</dd>
          </div>
        ) : (
          <>
            {current && (
              <div class="plc-panel__row">
                <dt>In {sign.name} now</dt>
                <dd>{windowLabel(current)}</dd>
              </div>
            )}
            {upcoming.length > 0 && (
              <div class="plc-panel__row">
                <dt>{current ? 'Then' : 'Next'}</dt>
                <dd>{upcoming.map(windowLabel).join(' · ')}</dd>
              </div>
            )}
            {recentEras.length > 0 && (
              <div class="plc-panel__row">
                <dt>Most recent era{recentEras.length > 1 ? 's' : ''}</dt>
                <dd>{recentEras.map(windowLabel).join(' · ')}</dd>
              </div>
            )}
          </>
        )}
      </dl>
    </header>

    <div class="prose reveal">
      <Content />
    </div>

    {planet === 'Mercury' && (
      <p class="plc-communication reveal">
        Part of how your chart talks — <a href="/learn/communication/">the communication guide →</a>
      </p>
    )}

    <section class="reveal">
      <Faq items={entry.data.faq} heading="Asked and answered" />
    </section>

    <div class="learn-detail__cta shell tinted reveal">
      <div class="core tinted learn-detail__cta-core">
        <strong>Is this your {planet}?</strong>
        <p>{PLANET_CTA[planet].blurb}</p>
        <a class="btn btn--primary" href={PLANET_CTA[planet].href}><span>{PLANET_CTA[planet].label}</span><span class="orb">↗</span></a>
      </div>
    </div>

    <nav class="plc-more reveal" aria-label="Related placements">
      <div class="plc-more__col">
        <span class="plc-more__head">{planet} through the signs</span>
        <div class="plc-more__chips">
          <a class="plc-chip" href={`/learn/placements/${pl}-in-${prevSign.slug}/`}>← {prevSign.name}</a>
          <a class="plc-chip" href={`/learn/placements/`}>All placements</a>
          <a class="plc-chip" href={`/learn/placements/${pl}-in-${nextSign.slug}/`}>{nextSign.name} →</a>
        </div>
      </div>
      <div class="plc-more__col">
        <span class="plc-more__head">More in {sign.name}</span>
        <div class="plc-more__chips">
          {others.map((p) => (
            <a class="plc-chip" href={`/learn/placements/${p.toLowerCase()}-in-${sign.slug}/`}>
              {PLANET_GLYPHS[p]} {p}
            </a>
          ))}
        </div>
      </div>
    </nav>
  </article>
</Base>

<style>
  .learn-detail { display: grid; gap: clamp(28px, 5vw, 44px); padding-block: clamp(24px, 5vw, 56px) clamp(36px, 6vw, 72px); }
  .learn-detail__hero { display: grid; gap: 18px; justify-items: start; }

  .plc-lockup { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .plc-glyph { font-size: 34px; color: var(--muted); }
  .plc-lockup :global(.plc-disc) { border-radius: 50%; }
  .plc-lockup h1 {
    margin: 0;
    font-size: clamp(2.1rem, 1.4rem + 3.4vw, 3.6rem);
    line-height: 1.02;
    flex-basis: 100%;
  }
  @media (min-width: 700px) { .plc-lockup h1 { flex-basis: auto; } }

  .plc-panel { margin: 0; display: grid; width: 100%; max-width: 640px; }
  .plc-panel__row {
    display: grid;
    gap: 2px 20px;
    padding: 9px 0;
    border-bottom: 1px solid var(--hair-1);
    font-size: 11.5px;
    letter-spacing: 0.05em;
  }
  .plc-panel__row:first-child { border-top: 1px solid var(--hair-1); }
  @media (min-width: 560px) { .plc-panel__row { grid-template-columns: 170px 1fr; } }
  .plc-panel__row dt { color: var(--faint); font-size: 12px; letter-spacing: 0; align-self: baseline; }
  .plc-panel__row dd { margin: 0; color: var(--text-2); }
  .plc-panel__row strong { color: var(--text); font-weight: 600; text-transform: capitalize; }

  .learn-detail__cta-core { padding: clamp(22px, 4vw, 32px); display: grid; gap: 10px; justify-items: start; }
  .learn-detail__cta-core strong { font-size: var(--text-lg); letter-spacing: -0.01em; }
  .learn-detail__cta-core p { margin: 0; font-size: var(--text-sm); color: var(--text-2); max-width: 54ch; }

  .plc-communication {
    margin: 0;
    padding-top: 18px;
    border-top: 1px solid var(--hair-1);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .plc-communication a { color: var(--text); }

  .plc-more {
    display: grid;
    gap: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--hair-1);
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) { .plc-more { grid-template-columns: auto 1fr; gap: 20px 48px; } }
  .plc-more__col { display: grid; gap: 10px; align-content: start; }
  .plc-more__head { font-weight: 600; font-size: var(--text-sm); color: var(--text); }
  .plc-more__chips { display: flex; flex-wrap: wrap; gap: 4px 2px; }
  .plc-chip {
    padding: 4px 9px;
    border-radius: var(--r-full);
    font-size: 12.5px;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }
  .plc-chip:hover { color: var(--text); background: color-mix(in oklab, var(--sign) 12%, transparent); }
</style>
