---
import Base from '../../../layouts/Base.astro';
import dailyData from '../../../data/daily.json';
import type { Daily } from '../../../lib/daily';
import { dailyReadingForLocale } from '../../../lib/i18n/daily-reading';
import { formatDate } from '../../../lib/i18n/dates';
import { englishOnlyCue } from '../../../lib/i18n/english-only';
import { SIGNS, signDates, signName } from '../../../lib/signs';

const locale = 'es' as const;
const daily = dailyData as Daily;
const dateLabel = formatDate(locale, `${daily.date}T12:00:00Z`, {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
const cards = SIGNS.map((sign) => {
  const reading = dailyReadingForLocale(sign.slug, daily, locale);
  return { sign, teaser: reading.lines.find((line) => line.house !== undefined)?.text ?? reading.headline };
});
const cue = englishOnlyCue(locale);
const description = `Horóscopos de hoy, ${dateLabel}: una nota clara para cada uno de los doce signos, calculada a partir de las posiciones reales del cielo.`;
---
<Base
  title={`Horóscopos de hoy — ${dateLabel} | Zodiacs.org`}
  description={description}
  path="/es/horoscopes/"
  locale={locale}
  editionDate={daily.date}
  image="/assets/og/v2/tool/horoscopes.png"
  imageAlt="Horóscopos de hoy para los doce signos — Zodiacs.org"
>
  <section class="section--tight container container--narrow" data-edition-content="true">
    <div class="horo-es__hero">
      <em class="kicker">Edición diaria · {dateLabel}</em>
      <h1 class="display">Horóscopos de hoy</h1>
      <p>
        Busca tu signo para la nota más concreta del cielo de hoy. Lee primero tu signo solar y, si lo conoces,
        también tu ascendente.
      </p>
    </div>

    <div class="horo-es__grid">
      {cards.map(({ sign, teaser }) => (
        <a class="tile horo-es__card" href={`/es/horoscopes/${sign.slug}/`} style={`--sign:${sign.hue}`}>
          <img src={`/assets/zodiac-icons/48/${sign.slug}.webp`} width="48" height="48" alt="" loading="lazy" decoding="async" />
          <span class="horo-es__name">{signName(sign, locale)}</span>
          <span class="horo-es__dates mono">{signDates(sign, locale)}</span>
          <span class="horo-es__teaser">{teaser}</span>
          <span class="horo-es__go mono">Leer hoy →</span>
        </a>
      ))}
    </div>

    <p class="horo-es__note">
      ¿Quieres una vista más personal? <a href="/es/birth-chart/">Calcula tu carta natal gratis</a>. Las lecturas de
      mañana, de la semana y del mes están en{' '}
      <a href="/horoscopes/" hreflang="en" title={cue?.aria}>la edición en inglés{cue?.suffix}</a>.
    </p>
  </section>
</Base>

<style>
  .horo-es__hero { max-width: 62ch; margin-bottom: clamp(26px, 5vw, 42px); }
  .horo-es__hero h1 { margin: 14px 0; font-size: var(--text-2xl); line-height: 1.04; }
  .horo-es__hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }
  .horo-es__grid { display: grid; gap: 10px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 700px) { .horo-es__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .horo-es__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .horo-es__card {
    display: grid; justify-items: center; gap: 8px; min-width: 0; padding: 22px 14px 17px;
    color: var(--text); text-align: center; text-decoration: none;
  }
  .horo-es__card img { border-radius: 50%; }
  .horo-es__name { font-weight: 650; letter-spacing: -0.01em; }
  .horo-es__dates { color: var(--faint); font-size: 10px; letter-spacing: 0.06em; }
  .horo-es__teaser {
    margin-top: 6px; padding-top: 10px; border-top: 1px solid var(--hair-1);
    color: var(--text-2); font-size: 12px; line-height: 1.5; text-wrap: pretty;
  }
  .horo-es__go { margin-top: 4px; color: var(--faint); font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; }
  .horo-es__card:hover .horo-es__go { color: var(--text); }
  .horo-es__note { margin-top: clamp(22px, 4vw, 34px); color: var(--muted); font-size: var(--text-sm); }
  .horo-es__note a { color: var(--text); }
  @media (max-width: 460px) { .horo-es__grid { grid-template-columns: 1fr; } }
</style>
