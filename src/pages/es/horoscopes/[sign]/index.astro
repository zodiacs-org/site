---
// Horóscopo diario de cada signo en español: la página vive en LocalizedHoroscope.
import LocalizedHoroscope from '../../../../components/localized/LocalizedHoroscope.astro';
import { SIGNS } from '../../../../lib/signs';

export function getStaticPaths() {
  return SIGNS.map((sign) => ({ params: { sign: sign.slug } }));
}
---
<LocalizedHoroscope locale="es" signSlug={Astro.params.sign!} />
