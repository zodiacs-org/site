---
import Base from '../../../layouts/Base.astro';
import DailyLocaleReading from '../../../components/DailyLocaleReading.astro';
import dailyData from '../../../data/daily.json';
import type { Daily } from '../../../lib/daily';
import { dailyReadingForLocale } from '../../../lib/i18n/daily-reading';
import { formatDate } from '../../../lib/i18n/dates';
import { moonPhaseLabel } from '../../../lib/i18n/astrology';
import { englishOnlyCue } from '../../../lib/i18n/english-only';
import { SIGNS, signName } from '../../../lib/signs';

// El cielo de hoy leído para los doce signos, en español, desde los mismos
// hechos registrados que la edición inglesa: ninguna prosa nueva, solo la
// misma selección de líneas con plantillas en este idioma.
const locale = 'es' as const;
const daily = dailyData as Daily;
const dateLabel = formatDate(locale, `${daily.date}T12:00:00Z`, {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
const readings = SIGNS.map((sign) => ({ sign, reading: dailyReadingForLocale(sign.slug, daily, locale) }));
const cue = englishOnlyCue(locale);
const description = `El cielo de hoy para los doce signos solares: cuatro notas por signo, calculadas a partir de las posiciones reales del ${dateLabel}.`;
---
<Base
  title={`Hoy — el cielo del ${dateLabel} | Zodiacs.org`}
  description={description}
  path="/es/today/"
  locale={locale}
  editionDate={daily.date}
>
  <section class="section--tight container container--narrow" data-edition-content="true">
    <header class="today-es__hero">
      <em class="kicker">Edición diaria · {dateLabel}</em>
      <h1 class="display">Hoy</h1>
      <p>
        Elige tu signo solar. Cada nota sale de las posiciones registradas del cielo de hoy, leídas desde las casas
        solares de tu signo; los comprobantes bajo cada lectura dicen exactamente qué la produjo.
      </p>
      <span class="today-es__stamp mono">{dateLabel} · {moonPhaseLabel(locale, daily.moon.phase)}</span>
    </header>

    <nav class="today-es__signs" aria-label="Signos">
      {SIGNS.map((sign) => (
        <a class="today-es__chip" href={`#${sign.slug}`} style={`--sign:${sign.hue}`}>
          <img src={`/assets/zodiac-icons/48/${sign.slug}.webp`} width="22" height="22" alt="" loading="lazy" decoding="async" />
          {signName(sign, locale)}
        </a>
      ))}
    </nav>

    {readings.map(({ sign, reading }) => (
      <article class="today-es__sign tile" id={sign.slug} style={`--sign:${sign.hue}`}>
        <h2 id={`${sign.slug}-title`}>
          <img src={`/assets/zodiac-icons/48/${sign.slug}.webp`} width="28" height="28" alt="" loading="lazy" decoding="async" />
          {signName(sign, locale)}
        </h2>
        <DailyLocaleReading locale={locale} reading={reading} headingId={`${sign.slug}-title`} />
        <p class="today-es__links">
          <a href={`/es/horoscopes/${sign.slug}/`}>Horóscopo de hoy de {signName(sign, locale)}</a> ·
          <a href={`/es/${sign.slug}/`}>Guía de {signName(sign, locale)}</a>
        </p>
      </article>
    ))}

    <p class="today-es__note">
      ¿Tienes tu carta natal? La comparación privada con el cielo de hoy vive en{' '}
      <a href="/today/" hreflang="en" title={cue?.aria}>la edición en inglés{cue?.suffix}</a>; tu{' '}
      <a href="/es/birth-chart/">carta natal gratis</a> se calcula aquí, en tu navegador.
    </p>
  </section>
</Base>

<style>
  .today-es__hero { max-width: 62ch; margin-bottom: clamp(22px, 4vw, 34px); }
  .today-es__hero h1 { margin: 14px 0; font-size: var(--text-2xl); line-height: 1.04; }
  .today-es__hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }
  .today-es__stamp { display: block; margin-top: 14px; color: var(--faint); font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; }
  .today-es__signs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: clamp(22px, 4vw, 34px); }
  .today-es__chip {
    display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px 6px 8px;
    border: 1px solid var(--hair-2); border-radius: 999px; color: var(--text-2);
    font-size: var(--text-sm); text-decoration: none;
  }
  .today-es__chip:hover { border-color: var(--hair-3); color: var(--text); }
  .today-es__chip img { border-radius: 50%; }
  .today-es__sign { padding: 20px 18px; margin-bottom: 12px; scroll-margin-top: 20px; }
  .today-es__sign h2 { display: flex; align-items: center; gap: 10px; margin: 0 0 12px; font-size: var(--text-lg); }
  .today-es__sign h2 img { border-radius: 50%; }
  .today-es__links { margin: 12px 0 0; color: var(--muted); font-size: var(--text-sm); }
  .today-es__links a { color: var(--text-2); }
  .today-es__note { margin-top: clamp(22px, 4vw, 34px); color: var(--muted); font-size: var(--text-sm); }
  .today-es__note a { color: var(--text); }
</style>
