---
import ReturnToolLinks from "../../../components/return-visits/ReturnToolLinks.astro";
import Base from '../../../layouts/Base.astro';
import ProfileDashboard from '../../../islands/ProfileDashboard';
import SavedRecordsPanel from '../../../islands/SavedRecordsPanel';
import { savedRecordsEnabled } from '../../../lib/profile/saved-record-flags';
import ProfileManager from '../../../islands/ProfileManager';
import AccountBoundProfileSurface from '../../../islands/AccountBoundProfileSurface';
import { accountSyncV2Enabled as isAccountSyncV2Enabled } from '../../../lib/account-v2/feature-flags';
import '../../../styles/calculator.css';
import '../../../styles/profile-polish.css';
import '../../../styles/profile-page.css';

const accountSyncV2Enabled = isAccountSyncV2Enabled({
  PUBLIC_ACCOUNT_SYNC_V2_ENABLED: process.env.PUBLIC_ACCOUNT_SYNC_V2_ENABLED,
  PUBLIC_ACCOUNT_SYNC_V2_PREVIEW_ACK: process.env.PUBLIC_ACCOUNT_SYNC_V2_PREVIEW_ACK,
});
const savedRecordsSurfaceEnabled = savedRecordsEnabled({
  PUBLIC_SAVED_RECORDS_ENABLED: process.env.PUBLIC_SAVED_RECORDS_ENABLED,
});

const jsonLd = [
  {
    '@type': 'WebPage',
    name: 'Cartas guardadas',
    url: 'https://zodiacs.org/es/profile/',
    description: 'Guarda cartas en este dispositivo y sincronízalas con tu cuenta solo cuando tú lo decidas.',
    inLanguage: 'es',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
];
---
<Base
  clientUi
  title="Cartas guardadas | Zodiacs.org"
  description="Guarda cartas de forma privada en este dispositivo e inicia sesión cuando quieras tenerlas en todos tus dispositivos."
  path="/es/profile/"
  locale="es"
  jsonLd={jsonLd}
  privateSurface={accountSyncV2Enabled}
>
  <section class="section--tight container pf-page">
    <div class="pf-hero">
      <h1 class="display">Cartas guardadas.</h1>
      <p>Guarda cartas en este dispositivo. Inicia sesión cuando quieras tenerlas en todos tus dispositivos.</p>
    </div>
    {accountSyncV2Enabled ? (
      <AccountBoundProfileSurface locale="es" client:load />
    ) : (
      <>
        <ProfileDashboard locale="es" client:load />
        <ProfileManager locale="es" client:load />
      </>
    )}
    <SavedRecordsPanel enabled={savedRecordsSurfaceEnabled} locale="es" client:load />
    <aside class="pf-note">
      <p class="mono">{accountSyncV2Enabled
        ? <>La prueba de sincronización cifrada se gestiona temporalmente en <a href="/profile/">/profile/</a>. Aquí tus cartas permanecen solo en este dispositivo.</>
        : 'Si borras los datos del navegador, se borran las cartas que solo están guardadas localmente. Inicia sesión para sincronizar cartas guardadas y eliminaciones entre dispositivos.'}</p>
    </aside>
  </section>
<section class="section--tight container"><ReturnToolLinks locale="es" /></section>
</Base>
