---
import Base from '../../../layouts/Base.astro';
import LocalizedBirthChart from '../../../components/localized/LocalizedBirthChart.astro';
import birthChartCss from '../../../components/localized/LocalizedBirthChart.css?inline';

const faq = [
  {
    q: '¿Qué es una carta natal?',
    a: 'Una carta natal, o carta astral, es un mapa de la posición de cada planeta, vista desde la Tierra, en el momento y lugar exactos en que naciste. Registra tu Sol, Luna y ascendente, además de las posiciones de Mercurio a Plutón en las doce casas.',
  },
  {
    q: '¿Necesito saber mi hora exacta de nacimiento?',
    a: 'Para calcular el ascendente y las casas, sí: el ascendente cambia aproximadamente cada dos horas. Si no sabes la hora, usamos las 12:00 del tiempo civil local como referencia para las posiciones y omitimos ascendente, ángulos y casas. Como la Luna puede cambiar de signo durante el día, el resultado marca el signo lunar como no verificado hasta que agregues la hora. El certificado de nacimiento, el libro del bebé o tu familia suelen ser las mejores fuentes.',
  },
  {
    q: '¿Qué tan precisa es esta calculadora?',
    a: 'Las posiciones planetarias se calculan con un motor astronómico y se comparan con datos de referencia de NASA JPL, con un margen de unas centésimas de grado. Los cambios horarios históricos desde 1970 se resuelven con el historial IANA suministrado por el navegador o el sistema del dispositivo, y los anteriores con una versión fijada de la base de datos IANA, incluidos los registros antiguos que guarda aparte para lugares cuyos relojes coincidieron después con los de otra ciudad, que sus responsables consideran menos fiables. Un nacimiento anterior a que su lugar adoptara una hora legal usa la hora media local del propio lugar de nacimiento.',
  },
  {
    q: '¿Qué ocurre con mis datos de nacimiento?',
    a: 'La carta completa se calcula en tu navegador; la calculadora no usa ninguna API de cartas en el servidor y no necesitas una cuenta. Si guardas una carta, primero permanece en este dispositivo. La sincronización opcional solo sube las cartas guardadas después de que inicias sesión.',
  },
  {
    q: 'Casas de signos completos o Placidus: ¿cuál elijo?',
    a: 'El sistema de casas de signos completos es el más antiguo y el más fácil de leer: cada casa ocupa un signo completo. Placidus es la opción moderna más habitual y divide las casas según el tiempo que tardan en ascender, por lo que su tamaño varía. Prueba ambos: tus planetas no se mueven; solo cambian los límites de las casas.',
    id: 'houses',
  },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    name: 'Calculadora gratuita de carta natal',
    url: 'https://zodiacs.org/es/birth-chart/',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: 'Sol, Luna, ascendente, planetas de Mercurio a Plutón, Nodo verdadero, casas de signos completos y Placidus, aspectos',
    inLanguage: 'es',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
  {
    '@type': 'FAQPage',
    inLanguage: 'es',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org en español', item: 'https://zodiacs.org/es/' },
      { '@type': 'ListItem', position: 2, name: 'Herramientas', item: 'https://zodiacs.org/es/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Calculadora de carta natal', item: 'https://zodiacs.org/es/birth-chart/' },
    ],
  },
];
---
<Base
  clientUi
  glass
  title="Carta natal gratis: Sol, Luna y ascendente | Zodiacs.org"
  description="Calcula tu carta natal gratis: Sol, Luna, ascendente, planetas, casas y qué significan. Privado en tu navegador y explicado con claridad."
  path="/es/birth-chart/"
  locale="es"
  image="/assets/og/v2/tool/birth-chart.png"
  imageAlt="Calculadora de carta natal gratis, Zodiacs.org"
  jsonLd={jsonLd}
>
  <script slot="head" is:inline>
    try {
      var chartShareParams = new URLSearchParams(location.hash.slice(1));
      if (chartShareParams.has('p') || chartShareParams.has('c')) {
        document.documentElement.dataset.chartShareReceiver = '';
        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('a[href="/astrofolio/"],a[href^="/registry/"],a[href^="/sdk/"]').forEach(function (element) {
            if (element.closest('[data-nav], [data-mobile-menu]')) return;
            var footerWing = element.closest('.footer__col, .zfooter__group');
            (footerWing || element).remove();
          });
        }, { once: true });
      }
    } catch (error) {}
  </script>
  <style slot="head" is:inline>
    html[data-chart-share-receiver] a[href="/astrofolio/"]:not([data-nav] a, [data-mobile-menu] a),
    html[data-chart-share-receiver] a[href^="/registry/"],
    html[data-chart-share-receiver] a[href^="/sdk/"],
    html[data-chart-share-receiver] .calc__record,
    html[data-chart-share-receiver] [data-registry-aura-chart-link],
    html[data-chart-share-receiver] .footer__col:has(a[href^="/registry/"]),
    html[data-chart-share-receiver] .zfooter__group:has(a[href^="/registry/"]) { display: none !important; }
  </style>
  <style slot="head" is:inline data-zdx-birth-chart-route set:html={birthChartCss} />

  <LocalizedBirthChart locale="es" faq={faq} />
</Base>
