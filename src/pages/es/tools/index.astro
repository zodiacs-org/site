---
import ReturnToolLinks from "../../../components/return-visits/ReturnToolLinks.astro";
import SharingToolLinks from '../../../components/sharing/SharingToolLinks.astro';
import Base from '../../../layouts/Base.astro';
import ToolIcon from '../../../components/ToolIcon.astro';
import ToolsHelpCard from '../../../components/tools/ToolsHelpCard.astro';
import ToolsLead from '../../../components/tools/ToolsLead.astro';
import ToolsPageHeading from '../../../components/ToolsPageHeading.astro';
import { ENGLISH_ONLY_COPY, localizePath, t } from '../../../lib/i18n';
import { toolIconForPath } from '../../../lib/tool-icons';
import '../../../styles/tools-hub.css';

const englishOnly = ENGLISH_ONLY_COPY.es;
const tools = [
  { href: '/birth-chart/', title: 'Calculadora de carta natal', promise: 'Descubre tu Sol, tu Luna, tu ascendente, los planetas, las casas y lo que significan.' },
  { href: '/birth-chart/someone-else/', title: 'Carta de otra persona (en inglés)', promise: 'Usa sus datos de nacimiento, sus tres grandes o un enlace de Zodiacs, con su permiso.', englishOnly: true },
  { href: '/today/', title: 'Hoy', promise: 'El cielo de hoy, leído para los doce signos solares.' },
  { href: '/compatibility/', title: 'Compatibilidad', promise: 'Compara dos cartas y mira dónde conectan, chocan y crecen.' },
  { href: '/moon-sign/', title: 'Calculadora de signo lunar', promise: 'Cómo sientes las cosas y qué te calma.' },
  { href: '/rising-sign/', title: 'Calculadora de ascendente', promise: 'El signo que los demás ven primero. La hora de nacimiento ayuda.' },
  { href: '/moon-phase/', title: 'Fase lunar', promise: 'La Luna de hoy y la Luna de cualquier fecha importante.' },
  { href: '/saturn-return/', title: 'Retorno de Saturno', promise: 'Cuándo llega el tuyo y qué suele pedir.' },
  { href: '/transits/', title: 'Tránsitos', promise: 'El cielo de hoy comparado con tu carta.' },
];
const [lead, ...rest] = tools;
const iconFor = (href: string) => toolIconForPath(href) ?? 'birth-chart';

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'Herramientas gratis de astrología',
    url: 'https://zodiacs.org/es/tools/',
    description: 'Calculadoras gratis de astrología, calculadas de forma privada en tu navegador.',
    inLanguage: 'es',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
];
---
<Base
  title="Herramientas gratis de astrología | Zodiacs.org"
  description="Calculadoras gratis de astrología: carta natal, compatibilidad, signo lunar, ascendente, fase lunar, retorno de Saturno y tránsitos, en tu navegador."
  path="/es/tools/"
  locale="es"
  image="/assets/og/v2/tool/tools.png"
  imageAlt="Herramientas gratis de astrología, Zodiacs.org"
  jsonLd={jsonLd}
>
  <header class="tools-hub tools-hub--solo kwrap">
    <div class="tools-hub__intro">
      <ToolsPageHeading>Herramientas gratis de astrología</ToolsPageHeading>
      <p class="klede tools-hub__lede">Encuentra tu carta natal, signo lunar, ascendente, compatibilidad y lo que está pasando en el cielo ahora. Tus datos se calculan en tu navegador.</p>
    </div>
    <ToolsLead
      href={localizePath('es', lead.href)}
      title={lead.title}
      text={lead.promise}
      needs={[t('es', 'birthDate'), t('es', 'birthTime'), t('es', 'birthplace')]}
      cta={t('es', 'getBirthChart')}
      reassure={t('es', 'privacyDevice')}
      locale="es"
    />
  </header>

  <section class="tools-block kwrap">
    <ul class="tools-grid tools-list">
      {rest.map((tool) => (
        <li>
          <a class="tools-row" href={'englishOnly' in tool ? tool.href : localizePath('es', tool.href)} hreflang={'englishOnly' in tool ? 'en' : undefined} title={'englishOnly' in tool ? englishOnly.aria : undefined} aria-label={'englishOnly' in tool ? `${tool.title}. ${englishOnly.aria}` : undefined}>
            <ToolIcon name={iconFor(tool.href)} size={52} />
            <div class="tool-card">
              <h2>{tool.title}</h2>
              <p>{tool.promise}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="tools-block kwrap">
    <h2 class="tools-section-title">Calendarios del cielo</h2>
    <ul class="tools-list">
      <li class="tools-row"><ToolIcon name="full-moon-calendar" size={52} /><span class="tools-row__text"><a href="/es/full-moon-calendar/"><strong>Lunas llenas</strong></a>: fechas, signos y nombres hasta 2027.</span></li>
      <li class="tools-row"><ToolIcon name="eclipses" size={52} /><span class="tools-row__text"><a href="/es/eclipses/"><strong>Eclipses</strong></a>: solares y lunares hasta 2028.</span></li>
      <li class="tools-row"><ToolIcon name="retrogrades" size={52} /><span class="tools-row__text"><a href="/es/retrogrades/"><strong>Planetas retrógrados</strong></a>: de Mercurio a Plutón. <a href="/es/mercury-retrograde/"><strong>Mercurio retrógrado</strong></a>: cada periodo, con sus estaciones.</span></li>
    </ul>
  </section>

  <section class="tools-block kwrap">
    <h2 class="tools-section-title">También disponible en inglés</h2>
    <ul class="tools-list">
      <li class="tools-row"><ToolIcon name="horoscopes" size={52} /><span class="tools-row__text"><strong>Horóscopos.</strong> El cielo de hoy, signo por signo. La edición inglesa también incluye lecturas semanales y mensuales: <a href="/horoscopes/" hreflang="en" title={englishOnly.aria}>elegir signo</a>.</span></li>
    </ul>
  </section>

  <section class="tools-block kwrap"><SharingToolLinks locale="es" icons /></section>
  <section class="tools-block kwrap"><ReturnToolLinks locale="es" current="/saturn-return/" icons /></section>

  <section class="tools-help">
    <div class="kwrap"><div class="tools-help__grid tools-help__grid--one">
      <ToolsHelpCard icon="guide" art="tools-lens" title="Pregunta a Guide">
        <p>Guide puede ayudarte con una herramienta, un término astrológico o una carta que hayas guardado aquí.</p>
        <button class="btn btn--sm" type="button" data-assistant-open data-assistant-locale="es" aria-haspopup="dialog">Iniciar una conversación</button>
      </ToolsHelpCard>
    </div></div>
  </section>
</Base>
