---
import ReturnToolLinks from "../../../components/return-visits/ReturnToolLinks.astro";
import SharingToolLinks from '../../../components/sharing/SharingToolLinks.astro';
import Base from '../../../layouts/Base.astro';
import ToolGlyph from '../../../components/ToolGlyph.astro';
import ToolsPageHeading from '../../../components/ToolsPageHeading.astro';
import { ENGLISH_ONLY_COPY, localizePath } from '../../../lib/i18n';

const englishOnly = ENGLISH_ONLY_COPY.es;
const tools = [
  { href: '/birth-chart/', title: 'Calculadora de carta natal', promise: 'Descubre tu Sol, tu Luna, tu ascendente, los planetas, las casas y lo que significan.', hue: 'var(--sign-cancer)', kind: 'birth' as const },
  { href: '/birth-chart/someone-else/', title: 'Carta de otra persona (en inglés)', promise: 'Usa sus datos de nacimiento, sus tres grandes o un enlace de Zodiacs, con su permiso.', hue: 'var(--sign-pisces)', kind: 'birth' as const, englishOnly: true },
  { href: '/today/', title: 'Hoy', promise: 'El cielo de hoy, leído para los doce signos solares.', hue: 'var(--sign-cancer)', kind: 'transit' as const },
  { href: '/compatibility/', title: 'Compatibilidad', promise: 'Compara dos cartas y mira dónde conectan, chocan y crecen.', hue: 'var(--sign-libra)', kind: 'compat' as const },
  { href: '/moon-sign/', title: 'Calculadora de signo lunar', promise: 'Cómo sientes las cosas y qué te calma.', hue: 'var(--sign-pisces)', kind: 'moon' as const },
  { href: '/rising-sign/', title: 'Calculadora de ascendente', promise: 'El signo que los demás ven primero. La hora de nacimiento ayuda.', hue: 'var(--sign-gemini)', kind: 'rising' as const },
  { href: '/moon-phase/', title: 'Fase lunar', promise: 'La Luna de hoy y la Luna de cualquier fecha importante.', hue: 'var(--sign-cancer)', kind: 'moonphase' as const },
  { href: '/saturn-return/', title: 'Retorno de Saturno', promise: 'Cuándo llega el tuyo y qué suele pedir.', hue: 'var(--sign-capricorn)', kind: 'saturn' as const },
  { href: '/transits/', title: 'Tránsitos', promise: 'El cielo de hoy comparado con tu carta.', hue: 'var(--sign-aries)', kind: 'transit' as const },
];

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'Herramientas gratis de astrología',
    url: 'https://zodiacs.org/es/tools/',
    description: 'Calculadoras gratis de astrología, calculadas de forma privada en tu navegador.',
    inLanguage: 'es',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
];
---
<Base
  title="Herramientas gratis de astrología | Zodiacs.org"
  description="Calculadoras gratis de astrología: carta natal, compatibilidad, signo lunar, ascendente, fase lunar, retorno de Saturno y tránsitos, en tu navegador."
  path="/es/tools/"
  locale="es"
  image="/assets/og/v2/tool/tools.png"
  imageAlt="Herramientas gratis de astrología — Zodiacs.org"
  jsonLd={jsonLd}
>
  <section class="section container">
    <div class="section-head">
      <ToolsPageHeading>Herramientas gratis de astrología</ToolsPageHeading>
      <p>Encuentra tu carta natal, signo lunar, ascendente, compatibilidad y lo que está pasando en el cielo ahora. Tus datos se calculan en tu navegador.</p>
    </div>

    <div class="tools-grid">
      {tools.map((tool) => (
        <a class="shell tinted" href={'englishOnly' in tool ? tool.href : localizePath('es', tool.href)} hreflang={'englishOnly' in tool ? 'en' : undefined} title={'englishOnly' in tool ? englishOnly.aria : undefined} aria-label={'englishOnly' in tool ? `${tool.title}. ${englishOnly.aria}` : undefined} style={`--sign:${tool.hue}`}>
          <div class="core tinted tool-card">
            <ToolGlyph kind={tool.kind} />
            <h2>{tool.title}</h2>
            <p>{tool.promise}</p>
            <span class="tool-card__go">Abrir →</span>
          </div>
        </a>
      ))}
      <button
        class="shell tinted assistant-tool"
        type="button"
        style="--sign:var(--sign-aquarius)"
        data-assistant-open
        data-assistant-locale="es"
        aria-haspopup="dialog"
      >
        <div class="core tinted tool-card">
          <ToolGlyph kind="assistant" />
          <h2>Pregunta a Guide</h2>
          <p>Guide puede ayudarte con una herramienta, un término astrológico o una carta que hayas guardado aquí.</p>
          <span class="tool-card__go">Iniciar una conversación →</span>
        </div>
      </button>
    </div>

    <div class="tools-upcoming">
      <em class="kicker">También disponible en inglés</em>
      <ul>
        <li><strong>Horóscopos.</strong> El cielo de hoy, signo por signo. La edición inglesa también incluye lecturas semanales y mensuales: <a href="/horoscopes/" hreflang="en" title={englishOnly.aria}>elegir signo</a>.</li>
        <li><strong>Mercurio retrógrado.</strong> Ventanas exactas hasta 2027: <a href="/mercury-retrograde/" hreflang="en">ver fechas</a>.</li>
      </ul>
    </div>
  </section>
<section class="section--tight container"><SharingToolLinks locale="es" /></section>
<section class="section--tight container"><ReturnToolLinks locale="es" /></section>
</Base>

<style>
  .tools-grid { display: grid; gap: 14px; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .tools-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .tools-grid { grid-template-columns: repeat(3, 1fr); } }
  .tool-card { display: flex; flex-direction: column; gap: 10px; padding: 26px 22px; min-height: 210px; }
  /* Tool-card icon disc lives in ToolGlyph.astro. */
  .tool-card h2 { margin: 4px 0 0; font-size: var(--text-lg); font-weight: 620; color: var(--text); }
  .tool-card p { margin: 0; font-size: var(--text-sm); color: var(--text-2); line-height: 1.6; }
  .tool-card__go { margin-top: auto; font-size: 13px; font-weight: 550; color: var(--text); }
  .assistant-tool { display: block; width: 100%; text-align: start; transition: border-color var(--dur-2) var(--ease), transform var(--dur-2) var(--ease); }
  .assistant-tool:hover { border-color: color-mix(in oklab, var(--sign) 45%, transparent); transform: translateY(-2px); }
  .assistant-tool:hover .core { border-color: color-mix(in oklab, var(--sign) 28%, transparent); }
  .tools-upcoming { margin-top: clamp(28px, 5vw, 44px); padding-top: 24px; border-top: 1px solid var(--hair-1); }
  .tools-upcoming ul { margin: 12px 0 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .tools-upcoming li { font-size: var(--text-sm); color: var(--muted); }
  .tools-upcoming strong { color: var(--text-2); font-weight: 600; }
  .tools-upcoming a { color: var(--text); }
</style>
