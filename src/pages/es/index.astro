---
import Base from '../../layouts/Base.astro';
import LocalizedHome from '../../components/localized/LocalizedHome.astro';
import LocalizedHomeHead from '../../components/localized/LocalizedHomeHead.astro';
import { localizedHomeFaq, localizedHomeFaqSchema } from '../../components/localized/home-copy';

// The English homepage's two own questions, in Spanish. The data answer is
// the birth chart page's, as published there.
const faq = localizedHomeFaq('es', [
  {
    q: '¿Qué ocurre con mis datos de nacimiento?',
    a: 'La carta completa se calcula en tu navegador; la calculadora no usa ninguna API de cartas en el servidor y no necesitas una cuenta. Si guardas una carta, primero permanece en este dispositivo. La sincronización opcional solo sube las cartas guardadas después de que inicias sesión.',
  },
  {
    q: '¿Y si no sé mi hora de nacimiento?',
    a: 'Elige “No la sé”. La calculadora usa las 12:00 como referencia, deja fuera el ascendente y las casas en lugar de inventarlos y marca el signo lunar como no verificado hasta que agregues una hora, porque la Luna puede cambiar de signo durante el día.',
  },
]);

const jsonLd = [
  localizedHomeFaqSchema(faq),
  {
    '@type': 'WebSite',
    '@id': 'https://zodiacs.org/#site',
    url: 'https://zodiacs.org/',
    name: 'Zodiacs.org',
    description: 'Cartas natales gratis, signo lunar, compatibilidad, horóscopos y guías de signos, privados y fáciles de entender.',
    publisher: { '@id': 'https://zodiacs.org/#org' },
    inLanguage: ['en', 'es'],
  },
];
---
<Base
  clientUi
  title="Zodiacs.org | carta natal gratis y guías de signos"
  description="Carta natal gratis, signo lunar, ascendente, compatibilidad, horóscopos y guías de los doce signos, calculados en privado en tu navegador."
  path="/es/"
  locale="es"
  jsonLd={jsonLd}
>
  <LocalizedHomeHead slot="head" locale="es" />
  <LocalizedHome locale="es" faq={faq} />
</Base>
