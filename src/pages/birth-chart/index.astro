  <script is:inline>
    // The sample's sign pictures, as one whole set: when any part of the
    // sample nears the screen, the first wheel's twelve discs are asked for
    // in zodiac order, then the second wheel and every other sample disc,
    // which by then are the same twelve files. A phone, where the sample sits
    // below the form, fetches none of it while the page loads.
    (function () {
      var query = '?surface=sample-chart';
      var parts = document.querySelectorAll('[data-sample-set]');
      var done = false;
      function load() {
        if (done) return;
        done = true;
        document.querySelectorAll('.bc-wheel image[data-href]').forEach(function (image) {
          image.setAttribute('href', image.getAttribute('data-href') + query);
          image.removeAttribute('data-href');
        });
        document.querySelectorAll('img[data-sample-src]').forEach(function (image) {
          image.src = image.getAttribute('data-sample-src');
          image.removeAttribute('data-sample-src');
        });
      }
      if (!('IntersectionObserver' in window)) { load(); return; }
      var watch = new IntersectionObserver(function (entries) {
        if (!entries.some(function (entry) { return entry.isIntersecting; })) return;
        watch.disconnect();
        load();
      }, { rootMargin: '200px 0px' });
      parts.forEach(function (part) { watch.observe(part); });
    })();
  </script>
