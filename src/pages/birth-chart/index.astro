---
import Base from '../../layouts/Base.astro';
import AstroTerm from '../../components/AstroTerm.astro';
import ChartCalculator from '../../islands/ChartCalculator';
import { PostChartDailyBrief } from '../../islands/PostChartDailyBrief';
import EmailCapture from '../../components/EmailCapture.astro';
import EvidenceDisclosure from '../../components/EvidenceDisclosure.astro';
import { hasDailyChartEmailProvider } from '../../lib/email/daily-config';
import '../../styles/calculator.css';
import '../../styles/explorer.css';
import '../../styles/post-chart-daily.css';

const postChartDailyEnabled = hasDailyChartEmailProvider(process.env);

const faq = [
  {
    q: 'What is a birth chart?',
    a: 'A birth chart (or natal chart) is a map of where every planet sat — from your point of view on Earth — at the exact moment and place you were born. It records your Sun, Moon, and Rising signs plus the positions of Mercury through Pluto across twelve houses.',
  },
  {
    q: 'Do I need my exact birth time?',
    a: 'For your rising sign and houses, yes — the ascendant changes roughly every two hours. Without a time, we use 12:00 local civil time as a reference for body positions and omit the rising sign, angles, and houses. Because the Moon can change sign during a day, the result marks the Moon sign as unverified until you add a time. Birth certificates, baby books, and parents are the usual sources.',
  },
  {
    q: 'How accurate is this calculator?',
    a: 'Planetary positions are computed with an astronomical engine and tested against NASA JPL reference data to within a few hundredths of a degree. Historical clock changes from 1970 on are resolved from the IANA time-zone history supplied by your browser or device runtime, and earlier ones from a pinned release of the IANA database, including the older records it keeps apart for places whose clocks later matched another city’s, which its maintainers consider less reliable. A birth from before its place adopted a legal time uses the local mean time of the birthplace itself.',
  },
  {
    q: 'What happens to my birth data?',
    a: 'The entire chart is computed in your browser; the calculator uses no server-side chart API and needs no account. If you save a chart, it stays on this device first; optional account sync uploads saved charts only after you sign in.',
  },
  {
    q: 'Whole sign or Placidus houses — which should I pick?',
    a: 'Whole sign is the oldest system and the friendliest to read: each house is one full sign. Placidus is the most common modern default and divides houses by time of rising, so their sizes vary. Try both — your planets stay put; only the house boundaries move.',
  },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    name: 'Free Birth Chart Calculator',
    url: 'https://zodiacs.org/birth-chart/',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: 'Sun, Moon, Rising, planets Mercury–Pluto, True Node, whole sign and Placidus houses, aspects',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://zodiacs.org/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Birth chart calculator', item: 'https://zodiacs.org/birth-chart/' },
    ],
  },
];
---
<Base
  clientUi
  glass
  inlineCriticalCss
  title="Free Birth Chart Calculator — Sun, Moon & Rising | Zodiacs.org"
  description="Calculate your free birth chart: sun, moon, rising, planets, houses, and what they mean — computed privately, in your browser."
  path="/birth-chart/"
  image="/assets/og/v2/tool/birth-chart.png"
  imageAlt="Free birth chart calculator — Zodiacs.org"
  jsonLd={jsonLd}
>
  <script slot="head" is:inline>
    try {
      var chartShareParams = new URLSearchParams(location.hash.slice(1));
      if (chartShareParams.has('p') || chartShareParams.has('c')) {
        document.documentElement.dataset.chartShareReceiver = '';
        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('a[href="/astrofolio/"],a[href^="/registry/"],a[href^="/sdk/"]').forEach(function (element) {
            if (element.closest('[data-nav], [data-mobile-menu]')) return;
            var footerWing = element.closest('.footer__col, .zfooter__group');
            (footerWing || element).remove();
          });
        }, { once: true });
      }
    } catch (error) {}
  </script>
  <style slot="head" is:inline>
    html[data-chart-share-receiver] a[href="/astrofolio/"]:not([data-nav] a, [data-mobile-menu] a),
    html[data-chart-share-receiver] a[href^="/registry/"],
    html[data-chart-share-receiver] a[href^="/sdk/"],
    html[data-chart-share-receiver] .calc__record,
    html[data-chart-share-receiver] [data-registry-aura-chart-link],
    html[data-chart-share-receiver] .footer__col:has(a[href^="/registry/"]),
    html[data-chart-share-receiver] .zfooter__group:has(a[href^="/registry/"]) { display: none !important; }

    /* Hydrated chart diagrams have intrinsic widths. Contain the full reading
       on this route while preserving the placements table's local scroller. */
    html { overflow-x: clip; }
    .calc,
    .calc__result {
      min-width: 0;
      max-width: 100%;
    }
    .calc__result > * { min-width: 0; max-width: 100%; }
  </style>
  <section class="section--tight container">
    <div class="tool-hero">
      <h1 class="display">Get your free birth chart.</h1>
      <p>
        See your Sun, Moon, rising sign, and what they mean.
      </p>
    </div>

    <ChartCalculator mode="full" client:idle />
    <EmailCapture placement="chart" revealOnChart postChartManaged={postChartDailyEnabled}>
      {postChartDailyEnabled && (
        <PostChartDailyBrief slot="post-chart" idPrefix="email-chart-en" client:load />
      )}
    </EmailCapture>
    <noscript>
      <p>This birth chart calculator needs JavaScript. Enable it and reload to calculate your Sun, Moon, rising sign, planets, and houses in your browser.</p>
    </noscript>
  </section>

  <section class="section--tight container container--narrow">
    <div class="prose">
      <h2>What you're looking at</h2>
      <p>
        A <a href="/learn/glossary/#birth-chart">birth chart</a> is a snapshot of the sky from where you were born, at the
        minute you were born. The wheel shows the twelve signs around the
        outside, the twelve houses inside, and each planet placed at its exact{' '}
        <AstroTerm term="degree" label="degree" surface="birth-chart-page" />. Three <AstroTerm term="placement" label="placements" surface="birth-chart-page" /> carry most of the story for beginners:
      </p>
      <ul>
        <li><strong>Sun</strong> — your core identity; the sign most people already know.</li>
        <li><strong>Moon</strong> — your emotional weather; how you feel and recharge.</li>
        <li><strong>Rising</strong> (ascendant) — the sign coming over the eastern horizon as you were born; how people first read you, and what lays out your houses.</li>
      </ul>
      <p>
        The lines across the middle are <a href="/learn/glossary/#aspect">aspects</a> — angles between planets that
        astrologers read as conversations: trines flow, squares argue
        productively, oppositions negotiate.
      </p>
      <p>
        Prefer to learn the shape of a chart before running your numbers?{' '}
        <a href="/learn/how-to-read-a-birth-chart/">How to read a birth
        chart</a> walks the same four steps the results do, and{' '}
        <a href="/birth-chart/three-dimensions/">the birth chart in three
        dimensions</a> covers what the flat wheel leaves out.
      </p>
      <EvidenceDisclosure
        label="How this chart is calculated"
        description="Coordinates, house system, and astronomical checks"
      >
        <p>
          Every chart lists the exact time and place used, its coordinates, and
          its <AstroTerm term="house-system" label="house system" surface="birth-chart-page" />. Planetary
          positions are checked against astronomical reference data.
        </p>
        <p class="evidence-disclosure__links"><a href="/methodology/">Read the full methodology →</a></p>
      </EvidenceDisclosure>
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <div class="section-head"><h2>Questions, answered</h2></div>
    <div class="faq">
      {faq.map(({ q, a }) => (
        <details class="faq__item">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .tool-hero { max-width: 62ch; margin-bottom: clamp(20px, 3vw, 32px); }
  .tool-hero h1 {
    margin: 0 0 16px;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1.04;
    font-variant-numeric: oldstyle-figures;
    text-wrap: balance;
  }
  .tool-hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }
  .faq { display: grid; gap: 8px; }
  .faq__item {
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: var(--void-1);
    padding: 4px 18px;
  }
  .faq__item summary {
    cursor: pointer;
    padding: 12px 0;
    font-weight: 550;
    color: var(--text);
  }
  .faq__item p { margin: 2px 0 16px; color: var(--text-2); font-size: var(--text-sm); line-height: 1.65; }
</style>
