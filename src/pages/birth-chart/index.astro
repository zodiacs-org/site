            <span class="kfacts"><span>{SAMPLE_BIRTH.date}</span><span class="bc-proof__time">{SAMPLE_BIRTH.time}</span><span>{SAMPLE_BIRTH.place}</span></span>
          </div>
          <div class="bc-proof__wheel bc-wheel">
            <Wheel {...SAMPLE_WHEEL} size={WHEEL_SIZE} deferIcons ariaLabel="Sample birth chart wheel" />
          </div>
          <div class="bc-proof__b3">
            {[['Sun', sun], ['Moon', moon], ['Rising', rising]].map(([label, p]) => (
              <div>
                <img class="bc-disc" data-sample-src={sampleDisc((p as typeof sun).sign.slug)} width="34" height="34" alt="" decoding="async" />
                <span><small>{label as string}</small><b>{(p as typeof sun).sign.name}</b><span class="bc-mono">{(p as typeof sun).degree}</span></span>
              </div>
            ))}
          </div>
        </figure>
        <p class="bc-proof__cap">
          <b>A real calculation, not an illustration.</b>
          {SAMPLE_HOURS_AFTER_FULL_MOON !== null && ` This person was born about ${SAMPLE_HOURS_AFTER_FULL_MOON === 1 ? 'an hour' : `${['', '', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven'][SAMPLE_HOURS_AFTER_FULL_MOON]} hours`} after a full moon, so the Sun and Moon sit almost exactly opposite each other on the wheel.`}
        </p>
      </aside>
    </div>
  </section>

