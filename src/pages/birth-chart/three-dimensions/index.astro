---
import Base from '../../../layouts/Base.astro';
import DepthFigure from '../../../components/DepthFigure.astro';
import demoChart from '../../../data/demo-chart-frida.json';
import { EDITOR_AUTHOR } from '../../../lib/editorial';
import { meanObliquity, ramcOf } from '../../../lib/engine/houses';
import {
  altitudeOf,
  declinationOf,
  gmstHours,
  julianCenturies,
  zenithOf,
} from '../../../lib/wheel/ecliptic3d';

/**
 * The Kahlo figures consume the same committed engine fixture as the homepage
 * demo. Horizon, sect, and declination values are then derived here from that
 * UTC instant and those engine positions instead of being copied by hand.
 */
const KAHLO = { asc: demoChart.angles.asc, latitude: 19.35, longitude: -99.16 };
const KAHLO_UTC_MS = Date.parse(demoChart.utc);
const KAHLO_UTC_LABEL = `${demoChart.utc.replace('T', ' ').slice(0, 19)} UTC`;
const KAHLO_BODIES = demoChart.bodies
  .filter(({ body }) => !body.includes('Node'))
  .map(({ body, lon, lat }) => ({ body, lon, lat }));
const KAHLO_OBLIQUITY = meanObliquity(julianCenturies(KAHLO_UTC_MS));
const KAHLO_ZENITH = zenithOf(
  ramcOf({ gastHours: gmstHours(KAHLO_UTC_MS), longitude: KAHLO.longitude }),
  KAHLO.latitude,
  KAHLO_OBLIQUITY,
);
const KAHLO_SUN = KAHLO_BODIES.find(({ body }) => body === 'Sun')!;
const KAHLO_MARS = KAHLO_BODIES.find(({ body }) => body === 'Mars')!;
const KAHLO_SUN_ALTITUDE = altitudeOf(KAHLO_SUN.lon, KAHLO_SUN.lat, KAHLO_ZENITH);
const KAHLO_MARS_DECLINATION = Math.abs(
  declinationOf(KAHLO_MARS.lon, KAHLO_MARS.lat, KAHLO_OBLIQUITY),
);
const KAHLO_MARS_EXCESS = KAHLO_MARS_DECLINATION - KAHLO_OBLIQUITY;
const KAHLO_SOURCE_URL = 'https://www.astro.com/astro-databank/Kahlo%2C_Frida';

const GREENWICH = { asc: 205.447 };
const GREENWICH_BODIES = [
  { body: 'Sun', lon: 125.443, lat: 0, dim: true },
  { body: 'Moon', lon: 293.063, lat: -3.138 },
  { body: 'Mercury', lon: 107.327, lat: -3.042, dim: true },
  { body: 'Venus', lon: 170.399, lat: 0.271, ringed: true },
  { body: 'Mars', lon: 80.696, lat: 0.046, dim: true },
  { body: 'Jupiter', lon: 126.186, lat: 0.472, dim: true },
  { body: 'Saturn', lon: 14.745, lat: -2.509, ringed: true },
  { body: 'Uranus', lon: 64.891, lat: -0.154, dim: true },
  { body: 'Neptune', lon: 4.304, lat: -1.387, dim: true },
  { body: 'Pluto', lon: 304.257, lat: -4.274, dim: true },
];
/** Venus sits at +4.05° declination, Saturn at +3.50°; the shared ring is drawn at their mean. */
const VENUS_SATURN_RING = 3.77;

const SECT_BODIES = ['Sun', 'Moon', 'Jupiter', 'Saturn', 'Venus', 'Mars'].map((body) => ({
  ...KAHLO_BODIES.find((placement) => placement.body === body)!,
  ringed: body === 'Sun',
  dim: body !== 'Sun' && body !== 'Moon',
}));

const faq = [
  {
    q: 'What is declination in astrology?',
    a: 'Declination is a body’s angle north or south of the celestial equator, a different measurement from its zodiac position, which runs along the ecliptic. Two planets can stand far apart on the wheel and still share a declination. This site computes it for the ten Sun-through-Pluto bodies in the birth chart’s three-dimensional view.',
  },
  {
    q: 'What is an out-of-bounds planet?',
    a: `A planet is out of bounds when its declination passes ±23.44°, further north or south of the celestial equator than the Sun ever travels. The Moon and Mercury go out of bounds most often, Venus and Mars less often, and the Sun never can. The limit is the Sun’s own path. In this published-time Frida Kahlo sample, Mars is ${KAHLO_MARS_DECLINATION.toFixed(1)}° south, well past it.`,
  },
  {
    q: 'What is a parallel aspect?',
    a: 'A parallel joins two bodies at the same declination on the same side of the celestial equator, and is traditionally read much like a conjunction. A contraparallel, equal declinations on opposite sides, reads like an opposition. Both are invisible on a flat chart wheel, which plots zodiac longitude only. This site marks them within 1° of exact, or 1.5° when the Sun or Moon is involved.',
  },
  {
    q: 'What is a day chart?',
    a: 'A chart is a day chart when the Sun stood above the horizon at the moment of birth, and a night chart when it sat below, the division traditional astrology calls sect. Sun, Jupiter, and Saturn belong to the day; Moon, Venus, and Mars to the night; Mercury goes with the half it rises in. It takes a birth time and place to answer, because it takes a horizon.',
  },
];

const PAGE_URL = 'https://zodiacs.org/birth-chart/three-dimensions/';
const jsonLd = [
  {
    '@type': 'Article',
    headline: 'The birth chart in three dimensions',
    url: PAGE_URL,
    datePublished: '2026-07-28T18:50:00+07:00',
    dateModified: '2026-09-23T00:00:00+07:00',
    author: EDITOR_AUTHOR,
    publisher: { '@id': 'https://zodiacs.org/#org' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': PAGE_URL },
    inLanguage: 'en',
    about: 'What the flat chart wheel leaves out: ecliptic latitude, declination and out-of-bounds planets, parallel and contraparallel aspects, the horizon, and sect.',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Birth chart calculator', item: 'https://zodiacs.org/birth-chart/' },
      { '@type': 'ListItem', position: 3, name: 'The chart in three dimensions', item: PAGE_URL },
    ],
  },
];
---
<Base
  title="The Birth Chart in Three Dimensions | Declination, Parallels, Sect | Zodiacs.org"
  description="What the flat chart wheel leaves out: declination and out-of-bounds planets, parallel aspects across the whole zodiac, and whether yours is a day or night chart."
  path="/birth-chart/three-dimensions/"
  image="/assets/og/v2/tool/birth-chart.png"
  imageAlt="The birth chart in three dimensions, Zodiacs.org"
  type="article"
  jsonLd={jsonLd}
>
  <section class="section container container--narrow">
    <h1 class="display td-title">The birth chart in three dimensions.</h1>
    <p class="td-lead">
      A chart wheel records one angle for each planet: its position around the
      zodiac. The sky has more angles than that, and the ones the wheel drops
      (how far a body sits from the Sun's path, how far from the celestial
      equator, whether it stood above your horizon) carry readings of their
      own. This page walks through them on two real charts. To turn the sphere
      yourself, <a href="/birth-chart/">calculate your chart</a> and press
      “See it in three dimensions”.
    </p>

    <DepthFigure
      bodies={KAHLO_BODIES}
      asc={KAHLO.asc}
      latitude={KAHLO.latitude}
      longitude={KAHLO.longitude}
      utcMs={KAHLO_UTC_MS}
      showHorizon
      showBounds
      caption={`Frida Kahlo’s chart as an armillary sphere: the zodiac band, the celestial equator, her horizon for ${KAHLO_UTC_LABEL} at Coyoacán, and each body at its real height above or below the ecliptic plane.`}
    />
    <p class="td-source">
      Sample provenance: <a href={KAHLO_SOURCE_URL} target="_blank" rel="noopener noreferrer">the published Astro-Databank record</a>
      {' '}reports 8:30 a.m. in Coyoacán and labels the time AA (birth record). The calculator reads that time on Coyoacán’s own local mean time and converts it to {KAHLO_UTC_LABEL}; Zodiacs.org has not independently inspected the underlying record.
    </p>

    <div class="prose">
      <h2 id="latitude">The wheel is a shadow</h2>
      <p>
        Every planet's position is a direction in space, and the wheel keeps
        only the part of that direction that runs along the ecliptic, the
        Sun's apparent path. The other part, ecliptic latitude, is computed
        for every chart and then flattened away. It is not small. Between 1930
        and 2030, Pluto strays up to 17.7° from the plane, Venus up to 8.0°,
        the Moon up to 5.3°. The Sun alone always reads 0.0°, because the Sun
        is what defines the plane. In the sphere above, that discarded angle
        is simply visible: each stem is the distance the wheel was hiding.
      </p>

      <h2 id="declination">Declination, the second angle</h2>
      <p>
        Measure from the celestial equator instead of the ecliptic and you get
        declination, the same north-south angle that decides where on Earth a
        star can pass overhead. Because the two reference circles tilt 23.44°
        against each other, a body's declination is not a restatement of its
        zodiac position; it is independent information the wheel has no room
        for.
      </p>
      <h3 id="out-of-bounds">Out of bounds</h3>
      <p>
        The Sun's own declination never passes ±23.44°. That limit is what
        the tropics are. A planet that crosses it is called out of bounds,
        and modern astrological practice often describes it as operating past
        the Sun's rule. In this sample, Mars stands at {KAHLO_MARS_DECLINATION.toFixed(1)}° south declination, {KAHLO_MARS_EXCESS.toFixed(1)}° beyond
        the southern bound. The Moon and Mercury go out of bounds most often;
        the Sun, by definition, never can.
      </p>
    </div>

    <DepthFigure
      bodies={GREENWICH_BODIES}
      asc={GREENWICH.asc}
      showBounds
      declRings={[VENUS_SATURN_RING]}
      chord
      caption="Greenwich noon, 2026-07-28: Venus at 4.1° north declination and Saturn at 3.5° north ride the same circle to within 0.56°, a parallel, while standing 155.7° apart on the wheel. The Moon, at 24.6° south, sits outside the dotted bounds the Sun never passes."
    />

    <div class="prose">
      <h2 id="parallels">Parallels and contraparallels</h2>
      <p>
        Two bodies at the same declination on the same side of the equator are
        parallel, read traditionally as a standing conjunction. Mirrored
        across the equator they are contraparallel, read like an opposition.
        The pair above is the point: Venus and Saturn share a circle to half a
        degree while sitting more than 150° apart in longitude, further than
        any aspect the wheel draws can reach. The same chart carries Mars at
        23.2° north against Pluto at 23.3° south, a contraparallel within
        0.19°. This site marks both families within 1° of exact, 1.5° when
        the Sun or Moon is one of the pair, and the three-dimensional view
        draws the ring the pair shares.
      </p>

      <h2 id="horizon">The horizon makes it yours</h2>
      <p>
        Everything above is true of the sky in general. The horizon is not: it
        belongs to a minute and a place, and it is the circle that turns a sky
        map into somebody's chart. Where it cuts the zodiac on the eastern
        side is the ascendant, the reason birth time matters, and it divides
        every chart into a visible half and a hidden one.
      </p>
    </div>

    <DepthFigure
      bodies={SECT_BODIES}
      asc={KAHLO.asc}
      latitude={KAHLO.latitude}
      longitude={KAHLO.longitude}
      utcMs={KAHLO_UTC_MS}
      showHorizon
      caption={`The same horizon, asking one question: was the Sun above it? In this sample it stood ${KAHLO_SUN_ALTITUDE.toFixed(1)}° high, a day chart, so the Sun leads as sect light, ringed here.`}
    />

    <div class="prose">
      <h2 id="sect">Sect: day charts and night charts</h2>
      <p>
        Whether the Sun stood above or below the horizon at birth divides all
        charts into two families: sect, the oldest sorting rule in the
        tradition. Sun, Jupiter and Saturn are the day's planets; Moon, Venus
        and Mars the night's; whichever team matches the chart is in sect and
        carries more of its weight. Mercury takes the half it rises in: ahead
        of the Sun as a morning star it joins the day, trailing behind as an
        evening star, the night. The chart's own luminary (Sun by day, Moon
        by night) is its sect light. Uranus, Neptune and Pluto sit outside
        the scheme; it was settled long before anyone saw them.
      </p>
      <p>
        None of this needs new data. It falls out of the same birth minute
        and place the chart already asked for, geometry first, doctrine
        second.
      </p>
    </div>

    <aside class="td-cta">
      <p>
        <strong>See your own chart this way.</strong>{' '}The{' '}
        <a href="/birth-chart/">birth chart calculator</a> computes all of it
        in your browser (declinations, out-of-bounds bodies, parallels, sect),
        and the “See it in three dimensions” control under the wheel puts
        you inside the instrument. Terms are defined in the{' '}
        <a href="/learn/glossary/#declination">glossary</a>.
      </p>
    </aside>

    <div class="section-head td-faq-head"><h2>Questions, answered</h2></div>
    <div class="faq">
      {faq.map(({ q, a }) => (
        <details class="faq__item">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .td-title { max-width: 16ch; margin: 13px 0 14px; }
  .td-lead {
    max-width: 64ch;
    margin: 0 0 8px;
    color: var(--muted);
    font-size: var(--text-lg);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .td-source {
    max-width: 72ch;
    margin: -2px 0 24px;
    color: var(--text-2);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .prose h2 { margin-top: 34px; }
  .prose h3 { margin-top: 22px; }
  .td-cta {
    margin: 34px 0 8px;
    padding: 18px 20px;
    border: 1px solid var(--hair-1, #242936);
    border-radius: 12px;
    transition: border-color var(--dur-1) var(--ease);
  }
  .td-cta:focus-within { border-color: var(--hair-3); }
  @media (hover: hover) and (pointer: fine) { .td-cta:hover { border-color: var(--hair-2); } }
  .td-cta p { margin: 0; line-height: 1.6; text-wrap: pretty; }
  .td-faq-head { margin-top: 40px; }
  .faq { display: grid; gap: 8px; }
  .faq__item {
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: var(--void-1);
    padding: 4px 18px;
  }
  .faq__item summary {
    cursor: pointer;
    padding: 12px 0;
    font-weight: 550;
    color: var(--text);
  }
  .faq__item p { margin: 2px 0 16px; color: var(--text-2); font-size: var(--text-sm); line-height: 1.65; }
</style>
