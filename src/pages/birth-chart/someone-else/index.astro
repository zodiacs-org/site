---
import Base from '../../../layouts/Base.astro';
import SomeoneElseChart from '../../../islands/SomeoneElseChart';

const jsonLd = [
  {
    '@type': 'WebApplication',
    name: "Someone else's birth chart",
    url: 'https://zodiacs.org/birth-chart/someone-else/',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'A permission-first way to open another person’s chart from birth details, their Big Three, or a Zodiacs chart link.',
  },
];
---
<Base
  clientUi
  title="Someone Else’s Birth Chart | Zodiacs.org"
  description="Open someone else’s astrology chart with their permission, using birth details, the Big Three, or a Zodiacs chart link."
  path="/birth-chart/someone-else/"
  image="/assets/og/v2/tool/birth-chart.png"
  imageAlt="Someone else’s birth chart — Zodiacs.org"
  jsonLd={jsonLd}
  glass
>
  <section class="section--tight container container--narrow someone-else-hero">
      <em class="kicker">Their chart, with permission</em>
      <h1 class="display">Add someone else’s chart.</h1>
      <p>
        Read their full chart or compare it with yours using what they shared:
        birth details, their Sun–Moon–Rising, or a Zodiacs chart link.
      </p>
  </section>

  <section class="section--tight container container--narrow">
    <SomeoneElseChart client:load />
    <noscript>
      <p>This flow needs JavaScript to validate private chart links and hand birth details to the on-device calculator.</p>
    </noscript>
  </section>

  <section class="section--tight container container--narrow someone-else-method">
    <h2>What each option can do</h2>
    <div>
      <article>
        <strong>Full birth details</strong>
        <p>Produces the full chart: planets, houses, angles, aspects, and the guided reading.</p>
      </article>
      <article>
        <strong>The Big Three</strong>
        <p>Gives you a limited sign profile and a Sun-sign pairing guide, without pretending to know houses, aspects, or timing.</p>
      </article>
      <article>
        <strong>A Zodiacs link</strong>
        <p>Reuses exactly what they chose to share. A positions-only link has no name, date, time or place fields. Its exact positions still give the birth date and, when there is a birth time, the time and the birthplace roughly: an area about 110 km wide and hundreds of kilometres long near the equator, smaller nearer the poles, and near the Arctic Circle sometimes a strip less than a kilometre from north to south. A link made by an earlier version of the site for a birth before standard time can narrow it to strips about 3 km wide.</p>
      </article>
    </div>
  </section>
</Base>

<style>
  .someone-else-hero { padding-bottom: 24px; }
  .someone-else-hero h1 {
    max-width: 13ch;
    margin: 13px 0 14px;
    font-size: var(--text-2xl);
    line-height: 1.02;
  }
  .someone-else-hero p { max-width: 61ch; margin: 0; color: var(--muted); font-size: var(--text-lg); line-height: 1.55; text-wrap: pretty; }
  .someone-else-method { padding-top: 54px; }
  .someone-else-method h2 { margin: 0 0 18px; color: var(--text); font-family: var(--font-serif); font-size: var(--text-xl); font-weight: 500; }
  .someone-else-method > div { display: grid; gap: 10px; }
  .someone-else-method article { padding: 18px; border: 1px solid var(--hair-2); border-radius: var(--r-md); background: rgba(198,204,218,0.025); }
  .someone-else-method strong { color: var(--text); }
  .someone-else-method p { margin: 7px 0 0; color: var(--muted); font-size: var(--text-sm); line-height: 1.55; }
  @media (min-width: 720px) { .someone-else-method > div { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
