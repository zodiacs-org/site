---
import Base from '../../layouts/Base.astro';
import { SIGNS } from '../../lib/signs';

const feeds = [
  {
    href: '/feeds/events.xml',
    title: 'Sky events',
    description: 'Full moons, eclipses, stations, sign changes, and rare alignments, with the exact dates ahead.',
  },
  {
    href: '/feeds/daily-sky.xml',
    title: 'Daily sky',
    description: 'Today’s Moon phase, planetary positions, retrogrades, and timed sky events in one feed.',
  },
  {
    href: '/feeds/horoscopes.xml',
    title: 'Daily horoscopes',
    description: 'A clear daily focus and one useful move for all twelve signs.',
  },
  {
    href: '/feeds/almanac.xml',
    title: 'The Almanac',
    description: 'New long-form essays about the current sky and how astrology reads it.',
  },
];

const signFeeds = SIGNS.map((sign) => ({
  href: `/feeds/horoscopes/${sign.slug}.xml`,
  title: `${sign.name} horoscope`,
}));
const allFeeds = [...feeds, ...signFeeds];

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'Zodiacs.org RSS feeds',
    url: 'https://zodiacs.org/feeds/',
    description: 'Follow daily horoscopes, the current sky, and new Almanac essays in any RSS reader.',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: allFeeds.map((feed, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: feed.title,
        url: `https://zodiacs.org${feed.href}`,
      })),
    },
  },
];
---
<Base
  title="RSS Feeds | Daily Sky, Horoscopes & Almanac | Zodiacs.org"
  description="Follow daily horoscopes, the current sky, and new long-form Almanac essays through Zodiacs.org RSS feeds."
  path="/feeds/"
  jsonLd={jsonLd}
>
  <section class="section container container--narrow feeds">
    <em class="kicker">RSS feeds</em>
    <h1 class="display">Follow the sky on your own terms.</h1>
    <p class="feeds__lede">
      Subscribe in any RSS reader. Follow the whole sky, get one concise reading
      for every sign, or choose just yours. The Almanac feed updates when a new
      essay appears. No account or notification permission needed.
    </p>

    <div class="feeds__list">
      {feeds.map((feed) => (
        <a class="tile feeds__item" href={feed.href} type="application/rss+xml">
          <span>
            <strong>{feed.title}</strong>
            <p>{feed.description}</p>
          </span>
          <span class="feeds__go" aria-hidden="true">RSS →</span>
        </a>
      ))}
    </div>

    <div class="feeds__signs">
      <div class="feeds__signs-head">
        <em class="kicker">One sign only</em>
        <p>Choose a sun sign for a quieter, single-item daily feed.</p>
      </div>
      <div class="feeds__sign-grid">
        {signFeeds.map((feed) => (
          <a class="tile feeds__sign" href={feed.href} type="application/rss+xml">
            <span>{feed.title}</span>
            <span aria-hidden="true">RSS →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .feeds { display: grid; gap: 18px; }
  .feeds h1 { margin: 4px 0 0; font-size: var(--text-2xl); line-height: 1.04; }
  .feeds__lede { margin: 0; max-width: 58ch; color: var(--muted); font-size: var(--text-lg); line-height: 1.6; }
  .feeds__list { display: grid; gap: 10px; margin-top: 14px; }
  .feeds__item {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 20px;
    color: var(--text);
    text-decoration: none;
  }
  .feeds__item strong { font-size: var(--text-lg); }
  .feeds__item p { margin: 6px 0 0; color: var(--text-2); font-size: var(--text-sm); line-height: 1.6; }
  .feeds__go { flex: none; align-self: center; color: var(--faint); font-family: var(--font-mono); font-size: 11px; }
  .feeds__signs { display: grid; gap: 14px; margin-top: 18px; padding-top: 24px; border-top: 1px solid var(--hair-2); }
  .feeds__signs-head { display: grid; gap: 6px; }
  .feeds__signs-head p { margin: 0; color: var(--muted); font-size: var(--text-sm); }
  .feeds__sign-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .feeds__sign {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 14px;
    color: var(--text-2);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .feeds__sign span:last-child { color: var(--faint); font-family: var(--font-mono); font-size: 10px; }
  @media (min-width: 720px) {
    .feeds__sign-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
