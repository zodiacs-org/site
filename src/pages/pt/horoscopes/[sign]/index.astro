---
// Horóscopo diário de cada signo em português: a página fica em LocalizedHoroscope.
import LocalizedHoroscope from '../../../../components/localized/LocalizedHoroscope.astro';
import { SIGNS } from '../../../../lib/signs';

export function getStaticPaths() {
  return SIGNS.map((sign) => ({ params: { sign: sign.slug } }));
}
---
<LocalizedHoroscope locale="pt" signSlug={Astro.params.sign!} />
