---
import Base from '../../../../layouts/Base.astro';
import DailyLocaleReading from '../../../../components/DailyLocaleReading.astro';
import dailyData from '../../../../data/daily.json';
import type { Daily } from '../../../../lib/daily';
import { dailyReadingForLocale } from '../../../../lib/i18n/daily-reading';
import { formatDate } from '../../../../lib/i18n/dates';
import { moonPhaseLabel } from '../../../../lib/i18n/astrology';
import { englishOnlyCue } from '../../../../lib/i18n/english-only';
import { SIGNS, signBySlug, signDates, signName } from '../../../../lib/signs';

export function getStaticPaths() {
  return SIGNS.map((sign) => ({ params: { sign: sign.slug } }));
}

const locale = 'pt' as const;
const daily = dailyData as Daily;
const sign = signBySlug(Astro.params.sign!);
const name = signName(sign, locale);
const reading = dailyReadingForLocale(sign.slug, daily, locale);
const dateLabel = formatDate(locale, `${daily.date}T12:00:00Z`, {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
// O título usa a data sem o ano para caber em 60 caracteres com o nome de signo mais longo.
const titleDate = formatDate(locale, `${daily.date}T12:00:00Z`, {
  day: 'numeric', month: 'long', timeZone: 'UTC',
});
const cue = englishOnlyCue(locale);
const description = `Horóscopo de ${name} hoje, ${dateLabel}: ${reading.lines.length} notas lidas pelas casas solares do signo, com as posições reais do céu e seus registros.`;
---
<Base
  title={`Horóscopo de ${name} hoje, ${titleDate} | Zodiacs.org`}
  description={description}
  path={`/pt/horoscopes/${sign.slug}/`}
  locale={locale}
  editionDate={daily.date}
  image={`/assets/og/v2/sign/${sign.slug}.png`}
  imageAlt={`${name} — horóscopo de hoje — Zodiacs.org`}
>
  <section class="section--tight container container--narrow" data-edition-content="true" style={`--sign:${sign.hue}`}>
    <header class="sign-pt__hero">
      <em class="kicker">Horóscopo diário · {dateLabel}</em>
      <h1 class="display">
        <img src={`/assets/zodiac-icons/128/${sign.slug}.webp`} width="44" height="44" alt="" decoding="async" />
        {name} hoje
      </h1>
      <p class="sign-pt__lead">{reading.headline}</p>
      <span class="sign-pt__stamp mono">{signDates(sign, locale)} · {moonPhaseLabel(locale, daily.moon.phase)}</span>
    </header>

    <div class="sign-pt__reading shell tinted">
      <div class="core tinted sign-pt__core">
        <DailyLocaleReading locale={locale} reading={reading} />
      </div>
    </div>

    <nav class="sign-pt__links" aria-label="Mais sobre este signo">
      <a class="btn btn--glass" href={`/pt/${sign.slug}/`}><span>Guia de {name}</span><span class="orb">→</span></a>
      <a class="btn btn--ghost" href="/pt/horoscopes/"><span>Todos os signos</span><span class="orb">→</span></a>
      <a class="btn btn--ghost" href={`/horoscopes/${sign.slug}/`} hreflang="en" title={cue?.aria}>
        <span>Amanhã, semana e mês{cue?.suffix}</span><span class="orb">↗</span>
      </a>
    </nav>

    <p class="sign-pt__note">
      Estas notas são lidas a partir do signo solar. Com a sua hora e o seu local de nascimento, o{' '}
      <a href="/pt/birth-chart/">mapa astral grátis</a> mostra em que casa cada trânsito cai para você.
    </p>
  </section>
</Base>

<style>
  .sign-pt__hero { max-width: 62ch; margin-bottom: clamp(22px, 4vw, 34px); }
  .sign-pt__hero h1 { display: flex; align-items: center; gap: 12px; margin: 14px 0; font-size: var(--text-2xl); line-height: 1.04; }
  .sign-pt__hero h1 img { border-radius: 50%; }
  .sign-pt__lead { margin: 0; color: var(--text-2); font-size: var(--text-lg); text-wrap: pretty; }
  .sign-pt__stamp { display: block; margin-top: 14px; color: var(--faint); font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; }
  .sign-pt__core { padding: 22px 20px; }
  .sign-pt__links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: clamp(18px, 3vw, 26px); }
  .sign-pt__note { margin-top: clamp(18px, 3vw, 26px); color: var(--muted); font-size: var(--text-sm); }
  .sign-pt__note a { color: var(--text); }
</style>
