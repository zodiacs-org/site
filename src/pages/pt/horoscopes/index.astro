---
import Base from '../../../layouts/Base.astro';
import dailyData from '../../../data/daily.json';
import type { Daily } from '../../../lib/daily';
import { dailyReadingForLocale } from '../../../lib/i18n/daily-reading';
import { formatDate } from '../../../lib/i18n/dates';
import { englishOnlyCue } from '../../../lib/i18n/english-only';
import { SIGNS, signDates, signName } from '../../../lib/signs';

const locale = 'pt' as const;
const daily = dailyData as Daily;
const dateLabel = formatDate(locale, `${daily.date}T12:00:00Z`, {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
const cards = SIGNS.map((sign) => {
  const reading = dailyReadingForLocale(sign.slug, daily, locale);
  return { sign, teaser: reading.lines.find((line) => line.house !== undefined)?.text ?? reading.headline };
});
const cue = englishOnlyCue(locale);
const description = `Horóscopos de hoje, ${dateLabel}: uma nota clara para cada um dos doze signos, calculada a partir das posições reais do céu.`;
---
<Base
  title={`Horóscopos de hoje — ${dateLabel} | Zodiacs.org`}
  description={description}
  path="/pt/horoscopes/"
  locale={locale}
  editionDate={daily.date}
  image="/assets/og/v2/tool/horoscopes.png"
  imageAlt="Horóscopos de hoje para os doze signos — Zodiacs.org"
>
  <section class="section--tight container container--narrow" data-edition-content="true">
    <div class="horo-pt__hero">
      <em class="kicker">Edição diária · {dateLabel}</em>
      <h1 class="display">Horóscopos de hoje</h1>
      <p>
        Encontre o seu signo para a nota mais concreta do céu de hoje. Leia primeiro o seu signo solar e, se souber,
        o seu ascendente também.
      </p>
    </div>

    <div class="horo-pt__grid">
      {cards.map(({ sign, teaser }) => (
        <a class="tile horo-pt__card" href={`/pt/horoscopes/${sign.slug}/`} style={`--sign:${sign.hue}`}>
          <img src={`/assets/zodiac-icons/48/${sign.slug}.webp`} width="48" height="48" alt="" loading="lazy" decoding="async" />
          <span class="horo-pt__name">{signName(sign, locale)}</span>
          <span class="horo-pt__dates mono">{signDates(sign, locale)}</span>
          <span class="horo-pt__teaser">{teaser}</span>
          <span class="horo-pt__go mono">Ler hoje →</span>
        </a>
      ))}
    </div>

    <p class="horo-pt__note">
      Quer uma visão mais pessoal? <a href="/pt/birth-chart/">Calcule o seu mapa astral grátis</a>. As leituras de
      amanhã, da semana e do mês estão na{' '}
      <a href="/horoscopes/" hreflang="en" title={cue?.aria}>edição em inglês{cue?.suffix}</a>.
    </p>
  </section>
</Base>

<style>
  .horo-pt__hero { max-width: 62ch; margin-bottom: clamp(26px, 5vw, 42px); }
  .horo-pt__hero h1 { margin: 14px 0; font-size: var(--text-2xl); line-height: 1.04; }
  .horo-pt__hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }
  .horo-pt__grid { display: grid; gap: 10px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 700px) { .horo-pt__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .horo-pt__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .horo-pt__card {
    display: grid; justify-items: center; gap: 8px; min-width: 0; padding: 22px 14px 17px;
    color: var(--text); text-align: center; text-decoration: none;
  }
  .horo-pt__card img { border-radius: 50%; }
  .horo-pt__name { font-weight: 650; letter-spacing: -0.01em; }
  .horo-pt__dates { color: var(--faint); font-size: 10px; letter-spacing: 0.06em; }
  .horo-pt__teaser {
    margin-top: 6px; padding-top: 10px; border-top: 1px solid var(--hair-1);
    color: var(--text-2); font-size: 12px; line-height: 1.5; text-wrap: pretty;
  }
  .horo-pt__go { margin-top: 4px; color: var(--faint); font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; }
  .horo-pt__card:hover .horo-pt__go { color: var(--text); }
  .horo-pt__note { margin-top: clamp(22px, 4vw, 34px); color: var(--muted); font-size: var(--text-sm); }
  .horo-pt__note a { color: var(--text); }
  @media (max-width: 460px) { .horo-pt__grid { grid-template-columns: 1fr; } }
</style>
