---
import Base from '../../layouts/Base.astro';
import SignIcon from '../../components/SignIcon.astro';
import { SIGNS, signName } from '../../lib/signs';
---
<Base
  title="Página não encontrada — Zodiacs.org"
  description="Esta página não existe. Experimente um guia de signo ou calcule seu mapa astral gratuitamente."
  path="/pt/404/"
  locale="pt"
  noindex
>
  <section class="section container nf">
    <h1 class="display">Esta página não existe.</h1>
    <p class="dateline">Erro 404</p>
    <p>O que você procurava mudou de lugar ou nunca existiu. Os doze signos continuam aqui:</p>
    <div class="nf__signs">
      {SIGNS.map((s) => (
        <a href={`/pt/${s.slug}/`} aria-label={signName(s, 'pt')} style={`--sign:${s.hue}`}>
          <SignIcon sign={s.slug} size={40} />
        </a>
      ))}
    </div>
    <div class="nf__ctas">
      <a class="btn btn--primary" href="/pt/"><span>Voltar ao início</span><span class="orb">→</span></a>
      <a class="btn btn--ghost" href="/pt/birth-chart/"><span>Calcule seu mapa astral grátis</span></a>
    </div>
  </section>
</Base>

<style>
  .nf { text-align: center; display: grid; justify-items: center; gap: 18px; }
  .nf h1 { margin: 6px 0 0; font-size: var(--text-2xl); max-width: 16ch; }
  .nf p { margin: 0; max-width: 44ch; color: var(--muted); }
  .nf__signs { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: 10px 0; max-width: 560px; }
  .nf__signs a { display: grid; place-items: center; padding: 6px; border-radius: 50%; border: 1px solid transparent; }
  .nf__ctas { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
</style>
