---
import ReturnToolLinks from "../../../components/return-visits/ReturnToolLinks.astro";
import SharingToolLinks from '../../../components/sharing/SharingToolLinks.astro';
import Base from '../../../layouts/Base.astro';
import ToolIcon from '../../../components/ToolIcon.astro';
import ToolsHelpCard from '../../../components/tools/ToolsHelpCard.astro';
import ToolsLead from '../../../components/tools/ToolsLead.astro';
import ToolsPageHeading from '../../../components/ToolsPageHeading.astro';
import { ENGLISH_ONLY_COPY, localizePath, t } from '../../../lib/i18n';
import { toolIconForPath } from '../../../lib/tool-icons';
import '../../../styles/tools-hub.css';

const englishOnly = ENGLISH_ONLY_COPY.pt;
const tools = [
  { href: '/birth-chart/', title: 'Calculadora de mapa astral', promise: 'Veja seu Sol, sua Lua, seu ascendente, seus planetas, suas casas e o que tudo isso significa.' },
  { href: '/birth-chart/someone-else/', title: 'Mapa de outra pessoa (em inglês)', promise: 'Use os dados de nascimento, os três signos ou um link do Zodiacs, com a permissão dela.', englishOnly: true },
  { href: '/today/', title: 'Hoje', promise: 'O céu de hoje, lido para os doze signos solares.' },
  { href: '/compatibility/', title: 'Compatibilidade', promise: 'Compare dois mapas e veja onde eles se conectam, entram em conflito e crescem.' },
  { href: '/moon-sign/', title: 'Calculadora de signo lunar', promise: 'Como você vive as emoções e o que ajuda a voltar ao seu centro.' },
  { href: '/rising-sign/', title: 'Calculadora de ascendente', promise: 'Descubra como as outras pessoas percebem você de início.' },
  { href: '/moon-phase/', title: 'Fase da Lua', promise: 'A Lua de hoje e a Lua de qualquer data importante para você.' },
  { href: '/saturn-return/', title: 'Retorno de Saturno', promise: 'Quando o seu acontece e o que ele costuma pedir.' },
  { href: '/transits/', title: 'Trânsitos', promise: 'O céu de hoje comparado com seu mapa.' },
];
const [lead, ...rest] = tools;
const iconFor = (href: string) => toolIconForPath(href) ?? 'birth-chart';

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'Ferramentas gratuitas de astrologia',
    url: 'https://zodiacs.org/pt/tools/',
    description: 'Calculadoras gratuitas de astrologia, com os cálculos feitos de forma privada no seu navegador.',
    inLanguage: 'pt-BR',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
];
---
<Base
  title="Ferramentas gratuitas de astrologia | Zodiacs.org"
  description="Calculadoras gratuitas de astrologia: mapa astral, compatibilidade, signo lunar, ascendente, fase da Lua e trânsitos, privadas, no seu navegador."
  path="/pt/tools/"
  locale="pt"
  image="/assets/og/v2/tool/tools.png"
  imageAlt="Ferramentas gratuitas de astrologia, Zodiacs.org"
  jsonLd={jsonLd}
>
  <header class="tools-hub tools-hub--solo kwrap">
    <div class="tools-hub__intro">
      <ToolsPageHeading>Ferramentas gratuitas de astrologia</ToolsPageHeading>
      <p class="klede tools-hub__lede">Descubra seu mapa astral, signo lunar, ascendente, compatibilidade e o que está acontecendo no céu agora. Seus dados são calculados no navegador.</p>
    </div>
    <ToolsLead
      href={localizePath('pt', lead.href)}
      title={lead.title}
      text={lead.promise}
      needs={[t('pt', 'birthDate'), t('pt', 'birthTime'), t('pt', 'birthplace')]}
      cta={t('pt', 'getBirthChart')}
      reassure={t('pt', 'privacyDevice')}
      locale="pt"
    />
  </header>

  <section class="tools-block kwrap">
    <ul class="tools-grid tools-list">
      {rest.map((tool) => (
        <li>
          <a class="tools-row" href={'englishOnly' in tool ? tool.href : localizePath('pt', tool.href)} hreflang={'englishOnly' in tool ? 'en' : undefined} title={'englishOnly' in tool ? englishOnly.aria : undefined} aria-label={'englishOnly' in tool ? `${tool.title}. ${englishOnly.aria}` : undefined}>
            <ToolIcon name={iconFor(tool.href)} size={52} />
            <div class="tool-card">
              <h2>{tool.title}</h2>
              <p>{tool.promise}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="tools-block kwrap">
    <h2 class="tools-section-title">Calendários do céu</h2>
    <ul class="tools-list">
      <li class="tools-row"><ToolIcon name="full-moon-calendar" size={52} /><span class="tools-row__text"><a href="/pt/full-moon-calendar/"><strong>Luas cheias</strong></a>: datas, signos e nomes até 2027.</span></li>
      <li class="tools-row"><ToolIcon name="eclipses" size={52} /><span class="tools-row__text"><a href="/pt/eclipses/"><strong>Eclipses</strong></a>: solares e lunares até 2028.</span></li>
      <li class="tools-row"><ToolIcon name="retrogrades" size={52} /><span class="tools-row__text"><a href="/pt/retrogrades/"><strong>Planetas retrógrados</strong></a>: de Mercúrio a Plutão. <a href="/pt/mercury-retrograde/"><strong>Mercúrio retrógrado</strong></a>: cada período, com as estações.</span></li>
    </ul>
  </section>

  <section class="tools-block kwrap">
    <h2 class="tools-section-title">Também disponível em inglês</h2>
    <ul class="tools-list">
      <li class="tools-row"><ToolIcon name="horoscopes" size={52} /><span class="tools-row__text"><strong>Horóscopos.</strong> O céu de hoje, signo por signo. A edição em inglês também inclui leituras semanais e mensais: <a href="/horoscopes/" hreflang="en" title={englishOnly.aria}>escolher signo</a>.</span></li>
    </ul>
  </section>

  <section class="tools-block kwrap"><SharingToolLinks locale="pt" icons /></section>
  <section class="tools-block kwrap"><ReturnToolLinks locale="pt" current="/saturn-return/" icons /></section>

  <section class="tools-help">
    <div class="kwrap"><div class="tools-help__grid tools-help__grid--one">
      <ToolsHelpCard icon="guide" title="Pergunte ao Guide">
        <p>O Guide pode ajudar com uma ferramenta, um termo astrológico ou um mapa que você salvou aqui.</p>
        <button class="btn btn--sm" type="button" data-assistant-open data-assistant-locale="pt" aria-haspopup="dialog">Iniciar uma conversa</button>
      </ToolsHelpCard>
    </div></div>
  </section>
</Base>
