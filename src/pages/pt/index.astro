---
import Base from '../../layouts/Base.astro';
import SignIcon from '../../components/SignIcon.astro';
import ToolGlyph from '../../components/ToolGlyph.astro';
import SkyTicker from '../../islands/SkyTicker';
import TodayBySign from '../../islands/TodayBySign';
import WelcomeBack from '../../islands/WelcomeBack';
import { SIGNS, signDates, signName } from '../../lib/signs';
import { localizePath } from '../../lib/i18n';
import glassMaps from '../../data/glass-maps.json';
import '../../styles/today.css';

const tools = [
  { href: '/birth-chart/', title: 'Mapa astral', promise: 'Seu Sol, sua Lua, seu ascendente, seus planetas, suas casas e o significado de cada um.', hue: 'var(--sign-cancer)', kind: 'birth' as const },
  { href: '/moon-sign/', title: 'Signo lunar', promise: 'Como você vive as emoções, o que traz calma e do que precisa para se sentir em casa.', hue: 'var(--sign-pisces)', kind: 'moon' as const },
  { href: '/rising-sign/', title: 'Ascendente', promise: 'A primeira impressão que você causa e como seu mapa se organiza.', hue: 'var(--sign-libra)', kind: 'rising' as const },
  { href: '/compatibility/', title: 'Compatibilidade', promise: 'Compare dois mapas e veja onde vocês se conectam, entram em conflito e crescem.', hue: 'var(--sign-leo)', kind: 'compat' as const },
];

const jsonLd = [
  {
    '@type': 'WebSite',
    '@id': 'https://zodiacs.org/#site',
    url: 'https://zodiacs.org/',
    name: 'Zodiacs.org',
    description: 'Mapas astrais grátis, signo lunar, compatibilidade, horóscopos e guias dos signos, privados e fáceis de entender.',
    publisher: { '@id': 'https://zodiacs.org/#org' },
    inLanguage: ['en', 'es', 'pt-BR'],
  },
];
---
<Base
  clientUi
  title="Zodiacs.org em português — mapas astrais grátis e astrologia descomplicada"
  description="Mapas astrais grátis, signo lunar, ascendente, compatibilidade, horóscopos e guias dos signos: precisos, privados e fáceis de entender."
  path="/pt/"
  locale="pt"
  jsonLd={jsonLd}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/assets/hero/zodiacs-hero-poster.avif"
    fetchpriority="high"
  />
  <section class="hero-es container">
    <div class="hero-es__frame">
      <video
        class="hero-es__video"
        data-src="/assets/hero/zodiacs-hero.mp4"
        poster="/assets/hero/zodiacs-hero-poster.avif"
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        aria-hidden="true"
        tabindex="-1"
        data-hero-video-pt
      ></video>
      <button class="hero-motion" type="button" data-home-film-toggle aria-pressed="false">Pausar animação</button>
      <div class="hero-es__scrim" aria-hidden="true"></div>
      <div class="hero-es__content">
        <h1>Seu mapa completo, não apenas seu signo.</h1>
        <div class="hero-es__foot">
          <p>Mapas astrais, signo lunar, compatibilidade e horóscopos grátis: precisos, privados e fáceis de entender.</p>
          <div class="hero-es__ctas">
            <a class="btn btn--primary" href={localizePath('pt', '/birth-chart/')}><span>Faça seu mapa astral grátis</span><span class="orb">↗</span></a>
            <a class="btn btn--ghost hero-es__ghost" href="/pt/horoscopes/"><span>Seu horóscopo</span></a>
          </div>
          <div class="hero-es__trustlines">
            <p class="hero-es__trust">Grátis · Sem cadastro · Calculado no seu navegador</p>
          </div>
        </div>
      </div>
    </div>
    <script is:inline>
      (function () {
        var v = document.querySelector('[data-hero-video-pt]');
        var toggle = document.querySelector('[data-home-film-toggle]');
        if (!v || !toggle) return;
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        var connection = navigator.connection;
        var constrained = connection && (connection.saveData || ['slow-2g','2g'].indexOf(connection.effectiveType) !== -1);
        var paused = false, visible = false;
        try { paused = sessionStorage.getItem('zodiacs:motion-paused') === '1'; } catch (_) {}
        if (paused) { toggle.setAttribute('aria-pressed', 'true'); toggle.textContent = 'Retomar animação'; }
        var requested = window.matchMedia('(min-width: 720px)').matches;
        var play = function () {
          if (paused || !visible || !requested || document.hidden || reduced.matches || constrained) { v.pause(); return; }
          if (!v.getAttribute('src')) { v.src = v.dataset.src; v.preload = 'auto'; }
          var promise = v.play();
          if (promise && promise.catch) promise.catch(function () {});
        };
        toggle.addEventListener('click', function () {
          paused = !paused;
          try { sessionStorage.setItem('zodiacs:motion-paused', paused ? '1' : '0'); } catch (_) {}
          toggle.setAttribute('aria-pressed', String(paused));
          toggle.textContent = paused ? 'Retomar animação' : 'Pausar animação';
          if (paused) { v.pause(); v.removeAttribute('src'); v.load(); }
          else { requested = true; play(); }
        });
        ['pointerdown','keydown'].forEach(function (name) { window.addEventListener(name, function () { requested = true; play(); }, { once:true, passive:true }); });
        if ('IntersectionObserver' in window) new IntersectionObserver(function (entries) { visible = entries[0].isIntersecting; play(); }, { threshold:.01 }).observe(v);
        document.addEventListener('visibilitychange', play);
        reduced.addEventListener && reduced.addEventListener('change', play);
      })();
    </script>

    <!-- Lens filters for the glass chrome: capsule displacement maps ride
         inline so nothing is fetched. Browsers without url() backdrop
         filters never leave the blur floor. -->
    <svg class="glass-defs" aria-hidden="true" focusable="false">
      <filter id="zdx-lens-cta" color-interpolation-filters="sRGB" primitiveUnits="objectBoundingBox" x="-0.1" y="-0.2" width="1.2" height="1.4">
        <feImage href={glassMaps.cta} x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="map" />
        <feDisplacementMap in="SourceGraphic" in2="map" scale="0.5" xChannelSelector="R" yChannelSelector="G" result="disp" />
        <feGaussianBlur in="disp" stdDeviation="0.009 0.038" result="soft" />
        <feColorMatrix in="soft" type="saturate" values="1.4" />
      </filter>
      <filter id="zdx-lens-nav" color-interpolation-filters="sRGB" primitiveUnits="objectBoundingBox" x="-0.1" y="-0.2" width="1.2" height="1.4">
        <feImage href={glassMaps.nav} x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="map" />
        <feDisplacementMap in="SourceGraphic" in2="map" scale="0.35" xChannelSelector="R" yChannelSelector="G" result="disp" />
        <feGaussianBlur in="disp" stdDeviation="0.005 0.038" result="soft" />
        <feColorMatrix in="soft" type="saturate" values="1.35" />
      </filter>
    </svg>
  </section>

  <p class="container home-method-note">Posições conferidas com o NASA JPL Horizons · <a href={localizePath('pt', '/methodology/')}>Como calculamos</a></p>

  <WelcomeBack client:idle locale="pt" />

  <section class="container ticker-band reveal">
    <SkyTicker client:visible locale="pt" />
  </section>

  <section class="container reveal pace-act">
    <TodayBySign client:idle locale="pt" />
  </section>

  <section class="container pace-act pace-act--rule">
    <div class="section-head reveal">
      <h2>Comece pelo seu mapa</h2>
      <p>Descubra seu mapa astral, signo lunar, ascendente, compatibilidade e o que está acontecendo no céu agora.</p>
    </div>
    <div class="home-tools-es">
      {tools.map((tool, i) => (
        <a class="tile reveal" href={localizePath('pt', tool.href)} style={`--sign:${tool.hue};--reveal-delay:${i * 60}ms`}>
          <div class="home-tool-es">
            <ToolGlyph kind={tool.kind} />
            <h3>{tool.title}</h3>
            <p>{tool.promise}</p>
            <span class="home-tool-es__go">Abrir →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="container pace-tight" id="signos">
    <div class="section-head reveal">
      <h2>Os doze signos</h2>
      <p>Guias claros de cada signo: personalidade, amor, compatibilidade e o que ele significa no seu mapa.</p>
    </div>
    <div class="twelve-es">
      {SIGNS.map((sign, i) => (
        <a class="tile reveal" href={localizePath('pt', `/${sign.slug}/`)} style={`--sign:${sign.hue};--reveal-delay:${(i % 6) * 45}ms`}>
          <div class="twelve-es__card">
            <SignIcon sign={sign.slug} size={64} />
            <strong>{signName(sign, 'pt')}</strong>
            <span class="mono twelve-es__dates">{signDates(sign, 'pt')}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="container close-es pace-sec pace-end">
    <h2 class="display reveal">Comece pelo seu mapa astral.</h2>
    <div class="reveal" style="--reveal-delay:120ms">
      <a class="btn btn--primary" href={localizePath('pt', '/birth-chart/')}><span>Faça seu mapa astral grátis</span><span class="orb">↗</span></a>
    </div>
  </section>
</Base>

<style>
  /* ── Vertical rhythm — one-sided padding in three tiers; the hairline
     marks the act break. Mirrors the EN homepage scale. ── */
  .pace-act { padding-top: clamp(72px, 9.5vw, 132px); }
  .pace-act--rule {
    margin-top: clamp(40px, 5vw, 64px);
    border-top: 1px solid var(--hair-1);
    padding-top: clamp(44px, 5.5vw, 72px);
  }
  .pace-tight { padding-top: clamp(36px, 4.5vw, 60px); }
  .pace-sec { padding-top: clamp(48px, 6.5vw, 88px); }
  .pace-end { padding-bottom: clamp(80px, 10vw, 132px); }


  .hero-es {
    /* Rise behind the fixed nav so the glass refracts the footage on
       first paint (matches the English homepage). */
    margin-top: calc(-1 * var(--nav-space, 96px));
    width: min(100% - 32px, 1440px);
    padding-block: 0 clamp(14px, 2vw, 22px);
  }
  .hero-es__frame {
    position: relative;
    overflow: hidden;
    border-radius: clamp(18px, 2.6vw, 30px);
    min-height: clamp(560px, calc(100svh - 40px), 900px);
    background: var(--void-1);
    box-shadow: inset 0 0 0 1px rgba(198, 204, 218, 0.10), 0 30px 80px -40px rgba(0, 0, 0, 0.8);
    isolation: isolate;
  }
  .hero-es__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    transform: scale(1.035);
  }
  .hero-es__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(6, 7, 9, 0.62) 0%, rgba(6, 7, 9, 0.34) 36%, rgba(6, 7, 9, 0.72) 100%);
  }
  .hero-es__content {
    position: relative;
    z-index: 2;
    min-height: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: calc(clamp(100px, 13svh, 132px) + env(safe-area-inset-top)) clamp(22px, 4vw, 56px) clamp(28px, 5vw, 64px);
    text-align: center;
  }
  .hero-es h1 {
    margin: 0 0 clamp(14px, 2vw, 20px);
    max-width: 9.53em; /* 14ch of Instrument — font-independent so fallback text can't resize the box */
    font-family: var(--font-sans);
    font-size: clamp(2.35rem, 0.95rem + 5.8vw, 5.9rem);
    line-height: 0.95;
    font-weight: 690;
    text-transform: uppercase;
    color: var(--ink-0, #EEF1F7);
    text-wrap: balance;
    text-shadow: 0 2px 28px rgba(6, 7, 9, 0.55);
  }
  /* Caption and buttons sink to the base of the frame; the headline
     stays pinned at the top. */
  .hero-es__foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(20px, 3vw, 28px);
  }
  .hero-es p {
    margin: 0;
    max-width: 33.3em; /* 50ch of Instrument */
    color: var(--ink-1, #C6CCDA);
    font-size: clamp(0.95rem, 0.85rem + 0.5vw, 1.125rem);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .hero-es__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .hero-es__trustlines { margin: -2px 0 0; display: grid; gap: 4px; justify-items: center; }
  .hero-es__foot .hero-es__trust { margin: 0; max-width: none; font-family: var(--font-mono); font-size: 10.5px; line-height: 1.45; letter-spacing: 0.055em; color: var(--faint); text-shadow: 0 1px 14px rgba(6, 7, 9, 0.72); text-align: center; }
  .hero-es__trust a { color: inherit; text-underline-offset: 2px; }
  .hero-es__ghost {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0) 46%),
      rgba(10, 12, 17, 0.46);
    backdrop-filter: blur(14px) saturate(150%) brightness(1.12);
    -webkit-backdrop-filter: blur(14px) saturate(150%) brightness(1.12);
    border-color: rgba(238, 241, 247, 0.42);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      inset 0 -12px 22px -14px rgba(255, 255, 255, 0.08),
      0 8px 26px -12px rgba(0, 0, 0, 0.5);
  }
  .hero-es__ghost:hover { background: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0) 46%), rgba(10, 12, 17, 0.6); }

  /* Primary CTA glass — arrow disc stays a solid white token (matches EN). */
  .hero-es__ctas .btn--primary {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0) 46%),
      rgba(10, 12, 17, 0.46);
    backdrop-filter: blur(14px) saturate(150%) brightness(1.12);
    -webkit-backdrop-filter: blur(14px) saturate(150%) brightness(1.12);
    border-color: rgba(238, 241, 247, 0.46);
    color: var(--ink-0, #EEF1F7);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.34),
      inset 0 -12px 22px -14px rgba(255, 255, 255, 0.08),
      0 8px 26px -12px rgba(0, 0, 0, 0.5);
  }
  .hero-es__ctas .btn--primary:hover {
    background: rgba(10, 12, 17, 0.6);
    border-color: rgba(238, 241, 247, 0.42);
  }
  .hero-es__ctas .btn--primary .orb {
    background: var(--ink-0, #EEF1F7);
    border-color: rgba(238, 241, 247, 0.5);
    color: var(--void-0, #060709);
  }
  .hero-es__ctas .btn--primary:hover .orb { background: #ffffff; }

  /* ── Liquid glass (homepage chrome only) — matches the English hero. ── */
  .glass-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  /* Chromium-only refraction lens (.zdx-lens set by Base.astro's inline
     script); Safari/iOS keep the frosted blur floor above. */
  :global(html.zdx-lens) .hero-es__ghost {
    background: rgba(10, 12, 17, 0.34);
    backdrop-filter: url(#zdx-lens-cta);
    -webkit-backdrop-filter: url(#zdx-lens-cta);
    border-color: rgba(238, 241, 247, 0.28);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.20),
      inset 0 -1px 0 rgba(255, 255, 255, 0.06),
      0 10px 30px -12px rgba(0, 0, 0, 0.55);
  }
  :global(html.zdx-lens) .hero-es__ghost:hover { background: rgba(10, 12, 17, 0.5); }
  :global(html.zdx-lens) .hero-es__ctas .btn--primary {
    background: rgba(10, 12, 17, 0.34);
    backdrop-filter: url(#zdx-lens-cta);
    -webkit-backdrop-filter: url(#zdx-lens-cta);
    border-color: rgba(238, 241, 247, 0.30);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.20),
      inset 0 -1px 0 rgba(255, 255, 255, 0.06),
      0 10px 30px -12px rgba(0, 0, 0, 0.55);
  }
  :global(html.zdx-lens) .hero-es__ctas .btn--primary:hover { background: rgba(10, 12, 17, 0.5); }
  :global(html.zdx-lens .nav-wrap .nav) {
    background: rgba(10, 12, 17, 0.56);
    backdrop-filter: url(#zdx-lens-nav);
    -webkit-backdrop-filter: url(#zdx-lens-nav);
    box-shadow:
      inset 0 1px 0 rgba(238, 241, 247, 0.10),
      inset 0 -1px 0 rgba(238, 241, 247, 0.04),
      0 12px 32px -14px rgba(0, 0, 0, 0.7);
  }
  @media (prefers-reduced-transparency: reduce) {
    .hero-es__ghost,
    .hero-es__ctas .btn--primary {
      background: rgba(10, 12, 17, 0.86);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    :global(html .nav-wrap .nav) {
      background: rgba(10, 12, 17, 0.92);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  /* .ticker-band + .wb + .skyticker styles live in ../../styles/today.css. */
  .home-tools-es { display: grid; gap: 14px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) { .home-tools-es { grid-template-columns: repeat(4, 1fr); } }
  .home-tool-es { display: flex; flex-direction: column; gap: 9px; padding: 26px 22px 22px; min-height: 196px; }
  /* Tool-card icon disc lives in ToolGlyph.astro (shared with the EN home). */
  .home-tool-es h3 { margin: 2px 0 0; font-size: var(--text-base); font-weight: 620; color: var(--text); }
  .home-tool-es p { margin: 0; font-size: 13px; color: var(--text-2); line-height: 1.55; }
  .home-tool-es__go { margin-top: auto; padding-top: 12px; font-size: 12.5px; color: var(--muted); }
  .twelve-es { display: grid; gap: 12px; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 640px) { .twelve-es { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 960px) { .twelve-es { grid-template-columns: repeat(6, 1fr); } }
  .twelve-es__card { display: flex; flex-direction: column; align-items: center; gap: 11px; padding: 26px 12px 20px; text-align: center; }
  .twelve-es__card strong { font-size: 15px; font-weight: 600; color: var(--text); }
  .twelve-es__dates { font-size: 9.5px; color: var(--faint); letter-spacing: 0.05em; }
  .close-es { text-align: center; }
  .close-es h2 { margin: 0 0 30px; font-size: var(--text-2xl); }
  @media (max-width: 640px) {
    .hero-es { width: min(100% - 20px, 1440px); }
    .hero-es__frame { min-height: clamp(520px, calc(100svh - 56px), 760px); }
    .hero-es__content { padding: calc(clamp(96px, 15svh, 120px) + env(safe-area-inset-top)) 18px 22px; }
    .hero-es h1 { max-width: 7.49em; font-size: clamp(2.2rem, 11vw, 3.45rem); }
    .hero-es p { max-width: 20.65em; font-size: 0.98rem; line-height: 1.52; }
    .hero-es__ctas .btn { flex: 1 1 auto; justify-content: center; }
  }
  .hero-es__ctas .btn--primary, :global(html.zdx-lens) .hero-es__ctas .btn--primary { background: var(--text); color: var(--void-0); border-color: var(--text); backdrop-filter: none; filter: none; box-shadow: none; }
  .hero-es__ctas .btn--primary:hover { background: #fff; }
  .hero-motion { position: absolute; z-index: 5; top: 14px; right: 14px; min-height: 44px; padding: 0 14px; border: 1px solid var(--hair-2); border-radius: 999px; background: rgba(6,7,9,.85); color: var(--text); font: 500 12px var(--font-sans); cursor: pointer; }
  @media (prefers-reduced-motion: reduce) { .hero-motion { display: none; } }
  .home-method-note { margin-block: 24px 0; color: var(--muted); font-size: 12px; text-align: center; }
</style>
