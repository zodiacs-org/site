---
import Base from '../../layouts/Base.astro';
import LocalizedHome from '../../components/localized/LocalizedHome.astro';
import LocalizedHomeHead from '../../components/localized/LocalizedHomeHead.astro';
import { localizedHomeFaq, localizedHomeFaqSchema } from '../../components/localized/home-copy';

// The English homepage's two own questions, in Brazilian Portuguese. The
// data answer is the birth chart page's, as published there.
const faq = localizedHomeFaq('pt', [
  {
    q: 'O que acontece com meus dados de nascimento?',
    a: 'O mapa inteiro é calculado no seu navegador; a calculadora não usa nenhuma API de mapas no servidor e você não precisa criar uma conta. Se salvar um mapa, ele fica primeiro neste dispositivo. A sincronização opcional só envia os mapas salvos depois que você entra na conta.',
  },
  {
    q: 'E se eu não souber a hora do meu nascimento?',
    a: 'Escolha “Não sei”. A calculadora usa 12:00 como referência, deixa de fora o ascendente e as casas em vez de inventá-los e marca o signo lunar como não verificado até você informar um horário, porque a Lua pode mudar de signo ao longo do dia.',
  },
]);

const jsonLd = [
  localizedHomeFaqSchema(faq),
  {
    '@type': 'WebSite',
    '@id': 'https://zodiacs.org/#site',
    url: 'https://zodiacs.org/',
    name: 'Zodiacs.org',
    description: 'Mapas astrais grátis, signo lunar, compatibilidade, horóscopos e guias dos signos, privados e fáceis de entender.',
    publisher: { '@id': 'https://zodiacs.org/#org' },
    inLanguage: ['en', 'es', 'pt-BR'],
  },
];
---
<Base
  clientUi
  title="Mapa astral grátis e astrologia clara | Zodiacs.org"
  description="Mapa astral grátis, signo lunar, ascendente, compatibilidade, horóscopos e guias dos doze signos, calculados com privacidade no seu navegador."
  path="/pt/"
  locale="pt"
  jsonLd={jsonLd}
>
  <LocalizedHomeHead slot="head" locale="pt" />
  <LocalizedHome locale="pt" faq={faq} />
</Base>
