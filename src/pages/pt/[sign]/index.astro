---
import Base from '../../../layouts/Base.astro';
import SignIcon from '../../../components/SignIcon.astro';
import SignGuideHero from '../../../components/SignGuideHero.astro';
import SignGuideFacts from '../../../components/SignGuideFacts.astro';
import Faq from '../../../components/Faq.astro';
import CollectBand from '../../../components/CollectBand.astro';
import ShareRow from '../../../components/ShareRow.astro';
import { SIGNS, SIGN_SLUGS, elementLabel, signBySlug, signName } from '../../../lib/signs';
import { signDateRange } from '../../../lib/sign-display';
import { planetLabel } from '../../../lib/i18n/astrology';
import { localizePath, t } from '../../../lib/i18n';
import { portugueseGuideFor } from '../../../data/pt-guides';
import { pairSlug } from '../../../lib/compat';
import { EDITOR_AUTHOR } from '../../../lib/editorial';
import { signArtCard } from '../../../lib/og-art-cards.mjs';

export function getStaticPaths() {
  return SIGN_SLUGS.map((sign) => ({ params: { sign } }));
}

const sign = signBySlug(Astro.params.sign!);
const guide = portugueseGuideFor(sign);
const idx = SIGNS.findIndex((s) => s.slug === sign.slug);
const prev = SIGNS[(idx + 11) % 12];
const next = SIGNS[(idx + 1) % 12];
const easeful = {
  aries: ['leo', 'sagittarius', 'gemini'],
  taurus: ['virgo', 'capricorn', 'cancer'],
  gemini: ['libra', 'aquarius', 'aries'],
  cancer: ['scorpio', 'pisces', 'taurus'],
  leo: ['aries', 'sagittarius', 'libra'],
  virgo: ['taurus', 'capricorn', 'cancer'],
  libra: ['gemini', 'aquarius', 'leo'],
  scorpio: ['cancer', 'pisces', 'virgo'],
  sagittarius: ['aries', 'leo', 'aquarius'],
  capricorn: ['taurus', 'virgo', 'scorpio'],
  aquarius: ['gemini', 'libra', 'sagittarius'],
  pisces: ['cancer', 'scorpio', 'capricorn'],
}[sign.slug]!;

// The hero's quick answers, in the labels this locale's catalogue already
// carries for the chart inspector (dates, element, ruler).
const upperFirst = (value: string) => value.replace(/^\p{L}/u, (letter) => letter.toLocaleUpperCase('pt'));
const heroFacts = [
  { label: t('pt', 'dates'), value: upperFirst(signDateRange(sign, 'pt')) },
  { label: t('pt', 'element'), value: upperFirst(elementLabel(sign.element, 'pt')) },
  { label: t('pt', 'ruler'), value: planetLabel('pt', sign.ruler), glyph: sign.ruler },
];

const jsonLd = [
  {
    '@type': 'Article',
    headline: guide.title,
    description: guide.description,
    url: `https://zodiacs.org/pt/${sign.slug}/`,
    datePublished: '2026-07-15T00:00:00+07:00',
    dateModified: '2026-07-15T00:00:00+07:00',
    author: EDITOR_AUTHOR,
    publisher: { '@id': 'https://zodiacs.org/#org' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://zodiacs.org/pt/${sign.slug}/` },
    image: `https://zodiacs.org${signArtCard(sign.slug, 'pt')}`,
    inLanguage: 'pt-BR',
    about: { '@type': 'Thing', name: `${signName(sign, 'pt')} (astrologia)` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org em português', item: 'https://zodiacs.org/pt/' },
      { '@type': 'ListItem', position: 2, name: 'Signos do zodíaco', item: 'https://zodiacs.org/pt/#signos' },
      { '@type': 'ListItem', position: 3, name: signName(sign, 'pt'), item: `https://zodiacs.org/pt/${sign.slug}/` },
    ],
  },
  {
    '@type': 'FAQPage',
    inLanguage: 'pt-BR',
    mainEntity: guide.faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title={`${guide.title} | Zodiacs.org`}
  description={guide.description}
  path={`/pt/${sign.slug}/`}
  image={signArtCard(sign.slug, 'pt')}
  imageAlt={`${signName(sign, 'pt')}, guia de signo no Zodiacs.org`}
  type="article"
  locale="pt"
  jsonLd={jsonLd}
>
  <article style={`--sign:${sign.hue}`}>
    <SignGuideHero sign={sign.slug} locale="pt" title={signName(sign, 'pt')} sub={guide.intro[0]}>
      <a class="btn btn--primary btn--lg" href={localizePath('pt', '/birth-chart/')}><span>Calcule seu mapa astral grátis</span><span class="orb" aria-hidden="true">↗</span></a>
      <a class="btn btn--glass btn--lg" href={localizePath('pt', '/compatibility/')}><span>Ver compatibilidade</span></a>
    </SignGuideHero>
    <div class="kwrap guide-locale-facts">
      <SignGuideFacts facts={heroFacts} />
    </div>

    <div class="container container--narrow guide-pt-body">
      <div class="reveal">
        <CollectBand signName={signName(sign, 'pt')} slug={sign.slug} locale="pt" />
      </div>

      <div class="prose reveal">
        {guide.intro.slice(1).map((p) => <p>{p}</p>)}
        {guide.sections.map((section) => (
          <>
            <h2>{section.heading}</h2>
            {section.body.map((p) => <p>{p}</p>)}
            {section.risingProfile && (
              <p>
                <a href={`/pt/rising-sign/${sign.slug}/`}>
                  Perfil completo do ascendente em {signName(sign, 'pt')} →
                </a>
              </p>
            )}
          </>
        ))}
      </div>

      <section class="guide-pt-panel shell tinted reveal" style={`--sign:${sign.hue}`}>
        <div class="core tinted guide-pt-panel__core">
          <h2>Compatibilidade rápida</h2>
          <p>
            A química entre signos solares é apenas o começo. Estes signos
            costumam fluir com {signName(sign, 'pt')}; para uma leitura de
            verdade, compare os dois mapas.
          </p>
          <div class="guide-pt-panel__chips">
            {easeful.map((slug) => {
              const s = signBySlug(slug);
              return (
                <a class="chip" href={`/pt/compatibility/${pairSlug(sign.slug, s.slug)}/`} style={`--sign:${s.hue}`}>
                  <SignIcon sign={s.slug} size={18} class="chip__icon" /> {signName(sign, 'pt')} e {signName(s, 'pt')}
                </a>
              );
            })}
          </div>
        </div>
      </section>

      <section class="reveal">
        <Faq items={guide.faq} heading={`${signName(sign, 'pt')}: perguntas frequentes`} />
      </section>

      <ShareRow
        text={`${signName(sign, 'pt')}, o guia completo`}
        url={`https://zodiacs.org/pt/${sign.slug}/`}
        locale="pt"
      />
    </div>

    <nav class="container guide-pt-nav reveal" aria-label="Mais signos">
      <a class="guide-pt-nav__link" href={localizePath('pt', `/${prev.slug}/`)} style={`--sign:${prev.hue}`}>
        <span class="mono--label">← Anterior</span>
        <span><SignIcon sign={prev.slug} size={22} /> {signName(prev, 'pt')}</span>
      </a>
      <a class="guide-pt-nav__link guide-pt-nav__link--next" href={localizePath('pt', `/${next.slug}/`)} style={`--sign:${next.hue}`}>
        <span class="mono--label">Próximo →</span>
        <span><SignIcon sign={next.slug} size={22} /> {signName(next, 'pt')}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .guide-locale-facts { margin-bottom: clamp(36px, 5vw, 56px); }
  .guide-pt-body { display: grid; gap: clamp(28px, 5vw, 46px); }
  .guide-pt-panel__core { padding: clamp(22px, 4vw, 32px); display: grid; gap: 12px; }
  .guide-pt-panel h2 { margin: 0; font-size: var(--text-xl); }
  .guide-pt-panel p { margin: 0; max-width: 58ch; color: var(--text-2); line-height: 1.65; }
  .guide-pt-panel__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .guide-pt-nav {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-block: clamp(34px, 6vw, 70px) 0;
  }
  .guide-pt-nav__link {
    display: grid;
    gap: 7px;
    min-width: 0;
    color: var(--text);
    text-decoration: none;
  }
  .guide-pt-nav__link span:last-child {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }
  .guide-pt-nav__link--next { text-align: end; justify-items: end; }
</style>
