---
import Base from '../../../layouts/Base.astro';
import DailyLocaleReading from '../../../components/DailyLocaleReading.astro';
import dailyData from '../../../data/daily.json';
import type { Daily } from '../../../lib/daily';
import { dailyReadingForLocale } from '../../../lib/i18n/daily-reading';
import { formatDate } from '../../../lib/i18n/dates';
import { moonPhaseLabel } from '../../../lib/i18n/astrology';
import { englishOnlyCue } from '../../../lib/i18n/english-only';
import { SIGNS, signName } from '../../../lib/signs';

// O céu de hoje lido para os doze signos, em português, a partir dos mesmos
// fatos registrados da edição em inglês: nenhuma prosa nova, apenas a mesma
// seleção de linhas com modelos neste idioma.
const locale = 'pt' as const;
const daily = dailyData as Daily;
const dateLabel = formatDate(locale, `${daily.date}T12:00:00Z`, {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
const readings = SIGNS.map((sign) => ({ sign, reading: dailyReadingForLocale(sign.slug, daily, locale) }));
const cue = englishOnlyCue(locale);
const description = `O céu de hoje para os doze signos solares: quatro notas por signo, calculadas a partir das posições reais de ${dateLabel}.`;
---
<Base
  title={`Hoje — o céu de ${dateLabel} | Zodiacs.org`}
  description={description}
  path="/pt/today/"
  locale={locale}
  editionDate={daily.date}
>
  <section class="section--tight container container--narrow" data-edition-content="true">
    <header class="today-pt__hero">
      <em class="kicker">Edição diária · {dateLabel}</em>
      <h1 class="display">Hoje</h1>
      <p>
        Escolha o seu signo solar. Cada nota vem das posições registradas do céu de hoje, lidas a partir das casas
        solares do seu signo; os registros sob cada leitura dizem exatamente o que a produziu.
      </p>
      <span class="today-pt__stamp mono">{dateLabel} · {moonPhaseLabel(locale, daily.moon.phase)}</span>
    </header>

    <nav class="today-pt__signs" aria-label="Signos">
      {SIGNS.map((sign) => (
        <a class="today-pt__chip" href={`#${sign.slug}`} style={`--sign:${sign.hue}`}>
          <img src={`/assets/zodiac-icons/48/${sign.slug}.webp`} width="22" height="22" alt="" loading="lazy" decoding="async" />
          {signName(sign, locale)}
        </a>
      ))}
    </nav>

    {readings.map(({ sign, reading }) => (
      <article class="today-pt__sign tile" id={sign.slug} style={`--sign:${sign.hue}`}>
        <h2 id={`${sign.slug}-title`}>
          <img src={`/assets/zodiac-icons/48/${sign.slug}.webp`} width="28" height="28" alt="" loading="lazy" decoding="async" />
          {signName(sign, locale)}
        </h2>
        <DailyLocaleReading locale={locale} reading={reading} headingId={`${sign.slug}-title`} />
        <p class="today-pt__links">
          <a href={`/pt/horoscopes/${sign.slug}/`}>Horóscopo de hoje de {signName(sign, locale)}</a> ·
          <a href={`/pt/${sign.slug}/`}>Guia de {signName(sign, locale)}</a>
        </p>
      </article>
    ))}

    <p class="today-pt__note">
      Já tem o seu mapa astral? A comparação privada com o céu de hoje está na{' '}
      <a href="/today/" hreflang="en" title={cue?.aria}>edição em inglês{cue?.suffix}</a>; o seu{' '}
      <a href="/pt/birth-chart/">mapa astral grátis</a> é calculado aqui, no seu navegador.
    </p>
  </section>
</Base>

<style>
  .today-pt__hero { max-width: 62ch; margin-bottom: clamp(22px, 4vw, 34px); }
  .today-pt__hero h1 { margin: 14px 0; font-size: var(--text-2xl); line-height: 1.04; }
  .today-pt__hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }
  .today-pt__stamp { display: block; margin-top: 14px; color: var(--faint); font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; }
  .today-pt__signs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: clamp(22px, 4vw, 34px); }
  .today-pt__chip {
    display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px 6px 8px;
    border: 1px solid var(--hair-2); border-radius: 999px; color: var(--text-2);
    font-size: var(--text-sm); text-decoration: none;
  }
  .today-pt__chip:hover { border-color: var(--hair-3); color: var(--text); }
  .today-pt__chip img { border-radius: 50%; }
  .today-pt__sign { padding: 20px 18px; margin-bottom: 12px; scroll-margin-top: 20px; }
  .today-pt__sign h2 { display: flex; align-items: center; gap: 10px; margin: 0 0 12px; font-size: var(--text-lg); }
  .today-pt__sign h2 img { border-radius: 50%; }
  .today-pt__links { margin: 12px 0 0; color: var(--muted); font-size: var(--text-sm); }
  .today-pt__links a { color: var(--text-2); }
  .today-pt__note { margin-top: clamp(22px, 4vw, 34px); color: var(--muted); font-size: var(--text-sm); }
  .today-pt__note a { color: var(--text); }
</style>
