---
import ReturnToolLinks from "../../../components/return-visits/ReturnToolLinks.astro";
import Base from '../../../layouts/Base.astro';
import ProfilePrepaint from '../../../components/profile/ProfilePrepaint.astro';
import ProfileDashboard from '../../../islands/ProfileDashboard';
import SavedRecordsPanel from '../../../islands/SavedRecordsPanel';
import { savedRecordsEnabled } from '../../../lib/profile/saved-record-flags';
import ProfileManager from '../../../islands/ProfileManager';
import AccountBoundProfileSurface from '../../../islands/AccountBoundProfileSurface';
import { accountSyncV2Enabled as isAccountSyncV2Enabled } from '../../../lib/account-v2/feature-flags';
import '../../../styles/calculator.css';
import '../../../styles/profile-polish.css';
import '../../../styles/profile-page.css';

const accountSyncV2Enabled = isAccountSyncV2Enabled({
  PUBLIC_ACCOUNT_SYNC_V2_ENABLED: process.env.PUBLIC_ACCOUNT_SYNC_V2_ENABLED,
  PUBLIC_ACCOUNT_SYNC_V2_PREVIEW_ACK: process.env.PUBLIC_ACCOUNT_SYNC_V2_PREVIEW_ACK,
});
const savedRecordsSurfaceEnabled = savedRecordsEnabled({
  PUBLIC_SAVED_RECORDS_ENABLED: process.env.PUBLIC_SAVED_RECORDS_ENABLED,
});

const jsonLd = [
  {
    '@type': 'WebPage',
    name: 'Mapas salvos',
    url: 'https://zodiacs.org/pt/profile/',
    description: 'Salve mapas neste dispositivo e sincronize-os com sua conta somente quando você decidir.',
    inLanguage: 'pt-BR',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
];
---
<Base
  clientUi
  title="Mapas salvos | Zodiacs.org"
  description="Salve mapas com privacidade neste dispositivo e entre na conta quando quiser acessá-los em todos os seus dispositivos."
  path="/pt/profile/"
  locale="pt"
  jsonLd={jsonLd}
  privateSurface={accountSyncV2Enabled}
>
  <section class="section--tight container pf-page">
    <ProfilePrepaint />
    <div class="pf-hero">
      <h1 class="display">Mapas salvos.</h1>
      <p>Salve mapas neste dispositivo. Entre na conta quando quiser acessá-los em todos os seus dispositivos.</p>
    </div>
    {accountSyncV2Enabled ? (
      <AccountBoundProfileSurface locale="pt" client:load />
    ) : (
      <>
        <ProfileDashboard locale="pt" client:load />
        <ProfileManager locale="pt" client:load />
      </>
    )}
    <SavedRecordsPanel enabled={savedRecordsSurfaceEnabled} locale="pt" client:load />
    <aside class="pf-note">
      <p class="mono">{accountSyncV2Enabled
        ? <>O teste de sincronização criptografada é gerenciado temporariamente em <a href="/profile/">/profile/</a>. Aqui, seus mapas ficam somente neste dispositivo.</>
        : 'Se você apagar os dados do navegador, os mapas armazenados apenas localmente também serão apagados. Entre na conta para sincronizar mapas salvos e exclusões entre dispositivos.'}</p>
    </aside>
  </section>
<section class="section--tight container"><ReturnToolLinks locale="pt" /></section>
</Base>
