---
import Base from '../../../layouts/Base.astro';
import LocalizedBirthChart from '../../../components/localized/LocalizedBirthChart.astro';
import birthChartCss from '../../../components/localized/LocalizedBirthChart.css?inline';

const faq = [
  {
    q: 'O que é um mapa astral?',
    a: 'Um mapa astral, ou mapa natal, mostra onde cada planeta estava, do ponto de vista da Terra, no momento e no lugar exatos do seu nascimento. Ele registra seu Sol, sua Lua e seu ascendente, além das posições de Mercúrio a Plutão nas doze casas.',
  },
  {
    q: 'Preciso saber a hora exata do meu nascimento?',
    a: 'Para calcular o ascendente e as casas, sim: o ascendente muda aproximadamente a cada duas horas. Sem o horário, usamos 12:00 no horário civil local como referência para as posições e omitimos ascendente, ângulos e casas. Como a Lua pode mudar de signo ao longo do dia, o resultado marca o signo lunar como não verificado até você informar o horário. A certidão de nascimento, o livro do bebê ou sua família costumam ser as melhores fontes.',
  },
  {
    q: 'Qual é a precisão desta calculadora?',
    a: 'As posições planetárias são calculadas com um mecanismo astronômico e comparadas com dados de referência do JPL da NASA, com margem de poucos centésimos de grau. Mudanças históricas de horário a partir de 1970 são resolvidas com o histórico IANA fornecido pelo navegador ou pelo sistema do dispositivo, e as anteriores com uma versão fixa do banco de dados IANA, incluindo os registros antigos que ele mantém à parte para lugares cujos relógios depois passaram a coincidir com os de outra cidade, que seus mantenedores consideram menos confiáveis. Um nascimento anterior à adoção de uma hora legal no lugar usa a hora média local do próprio local de nascimento.',
  },
  {
    q: 'O que acontece com meus dados de nascimento?',
    a: 'O mapa inteiro é calculado no seu navegador; a calculadora não usa nenhuma API de mapas no servidor e você não precisa criar uma conta. Se salvar um mapa, ele fica primeiro neste dispositivo. A sincronização opcional só envia os mapas salvos depois que você entra na conta.',
  },
  {
    q: 'Casas de signos inteiros ou Placidus: qual sistema escolher?',
    a: 'O sistema de casas de signos inteiros é o mais antigo e o mais fácil de ler: cada casa ocupa um signo completo. Placidus é a opção moderna mais comum e divide as casas conforme o tempo de ascensão, por isso seus tamanhos variam. Experimente os dois: os planetas não mudam de lugar; apenas os limites das casas mudam.',
    id: 'houses',
  },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    name: 'Calculadora gratuita de mapa astral',
    url: 'https://zodiacs.org/pt/birth-chart/',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: 'Sol, Lua, ascendente, planetas de Mercúrio a Plutão, Nodo Norte verdadeiro, casas de signos inteiros e Placidus, aspectos',
    inLanguage: 'pt-BR',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
  {
    '@type': 'FAQPage',
    inLanguage: 'pt-BR',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org em português', item: 'https://zodiacs.org/pt/' },
      { '@type': 'ListItem', position: 2, name: 'Ferramentas', item: 'https://zodiacs.org/pt/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Calculadora de mapa astral', item: 'https://zodiacs.org/pt/birth-chart/' },
    ],
  },
];
---
<Base
  clientUi
  glass
  title="Mapa astral grátis: Sol, Lua e ascendente | Zodiacs.org"
  description="Calcule seu mapa astral grátis: Sol, Lua, ascendente, planetas, casas e o que cada um significa. Calculado com privacidade no seu navegador."
  path="/pt/birth-chart/"
  locale="pt"
  image="/assets/og/v2/tool/birth-chart.png"
  imageAlt="Calculadora gratuita de mapa astral, Zodiacs.org"
  jsonLd={jsonLd}
>
  <script slot="head" is:inline>
    try {
      var chartShareParams = new URLSearchParams(location.hash.slice(1));
      if (chartShareParams.has('p') || chartShareParams.has('c')) {
        document.documentElement.dataset.chartShareReceiver = '';
        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('a[href="/astrofolio/"],a[href^="/registry/"],a[href^="/sdk/"]').forEach(function (element) {
            if (element.closest('[data-nav], [data-mobile-menu]')) return;
            var footerWing = element.closest('.footer__col, .zfooter__group');
            (footerWing || element).remove();
          });
        }, { once: true });
      }
    } catch (error) {}
  </script>
  <style slot="head" is:inline>
    html[data-chart-share-receiver] a[href="/astrofolio/"]:not([data-nav] a, [data-mobile-menu] a),
    html[data-chart-share-receiver] a[href^="/registry/"],
    html[data-chart-share-receiver] a[href^="/sdk/"],
    html[data-chart-share-receiver] .calc__record,
    html[data-chart-share-receiver] [data-registry-aura-chart-link],
    html[data-chart-share-receiver] .footer__col:has(a[href^="/registry/"]),
    html[data-chart-share-receiver] .zfooter__group:has(a[href^="/registry/"]) { display: none !important; }
  </style>
  <style slot="head" is:inline data-zdx-birth-chart-route set:html={birthChartCss} />

  <LocalizedBirthChart locale="pt" faq={faq} />
</Base>
