---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const pairs = await getCollection('pairs', ({ data }) => !data.draft);
  const learn = await getCollection('learn', ({ data }) => !data.draft);

  const staticSlugs = [
    ['learn'],
    ['learn', 'planets'],
    ['learn', 'houses'],
    ['learn', 'aspects'],
    ['learn', 'placements'],
  ];

  const dynamicSlugs = [
    ...pairs.map((p) => ['compatibility', p.id]),
    // Rising-sign profiles are translated: src/pages/pt/rising-sign/[sign].astro.
    ...learn.filter((l) => l.data.kind !== 'rising').map((l) => ['learn', ...l.id.split('/')]),
  ];

  return [...staticSlugs, ...dynamicSlugs].map((slug) => ({ params: { slug: slug.join('/') } }));
}

const slug = Astro.params.slug ?? '';
const englishPath = `/${slug}/`;
---
<Base
  title="Conteúdo em inglês — Zodiacs.org"
  description="Esta página ainda não foi traduzida para o português. Você pode ler a versão completa em inglês."
  path={`/pt/${slug}/`}
  locale="pt"
  noindex
>
  <section class="section container container--narrow fallback-pt">
    <em class="kicker">Disponível em inglês</em>
    <h1 class="display">Esta página ainda não foi traduzida.</h1>
    <p>
      A versão completa continua disponível em inglês enquanto traduzimos o
      restante do site.
    </p>
    <a class="btn btn--primary" href={englishPath} hreflang="en"><span>Ler em inglês</span><span class="orb">→</span></a>
  </section>
</Base>

<style>
  .fallback-pt { display: grid; gap: 18px; justify-items: start; }
  .fallback-pt h1 { margin: 4px 0 0; font-size: var(--text-2xl); line-height: 1.04; }
  .fallback-pt p { margin: 0; max-width: 52ch; color: var(--muted); font-size: var(--text-lg); line-height: 1.6; }
</style>
