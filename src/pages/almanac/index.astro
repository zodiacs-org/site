---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = (await getCollection('almanac', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

if (entries.length < 1) {
  throw new Error('The Almanac must publish at least one non-draft entry.');
}

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'The Almanac',
    url: 'https://zodiacs.org/almanac/',
    description: "The sky, written down: what's actually happening up there each month, and what the tradition makes of it.",
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: entries.length,
      itemListElement: entries.map((entry, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: entry.data.title,
        url: `https://zodiacs.org/almanac/${entry.id}/`,
      })),
    },
  },
];
---
<Base
  title="The Almanac | The Sky, Written Down | Zodiacs.org"
  description="Long-form notes on the month's computed sky and what the astrological tradition makes of it, plus careful guides to reading charts in ordinary life."
  path="/almanac/"
  image="/assets/og/v2/almanac/index.png"
  imageAlt="The Almanac: the sky, written down at Zodiacs.org"
  jsonLd={jsonLd}
>
  <section class="section container container--narrow almanac-hub">
    <header class="almanac-hub__hero reveal">
      <h1 class="display">The sky, written down.</h1>
      <p>The sky, written down: what's actually happening up there each month, and what the tradition makes of it.</p>
    </header>

    <div class="almanac-hub__list">
      {entries.map((entry) => (
        <article class="almanac-hub__entry reveal">
          <time class="mono" datetime={entry.data.published.toISOString()}>
            {entry.data.published.toLocaleDateString('en-US', {
              day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC',
            })}
          </time>
          <div>
            <h2><a href={`/almanac/${entry.id}/`}>{entry.data.title}</a></h2>
            <p>{entry.data.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .almanac-hub { display: grid; gap: clamp(34px, 6vw, 64px); }
  .almanac-hub__hero { max-width: 60ch; }
  .almanac-hub__hero h1 { margin: 14px 0; font-size: var(--text-2xl); line-height: 1.04; }
  .almanac-hub__hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); line-height: 1.6; text-wrap: pretty; }
  .almanac-hub__list { border-top: 1px solid var(--hair-1); }
  .almanac-hub__entry {
    display: grid;
    grid-template-columns: minmax(92px, 0.28fr) minmax(0, 1fr);
    gap: clamp(16px, 4vw, 38px);
    padding: clamp(22px, 4vw, 32px) 0;
    border-bottom: 1px solid var(--hair-1);
  }
  .almanac-hub__entry time { padding-top: 5px; color: var(--faint); font-size: 12px; letter-spacing: 0; }
  .almanac-hub__entry h2 { margin: 0; font-size: var(--text-xl); line-height: 1.2; letter-spacing: -0.02em; }
  .almanac-hub__entry h2 a { color: var(--text); text-decoration: none; }
  .almanac-hub__entry h2 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .almanac-hub__entry p { margin: 8px 0 0; color: var(--muted); line-height: 1.6; text-wrap: pretty; }
  @media (max-width: 520px) {
    .almanac-hub__entry { grid-template-columns: 1fr; gap: 8px; }
  }
</style>
