---
import Base from '../../../layouts/Base.astro';
import SignIcon from '../../../components/SignIcon.astro';
import SignGuideHero from '../../../components/SignGuideHero.astro';
import SignGuideFacts from '../../../components/SignGuideFacts.astro';
import Faq from '../../../components/Faq.astro';
import CollectBand from '../../../components/CollectBand.astro';
import ShareRow from '../../../components/ShareRow.astro';
import { SIGNS, SIGN_SLUGS, elementLabel, signBySlug, signName } from '../../../lib/signs';
import { signDateRange } from '../../../lib/sign-display';
import { planetLabel } from '../../../lib/i18n/astrology';
import { localizePath, t } from '../../../lib/i18n';
import { italianGuideFor } from '../../../data/it-guides';
import { pairSlug } from '../../../lib/compat';
import { EDITOR_AUTHOR } from '../../../lib/editorial';
import { signArtCard } from '../../../lib/og-art-cards.mjs';

export function getStaticPaths() {
  return SIGN_SLUGS.map((sign) => ({ params: { sign } }));
}

const sign = signBySlug(Astro.params.sign!);
const guide = italianGuideFor(sign);
const idx = SIGNS.findIndex((s) => s.slug === sign.slug);
const prev = SIGNS[(idx + 11) % 12];
const next = SIGNS[(idx + 1) % 12];
const easeful = {
  aries: ['leo', 'sagittarius', 'gemini'],
  taurus: ['virgo', 'capricorn', 'cancer'],
  gemini: ['libra', 'aquarius', 'aries'],
  cancer: ['scorpio', 'pisces', 'taurus'],
  leo: ['aries', 'sagittarius', 'libra'],
  virgo: ['taurus', 'capricorn', 'cancer'],
  libra: ['gemini', 'aquarius', 'leo'],
  scorpio: ['cancer', 'pisces', 'virgo'],
  sagittarius: ['aries', 'leo', 'aquarius'],
  capricorn: ['taurus', 'virgo', 'scorpio'],
  aquarius: ['gemini', 'libra', 'sagittarius'],
  pisces: ['cancer', 'scorpio', 'capricorn'],
}[sign.slug]!;

// The hero's quick answers, in the labels this locale's catalogue already
// carries for the chart inspector (dates, element, ruler).
const upperFirst = (value: string) => value.replace(/^\p{L}/u, (letter) => letter.toLocaleUpperCase('it'));
const heroFacts = [
  { label: t('it', 'dates'), value: upperFirst(signDateRange(sign, 'it')) },
  { label: t('it', 'element'), value: upperFirst(elementLabel(sign.element, 'it')) },
  { label: t('it', 'ruler'), value: planetLabel('it', sign.ruler), glyph: sign.ruler },
];

const jsonLd = [
  {
    '@type': 'Article',
    headline: guide.title,
    description: guide.description,
    url: `https://zodiacs.org/it/${sign.slug}/`,
    datePublished: '2026-07-15T00:00:00+07:00',
    dateModified: '2026-07-15T00:00:00+07:00',
    author: EDITOR_AUTHOR,
    publisher: { '@id': 'https://zodiacs.org/#org' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://zodiacs.org/it/${sign.slug}/` },
    image: `https://zodiacs.org${signArtCard(sign.slug, 'it')}`,
    inLanguage: 'it',
    about: { '@type': 'Thing', name: `${signName(sign, 'it')} (astrologia)` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org in italiano', item: 'https://zodiacs.org/it/' },
      { '@type': 'ListItem', position: 2, name: 'Segni zodiacali', item: 'https://zodiacs.org/it/#segni' },
      { '@type': 'ListItem', position: 3, name: signName(sign, 'it'), item: `https://zodiacs.org/it/${sign.slug}/` },
    ],
  },
  {
    '@type': 'FAQPage',
    inLanguage: 'it',
    mainEntity: guide.faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title={`${guide.title} | Zodiacs.org`}
  description={guide.description}
  path={`/it/${sign.slug}/`}
  image={signArtCard(sign.slug, 'it')}
  imageAlt={`${signName(sign, 'it')}, guida al segno su Zodiacs.org`}
  type="article"
  locale="it"
  jsonLd={jsonLd}
>
  <article style={`--sign:${sign.hue}`}>
    <SignGuideHero sign={sign.slug} locale="it" title={signName(sign, 'it')} sub={guide.intro[0]}>
      <a class="btn btn--primary btn--lg" href={localizePath('it', '/birth-chart/')}><span>Calcola il tuo tema natale gratis</span><span class="orb" aria-hidden="true">↗</span></a>
      <a class="btn btn--glass btn--lg" href={localizePath('it', '/compatibility/')}><span>Vedi la compatibilità</span></a>
    </SignGuideHero>
    <div class="kwrap guide-locale-facts">
      <SignGuideFacts facts={heroFacts} />
    </div>

    <div class="container container--narrow guide-es-body">
      <div class="reveal">
        <CollectBand signName={signName(sign, 'it')} slug={sign.slug} locale="it" />
      </div>

      <div class="prose reveal">
        {guide.intro.slice(1).map((p) => <p>{p}</p>)}
        {guide.sections.map((section) => (
          <>
            <h2>{section.heading}</h2>
            {section.body.map((p) => <p>{p}</p>)}
            {section.risingProfile && (
              <p>
                <a href={`/it/rising-sign/${sign.slug}/`}>
                  Profilo completo dell’ascendente {signName(sign, 'it')} →
                </a>
              </p>
            )}
          </>
        ))}
      </div>

      <section class="guide-es-panel shell tinted reveal" style={`--sign:${sign.hue}`}>
        <div class="core tinted guide-es-panel__core">
          <h2>Compatibilità in breve</h2>
          <p>
            L’intesa tra due segni solari è solo l’inizio. Questi segni tendono
            ad accordarsi con {signName(sign, 'it')}; per una lettura completa, confronta i due temi.
            Le guide alle coppie collegate qui sotto sono in inglese.
          </p>
          <div class="guide-es-panel__chips">
            {easeful.map((slug) => {
              const s = signBySlug(slug);
              return (
                <a class="chip" href={`/it/compatibility/${pairSlug(sign.slug, s.slug)}/`} style={`--sign:${s.hue}`}>
                  <SignIcon sign={s.slug} size={18} class="chip__icon" /> {signName(sign, 'it')} e {signName(s, 'it')}
                </a>
              );
            })}
          </div>
        </div>
      </section>

      <section class="reveal">
        <Faq items={guide.faq} heading={`${signName(sign, 'it')}: domande frequenti`} />
      </section>

      <ShareRow
        text={`${signName(sign, 'it')}, la guida completa`}
        url={`https://zodiacs.org/it/${sign.slug}/`}
        locale="it"
      />
    </div>

    <nav class="container guide-es-nav reveal" aria-label="Altri segni">
      <a class="guide-es-nav__link" href={localizePath('it', `/${prev.slug}/`)} style={`--sign:${prev.hue}`}>
        <span class="mono--label">← Precedente</span>
        <span><SignIcon sign={prev.slug} size={22} /> {signName(prev, 'it')}</span>
      </a>
      <a class="guide-es-nav__link guide-es-nav__link--next" href={localizePath('it', `/${next.slug}/`)} style={`--sign:${next.hue}`}>
        <span class="mono--label">Successivo →</span>
        <span><SignIcon sign={next.slug} size={22} /> {signName(next, 'it')}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .guide-locale-facts { margin-bottom: clamp(36px, 5vw, 56px); }
  .guide-es-body { display: grid; gap: clamp(28px, 5vw, 46px); }
  .guide-es-panel__core { padding: clamp(22px, 4vw, 32px); display: grid; gap: 12px; }
  .guide-es-panel h2 { margin: 0; font-size: var(--text-xl); }
  .guide-es-panel p { margin: 0; max-width: 58ch; color: var(--text-2); line-height: 1.65; }
  .guide-es-panel__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .guide-es-nav {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-block: clamp(34px, 6vw, 70px) 0;
  }
  .guide-es-nav__link {
    display: grid;
    gap: 7px;
    min-width: 0;
    color: var(--text);
    text-decoration: none;
  }
  .guide-es-nav__link span:last-child {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }
  .guide-es-nav__link--next { text-align: end; justify-items: end; }
</style>
