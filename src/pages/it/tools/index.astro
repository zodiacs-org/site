---
import ReturnToolLinks from "../../../components/return-visits/ReturnToolLinks.astro";
import SharingToolLinks from '../../../components/sharing/SharingToolLinks.astro';
import Base from '../../../layouts/Base.astro';
import ToolIcon from '../../../components/ToolIcon.astro';
import ToolsHelpCard from '../../../components/tools/ToolsHelpCard.astro';
import ToolsLead from '../../../components/tools/ToolsLead.astro';
import ToolsPageHeading from '../../../components/ToolsPageHeading.astro';
import { ENGLISH_ONLY_COPY, localizePath, t } from '../../../lib/i18n';
import { toolIconForPath } from '../../../lib/tool-icons';
import '../../../styles/tools-hub.css';

const englishOnly = ENGLISH_ONLY_COPY.it;
const tools = [
  { href: '/birth-chart/', title: 'Tema natale', promise: 'Il tuo Sole, la tua Luna, l’ascendente, i pianeti, le case e il loro significato.' },
  { href: '/birth-chart/someone-else/', title: 'Tema di un’altra persona (in inglese)', promise: 'Usa i dati di nascita, i tre segni principali o un link Zodiacs, con il suo permesso.', englishOnly: true },
  { href: '/today/', title: 'Oggi (in inglese)', promise: 'Il tuo ultimo tema salvato a confronto con il cielo di mezzogiorno, gradi compresi.', englishOnly: true },
  { href: '/compatibility/', title: 'Compatibilità', promise: 'Confronta due temi e scopri dove si accordano, si scontrano e crescono.' },
  { href: '/moon-sign/', title: 'Segno lunare', promise: 'Come vivi le emozioni e che cosa ti calma.' },
  { href: '/rising-sign/', title: 'Ascendente', promise: 'Il segno che mostri agli altri al primo incontro. L’ora di nascita aiuta.' },
  { href: '/moon-phase/', title: 'Fase lunare', promise: 'La Luna di oggi e quella di qualsiasi data importante per te.' },
  { href: '/saturn-return/', title: 'Ritorno di Saturno', promise: 'Quando arriva il tuo, con precisione, e che cosa tende a chiedere.' },
  { href: '/transits/', title: 'Transiti', promise: 'Il cielo di oggi a confronto con il tuo tema.' },
];
const [lead, ...rest] = tools;
const iconFor = (href: string) => toolIconForPath(href) ?? 'birth-chart';

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'Strumenti astrologici gratuiti',
    url: 'https://zodiacs.org/it/tools/',
    description: 'Strumenti astrologici gratuiti, calcolati in modo riservato nel tuo browser.',
    inLanguage: 'it',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
];
---
<Base
  title="Strumenti astrologici gratuiti | Zodiacs.org"
  description="Strumenti astrologici gratuiti: tema natale, compatibilità, segno lunare, ascendente, fase lunare e ritorno di Saturno, calcolati nel tuo browser."
  path="/it/tools/"
  locale="it"
  image="/assets/og/v2/tool/tools.png"
  imageAlt="Strumenti astrologici gratuiti, Zodiacs.org"
  jsonLd={jsonLd}
>
  <header class="tools-hub tools-hub--solo kwrap">
    <div class="tools-hub__intro">
      <ToolsPageHeading>Strumenti astrologici gratuiti</ToolsPageHeading>
      <p class="klede tools-hub__lede">Scopri il tuo tema natale, il segno lunare, l’ascendente, le compatibilità e ciò che accade nel cielo adesso. I tuoi dati vengono calcolati nel browser.</p>
    </div>
    <ToolsLead
      href={localizePath('it', lead.href)}
      title={lead.title}
      text={lead.promise}
      needs={[t('it', 'birthDate'), t('it', 'birthTime'), t('it', 'birthplace')]}
      cta={t('it', 'getBirthChart')}
      reassure={t('it', 'privacyDevice')}
      locale="it"
    />
  </header>

  <section class="tools-block kwrap">
    <ul class="tools-grid tools-list">
      {rest.map((tool) => (
        <li>
          <a class="tools-row" href={'englishOnly' in tool ? tool.href : localizePath('it', tool.href)} hreflang={'englishOnly' in tool ? 'en' : undefined} title={'englishOnly' in tool ? englishOnly.aria : undefined} aria-label={'englishOnly' in tool ? `${tool.title}. ${englishOnly.aria}` : undefined}>
            <ToolIcon name={iconFor(tool.href)} size={52} />
            <div class="tool-card">
              <h2>{tool.title}</h2>
              <p>{tool.promise}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="tools-block kwrap">
    <h2 class="tools-section-title">Calendari del cielo</h2>
    <ul class="tools-list">
      <li class="tools-row"><ToolIcon name="full-moon-calendar" size={52} /><span class="tools-row__text"><a href="/it/full-moon-calendar/"><strong>Lune piene</strong></a>: date, segni e nomi fino al 2027.</span></li>
      <li class="tools-row"><ToolIcon name="eclipses" size={52} /><span class="tools-row__text"><a href="/it/eclipses/"><strong>Eclissi</strong></a>: solari e lunari fino al 2028.</span></li>
      <li class="tools-row"><ToolIcon name="retrogrades" size={52} /><span class="tools-row__text"><a href="/it/retrogrades/"><strong>Pianeti retrogradi</strong></a>: da Mercurio a Plutone. <a href="/it/mercury-retrograde/"><strong>Mercurio retrogrado</strong></a>: ogni periodo, con le stazioni.</span></li>
    </ul>
  </section>

  <section class="tools-block kwrap">
    <h2 class="tools-section-title">Disponibile anche in inglese</h2>
    <ul class="tools-list">
      <li class="tools-row"><ToolIcon name="horoscopes" size={52} /><span class="tools-row__text"><strong>Oroscopi.</strong> Il cielo di oggi, segno per segno. L’edizione inglese include anche le letture della settimana e del mese: <a href="/horoscopes/" hreflang="en" title={englishOnly.aria}>scegliere un segno</a>.</span></li>
    </ul>
  </section>

  <section class="tools-block kwrap"><SharingToolLinks locale="it" icons /></section>
  <section class="tools-block kwrap"><ReturnToolLinks locale="it" current="/saturn-return/" icons /></section>

  <section class="tools-help">
    <div class="kwrap"><div class="tools-help__grid tools-help__grid--one">
      <ToolsHelpCard icon="guide" title="Chiedi a Guide">
        <p>Guide può aiutarti con uno strumento, un termine astrologico o un tema che hai salvato qui.</p>
        <button class="btn btn--sm" type="button" data-assistant-open data-assistant-locale="it" aria-haspopup="dialog">Inizia una conversazione</button>
      </ToolsHelpCard>
    </div></div>
  </section>
</Base>
