---
import ReturnToolLinks from "../../../components/return-visits/ReturnToolLinks.astro";
import SharingToolLinks from '../../../components/sharing/SharingToolLinks.astro';
import Base from '../../../layouts/Base.astro';
import ToolGlyph from '../../../components/ToolGlyph.astro';
import ToolsPageHeading from '../../../components/ToolsPageHeading.astro';
import { ENGLISH_ONLY_COPY, localizePath } from '../../../lib/i18n';

const englishOnly = ENGLISH_ONLY_COPY.it;
const tools = [
  { href: '/birth-chart/', title: 'Tema natale', promise: 'Il tuo Sole, la tua Luna, l’ascendente, i pianeti, le case e il loro significato.', hue: 'var(--sign-cancer)', kind: 'birth' as const },
  { href: '/birth-chart/someone-else/', title: 'Tema di un’altra persona (in inglese)', promise: 'Usa i dati di nascita, i tre segni principali o un link Zodiacs, con il suo permesso.', hue: 'var(--sign-pisces)', kind: 'birth' as const, englishOnly: true },
  { href: '/today/', title: 'Oggi (in inglese)', promise: 'Il tuo ultimo tema salvato a confronto con il cielo di mezzogiorno, gradi compresi.', hue: 'var(--sign-cancer)', kind: 'transit' as const, englishOnly: true },
  { href: '/compatibility/', title: 'Compatibilità', promise: 'Confronta due temi e scopri dove si accordano, si scontrano e crescono.', hue: 'var(--sign-leo)', kind: 'compat' as const },
  { href: '/moon-sign/', title: 'Segno lunare', promise: 'Come vivi le emozioni e che cosa ti calma.', hue: 'var(--sign-pisces)', kind: 'moon' as const },
  { href: '/rising-sign/', title: 'Ascendente', promise: 'Il segno che mostri agli altri al primo incontro. L’ora di nascita aiuta.', hue: 'var(--sign-aries)', kind: 'rising' as const },
  { href: '/moon-phase/', title: 'Fase lunare', promise: 'La Luna di oggi e quella di qualsiasi data importante per te.', hue: 'var(--sign-cancer)', kind: 'moonphase' as const },
  { href: '/saturn-return/', title: 'Ritorno di Saturno', promise: 'Quando arriva il tuo, con precisione, e che cosa tende a chiedere.', hue: 'var(--sign-capricorn)', kind: 'saturn' as const },
  { href: '/transits/', title: 'Transiti', promise: 'Il cielo di oggi a confronto con il tuo tema.', hue: 'var(--sign-aries)', kind: 'transit' as const },
];

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'Strumenti astrologici gratuiti',
    url: 'https://zodiacs.org/it/tools/',
    description: 'Strumenti astrologici gratuiti, calcolati in modo riservato nel tuo browser.',
    inLanguage: 'it',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
];
---
<Base
  title="Strumenti astrologici gratuiti | Zodiacs.org"
  description="Strumenti astrologici gratuiti: tema natale, compatibilità, segno lunare, ascendente, fase lunare e ritorno di Saturno, calcolati nel tuo browser."
  path="/it/tools/"
  locale="it"
  image="/assets/og/v2/tool/tools.png"
  imageAlt="Strumenti astrologici gratuiti, Zodiacs.org"
  jsonLd={jsonLd}
>
  <section class="section container">
    <div class="section-head">
      <ToolsPageHeading>Strumenti astrologici gratuiti</ToolsPageHeading>
      <p>Scopri il tuo tema natale, il segno lunare, l’ascendente, le compatibilità e ciò che accade nel cielo adesso. I tuoi dati vengono calcolati nel browser.</p>
    </div>

    <div class="tools-grid">
      {tools.map((tool) => (
        <a class="shell tinted" href={'englishOnly' in tool ? tool.href : localizePath('it', tool.href)} hreflang={'englishOnly' in tool ? 'en' : undefined} title={'englishOnly' in tool ? englishOnly.aria : undefined} aria-label={'englishOnly' in tool ? `${tool.title}. ${englishOnly.aria}` : undefined} style={`--sign:${tool.hue}`}>
          <div class="core tinted tool-card">
            <ToolGlyph kind={tool.kind} />
            <h2>{tool.title}</h2>
            <p>{tool.promise}</p>
            <span class="tool-card__go">Apri →</span>
          </div>
        </a>
      ))}
      <button
        class="shell tinted assistant-tool"
        type="button"
        style="--sign:var(--ink-1)"
        data-assistant-open
        data-assistant-locale="it"
        aria-haspopup="dialog"
      >
        <div class="core tinted tool-card">
          <ToolGlyph kind="assistant" />
          <h2>Chiedi a Guide</h2>
          <p>Guide può aiutarti con uno strumento, un termine astrologico o un tema che hai salvato qui.</p>
          <span class="tool-card__go">Inizia una conversazione →</span>
        </div>
      </button>
    </div>

    <div class="tools-upcoming">
      <h2 class="list-heading">Calendari del cielo</h2>
      <ul>
        <li style="--sign:var(--sign-taurus)"><ToolGlyph kind="fullmoon" /><span><a href="/it/full-moon-calendar/"><strong>Lune piene</strong></a>: date, segni e nomi fino al 2027.</span></li>
        <li style="--sign:var(--sign-leo)"><ToolGlyph kind="eclipse" /><span><a href="/it/eclipses/"><strong>Eclissi</strong></a>: solari e lunari fino al 2028.</span></li>
        <li style="--sign:var(--sign-virgo)"><ToolGlyph kind="retrograde" /><span><a href="/it/mercury-retrograde/"><strong>Mercurio retrogrado</strong></a>: ogni periodo, con le stazioni.</span></li>
        <li style="--sign:var(--sign-capricorn)"><ToolGlyph kind="retrograde" /><span><a href="/it/retrogrades/"><strong>Pianeti retrogradi</strong></a>: da Mercurio a Plutone.</span></li>
      </ul>
    </div>

    <div class="tools-upcoming">
      <h2 class="list-heading">Disponibile anche in inglese</h2>
      <ul>
        <li style="--sign:var(--sign-sagittarius)"><ToolGlyph kind="sun" /><span><strong>Oroscopi.</strong> Il cielo di oggi, segno per segno. L’edizione inglese include anche le letture della settimana e del mese: <a href="/horoscopes/" hreflang="en" title={englishOnly.aria}>scegliere un segno</a>.</span></li>
      </ul>
    </div>
  </section>
<section class="section--tight container"><SharingToolLinks locale="it" icons /></section>
<section class="section--tight container"><ReturnToolLinks locale="it" icons /></section>
</Base>

<style>
  .tools-grid { display: grid; gap: 14px; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .tools-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .tools-grid { grid-template-columns: repeat(3, 1fr); } }
  .tool-card { display: flex; flex-direction: column; gap: 10px; padding: 26px 22px; min-height: 210px; }
  /* Tool-card icon disc lives in ToolGlyph.astro. */
  .tool-card h2 { margin: 4px 0 0; font-size: var(--text-lg); font-weight: 620; color: var(--text); }
  .tool-card p { margin: 0; font-size: var(--text-sm); color: var(--text-2); line-height: 1.6; }
  .tool-card__go { margin-top: auto; font-size: 13px; font-weight: 550; color: var(--text); }
  .assistant-tool { display: block; width: 100%; text-align: start; transition: border-color var(--dur-2) var(--ease), transform var(--dur-2) var(--ease); }
  .assistant-tool:hover { border-color: color-mix(in oklab, var(--sign) 45%, transparent); transform: translateY(-2px); }
  .assistant-tool:hover .core { border-color: color-mix(in oklab, var(--sign) 28%, transparent); }
  .tools-upcoming { margin-top: clamp(28px, 5vw, 44px); padding-top: 24px; border-top: 1px solid var(--hair-1); }
  .tools-upcoming ul { margin: 12px 0 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .tools-upcoming li { display: flex; align-items: center; gap: 12px; min-height: 44px; font-size: var(--text-sm); color: var(--muted); }
  /* Each entry wears its tool's pastel disc, at list size. */
  .tools-upcoming li :global(.tool-glyph) { width: 34px; height: 34px; margin: 0; flex: none; }
  .tools-upcoming li :global(.tool-glyph svg) { width: 18px; height: 18px; }
  .tools-upcoming strong { color: var(--text-2); font-weight: 600; }
  .tools-upcoming a { color: var(--text); }
</style>
