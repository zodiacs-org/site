---
import SharingToolLinks from '../../../components/sharing/SharingToolLinks.astro';
import Base from '../../../layouts/Base.astro';
import Faq from '../../../components/Faq.astro';
import SignIcon from '../../../components/SignIcon.astro';
import SynastryCalculator from '../../../islands/SynastryCalculator';
import { SIGNS, signName } from '../../../lib/signs';
import { pairSlug } from '../../../lib/compat';
import '../../../styles/calculator.css';

const faq = [
  {
    q: 'Come funziona la compatibilità astrologica?',
    a: 'L’astrologia confronta due temi natali misurando gli angoli tra i pianeti di due persone; questa pratica si chiama sinastria. Trigoni e sestili tra i temi vengono interpretati come segni di affinità, mentre quadrature e opposizioni indicano un attrito produttivo. La compatibilità tra segni solari è solo una sintesi molto breve di un confronto assai più ampio.',
  },
  {
    q: 'La compatibilità tra segni solari è reale?',
    a: 'È il livello più semplice da cui partire. Due persone sono molto più dei loro segni solari: nella pratica, Luna, Venere e Marte spesso contano di più. Le guide alle coppie di segni sono punti di partenza onesti, e il calcolatore confronta i due temi quando hai i dati di nascita.',
  },
  {
    q: 'Servono le ore di nascita esatte per confrontare due temi?',
    a: 'Le ore aiutano, ma non sono indispensabili. Senza l’ora esatta, il calcolatore usa il mezzogiorno locale come riferimento e omette ascendente, angoli e case. I segni della maggior parte dei pianeti restano stabili durante il giorno, ma la Luna avanza di circa 13 gradi e la sua posizione e gli aspetti vicini restano approssimativi.',
  },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    name: 'Calcolatore di compatibilità',
    url: 'https://zodiacs.org/it/compatibility/',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Calcolatore gratuito di sinastria per confrontare due temi natali sul tuo dispositivo.',
    inLanguage: 'it',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
  {
    '@type': 'FAQPage',
    inLanguage: 'it',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base privateSurface
  clientUi
  title="Calcolatore di compatibilità astrologica | Zodiacs.org"
  description="Confronta gratuitamente due temi natali nel tuo browser, in modo riservato, con letture chiare e guide per le 78 combinazioni di segni."
  path="/it/compatibility/"
  locale="it"
  image="/assets/og/v2/tool/compatibility.png"
  imageAlt="Calcolatore di compatibilità — Zodiacs.org"
  jsonLd={jsonLd}
  glass
>
  <section class="section--tight container container--narrow">
    <div class="compat-hero">
      <em class="kicker">Due temi, confrontati con chiarezza</em>
      <h1 class="display">Esplora la tua compatibilità astrologica.</h1>
      <p>I segni solari sono solo l’inizio. Confronta due temi natali nel tuo browser: due temi riuniti in un’unica ruota, con gli aspetti tracciati e una lettura che puoi davvero usare.</p>
    </div>
    <SynastryCalculator locale="it" client:load />
    <noscript>
      <p>Questo calcolatore di compatibilità richiede JavaScript. Attiva JavaScript e ricarica la pagina per confrontare due temi natali nel tuo browser.</p>
    </noscript>
  </section>

  <section class="section container">
    <div class="section-head">
      <h2>Le 78 combinazioni</h2>
      <p>Le guide complete restano per ora in inglese, ma puoi esplorare ogni coppia come punto di partenza.</p>
    </div>
    <div class="compat-index">
      {SIGNS.map((a) => (
        <div class="compat-row" style={`--sign:${a.hue}`}>
          <a class="compat-row__sign" href={`/it/${a.slug}/`}>
            <SignIcon sign={a.slug} size={34} class="compat-row__icon" />
            <span>{signName(a, 'it')}</span>
          </a>
          <div class="compat-row__pairs">
            {SIGNS.map((b) => (
              <a class="compat-row__pair" href={`/compatibility/${pairSlug(a.slug, b.slug)}/`} hreflang="en">
                {signName(b, 'it')}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <Faq items={faq} heading="Domande sulla compatibilità" />
  </section>
<section class="section--tight container"><SharingToolLinks locale="it" /></section>
</Base>

<style>
  .compat-hero { max-width: 58ch; margin-bottom: clamp(26px, 5vw, 42px); }
  .compat-hero h1 { margin: 14px 0; font-size: var(--text-2xl); line-height: 1.04; }
  .compat-hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }
  .compat-index { display: grid; }
  .compat-row { display: grid; gap: 10px 26px; padding: 16px 0; border-bottom: 1px solid var(--hair-1); grid-template-columns: 1fr; }
  .compat-row:first-child { border-top: 1px solid var(--hair-1); }
  @media (min-width: 760px) { .compat-row { grid-template-columns: 190px 1fr; align-items: start; } }
  .compat-row__sign { display: inline-flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; font-weight: 600; }
  .compat-row__pairs { display: flex; flex-wrap: wrap; gap: 7px; }
  .compat-row__pair { padding: 5px 10px; border: 1px solid var(--hair-1); border-radius: var(--r-full); color: var(--text-2); text-decoration: none; font-size: 13px; }
</style>
