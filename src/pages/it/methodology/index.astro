import { EDITOR_AUTHOR } from '../../../lib/editorial';

const jsonLd = [
  {
    '@type': 'Article',
    headline: 'Come calcoliamo il tuo tema natale',
    url: 'https://zodiacs.org/it/methodology/',
    datePublished: '2026-07-15T00:00:00+07:00',
    dateModified: '2026-09-28T00:00:00Z',
    author: EDITOR_AUTHOR,
    publisher: { '@id': 'https://zodiacs.org/#org' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': 'https://zodiacs.org/it/methodology/' },
    inLanguage: 'it',
    about: 'Metodo astronomico, gestione dei fusi orari e modello di privacy del motore per i temi natali di Zodiacs.org.',
