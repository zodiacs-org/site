---
import ReturnToolLinks from "../../../components/return-visits/ReturnToolLinks.astro";
import Base from '../../../layouts/Base.astro';
import ProfileDashboard from '../../../islands/ProfileDashboard';
import SavedRecordsPanel from '../../../islands/SavedRecordsPanel';
import { savedRecordsEnabled } from '../../../lib/profile/saved-record-flags';
import ProfileManager from '../../../islands/ProfileManager';
import AccountBoundProfileSurface from '../../../islands/AccountBoundProfileSurface';
import { accountSyncV2Enabled as isAccountSyncV2Enabled } from '../../../lib/account-v2/feature-flags';
import '../../../styles/calculator.css';
import '../../../styles/profile-polish.css';
import '../../../styles/profile-page.css';

const accountSyncV2Enabled = isAccountSyncV2Enabled({
  PUBLIC_ACCOUNT_SYNC_V2_ENABLED: process.env.PUBLIC_ACCOUNT_SYNC_V2_ENABLED,
  PUBLIC_ACCOUNT_SYNC_V2_PREVIEW_ACK: process.env.PUBLIC_ACCOUNT_SYNC_V2_PREVIEW_ACK,
});
const savedRecordsSurfaceEnabled = savedRecordsEnabled({
  PUBLIC_SAVED_RECORDS_ENABLED: process.env.PUBLIC_SAVED_RECORDS_ENABLED,
});

const jsonLd = [
  {
    '@type': 'WebPage',
    name: 'Temi salvati',
    url: 'https://zodiacs.org/it/profile/',
    description: 'Salva i tuoi temi su questo dispositivo e sincronizzali con il tuo account solo se lo desideri.',
    inLanguage: 'it',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
];
---
<Base
  clientUi
  title="Temi salvati | Zodiacs.org"
  description="Salva i tuoi temi in modo riservato su questo dispositivo e accedi se vuoi ritrovarli su tutti i tuoi dispositivi."
  path="/it/profile/"
  locale="it"
  jsonLd={jsonLd}
  privateSurface={accountSyncV2Enabled}
>
  <section class="section--tight container pf-page">
    <div class="pf-hero">
      <h1 class="display">I tuoi temi salvati.</h1>
      <p>Salva i tuoi temi su questo dispositivo. Accedi se vuoi ritrovarli su tutti i tuoi dispositivi.</p>
    </div>
    {accountSyncV2Enabled ? (
      <AccountBoundProfileSurface locale="it" client:load />
    ) : (
      <>
        <ProfileDashboard locale="it" client:load />
        <ProfileManager locale="it" client:load />
      </>
    )}
    <SavedRecordsPanel enabled={savedRecordsSurfaceEnabled} locale="it" client:load />
    <aside class="pf-note">
      <p class="mono">{accountSyncV2Enabled
        ? <>La prova di sincronizzazione cifrata viene gestita temporaneamente su <a href="/profile/">/profile/</a>. Qui i tuoi temi restano solo su questo dispositivo.</>
        : 'Se cancelli i dati del browser, i temi salvati solo in locale verranno eliminati. Accedi per sincronizzare i temi salvati e fare in modo che le eliminazioni si riflettano su tutti i tuoi dispositivi.'}</p>
    </aside>
  </section>
<section class="section--tight container"><ReturnToolLinks locale="it" /></section>
</Base>
