---
import Base from '../../layouts/Base.astro';
import SignIcon from '../../components/SignIcon.astro';
import { SIGNS, signName } from '../../lib/signs';
---
<Base
  title="Pagina non trovata — Zodiacs.org"
  description="Questa pagina non esiste. Consulta una guida ai segni o calcola gratuitamente il tuo tema natale."
  path="/it/404/"
  locale="it"
  noindex
>
  <section class="section container nf">
    <h1 class="display">Questa pagina non esiste.</h1>
    <p class="dateline">Errore 404</p>
    <p>Quello che cercavi è stato spostato, oppure non è mai esistito. I dodici segni sono ancora qui:</p>
    <div class="nf__signs">
      {SIGNS.map((s) => (
        <a href={`/it/${s.slug}/`} aria-label={signName(s, 'it')} style={`--sign:${s.hue}`}>
          <SignIcon sign={s.slug} size={40} />
        </a>
      ))}
    </div>
    <div class="nf__ctas">
      <a class="btn btn--primary" href="/it/"><span>Torna alla home</span><span class="orb">→</span></a>
      <a class="btn btn--ghost" href="/it/birth-chart/"><span>Calcola il mio tema natale gratis</span></a>
    </div>
  </section>
</Base>

<style>
  .nf { text-align: center; display: grid; justify-items: center; gap: 18px; }
  .nf h1 { margin: 6px 0 0; font-size: var(--text-2xl); max-width: 16ch; }
  .nf p { margin: 0; max-width: 44ch; color: var(--muted); }
  .nf__signs { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: 10px 0; max-width: 560px; }
  .nf__signs a { display: grid; place-items: center; padding: 6px; border-radius: 50%; border: 1px solid transparent; }
  .nf__ctas { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
</style>
