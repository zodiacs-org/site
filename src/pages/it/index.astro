---
import Base from '../../layouts/Base.astro';
import LocalizedHome from '../../components/localized/LocalizedHome.astro';
import LocalizedHomeHead from '../../components/localized/LocalizedHomeHead.astro';
import { localizedHomeFaq, localizedHomeFaqSchema } from '../../components/localized/home-copy';

// The English homepage's two own questions, in Italian. The data answer is
// the birth chart page's, as published there.
const faq = localizedHomeFaq('it', [
  {
    q: 'Che cosa succede ai miei dati di nascita?',
    a: 'Il tema completo viene calcolato nel tuo browser; il calcolatore non usa nessuna API lato server e non serve un account. Se salvi un tema, resta prima di tutto su questo dispositivo. La sincronizzazione facoltativa trasferisce i temi salvati solo dopo l’accesso.',
  },
  {
    q: 'E se non conosco l’ora di nascita?',
    a: 'Scegli «Non la conosco». Il calcolatore usa le 12:00 come riferimento, tralascia l’ascendente e le case invece di inventarli e indica il segno lunare come non verificato finché non aggiungi un’ora, perché la Luna può cambiare segno nel corso della giornata.',
  },
]);

const jsonLd = [
  localizedHomeFaqSchema(faq),
  {
    '@type': 'WebSite',
    '@id': 'https://zodiacs.org/#site',
    url: 'https://zodiacs.org/',
    name: 'Zodiacs.org',
    description: 'Temi natali gratuiti, segno lunare, compatibilità, oroscopi e guide ai segni, riservati e facili da capire.',
    publisher: { '@id': 'https://zodiacs.org/#org' },
    inLanguage: ['en', 'it'],
  },
];
---
<Base
  clientUi
  title="Tema natale gratuito e astrologia | Zodiacs.org"
  description="Temi natali gratuiti, segno lunare, ascendente, compatibilità, oroscopi e guide ai segni, calcolati in privato nel tuo browser."
  path="/it/"
  locale="it"
  jsonLd={jsonLd}
>
  <LocalizedHomeHead slot="head" locale="it" />
  <LocalizedHome locale="it" faq={faq} />
</Base>
