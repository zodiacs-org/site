---
import Base from '../../../layouts/Base.astro';
import AskGuideLine from '../../../components/AskGuideLine.astro';
import Faq from '../../../components/Faq.astro';
import EmailCapture from '../../../components/EmailCapture.astro';
import ChartCalculator from '../../../islands/ChartCalculator';
import '../../../styles/calculator.css';
import '../../../styles/explorer.css';

const faq = [
  {
    q: 'Che cos’è un tema natale?',
    a: 'Un tema natale, o carta astrale, è una mappa della posizione di ogni pianeta — vista dalla Terra — nel momento e nel luogo esatti della tua nascita. Mostra il Sole, la Luna e l’ascendente, insieme alle posizioni da Mercurio a Plutone nelle dodici case.',
  },
  {
    q: 'Devo conoscere l’ora esatta della mia nascita?',
    a: 'Sì, per calcolare l’ascendente e le case: l’ascendente cambia circa ogni due ore. Se non conosci l’ora, usiamo le 12:00 dell’ora civile locale come riferimento per le posizioni e omettiamo ascendente, angoli e case. Poiché la Luna può cambiare segno nel corso della giornata, il risultato indica il segno lunare come non verificato finché non aggiungi l’ora. Il certificato di nascita, il libretto sanitario o la tua famiglia sono spesso le fonti migliori.',
  },
  {
    q: 'Quanto è preciso questo calcolatore?',
    a: 'Le posizioni planetarie sono calcolate con un motore astronomico e confrontate con i dati di riferimento del JPL della NASA, con un margine di pochi centesimi di grado. I cambi d’ora storici dal 1970 in poi sono gestiti con la cronologia IANA fornita dal browser o dal sistema del dispositivo, e quelli precedenti con una versione fissata del database IANA, compresi i registri più vecchi che conserva a parte per i luoghi i cui orologi hanno poi coinciso con quelli di un’altra città, che i suoi curatori considerano meno affidabili. Per una nascita precedente all’adozione di un’ora ufficiale nel luogo si usa l’ora media locale del luogo di nascita stesso.',
  },
  {
    q: 'Che cosa succede ai miei dati di nascita?',
    a: 'Il tema completo viene calcolato nel tuo browser; il calcolatore non usa nessuna API lato server e non serve un account. Se salvi un tema, resta prima di tutto su questo dispositivo. La sincronizzazione facoltativa trasferisce i temi salvati solo dopo l’accesso.',
  },
  {
    q: 'Case a segni interi o Placidus: quale scegliere?',
    a: 'Il sistema delle case a segni interi è il più antico e il più semplice da leggere: ogni casa occupa un segno completo. Placidus è l’opzione moderna più diffusa e divide le case in base al loro tempo di ascensione, perciò le dimensioni variano. Provali entrambi: i pianeti non si spostano; cambiano solo i confini delle case.',
  },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    name: 'Calcolatore gratuito del tema natale',
    url: 'https://zodiacs.org/it/birth-chart/',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: 'Sole, Luna, ascendente, pianeti da Mercurio a Plutone, Nodo vero, case a segni interi e Placidus, aspetti',
    inLanguage: 'it',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
  {
    '@type': 'FAQPage',
    inLanguage: 'it',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org in italiano', item: 'https://zodiacs.org/it/' },
      { '@type': 'ListItem', position: 2, name: 'Strumenti', item: 'https://zodiacs.org/it/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Calcolatore del tema natale', item: 'https://zodiacs.org/it/birth-chart/' },
    ],
  },
];
---
<Base
  clientUi
  glass
  title="Tema natale gratuito — Sole, Luna e ascendente | Zodiacs.org"
  description="Calcola gratis il tuo tema natale: Sole, Luna, ascendente, pianeti e case, con il loro significato. Tutto resta nel tuo browser."
  path="/it/birth-chart/"
  locale="it"
  image="/assets/og/v2/tool/birth-chart.png"
  imageAlt="Calcolatore gratuito del tema natale — Zodiacs.org"
  jsonLd={jsonLd}
>
  <script slot="head" is:inline>
    try {
      var chartShareParams = new URLSearchParams(location.hash.slice(1));
      if (chartShareParams.has('p') || chartShareParams.has('c')) {
        document.documentElement.dataset.chartShareReceiver = '';
        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('a[href="/astrofolio/"],a[href^="/registry/"],a[href^="/sdk/"]').forEach(function (element) {
            var footerWing = element.closest('.footer__col, .zfooter__group');
            (footerWing || element).remove();
          });
        }, { once: true });
      }
    } catch (error) {}
  </script>
  <style slot="head" is:inline>
    html[data-chart-share-receiver] a[href="/astrofolio/"],
    html[data-chart-share-receiver] a[href^="/registry/"],
    html[data-chart-share-receiver] a[href^="/sdk/"],
    html[data-chart-share-receiver] .calc__record,
    html[data-chart-share-receiver] [data-registry-aura-chart-link],
    html[data-chart-share-receiver] .footer__col:has(a[href^="/registry/"]),
    html[data-chart-share-receiver] .zfooter__group:has(a[href^="/registry/"]) { display: none !important; }
  </style>
  <section class="section--tight container">
    <div class="tool-hero">
      <h1 class="display">Calcola il tuo tema natale gratis.</h1>
      <p>Inserisci data, ora e luogo di nascita per vedere il Sole, la Luna, l’ascendente, i pianeti, le case e il loro significato.</p>
    </div>
    <ChartCalculator mode="full" locale="it" client:idle />
    <EmailCapture placement="chart" locale="it" revealOnChart />
    <noscript>
      <p>Questo calcolatore del tema natale richiede JavaScript. Attiva JavaScript e ricarica la pagina per calcolare Sole, Luna, ascendente, pianeti e case nel tuo browser.</p>
    </noscript>
    <AskGuideLine lead="Domande su una posizione del tuo tema?" locale="it" />
  </section>

  <section class="section--tight container container--narrow">
    <div class="prose">
      <h2>Che cosa stai guardando</h2>
      <p>Un tema natale è una fotografia del cielo scattata dal luogo e nel momento della tua nascita. Mostra segni, case e pianeti a gradi precisi.</p>
      <p>Inizia dal Sole, dalla Luna e dall’ascendente: identità, vita emotiva e prima impressione. Poi puoi salvare il tema e tornarci quando vuoi.</p>
      <p>Trovi tutti i dettagli nella pagina dedicata al <a href="/it/methodology/">metodo di calcolo</a>.</p>
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <Faq items={faq} heading="Domande sul tema natale" />
  </section>
</Base>

<style>
  .tool-hero { max-width: 62ch; margin-bottom: clamp(28px, 5vw, 44px); }
  .tool-hero h1 { margin: 0 0 16px; font-size: var(--text-2xl); line-height: 1.04; }
  .tool-hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }
</style>
