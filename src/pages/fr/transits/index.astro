---
import Base from '../../../layouts/Base.astro';
import Faq from '../../../components/Faq.astro';
import TransitTracker from '../../../islands/TransitTracker';
import PlanetGlyph from '../../../components/PlanetGlyph';
import { dayLabel, eventList, transitMonthForEdition, monthLabel } from '../../../lib/horoscopes';
import daily from '../../../data/daily.json';
import '../../../styles/calculator.css';

const month = transitMonthForEdition(daily.date);
const events = month ? eventList(month, 'fr') : [];
const label = month ? monthLabel(month, 'fr') : null;

const faq = [
  {
    q: 'Qu’est-ce qu’un transit ?',
    a: 'Les planètes ont continué à bouger après ta naissance. Un transit est la position actuelle d’une planète comparée à une position de ton thème astral. Par exemple, Saturne en transit au carré de ta Lune natale signifie qu’aujourd’hui, Saturne se trouve à quatre-vingt-dix degrés de la position occupée par la Lune à ta naissance. Les transits sont le principal outil astrologique pour étudier les périodes de la vie.',
  },
  {
    q: 'Quels transits cette page affiche-t-elle ?',
    a: 'Elle montre les aspects entre les dix planètes du ciel — aujourd’hui ou à la date choisie avec le curseur — et les dix planètes de ton thème astral, lorsque leur orbe est inférieur ou égal à 3 degrés, la marge étroite dans laquelle un transit est généralement considéré comme actif. La Lune en transit ne figure pas dans la liste, car elle parcourt tout ton thème chaque mois, mais elle reste visible sur l’anneau extérieur.',
  },
  {
    q: 'Pourquoi les transits lents comptent-ils davantage ?',
    a: 'La vitesse détermine la durée. Le Soleil traverse un point natal en environ deux jours et Mars en une ou deux semaines, mais Saturne peut rester plusieurs mois à moins de trois degrés d’un point, et Pluton pendant deux ans. Les boucles rétrogrades font aussi passer les planètes lentes trois fois au même endroit. L’astrologie interprète ces longues visites comme des chapitres, pas comme un état passager.',
  },
  {
    q: 'Ai-je besoin de mon heure de naissance exacte ?',
    a: 'Pour la plupart des transits, non. Les aspects entre planètes fonctionnent avec la date et le lieu de naissance. La Lune fait exception : sans heure, elle est calculée à midi et peut être décalée de six degrés au maximum ; les transits lunaires proches de la limite de l’orbe sont donc incertains. L’outil te prévient lorsque cela arrive.',
  },
];

const jsonLd = [
  {
    '@type': 'WebPage',
    name: 'Suivi des transits : le ciel en mouvement sur ton thème',
    url: 'https://zodiacs.org/fr/transits/',
    description: 'Le ciel en mouvement sur ton thème astral : transits avec un orbe maximal de 3 degrés, aujourd’hui ou à toute date jusqu’à un an avant ou après.',
    inLanguage: 'fr',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
  {
    '@type': 'FAQPage',
    inLanguage: 'fr',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  clientUi
  title="Transits du jour sur ton thème astral | Zodiacs.org"
  description="Les transits du jour sur tes planètes natales, à 3° d’orbe au plus, et un curseur pour avancer ou reculer le ciel jusqu’à un an. Calculé sur ton appareil."
  path="/fr/transits/"
  locale="fr"
  image="/assets/og/v2/tool/transits.png"
  imageAlt="Suivi des transits — Zodiacs.org"
  jsonLd={jsonLd}
  glass
>
  <section class="section--tight container container--narrow">
    <div class="tool-hero reveal">
      <h1 class="display">Le ciel, sur ton thème.</h1>
      <p>Les planètes du jour comparées aux tiennes, avec un orbe maximal de 3°, et un curseur pour déplacer le ciel jusqu’à un an avant ou après afin de voir un transit se former, culminer puis s’éloigner. Choisis un thème enregistré ou indique tes données ; rien ne quitte ton appareil.</p>
    </div>
    <TransitTracker locale="fr" client:load />
    <noscript>
      <p>Ce calculateur de transits nécessite JavaScript. Active JavaScript et recharge la page pour comparer le ciel actuel à ton thème astral dans ton navigateur.</p>
    </noscript>
  </section>

  {month && (
    <section class="section--tight container container--narrow">
      <div class="section-head reveal">
        <h2>Le ciel en {label}</h2>
        <p>Événements du mois calculés par le moteur : entrées dans les signes, lunaisons, stations et aspects exacts. Les heures sont en temps universel.</p>
      </div>
      <ul class="trn-events reveal">
        {events.map((event) => (
          <li><span class="trn-events__date mono">{dayLabel(event.at, 'fr')}</span><span class="trn-events__label"><PlanetGlyph body={event.body} hue={event.hue} size={14} class="rcpt-glyph" />{event.label}</span></li>
        ))}
      </ul>
    </section>
  )}

  <section class="section--tight container container--narrow">
    <Faq items={faq} heading="Questions sur les transits" />
  </section>
</Base>

<style>
  .tool-hero { max-width: 62ch; margin-bottom: clamp(24px, 4vw, 36px); }
  .tool-hero h1 { margin: 0 0 16px; font-size: var(--text-2xl); line-height: 1.04; }
  .tool-hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }
  .trn-events { margin: 0; padding: 0; list-style: none; display: grid; gap: 7px; }
  .trn-events li { display: flex; align-items: baseline; gap: 16px; padding-bottom: 7px; border-bottom: 1px solid var(--hair-1); }
  .trn-events__date { flex-shrink: 0; width: 58px; font-size: 11px; color: var(--faint); letter-spacing: 0.05em; }
  .trn-events__label { font-size: var(--text-sm); color: var(--text-2); }
</style>
