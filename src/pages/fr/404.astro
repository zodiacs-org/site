---
import Base from '../../layouts/Base.astro';
import SignIcon from '../../components/SignIcon.astro';
import { SIGNS, signName } from '../../lib/signs';
---
<Base
  title="Page introuvable — Zodiacs.org"
  description="Cette page n’existe pas. Consulte un guide des signes ou calcule gratuitement ton thème astral."
  path="/fr/404/"
  locale="fr"
  noindex
>
  <section class="section container nf">
    <em class="kicker">Erreur 404</em>
    <h1 class="display">Cette page n’existe pas.</h1>
    <p>Ce que tu cherchais a été déplacé, ou n’a jamais existé. Les douze signes sont toujours là :</p>
    <div class="nf__signs">
      {SIGNS.map((s) => (
        <a href={`/fr/${s.slug}/`} aria-label={signName(s, 'fr')} style={`--sign:${s.hue}`}>
          <SignIcon sign={s.slug} size={40} />
        </a>
      ))}
    </div>
    <div class="nf__ctas">
      <a class="btn btn--primary" href="/fr/"><span>Retour à l’accueil</span><span class="orb">→</span></a>
      <a class="btn btn--ghost" href="/fr/birth-chart/"><span>Obtenir mon thème astral gratuit</span></a>
    </div>
  </section>
</Base>

<style>
  .nf { text-align: center; display: grid; justify-items: center; gap: 18px; }
  .nf h1 { margin: 6px 0 0; font-size: var(--text-2xl); max-width: 16ch; }
  .nf p { margin: 0; max-width: 44ch; color: var(--muted); }
  .nf__signs { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: 10px 0; max-width: 560px; }
  .nf__signs a { display: grid; place-items: center; padding: 6px; border-radius: 50%; border: 1px solid transparent; }
  .nf__ctas { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
</style>
