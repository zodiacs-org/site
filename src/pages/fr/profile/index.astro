---
import ReturnToolLinks from "../../../components/return-visits/ReturnToolLinks.astro";
import Base from '../../../layouts/Base.astro';
import ProfileDashboard from '../../../islands/ProfileDashboard';
import SavedRecordsPanel from '../../../islands/SavedRecordsPanel';
import { savedRecordsEnabled } from '../../../lib/profile/saved-record-flags';
import ProfileManager from '../../../islands/ProfileManager';
import AccountBoundProfileSurface from '../../../islands/AccountBoundProfileSurface';
import { accountSyncV2Enabled as isAccountSyncV2Enabled } from '../../../lib/account-v2/feature-flags';
import '../../../styles/calculator.css';
import '../../../styles/profile-polish.css';
import '../../../styles/profile-page.css';

const accountSyncV2Enabled = isAccountSyncV2Enabled({
  PUBLIC_ACCOUNT_SYNC_V2_ENABLED: process.env.PUBLIC_ACCOUNT_SYNC_V2_ENABLED,
  PUBLIC_ACCOUNT_SYNC_V2_PREVIEW_ACK: process.env.PUBLIC_ACCOUNT_SYNC_V2_PREVIEW_ACK,
});
const savedRecordsSurfaceEnabled = savedRecordsEnabled({
  PUBLIC_SAVED_RECORDS_ENABLED: process.env.PUBLIC_SAVED_RECORDS_ENABLED,
});

const jsonLd = [
  {
    '@type': 'WebPage',
    name: 'Thèmes enregistrés',
    url: 'https://zodiacs.org/fr/profile/',
    description: 'Enregistre tes thèmes sur cet appareil et synchronise-les avec ton compte seulement si tu le souhaites.',
    inLanguage: 'fr',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
];
---
<Base
  clientUi
  title="Thèmes enregistrés | Zodiacs.org"
  description="Enregistre tes thèmes en toute confidentialité sur cet appareil et connecte-toi si tu veux les retrouver sur tous tes appareils."
  path="/fr/profile/"
  locale="fr"
  jsonLd={jsonLd}
  privateSurface={accountSyncV2Enabled}
>
  <section class="section--tight container pf-page">
    <div class="pf-hero">
      <h1 class="display">Tes thèmes enregistrés.</h1>
      <p>Enregistre tes thèmes sur cet appareil. Connecte-toi si tu veux les retrouver sur tous tes appareils.</p>
    </div>
    {accountSyncV2Enabled ? (
      <AccountBoundProfileSurface locale="fr" client:load />
    ) : (
      <>
        <ProfileDashboard locale="fr" client:load />
        <ProfileManager locale="fr" client:load />
      </>
    )}
    <SavedRecordsPanel enabled={savedRecordsSurfaceEnabled} locale="fr" client:load />
    <aside class="pf-note">
      <p class="mono">{accountSyncV2Enabled
        ? <>Le test de synchronisation chiffrée se gère temporairement sur <a href="/profile/">/profile/</a>. Ici, tes thèmes restent uniquement sur cet appareil.</>
        : 'Si tu effaces les données du navigateur, les thèmes enregistrés uniquement en local seront supprimés. Connecte-toi pour synchroniser tes thèmes et répercuter leur suppression sur tes autres appareils.'}</p>
    </aside>
  </section>
<section class="section--tight container"><ReturnToolLinks locale="fr" /></section>
</Base>
