---
import SharingToolLinks from '../../../components/sharing/SharingToolLinks.astro';
import Base from '../../../layouts/Base.astro';
import Faq from '../../../components/Faq.astro';
import SignIcon from '../../../components/SignIcon.astro';
import SynastryCalculator from '../../../islands/SynastryCalculator';
import { SIGNS, signName } from '../../../lib/signs';
import { pairSlug } from '../../../lib/compat';
import '../../../styles/calculator.css';

const faq = [
  {
    q: 'Comment fonctionne la compatibilité astrologique ?',
    a: 'L’astrologie compare deux thèmes astraux en mesurant les angles entre les planètes de deux personnes ; cette pratique s’appelle la synastrie. Les trigones et sextiles entre les thèmes sont interprétés comme des affinités, tandis que les carrés et oppositions indiquent une friction productive. La compatibilité entre signes solaires n’est qu’un résumé très bref d’une comparaison bien plus vaste.',
  },
  {
    q: 'La compatibilité entre signes solaires est-elle réelle ?',
    a: 'C’est la couche utile la plus simple. Deux personnes ne se résument pas à leur signe solaire : dans la pratique, la Lune, Vénus et Mars comptent souvent davantage. Les guides des paires de signes sont des points de départ honnêtes, et le calculateur compare les deux thèmes lorsque tu disposes des données de naissance.',
  },
  {
    q: 'Faut-il les heures de naissance exactes pour comparer deux thèmes ?',
    a: 'Les heures sont utiles, mais pas indispensables. Sans elles, le calculateur utilise midi local comme référence et omet l’ascendant, les angles et les maisons. Les signes de la plupart des planètes restent stables pendant la journée, mais la Lune avance d’environ 13 degrés et sa position et les aspects proches restent approximatifs.',
  },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    name: 'Calculateur de compatibilité',
    url: 'https://zodiacs.org/fr/compatibility/',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description: 'Calculateur de synastrie gratuit pour comparer deux thèmes astraux sur ton appareil.',
    inLanguage: 'fr',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
  {
    '@type': 'FAQPage',
    inLanguage: 'fr',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base privateSurface
  clientUi
  title="Calculateur de compatibilité astrologique | Zodiacs.org"
  description="Compare gratuitement deux thèmes astraux dans ton navigateur, avec les aspects qui les relient et des guides pour les 78 combinaisons de signes."
  path="/fr/compatibility/"
  locale="fr"
  image="/assets/og/v2/tool/compatibility.png"
  imageAlt="Calculateur de compatibilité — Zodiacs.org"
  jsonLd={jsonLd}
  glass
>
  <section class="section--tight container container--narrow" id="calculator">
    <div class="compat-hero">
      <em class="kicker">Deux thèmes, comparés clairement</em>
      <h1 class="display">Explore ta compatibilité astrologique.</h1>
      <p>Les signes solaires ne sont qu’un début. Compare deux thèmes astraux dans ton navigateur : deux thèmes réunis sur une seule roue, avec leurs liens tracés et une lecture que tu peux vraiment utiliser.</p>
    </div>
    <SynastryCalculator locale="fr" client:load />
    <noscript>
      <p>Ce calculateur de compatibilité nécessite JavaScript. Active JavaScript et recharge la page pour comparer deux thèmes astraux dans ton navigateur.</p>
    </noscript>
  </section>

  <section class="section container">
    <div class="section-head">
      <h2>Les 78 combinaisons</h2>
      <p>Chaque duo a son guide : comment il fonctionne, là où ça frotte et ce qui le fait durer.</p>
    </div>
    <div class="compat-index">
      {SIGNS.map((a) => (
        <div class="compat-row" style={`--sign:${a.hue}`}>
          <a class="compat-row__sign" href={`/fr/${a.slug}/`}>
            <SignIcon sign={a.slug} size={34} class="compat-row__icon" />
            <span>{signName(a, 'fr')}</span>
          </a>
          <div class="compat-row__pairs">
            {SIGNS.map((b) => (
              <a class="compat-row__pair" href={`/fr/compatibility/${pairSlug(a.slug, b.slug)}/`}>
                {signName(b, 'fr')}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <Faq items={faq} heading="Questions sur la compatibilité" />
  </section>
<section class="section--tight container"><SharingToolLinks locale="fr" /></section>
</Base>

<style>
  .compat-hero { max-width: 58ch; margin-bottom: clamp(26px, 5vw, 42px); }
  .compat-hero h1 { margin: 14px 0; font-size: var(--text-2xl); line-height: 1.04; }
  .compat-hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }
  .compat-index { display: grid; }
  .compat-row { display: grid; gap: 10px 26px; padding: 16px 0; border-bottom: 1px solid var(--hair-1); grid-template-columns: 1fr; }
  .compat-row:first-child { border-top: 1px solid var(--hair-1); }
  @media (min-width: 760px) { .compat-row { grid-template-columns: 190px 1fr; align-items: start; } }
  .compat-row__sign { display: inline-flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; font-weight: 600; }
  .compat-row__pairs { display: flex; flex-wrap: wrap; gap: 7px; }
  .compat-row__pair { padding: 5px 10px; border: 1px solid var(--hair-1); border-radius: var(--r-full); color: var(--text-2); text-decoration: none; font-size: 13px; }
</style>
