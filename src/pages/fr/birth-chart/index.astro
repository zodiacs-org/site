---
import Base from '../../../layouts/Base.astro';
import AskGuideLine from '../../../components/AskGuideLine.astro';
import Faq from '../../../components/Faq.astro';
import EmailCapture from '../../../components/EmailCapture.astro';
import ChartCalculator from '../../../islands/ChartCalculator';
import '../../../styles/calculator.css';
import '../../../styles/explorer.css';

const faq = [
  {
    q: 'Qu’est-ce qu’un thème astral ?',
    a: 'Un thème astral, ou thème natal, est une carte de la position de chaque planète — vue depuis la Terre — au moment et à l’endroit précis de ta naissance. Il indique ton Soleil, ta Lune et ton ascendant, ainsi que les positions de Mercure à Pluton dans les douze maisons.',
  },
  {
    q: 'Dois-je connaître mon heure de naissance exacte ?',
    a: 'Oui, pour calculer l’ascendant et les maisons : l’ascendant change environ toutes les deux heures. Si tu ignores l’heure, nous utilisons 12 h en heure civile locale comme référence pour les positions et omettons l’ascendant, les angles et les maisons. Comme la Lune peut changer de signe au cours de la journée, le résultat indique le signe lunaire comme non vérifié tant que tu n’ajoutes pas l’heure. Ton acte de naissance, ton carnet de santé ou ta famille sont souvent les meilleures sources.',
  },
  {
    q: 'Quelle est la précision de ce calculateur ?',
    a: 'Les positions planétaires sont calculées avec un moteur astronomique et comparées aux données de référence du JPL de la NASA, avec une marge de quelques centièmes de degré. Les changements d’heure historiques depuis 1970 sont traités avec l’historique IANA fourni par le navigateur ou le système de l’appareil, et les plus anciens avec une version figée de la base de données IANA, y compris les anciens enregistrements qu’elle conserve à part pour les lieux dont l’heure s’est ensuite alignée sur celle d’une autre ville, que ses responsables jugent moins fiables. Pour une naissance antérieure à l’adoption d’une heure légale dans le lieu, nous utilisons l’heure moyenne locale du lieu de naissance lui-même.',
  },
  {
    q: 'Que deviennent mes données de naissance ?',
    a: 'Le thème complet est calculé dans ton navigateur ; le calculateur ne fait appel à aucune API serveur et tu n’as pas besoin de compte. Si tu enregistres un thème, il reste d’abord sur cet appareil. La synchronisation facultative ne transfère tes thèmes enregistrés qu’après ta connexion.',
  },
  {
    q: 'Maisons en signes entiers ou Placidus : que choisir ?',
    a: 'Le système des maisons en signes entiers est le plus ancien et le plus simple à lire : chaque maison occupe un signe complet. Placidus est l’option moderne la plus courante et divise les maisons selon leur temps d’ascension, si bien que leur taille varie. Essaie les deux : tes planètes ne bougent pas ; seules les limites des maisons changent.',
  },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    name: 'Calculateur gratuit de thème astral',
    url: 'https://zodiacs.org/fr/birth-chart/',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: 'Soleil, Lune, ascendant, planètes de Mercure à Pluton, Nœud vrai, maisons en signes entiers et Placidus, aspects',
    inLanguage: 'fr',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
  {
    '@type': 'FAQPage',
    inLanguage: 'fr',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org en français', item: 'https://zodiacs.org/fr/' },
      { '@type': 'ListItem', position: 2, name: 'Outils', item: 'https://zodiacs.org/fr/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Calculateur de thème astral', item: 'https://zodiacs.org/fr/birth-chart/' },
    ],
  },
];
---
<Base
  clientUi
  glass
  title="Calcul de thème astral gratuit, avec ascendant | Zodiacs.org"
  description="Calcule gratuitement ton thème astral : Soleil, Lune, ascendant, planètes et maisons, avec leur signification. Tout reste dans ton navigateur."
  path="/fr/birth-chart/"
  locale="fr"
  image="/assets/og/v2/tool/birth-chart.png"
  imageAlt="Calculateur gratuit de thème astral — Zodiacs.org"
  jsonLd={jsonLd}
>
  <script slot="head" is:inline>
    try {
      var chartShareParams = new URLSearchParams(location.hash.slice(1));
      if (chartShareParams.has('p') || chartShareParams.has('c')) {
        document.documentElement.dataset.chartShareReceiver = '';
        document.addEventListener('DOMContentLoaded', function () {
          document.querySelectorAll('a[href="/astrofolio/"],a[href^="/registry/"],a[href^="/sdk/"]').forEach(function (element) {
            var footerWing = element.closest('.footer__col, .zfooter__group');
            (footerWing || element).remove();
          });
        }, { once: true });
      }
    } catch (error) {}
  </script>
  <style slot="head" is:inline>
    html[data-chart-share-receiver] a[href="/astrofolio/"],
    html[data-chart-share-receiver] a[href^="/registry/"],
    html[data-chart-share-receiver] a[href^="/sdk/"],
    html[data-chart-share-receiver] .calc__record,
    html[data-chart-share-receiver] [data-registry-aura-chart-link],
    html[data-chart-share-receiver] .footer__col:has(a[href^="/registry/"]),
    html[data-chart-share-receiver] .zfooter__group:has(a[href^="/registry/"]) { display: none !important; }
  </style>
  <section class="section--tight container">
    <div class="tool-hero">
      <h1 class="display">Obtiens ton thème astral gratuit.</h1>
      <p>Indique ta date, ton heure et ton lieu de naissance pour voir ton Soleil, ta Lune, ton ascendant, tes planètes, tes maisons et leur signification.</p>
    </div>
    <ChartCalculator mode="full" locale="fr" client:idle />
    <EmailCapture placement="chart" locale="fr" revealOnChart />
    <noscript>
      <p>Ce calculateur de thème astral nécessite JavaScript. Active JavaScript et recharge la page pour calculer ton Soleil, ta Lune, ton ascendant, tes planètes et tes maisons dans ton navigateur.</p>
    </noscript>
    <AskGuideLine lead="Des questions sur une position de ton thème ?" locale="fr" />
  </section>

  <section class="section--tight container container--narrow">
    <div class="prose">
      <h2>Ce que tu regardes</h2>
      <p>Un thème astral est une photographie du ciel prise depuis ton lieu de naissance, au moment où tu es né·e. Il montre les signes, les maisons et les planètes à des degrés précis.</p>
      <p>Commence par ton Soleil, ta Lune et ton ascendant : identité, vie émotionnelle et première impression. Tu peux ensuite enregistrer le thème et y revenir quand tu veux.</p>
      <p>Retrouve toute la méthodologie dans <a href="/fr/methodology/">notre méthode de calcul</a>.</p>
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <Faq items={faq} heading="Questions sur le thème astral" />
  </section>
</Base>

<style>
  .tool-hero { max-width: 62ch; margin-bottom: clamp(28px, 5vw, 44px); }
  .tool-hero h1 { margin: 0 0 16px; font-size: var(--text-2xl); line-height: 1.04; }
  .tool-hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }
</style>
