---
import Base from '../../layouts/Base.astro';
import LocalizedHome from '../../components/localized/LocalizedHome.astro';
import LocalizedHomeHead from '../../components/localized/LocalizedHomeHead.astro';
import { localizedHomeFaq, localizedHomeFaqSchema } from '../../components/localized/home-copy';

// The English homepage's two own questions, in French. The data answer is
// the birth chart page's, as published there.
const faq = localizedHomeFaq('fr', [
  {
    q: 'Que deviennent mes données de naissance ?',
    a: 'Le thème complet est calculé dans ton navigateur ; le calculateur ne fait appel à aucune API serveur et tu n’as pas besoin de compte. Si tu enregistres un thème, il reste d’abord sur cet appareil. La synchronisation facultative ne transfère tes thèmes enregistrés qu’après ta connexion.',
  },
  {
    q: 'Et si je ne connais pas mon heure de naissance ?',
    a: 'Choisis « Je ne la connais pas ». Le calculateur prend 12 h comme référence, laisse de côté l’ascendant et les maisons au lieu de les inventer, et indique le signe lunaire comme non vérifié tant que tu n’ajoutes pas d’heure, car la Lune peut changer de signe au cours d’une journée.',
  },
]);

const jsonLd = [
  localizedHomeFaqSchema(faq),
  {
    '@type': 'WebSite',
    '@id': 'https://zodiacs.org/#site',
    url: 'https://zodiacs.org/',
    name: 'Zodiacs.org',
    description: 'Thème astral gratuit, signe lunaire, ascendant, compatibilité, horoscopes et guides des douze signes. Tout est calculé dans ton navigateur.',
    publisher: { '@id': 'https://zodiacs.org/#org' },
    inLanguage: ['en', 'fr'],
  },
];
---
<Base
  clientUi
  title="Thème astral gratuit, signe lunaire, ascendant | Zodiacs.org"
  description="Thème astral gratuit, signe lunaire, ascendant, compatibilité, horoscopes et guides des douze signes. Tout est calculé dans ton navigateur."
  path="/fr/"
  locale="fr"
  jsonLd={jsonLd}
>
  <LocalizedHomeHead slot="head" locale="fr" />
  <LocalizedHome locale="fr" faq={faq} />
</Base>
