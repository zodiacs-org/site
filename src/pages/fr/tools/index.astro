---
import ReturnToolLinks from "../../../components/return-visits/ReturnToolLinks.astro";
import SharingToolLinks from '../../../components/sharing/SharingToolLinks.astro';
import Base from '../../../layouts/Base.astro';
import ToolIcon from '../../../components/ToolIcon.astro';
import ToolsHelpCard from '../../../components/tools/ToolsHelpCard.astro';
import ToolsLead from '../../../components/tools/ToolsLead.astro';
import ToolsPageHeading from '../../../components/ToolsPageHeading.astro';
import { ENGLISH_ONLY_COPY, localizePath, t } from '../../../lib/i18n';
import { toolIconForPath } from '../../../lib/tool-icons';
import '../../../styles/tools-hub.css';

const englishOnly = ENGLISH_ONLY_COPY.fr;
const tools = [
  { href: '/birth-chart/', title: 'Thème astral', promise: 'Ton Soleil, ta Lune, ton ascendant, tes planètes, tes maisons et leur signification.' },
  { href: '/birth-chart/someone-else/', title: 'Thème d’une autre personne (en anglais)', promise: 'Utilise ses données de naissance, ses trois signes principaux ou un lien Zodiacs, avec son accord.', englishOnly: true },
  { href: '/today/', title: 'Aujourd’hui (en anglais)', promise: 'Ton dernier thème enregistré face au ciel de midi, degrés compris.', englishOnly: true },
  { href: '/compatibility/', title: 'Compatibilité', promise: 'Compare deux thèmes : où ils s’accordent, où ils se heurtent, où ils grandissent.' },
  { href: '/moon-sign/', title: 'Signe lunaire', promise: 'Ta manière de ressentir et ce qui t’apaise.' },
  { href: '/rising-sign/', title: 'Ascendant', promise: 'Le signe que les autres rencontrent en premier.' },
  { href: '/moon-phase/', title: 'Phase de la Lune', promise: 'La Lune d’aujourd’hui et celle de toute date qui compte pour toi.' },
  { href: '/saturn-return/', title: 'Retour de Saturne', promise: 'Quand arrive le tien, à la date près, et ce qu’il demande en général.' },
  { href: '/transits/', title: 'Transits', promise: 'Le ciel d’aujourd’hui comparé à ton thème.' },
];
const [lead, ...rest] = tools;
const iconFor = (href: string) => toolIconForPath(href) ?? 'birth-chart';

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'Outils d’astrologie gratuits',
    url: 'https://zodiacs.org/fr/tools/',
    description: 'Des outils d’astrologie gratuits, calculés en toute confidentialité dans ton navigateur.',
    inLanguage: 'fr',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
];
---
<Base
  title="Outils d’astrologie gratuits | Zodiacs.org"
  description="Outils d’astrologie gratuits : thème astral, compatibilité, signe lunaire, ascendant, phase de la Lune, retour de Saturne et transits, dans ton navigateur."
  path="/fr/tools/"
  locale="fr"
  image="/assets/og/v2/tool/tools.png"
  imageAlt="Outils d’astrologie gratuits, Zodiacs.org"
  jsonLd={jsonLd}
>
  <header class="tools-hub tools-hub--solo kwrap">
    <div class="tools-hub__intro">
      <ToolsPageHeading>Outils d’astrologie gratuits</ToolsPageHeading>
      <p class="klede tools-hub__lede">Découvre ton thème astral, ton signe lunaire, ton ascendant, tes compatibilités et ce qui se passe dans le ciel maintenant. Tes données sont calculées dans ton navigateur.</p>
    </div>
    <ToolsLead
      href={localizePath('fr', lead.href)}
      title={lead.title}
      text={lead.promise}
      needs={[t('fr', 'birthDate'), t('fr', 'birthTime'), t('fr', 'birthplace')]}
      cta={t('fr', 'getBirthChart')}
      reassure={t('fr', 'privacyDevice')}
      locale="fr"
    />
  </header>

  <section class="tools-block kwrap">
    <ul class="tools-grid tools-list">
      {rest.map((tool) => (
        <li>
          <a class="tools-row" href={'englishOnly' in tool ? tool.href : localizePath('fr', tool.href)} hreflang={'englishOnly' in tool ? 'en' : undefined} title={'englishOnly' in tool ? englishOnly.aria : undefined} aria-label={'englishOnly' in tool ? `${tool.title}. ${englishOnly.aria}` : undefined}>
            <ToolIcon name={iconFor(tool.href)} size={52} />
            <div class="tool-card">
              <h2>{tool.title}</h2>
              <p>{tool.promise}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="tools-block kwrap">
    <h2 class="tools-section-title">Calendriers du ciel</h2>
    <ul class="tools-list">
      <li class="tools-row"><ToolIcon name="full-moon-calendar" size={52} /><span class="tools-row__text"><a href="/fr/full-moon-calendar/"><strong>Pleines lunes</strong></a> : dates, signes et noms jusqu’en 2027.</span></li>
      <li class="tools-row"><ToolIcon name="eclipses" size={52} /><span class="tools-row__text"><a href="/fr/eclipses/"><strong>Éclipses</strong></a> : solaires et lunaires jusqu’en 2028.</span></li>
      <li class="tools-row"><ToolIcon name="retrogrades" size={52} /><span class="tools-row__text"><a href="/fr/retrogrades/"><strong>Planètes rétrogrades</strong></a> : de Mercure à Pluton. <a href="/fr/mercury-retrograde/"><strong>Mercure rétrograde</strong></a> : chaque période, avec ses stations.</span></li>
    </ul>
  </section>

  <section class="tools-block kwrap">
    <h2 class="tools-section-title">Également disponible en anglais</h2>
    <ul class="tools-list">
      <li class="tools-row"><ToolIcon name="horoscopes" size={52} /><span class="tools-row__text"><strong>Horoscopes.</strong> Le ciel du jour, signe par signe. L’édition anglaise comprend aussi les lectures de la semaine et du mois : <a href="/horoscopes/" hreflang="en" title={englishOnly.aria}>choisir un signe</a>.</span></li>
    </ul>
  </section>

  <section class="tools-block kwrap"><SharingToolLinks locale="fr" icons /></section>
  <section class="tools-block kwrap"><ReturnToolLinks locale="fr" current="/saturn-return/" icons /></section>

  <section class="tools-help">
    <div class="kwrap"><div class="tools-help__grid tools-help__grid--one">
      <ToolsHelpCard icon="guide" art="tools-lens" title="Demande à Guide">
        <p>Guide peut aider avec un outil, un terme astrologique ou un thème que tu as enregistré ici.</p>
        <button class="btn btn--sm" type="button" data-assistant-open data-assistant-locale="fr" aria-haspopup="dialog">Commencer une conversation</button>
      </ToolsHelpCard>
    </div></div>
  </section>
</Base>
