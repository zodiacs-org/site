---
import Base from '../../../layouts/Base.astro';
import Faq from '../../../components/Faq.astro';
import MoonPhaseTool from '../../../islands/MoonPhaseTool';
import '../../../styles/calculator.css';

const faq = [
  {
    q: 'Dans quelle phase se trouve la Lune ce soir ?',
    a: 'L’indicateur en haut de cette page la calcule en direct sur ton appareil : il affiche le nom de la phase actuelle, son pourcentage d’illumination et le signe occupé par la Lune en ce moment, avec l’heure en temps universel.',
  },
  {
    q: 'Quelle était la phase de la Lune le jour de mon anniversaire ?',
    a: 'Indique ta date de naissance dans l’outil. Sans heure, le résultat décrit un instant de référence ; la phase peut changer au cours de cette date. Ajoute une heure et un lieu pour calculer la phase à ton instant local de naissance. L’astrologie interprète la phase natale comme une nuance du tempérament : on dit que les personnes nées à la nouvelle lune aiment lancer les choses, tandis que celles nées à la pleine lune vivent de façon plus visible.',
  },
  {
    q: 'À quelle fréquence y a-t-il une pleine lune ?',
    a: 'Tous les 29,5 jours en moyenne : cette période s’appelle le mois synodique. Son décalage avec le calendrier fait changer la date de la pleine lune chaque mois et produit parfois une deuxième pleine lune au cours d’un même mois civil : ce qu’on appelle une lune bleue.',
  },
  {
    q: 'La phase de la Lune influence-t-elle mon signe lunaire ?',
    a: 'Ce sont deux mesures différentes. La phase compare la Lune au Soleil ; le signe lunaire indique où se trouvait la Lune dans le zodiaque. Une pleine lune peut avoir lieu dans chacun des douze signes. C’est le signe lunaire que l’astrologie interprète comme une description du tempérament émotionnel.',
  },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    name: 'Phase de la Lune',
    url: 'https://zodiacs.org/fr/moon-phase/',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    inLanguage: 'fr',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
  {
    '@type': 'FAQPage',
    inLanguage: 'fr',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  clientUi
  title="Phase de la Lune aujourd’hui et à ta naissance | Zodiacs.org"
  description="Consulte la phase de la Lune du jour ou de toute autre date : phase, illumination et signe lunaire, gratuitement et sur ton appareil."
  path="/fr/moon-phase/"
  locale="fr"
  image="/assets/og/v2/tool/moon-phase.png"
  imageAlt="Phase de la Lune du jour et de toute autre date — Zodiacs.org"
  jsonLd={jsonLd}
>
  <section class="section--tight container">
    <div class="tool-hero">
      <h1 class="display">La Lune, aujourd’hui ou n’importe quel soir.</h1>
      <p>La phase de ce soir, calculée en direct. Plus bas, recherche la Lune sous laquelle tu es né·e ou celle de toute date importante.</p>
    </div>
    <MoonPhaseTool locale="fr" client:load />
    <noscript>
      <p>Ce calculateur de la phase de la Lune nécessite JavaScript. Active JavaScript et recharge la page pour voir la phase de ce soir ou consulter celle d’une autre date.</p>
    </noscript>
  </section>

  <section class="section--tight container container--narrow">
    <Faq items={faq} heading="Questions sur les phases de la Lune" />
  </section>
</Base>

<style>
  .tool-hero { max-width: 62ch; margin-bottom: clamp(28px, 5vw, 44px); }
  .tool-hero h1 { margin: 0 0 16px; font-size: var(--text-2xl); line-height: 1.04; }
  .tool-hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }
</style>
