---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { currentHoroscopeMonth, utcMonth } from '../../lib/horoscope-month.mjs';
import daily from '../../data/daily.json';

export async function getStaticPaths() {
  const learn = await getCollection('learn', ({ data }) => !data.draft);
  const horoscopes = await getCollection('horoscopes', ({ data }) => !data.draft);
  const latestMonth = currentHoroscopeMonth(horoscopes.map((h) => h.data.month), utcMonth(daily.date));
  const currentHoroscopes = horoscopes.filter((h) => h.data.month === latestMonth);

  const staticSlugs = [
    ['learn'],
    ['learn', 'planets'],
    ['learn', 'houses'],
    ['learn', 'aspects'],
    ['learn', 'placements'],
    ['horoscopes'],
  ];

  const dynamicSlugs = [
    // Compatibility pairs are translated: src/pages/fr/compatibility/[pair]/index.astro.
    // Rising-sign profiles are translated: src/pages/fr/rising-sign/[sign].astro.
    ...learn.filter((l) => l.data.kind !== 'rising').map((l) => ['learn', ...l.id.split('/')]),
    ...currentHoroscopes.map((h) => ['horoscopes', h.data.sign]),
  ];

  return [...staticSlugs, ...dynamicSlugs].map((slug) => ({ params: { slug: slug.join('/') } }));
}

const slug = Astro.params.slug ?? '';
const englishPath = `/${slug}/`;
---
<Base
  title="Contenu en anglais — Zodiacs.org"
  description="Cette page n’est pas encore traduite en français. Tu peux lire sa version complète en anglais."
  path={`/fr/${slug}/`}
  locale="fr"
  noindex
>
  <section class="section container container--narrow fallback-es">
    <em class="kicker">Disponible en anglais</em>
    <h1 class="display">Cette page n’est pas encore traduite.</h1>
    <p>
      La version complète reste disponible en anglais pendant que nous
      traduisons le reste du site.
    </p>
    <a class="btn btn--primary" href={englishPath} hreflang="en"><span>Lire en anglais</span><span class="orb">→</span></a>
  </section>
</Base>

<style>
  .fallback-es { display: grid; gap: 18px; justify-items: start; }
  .fallback-es h1 { margin: 4px 0 0; font-size: var(--text-2xl); line-height: 1.04; }
  .fallback-es p { margin: 0; max-width: 52ch; color: var(--muted); font-size: var(--text-lg); line-height: 1.6; }
</style>
