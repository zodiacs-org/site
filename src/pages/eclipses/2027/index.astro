---
import Base from '../../../layouts/Base.astro';
import '../../../styles/rx-table.css';
import eclipseData from '../../../data/eclipses.json';
import { signBySlug } from '../../../lib/signs';
import { formatDate, formatTime } from '../../../lib/i18n/dates';
import { publishedEventById } from '../../../lib/events/site-publication';
import { isInvisiblePenumbral, lunarTotalityMinutes, penumbralMagnitude } from '../../../lib/nasa-lunar-eclipses';
import { worldTimesSentence } from '../../../world-times/world-times';
import { nasaEclipseAt } from '../../../lib/nasa-event-times-2027';
import { ECLIPSES_2027_UPDATED as UPDATED, updatedIso, updatedLabel } from '../../../world-times/updated';
import WorldTimesTable from '../../../world-times/WorldTimesTable.astro';

// The 2027 eclipses, from the same committed data the hub renders — receipts,
// no client ephemeris. A year page so a search for the year lands on the
// year, with a calendar file beside it.
const YEAR = 2027;
const buildNow = new Date();

const sources = [
  { label: 'NASA Eclipse Catalog', href: 'https://eclipse.gsfc.nasa.gov/eclipse.html' },
  { label: 'Astronomy Engine', href: 'https://github.com/cosinekitty/astronomy' },
  { label: 'IANA Time Zone Database', href: 'https://www.iana.org/time-zones' },
];

interface EclipseEntry {
  type: 'solar' | 'lunar';
  kind: string;
  peak: string;
  sign: string;
  obscuration?: number;
  totalMinutes?: number;
}

const eclipses = (eclipseData.eclipses as EclipseEntry[])
  .filter((e) => e.peak.startsWith(`${YEAR}-`))
  .map((e) => {
    // The peak printed is solved on NASA JPL Horizons (src/lib/nasa-event-times-2027.ts), as on the
    // eclipse's own page; the id, the sign and the detail keep the committed data.
    const at = new Date(nasaEclipseAt(e.type, e.peak) ?? e.peak);
    const publicationId = `eclipse-${e.peak.slice(0, 10)}`;
    const pct = typeof e.obscuration === 'number' ? Math.round(e.obscuration * 100) : null;
    let detail = '';
    if (e.type === 'solar') {
      detail = e.kind === 'total'
        ? 'totality, the Sun fully covered along the track'
        : e.kind === 'annular'
          ? `ring eclipse, ${pct}% of the Sun covered at maximum`
          : 'partial only';
    } else {
      detail = e.kind === 'total'
        ? `totality lasts about ${lunarTotalityMinutes(e.peak, e.totalMinutes)} minutes`
        : e.kind === 'partial'
          ? `${pct}% of the Moon in shadow at maximum`
          : isInvisiblePenumbral(e.peak, e.kind)
          ? 'penumbral, so slight that no eye or camera will see it'
          : 'penumbral, a subtle shading, easy to miss';
    }
    return {
      ...e,
      anchorId: `${publicationId}-${e.type}`,
      at,
      sign: signBySlug(e.sign),
      detail,
      label: `${e.kind === 'annular' ? 'Annular' : e.kind[0].toUpperCase() + e.kind.slice(1)} ${e.type}`,
      past: at < buildNow,
      path: publishedEventById.get(publicationId)?.path ?? null,
    };
  });

if (eclipses.length === 0) throw new Error(`No ${YEAR} eclipses in eclipses.json`);

const solar = eclipses.filter((e) => e.type === 'solar');
const lunar = eclipses.filter((e) => e.type === 'lunar');
const total = eclipses.filter((e) => e.kind === 'total');
const unseen = lunar.filter((e) => isInvisiblePenumbral(e.peak, e.kind));

const fmtDay = (d: Date) =>
  formatDate('en', d, { weekday: 'short', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const fmtTime = (d: Date) =>
  formatTime('en', d, { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'UTC' });
const fmtMonthDay = (d: Date) => formatDate('en', d, { month: 'long', day: 'numeric', timeZone: 'UTC' });

const listJoin = (items: string[]) => items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}`;
const numberWord = (n: number) => ['no', 'one', 'two', 'three', 'four', 'five'][n] ?? String(n);
const fmtMonth = (d: Date) => formatDate('en', d, { month: 'long', timeZone: 'UTC' });
const kindLabel = (e: { kind: string; type: string }) => `${e.kind === 'annular' ? 'annular' : e.kind} ${e.type}`;

// Eclipse seasons: eclipses less than 40 days apart belong to one season.
const seasons: (typeof eclipses)[] = [];
for (const e of eclipses) {
  const current = seasons.at(-1);
  if (current && e.at.getTime() - current[current.length - 1].at.getTime() < 40 * 86_400_000) current.push(e);
  else seasons.push([e]);
}
const seasonLine = (season: typeof eclipses) => {
  const [a, z] = [season[0].at, season[season.length - 1].at];
  const months = fmtMonth(a) === fmtMonth(z) ? fmtMonth(a) : `${fmtMonth(a)} to ${fmtMonth(z)}`;
  return `${months} (${listJoin(season.map((e) => `the ${kindLabel(e)} eclipse of ${fmtMonthDay(e.at)}`))})`;
};

// The first eclipse, and the first total eclipse, after this year.
const later = (eclipseData.eclipses as EclipseEntry[]).filter((e) => Number(e.peak.slice(0, 4)) > YEAR);
const nextAny = later[0];
const nextTotal = later.find((e) => e.kind === 'total');
if (!nextAny || !nextTotal) throw new Error(`No eclipse after ${YEAR} in eclipses.json`);
const sentenceFor = (e: EclipseEntry) => `the ${kindLabel(e)} eclipse of ${fmtMonthDay(new Date(e.peak))}, ${e.peak.slice(0, 4)}, in ${signBySlug(e.sign).name}`;
const totalSolar = eclipses.find((e) => e.type === 'solar' && e.kind === 'total');

const description = `Every solar and lunar eclipse of 2027 with the exact peak in UTC, New York, London, Kolkata and Sydney, the eclipse type, the zodiac sign it falls in, and a calendar file.`;

const faq = [
  {
    q: `How many eclipses are there in ${YEAR}?`,
    a: `${eclipses.length}: ${solar.length} solar and ${lunar.length} lunar.${total.length ? ` ${total.map((e) => `The ${e.label.toLowerCase()} eclipse on ${fmtMonthDay(e.at)} in ${e.sign.name}`).join('; ')} ${total.length === 1 ? 'is' : 'are'} the ${total.length === 1 ? 'one' : ''} total eclipse${total.length === 1 ? '' : 's'} of the year.` : ''}`,
  },
  {
    q: 'Which sign does an eclipse belong to?',
    a: 'The sign holding the Sun at a solar eclipse, or the Moon at a lunar one, at the instant of the peak. Eclipses come two or three to a season, about two weeks apart in opposite signs, so each season marks an axis of your chart rather than one house.',
  },
  {
    q: 'Can I see these from where I live?',
    a: `A lunar eclipse is visible from the whole night side of Earth at its peak time; a solar eclipse only along a narrow track, so most people see a partial or nothing. The linked eclipse pages describe the track for each one.${unseen.map((e) => ` The penumbral eclipse on ${fmtMonthDay(e.at)} is the exception: NASA gives it a penumbral magnitude of ${penumbralMagnitude(e.peak)}, so slight that no eye or camera will see it.`).join('')}`,
  },
  {
    q: 'What time is each eclipse where I live?',
    a: `The peak is one instant for the whole planet; only the clock reading changes.${totalSolar ? ` The total solar eclipse peaks at ${worldTimesSentence(totalSolar.at)}.` : ''} The local times table gives every ${YEAR} peak on those five clocks, daylight saving included. Whether you see an eclipse at that minute depends on where you stand, not on your clock.`,
  },
  {
    q: `When are the eclipse seasons in ${YEAR}?`,
    a: `${seasons.length === 1 ? 'Once' : seasons.length === 2 ? 'Twice' : `${numberWord(seasons.length).replace(/^./u, (c) => c.toUpperCase())} times`}: ${listJoin(seasons.map(seasonLine))}. A season is the stretch of a few weeks when the Sun is near one of the Moon's nodes, so a new or full Moon falls close enough to the node to eclipse; the eclipses inside one season arrive about two weeks apart.`,
  },
  {
    q: `When is the next eclipse after ${YEAR}?`,
    a: `The first of ${nextAny.peak.slice(0, 4)} is ${sentenceFor(nextAny)}, peaking at ${worldTimesSentence(new Date(nextAny.peak))}.${nextTotal === nextAny ? '' : ` The next total eclipse is ${sentenceFor(nextTotal)}.`}`,
  },
];

const jsonLd = [
  {
    '@type': 'WebPage',
    name: `Eclipses ${YEAR}`,
    url: `https://zodiacs.org/eclipses/${YEAR}/`,
    description,
    dateModified: updatedIso(UPDATED),
    isPartOf: { '@type': 'WebPage', url: 'https://zodiacs.org/eclipses/' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title="Eclipses 2027: Every Solar and Lunar Eclipse, Exact | Zodiacs.org"
  description="Every solar and lunar eclipse of 2027 with the exact peak in UTC, New York, London, Kolkata and Sydney, the eclipse type, the zodiac sign it falls in, and a calendar file."
  path={`/eclipses/${YEAR}/`}
  image="/assets/og/v2/tool/eclipses.png"
  imageAlt="Eclipses 2027, Zodiacs.org"
  jsonLd={jsonLd}
  sources={sources}
>
  <section class="section--tight container container--narrow">
    <div class="tool-hero reveal">
      <a class="crumb" href="/eclipses/"><span class="crumb__arrow" aria-hidden="true">←</span>Eclipses</a>
      <h1 class="display">The eclipses of {YEAR}.</h1>
      <p>
        {solar.length} solar and {lunar.length} lunar, each at its exact peak in universal time, with the{' '}
        <a href="/learn/glossary/#zodiac-sign">sign</a> it lands in. Eclipse seasons arrive about twice a year, and each holds
        two or three eclipses about two weeks apart.
      </p>
      <p class="year-page__updated">Updated <time datetime={UPDATED}>{updatedLabel(UPDATED)}</time></p>
    </div>

    <div class="rx-now shell tinted reveal" style="--sign:var(--sign-leo)">
      <div class="core tinted rx-now__core">
        <span class="mono--label">Calendar file</span>
        <strong class="rx-now__line">
          <a href={`/eclipses/${YEAR}.ics`}>Add the {YEAR} eclipses to your calendar</a>
        </strong>
        <span class="rx-now__all mono">
          Peak instants in universal time · every year from 2026 on <a href="/eclipses/">the eclipse page</a>
        </span>
      </div>
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <div class="section-head reveal">
      <h2>The eclipses, {YEAR}</h2>
      <p>Peak times in universal time. Solar eclipses are visible along a limited track; lunar eclipses from the whole night side of Earth.</p>
    </div>
    <div class="table-wrap reveal">
      <table class="rx-table">
        <thead>
          <tr><th>Peak</th><th>UTC</th><th>Eclipse</th><th>In</th><th>Detail</th></tr>
        </thead>
        <tbody>
          {eclipses.map((e) => (
            <tr id={e.anchorId} class={e.past ? 'rx-table__past' : ''}>
              <td data-label="Peak">
                {e.path ? <a href={e.path}>{fmtDay(e.at)}</a> : fmtDay(e.at)}
              </td>
              <td class="mono" data-label="UTC">{fmtTime(e.at)}</td>
              <td data-label="Eclipse">{e.label}</td>
              <td data-label="In" style={`color:${e.sign.hue}`}>{e.sign.name}</td>
              <td data-label="Detail">{e.detail}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section--tight container container--narrow" id="local-times">
    <div class="section-head reveal">
      <h2>Eclipse peaks in five time zones</h2>
      <p>The same peaks on five clocks. Where the date differs from the UTC date, the table shows it.</p>
    </div>
    <div class="reveal">
      <WorldTimesTable
        rows={eclipses.map((e) => ({ label: `${e.label} eclipse in ${e.sign.name}`, at: e.at, past: e.past }))}
        eventLabel="Eclipse"
        caption={`The ${YEAR} eclipse peaks in UTC, New York, London, Kolkata and Sydney`}
      />
    </div>
    <p class="year-page__check reveal">
      Peak times are solved on NASA JPL Horizons (the DE441 ephemeris) and printed to the minute. The signs are
      calculated with Astronomy Engine, and the eclipses are checked against NASA's
      <em>Five Millennium Canon</em> of eclipses by Fred Espenak and Jean Meeus.
      <a href="/methodology/#event-times">How we check event times</a>
    </p>
  </section>

  <section class="section--tight container container--narrow">
    <div class="section-head reveal"><h2>Questions</h2></div>
    <div class="prose reveal">
      {faq.map(({ q, a }) => (
        <details class="faq-item">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
    <p class="year-page__links reveal">
      <a href="/eclipses/">All years</a> · <a href={`/full-moon-calendar/${YEAR}/`}>Full moons {YEAR}</a> ·
      <a href={`/mercury-retrograde/${YEAR}/`}>Mercury retrograde {YEAR}</a> · <a href="/birth-chart/">Your birth chart</a>
    </p>
  </section>
</Base>

<style>
  .tool-hero .kicker { display: block; margin-bottom: 10px; }
  .year-page__updated { margin: 10px 0 0; color: var(--muted); font-size: var(--text-sm); }
  .year-page__check { margin: 14px 0 0; max-width: 64ch; color: var(--muted); font-size: var(--text-sm); }
  .year-page__check a { color: var(--text-2); }
  .year-page__links { margin-top: 18px; color: var(--muted); font-size: var(--text-sm); }
  .year-page__links a { color: var(--text-2); }
  .faq-item { border-top: 1px solid var(--hair-1); }
  .faq-item summary { min-height: 44px; padding: 12px 0; cursor: pointer; color: var(--text); }
  .faq-item p { margin: 0 0 14px; color: var(--muted); }
</style>
