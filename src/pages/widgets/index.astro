---
import Base from '../../layouts/Base.astro';
import {
  iframeEmbedCode,
  WIDGET_DIMENSIONS,
} from '../../lib/widgets';
import { WIDGET_EN } from '../../strings/widgets';

const publicOrigin = Astro.site?.origin ?? 'https://zodiacs.org';
const defaultAccent = '#E0B080';
const defaultCode = iframeEmbedCode({
  origin: publicOrigin,
  kind: 'moon',
  theme: 'dark',
  accent: defaultAccent,
  title: WIDGET_EN.moonTitle,
});
const defaultPreview = `/embed/moon/?theme=dark&accent=${encodeURIComponent(defaultAccent)}`;

const jsonLd = [{
  '@type': 'WebPage',
  name: WIDGET_EN.pageMetaTitle,
  url: `${publicOrigin}/widgets/`,
  description: WIDGET_EN.pageMetaDescription,
}];
---
<Base
  title={WIDGET_EN.pageMetaTitle}
  description={WIDGET_EN.pageMetaDescription}
  path="/widgets/"
  jsonLd={jsonLd}
>
  <section class="section container container--narrow">
    <h1 class="display wdg-title">{WIDGET_EN.pageTitle}</h1>
    <div class="prose wdg-intro">
      <p>{WIDGET_EN.pageIntro}</p>
      <p>
        Building something of your own instead? The computed sky behind these
        widgets is also published as{' '}
        <a href="/developers/">machine-readable JSON</a>.
      </p>
    </div>

    <section
      class="wdg-generator"
      aria-labelledby="widget-generator-title"
      data-widget-generator
      data-origin={publicOrigin}
      data-title-moon={WIDGET_EN.moonTitle}
      data-title-sky={WIDGET_EN.skyTitle}
      data-title-chart={WIDGET_EN.chartTitle}
      data-copy-label={WIDGET_EN.copyAction}
      data-copied-label={WIDGET_EN.copiedAction}
    >
      <div class="wdg-controls">
        <h2 id="widget-generator-title">{WIDGET_EN.generatorTitle}</h2>
        <div class="wdg-fields">
          <label class="field wdg-choice">
            <span class="field__label">{WIDGET_EN.widgetLabel}</span>
            <select class="field__input" data-widget-kind>
              <option value="moon">{WIDGET_EN.moonOption}</option>
              <option value="sky">{WIDGET_EN.skyOption}</option>
              <option value="chart">{WIDGET_EN.chartOption}</option>
            </select>
          </label>
          <label class="field wdg-choice">
            <span class="field__label">{WIDGET_EN.modeLabel}</span>
            <select class="field__input" data-widget-mode>
              <option value="iframe">{WIDGET_EN.iframeOption}</option>
              <option value="script">{WIDGET_EN.scriptOption}</option>
            </select>
          </label>
          <label class="field">
            <span class="field__label">{WIDGET_EN.themeLabel}</span>
            <select class="field__input" data-widget-theme>
              <option value="dark">{WIDGET_EN.darkOption}</option>
              <option value="light">{WIDGET_EN.lightOption}</option>
            </select>
          </label>
          <label class="field wdg-accent">
            <span class="field__label">{WIDGET_EN.accentLabel}</span>
            <input class="field__input" type="color" value={defaultAccent} data-widget-accent />
          </label>
        </div>
        <p class="wdg-note mono">{WIDGET_EN.backlinkNote}</p>
        <p class="wdg-note mono">{WIDGET_EN.privacyNote}</p>
        <p class="wdg-note mono">{WIDGET_EN.sizeNote}</p>
      </div>

      <div class="wdg-output">
        <h2>{WIDGET_EN.previewTitle}</h2>
        <div class="wdg-preview">
          <iframe
            src={defaultPreview}
            title={WIDGET_EN.moonTitle}
            width={WIDGET_DIMENSIONS.moon.width}
            height={WIDGET_DIMENSIONS.moon.height}
            loading="lazy"
            sandbox="allow-scripts allow-forms allow-same-origin allow-popups allow-popups-to-escape-sandbox"
            referrerpolicy="strict-origin-when-cross-origin"
            data-widget-preview
          ></iframe>
        </div>
        <label class="field" for="widget-code">
          <span class="field__label">{WIDGET_EN.codeLabel}</span>
        </label>
        <textarea id="widget-code" class="field__input wdg-code" readonly rows="7" data-widget-code>{defaultCode}</textarea>
        <button class="btn btn--ghost wdg-copy" type="button" data-widget-copy>{WIDGET_EN.copyAction}</button>
      </div>
    </section>
  </section>

  <script>
    import {
      iframeEmbedCode,
      isWidgetKind,
      isWidgetMode,
      isWidgetTheme,
      scriptEmbedCode,
      WIDGET_DIMENSIONS,
      widgetEmbedUrl,
    } from '../../lib/widgets';
    import { trackAnalytics } from '../../lib/analytics';

    const root = document.querySelector<HTMLElement>('[data-widget-generator]');
    if (root) {
      const kindControl = root.querySelector<HTMLSelectElement>('[data-widget-kind]');
      const modeControl = root.querySelector<HTMLSelectElement>('[data-widget-mode]');
      const themeControl = root.querySelector<HTMLSelectElement>('[data-widget-theme]');
      const accentControl = root.querySelector<HTMLInputElement>('[data-widget-accent]');
      const preview = root.querySelector<HTMLIFrameElement>('[data-widget-preview]');
      const code = root.querySelector<HTMLTextAreaElement>('[data-widget-code]');
      const copy = root.querySelector<HTMLButtonElement>('[data-widget-copy]');
      const publicOrigin = root.dataset.origin ?? 'https://zodiacs.org';

      const update = () => {
        const kind = kindControl?.value ?? '';
        const mode = modeControl?.value ?? '';
        const theme = themeControl?.value ?? '';
        if (!isWidgetKind(kind) || !isWidgetMode(mode) || !isWidgetTheme(theme)) return;
        const accent = accentControl?.value ?? null;
        const title = root.dataset[`title${kind.charAt(0).toUpperCase()}${kind.slice(1)}`] ?? kind;
        const options = { origin: publicOrigin, kind, theme, accent, title };
        if (code) code.value = mode === 'iframe' ? iframeEmbedCode(options) : scriptEmbedCode(options);
        if (preview) {
          // A settings change is explicit preview intent. A lazy iframe can
          // retain its previous document after rapid destination changes.
          preview.loading = 'eager';
          const destination = widgetEmbedUrl(window.location.origin, kind, theme, accent);
          if (preview.src !== destination) preview.src = destination;
          preview.title = title;
          preview.width = String(WIDGET_DIMENSIONS[kind].width);
          preview.height = String(WIDGET_DIMENSIONS[kind].height);
        }
      };

      [kindControl, modeControl, themeControl, accentControl].forEach((control) => {
        control?.addEventListener('input', update);
        control?.addEventListener('change', update);
      });

      copy?.addEventListener('click', async () => {
        const kind = kindControl?.value ?? '';
        const mode = modeControl?.value ?? '';
        if (!code || !isWidgetKind(kind) || !isWidgetMode(mode)) return;
        try {
          await navigator.clipboard.writeText(code.value);
        } catch {
          code.select();
          document.execCommand('copy');
        }
        trackAnalytics('widget_embed_copied', { widget: kind, mode });
        copy.textContent = root.dataset.copiedLabel ?? '';
        window.setTimeout(() => { copy.textContent = root.dataset.copyLabel ?? ''; }, 1600);
      });
    }
  </script>
</Base>

<style>
  .wdg-title { margin: var(--s-1) 0 var(--s-4); }
  .wdg-intro { max-width: 68ch; }
  .wdg-generator { display: grid; gap: var(--s-8); margin-top: var(--s-8); }
  .wdg-generator h2 { margin: 0 0 var(--s-4); font-size: var(--text-lg); }
  .wdg-controls, .wdg-output { min-width: 0; }
  .wdg-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4); }
  /* The calculator field recipe, scoped to this builder so documentation
     does not need the calculator's result and wheel stylesheet. */
  .wdg-generator .field { display: flex; flex-direction: column; gap: var(--s-2); min-width: 0; }
  .wdg-generator .field__label { font-size: var(--text-sm); font-weight: 500; color: var(--text-2); }
  .wdg-generator .field__input {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    min-height: 46px;
    padding: 10px 14px;
    border: 1px solid var(--hair-2);
    border-radius: var(--r-md);
    background: var(--void-1);
    color: var(--text);
    font-size: 16px;
    color-scheme: dark;
  }
  .wdg-generator .field__input:hover { border-color: var(--hair-3); }
  .wdg-generator .field__input:focus { border-color: color-mix(in oklab, var(--accent) 60%, transparent); }
  .wdg-generator .field__input:focus-visible {
    outline: 2px solid color-mix(in oklab, var(--accent) 75%, white);
    outline-offset: 2px;
  }
  .wdg-fields .field { margin: 0; }
  .wdg-fields .wdg-choice { grid-column: 1 / -1; }
  .wdg-generator .wdg-accent input { height: 46px; padding: 5px; cursor: pointer; }
  .wdg-note { max-width: 62ch; margin: var(--s-3) 0 0; color: var(--muted); font-size: 11px; line-height: 1.65; letter-spacing: .025em; }
  .wdg-output { display: grid; gap: var(--s-3); }
  .wdg-output h2 { margin-bottom: 0; }
  .wdg-preview { min-height: 276px; display: grid; place-items: center; overflow: auto; padding: var(--s-3); border: 1px solid var(--hair-2); border-radius: var(--r-md); background: var(--void-1); }
  .wdg-preview iframe { display: block; max-width: 100%; border: 0; border-radius: var(--r-md); overflow: hidden; }
  .wdg-generator .wdg-code { min-height: 138px; resize: vertical; font-family: var(--font-mono); font-size: 12px; line-height: 1.55; }
  .wdg-copy { justify-self: start; }
  @media (min-width: 900px) {
    .wdg-generator { grid-template-columns: minmax(250px, .72fr) minmax(0, 1.28fr); align-items: start; gap: var(--s-12); }
    .wdg-controls { position: sticky; top: 94px; }
  }
  @media (max-width: 560px) {
    .wdg-fields { grid-template-columns: 1fr; }
    .wdg-preview { justify-content: start; }
    .wdg-generator .wdg-code { font-size: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wdg-preview iframe { transition: none; }
  }
</style>
