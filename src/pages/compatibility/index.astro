---
import SharingToolLinks from '../../components/sharing/SharingToolLinks.astro';
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import RaceRamp from '../../components/RaceRamp.astro';
import SignIcon from '../../components/SignIcon.astro';
import AstroTerm from '../../components/AstroTerm.astro';
import SynastryCalculator from '../../islands/SynastryCalculator';
import { SIGNS } from '../../lib/signs';
import { pairSlug } from '../../lib/compat';
import '../../styles/calculator.css';

const faq = [
  {
    q: 'How does astrological compatibility work?',
    a: 'Astrologers compare two birth charts by measuring the angles between one person’s planets and the other’s — a practice called synastry. Trines and sextiles between charts read as ease; squares and oppositions read as productive friction. Sun-sign compatibility is the one-line summary of a much longer comparison.',
  },
  {
    q: 'Is sun-sign compatibility real?',
    a: 'It is the simplest useful layer. Two people are more than their sun signs — the Moon, Venus, and Mars often matter more in practice. The sun-sign pairing pages here are honest starting points, and the calculator compares two birth charts when you have birth details.',
  },
  {
    q: 'Do I need exact birth times for a compatibility reading?',
    a: 'Times help but are not required. Without one, the calculator uses local noon as a reference and omits the rising sign, angles, and houses. Most planetary signs are stable across a day, but the Moon moves about 13 degrees and its position and nearby aspects remain approximate.',
  },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    name: 'Compatibility calculator',
    url: 'https://zodiacs.org/compatibility/',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description:
      'See where a relationship flows, where it catches, and what each person brings out in the other with a private birth-chart comparison.',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
const inviteUiEnabled = import.meta.env.PUBLIC_COMPAT_INVITES_ENABLED === '1';
---
<Base privateSurface
  clientUi
  title="Compatibility Calculator — Compare Two Birth Charts | Zodiacs.org"
  description="Free astrology compatibility calculator: compare two birth charts privately in your browser, with clear readings and guides to all 78 sign pairings."
  path="/compatibility/"
  image="/assets/og/v2/tool/compatibility.png"
  imageAlt="Compatibility calculator — Zodiacs.org"
  jsonLd={jsonLd}
  glass
>
  <section class="section--tight container container--narrow" id="calculator">
    <div class="compat-hero">
      <em class="kicker">Two charts, honestly compared</em>
      <h1 class="display">Check your astrology compatibility.</h1>
      <p>
        Compare two <AstroTerm term="birth-chart" label="birth charts" surface="compatibility" />{' '}to explore where a relationship flows and where it catches.
      </p>
    </div>

    <SynastryCalculator client:load />
    <noscript>
      <p>This compatibility calculator needs JavaScript. Enable it and reload to compare two birth charts in your browser.</p>
      {inviteUiEnabled && <p>Invitation links open here too, and need JavaScript for the same reason.</p>}
    </noscript>
  </section>

  <section class="section container">
    <div class="section-head">
      <h2>Start with sun signs</h2>
      <p>
        If you do not have two birth charts yet, these shorter{' '}
        <a href="/learn/glossary/#sun-sign">Sun-sign guides</a> are a useful first look at
        the dynamic between two signs.
      </p>
    </div>

    <details class="compat-library">
      <summary>
        <span>
          <strong>Browse all 78 sun-sign pairings</strong>
          <small>Plain-language guides, without a score</small>
        </span>
        <span class="compat-library__toggle" aria-hidden="true">+</span>
      </summary>
      <div class="compat-index">
        {SIGNS.map((a, index) => (
          <div class="compat-row" style={`--sign:${a.hue}`}>
            <a class="compat-row__sign" href={`/${a.slug}/`}>
              <SignIcon sign={a.slug} size={34} class="compat-row__icon" />
              <span>{a.name}</span>
            </a>
            <div class="compat-row__pairs">
              {SIGNS.slice(index).map((b) => (
                <a class="compat-row__pair" href={`/compatibility/${pairSlug(a.slug, b.slug)}/`}>
                  {b.name}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </details>
  </section>

  <section class="section--tight container container--narrow">
    <Faq items={faq} heading="Compatibility questions" />
    <RaceRamp gap="28px" />
  </section>
<section class="section--tight container"><SharingToolLinks locale="en" /></section>
</Base>

<style>
  .compat-hero { max-width: 58ch; margin-bottom: clamp(26px, 5vw, 42px); }
  .compat-hero h1 {
    margin: 14px 0 14px;
    font-size: var(--text-2xl);
    line-height: 1.04;
  }
  .compat-hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }

  .compat-library { overflow: hidden; border: 1px solid var(--hair-2); border-radius: var(--r-md); background: var(--void-1); }
  .compat-library > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 18px 20px;
    list-style: none;
    cursor: pointer;
  }
  .compat-library > summary::-webkit-details-marker { display: none; }
  .compat-library > summary:focus-visible { outline: 2px solid var(--ink-0); outline-offset: -4px; }
  .compat-library > summary > span:first-child { display: grid; gap: 3px; }
  .compat-library > summary strong { color: var(--text); font-size: var(--text-base); }
  .compat-library > summary small { color: var(--muted); font-size: 12px; }
  .compat-library__toggle { color: var(--muted); font-size: 22px; line-height: 1; transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1); }
  .compat-library[open] .compat-library__toggle { transform: rotate(45deg); }

  .compat-index { display: grid; padding: 0 20px 18px; border-top: 1px solid var(--hair-1); }
  .compat-row {
    display: grid;
    gap: 10px 26px;
    padding: 16px 0;
    border-bottom: 1px solid var(--hair-1);
    grid-template-columns: 1fr;
  }
  .compat-row:first-child { border-top: 1px solid var(--hair-1); }
  @media (min-width: 760px) {
    .compat-row { grid-template-columns: 170px minmax(0, 1fr); align-items: center; }
  }
  .compat-row__sign {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    font-size: var(--text-md, 15px);
  }
  .compat-row__sign :global(img) { border-radius: 50%; }
  .compat-row__pairs { display: flex; flex-wrap: wrap; gap: 4px 2px; }
  .compat-row__pair {
    padding: 4px 9px;
    border-radius: var(--r-full);
    font-size: 12.5px;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }
  .compat-row__pair:hover {
    color: var(--text);
    background: color-mix(in oklab, var(--sign) 12%, transparent);
  }
  @media (prefers-reduced-motion: reduce) { .compat-library__toggle { transition: none; } }
</style>
