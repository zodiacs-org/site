---
import SynastryDiscovery from '../../../components/learn/SynastryDiscovery.astro';
import PairComparisonSymbol from '../../../components/PairComparisonSymbol.astro';
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SignIcon from '../../../components/SignIcon.astro';
import ArtFrame from '../../../components/ArtFrame.astro';
import AskGuideLine from '../../../components/AskGuideLine.astro';
import PairProse from '../../../components/compat/PairProse.astro';
import SynastryCalculator from '../../../islands/SynastryCalculator';
import { SIGNS, ELEMENT_LABEL, MODALITY_LABEL, type Sign } from '../../../lib/signs';
import { signDateRange } from '../../../lib/sign-display';
import { pairSlug } from '../../../lib/compat';
import { pairPattern, rulerName, SIGN_ART_DETAIL, SIGN_FIGURE } from '../../../lib/compat-reading';
import { SIGN_ART_AVIF_MEDIA, signArtAvifSrcset, signArtSrc, signArtSrcset, SIGN_ART_SIZE } from '../../../lib/sign-art';
import { elementMedallionSrc, elementMedallionSrcset } from '../../../lib/art';
import '../../../styles/calculator.css';
import '../../../styles/pair-page.css';
import { EDITOR_AUTHOR } from '../../../lib/editorial';

export async function getStaticPaths() {
  const pairs = await getCollection('pairs', ({ data }) => !data.draft);
  if (pairs.length !== 78) {
    throw new Error(`Pairs collection must hold exactly 78 pages; found ${pairs.length}.`);
  }
  for (const entry of pairs) {
    const expected = pairSlug(entry.data.signs[0], entry.data.signs[1]);
    if (entry.id !== expected) {
      throw new Error(`Pair file ${entry.id}.mdx declares signs [${entry.data.signs.join(', ')}] — expected filename ${expected}.mdx`);
    }
  }
  return pairs.map((entry) => ({ params: { pair: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const pattern = pairPattern(entry.data.signs[0], entry.data.signs[1]);
const { facts } = pattern;
const { a, b, same } = facts;
const { Content, headings } = await render(entry);

const sections = headings.filter((heading) => heading.depth === 2);
const words = (entry.body ?? '').replace(/^---[\s\S]*?---/, '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));

const planetRoles = new Map(
  (await getCollection('learn', ({ data }) => data.kind === 'planet'))
    .map((planet) => [planet.data.kind === 'planet' ? planet.data.planet : '', planet.data.kind === 'planet' ? planet.data.role : '']),
);
const rulerSentence = (sign: Sign) => {
  const role = planetRoles.get(sign.ruler);
  if (!role) throw new Error(`No learn page role for ${sign.ruler}.`);
  const name = rulerName(sign.ruler);
  return `${name.charAt(0).toUpperCase()}${name.slice(1)} is ${role.charAt(0).toLowerCase()}${role.slice(1)}`;
};
const rulersNote = same || a.ruler === b.ruler ? rulerSentence(a) : `${rulerSentence(a)} ${rulerSentence(b)}`;


const people = same ? [a] : [a, b];
const otherPairs = (sign: Sign) => SIGNS.map((other) => {
  const slug = pairSlug(sign.slug, other.slug);
  return { other, slug, now: slug === facts.slug };
});
const elementWord = (sign: Sign) => ELEMENT_LABEL[sign.element];
const signFacts = (sign: Sign) => `${signDateRange(sign)} · ${ELEMENT_LABEL[sign.element]} · ${MODALITY_LABEL[sign.modality]} · ${sign.ruler}`;
const detail = (sign: Sign) => SIGN_ART_DETAIL[sign.slug];

const jsonLd = [
  {
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    url: `https://zodiacs.org/compatibility/${facts.slug}/`,
    datePublished: entry.data.published.toISOString(),
    dateModified: entry.data.updated.toISOString(),
    author: EDITOR_AUTHOR,
    publisher: { '@id': 'https://zodiacs.org/#org' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://zodiacs.org/compatibility/${facts.slug}/` },
    inLanguage: 'en',
    image: `https://zodiacs.org/assets/og/v2/pair/${facts.slug}.png`,
    about: [
      { '@type': 'Thing', name: `${a.name} (astrology)` },
      { '@type': 'Thing', name: `${b.name} (astrology)` },
    ],
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Compatibility', item: 'https://zodiacs.org/compatibility/' },
      { '@type': 'ListItem', position: 3, name: `${a.name} and ${b.name}`, item: `https://zodiacs.org/compatibility/${facts.slug}/` },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: entry.data.faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  clientUi
  inlineCriticalCss
  title={entry.data.title}
  description={entry.data.description}
  path={`/compatibility/${facts.slug}/`}
  image={`/assets/og/v2/pair/${facts.slug}.png`}
  imageAlt={`${a.name} and ${b.name} compatibility, Zodiacs.org`}
  type="article"
  jsonLd={jsonLd}
>
  <link slot="head" rel="preload" href="/fonts/eb-garamond-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />
  <article class="ph" style={`--a:${a.hue};--b:${b.hue}`}>
    <header class="ph-hero">
      <div class="ph-hero__art">
        <ArtFrame
          sign={a.slug}
          flip
          eager
          avif
          class="ph-pane ph-pane--a"
          sizes="(max-width: 760px) 128vw, 66vw"
        />
        {/* The second painting waits behind the first, the page's largest element. */}
        <ArtFrame
          sign={b.slug}
          eager
          fetchPriority="low"
          avif
          alt={same ? '' : undefined}
          class="ph-pane ph-pane--b"
          sizes="(max-width: 760px) 128vw, 66vw"
        />
      </div>
      {/* The discs and the Change pair minis wait behind the first painting too: on a slow link Chrome raises on-screen images to high priority at the first layout unless they ask for low. */}
      <div class="ph-hero__pair" aria-hidden="true">
        {people.map((sign) => <SignIcon sign={sign.slug} size={84} loading="eager" fetchPriority="low" class="ph-hero__disc" />)}
      </div>
      <div class="ph-hero__body">
        <span class="kicker"><a href="/compatibility/">Compatibility</a>, {pattern.elementPhrase}</span>
        <h1 class="h-hero">{a.name} <em>and</em> {b.name}</h1>
        <p class="ph-hero__cap">{entry.data.description}</p>
        <div class="btn-row">
          <a class="btn btn--primary btn--lg" href="#compare"><span>Compare your birth charts</span><span class="orb" aria-hidden="true">↗</span></a>
          <a class="btn btn--glass btn--lg ph-change" href="#switch">
            <span class="ph-change__minis" aria-hidden="true">
              {people.map((sign) => <SignIcon sign={sign.slug} size={22} loading="eager" fetchPriority="low" />)}
            </span>
            <span>Change pair</span>
            <svg class="ph-change__swap" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h15M15 4l4 4-4 4M20 16H5M9 12l-4 4 4 4" /></svg>
          </a>
        </div>
        <p class="reassure">Free · No scores or verdicts · Private in your browser</p>
      </div>
      <span class="ph-hero__label ph-hero__label--l">{a.name}, {SIGN_FIGURE[a.slug]} · {signDateRange(a)}</span>
      {!same && <span class="ph-hero__label ph-hero__label--r">{b.name}, {SIGN_FIGURE[b.slug]} · {signDateRange(b)}</span>}
    </header>

    <div class="kwrap ph-pattern">
      <div class:list={['ph-ticker', same && 'ph-ticker--one']} role="group" aria-label="The pattern behind this pairing">
        <span class="ph-ticker__label">The pattern</span>
        {people.map((sign) => (
          <span class="ph-ticker__item ph-ticker__item--sign"><SignIcon sign={sign.slug} size={18} /><b>{sign.name}</b><span>{signDateRange(sign)}</span></span>
        ))}
        <span class="ph-ticker__item">{pattern.element}</span>
        <span class="ph-ticker__item">{pattern.modality}</span>
        <span class="ph-ticker__item ph-ticker__item--wide">{pattern.rulers}</span>
        <span class="ph-ticker__item ph-ticker__item--wide">{pattern.polarity}</span>
        <a class="textlink" href="#basis">Why it reads this way <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>


    <section class="ksection ph-readsec" id="read" aria-label={`The full ${a.name} and ${b.name} read`}>
      <div class="kwrap ph-read">
        <aside class="ph-toc" aria-label="In this read">
          <span class="kicker">In this read</span>
          <ol>
            {sections.map((heading, index) => (
              <li><a href={`#${heading.slug}`}><i>{index + 1}</i>{heading.text}</a></li>
            ))}
            <li><a href="#basis"><i>{sections.length + 1}</i>Why it reads this way</a></li>
          </ol>
          <div class="ph-toc__pair" aria-hidden="true">
            {people.map((sign) => <SignIcon sign={sign.slug} size={36} />)}
          </div>
          <p class="ph-toc__by">Published by Zodiacs.org<br />About {minutes} {minutes === 1 ? 'minute' : 'minutes'} to read<br /><a href="/methodology/">Editorial standards</a></p>
        </aside>

        <div class="ph-feature">
          <PairProse id={entry.id}>
            <Content />
            {entry.id === 'gemini-gemini' && <SynastryDiscovery />}
            <div slot="rooms" class="ph-rooms">
              {[a, b].map((sign, index) => {
                const point = detail(sign);
                return (
                  <figure>
                    <div class="ph-rooms__art" style={`--spot:${index === 0 ? '60% 46%' : '40% 46%'}`}>
                      <div class:list={['ph-rooms__flip', index === 0 && 'ph-rooms__flip--x']}>
                        {/* The hero's AVIF copies too, so these can reuse its download. */}
                        <picture>
                          <source type="image/avif" media={SIGN_ART_AVIF_MEDIA} srcset={signArtAvifSrcset(sign.slug)} sizes="(max-width: 760px) 90vw, 680px" />
                          <img
                            src={signArtSrc(sign.slug, 1200)}
                            srcset={signArtSrcset(sign.slug)}
                            sizes="(max-width: 760px) 90vw, 680px"
                            width={SIGN_ART_SIZE.width}
                            height={SIGN_ART_SIZE.height}
                            alt=""
                            loading="lazy"
                            decoding="async"
                            style={`--z:${point.zoom};--o:${point.x}% ${point.y}%`}
                          />
                        </picture>
                      </div>
                    </div>
                    <figcaption><b><SignIcon sign={sign.slug} size={20} />{sign.name}</b>{SIGN_FIGURE[sign.slug]}</figcaption>
                  </figure>
                );
              })}
            </div>
          </PairProse>

          <section class="ph-basis" id="basis" aria-labelledby="basis-title">
            <h2 class="h-3" id="basis-title">Why it reads this way</h2>
            <p class="ph-basis__sub">The Sun sign basics behind this page.</p>
            <div class:list={['ph-basis__signs', same && 'ph-basis__signs--one']}>
              {people.map((sign) => (
                <a href={`/${sign.slug}/`}>
                  <SignIcon sign={sign.slug} size={40} />
                  <span><b>{sign.name}</b><small>{signFacts(sign)}</small></span>
                </a>
              ))}
            </div>
            <dl>
              <div><dt>Element</dt><dd class="ph-basis__v">{pattern.elementPair}<span class="ph-el" aria-hidden="true">{people.map((sign) => <img src={elementMedallionSrc(sign.element)} srcset={elementMedallionSrcset(sign.element)} sizes="64px" width="128" height="128" alt="" loading="lazy" decoding="async" />)}</span></dd><dd class="ph-basis__m">{pattern.elementNote}</dd></div>
              <div><dt>Mode</dt><dd class="ph-basis__v">{pattern.modalityPair}</dd><dd class="ph-basis__m">{pattern.modalityNote}</dd></div>
              <div><dt>Polarity</dt><dd class="ph-basis__v">{pattern.polarity}</dd><dd class="ph-basis__m">{pattern.polarityNote}</dd></div>
              <div><dt>{same || a.ruler === b.ruler ? 'Ruler' : 'Rulers'}</dt><dd class="ph-basis__v">{pattern.rulers}</dd><dd class="ph-basis__m">{rulersNote}</dd></div>
            </dl>
            <p class="ph-basis__note">Sun signs describe a starting pattern, not a verdict. The rest of both birth charts shapes how it is lived.</p>
          </section>
        </div>
      </div>
    </section>

    <div class="kwrap"><hr class="ph-rule" /></div>

    <section class="ksection ph-comparesec" id="compare" aria-labelledby="compare-title">
      <div class="kwrap ph-compare">
        <div class="ph-compare__intro">
          <span class="kicker">Beyond Sun signs</span>
          <h2 class="h-2" id="compare-title">Compare your two birth charts.</h2>
          <p class="klede">This page reads one placement in each chart, the Sun. With birth details for both of you, the calculator reads the rest and shows where your two charts meet.</p>
          <div class="ph-adds">
            <h3>What a full comparison adds</h3>
            <div><span class="ph-adds__gl" aria-hidden="true"><PairComparisonSymbol symbol="moon" /></span><div><b>Moon and Moon</b><span>How each of you settles, and what feels like home.</span></div></div>
            <div><span class="ph-adds__gl ph-adds__gl--two" aria-hidden="true"><PairComparisonSymbol symbol="venus-mars" /></span><div><b>Venus and Mars</b><span>How affection is shown, and what draws each of you in.</span></div></div>
            <div><span class="ph-adds__gl ph-adds__gl--mono" aria-hidden="true">ASC</span><div><b>Rising signs</b><span>First impressions and everyday approach. Needs birth times.</span></div></div>
            <div><span class="ph-adds__gl" aria-hidden="true"><PairComparisonSymbol symbol="conjunction" /></span><div><b>Links between the charts</b><span>Where your planets meet, support each other, or rub.</span></div></div>
          </div>
        </div>
        <!-- Keep the display: contents layout outside the visibility observer. -->
        <div class="calc"><SynastryCalculator unwrapped client:visible /></div>
        <noscript>
          <p class="ph-compare__noscript">This compatibility calculator needs JavaScript. Enable it and reload to compare two birth charts in your browser.</p>
        </noscript>
        <p class="ph-compare__after">Don’t know their birth details? <a class="textlink" href="/compatibility/invite/">Send them an invite <span class="arr" aria-hidden="true">→</span></a></p>
      </div>
    </section>

    <section class="ksection ph-questions" aria-labelledby="questions-title">
      <div class="kwrap qa">
        <div>
          <h2 class="h-2" id="questions-title">Questions about this pairing</h2>
          <AskGuideLine lead="Still curious?" />
        </div>
        <div class="kfaq">
          {entry.data.faq.map(({ q, a: answer }, index) => (
            <details open={index === 0}>
              <summary>{q}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="ksection ph-switch" id="switch" aria-labelledby="switch-title">
      <div class="kwrap">
        <div class="section-head section-head--row ph-switch__head">
          <div>
            <h2 class="h-2" id="switch-title">Switch the pair</h2>
            <p>{same
              ? `Pick any two signs, or see ${a.name} with someone else.`
              : `Pick any two signs, or see ${a.name} and ${b.name} with someone else. ${b.name} and ${a.name} is this same page.`}</p>
          </div>
          <div class="ph-picker" role="group" aria-label="Pick two signs">
            {[a, b].map((sign, side) => {
              const keep = side === 0 ? b : a;
              return (
                <>
                  {side === 1 && <span class="ph-picker__and">and</span>}
                  <details class="ph-sel">
                    <summary aria-label={`${side === 0 ? 'First' : 'Second'} sign: ${sign.name}. Choose another`}>
                      <SignIcon sign={sign.slug} size={28} /><span>{sign.name}</span>
                      <svg viewBox="0 0 8 5" fill="none" aria-hidden="true"><path d="M1 1l3 3 3-3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" /></svg>
                    </summary>
                    <ul class="ph-sel__menu" role="list">
                      {SIGNS.map((option) => {
                        const slug = pairSlug(option.slug, keep.slug);
                        return (
                          <li>
                            <a href={`/compatibility/${slug}/`} aria-current={slug === facts.slug ? 'page' : undefined}>
                              <SignIcon sign={option.slug} size={24} /><span>{option.name}</span>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </details>
                </>
              );
            })}
          </div>
        </div>

        {people.map((sign) => (
          <div class="ph-others">
            <div class="ph-others__head">
              <h3><SignIcon sign={sign.slug} size={26} />{sign.name} with</h3>
              <a class="textlink only-desktop" href={`/${sign.slug}/`}>{sign.name} sign guide <span class="arr" aria-hidden="true">→</span></a>
            </div>
            <ul class="ph-pairs" role="list" aria-label={`${sign.name} with each sign`}>
              {otherPairs(sign).map(({ other, slug, now }) => (
                <li>
                  <a href={`/compatibility/${slug}/`} class:list={[now && 'is-now']} aria-current={now ? 'page' : undefined} style={`--now:${(now && !same ? (sign.slug === a.slug ? b : a) : sign).hue}`}>
                    <SignIcon sign={other.slug} size={38} />
                    <b>{other.name}</b>
                    <small>{now ? 'This page' : elementWord(other)}</small>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </article>
</Base>

<script>
  // The two sign menus are plain links in <details>; this only closes an
  // open menu when the other opens, on Escape, or on a click elsewhere.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('.ph-sel')];
  for (const menu of menus) {
    menu.addEventListener('toggle', () => {
      if (menu.open) for (const other of menus) if (other !== menu) other.open = false;
    });
  }
  document.addEventListener('click', (event) => {
    for (const menu of menus) if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const menu of menus) {
      if (!menu.open) continue;
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
