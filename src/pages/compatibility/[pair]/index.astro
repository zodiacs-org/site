---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import SignIcon from '../../../components/SignIcon.astro';
import SynastryCalculator from '../../../islands/SynastryCalculator';
import { SIGNS, ELEMENT_LABEL, MODALITY_LABEL } from '../../../lib/signs';
import { signDateRange } from '../../../lib/sign-display';
import { pairFacts, pairSlug } from '../../../lib/compat';
import '../../../styles/calculator.css';
import { EDITOR_AUTHOR } from '../../../lib/editorial';
import { programmaticText } from '../../../strings/programmatic';

export async function getStaticPaths() {
  const pairs = await getCollection('pairs', ({ data }) => !data.draft);
  if (pairs.length !== 78) {
    throw new Error(`Pairs collection must hold exactly 78 pages; found ${pairs.length}.`);
  }
  for (const entry of pairs) {
    const expected = pairSlug(entry.data.signs[0], entry.data.signs[1]);
    if (entry.id !== expected) {
      throw new Error(`Pair file ${entry.id}.mdx declares signs [${entry.data.signs.join(', ')}] — expected filename ${expected}.mdx`);
    }
  }
  return pairs.map((entry) => ({ params: { pair: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const facts = pairFacts(entry.data.signs[0], entry.data.signs[1]);
const { a, b, same } = facts;
const { Content } = await render(entry);

const othersFor = (slug: string) =>
  SIGNS.filter((s) => pairSlug(slug, s.slug) !== facts.slug);

const jsonLd = [
  {
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    url: `https://zodiacs.org/compatibility/${facts.slug}/`,
    datePublished: entry.data.published.toISOString(),
    dateModified: entry.data.updated.toISOString(),
    author: EDITOR_AUTHOR,
    publisher: { '@id': 'https://zodiacs.org/#org' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://zodiacs.org/compatibility/${facts.slug}/` },
    inLanguage: 'en',
    image: `https://zodiacs.org/assets/og/v2/pair/${facts.slug}.png`,
    about: [
      { '@type': 'Thing', name: `${a.name} (astrology)` },
      { '@type': 'Thing', name: `${b.name} (astrology)` },
    ],
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Compatibility', item: 'https://zodiacs.org/compatibility/' },
      { '@type': 'ListItem', position: 3, name: `${a.name} and ${b.name}`, item: `https://zodiacs.org/compatibility/${facts.slug}/` },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: entry.data.faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  clientUi
  title={entry.data.title}
  description={entry.data.description}
  path={`/compatibility/${facts.slug}/`}
  image={`/assets/og/v2/pair/${facts.slug}.png`}
  imageAlt={`${a.name} and ${b.name} compatibility, Zodiacs.org`}
  type="article"
  jsonLd={jsonLd}
>
  <article>
    <header class="pair-hero container container--narrow">
      <a class="crumb" href="/compatibility/"><span class="crumb__arrow" aria-hidden="true">←</span>Compatibility</a>
      <div class="pair-hero__lockup reveal">
        <span class="pair-hero__icons">
          <SignIcon sign={a.slug} size={104} loading="eager" class="pair-hero__icon" />
          {!same && <SignIcon sign={b.slug} size={104} loading="eager" class="pair-hero__icon pair-hero__icon--b" />}
        </span>
        <h1 class="display">{a.name} <span class="pair-hero__amp">and</span> {same ? a.name : b.name}</h1>
      </div>
      <p class="pair-hero__lede">{entry.data.description}</p>
    </header>

    <div class="container container--narrow pair-body">
      <div class="prose reveal">
        <Content />
      </div>

      <details class="pair-basis reveal">
        <summary>
          <span>
            <strong>Why this pairing reads this way</strong>
            <small>Elements, modes, polarity, and each sign’s basic pattern</small>
          </span>
          <span class="pair-basis__mark" aria-hidden="true"></span>
        </summary>
        <section class="pair-panel" aria-label="The astrology behind this pairing">
          <div class="pair-panel__signs">
            {[a, b].map((s, i) => (
              <a class="pair-panel__sign tile" href={`/${s.slug}/`} style={`--sign:${s.hue}`}>
                <SignIcon sign={s.slug} size={44} class="pair-panel__sign-icon" />
                <span class="pair-panel__sign-name">{s.name}{same ? ` ${i === 0 ? 'A' : 'B'}` : ''}</span>
                <span class="pair-panel__sign-meta mono">{signDateRange(s)}</span>
                <span class="pair-panel__sign-meta mono">
                  {ELEMENT_LABEL[s.element]} · {MODALITY_LABEL[s.modality]} · {s.ruler}
                </span>
              </a>
            ))}
          </div>
          <dl class="pair-panel__rows">
            <div class="pair-panel__row">
              <dt><span class="mono--label">Elements</span> {facts.element.label}</dt>
              <dd>{facts.element.note}</dd>
            </div>
            <div class="pair-panel__row">
              <dt><span class="mono--label">Modes</span> {facts.modality.label}</dt>
              <dd>{facts.modality.note}</dd>
            </div>
            <div class="pair-panel__row">
              <dt><span class="mono--label">Polarity</span></dt>
              <dd>{facts.polarity}</dd>
            </div>
          </dl>
        </section>
      </details>

      <section class="pair-faq reveal">
        <div class="section-head">
          <h2>Questions about this pairing</h2>
        </div>
        <div class="pair-faq__list">
          {entry.data.faq.map(({ q, a }) => (
            <details class="pair-faq__item">
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="pair-tool reveal">
        <div class="section-head">
          <h2>Compare your actual charts</h2>
          <p>
            Sun signs are the summary. If you have birth details for both
            people, the calculator reads every cross-chart aspect between them.
          </p>
        </div>
        <p>
          <a class="btn btn--glass" href={`/compatibility/?sign1=${a.slug}&sign2=${b.slug}#calculator`}>
            <span>{programmaticText('compatibilityPrefillCta', { a: a.name, b: b.name })}</span><span class="orb">→</span>
          </a>
        </p>
        <SynastryCalculator client:visible />
        <noscript>
          <p>This compatibility calculator needs JavaScript. Enable it and reload to compare two birth charts in your browser.</p>
        </noscript>
      </section>

      <nav class="pair-more reveal" aria-label="More pairings">
        <div class="pair-more__col">
          <span class="pair-more__head">{a.name} with the others</span>
          <div class="pair-more__chips">
            {othersFor(a.slug).map((s) => (
              <a class="pair-more__chip" href={`/compatibility/${pairSlug(a.slug, s.slug)}/`}>{s.name}</a>
            ))}
          </div>
        </div>
        {!same && (
          <div class="pair-more__col">
            <span class="pair-more__head">{b.name} with the others</span>
            <div class="pair-more__chips">
              {othersFor(b.slug).map((s) => (
                <a class="pair-more__chip" href={`/compatibility/${pairSlug(b.slug, s.slug)}/`}>{s.name}</a>
              ))}
            </div>
          </div>
        )}
      </nav>
    </div>
  </article>
</Base>

<style>
  .pair-hero { padding-block: clamp(24px, 5vw, 56px) clamp(18px, 3vw, 30px); }
  .pair-hero__lockup {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 14px;
  }
  @media (min-width: 700px) {
    .pair-hero__lockup { flex-direction: row; align-items: center; gap: 30px; }
  }
  .pair-hero__icons { display: inline-flex; }
  .pair-hero :global(.pair-hero__icon) {
    width: clamp(72px, 10vw, 104px);
    border-radius: 50%;
  }
  .pair-hero :global(.pair-hero__icon--b) { margin-left: -18px; }
  .pair-hero h1 {
    margin: 0;
    font-size: clamp(2.1rem, 1.4rem + 3.4vw, 3.6rem);
    line-height: 1.02;
  }
  .pair-hero__amp {
    font-style: italic;
    color: var(--muted);
  }
  .pair-hero__lede {
    margin: 18px 0 0;
    max-width: 60ch;
    color: var(--muted);
    font-size: var(--text-lg);
    text-wrap: pretty;
  }

  .pair-body { display: grid; gap: clamp(30px, 5vw, 52px); padding-bottom: clamp(36px, 6vw, 72px); }

  .pair-basis {
    padding: 3px 18px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: var(--void-1);
  }
  .pair-basis > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 13px 0;
    cursor: pointer;
    list-style: none;
  }
  .pair-basis > summary::-webkit-details-marker { display: none; }
  .pair-basis > summary > span:first-child { display: grid; gap: 2px; }
  .pair-basis > summary strong { color: var(--text); font-size: var(--text-sm); }
  .pair-basis > summary small { color: var(--faint); font-size: var(--text-xs); }
  .pair-basis__mark::before { content: '+'; color: var(--muted); font-family: var(--font-mono); }
  .pair-basis[open] .pair-basis__mark::before { content: '−'; }

  .pair-panel { display: grid; gap: 18px; padding: 2px 0 15px; }
  .pair-panel__signs {
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) { .pair-panel__signs { grid-template-columns: 1fr 1fr; } }
  .pair-panel__sign {
    display: grid;
    justify-items: start;
    gap: 6px;
    padding: 18px;
    text-decoration: none;
    color: var(--text);
  }
  @media (min-width: 560px) {
    .pair-panel__sign {
      grid-template-columns: auto 1fr;
      column-gap: 16px;
      align-content: center;
      align-items: start;
    }
    .pair-panel__sign :global(.pair-panel__sign-icon) { grid-row: 1 / span 3; align-self: center; }
  }
  .pair-panel__sign :global(img) { border-radius: 50%; }
  .pair-panel__sign-name { font-weight: 620; font-size: var(--text-lg); letter-spacing: -0.01em; }
  .pair-panel__sign-meta { font-size: 10.5px; letter-spacing: 0.07em; color: var(--faint); }

  .pair-panel__rows { margin: 0; display: grid; }
  .pair-panel__row {
    display: grid;
    gap: 4px 26px;
    padding: 14px 0;
    border-bottom: 1px solid var(--hair-1);
  }
  .pair-panel__row:first-child { border-top: 1px solid var(--hair-1); }
  @media (min-width: 700px) {
    .pair-panel__row { grid-template-columns: 220px minmax(0, 1fr); }
  }
  .pair-panel__row dt {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--text);
  }
  .pair-panel__row dd { margin: 0; font-size: var(--text-sm); color: var(--text-2); line-height: 1.65; max-width: 58ch; }

  .pair-tool :global(.section-head) { margin-bottom: 22px; }

  .pair-faq__list { display: grid; gap: 8px; }
  .pair-faq__item {
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: var(--void-1);
    padding: 4px 18px;
  }
  .pair-faq__item summary { cursor: pointer; padding: 12px 0; font-weight: 550; color: var(--text); }
  .pair-faq__item p { margin: 2px 0 16px; color: var(--text-2); font-size: var(--text-sm); line-height: 1.65; }

  .pair-more {
    display: grid;
    gap: 24px;
    padding-top: clamp(20px, 4vw, 32px);
    border-top: 1px solid var(--hair-1);
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) { .pair-more { grid-template-columns: 1fr 1fr; } }
  .pair-more__col { display: grid; gap: 10px; align-content: start; }
  .pair-more__head { font-weight: 600; font-size: var(--text-sm); color: var(--text); }
  .pair-more__chips { display: flex; flex-wrap: wrap; gap: 4px 2px; }
  .pair-more__chip {
    padding: 4px 9px;
    border-radius: var(--r-full);
    font-size: 12.5px;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }
  .pair-more__chip:hover { color: var(--text); background: color-mix(in oklab, var(--ink-2) 12%, transparent); }
</style>
