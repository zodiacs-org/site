---
import Base from '../../../layouts/Base.astro';
import SignIcon from '../../../components/SignIcon.astro';
import WalletChart from '../../../islands/WalletChart';
import { SIGNS } from '../../../lib/signs';
import {
  configuredWalletChains,
  type WalletEnvironment,
} from '../../../lib/wallet/config';
import { WALLET_CHART_EN, walletText } from '../../../strings/wallet-chart';
import { SCHEMA_EN } from '../../../strings/seo.en.mjs';
import '../../../styles/wallet-chart.css';

const buildEnvironment: WalletEnvironment = {
  ...process.env,
  PUBLIC_WALLET_CHART_ENABLED:
    import.meta.env.PUBLIC_WALLET_CHART_ENABLED ?? process.env.PUBLIC_WALLET_CHART_ENABLED,
};
const availableChains = configuredWalletChains(buildEnvironment);

if (availableChains.length === 0) {
  return Astro.redirect('/404.html');
}

const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SCHEMA_EN.breadcrumbHome, item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: walletText('breadcrumbRegistry'), item: 'https://zodiacs.org/registry/' },
      { '@type': 'ListItem', position: 3, name: walletText('breadcrumbPage'), item: 'https://zodiacs.org/registry/wallet-chart/' },
    ],
  },
  {
    '@type': 'WebApplication',
    name: walletText('breadcrumbPage'),
    url: 'https://zodiacs.org/registry/wallet-chart/',
    description: WALLET_CHART_EN.metaDescription,
    applicationCategory: walletText('applicationCategory'),
    operatingSystem: SCHEMA_EN.operatingSystem,
    offers: { '@type': 'Offer', price: SCHEMA_EN.freePrice, priceCurrency: SCHEMA_EN.currency },
  },
];
---
<Base
  clientUi
  title={WALLET_CHART_EN.metaTitle}
  description={WALLET_CHART_EN.metaDescription}
  path="/registry/wallet-chart/"
  jsonLd={jsonLd}
>
  <section class="section container container--narrow wallet-page">
    <header class="wallet-page__hero">
      <div class="wallet-page__icons" aria-hidden="true">
        {SIGNS.map((sign) => <SignIcon sign={sign.slug} size={32} />)}
      </div>
      <em class="kicker">{walletText('kicker')}</em>
      <h1 class="display">{walletText('title')}</h1>
      <p class="wallet-page__intro">{walletText('intro')}</p>
      <p class="wallet-page__boundary">{walletText('boundary')}</p>
    </header>

    <WalletChart client:load availableChains={availableChains} />
    <noscript><p class="wallet-page__noscript">{walletText('noJavaScript')}</p></noscript>

    <aside class="wallet-page__disclosures" aria-labelledby="wallet-privacy-title">
      <div>
        <h2 id="wallet-privacy-title">{walletText('privacyTitle')}</h2>
        <p>{walletText('privacyBody')}</p>
      </div>
      <ul>
        <li>{walletText('readOnlyDisclosure')}</li>
        <li>{walletText('entertainmentDisclosure')}</li>
        <li>{walletText('financialDisclosure')}</li>
      </ul>
    </aside>

    <a class="btn btn--ghost wallet-page__back" href="/registry/">{walletText('registryBack')}</a>
  </section>
</Base>

<style>
  .wallet-page { max-width: 900px; }
  .wallet-page__hero { padding-top: clamp(18px, 4vw, 44px); }
  .wallet-page__icons { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 28px; }
  .wallet-page__hero h1 { max-width: 13ch; margin: 8px 0 18px; font-size: var(--text-2xl); }
  .wallet-page__intro { max-width: 62ch; margin: 0; color: var(--text-2); font-family: var(--font-serif); font-size: var(--text-lg); line-height: 1.55; }
  .wallet-page__boundary { max-width: 66ch; margin: 16px 0 0; color: var(--muted); line-height: 1.65; }
  .wallet-page__noscript { margin-top: 20px; padding: 16px; border: 1px solid #E0B080; border-radius: var(--r-md); color: #E0B080; }
  .wallet-page__disclosures { display: grid; gap: 22px; margin-top: clamp(56px, 9vw, 96px); padding: clamp(22px, 4vw, 34px); border: 1px solid var(--hair-2); border-radius: var(--r-lg); }
  .wallet-page__disclosures h2 { margin: 0 0 8px; font-family: var(--font-serif); font-size: var(--text-xl); font-weight: 500; }
  .wallet-page__disclosures p { margin: 0; color: var(--muted); line-height: 1.65; }
  .wallet-page__disclosures ul { display: grid; gap: 8px; margin: 0; padding-left: 20px; color: var(--text-2); }
  .wallet-page__back { margin-top: 24px; }
  @media (max-width: 660px) {
    .wallet-page__icons :global(picture:nth-child(n+7)) { display: none; }
  }
</style>
