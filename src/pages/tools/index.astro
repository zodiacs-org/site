---
import Base from '../../layouts/Base.astro';
import ArtFrame from '../../components/ArtFrame.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import ToolsHelpCard from '../../components/tools/ToolsHelpCard.astro';
import ToolsLead from '../../components/tools/ToolsLead.astro';
import { TOOLS_HUB, type ToolGroup } from '../../lib/nav-tools';
import { HERO_CROP_SIZE, heroCropSrc, heroCropSrcset, type HeroCropName } from '../../lib/hero-crops';
import '../../styles/tools-hub.css';

// The birth chart leads on its own; every other tool sits in one of four
// groups named for the question a visitor arrives with. Membership, order,
// names, one-line descriptions and icons all come from the shared catalogue.
const lead = TOOLS_HUB.find((tool) => tool.group === 'lead');
if (!lead) throw new Error('The tools hub needs a lead tool.');

interface Chapter {
  id: string;
  group: Exclude<ToolGroup, 'lead'>;
  title: string;
  /** What the group holds, for the contents list. */
  summary: string;
  /** One line under the chapter title. */
  copy: string;
  art: HeroCropName;
  focus: string;
}

const chapters = ([
  { id: 'about-you', group: 'you', title: 'About you', summary: 'Moon, rising, big three, numbers', copy: 'Your own chart, one piece at a time.', art: 'sun-moon', focus: '50% 30%' },
  { id: 'together', group: 'together', title: 'You and someone else', summary: 'Compatibility, group charts', copy: 'Partners, friends, family, and people who share your sky.', art: 'twins', focus: '45% 50%' },
  { id: 'sky-now', group: 'sky', title: 'The sky now', summary: 'Today, moon phase, horoscopes', copy: 'What the Sun, Moon and planets are doing today.', art: 'crescent', focus: '40% 45%' },
  { id: 'the-year', group: 'year', title: 'Through the year', summary: 'Returns, eclipses, retrogrades', copy: 'Your returns, and the sky’s calendar of moons, eclipses and retrogrades.', art: 'clock-dial', focus: '50% 50%' },
] satisfies Chapter[]).map((chapter) => ({ ...chapter, tools: TOOLS_HUB.filter((tool) => tool.group === chapter.group) }));

const UNITS = ['', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen', 'seventeen', 'eighteen', 'nineteen'];
const TENS = ['', '', 'twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy', 'eighty', 'ninety'];
function inWords(n: number): string {
  if (n < 20) return UNITS[n];
  if (n < 100) return TENS[Math.floor(n / 10)] + (n % 10 ? `-${UNITS[n % 10]}` : '');
  return String(n);
}
const toolCount = TOOLS_HUB.length;
const countWords = inWords(toolCount);
const countTitle = countWords.charAt(0).toUpperCase() + countWords.slice(1);

const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: 'Free astrology tools',
    url: 'https://zodiacs.org/tools/',
    description: 'Free birth charts, compatibility, moon and rising signs, transits, returns, and sky calendars, no signup required.',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: toolCount,
      itemListElement: TOOLS_HUB.map((tool, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: tool.title,
        url: `https://zodiacs.org${tool.href}`,
      })),
    },
  },
];
---
<Base
  title="Free Astrology Tools & Calculators | Zodiacs.org"
  description="Free astrology tools, no signup: birth chart, compatibility, moon sign, rising sign, transits, returns, eclipses, and more."
  path="/tools/"
  image="/assets/og/v2/tool/tools.png"
  imageAlt="Free astrology tools, Zodiacs.org"
  jsonLd={jsonLd}
>
  <header class="tools-hub kwrap">
    <div class="tools-hub__intro">
      <nav class="tools-crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Tools</span></nav>
      <span class="kicker">Free, no signup</span>
      <h1 class="tools-hub__title">Free astrology tools</h1>
      <p class="klede tools-hub__lede">{countTitle} tools, sorted by what you want to know. New here? Start with your birth chart.</p>
    </div>

    <ToolsLead
      href={lead.href}
      title="Your birth chart"
      text={`${lead.promise} Most of the tools below build on it.`}
      needsLabel="You need"
      needs={['Birth date', 'Birth time, if known', 'Birth place']}
      cta="Get your free birth chart"
      reassure="About twenty seconds · Private in your browser"
      tag="Start here"
    />

    <nav class="tools-toc" aria-label="Tool groups">
      <p class="tools-toc__label">Or go straight to what you want to know</p>
      <ul class="tools-toc__list">
        {chapters.map((chapter) => (
          <li>
            <a class="tools-toc__row" href={`#${chapter.id}`}>
              <span class="tools-stack">
                {chapter.tools.slice(0, 3).map((tool) => <ToolIcon name={tool.icon} size={34} inset={false} />)}
              </span>
              <span class="tools-toc__txt"><b>{chapter.title}</b><small>{chapter.summary}</small></span>
              <span class="tools-toc__n">{chapter.tools.length}<span class="sr-only"> tools</span></span>
              <span class="tools-toc__arr" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </header>

  {chapters.map((chapter) => (
    <section class="tools-chapter" id={chapter.id} aria-labelledby={`${chapter.id}-h`}>
      <div class="kwrap">
        <div class="tools-chapter__head">
          <ArtFrame
            class="tools-chapter__art"
            src={heroCropSrc(chapter.art, 360)}
            srcset={heroCropSrcset(chapter.art)}
            sizes="(min-width: 761px) 232px, 76px"
            width={HERO_CROP_SIZE.width}
            height={HERO_CROP_SIZE.height}
            alt=""
            focus={chapter.focus}
          />
          <div class="tools-chapter__title">
            <h2 class="h-2" id={`${chapter.id}-h`}>{chapter.title}</h2>
            <p>{chapter.copy}</p>
          </div>
        </div>
        <ul class="tools-list">
          {chapter.tools.map((tool) => (
            <li>
              <a class="tools-row" href={tool.href}>
                <ToolIcon name={tool.icon} size={52} />
                <span><span class="tools-row__name">{tool.title}</span><span class="tools-row__line">{tool.promise}</span></span>
              </a>
            </li>
          ))}
        </ul>
        {chapter.group === 'year' && <p class="tools-chapter__note">Explore the <a class="textlink" href="/learn/chinese-zodiac/">Chinese zodiac calendar and its twelve animals</a>, or follow the sky through our <a class="textlink" href="/feeds/">RSS feeds</a>.</p>}
        {chapter.group === 'together' && <p class="tools-chapter__note">Mark a shared moment with <a class="textlink" href="/occasions/">occasion cards for milestones and baby showers</a>.</p>}
      </div>
    </section>
  ))}

  <section class="tools-help" aria-label="Help and privacy">
    <div class="kwrap tools-help__grid">
      <ToolsHelpCard icon="guide" art="tools-lens" title="Not sure which tool?">
        <p>Ask Guide, the site’s AI assistant, in your own words. It answers astrology questions and points you to the right page.</p>
        <a class="btn btn--sm" href="/ask/" data-assistant-open data-assistant-locale="en">Ask Guide</a>
      </ToolsHelpCard>
      <ToolsHelpCard icon="privacy" title="Private by default">
        <p>Birth-chart calculations stay in your browser. A saved chart stays on this device unless you turn sync on.</p>
        <a class="textlink" href="/privacy/">Privacy and method <span class="arr" aria-hidden="true">→</span></a>
      </ToolsHelpCard>
    </div>
  </section>
</Base>

<style>
  .tools-chapter__note { margin-top: 20px; color: var(--ink-2); font-size: 0.9375rem; line-height: 1.6; }
</style>
