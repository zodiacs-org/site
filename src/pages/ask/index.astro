---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';

/**
 * Guide — the grounded astrology assistant's home. The page is deliberately a
 * useful static guide first: everything above the fold reads without
 * JavaScript and stays useful when the assistant is resting. The
 * conversation itself is the existing reviewed panel, opened by the same
 * one-click loader the footer uses; nothing about the assistant's
 * privacy, quota, or grounding contract is duplicated here.
 */
const faq = [
  {
    q: 'Where do the answers come from?',
    a: 'Guide uses a curated reference built from Zodiacs.org calculators, sign guides, Learn pages, calendars, and horoscopes. Questions about the current sky use today’s positions, computed in your browser the same way the calculators compute them. When the site does not cover an exact claim, Guide says it cannot verify it instead of improvising.',
  },
  {
    q: 'Are the answers generated?',
    a: 'Yes. Replies are generated on the spot and can be wrong. Astrology here is a symbolic tradition read over precisely computed astronomy: positions are facts, meanings are interpretation — never fate, diagnosis, or a prediction of events.',
  },
  {
    q: 'What happens to my conversation?',
    a: 'Each message is sent to OpenAI to be answered. While you are signed out, the conversation is kept only in this browser tab for your local day, and Zodiacs.org does not store the conversation or chart summary. The service keeps privacy-preserving fair-use counters so one visitor cannot exhaust Guide for everyone.',
  },
  {
    q: 'How does it use my birth chart?',
    a: 'Only if you attach it, and you see exactly what is sent first. Attaching a chart is offered only in the encrypted sync preview, which is off on the public site, and only for the one chart you marked there as your own. Guide then includes a placements-only summary, computed in your browser, after you confirm a preview of the precise text. No saved name, birth date, time, place, or coordinates travel with it, though its planet positions still give your birth date and time, and its rising sign and midheaven, kept to the whole degree, your birthplace roughly. For a chart without a birth time, it is the sky at 12:00 UTC on the birth date, without the Moon, which gives the date but nothing about the birthplace. Zodiacs.org does not store it while you are signed out.',
  },
  {
    q: 'What will it not do?',
    a: 'No medical, mental-health, legal, or financial advice. No predictions of specific events or dates. No claims about another person’s private thoughts or future behavior. Guide uses practical language and preserves your agency.',
  },
];

const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': 'https://zodiacs.org/ask/#page',
    url: 'https://zodiacs.org/ask/',
    name: 'Guide — astrology and birth-chart help from Zodiacs.org',
    description: 'Ask Guide about birth charts, astrology, or Zodiacs.org tools and guides. Signed-out conversations are not stored by Zodiacs.org.',
    isPartOf: { '@id': 'https://zodiacs.org/#site' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Guide', item: 'https://zodiacs.org/ask/' },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title="Guide — astrology and birth-chart help from Zodiacs.org"
  description="Ask Guide about birth charts, astrology, or Zodiacs.org tools and guides. Signed-out conversations are not stored by Zodiacs.org."
  path="/ask/"
  image="/assets/og/v2/tool/ask.png"
  imageAlt="Guide — astrology and birth-chart help from Zodiacs.org"
  jsonLd={jsonLd}
  privateSurface
>
  <section class="container container--narrow ask" data-guide-page-id="guide">
    <header class="ask__hero reveal">
      <em class="kicker">Guide</em>
      <h1 class="display">Astrology help, right when you need it.</h1>
      <p class="ask__lede">
        Ask how a tool works, what a placement means, what today's sky is
        doing, or what your own saved chart says. Guide answers in practical,
        plain language and points you toward the relevant pages.
      </p>
      <div class="ask__cta">
        <button type="button" class="btn btn--primary" data-assistant-open>
          <span>Open Guide</span><span class="orb" aria-hidden="true">↗</span>
        </button>
        <noscript>
          <p class="ask__nojs">
            Guide needs JavaScript. The site's tools and published guides do
            not, so the guides below remain available without it.
          </p>
        </noscript>
      </div>
    </header>

    <div class="ask__grid reveal">
      <section class="tile ask__card" aria-labelledby="ask-site">
        <h2 id="ask-site">About the site</h2>
        <p>“How do I save a chart?” “What house system does the calculator
        use?” “Where are the eclipse dates?” Guide can explain the supported
        tools and point you to the relevant published page.</p>
        <p class="ask__links"><a href="/birth-chart/">Birth chart</a> · <a href="/tools/">All tools</a> · <a href="/methodology/">How we compute</a></p>
      </section>
      <section class="tile ask__card" aria-labelledby="ask-astro">
        <h2 id="ask-astro">General astrology</h2>
        <p>“Is Mercury retrograde right now?” “What does a Saturn square feel
        like?” “What is a cusp, really?” Plain-language answers in the same
        register as the Learn pages — tradition read over computed astronomy,
        never fate.</p>
        <p class="ask__links"><a href="/learn/">Learn</a> · <a href="/learn/houses/">The houses</a> · <a href="/learn/aspects/">The aspects</a></p>
      </section>
      <section class="tile ask__card" aria-labelledby="ask-chart">
        <h2 id="ask-chart">Your own chart</h2>
        <p>In the encrypted sync preview, Guide can read the placements of
        the one chart you marked as your own, after you approve a preview of
        exactly what will be sent. That preview is off on the public site, so
        for now you can type the placements you want to ask about.</p>
        <p class="ask__links"><a href="/birth-chart/">Compute a chart</a> · <a href="/profile/">Saved charts</a></p>
      </section>
    </div>

    <section class="shell tinted reveal ask__contract">
      <div class="core tinted ask__contract-core">
        <h2>The contract, plainly</h2>
        <ul>
          <li><strong>Grounded.</strong> Site and astrology claims come from a curated Zodiacs.org reference. When it cannot verify a fact, Guide says so.</li>
          <li><strong>Generated.</strong> Replies are produced on the spot and can be wrong. Astrology here is symbolic, not deterministic.</li>
          <li><strong>Private.</strong> Each message goes to OpenAI to be answered; signed-out conversations are kept in this browser session and are not stored by Zodiacs.org. A chart is attached only after you confirm a preview of the exact placement text.</li>
          <li><strong>Bounded.</strong> No medical, legal, or financial advice; no event predictions; no third-party readings. Fair-use limits keep it available: a short per-minute pace and thirty questions a day.</li>
        </ul>
        <p class="ask__rest">When Guide is resting — unavailable, or over its daily fair-use budget — this page and the site's own guides remain useful. Nothing else here requires Guide or an account.</p>
      </div>
    </section>

    <section class="reveal">
      <Faq items={faq} heading="Guide, answered" />
    </section>
  </section>
</Base>

<style>
  .ask { display: grid; gap: clamp(30px, 5vw, 48px); padding-block: clamp(24px, 5vw, 56px) clamp(40px, 6vw, 72px); }
  .ask__hero { display: grid; gap: 16px; justify-items: start; }
  .ask__hero h1 { margin: 0; font-size: clamp(2.1rem, 1.4rem + 3.2vw, 3.4rem); line-height: 1.04; }
  .ask__lede { margin: 0; max-width: 60ch; color: var(--text-2); font-size: var(--text-lg); line-height: 1.6; text-wrap: pretty; }
  .ask__cta { display: grid; gap: 10px; justify-items: start; }
  .ask__nojs { margin: 0; max-width: 52ch; color: var(--muted); font-size: var(--text-sm); }
  .ask__grid { display: grid; gap: 14px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .ask__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .ask__card { display: grid; gap: 10px; align-content: start; padding: clamp(18px, 3vw, 24px); }
  .ask__card h2 { margin: 0; font-size: var(--text-md); }
  .ask__card p { margin: 0; color: var(--text-2); font-size: var(--text-sm); line-height: 1.6; }
  .ask__links { color: var(--muted); }
  .ask__links a { color: var(--text-2); text-decoration-color: var(--hair-2); text-underline-offset: 3px; }
  .ask__contract-core { padding: clamp(22px, 4vw, 34px); display: grid; gap: 14px; }
  .ask__contract-core h2 { margin: 0; font-size: var(--text-lg); }
  .ask__contract-core ul { margin: 0; padding-left: 18px; display: grid; gap: 9px; }
  .ask__contract-core li { color: var(--text-2); font-size: var(--text-sm); line-height: 1.6; }
  .ask__contract-core strong { color: var(--text); }
  .ask__rest { margin: 0; color: var(--muted); font-size: var(--text-sm); max-width: 62ch; }
</style>
