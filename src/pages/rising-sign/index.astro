---
import Base from '../../layouts/Base.astro';
import ArtFrame from '../../components/ArtFrame.astro';
import HorizonDiagram from '../../components/HorizonDiagram.astro';
import PlanetGlyph from '../../components/PlanetGlyph';
import ChartCalculator from '../../islands/ChartCalculator';
import SignIcon from '../../components/SignIcon.astro';
import { SIGNS } from '../../lib/signs';
import { RISING } from '../../lib/interpretations';
import {
  RISING_AT,
  RISING_DAY,
  RISING_EXAMPLE,
  RISING_LATER,
  RISING_LONGEST,
  RISING_SHORTEST,
  clockLabel,
  durationLabel,
  traditionalRuler,
} from '../../lib/rising-example';
import '../../styles/calculator.css';

const faq = [
  {
    q: 'What is a rising sign?',
    a: 'Your rising sign, also called the ascendant, is the zodiac sign that was coming up over the eastern horizon at the moment you were born. In astrology it describes first impressions: how strangers read you before they know your Sun sign. It also sets the layout of your chart’s twelve houses.',
  },
  {
    q: 'Why do I need my exact birth time?',
    a: 'The ascendant moves through all twelve signs every 24 hours, a new sign roughly every two hours and sometimes faster. Near a sign change, even 15 minutes can matter. A birth certificate is the best source; hospital records and family memory come next.',
  },
  {
    q: 'What if my birth time is rounded, like exactly 7:00?',
    a: 'Rounded times are common on birth records. If your result sits in the first or last degree or two of a sign, treat the neighbouring sign as a real possibility and read both. The one that sounds like how strangers see you is usually yours.',
  },
  {
    q: 'What is a chart ruler?',
    a: 'The planet that rules your rising sign is your chart ruler. Astrologers treat its sign and house as a major theme of the chart. The calculator names yours, using the traditional rulerships for consistency.',
  },
  {
    q: 'Is the rising sign really that important?',
    a: 'In chart reading it is arguably the most important single point. It anchors the houses, so it decides which area of life every other planet falls in. It is also why two people born on the same day can have very differently shaped charts.',
  },
  {
    q: 'How is the rising sign calculated?',
    a: 'From the Earth’s rotation at the moment and place of your birth: local sidereal time, the tilt of the Earth’s axis, and some spherical trigonometry. As a check, the rising degree at sunrise matches the Sun’s own position. It all runs privately in your browser.',
    link: { href: '/methodology/', label: 'Read the full methodology' },
  },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    name: 'Rising Sign Calculator',
    url: 'https://zodiacs.org/rising-sign/',
    applicationCategory: 'LifestyleApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://zodiacs.org/tools/' },
      { '@type': 'ListItem', position: 3, name: 'Rising sign calculator', item: 'https://zodiacs.org/rising-sign/' },
    ],
  },
];

const example = RISING_AT;
const later = RISING_LATER;
/** The one-line manner of each rising, condensed from the calculator's own readings. */
const RISING_LINE: Record<string, string> = {
  aries: 'Momentum first: decisive, direct, already halfway out the door.',
  taurus: 'Calm, solid and unhurried. People tend to trust it on sight.',
  gemini: 'Quick, verbal and visibly curious. Strangers tell you things.',
  cancer: 'Approachable and receptive, softer than you are: a safe place to land.',
  leo: 'Warm and slightly luminous. The entrance gets noticed, and so does the exit.',
  virgo: 'Composed, precise, quietly evaluating: the competent one in the room.',
  libra: 'Agreeable and polished, with real steel under the diplomacy.',
  scorpio: 'Private and magnetic. People feel noticed, and most of them like it.',
  sagittarius: 'Open, funny, and about to suggest something.',
  capricorn: 'Serious, capable and dry: the one who read the contract.',
  aquarius: 'Interesting before friendly, with an original angle people remember.',
  pisces: 'Gentle and a little hard to place. Your attention reads as empathy.',
};

/* The day strip: one band per rising sign, sized by its minutes. The phone
   shows the same day as two half-day strips, so a band that crosses noon
   appears in both, cut at noon. */
const NOON = 720;
const half = (from: number, to: number) => RISING_DAY
  .filter((band) => band.end > from && band.start < to)
  .map((band) => ({ ...band, start: Math.max(band.start, from), end: Math.min(band.end, to) }));
const bandTitle = (band: { sign: { name: string }; start: number; end: number }) =>
  `${band.sign.name} rising, ${clockLabel(band.start)} to ${clockLabel(band.end)}, ${band.end - band.start} minutes`;
const isPinned = (slug: string) => slug === example.sign.slug || slug === later.sign.slug;
const pct = (minutes: number, from = 0, span = 1440) => `${(((minutes - from) / span) * 100).toFixed(2)}%`;
const AXIS = [0, 180, 360, 540, 720, 900, 1080, 1260, 1440];
const shortestNames = RISING_SHORTEST.map((band) => band.sign.name);
const shortestLine = `${shortestNames.length > 1 ? `${shortestNames.slice(0, -1).join(', ')} and ${shortestNames.at(-1)}` : shortestNames[0]} took ${durationLabel(RISING_SHORTEST[0].end - RISING_SHORTEST[0].start)}${shortestNames.length > 1 ? ' each' : ''}.`;
const unevenLine = `${RISING_LONGEST.sign.name} took ${durationLabel(RISING_LONGEST.end - RISING_LONGEST.start)} to rise. ${shortestLine}`;
const gap = later.minutes - example.minutes;
---
<Base
  clientUi
  title="Rising Sign Calculator: What Is My Rising Sign? | Zodiacs.org"
  description="Find your rising sign free with your birth time and place: how people first read you, plus the planet that rules your chart."
  path="/rising-sign/"
  image="/assets/og/v2/tool/rising-sign.png"
  imageAlt="Free rising sign calculator, Zodiacs.org"
  jsonLd={jsonLd}
>
  <!-- 01 · The calculator first, with an example of what it gives back. -->
  <section class="rs-tool">
    <div class="kwrap rs-grid">
      <div class="rs-main">
        <nav class="rs-crumbs" aria-label="Breadcrumb"><a href="/tools/">Tools</a><span aria-hidden="true">/</span><span aria-current="page">Rising sign</span></nav>
        <h1 class="rs-title">Find your rising sign.</h1>
        <p class="klede rs-lede">The sign that was coming up on the eastern horizon the moment you were born. It describes how people first meet you, and it sets the shape of your whole chart.</p>

        <ChartCalculator mode="rising" client:load />
        <noscript>
          <p>This rising sign calculator needs JavaScript. Enable it and reload with your birth date, exact time, and place to calculate your ascendant.</p>
        </noscript>

        <p class="rs-notime">
          <span class="rs-notime__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M15.5 3.6a8.6 8.6 0 1 0 4.9 13.9A7 7 0 0 1 15.5 3.6z" /></svg></span>
          <span>No exact time? The moon sign works from your birth date alone. <a href="/moon-sign/">Find your moon sign</a></span>
        </p>
      </div>

      <aside class="rs-example" aria-label="Example result">
        <ArtFrame
          class="rs-example__art"
          sign={example.sign.slug}
          sizes="(min-width: 960px) 540px, 100vw"
          eager
          focus="50% 64%"
          spot="47% 56%"
        />
        <span class="pill rs-example__tag">What you get · example</span>
        <div class="rs-example__body">
          <div class="rs-example__head">
            <SignIcon sign={example.sign.slug} size={68} loading="eager" class="rs-example__disc" />
            <p class="rs-example__who"><b>Your rising sign</b>Born {RISING_EXAMPLE.date} · {example.clock} · {RISING_EXAMPLE.place}</p>
          </div>
          <div class="rs-example__sign"><h2 class="h-2">{example.sign.name} rising</h2><span class="rs-mono">{example.degree}</span></div>
          <p class="rs-example__read">{RISING[example.sign.slug]}</p>
          <div class="rs-example__rows">
            <div>
              <span class="rs-example__ri" aria-hidden="true"><PlanetGlyph body={example.ruler} size={15} /></span>
              <span><b>Chart ruler: {example.ruler} in {example.rulerSign.name}.</b> <span class="rs-m">The planet steering your rising sign.</span></span>
            </div>
          </div>
          <div class="rs-example__links">
            <a class="textlink" href={`/rising-sign/${example.sign.slug}/`}>Read {example.sign.name} rising <span class="arr" aria-hidden="true">→</span></a>
            <a class="textlink" href="/birth-chart/">See the full birth chart <span class="arr" aria-hidden="true">→</span></a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <div class="kwrap"><hr class="rule" /></div>

  <!-- 02 · Why the birth time matters, shown rather than described. -->
  <section class="kwrap ksection rs-why-band">
    <div class="rs-why">
      <div>
        <span class="kicker">Why we ask for the time</span>
        <h2 class="h-2">The rising sign changes about every two hours.</h2>
        <div class="rs-prose">
          <p>The Earth turns once a day, so the eastern horizon passes through all twelve signs of the <a href="/learn/glossary/#zodiac">zodiac</a> every 24 hours. Your <a href="/learn/glossary/#rising-sign">rising sign</a> is whichever one was crossing it at the moment you were born.</p>
          <p>The signs don’t take equal time. Depending on the sign and how far from the equator you were born, one can rise in just over an hour and another in two and a half. That is why we ask for your exact time, and why we never guess it.</p>
        </div>
        <p class="rs-tip">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 2.5h7l3 3v12H5z" /><path d="M8 9h4M8 12h4" /></svg>
          <span><b>Where to find your time:</b> a birth certificate is best, then hospital records, then family memory. If it was rounded to exactly 7:00, read the sign either side too.</span>
        </p>
      </div>
      <div class="kpanel rs-horizon">
        <HorizonDiagram asc={example.asc} />
      </div>
    </div>

    <!-- One day of rising signs: one strip on a wide screen, two half days on a phone. -->
    <div class="rs-day rs-day--d">
      <div class="rs-day__head">
        <h3 class="h-3">One day in {RISING_EXAMPLE.place}, {RISING_EXAMPLE.date}</h3>
        <p>Each band is one rising sign. Wider bands took longer to rise.</p>
      </div>
      <div class="rs-track">
        <div class="rs-pin rs-pin--l" style={`left:${pct(example.minutes)}`}><span class="rs-pin__l"><b>{example.clock}</b>{example.sign.name} rising</span></div>
        <div class="rs-pin rs-pin--r" style={`left:${pct(later.minutes)}`}><span class="rs-pin__l"><b>{later.clock}</b>{later.sign.name} rising</span></div>
        <div class="rs-strip">
          {RISING_DAY.map((band, index) => (
            <span
              class:list={['rs-strip__b', isPinned(band.sign.slug) && 'is-on', band.sign.slug === example.sign.slug && 'is-start']}
              style={`flex:${band.end - band.start} 0 0;--c:${band.sign.hue}`}
              title={bandTitle(band)}
            >
              {index > 0 && band.end - band.start >= 30 && <img src={`/assets/zodiac-icons/48/${band.sign.slug}.webp`} width="26" height="26" alt="" loading="lazy" decoding="async" />}
            </span>
          ))}
        </div>
      </div>
      <div class="rs-axis" aria-hidden="true">
        {AXIS.map((minutes) => <span style={`left:${pct(minutes)}`}>{minutes === 1440 ? '12 am' : clockLabel(minutes).replace(':00', '')}</span>)}
      </div>
      <div class="rs-day__notes">
        <div><SignIcon sign={example.sign.slug} size={32} /><span><b>{example.clock}: {example.sign.name} rising</b>Chart ruler {example.ruler}, in {example.rulerSign.name}.</span></div>
        <div><SignIcon sign={later.sign.slug} size={32} /><span><b>{later.clock}: {later.sign.name} rising</b>Same day, same city, {gap} minutes later. Chart ruler {later.ruler}, in {later.rulerSign.name}.</span></div>
        <div><span class="rs-n" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="7.2" /><path d="M10 6v4l2.6 1.6" /></svg></span><span><b>Uneven by design</b>{unevenLine}</span></div>
      </div>
    </div>

    <div class="rs-day rs-day--m">
      <div class="rs-day__head">
        <h3 class="h-3">One day in {RISING_EXAMPLE.place}, {RISING_EXAMPLE.date}</h3>
        <p>Each band is one rising sign. Wider bands took longer to rise.</p>
      </div>
      {[[0, NOON, 'Midnight to noon'], [NOON, 1440, 'Noon to midnight']].map(([from, to, caption]) => (
        <>
          <p class="rs-sub">{caption}</p>
          <div class:list={['rs-track', from !== 0 && 'rs-track--plain']}>
            {from === 0 && (
              <>
                <div class="rs-pin rs-pin--l" style={`left:${pct(example.minutes, 0, NOON)}`}><span class="rs-pin__l"><b>{example.clock}</b>{example.sign.name} rising</span></div>
                <div class="rs-pin rs-pin--r" style={`left:${pct(later.minutes, 0, NOON)}`}><span class="rs-pin__l"><b>{later.clock}</b>{later.sign.name}</span></div>
              </>
            )}
            <div class="rs-strip">
              {half(from as number, to as number).map((band) => (
                <span
                  class:list={['rs-strip__b', isPinned(band.sign.slug) && 'is-on', band.sign.slug === example.sign.slug && 'is-start']}
                  style={`flex:${band.end - band.start} 0 0;--c:${band.sign.hue}`}
                  title={bandTitle(band)}
                >
                  {band.end - band.start >= 30 && <img src={`/assets/zodiac-icons/48/${band.sign.slug}.webp`} width="20" height="20" alt="" loading="lazy" decoding="async" />}
                </span>
              ))}
            </div>
          </div>
          <div class="rs-axis" aria-hidden="true">
            {[0, 180, 360, 540, 720].map((offset) => {
              const minutes = (from as number) + offset;
              return <span style={`left:${pct(offset, 0, NOON)}`}>{minutes === 1440 ? '12 am' : clockLabel(minutes).replace(':00', '')}</span>;
            })}
          </div>
        </>
      ))}
      <div class="rs-day__notes">
        <div><SignIcon sign={later.sign.slug} size={32} /><span><b>{gap} minutes, a different sign</b>Born at {example.clock}: {example.sign.name} rising. Born at {later.clock} the same day: {later.sign.name} rising.</span></div>
        <div><span class="rs-n" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="7.2" /><path d="M10 6v4l2.6 1.6" /></svg></span><span><b>Uneven by design</b>{unevenLine}</span></div>
      </div>
    </div>
  </section>

  <!-- 03 · What the result tells you. -->
  <section class="kwrap rs-band">
    <div class="rs-shows-wrap">
      <div class="section-head">
        <h2 class="h-2">What your rising sign shows</h2>
        <p>Three things. The calculator gives you the first two straight away.</p>
      </div>
      <div class="rs-shows">
        <div>
          <span class="rs-tg" style="background:var(--sign-libra)" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="8.5" r="3.5" /><path d="M5 20a7 7 0 0 1 14 0" /></svg></span>
          <h3 class="h-4">How people first meet you</h3>
          <p>The manner strangers notice before they know your Sun sign: how you walk into a room, and the first impression you leave.</p>
        </div>
        <div>
          <span class="rs-tg" style="background:var(--sign-sagittarius)" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5" /><path d="M12 3.5v3M12 17.5v3M3.5 12h3M17.5 12h3" /><path d="M9.5 14.5l1.2-3.8 3.8-1.2-1.2 3.8z" /></svg></span>
          <h3 class="h-4">Your chart ruler</h3>
          <p>The planet that rules your rising sign. Astrologers read its sign and house as one of the main themes of a chart.</p>
        </div>
        <div>
          <span class="rs-tg" style="background:var(--sign-cancer)" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="8.5" /><path d="M12 3.5v17M3.5 12h17M6 6l12 12M18 6L6 18" /></svg></span>
          <h3 class="h-4">The layout of your houses</h3>
          <p>Your rising sign starts the <a href="/learn/glossary/#first-house">first house</a>, so it decides which area of life every other planet falls in. The full birth chart shows them all.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 · The twelve rising guides, as cards. -->
  <section class="kwrap rs-band">
    <div class="section-head section-head--row">
      <div>
        <h2 class="h-2">The twelve risings</h2>
        <p>Once you know yours, read what it does to a chart: the manner, the chart ruler, and how the houses fall.</p>
      </div>
      <p class="rs-rnote only-desktop">Rulers follow the traditional system, the same one the calculator uses. <a href="/learn/glossary/#chart-ruler">What is a chart ruler?</a></p>
    </div>
    <div class="rs-risings">
      {SIGNS.map((sign) => {
        const ruler = traditionalRuler(sign);
        return (
          <a class:list={['rs-rc', sign.slug === example.sign.slug && 'is-ex']} href={`/rising-sign/${sign.slug}/`} style={`--sign:${sign.hue}`}>
            <span class="rs-rc__top">
              <SignIcon sign={sign.slug} size={44} />
              <span><b>{sign.name} <span class="rs-rc__r">rising</span></b><small>Ruler <PlanetGlyph body={ruler} size={12} /> {ruler}</small></span>
            </span>
            <p>{RISING_LINE[sign.slug]}</p>
          </a>
        );
      })}
    </div>
  </section>

  <!-- 05 · Keep going: the full birth chart, and the moon sign for people without a time. -->
  <section class="kwrap rs-band">
    <div class="rs-next">
      <article class="rs-bc">
        <div class="rs-bc__art"><img class="rs-bc__bg" src="/assets/hero/zodiacs-hero-poster.avif" width="1600" height="900" alt="The painted zodiac band with its pastel sign discs and the gilded sun, from the Zodiacs hero film" loading="lazy" decoding="async" /></div>
        <div class="rs-bc__body">
          <span class="kicker">Next step</span>
          <h2 class="h-2">Your rising sign is one of three.</h2>
          <p class="rs-bc__l">The free birth chart adds your Sun and Moon signs, every planet, and the twelve houses your rising sign sets up, with what each one means.</p>
          <div class="rs-bc__list">
            <div><SignIcon sign={example.sign.slug} size={26} />Rising sign, from this page</div>
            <div><span class="rs-bc__x"><PlanetGlyph body="Sun" size={13} /></span>Sun sign, your core identity</div>
            <div><span class="rs-bc__x"><PlanetGlyph body="Moon" size={13} /></span>Moon sign, how you feel</div>
          </div>
          <div class="btn-row">
            <a class="btn btn--primary btn--lg" href="/birth-chart/"><span>Get your free birth chart</span><span class="orb" aria-hidden="true">↗</span></a>
          </div>
          <p class="reassure">Same birth date, time and place. Private in your browser.</p>
        </div>
      </article>
      <article class="kcard rs-ms">
        <ArtFrame
          class="rs-ms__art"
          src="/assets/hero-crops/crescent-560.webp"
          srcset="/assets/hero-crops/crescent-360.webp 360w, /assets/hero-crops/crescent-560.webp 560w"
          sizes="(min-width: 1100px) 440px, 100vw"
          width={560}
          height={350}
          alt="Gilded crescent moon on a dark painted ceiling"
          spot="40% 40%"
        />
        <div class="rs-ms__body">
          <span class="kicker">Sister tool</span>
          <h3 class="h-3">Find your moon sign</h3>
          <p>How you feel, and what settles you. It works from your birth date alone, and a time makes it exact.</p>
          <a class="textlink" href="/moon-sign/">Moon sign calculator <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </article>
    </div>
    <div class="rs-also">
      <span class="rs-also__label">Also useful:</span>
      <a class="pill" href="/big-three/">Big three card to share</a>
      <a class="pill" href="/chart-twins/">Chart twins</a>
      <a class="pill" href="/learn/glossary/#ascendant">Ascendant, in plain words</a>
    </div>
  </section>

  <!-- 06 · Questions. -->
  <section class="kwrap rs-band rs-faq">
    <div class="qa">
      <div>
        <h2 class="h-2">Questions, answered</h2>
        <p>Still curious? <a class="rs-inline" href="/methodology/">See how charts are calculated</a>, or <a class="rs-inline" href="/ask/" data-assistant-open>ask Guide</a>.</p>
      </div>
      <div class="kfaq">
        {faq.map(({ q, a, link }, index) => (
          <details open={index === 0}>
            <summary>{q}</summary>
            <p>{a}{link && <> <a href={link.href}>{link.label}</a>.</>}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .rs-mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .rs-band { padding-bottom: clamp(64px, 8vw, 120px); }

  /* ── The tool, with an example result beside it ── */
  .rs-tool { position: relative; padding: clamp(8px, 2vw, 24px) 0 clamp(64px, 7vw, 104px); }
  .rs-grid { display: grid; grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.94fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  /* Once a result is on the page, the example steps aside. */
  .rs-grid:has(.calc > :not(form)) { grid-template-columns: minmax(0, 1fr); }
  .rs-grid:has(.calc > :not(form)) .rs-example { display: none; }
  .rs-crumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; font-size: 13px; color: var(--faint); }
  .rs-crumbs a { color: var(--muted); text-decoration: none; }
  .rs-crumbs span[aria-hidden] { opacity: 0.6; }
  .rs-title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2.6rem, 1.7rem + 3.1vw, 4rem);
    line-height: 1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .rs-lede { margin-top: 16px; }

  /* The calculator's form, dressed as the mockup's panel: date and time side
     by side, the time note full width under them, then the birthplace. */
  .rs-main :global(.calc) { margin-top: 30px; }
  .rs-main :global(.calc > .shell) { max-width: none; }
  .rs-main :global(.calc .calc__form.shell > .calc__core) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    padding: clamp(20px, 3vw, 32px);
    border-radius: var(--r-xl);
    background: linear-gradient(180deg, rgba(21, 25, 37, 0.86), rgba(15, 18, 26, 0.86));
