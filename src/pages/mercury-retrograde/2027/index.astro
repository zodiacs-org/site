---
import Base from '../../../layouts/Base.astro';
import '../../../styles/rx-table.css';
import sky from '../../../data/sky.json';
import { bodyLongitude } from '../../../lib/engine/full';
import { formatLongitude, signForLongitude } from '../../../lib/signs';
import { formatDate, formatShortDate } from '../../../lib/i18n/dates';
import { publishedEventById } from '../../../lib/events/site-publication';
import { nasaStationAt } from '../../../lib/nasa-instants';
import { worldTimesSentence } from '../../../world-times/world-times';
import { MERCURY_RETROGRADE_2027_UPDATED as UPDATED, updatedIso, updatedLabel } from '../../../world-times/updated';
import WorldTimesTable from '../../../world-times/WorldTimesTable.astro';

// The 2027 Mercury retrograde windows, cut from the same committed sky data
// the hub renders and refined to the hour — receipts, no client ephemeris.
const YEAR = 2027;
const buildNow = new Date();

const sources = [
  { label: 'Astronomy Engine', href: 'https://github.com/cosinekitty/astronomy' },
  { label: 'IANA Time Zone Database', href: 'https://www.iana.org/time-zones' },
];

type SkyWindow = { planet: string; from: string; to: string | null; preShadowStart?: string | null; postShadowEnd?: string | null };
const mercuryWindows = (sky.retrogrades as SkyWindow[]).filter((r) => r.planet === 'Mercury');

const windows = mercuryWindows
  .map((r) => ({
    from: new Date(r.from),
    to: r.to ? new Date(r.to) : null,
    fromIso: r.from,
    // The station instants printed below are NASA JPL Horizons' (src/lib/nasa-instants.ts);
    // the id, the dates and the degrees keep the committed sky data, as the calendar file does.
    rxAt: new Date(nasaStationAt('Mercury', r.from) ?? r.from),
    directAt: r.to ? new Date(nasaStationAt('Mercury', r.to) ?? r.to) : null,
    shadowFrom: r.preShadowStart ? new Date(r.preShadowStart) : null,
    shadowTo: r.postShadowEnd ? new Date(r.postShadowEnd) : null,
  }))
  .filter(({ from, to }) => from.getUTCFullYear() === YEAR || to?.getUTCFullYear() === YEAR)
  .map(({ from, to, fromIso, rxAt, directAt, shadowFrom, shadowTo }) => {
    const rxLon = bodyLongitude('Mercury', from);
    const directLon = to ? bodyLongitude('Mercury', to) : null;
    const id = `mercury-retrograde-${fromIso.slice(0, 10)}`;
    return {
      id,
      from,
      to,
      rxAt,
      directAt,
      shadowFrom,
      shadowTo,
      label: `${formatShortDate('en', from)} to ${to ? formatShortDate('en', to) : 'ongoing'}`,
      stationRx: formatLongitude(rxLon),
      stationDirect: directLon === null ? null : formatLongitude(directLon),
      signRx: signForLongitude(rxLon),
      signDirect: directLon === null ? null : signForLongitude(directLon),
      state: to && to < buildNow ? 'past' : from > buildNow ? 'upcoming' : 'active',
      path: publishedEventById.get(id)?.path ?? null,
    };
  });

if (windows.length === 0) throw new Error(`No ${YEAR} Mercury retrograde windows in sky.json`);

const fmtMonthDay = (d: Date) => formatDate('en', d, { month: 'long', day: 'numeric', timeZone: 'UTC' });
const spans = windows.map((w) => `${fmtMonthDay(w.from)} to ${w.to ? fmtMonthDay(w.to) : 'the end of the year'}`);
const signs = [...new Set(windows.flatMap((w) => [w.signRx.name, w.signDirect?.name].filter((name): name is string => Boolean(name))))];
const listJoin = (items: string[]) => items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}`;
const DAY_MS = 86_400_000;

// Every station of the year, for the five-clock table.
const stationRows = windows.flatMap((w) => [
  { label: `Turns retrograde in ${w.signRx.name}`, at: w.rxAt, past: w.rxAt < buildNow },
  ...(w.directAt && w.signDirect ? [{ label: `Turns direct in ${w.signDirect.name}`, at: w.directAt, past: w.directAt < buildNow }] : []),
]);

const complete = windows.filter((w) => w.directAt && w.shadowFrom && w.shadowTo);
if (complete.length !== windows.length) throw new Error(`A ${YEAR} Mercury window lacks a station or a shadow edge; update the page copy`);
const lengths = complete.map((w) => Math.round((w.directAt!.getTime() - w.rxAt.getTime()) / DAY_MS));
const passLengths = complete.map((w) => Math.round((w.shadowTo!.getTime() - w.shadowFrom!.getTime()) / DAY_MS));
const shadowSpans = complete.map((w) => `${fmtMonthDay(w.shadowFrom!)} to ${fmtMonthDay(w.shadowTo!)}`);

// The first window that starts after this year, from the same sky data.
const nextRaw = mercuryWindows.find((r) => new Date(r.from).getUTCFullYear() > YEAR && r.to);
if (!nextRaw) throw new Error(`No Mercury retrograde after ${YEAR} in sky.json`);
const nextFrom = new Date(nasaStationAt('Mercury', nextRaw.from) ?? nextRaw.from);
const nextTo = new Date(nasaStationAt('Mercury', nextRaw.to!) ?? nextRaw.to!);
const nextSign = signForLongitude(bodyLongitude('Mercury', new Date(nextRaw.from)));
const nextPath = publishedEventById.get(`mercury-retrograde-${nextRaw.from.slice(0, 10)}`)?.path ?? null;

const description = `Every Mercury retrograde window of 2027 with each station's time in UTC, New York, London, Kolkata and Sydney, the degree Mercury stations at, the shadow dates, and a calendar file.`;

const faq = [
  {
    q: `When is Mercury retrograde in ${YEAR}?`,
    a: `${windows.length} times: ${spans.join('; ')}. Each window runs from the station where Mercury turns retrograde to the station where it turns direct, and the dates are universal time.`,
  },
  {
    q: 'What time does Mercury retrograde start where I live?',
    a: `The first ${YEAR} window starts at ${worldTimesSentence(windows[0].rxAt)}. The local times table lists every ${YEAR} station on those five clocks, daylight saving included. For anywhere else, add or subtract your own offset from UTC.`,
  },
  {
    q: 'How long does Mercury retrograde last?',
    a: `From station to station, the ${YEAR} windows last ${listJoin(lengths.map(String))} days. Counting the shadow on both sides, each passage over the same stretch of the zodiac takes ${listJoin(passLengths.map(String))} days.`,
  },
  {
    q: 'Which signs do the 2027 retrogrades touch?',
    a: `The stations fall in ${listJoin(signs)}. A retrograde that starts in one sign and ends in the previous one runs across that boundary, which is why the table shows both station positions.`,
  },
  {
    q: 'Is there a shadow period before and after?',
    a: `Mercury crosses the same degrees three times: forward before the retrograde station, backward during the window, and forward again after the direct station. Those bracketing passes are what people call the shadow. The shadow starts when Mercury first reaches the degree where it will later turn direct, and ends when it passes the degree where it turned retrograde. In ${YEAR} that is ${listJoin(shadowSpans)}.`,
  },
  {
    q: 'Can you see Mercury retrograde in the sky?',
    a: 'Not as motion you can watch. Mercury is retrograde around the time it passes between Earth and the Sun, midway through each window, so for part of it Mercury sits within 10° of the Sun and is lost in its glare. The backward drift shows only when its position against the stars is compared over days.',
  },
  {
    q: `When is the next Mercury retrograde after ${YEAR}?`,
    a: `${fmtMonthDay(nextFrom)} to ${fmtMonthDay(nextTo)}, ${nextFrom.getUTCFullYear()}, starting in ${nextSign.name}. It turns retrograde at ${worldTimesSentence(nextFrom)}.`,
  },
];

const jsonLd = [
  {
    '@type': 'WebPage',
    name: `Mercury retrograde ${YEAR}`,
    url: `https://zodiacs.org/mercury-retrograde/${YEAR}/`,
    description,
    dateModified: updatedIso(UPDATED),
    isPartOf: { '@type': 'WebPage', url: 'https://zodiacs.org/mercury-retrograde/' },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  title="Mercury Retrograde 2027: Exact Dates and Stations | Zodiacs.org"
  description="Every Mercury retrograde window of 2027 with each station's time in UTC, New York, London, Kolkata and Sydney, the degree Mercury stations at, the shadow dates, and a calendar file."
  path={`/mercury-retrograde/${YEAR}/`}
  image="/assets/og/v2/tool/mercury-retrograde.png"
  imageAlt="Mercury retrograde 2027, Zodiacs.org"
  jsonLd={jsonLd}
  sources={sources}
>
  <section class="section--tight container container--narrow">
    <div class="tool-hero reveal">
      <a class="crumb" href="/mercury-retrograde/"><span class="crumb__arrow" aria-hidden="true">←</span>Mercury retrograde</a>
      <h1 class="display">Mercury retrograde in {YEAR}.</h1>
      <p>
        {windows.length} windows, each computed from <a href="/learn/glossary/#mercury">Mercury</a>’s actual motion{' '}
        <a href="/learn/glossary/#station">station to station</a>, with the degree it stands still at on each end.
        Dates are universal time; the <a href="#local-times">local times table</a> gives each station in New York, London, Kolkata and Sydney too.
      </p>
      <p class="year-page__updated">Updated <time datetime={UPDATED}>{updatedLabel(UPDATED)}</time></p>
    </div>

    <div class="rx-now shell tinted reveal" style="--sign:var(--sign-gemini)">
      <div class="core tinted rx-now__core">
        <span class="mono--label">Calendar file</span>
        <strong class="rx-now__line">
          <a href={`/mercury-retrograde/${YEAR}.ics`}>Add the {YEAR} windows to your calendar</a>
        </strong>
        <span class="rx-now__all mono">
          One event per window, station to station · every year from 2026 on <a href="/mercury-retrograde/">the Mercury retrograde page</a>
        </span>
      </div>
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <div class="section-head reveal">
      <h2>The windows, {YEAR}</h2>
      <p>Dates in universal time. The position shown is where Mercury stands still each time, the stations.</p>
    </div>
    <div class="table-wrap reveal">
      <table class="rx-table">
        <thead>
          <tr><th>Window</th><th>Stations retrograde at</th><th>Stations direct at</th><th></th></tr>
        </thead>
        <tbody>
          {windows.map((w) => (
            <tr id={w.id} class={w.state === 'past' ? 'rx-table__past' : ''}>
              <td data-label="Window">{w.path ? <a href={w.path}>{w.label}</a> : w.label}</td>
              <td class="mono" data-label="Stations retrograde at">{w.stationRx}</td>
              <td class="mono" data-label="Stations direct at">{w.stationDirect ?? '—'}</td>
              <td class="mono rx-table__state" data-label="Status">{w.state === 'active' ? 'now' : w.state === 'upcoming' ? 'ahead' : ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section--tight container container--narrow" id="local-times">
    <div class="section-head reveal">
      <h2>Station times in five time zones</h2>
      <p>Each station at the minute it happens, on five clocks. The date moves with the zone: an evening station in UTC is the next morning in Sydney.</p>
    </div>
    <div class="reveal">
      <WorldTimesTable rows={stationRows} eventLabel="Station" caption={`Mercury's ${YEAR} stations in UTC, New York, London, Kolkata and Sydney`} />
    </div>
    <p class="year-page__check reveal">
      Station times come from NASA JPL Horizons (the DE441 ephemeris), solved to the second and printed to the minute.
      The degrees and the shadow dates come from our own engine. <a href="/methodology/#event-times">How we check event times</a>
    </p>
  </section>

  <section class="section--tight container container--narrow">
    <div class="prose reveal">
      <h2>What the window asks</h2>
      <p>
        The appearance is an optical effect: Mercury overtakes Earth on the inside of its orbit and seems to slide
        backward through the zodiac for about three weeks. The practical reading is the same each time: reread before
        you send, confirm the time and the place, and expect the conversation you thought was finished to come back
        once. Which part of your life it visits depends on the <a href="/learn/houses/">house</a> those degrees fall in
        for you; the birth-chart calculator shows which.
      </p>
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <div class="section-head reveal"><h2>Questions</h2></div>
    <div class="prose reveal">
      {faq.map(({ q, a }) => (
        <details class="faq-item">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
    <p class="year-page__links reveal">
      {nextPath && <><a href={nextPath}>The next one, {nextFrom.getUTCFullYear()}</a> · </>}
      <a href="/mercury-retrograde/">All years</a> · <a href="/retrogrades/">Every planet</a> ·
      <a href={`/full-moon-calendar/${YEAR}/`}>Full moons {YEAR}</a> · <a href={`/eclipses/${YEAR}/`}>Eclipses {YEAR}</a>
    </p>
  </section>
</Base>

<style>
  .tool-hero .kicker { display: block; margin-bottom: 10px; }
  .year-page__updated { margin: 10px 0 0; color: var(--muted); font-size: var(--text-sm); }
  .year-page__check { margin: 14px 0 0; max-width: 64ch; color: var(--muted); font-size: var(--text-sm); }
  .year-page__check a { color: var(--text-2); }
  .year-page__links { margin-top: 18px; color: var(--muted); font-size: var(--text-sm); }
  .year-page__links a { color: var(--text-2); }
  .faq-item { border-top: 1px solid var(--hair-1); }
  .faq-item summary { min-height: 44px; padding: 12px 0; cursor: pointer; color: var(--text); }
  .faq-item p { margin: 0 0 14px; color: var(--muted); }
</style>
