---
import Base from '../../layouts/Base.astro';
import VedicSigns from '../../islands/VedicSigns';
import '../../styles/calculator.css';

const faq = [
  { q: 'Why is my Vedic sign different from my Western sign?', a: 'The two zodiacs start in different places. Western astrology starts Aries at the spring equinox, so its signs keep step with the seasons. Vedic astrology (Jyotish) starts Aries from the stars. The equinox slides back along the stars by about one degree every 72 years, and the two zodiacs now sit about 24 degrees apart, so most placements fall one sign earlier in the Vedic chart. If your Western Sun is late in its sign, it can stay in the same sign.' },
  { q: 'Why does Vedic astrology lead with the Moon sign?', a: 'In Jyotish the Moon is the mind and the feelings, and the Moon sign (rashi) is what most people mean by "my sign". Daily and yearly forecasts, the dasha periods and much of compatibility are read from the Moon and its nakshatra. The Sun, the soul and sense of self, matters too, but it comes second.' },
  { q: 'What is a nakshatra?', a: 'One of 27 lunar mansions, each 13 degrees 20 minutes of the sidereal zodiac, starting with Ashwini at 0 degrees Aries. The Moon spends about a day in each. Every nakshatra has a ruling planet, a deity and a symbol, and is split into four padas (quarters) of 3 degrees 20 minutes. Your birth nakshatra is the one your Moon was in.' },
  { q: 'What is an ayanamsa, and which should I choose?', a: 'The ayanamsa is the distance between the two zodiacs on a given day: the amount subtracted from a Western position to give the Vedic one. Traditions fix the starting point slightly differently. Lahiri, the Indian government standard, is the default and the one most Vedic astrologers use; the others are here for readers who follow Raman, Krishnamurti (KP), Fagan and Bradley, Sri Yukteswar or True Chitra.' },
  { q: 'Do I need my birth time?', a: 'For the rising sign (lagna), yes: it changes sign about every two hours. Without a time, the page gives your Sun sign, and your Moon sign and nakshatra only when the Moon stayed in them for the whole birth day; otherwise it lists both and says a birth time settles it.' },
  { q: 'How is it calculated, and is anything stored?', a: 'Your Sun, Moon and rising degree come from the same engine as the birth chart, as positions of date. The chosen ayanamsa, with nutation, is subtracted to give sidereal positions, and the Moon\'s sidereal degree gives its nakshatra and pada. All of it runs on this device. Nothing is uploaded or stored, and the share link carries only the signs, the nakshatra and the ayanamsa.' },
];
const jsonLd = [
  { '@type': 'WebApplication', name: 'Vedic Signs Calculator', url: 'https://zodiacs.org/vedic-signs/', applicationCategory: 'LifestyleApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
  { '@type': 'FAQPage', mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base
  clientUi
  title="Your Vedic Signs: Sidereal Sun, Moon, Rising and Nakshatra"
  description="Find your Sun, Moon and rising signs in the sidereal zodiac of Vedic astrology, and the nakshatra your Moon was in, with its pada, lord, deity and symbol. Lahiri by default. Calculated in your browser."
  path="/vedic-signs/"
  jsonLd={jsonLd}
>
  <section class="section--tight container">
    <div class="tool-hero">
      <h1 class="display">Your Vedic signs</h1>
      <p>Your Sun, Moon and rising signs in the sidereal zodiac of Jyotish, Vedic astrology, and the nakshatra your Moon was in. Vedic signs usually sit one sign behind Western ones, because Jyotish counts the zodiac from the stars rather than the seasons.</p>
    </div>
    <VedicSigns client:load />
    <noscript><p>This calculator needs JavaScript. Enable it and reload to work out your Vedic signs in your browser.</p></noscript>
  </section>

  <section class="section--tight container container--narrow">
    <div class="section-head"><h2>Questions, answered</h2></div>
    <div class="faq">
      {faq.map(({ q, a }) => <details class="faq__item"><summary>{q}</summary><p>{a}</p></details>)}
    </div>
    <p class="vedic-related">In the Western zodiac: <a href="/moon-sign/">your Moon sign</a>, <a href="/big-three/">your big three</a> and <a href="/birth-chart/">your full birth chart</a>.</p>
  </section>
</Base>

<style>
  .tool-hero { max-width: 66ch; margin-bottom: clamp(28px, 5vw, 44px); }
  .tool-hero h1 { margin: 0 0 16px; font-family: var(--font-serif); font-size: var(--text-2xl); font-weight: 500; line-height: 1.04; text-wrap: balance; }
  .tool-hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }
  .faq { display: grid; gap: 8px; }
  .faq__item { border: 1px solid var(--hair-1); border-radius: var(--r-md); background: var(--void-1); padding: 4px 18px; }
  .faq__item summary { cursor: pointer; padding: 12px 0; font-weight: 550; color: var(--text); }
  .faq__item p { margin: 2px 0 16px; color: var(--text-2); font-size: var(--text-sm); line-height: 1.65; }
  .vedic-related { margin: 24px 0 0; color: var(--muted); font-size: var(--text-sm); }
  :global(.vedic__result) { display: grid; gap: 20px; margin-top: clamp(28px, 5vw, 44px); outline: none; }
  :global(.vedic__head h2) { margin: 0 0 10px; font-size: var(--text-xl); }
  :global(.vedic__head p) { margin: 0; max-width: 66ch; color: var(--text-2); font-size: var(--text-sm); line-height: 1.65; }
  :global(.vedic__grid) { display: grid; gap: 14px; grid-template-columns: 1fr; }
  @media (min-width: 760px) { :global(.vedic__grid) { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  :global(.vedic__card) { padding: 20px; }
  :global(.vedic__card.tile:hover) { transform: none; }
  :global(.vedic__body) { margin: 0 0 12px; font-family: var(--font-serif); font-style: italic; font-size: var(--text-lg); color: var(--muted); }
  :global(.vedic__disc) { display: block; width: 56px; height: 56px; margin: 0 0 12px; }
  :global(.vedic__disc--open) { box-sizing: border-box; border: 1.5px dashed var(--hair-2, rgba(198, 204, 218, 0.24)); border-radius: 50%; }
  :global(.vedic__sign) { margin: 0 0 8px; font-family: var(--font-serif); font-weight: 500; font-size: var(--text-xl); line-height: 1.1; color: var(--text); }
  :global(.vedic__sign span) { display: block; margin-top: 2px; font-family: var(--font-sans); font-size: var(--text-sm); font-weight: 400; color: var(--muted); }
  :global(.vedic__facts) { margin: 0 0 10px; color: var(--text-2); font-size: var(--text-sm); }
  :global(.vedic__line) { margin: 0; color: var(--text-2); font-size: var(--text-sm); line-height: 1.65; text-wrap: pretty; }
  :global(.vedic__facts-list) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 18px; margin: 4px 0 14px; }
  @media (min-width: 760px) { :global(.vedic__facts-list) { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  :global(.vedic__facts-list dt) { color: var(--muted); font-size: var(--text-xs, 0.8rem); }
  :global(.vedic__facts-list dd) { margin: 2px 0 0; color: var(--text); font-size: var(--text-sm); }
  :global(.vedic__limits h3) { margin: 0 0 8px; font-family: var(--font-serif); font-weight: 500; font-size: var(--text-lg); }
  :global(.vedic__limits ul) { margin: 0; padding-left: 1.1em; color: var(--text-2); font-size: var(--text-sm); line-height: 1.65; display: grid; gap: 6px; }
  :global(.vedic__confidence) { margin: 0; color: var(--text-2); font-size: var(--text-sm); }
  :global(.vedic__share) { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  :global(.vedic__share .btn) { min-height: 44px; }
  :global(.vedic__share-note) { flex-basis: 100%; margin: 0; color: var(--muted); font-size: var(--text-sm); }
  :global(.vedic__more) { margin: 0; color: var(--text-2); font-size: var(--text-sm); }
</style>
