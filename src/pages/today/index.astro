        <p class="today-method__links">
          <a class="textlink" href="/methodology/#daily-publication">How daily publication works <span class="arr" aria-hidden="true">→</span></a>
          <a class="textlink" href="/data/daily-publication.json">This edition’s record <span class="arr" aria-hidden="true">→</span></a>
          <a class="textlink" href="/corrections/">Corrections <span class="arr" aria-hidden="true">→</span></a>
        </p>
      </div>
    </section>
  </section>
<style is:global>
