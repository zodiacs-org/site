    background: color-mix(in oklab, var(--sign) 7%, var(--void-1));
  }
  .today-sign-reading:not(.today-sign-reading--compact) {
    grid-template-rows: auto auto auto 1fr;
    grid-template-areas: 'icon kicker' 'icon title' 'icon line' 'icon more';
    max-width: 820px;
  }
  :root[data-today-sun-sign]:not([data-today-saved-chart]) .today-sign-reading--compact .today-sign-reading__title,
  .today-sign-reading:not(.today-sign-reading--compact) .today-sign-reading__title { font-family: var(--font-serif); font-size: var(--text-xl); font-weight: 500; }
  :root[data-today-sun-sign]:not([data-today-saved-chart]) .today-sign-reading--compact .today-sign-reading__line,
  .today-sign-reading:not(.today-sign-reading--compact) .today-sign-reading__line { color: var(--text-2); font-size: clamp(1rem, 0.96rem + 0.25vw, 1.12rem); line-height: 1.6; }
  :root[data-today-sun-sign]:not([data-today-saved-chart]) .today-sign-reading__more { align-self: end; margin-top: 4px; color: var(--ink-0); font-size: 0.9375rem; font-weight: 550; }
  :root[data-today-sun-sign]:not([data-today-saved-chart]) .today-sign-reading__more-label { position: static; width: auto; height: auto; overflow: visible; clip: auto; }
  .today-sign-reading .btn { grid-area: more; justify-self: start; margin-top: 4px; }
  .today-fallback__personalize {
