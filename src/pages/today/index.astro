  }
  .today-sign-reading .kicker { grid-area: kicker; margin: 0; font-size: var(--text-base); }
  .today-sign-reading__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 8px;
    grid-area: title;
