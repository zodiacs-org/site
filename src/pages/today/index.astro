  .today-quiet__baseline > strong { color: var(--text-2); font-size: var(--text-sm); }
  .today-quiet__baseline > p:not(.kicker) { color: var(--muted); font-size: var(--text-sm); }
  .today-quiet__baseline > a { display: inline-block; margin-top: 10px; color: var(--sign, var(--text-2)); font-size: var(--text-sm); font-weight: 650; }
  .today-method-details {
