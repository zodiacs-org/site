  .today-rt__bar.is-clip-end { border-right: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; -webkit-mask-image: linear-gradient(270deg, transparent, #000 45%); mask-image: linear-gradient(270deg, transparent, #000 45%); }
  .today-rt__key { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 14px; color: var(--muted); font-size: 12.5px; }
  .today-rt__key > span { display: inline-flex; align-items: center; gap: 8px; }
