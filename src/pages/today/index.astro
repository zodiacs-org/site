  .today-rt__today { position: absolute; top: 0; left: var(--today-at); z-index: 2; padding: 3px 9px; border-radius: 99px; background: var(--ink-0); color: var(--void-0); font-size: 11.5px; font-weight: 600; white-space: nowrap; transform: translateX(-50%); }
  .today-rt__bar { position: absolute; top: 50%; height: 14px; margin-top: -7px; border-radius: 99px; background: linear-gradient(90deg, rgba(222, 142, 121, 0.88), rgba(224, 169, 180, 0.88)); }
