    .today-sign-reading--compact:hover .today-sign-reading__arrow { transform: translateX(3px); }
  }
  .today-sign-reading:target { background: color-mix(in oklab, var(--sign) 7%, transparent); }
  /* The quick read for a sign just picked settles in where the twelve notes
