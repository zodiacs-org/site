---
import Base from '../../layouts/Base.astro';
import ArtFrame from '../../components/ArtFrame.astro';
import EditionText from '../../components/EditionText.astro';
import EvidenceDisclosure from '../../components/EvidenceDisclosure.astro';
import AskGuideLine from '../../components/AskGuideLine.astro';
import GuideQuickPrompts from '../../components/GuideQuickPrompts.astro';
import SignIcon from '../../components/SignIcon.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import TodayBrief from '../../islands/today/TodayBrief';
import SkyTicker from '../../islands/SkyTicker';
import Wheel from '../../lib/wheel/Wheel';
import dailyData from '../../data/daily.json';
import publicationData from '../../data/daily-publication.json';
import skyData from '../../data/sky.json';
import eclipseData from '../../data/eclipses.json';
import eventsData from '../../data/events-publication.json';
import { CONTEXT_TERMS } from '../../data/context-help';
import type { Daily } from '../../lib/daily';
import type { DailyPublication } from '../../lib/daily-publication';
import { editionDateLabel } from '../../lib/edition-freshness';
import { ASPECT_GLYPH, PLANET_GLYPH } from '../../lib/glyphs/paths';
import { livingChartCaptureEnabled, livingChartSyncEnabled } from '../../lib/living-chart/feature-flags';
import { NATAL_BODY_THEME } from '../../lib/natal-context';
import { TOOLS_HUB } from '../../lib/nav-tools';
import { ART, artSrc, artSrcset } from '../../lib/art';
import { signBySlug } from '../../lib/signs';
import { signDateRange, signTagline } from '../../lib/sign-display';
import {
  aspectsToday,
  comingUp,
  degreeMinutes,
  editionDayEvents,
  longDate,
  moonAgeDays,
  moonCycle,
  nextEclipse,
  phaseLabel,
  planetRows,
  retrogradeTimeline,
  shortDate,
  utcClock,
  type TransitCatalog,
} from '../../lib/today-sky';

const daily = dailyData as Daily;
const publication = publicationData as DailyPublication;
const publicationLabel = editionDateLabel(publication.date);
const sunSignReadings = Object.fromEntries(
  publication.signs.map((entry) => [entry.sign, {
    text: entry.todayLine.text,
    receipt: entry.todayLine.receipt,
    house: entry.todayLine.house,
  }]),
);
const livingChartEnabled = livingChartCaptureEnabled({
  PUBLIC_LIVING_CHART_CAPTURE_ENABLED: process.env.PUBLIC_LIVING_CHART_CAPTURE_ENABLED,
});
const livingChartCloudSyncEnabled = livingChartEnabled && livingChartSyncEnabled({
  PUBLIC_LIVING_CHART_SYNC_ENABLED: process.env.PUBLIC_LIVING_CHART_SYNC_ENABLED,
});

// ── The edition's sky. Every value below comes from committed data for the
// edition date: the noon-UTC snapshot, the lunation and retrograde tables,
// the monthly transit catalogs, the eclipse table and the event pages. ──
const catalogs = Object.values(import.meta.glob<{ default: TransitCatalog }>('../../data/transits-*.json', { eager: true }))
  .map((module) => module.default);
const cap = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);
const listWords = (items: string[]) => (items.length <= 1
  ? items.join('')
  : `${items.slice(0, -1).join(', ')} and ${items.at(-1)}`);
const snapshotAt = daily.snapshotAt ?? `${daily.date}T12:00:00.000Z`;
const editionShort = shortDate(publication.date);
const bodyOf = (name: string) => daily.bodies.find((body) => body.body === name)!;
const sun = bodyOf('Sun');
const moon = bodyOf('Moon');
const sunSign = signBySlug(sun.sign);
const moonSign = signBySlug(moon.sign);
const illumination = Math.round(daily.moon.illumination * 100);
const phase = phaseLabel(daily.moon.phase);
const moonAge = moonAgeDays(daily, skyData.moons);
const rows = planetRows(daily);

// What happens on the edition's own date, as one sentence of facts.
const dayEvents = editionDayEvents(daily).slice(0, 3);
const daySentence = dayEvents.length === 0
  ? ''
  : `${cap(dayEvents[0])} today${dayEvents.length === 1
    ? '.'
    : dayEvents.length === 2 ? `, and ${dayEvents[1]}.` : `, ${dayEvents[1]}, and ${dayEvents[2]}.`}`;

// The two lights: their signs as the sign guides sum them up, and where in
// the sign each one stands.
const sunIngress = catalogs.flatMap((catalog) => catalog.ingresses)
  .filter((ingress) => ingress.planet === 'Sun' && ingress.at > snapshotAt)
  .sort((a, b) => a.at.localeCompare(b.at))[0];
const thirds = ['first', 'middle', 'last'];
const sunNote = `The Sun is in the ${thirds[Math.min(2, Math.floor(sun.degree / 10))]} third of the sign${sunIngress ? ` and enters ${signBySlug(sunIngress.sign).name} on ${shortDate(sunIngress.at)}` : ''}.`;
const moonNote = moonAge !== null
  ? `The Moon is ${moonAge} days past the new moon${moon.degree >= 29 ? ', in the last degree of the sign' : ''}.`
  : '';

// The lunar cycle, drawn as the Moon looks: lit on the right while waxing.
const cycle = moonCycle(daily, skyData.moons, catalogs);
const waxing = /waxing|first quarter/iu.test(daily.moon.phase);
function moonPath(fraction: number, growing: boolean, r = 20): string {
  if (fraction >= 0.985) return 'full';
  if (fraction <= 0.015) return '';
  const rx = (Math.abs(1 - 2 * fraction) * r).toFixed(2);
  const outer = growing ? 1 : 0;
  const inner = fraction < 0.5 ? (growing ? 0 : 1) : (growing ? 1 : 0);
  return `M0,-${r} A${r},${r} 0 0 ${outer} 0,${r} A${rx},${r} 0 0 ${inner} 0,-${r} Z`;
}
const todayMoonPath = moonPath(daily.moon.illumination, waxing);

// The planets, the dates ahead and the retrogrades.
const coming = comingUp(daily, catalogs, eclipseData.eclipses, eventsData.pages);
const eclipseAhead = nextEclipse(daily, eclipseData.eclipses);
const timeline = retrogradeTimeline(daily, skyData.retrogrades);
const allAspects = aspectsToday(daily);
const aspectCards = allAspects.slice(0, 4);
const wheelAspects = allAspects.map((aspect) => ({ a: aspect.a, b: aspect.b, type: aspect.type }));
const aspectTypes = new Set(allAspects.map((aspect) => aspect.type));
const definition = (slug: string) => CONTEXT_TERMS.find((term) => term.slug === slug)?.plainDefinition ?? '';
const named = (body: string) => (body === 'Sun' || body === 'Moon' ? `the ${body}` : body);
const topic = (body: string) => NATAL_BODY_THEME[body as keyof typeof NATAL_BODY_THEME]?.topic ?? '';
const numberWord = (count: number) => ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'][count] ?? String(count);

const retrogradeNow = timeline.rows.filter((row) => row.state === 'now').map((row) => row.planet);
const nextRetrograde = timeline.rows
  .filter((row) => row.state === 'upcoming')
  .sort((a, b) => a.from.localeCompare(b.from))[0];
const justEnded = timeline.rows
  .filter((row) => row.state === 'ended')
  .sort((a, b) => b.to.localeCompare(a.to))[0];
const retrogradeSummary = [
  retrogradeNow.length === 0
    ? 'No planet is retrograde today.'
    : `${listWords(retrogradeNow)} ${retrogradeNow.length === 1 ? 'is' : 'are'} retrograde today.`,
  nextRetrograde ? `${nextRetrograde.planet} turns retrograde on ${shortDate(nextRetrograde.from)}.` : '',
  justEnded
    ? `${justEnded.planet}’s retrograde ended ${justEnded.to.slice(0, 10) === publication.date ? 'today' : `on ${shortDate(justEnded.to)}`}.`
    : '',
].filter(Boolean).join(' ');
const windowEndLabel = shortDate(new Date(Date.parse(timeline.to) - 86_400_000).toISOString(), true);
const periodYear = (iso: string) => iso.slice(0, 4) !== publication.date.slice(0, 4);

const goFurther = ['/transits/', '/moon-phase/', '/sky-calendar/', '/eclipses/']
  .map((href) => TOOLS_HUB.find((tool) => tool.href === href))
  .filter((tool): tool is (typeof TOOLS_HUB)[number] => Boolean(tool));
const monthDay = (iso: string) => ({
  month: new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' }).format(new Date(iso)),
  day: new Date(iso).getUTCDate(),
});
---
<Base
  inlineCriticalCss
  stableTypography
  localTypography
  stableChromeTypography
  minimalNavFontPreloads
  title={`The Sky on ${publicationLabel}: Planets, Moon Phase and Retrogrades | Zodiacs.org`}
  description={`Where each planet is at noon UTC on ${publicationLabel}, the Moon’s phase, what is retrograde and the dates coming up, with a short note for every Sun sign.`}
  path="/today/"
  imageAlt={`The sky on ${publicationLabel}, Zodiacs.org`}
  editionDate={publication.date}
>
  <script slot="head" is:inline define:vars={{ livingChartEnabled }}>
    /* Private return-state hint. It carries no chart data: the boolean and
       validated sign let CSS establish the correct first-paint geometry
       before the idle island reads storage. */
    (function () {
      try {
        var sign = localStorage.getItem('zodiacs:today-sun-sign:v1');
        var preferredSign = /^(aries|taurus|gemini|cancer|leo|virgo|libra|scorpio|sagittarius|capricorn|aquarius|pisces)$/.test(sign || '') ? sign : null;
        if (preferredSign) {
          document.documentElement.setAttribute('data-today-sun-sign', sign);
          document.documentElement.setAttribute('data-today-stream-pending', '');
          document.addEventListener('DOMContentLoaded', function () {
            requestAnimationFrame(function () {
              requestAnimationFrame(function () {
                document.documentElement.removeAttribute('data-today-stream-pending');
              });
            });
          }, { once: true });
        }
        var syncPrivateProfileHint = function () {
          document.documentElement.removeAttribute('data-today-saved-chart');
          document.documentElement.removeAttribute('data-today-chart-sun-sign');
          document.documentElement.removeAttribute('data-today-sign-mismatch');
          document.documentElement.removeAttribute('data-living-chart-needs-self');
          if (document.documentElement.hasAttribute('data-account-sync-v2')
            && (!window.zodiacsProfileAccess || !window.zodiacsProfileAccess.canRead())) return;
          var rawProfile = localStorage.getItem('zodiacs.profile.v1');
          var profile = rawProfile ? JSON.parse(rawProfile) : null;
          var charts = profile && profile.version === 1 && Array.isArray(profile.charts)
            ? profile.charts.filter(function (chart) {
                return chart && chart.summary && Array.isArray(chart.summary.bodies)
                  && chart.summary.bodies.some(function (body) { return Number.isFinite(body && body.lon); });
              })
            : [];
          var latestChart = charts.reduce(function (latest, chart) {
            if (!latest) return chart;
            var chartStamp = typeof chart.updatedAt === 'string' ? chart.updatedAt : (chart.createdAt || '');
            var latestStamp = typeof latest.updatedAt === 'string' ? latest.updatedAt : (latest.createdAt || '');
            return chartStamp > latestStamp ? chart : latest;
          }, null);
          var selfCharts = livingChartEnabled
            ? charts.filter(function (chart) { return chart.relationship === 'self'; })
            : [];
          var primaryChart = livingChartEnabled
            ? (selfCharts.length === 1 ? selfCharts[0] : null)
            : latestChart;
          if (livingChartEnabled && charts.length && !primaryChart) {
            document.documentElement.setAttribute('data-living-chart-needs-self', '');
          }
          if (primaryChart) {
            document.documentElement.setAttribute('data-today-saved-chart', '');
            var sun = primaryChart.summary.bodies.find(function (body) {
              return body && body.body === 'Sun' && Number.isFinite(body.lon);
            });
            if (sun && primaryChart.birth && primaryChart.birth.timeKnown === true) {
              var signNames = ['aries', 'taurus', 'gemini', 'cancer', 'leo', 'virgo', 'libra', 'scorpio', 'sagittarius', 'capricorn', 'aquarius', 'pisces'];
              var longitude = ((sun.lon % 360) + 360) % 360;
              var chartSunSign = signNames[Math.floor(longitude / 30)];
              document.documentElement.setAttribute('data-today-chart-sun-sign', chartSunSign);
              /* The quick-read preference differs from the chart's Sun: the
                 chart-source line reserves that sentence before hydration. */
              if (preferredSign && preferredSign !== chartSunSign) {
                document.documentElement.setAttribute('data-today-sign-mismatch', '');
              }
            }
          }
        };
        syncPrivateProfileHint();
        window.addEventListener('zodiacs:profile', syncPrivateProfileHint);
        window.addEventListener('zodiacs:profile-access', syncPrivateProfileHint);
      } catch (error) {}
    })();
  </script>
  <!-- The opening's painted band is the page's largest first-screen picture:
       ask for the one this screen uses as soon as the head is read. -->
  <link slot="head" rel="preload" as="image" type="image/avif" href="/assets/hero/zodiacs-hero-poster-mobile.avif" media="(max-width: 760px)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" type="image/avif" href="/assets/hero/zodiacs-hero-poster.avif" media="(min-width: 761px)" fetchpriority="high" />
  <section
    class="today-page"
    data-edition-content="true"
    data-daily-date={publication.date}
    data-generation-mode={publication.generation.mode}
    data-living-chart-enabled={livingChartEnabled ? '' : undefined}
  >
    <!-- 1. The day in one sentence, with the edition's sky beside it. -->
    <header class="today-hero">
      <div class="today-hero__body">
        <nav class="today-crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page"><span data-edition-current-only>Today</span><span data-edition-dated-only>{publicationLabel}</span></span>
        </nav>
        <p class="kicker today-hero__kicker">{longDate(publication.date)}</p>
        <h1 class="display"><EditionText current="The sky today" editionDate={publication.date} /></h1>
        <p class="today-hero__lede">
          Where every planet is, what each placement traditionally stands for, and what comes next on the calendar.{daySentence && (
            <>{' '}<EditionText current={daySentence} editionDate={publication.date} /></>
          )}
        </p>
        <div class="btn-row today-hero__actions">
          <a class="btn btn--primary btn--lg" href="/transits/">See it against your chart <span class="orb" aria-hidden="true">↗</span></a>
          <a class="btn btn--glass btn--lg" href="#signs"><span><span class="today-cta-sign">Your sign</span><span class="today-cta-chart">Your chart</span><span data-edition-current-only> today</span></span></a>
        </div>
        <p class="reassure today-hero__note">Free · No signup · Positions for noon UTC</p>
      </div>
      <figure class="today-hero__wheel">
        <div class="today-wheel">
          <Wheel
            bodies={daily.bodies.map((body) => ({ body: body.body, lon: body.lon, retrograde: body.retrograde }))}
            aspects={wheelAspects}
            ariaLabel={`The sky at noon UTC on ${publicationLabel}: the Sun, the Moon and the planets in their signs, with the aspects within three degrees of exact`}
          />
          <svg class="today-wheel__moon" viewBox="-24 -24 48 48" aria-hidden="true">
            <circle r="23" fill="#0A0C11" stroke="rgba(198,204,218,0.12)" stroke-width="1" />
            <circle r="18" fill="#1C2130" />
            {todayMoonPath === 'full' && <circle r="18" fill="#E6E2D6" />}
            {todayMoonPath && todayMoonPath !== 'full' && <path d={moonPath(daily.moon.illumination, waxing, 18)} fill="#E6E2D6" />}
          </svg>
        </div>
        <figcaption class="today-legend">
          <span><i class="today-legend__rx">Rx</i>Retrograde</span>
          {(aspectTypes.has('trine') || aspectTypes.has('sextile')) && <span><i class="today-legend__line today-legend__line--easy"></i>Trine or sextile</span>}
          {(aspectTypes.has('square') || aspectTypes.has('opposition')) && <span><i class="today-legend__line today-legend__line--tense"></i>Square or opposition</span>}
          {aspectTypes.has('conjunction') && <span><i class="today-legend__line today-legend__line--joined"></i>Conjunction</span>}
        </figcaption>
      </figure>
    </header>

    <!-- 2. The sky in one line, the same line the home page shows. -->
    <div class="kwrap">
      <div class="ticker-band today-skyline">
        <SkyTicker />
      </div>
    </div>

    <!-- 3. The two lights, in the site's own sign art, and the lunar cycle. -->
    <section class="kwrap today-sec" aria-labelledby="today-lights-heading">
      <div class="section-head--row today-head">
        <div>
          <span class="kicker">Where the day starts</span>
          <h2 id="today-lights-heading" class="h-2">The Sun and the Moon</h2>
          <p>The two lights astrology begins with: where they are today, and what their signs have traditionally stood for.</p>
        </div>
        <a class="textlink only-desktop" href="/moon-phase/">Tonight’s moon, in detail <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <div class="today-lights">
        <article class="today-light" style={`--sign:${sunSign.hue}`}>
          <div class="today-light__art">
            <ArtFrame sign={sun.sign} sizes="(min-width: 761px) 600px, calc(100vw - 40px)" focus="50% 40%" spot="48% 52%" />
            <span class="today-light__tag">Sun · {degreeMinutes(sun.degree)}</span>
          </div>
          <div class="today-light__body">
            <div class="today-light__head"><SignIcon sign={sun.sign} size={46} /><h3 class="h-3">Sun in {sunSign.name}</h3></div>
            <p>{signTagline(sunSign)} {sunNote}</p>
            <p class="kfacts"><span>{signDateRange(sunSign)}</span><span>{cap(sunSign.modality)} {sunSign.element}</span><span class="today-hide-m">Ruled by {sunSign.ruler}</span></p>
          </div>
        </article>
        <article class="today-light" style={`--sign:${moonSign.hue}`}>
          <div class="today-light__art">
            <ArtFrame sign={moon.sign} sizes="(min-width: 761px) 600px, calc(100vw - 40px)" focus="50% 40%" spot="52% 52%" />
            <span class="today-light__tag">Moon · {degreeMinutes(moon.degree)} · {illumination}% lit</span>
          </div>
          <div class="today-light__body">
            <div class="today-light__head"><SignIcon sign={moon.sign} size={46} /><h3 class="h-3">Moon in {moonSign.name}</h3></div>
            <p>{signTagline(moonSign)} {moonNote}</p>
            <p class="kfacts"><span>{phase}</span>{moonAge !== null && <span>{moonAge} days old</span>}<span class="today-hide-m">{cap(moonSign.modality)} {moonSign.element}</span></p>
          </div>
        </article>
      </div>
      <ol class="today-cycle" aria-label="This lunar cycle" style={`--nodes:${cycle.length}`}>
        {cycle.map((node) => (
          <li class:list={{ 'is-now': node.kind === 'now' }}>
            <svg class="today-moon" viewBox="-24 -24 48 48" width="46" height="46" aria-hidden="true">
              <circle r="20" fill="#1C2130" stroke="rgba(198,204,218,0.22)" stroke-width="1" />
              {node.kind === 'full' && <circle r="20" fill="#E6E2D6" />}
              {node.kind === 'now' && todayMoonPath === 'full' && <circle r="20" fill="#E6E2D6" />}
              {node.kind === 'now' && todayMoonPath && todayMoonPath !== 'full' && <path d={todayMoonPath} fill="#E6E2D6" />}
            </svg>
            {node.kind === 'now'
              ? <b><span data-edition-current-only>Today</span><span data-edition-dated-only>{editionShort}</span></b>
              : <b>{node.kind === 'new' ? 'New moon' : 'Full moon'}</b>}
            {node.kind === 'now'
              ? <span>{phase}</span>
              : <span>{shortDate(node.at)}{node.sign && <span class="today-cycle__sign">{signBySlug(node.sign).name}</span>}</span>}
          </li>
        ))}
      </ol>
    </section>

    <!-- 4. The Moon from each Sun sign, and the version that is only yours.
         The island server-renders all twelve notes; a saved chart replaces
         them with its own comparison, and the head below follows the same
         private first-paint hint. -->
    <section class="kwrap today-sec today-signs" id="signs">
      <div class="section-head--row today-head">
        <div class="today-signs__head">
          <span class="kicker">Your sign today</span>
          <h2 class="h-2">The Moon, from your sign</h2>
          <p>Each note comes from one fact: which part of life the {moonSign.name} Moon falls in, counted from your Sun sign. Themes to notice, not instructions.</p>
        </div>
        <div class="today-signs__head today-signs__head--chart">
          <span class="kicker">Only yours</span>
          <h2 class="h-2">Today, against your chart</h2>
          <p>Today’s planets against your own chart.</p>
        </div>
        <a class="textlink only-desktop" href="/horoscopes/">All horoscopes <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <!-- The complete no-chart brief is server-rendered. This island owns all
           of its copy, so it needs neither the full client UI catalog nor eager
           hydration; personalization can wait until the first paint is idle. -->
      <TodayBrief
        client:idle
        editionDate={daily.date}
        bodies={daily.bodies}
        sunSignReadings={sunSignReadings}
        livingChartEnabled={livingChartEnabled}
        livingChartSyncEnabled={livingChartCloudSyncEnabled}
        generatorVersion={publication.rendererVersion}
      />
    </section>

    <!-- 5. Every planet, then the dates ahead as calendar facts, opened by
         the brass orrery: the Sun at the centre, the planets on their arms. -->
    <div class="kwrap today-sec today-art-band">
      <ArtFrame
        class="today-orrery"
        src={artSrc('today-orrery')}
        srcset={artSrcset('today-orrery')}
        sizes="(min-width: 1240px) 1200px, calc(100vw - 40px)"
        width={ART['today-orrery'].width}
        height={ART['today-orrery'].height}
        alt=""
        spot="51% 42%"
        fade
      />
    </div>
    <section class="kwrap today-sec today-split">
      <div>
        <h2 class="h-3">Where the planets are</h2>
        <p class="today-sub">Noon UTC, {publicationLabel}.<span class="only-desktop"> Each body with what it has traditionally stood for.</span></p>
        <ul class="today-ptable">
          {rows.map((row) => (
            <li class:list={['today-prow', { 'is-sun': row.body === 'Sun' }]}>
              <span class="today-pg" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={PLANET_GLYPH[row.body] ?? ''} /></span>
              <span class="today-prow__name"><b>{row.body}</b><small>{cap(topic(row.body))}</small></span>
              <span class="today-prow__sign"><SignIcon sign={row.sign} size={22} />{signBySlug(row.sign).name}</span>
              <span class="today-prow__deg">{row.degree}</span>
              {row.stationToday
                ? <span class="today-pm is-station">{cap(row.stationToday.type)} from {utcClock(row.stationToday.at)} UTC</span>
                : row.body === 'Moon'
                  ? <span class="today-pm is-moon">{phase}</span>
                  : row.retrograde
                    ? <span class="today-pm is-rx">Retrograde</span>
                    : <span class="today-pm">Direct</span>}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="h-3">Coming up in the sky</h2>
        <p class="today-sub">Calendar facts in UTC, so a few fall a day earlier in the Americas.</p>
        <ol class="today-events" data-daily-event-links>
          {coming.map((event) => {
            const date = monthDay(event.at);
            const sign = event.sign ? signBySlug(event.sign) : null;
            return (
              <li class:list={{ 'is-lunation': event.kind === 'lunation' || event.kind === 'eclipse' }} style={sign ? `--sign:${sign.hue}` : undefined}>
                <time datetime={event.at}><span>{date.month}</span><b>{date.day}</b></time>
                <div>
                  {event.path ? <a href={event.path}>{event.title}</a> : <b>{event.title}</b>}
                  <small>{event.detail}</small>
                </div>
                <span class="today-events__ic" aria-hidden="true">
                  {event.kind === 'ingress'
                    ? <SignIcon sign={event.sign} size={24} />
                    : event.kind === 'station' || event.kind === 'aspect'
                      ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={PLANET_GLYPH[event.body] ?? ''} />
                      : <svg class="today-events__moon" viewBox="-24 -24 48 48"><circle r="20" fill="#1C2130" stroke="rgba(198,204,218,0.3)" stroke-width="1.5" />{event.title.startsWith('Full') || (event.kind === 'eclipse' && event.body === 'Moon') ? <circle r="20" fill="#E6E2D6" /> : null}</svg>}
                </span>
              </li>
            );
          })}
        </ol>
        <div class="today-events__foot">
          {eclipseAhead && <span>Next eclipse: {cap(eclipseAhead.kind)} {eclipseAhead.type} eclipse, {shortDate(eclipseAhead.peak, true)}</span>}
          <a class="textlink" href="/sky-calendar/">Full sky calendar <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- 6. Retrogrades on one time axis, the edition marked. -->
    <section class="kwrap today-sec" aria-labelledby="today-rx-heading">
      <div class="section-head--row today-head">
        <div>
          <h2 id="today-rx-heading" class="h-2">Retrogrades, at a glance</h2>
          <p>{retrogradeSummary}</p>
        </div>
        <a class="textlink only-desktop" href="/retrogrades/">All retrograde dates <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <div class="today-rt" role="table" aria-label={`Retrograde periods from ${shortDate(timeline.from, true)} to ${windowEndLabel}`} style={`--today-at:${timeline.todayAt}%`}>
        <div class="today-rt__row today-rt__head" role="row">
          <span class="today-rt__name" role="columnheader"><span class="sr-only">Planet</span></span>
          <div class="today-rt__track today-rt__months" role="columnheader">
            <span class="sr-only">Period</span>
            {timeline.months.map((month, index) => (
              <span
                class:list={['today-rt__month', { 'today-hide-m': month.left <= timeline.todayAt && (timeline.months[index + 1]?.left ?? 100) > timeline.todayAt }]}
                style={`left:${month.left}%`}
                aria-hidden="true"
              >{month.label}</span>
            ))}
            <b class="today-rt__today" aria-hidden="true"><span data-edition-current-only>Today</span><span data-edition-dated-only>{editionShort}</span></b>
          </div>
        </div>
        {timeline.rows.map((row) => (
          <div class="today-rt__row" role="row">
            <div class="today-rt__name" role="rowheader">
              <span class="today-rt__g" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={PLANET_GLYPH[row.planet] ?? ''} /></span>
              <span>
                <b>{row.planet}</b>
                <small class:list={{ 'is-on': row.state === 'now' }}>
                  {row.state === 'now' && <span class="today-hide-m">Retrograde · </span>}
                  {shortDate(row.from, periodYear(row.from))} to {shortDate(row.to, periodYear(row.to))}{row.state === 'ended' && ', now direct'}
                </small>
              </span>
            </div>
            <div class="today-rt__track" role="cell">
              <span class="sr-only">{row.state === 'now' ? 'Retrograde now' : row.state === 'upcoming' ? 'Coming up' : 'Ended'}</span>
              <i class:list={['today-rt__bar', `is-${row.state}`, { 'is-clip-start': row.clippedStart, 'is-clip-end': row.clippedEnd }]} style={`left:${row.left}%;width:${row.width}%`}></i>
            </div>
          </div>
        ))}
      </div>
      <div class="today-rt__key" aria-hidden="true">
        <span><i></i>Retrograde now</span>
        <span><i class="is-upcoming"></i>Coming up</span>
        <span><i class="is-ended"></i>Ended</span>
        <span><i class="is-today"></i><span><span data-edition-current-only>Today, </span>{editionShort}</span></span>
      </div>
      <div class="today-note">
        <span class="kicker">What retrograde means</span>
        <p>Seen from Earth, a planet sometimes appears to slow, stop and drift backward against the stars. Nothing changes in its real orbit. Astrologers have long read these stretches as a time for review: the planet’s themes are revisited rather than begun.</p>
      </div>
    </section>

    <!-- 7. The closest angles in this sky, each with what it has
         traditionally been read as. -->
    {aspectCards.length > 0 && (
      <section class="kwrap today-sec" aria-labelledby="today-aspects-heading">
        <div class="section-head--row today-head">
          <div>
            <h2 id="today-aspects-heading" class="h-2">Today’s closest aspects</h2>
            <p>
              Aspects are the angles between planets.
              {allAspects.length > aspectCards.length
                ? ` ${cap(numberWord(allAspects.length))} are within three degrees of exact at noon UTC; these are the ${numberWord(aspectCards.length)} closest.`
                : ` ${allAspects.length === 1 ? 'This one is' : `These ${numberWord(allAspects.length)} are`} within three degrees of exact at noon UTC.`}
            </p>
          </div>
          <a class="textlink only-desktop" href="/learn/aspects/">How aspects work <span class="arr" aria-hidden="true">→</span></a>
        </div>
        <div class="today-asps">
          {aspectCards.map((aspect) => {
            const a = bodyOf(aspect.a);
            const b = bodyOf(aspect.b);
            return (
              <article class="kcard today-asp">
                <div class="today-asp__g" aria-hidden="true">
                  <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={PLANET_GLYPH[aspect.a] ?? ''} /></span>
                  <svg class={`today-asp__type is-${aspect.type}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={ASPECT_GLYPH[aspect.type] ?? ''} />
                  <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={PLANET_GLYPH[aspect.b] ?? ''} /></span>
                </div>
                <h3 class="h-4">{aspect.a} {aspect.type} {aspect.b}</h3>
                <p class="today-asp__pos">{degreeMinutes(a.degree)} {signBySlug(a.sign).name}{a.retrograde ? ' Rx' : ''} · {degreeMinutes(b.degree)} {signBySlug(b.sign).name}{b.retrograde ? ' Rx' : ''}</p>
                <p>{definition(aspect.type)} {cap(named(aspect.a))} has traditionally stood for {topic(aspect.a)}, {named(aspect.b)} for {topic(aspect.b)}.</p>
                <span class:list={['today-asp__tag', { 'is-exact': aspect.exactAt }]}>
                  {aspect.exactAt ? `Exact at ${utcClock(aspect.exactAt)} UTC` : `${degreeMinutes(aspect.orb)} from exact`}
                </span>
              </article>
            );
          })}
        </div>
      </section>
    )}

    <!-- 8. Go further, and questions for Guide. -->
    <section class="kwrap today-sec" aria-labelledby="today-further-heading">
      <div class="section-head--row today-head">
        <div>
          <h2 id="today-further-heading" class="h-2">Go further</h2>
