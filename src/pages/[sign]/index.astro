---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SignIcon from '../../components/SignIcon.astro';
import FactTable from '../../components/FactTable.astro';
import HeritageTimeline from '../../components/HeritageTimeline.astro';
import CollectBand from '../../components/CollectBand.astro';
import RaceRamp from '../../components/RaceRamp.astro';
import Faq from '../../components/Faq.astro';
import ShareRow from '../../components/ShareRow.astro';
import GuideHoroscopeBand from '../../components/GuideHoroscopeBand.astro';
import GuideProfileHook from '../../components/GuideProfileHook.astro';
import { SIGNS, SIGN_SLUGS, signBySlug, ELEMENT_LABEL } from '../../lib/signs';
import { pairSlug } from '../../lib/compat';
import { heritage } from '../../lib/legacy/sign-lore';
import { EDITOR_AUTHOR } from '../../lib/editorial';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  const slugs = guides.map((g) => g.data.sign).sort();
  if (slugs.length !== 12 || JSON.stringify(slugs) !== JSON.stringify([...SIGN_SLUGS].sort())) {
    throw new Error(`Guides collection must cover exactly the 12 signs; found: ${slugs.join(', ')}`);
  }
  return guides.map((guide) => ({ params: { sign: guide.data.sign }, props: { guide } }));
}

const { guide } = Astro.props;
const sign = signBySlug(guide.data.sign);
const lore = heritage(sign.slug);
const { Content } = await render(guide);

const idx = SIGNS.findIndex((s) => s.slug === sign.slug);
const prev = SIGNS[(idx + 11) % 12];
const next = SIGNS[(idx + 1) % 12];
const siblings = SIGNS.filter((s) => s.element === sign.element && s.slug !== sign.slug);

const jsonLd = [
  {
    '@type': 'Article',
    headline: guide.data.title,
    description: guide.data.description,
    url: `https://zodiacs.org/${sign.slug}/`,
    datePublished: guide.data.published.toISOString(),
    dateModified: guide.data.updated.toISOString(),
    author: EDITOR_AUTHOR,
    publisher: { '@id': 'https://zodiacs.org/#org' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://zodiacs.org/${sign.slug}/` },
    inLanguage: 'en',
    image: `https://zodiacs.org/assets/og/v2/sign/${sign.slug}.png`,
    about: { '@type': 'Thing', name: `${sign.name} (astrology)` },
    citation: guide.data.sources.map((source) => source.href
      ? { '@type': 'CreativeWork', name: source.label, url: source.href }
      : source.label),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Zodiac signs', item: 'https://zodiacs.org/learn/' },
      { '@type': 'ListItem', position: 3, name: sign.name, item: `https://zodiacs.org/${sign.slug}/` },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: guide.data.faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  preloadMonoFont
  inlineCriticalCss
  title={guide.data.title}
  description={guide.data.description}
  path={`/${sign.slug}/`}
  image={`/assets/og/v2/sign/${sign.slug}.png`}
  imageAlt={`${sign.name} — sign guide on Zodiacs.org`}
  type="article"
  jsonLd={jsonLd}
  sources={guide.data.sources}
>
  <article style={`--sign:${sign.hue}`}>
    <header class="guide-hero container">
      {/* No reveal on the masthead: it is the LCP and must paint before any
          script runs — the RU release set this pattern. */}
      <div class="guide-hero__id">
        <SignIcon sign={sign.slug} size={200} loading="eager" fetchPriority="high" webpOnly class="guide-hero__icon" />
        <div>
          <span class="eyebrow">{sign.glyph} · {ELEMENT_LABEL[sign.element]} · {sign.dates}</span>
          <h1>{sign.name}</h1>
          <p class="guide-hero__essence">{sign.essence}</p>
          <div class="guide-hero__ctas">
            <a class="btn btn--primary" href="/birth-chart/"><span>Get your free birth chart</span><span class="orb">↗</span></a>
            <a class="btn btn--ghost" href="/moon-sign/"><span>Find your moon sign</span></a>
          </div>
        </div>
      </div>
    </header>

    <div class="container guide-grid">
      <div class="guide-main">
        <div class="reveal">
          <GuideHoroscopeBand signName={sign.name} slug={sign.slug} />
        </div>

        <div class="prose reveal">
          <Content />
        </div>

        <div class="guide-band reveal">
          <CollectBand signName={sign.name} slug={sign.slug} />
          <RaceRamp signName={sign.name} gap="10px" />
        </div>

        <section class="guide-heritage reveal">
          <h2>Myth, history &amp; the long record</h2>
          <p class="guide-heritage__lede">{lore.lede}</p>
          {lore.paragraphs.map((p) => <p class="guide-heritage__p">{p}</p>)}
          <HeritageTimeline lore={lore} hue={sign.hue} />
        </section>

        <section class="guide-compat reveal">
          <h2>{sign.name} compatibility, at a glance</h2>
          <div class="guide-compat__rows">
            <div class="guide-compat__row">
              <span class="mono--label">Easeful with</span>
              <div class="guide-compat__chips">
                {guide.data.compat.easeful.map((slug) => {
                  const s = signBySlug(slug);
                  return (
                    <a class="chip" href={`/compatibility/${pairSlug(sign.slug, s.slug)}/`} style={`--sign:${s.hue}`}>
                      <SignIcon sign={s.slug} size={18} class="chip__icon" /> {sign.name} &amp; {s.name}
                    </a>
                  );
                })}
              </div>
            </div>
            <div class="guide-compat__row">
              <span class="mono--label">Charged with</span>
              <div class="guide-compat__chips">
                {guide.data.compat.charged.map((slug) => {
                  const s = signBySlug(slug);
                  return (
                    <a class="chip" href={`/compatibility/${pairSlug(sign.slug, s.slug)}/`} style={`--sign:${s.hue}`}>
                      <SignIcon sign={s.slug} size={18} class="chip__icon" /> {sign.name} &amp; {s.name}
                    </a>
                  );
                })}
              </div>
            </div>
          </div>
          <p class="guide-compat__note">
            Sun-sign chemistry is the first sentence, not the story — for the
            whole thing, <a href="/compatibility/">compare two full charts</a>.
          </p>
        </section>

        <section class="guide-placements reveal">
          <h2>Planets in {sign.name}</h2>
          <p class="guide-placements__note">
            The Sun is one of ten planets that can wear this sign — each
            reads differently.
          </p>
          <div class="guide-placements__chips">
            {['Sun', 'Moon', 'Mercury', 'Venus', 'Mars', 'Jupiter', 'Saturn', 'Uranus', 'Neptune', 'Pluto'].map((p) => (
              <a class="chip" href={`/learn/placements/${p.toLowerCase()}-in-${sign.slug}/`} style={`--sign:${sign.hue}`}>
                {p} in {sign.name}
              </a>
            ))}
          </div>
        </section>

        <section class="reveal">
          <Faq items={guide.data.faq} heading={`${sign.name}, asked and answered`} />
        </section>

        <ShareRow text={`${sign.name} — the full guide`} url={`https://zodiacs.org/${sign.slug}/`} />
        <GuideProfileHook signName={sign.name} slug={sign.slug} />
      </div>

      <aside class="guide-side">
        <div class="shell">
          <div class="core guide-side__core">
            <span class="mono--label">The essentials</span>
            <FactTable sign={sign} star={lore.principalStar} babylonianRecord={lore.babylonianRecord} />
            <a class="guide-side__bdays" href="/birthday/">Look up your exact birthday →</a>
          </div>
        </div>
        <div class="guide-side__cta shell tinted">
          <div class="core tinted guide-side__cta-core">
            <strong>Is {sign.name} your sun sign?</strong>
            <p>Get your birth chart — moon, rising, planets, and all — then save what matters.</p>
            <a class="btn btn--primary" href="/birth-chart/"><span>Get your free birth chart</span><span class="orb">↗</span></a>
          </div>
        </div>
      </aside>
    </div>

    <nav class="container guide-nav reveal" aria-label="More signs">
      <a class="guide-nav__adjacent" href={`/${prev.slug}/`} style={`--sign:${prev.hue}`}>
        <span class="mono--label">← Previous</span>
        <span class="guide-nav__name"><SignIcon sign={prev.slug} size={24} /> {prev.name}</span>
      </a>
      <div class="guide-nav__siblings">
        <span class="mono--label">Fellow {ELEMENT_LABEL[sign.element].toLowerCase()} signs</span>
        <div>
          {siblings.map((s) => (
            <a class="chip" href={`/${s.slug}/`} style={`--sign:${s.hue}`}>
              <SignIcon sign={s.slug} size={18} class="chip__icon" /> {s.name}
            </a>
          ))}
        </div>
      </div>
      <a class="guide-nav__adjacent guide-nav__adjacent--next" href={`/${next.slug}/`} style={`--sign:${next.hue}`}>
        <span class="mono--label">Next →</span>
        <span class="guide-nav__name"><SignIcon sign={next.slug} size={24} /> {next.name}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .guide-hero { padding-block: clamp(20px, 5vw, 56px) clamp(24px, 4vw, 40px); }
  .guide-hero__id {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  @media (min-width: 760px) {
    .guide-hero__id { flex-direction: row; align-items: center; gap: 44px; }
  }
  .guide-hero :global(.guide-hero__icon) {
    width: clamp(120px, 18vw, 200px);
    filter: drop-shadow(0 18px 44px color-mix(in oklab, var(--sign) 30%, transparent));
  }
  .guide-hero h1 {
    margin: 14px 0 12px;
    font-family: var(--font-serif);
    font-size: var(--text-hero);
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 0.96;
    font-variant-numeric: oldstyle-figures;
  }
  .guide-hero__essence {
    margin: 0 0 22px;
    max-width: 44ch;
    color: var(--muted);
    font-size: var(--text-lg);
    text-wrap: pretty;
  }
  .guide-hero__ctas { display: flex; flex-wrap: wrap; gap: 10px; }

  .guide-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 5vw, 56px);
    padding-bottom: clamp(32px, 6vw, 64px);
  }
  @media (min-width: 960px) {
    .guide-grid { grid-template-columns: minmax(0, 1fr) 340px; align-items: start; }
    .guide-side { position: sticky; top: 96px; }
  }
  .guide-main { display: grid; gap: clamp(28px, 5vw, 48px); min-width: 0; }
  .guide-band { margin-bottom: -6px; }

  .guide-heritage h2, .guide-compat h2 {
    margin: 0 0 16px;
    font-size: var(--text-xl);
    font-weight: 620;
    letter-spacing: -0.02em;
  }
  .guide-heritage__lede {
    margin: 0 0 14px;
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--text);
    max-width: 62ch;
    text-wrap: pretty;
  }
  .guide-heritage__p {
    margin: 0 0 14px;
    max-width: 66ch;
    color: var(--text-2);
    line-height: 1.7;
  }
  .guide-heritage :global(.timeline) { margin-top: 22px; }

  /* Label → chips as an aligned two-column set: both labels share one column
     so the two rows line up, chips flow in the second column (the wb__three
     treatment). display:contents lets each row's parts join the shared grid. */
  .guide-compat__rows {
    display: grid;
    grid-template-columns: max-content 1fr;
    align-items: baseline;
    gap: 12px 16px;
    padding: 6px 0;
  }
  .guide-compat__row { display: contents; }
  .guide-compat__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .guide-compat__note { margin: 8px 0 0; font-size: var(--text-sm); color: var(--faint); }

  .guide-placements h2 {
    margin: 0 0 8px;
    font-size: var(--text-xl);
    font-weight: 620;
    letter-spacing: -0.02em;
  }
  .guide-placements__note { margin: 0 0 14px; font-size: var(--text-sm); color: var(--faint); }
  .guide-placements__chips { display: flex; flex-wrap: wrap; gap: 8px; }

  .guide-side { display: grid; gap: 14px; }
  .guide-side__core { padding: 20px; display: grid; gap: 12px; }
  .guide-side__bdays { justify-self: start; font-size: 12.5px; color: var(--muted); text-decoration: none; border-bottom: 1px solid var(--hair-2); }
  .guide-side__bdays:hover { color: var(--text); border-bottom-color: var(--sign); }
  .guide-side__cta-core { padding: 22px 20px; display: grid; gap: 10px; }
  .guide-side__cta-core strong { font-size: var(--text-lg); letter-spacing: -0.01em; }
  .guide-side__cta-core p { margin: 0; font-size: var(--text-sm); color: var(--text-2); }
  .guide-side__cta-core .btn { width: fit-content; }

  .guide-nav {
    display: grid;
    gap: 18px;
    padding-block: clamp(20px, 4vw, 36px) clamp(28px, 5vw, 48px);
    border-top: 1px solid var(--hair-1);
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) {
    .guide-nav { grid-template-columns: 1fr auto 1fr; align-items: center; }
  }
  .guide-nav__adjacent { text-decoration: none; display: grid; gap: 8px; }
  .guide-nav__adjacent--next { text-align: end; justify-items: end; }
  .guide-nav__name {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text);
  }
  .guide-nav__siblings { display: grid; gap: 10px; justify-items: center; text-align: center; }
  .guide-nav__siblings > div { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 3px 10px 3px 4px;
    border-radius: var(--r-full);
    border: 1px solid color-mix(in oklab, var(--sign, var(--accent)) 35%, transparent);
    background: color-mix(in oklab, var(--sign, var(--accent)) 9%, transparent);
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    transition: background var(--dur-1) var(--ease);
  }
  .chip:hover { background: color-mix(in oklab, var(--sign, var(--accent)) 16%, transparent); }
  .chip :global(.chip__icon img) { border-radius: 50%; }
</style>
