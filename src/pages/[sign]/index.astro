---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArtFrame from '../../components/ArtFrame.astro';
import SignIcon from '../../components/SignIcon.astro';
import SignGuideHero from '../../components/SignGuideHero.astro';
import SignGuideFacts from '../../components/SignGuideFacts.astro';
import type { SignGuideFact } from '../../components/SignGuideFacts.astro';
import HeritageTimeline from '../../components/HeritageTimeline.astro';
import CollectBand from '../../components/CollectBand.astro';
import ShareRow from '../../components/ShareRow.astro';
import GuideHoroscopeBand from '../../components/GuideHoroscopeBand.astro';
import GuideProfileHook from '../../components/GuideProfileHook.astro';
import GuidePull from '../../components/guide/GuidePull.astro';
import GuideEdges from '../../components/guide/GuideEdges.astro';
import GuideEdge from '../../components/guide/GuideEdge.astro';
import GuidePartners from '../../components/guide/GuidePartners.astro';
import GuideLoveClose from '../../components/guide/GuideLoveClose.astro';
import GuidePlaces from '../../components/guide/GuidePlaces.astro';
import GuidePlace from '../../components/guide/GuidePlace.astro';
import GuideWhere from '../../components/guide/GuideWhere.astro';
import programData from '../../data/horoscope-program.json';
import { SIGNS, SIGN_SLUGS, signBySlug, ELEMENT_LABEL, MODALITY_LABEL } from '../../lib/signs';
import { signDateRange, signTagline } from '../../lib/sign-display';
import { guideLede, heritage, plainDashes } from '../../lib/legacy/sign-lore';
import { guideFacts, guideReadingMinutes, signFigure, signOrdinal } from '../../lib/guide-facts';
import { EDITOR_AUTHOR } from '../../lib/editorial';
import { SIGN_GUIDE_HERO_SIZES, signArtSrc, signArtSrcset } from '../../lib/sign-art';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  const slugs = guides.map((g) => g.data.sign).sort();
  if (slugs.length !== 12 || JSON.stringify(slugs) !== JSON.stringify([...SIGN_SLUGS].sort())) {
    throw new Error(`Guides collection must cover exactly the 12 signs; found: ${slugs.join(', ')}`);
  }
  return guides.map((guide) => ({ params: { sign: guide.data.sign }, props: { guide } }));
}

const { guide } = Astro.props;
const sign = signBySlug(guide.data.sign);
const lore = heritage(sign.slug);
const { Content, headings } = await render(guide);

const idx = SIGNS.findIndex((s) => s.slug === sign.slug);
const prev = SIGNS[(idx + 11) % 12];
const next = SIGNS[(idx + 1) % 12];
const siblings = SIGNS.filter((s) => s.element === sign.element && s.slug !== sign.slug);
const facts = guideFacts(sign, lore.principalStar);
const figure = signFigure(lore.epithet);
const elementWord = ELEMENT_LABEL[sign.element].toLowerCase();
const rulerLine = sign.classicRuler ? `${sign.ruler} (traditionally ${sign.classicRuler})` : sign.ruler;
const minutes = guideReadingMinutes(guide.body ?? '', [lore.lede, ...lore.paragraphs]);
// The daily card quotes this edition; Base dates its relative words if the
// deploy outlives the day (see GuideHoroscopeBand).
const editionDate = (programData as { anchorDate: string }).anchorDate;

const factRows: SignGuideFact[] = [
  { label: 'Dates', value: signDateRange(sign), note: 'Edges shift a day in some years.', link: { href: '/birthday/', label: 'Check yours' } },
  { label: 'Element', value: ELEMENT_LABEL[sign.element], note: `With ${siblings[0].name} and ${siblings[1].name}` },
  { label: 'Modality', value: MODALITY_LABEL[sign.modality], note: facts.modalityNote },
  { label: 'Ruling planet', value: sign.ruler, glyph: sign.ruler, note: facts.rulerNote },
  { label: 'Polarity', value: sign.polarity === 'day' ? 'Day (yang)' : 'Night (yin)', note: facts.polarityNote },
  { label: 'Principal star', value: lore.principalStar.name, note: facts.starNote },
];

const contents = [
  ...headings.filter((h) => h.depth === 2).map((h) => ({ href: `#${h.slug}`, label: h.text })),
  { href: '#history', label: 'Myth and history' },
  { href: '#questions', label: 'Questions' },
];

const mdxComponents = {
  GuidePull,
  GuideEdges,
  GuideEdge,
  GuidePartners,
  GuideLoveClose,
  GuidePlaces,
  GuidePlace,
  GuideWhere,
};

const jsonLd = [
  {
    '@type': 'Article',
    headline: guide.data.title,
    description: guide.data.description,
    url: `https://zodiacs.org/${sign.slug}/`,
    datePublished: guide.data.published.toISOString(),
    dateModified: guide.data.updated.toISOString(),
    author: EDITOR_AUTHOR,
    publisher: { '@id': 'https://zodiacs.org/#org' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://zodiacs.org/${sign.slug}/` },
    inLanguage: 'en',
    image: `https://zodiacs.org/assets/og/v2/sign/${sign.slug}.png`,
    about: { '@type': 'Thing', name: `${sign.name} (astrology)` },
    citation: guide.data.sources.map((source) => source.href
      ? { '@type': 'CreativeWork', name: source.label, url: source.href }
      : source.label),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Zodiac signs', item: 'https://zodiacs.org/learn/' },
      { '@type': 'ListItem', position: 3, name: sign.name, item: `https://zodiacs.org/${sign.slug}/` },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: guide.data.faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---
<Base
  inlineCriticalCss
  title={guide.data.title}
  description={guide.data.description}
  path={`/${sign.slug}/`}
  image={`/assets/og/v2/sign/${sign.slug}.png`}
  imageAlt={`${sign.name}, sign guide on Zodiacs.org`}
  type="article"
  jsonLd={jsonLd}
  sources={guide.data.sources}
  editionDate={editionDate}
>
  {/* The hero art is the LCP: announce it before the inlined stylesheets
      finish streaming, with the same candidates and sizes as the <img>. */}
  <link
    slot="head"
    rel="preload"
    as="image"
    href={signArtSrc(sign.slug, 1200)}
    imagesrcset={signArtSrcset(sign.slug)}
    imagesizes={SIGN_GUIDE_HERO_SIZES}
    fetchpriority="high"
  />
  <article class="guide" style={`--sign:${sign.hue};--hue:${sign.hue}`}>
    {/* No reveal on the masthead: the art is the LCP and must paint before
        any script runs. */}
    <SignGuideHero
      sign={sign.slug}
      title={sign.name}
      kicker={`The ${signOrdinal(idx)} sign of the zodiac`}
      line={signTagline(sign)}
      sub={`The Sun sign for birthdays from ${facts.longRange}. ${MODALITY_LABEL[sign.modality]} ${elementWord}, ruled by ${rulerLine}.`}
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Signs', href: '/learn/' }, { label: sign.name }]}
      credit={`${figure}, from the Zodiacs sign art`}
    >
      <a class="btn btn--primary btn--lg" href={`/horoscopes/${sign.slug}/`}><span>Today’s {sign.name} horoscope</span><span class="orb" aria-hidden="true">↗</span></a>
      <a class="btn btn--glass btn--lg" href="/birth-chart/"><span>Get your free birth chart</span></a>
    </SignGuideHero>

    <div class="kwrap">
      <SignGuideFacts facts={factRows} label={`${sign.name} essentials`} />

      <GuideHoroscopeBand signName={sign.name} slug={sign.slug} />

      <div class="guide-read">
        <div class="guide-rail">
          <nav class="guide-rail__nav" aria-label="On this page">
            <p class="guide-rail__title">On this page</p>
            <ol>
              {contents.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            </ol>
          </nav>
          <div class="guide-rail__meta">
            <span>A {minutes} minute read</span>
            <GuideProfileHook signName={sign.name} slug={sign.slug} />
            <ShareRow text={`${sign.name}, the full guide`} url={`https://zodiacs.org/${sign.slug}/`} />
          </div>
        </div>

        <div class="guide-main">
          <div class="prose guide-prose">
            <Content components={mdxComponents} />
          </div>

          <section class="guide-history" id="history" aria-labelledby="guide-history-title">
            <h2 class="h-2" id="guide-history-title">Myth, history, and the long record</h2>
            <p class="guide-history__lede">{guideLede(lore.lede)}</p>
            <div class="guide-history__prose">
              {lore.paragraphs.map((p) => <p>{plainDashes(p)}</p>)}
            </div>
            <div class="guide-history__figs">
              <figure class="guide-history__fig">
                <ArtFrame
                  sign={sign.slug}
                  class="guide-history__detail"
                  src={`/assets/sign-art/${sign.slug}-720.webp`}
                  width={720}
                  height={480}
                />
                <figcaption>{figure}, as the Zodiacs sign art paints it.</figcaption>
              </figure>
              <figure class="guide-history__fig guide-history__stars">
                <div class="guide-history__frame">
                  <img
                    src={`/assets/constellations/${sign.slug}.svg`}
                    width="720"
                    height="460"
                    loading="lazy"
                    decoding="async"
                    alt={`Map of the brighter ${sign.name} constellation stars, with ${lore.principalStar.name} highlighted`}
                  />
                </div>
                <figcaption>
                  The brighter stars of {sign.name}, plotted from catalogue positions, with {lore.principalStar.name} highlighted.
                  The lines are a reading guide, not official constellation boundaries.
                  Star data: <a href="https://github.com/astronexus/HYG-Database" rel="noopener noreferrer">HYG Database v4.0</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener noreferrer">CC BY-SA 4.0</a>.
                </figcaption>
              </figure>
            </div>
            <HeritageTimeline lore={lore} hue={sign.hue} />
          </section>
        </div>
      </div>
    </div>

    <section class="guide-questions" id="questions" aria-labelledby="guide-questions-title">
      <div class="kwrap qa">
        <div>
          <h2 class="h-2" id="guide-questions-title">{sign.name}, asked and answered</h2>
          <p>Born near the edge of the dates? <a href="/birthday/">Look up your exact birthday</a>.</p>
        </div>
        <div class="kfaq">
          {guide.data.faq.map(({ q, a }, index) => (
            <details open={index === 0}>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="guide-wheel" aria-labelledby="guide-wheel-title">
      <div class="kwrap">
        <div class="section-head--row guide-wheel__head">
          <div>
            <h2 class="h-2" id="guide-wheel-title">Keep reading the wheel</h2>
            <p>The sign before {sign.name}, the sign after, and the other ten.</p>
          </div>
          <a class="textlink only-desktop" href="/learn/zodiac-dates/">All zodiac dates <span class="arr" aria-hidden="true">→</span></a>
        </div>

        <nav class="guide-neighbours" aria-label="Neighbouring signs">
          {[{ s: prev, rel: 'prev', kicker: `Before ${sign.name}`, arrow: '←' }, { s: next, rel: 'next', kicker: `After ${sign.name}`, arrow: '→' }].map(({ s, rel, kicker, arrow }) => (
            <a class="guide-nb" href={`/${s.slug}/`} rel={rel} style={`--sign:${s.hue}`}>
              <ArtFrame
                sign={s.slug}
                class="guide-nb__art"
                src={`/assets/sign-art/${s.slug}-720.webp`}
                width={720}
                height={480}
                alt=""
                spot="62% 50%"
              />
              <span class="guide-nb__body">
                <span>
                  <span class="kicker">{kicker}</span>
                  <span class="h-3 guide-nb__name"><SignIcon sign={s.slug} size={34} />{s.name}</span>
                  <span class="guide-nb__line">{signDateRange(s)}. {signTagline(s)}</span>
                </span>
                <span class="guide-nb__go" aria-hidden="true">{arrow}</span>
              </span>
            </a>
          ))}
        </nav>

        <nav class="guide-wheelrow" aria-label="All twelve sign guides">
          {SIGNS.map((s) => (
            <a href={`/${s.slug}/`} aria-current={s.slug === sign.slug ? 'page' : undefined} style={`--sign:${s.hue}`}>
              <SignIcon sign={s.slug} size={40} />
              <b>{s.name}</b>
              <small>{s.slug === sign.slug ? 'You are here' : signDateRange(s)}</small>
            </a>
          ))}
        </nav>

        <div class="guide-siblings">
          <span class="guide-siblings__label">Fellow {elementWord} signs:</span>
          {siblings.map((s) => (
            <a class="pill" href={`/${s.slug}/`}><SignIcon sign={s.slug} size={22} />{s.name}</a>
          ))}
        </div>

        <div class="guide-collect">
          <CollectBand signName={sign.name} slug={sign.slug} />
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  /* ── Reading column with its contents rail ───────────────────── */
  .guide-read {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 88px;
    margin-top: clamp(64px, 7vw, 104px);
  }
  .guide-rail { position: sticky; top: 96px; align-self: start; }
  .guide-rail__title { margin: 0 0 10px; font-size: 13px; font-weight: 600; color: var(--ink-1); }
  .guide-rail ol { margin: 0; padding: 0; list-style: none; border-left: 1px solid var(--hair-2); }
  .guide-rail li a {
    display: block;
    margin-left: -1px;
    padding: 7px 0 7px 16px;
    border-left: 2px solid transparent;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--muted);
    text-decoration: none;
  }
  .guide-rail li a:hover { color: var(--ink-0); }
  .guide-rail li a:focus-visible { color: var(--ink-0); border-left-color: var(--hue); }
  .guide-rail__meta {
    display: grid;
    gap: 14px;
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid var(--hair-1);
    font-size: 13.5px;
    color: var(--muted);
  }

  .guide-main { min-width: 0; }

  /* The guide's own text, set as a feature. */
  .guide-prose { max-width: none; }
  .guide-prose > :global(p) { max-width: 64ch; }
  .guide-prose > :global(p:not(h2 ~ *)) { font-size: 1.1875rem; line-height: 1.66; color: var(--ink-1); }
  .guide-prose > :global(p:first-child::first-letter) {
    float: left;
    padding: 8px 8px 0 0;
    font-family: var(--font-serif);
    font-size: 4.6em;
    line-height: 0.82;
    color: var(--hue);
  }
  .guide-prose > :global(h2) {
    margin: clamp(64px, 6.5vw, 96px) 0 20px;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 1.5rem + 1.7vw, 2.8rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.005em;
    color: var(--ink-0);
  }
  .guide-prose > :global(h2:first-of-type) { margin-top: 56px; }
  .guide-prose > :global(.guide-pull) {
    max-width: 620px;
    margin: 36px 0;
    padding: 4px 0 4px 28px;
    border-inline-start: 2px solid var(--hue);
    font-style: normal;
  }
  .guide-prose > :global(.guide-pull p) { font-size: clamp(1.7rem, 1.2rem + 1.4vw, 2.3rem); line-height: 1.16; }

  /* ── History ─────────────────────────────────────────────────── */
  .guide-history { margin-top: clamp(64px, 6.5vw, 96px); }
  .guide-history .h-2 { margin: 0 0 20px; font-size: clamp(2rem, 1.5rem + 1.7vw, 2.8rem); line-height: 1.05; }
  .guide-history__lede {
    margin: 0;
    max-width: 40ch;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.7rem);
    line-height: 1.38;
    color: var(--ink-0);
    text-wrap: pretty;
  }
  .guide-history__prose { margin-top: 22px; }
  .guide-history__prose p { margin: 0 0 1.05em; max-width: 64ch; font-size: 1.0625rem; line-height: 1.72; color: var(--text-2); text-wrap: pretty; }
  .guide-history__figs { display: grid; grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr); gap: 16px; margin-top: 36px; }
  .guide-history__fig { margin: 0; display: flex; flex-direction: column; }
  .guide-history__fig :global(.guide-history__detail) { aspect-ratio: 4 / 5; }
  .guide-history__fig :global(.guide-history__detail > img) { object-position: 52% 50%; transform: scale(1.15); transform-origin: 52% 52%; }
  .guide-history__frame {
    flex: 1;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-lg);
    background: #090b10;
  }
  .guide-history__frame img { display: block; width: 100%; height: auto; }
  .guide-history figcaption { margin-top: 10px; max-width: 56ch; font-size: 12.5px; line-height: 1.5; color: var(--faint); }
  .guide-history figcaption a { color: var(--muted); text-decoration: underline; text-decoration-color: var(--hair-2); text-underline-offset: 3px; }

  /* ── Questions ───────────────────────────────────────────────── */
  .guide-questions { padding-top: clamp(64px, 8vw, 120px); }
  .guide-questions .h-2 { font-size: clamp(2.1rem, 1.5rem + 2.8vw, 3.2rem); }
  .guide-questions a { text-decoration: underline; text-decoration-color: var(--hair-3); text-underline-offset: 3px; }

  /* ── Keep reading the wheel ──────────────────────────────────── */
  .guide-wheel { padding-block: clamp(64px, 8vw, 120px) clamp(48px, 6vw, 88px); }
  .guide-wheel__head { margin-bottom: clamp(28px, 4vw, 48px); }
  .guide-wheel__head > div { max-width: 60ch; }
  .guide-wheel__head .h-2 { color: var(--ink-0); }
  .guide-neighbours { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .guide-nb {
    position: relative;
    isolation: isolate;
    display: block;
    min-height: 340px;
    overflow: hidden;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-xl);
    color: var(--ink-0);
    text-decoration: none;
  }
  .guide-nb :global(.guide-nb__art) { position: absolute; inset: 0; z-index: -1; border-radius: 0; }
  .guide-nb :global(.guide-nb__art::after) {
    background:
      radial-gradient(ellipse 50% 60% at 62% 50%, transparent 0 34%, rgba(6, 7, 9, 0.45) 74%, rgba(6, 7, 9, 0.85) 100%),
      linear-gradient(0deg, rgba(6, 7, 9, 0.92) 0%, rgba(6, 7, 9, 0) 58%);
  }
  .guide-nb__body { position: absolute; left: 28px; right: 28px; bottom: 26px; display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; }
  .guide-nb__body > span:first-child { display: grid; }
  .guide-nb .kicker { margin: 0; font-size: 1rem; color: var(--ink-1); }
  .guide-nb__name { display: flex; align-items: center; gap: 12px; margin-top: 2px; font-size: 2.2rem; color: var(--ink-0); }
  .guide-nb__name :global(.sign-icon) { width: 34px; }
  .guide-nb__line { margin-top: 6px; max-width: 40ch; font-size: 0.9375rem; line-height: 1.5; color: var(--ink-1); }
  .guide-nb__go {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(238, 241, 247, 0.4);
    background: rgba(10, 12, 17, 0.5);
    font-size: 16px;
    color: var(--ink-0);
    transition: transform var(--dur-1) var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .guide-nb:hover .guide-nb__go { transform: translateX(2px); }
    .guide-nb[rel='prev']:hover .guide-nb__go { transform: translateX(-2px); }
  }
  @media (prefers-reduced-motion: reduce) { .guide-nb__go { transition: none; } }

  .guide-wheelrow { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 8px; margin-top: 20px; }
  .guide-wheelrow a {
    display: grid;
    justify-items: center;
    gap: 8px;
    padding: 16px 2px 12px;
    border: 1px solid var(--hair-1);
    border-radius: 16px;
    background: rgba(198, 204, 218, 0.02);
    color: var(--ink-0);
    text-align: center;
    text-decoration: none;
  }
  .guide-wheelrow :global(.sign-icon) { width: 40px; }
  .guide-wheelrow b { font-weight: 550; font-size: 0.875rem; }
  .guide-wheelrow small { margin-top: -6px; font-size: 10.5px; line-height: 1.3; letter-spacing: -0.01em; white-space: nowrap; color: var(--faint); }
  .guide-wheelrow a[aria-current='page'] {
    border-color: color-mix(in oklab, var(--sign) 45%, transparent);
    background: color-mix(in oklab, var(--sign) 8%, transparent);
  }
  .guide-wheelrow a[aria-current='page'] small { color: var(--sign); }
  @media (hover: hover) and (pointer: fine) {
    .guide-wheelrow a:hover { border-color: color-mix(in oklab, var(--sign) 42%, transparent); }
  }
  .guide-siblings { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; margin-top: 16px; font-size: 0.9375rem; color: var(--muted); }
  .guide-siblings__label { margin-right: 4px; }
  .guide-siblings .pill :global(.sign-icon) { width: 22px; }
  .guide-collect { margin-top: clamp(36px, 5vw, 56px); }

  /* ── Breakpoints ─────────────────────────────────────────────── */
  @media (max-width: 1100px) {
    .guide-wheelrow { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }
  @media (max-width: 960px) {
    .guide-read { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .guide-rail { position: static; }
    .guide-rail__meta { display: none; }
  }
  @media (max-width: 760px) {
    .guide-read { margin-top: 44px; }
    .guide-rail { margin: 0 -20px 40px 0; }
    .guide-rail__title { display: none; }
    .guide-rail ol {
      display: flex;
      gap: 8px;
      padding-right: 20px;
      overflow-x: auto;
      border-left: 0;
      scrollbar-width: none;
    }
    .guide-rail ol::-webkit-scrollbar { display: none; }
    .guide-rail li { flex: none; }
    .guide-rail li a {
      display: inline-flex;
      align-items: center;
      height: 36px;
      margin: 0;
      padding: 0 14px;
      border: 1px solid var(--hair-2);
      border-radius: var(--r-full);
      font-size: 0.875rem;
      white-space: nowrap;
    }

    .guide-prose > :global(p:not(h2 ~ *)) { font-size: 1.0625rem; }
    .guide-prose > :global(.guide-pull) { margin: 30px 0; padding-left: 20px; }

