---
import Base from '../../layouts/Base.astro';
import SolarReturnCalculator from '../../islands/SolarReturnCalculator';
import '../../styles/calculator.css';

const relocation = `Astrologers disagree about whether a solar-return chart should be cast for your birthplace or for where you actually are on your birthday. Both traditions are old and neither is provable, so this tool defaults to your birthplace and lets you recast for any location — the planets don't move, but the houses and rising sign do. If you travel for your birthday, casting both and comparing is the honest experiment.`;
const faq = [
  { q: 'What is a solar return chart?', a: 'A chart cast for the instant the transiting Sun returns to its natal longitude — usually within a day of your birthday. Astrologers read it as the weather report for your personal year, from one return to the next.' },
  { q: 'Should I use my birthplace or where I am now?', a: relocation },
  { q: 'Does my birth time matter for a solar return?', a: `The return instant itself depends only on your birth date's Sun position, which needs your birth time to pin precisely — an unknown time can shift the return by up to about a day, since the Sun moves about a degree in that time. With no birth time we use the Sun at 12:00 UTC on your birth date as the natal reference, the same for every birthplace, and omit the return chart's rising sign, angles, and houses, and say so.` },
];
const jsonLd = [
  {
    '@type': 'WebApplication', name: 'Solar Return Calculator', url: 'https://zodiacs.org/solar-return/',
    applicationCategory: 'LifestyleApplication', operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  { '@type': 'FAQPage', mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base
  clientUi
  title="Solar Return Calculator — Your Birthday Chart for Any Year"
  description="See the themes shaping your personal year with a solar return chart for any year and location. Free and private by default."
  path="/solar-return/"
  jsonLd={jsonLd}
>
  <section class="section--tight container">
    <div class="tool-hero">
      <h1 class="display">Your solar return</h1>
      <p>See the themes shaping your personal year: where to grow, what needs steadier attention, and which part of life is asking to lead. Choose a year and location to cast the chart.</p>
    </div>
    <SolarReturnCalculator client:load />
    <noscript><p>This solar return calculator needs JavaScript. Enable it and reload to cast the chart in your browser.</p></noscript>
  </section>

  <section class="section--tight container container--narrow">
    <div class="section-head"><h2>Questions, answered</h2></div>
    <div class="faq">
      {faq.map(({ q, a }) => <details class="faq__item"><summary>{q}</summary><p>{a}</p></details>)}
    </div>
  </section>
</Base>

<style>
  .tool-hero { max-width: 66ch; margin-bottom: clamp(28px, 5vw, 44px); }
  .tool-hero h1 { margin: 0 0 16px; font-family: var(--font-serif); font-size: var(--text-2xl); font-weight: 500; line-height: 1.04; text-wrap: balance; }
  .tool-hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }
  .faq { display: grid; gap: 8px; }
  .faq__item { border: 1px solid var(--hair-1); border-radius: var(--r-md); background: var(--void-1); padding: 4px 18px; }
  .faq__item summary { cursor: pointer; padding: 12px 0; font-weight: 550; color: var(--text); }
  .faq__item p { margin: 2px 0 16px; color: var(--text-2); font-size: var(--text-sm); line-height: 1.65; }
</style>
