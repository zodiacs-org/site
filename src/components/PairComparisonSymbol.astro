---
// Fixed outlines for the comparison badges, avoiding platform glyph fallback
// for U+263D, U+260C, U+2640, U+2642 and their U+FE0E text selectors.
// Moon/conjunction: DejaVu Sans 2.37. Venus/Mars: Liberation Sans 2.1.5,
// at the existing Instrument Sans fallback's 103.5% size adjustment.
// Both sources use 2048 units/em. The viewBox retains the original 1em
// line box and Instrument Sans baseline (0.86em with line-height: 1).
// Source notices: docs/licenses/pair-comparison-symbols.txt.
interface Props { symbol: 'moon' | 'venus-mars' | 'conjunction' }
const { symbol } = Astro.props;
const paths = {
