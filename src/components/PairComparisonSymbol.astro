  venus: 'M732 -578Q656 -589 602.5 -627.0Q549 -665 515.0 -726.0Q481 -787 481 -862Q481 -988 568.0 -1070.5Q655 -1153 769 -1153Q887 -1153 970 -1067Q1056 -984 1056 -862Q1056 -753 984.0 -672.0Q912 -591 806 -578V-412H1062V-342H806V-80H732V-342H474V-412H732ZM767 -1069Q711 -1069 665.0 -1042.5Q619 -1016 590.5 -968.5Q562 -921 562 -864Q562 -778 623.5 -717.5Q685 -657 767 -657Q854 -657 913 -719Q974 -780 974 -864Q974 -922 945.5 -969.5Q917 -1017 870.5 -1043.0Q824 -1069 767 -1069Z',
