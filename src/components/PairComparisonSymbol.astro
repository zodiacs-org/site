};
// Venus/Mars retain two 1536-unit advances at 103.5%, minus 1px
// letter spacing per cluster at 15px: 2 * (1536 * 1.035 - 2048 / 15).
const width = symbol === 'moon' ? 1836 : symbol === 'conjunction' ? 1375 : 2906.453333;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 -1761.28 ${width} 2048`}
  width={`${width / 2048}em`}
  height="1em"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  {symbol === 'venus-mars' ? (
    <g transform="scale(1.035)">
      <path d={paths.venus} />
      <path d={paths.mars} transform="translate(1404.0837)" />
    </g>
  ) : <path d={paths[symbol]} />}
</svg>
