---
/** The sign guide's quiet profile prompt, in the contents rail. */
interface Props {
  signName: string;
  slug: string;
}

const { signName, slug } = Astro.props;
---
<p class="guide-profile">
  <span>Is {signName} your Sun sign?</span>
  <a class="textlink" href={`/profile/?sun=${slug}`}>Save it to your profile <span class="arr" aria-hidden="true">→</span></a>
</p>

<style>
  .guide-profile { display: grid; justify-items: start; gap: 6px; margin: 0; font-size: 0.875rem; color: var(--muted); }
  .guide-profile .textlink { min-height: 32px; font-size: 0.875rem; }
</style>
