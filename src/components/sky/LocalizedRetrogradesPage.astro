---
/**
 * Translated retrograde calendar (es, pt, fr, it). The English page
 * (src/pages/retrogrades/index.astro) is the reference: same data logic,
 * markup and styles; every visible string comes from COPY below.
 *
 * The English page's glossary and planet-profile links point at English-only
 * pages (/learn/…). They are incidental prose links, so the text stays and
 * the link is dropped here rather than carrying an "in English" cue
 * mid-sentence.
 */
import Base from '../../layouts/Base.astro';
import '../../styles/rx-table.css';
import sky from '../../data/sky.json';
import { bodyLongitude } from '../../lib/engine/full';
import type { BodyName } from '../../lib/engine/types';
import { formatLongitude } from '../../lib/signs';
import { formatShortDate } from '../../lib/i18n/dates';
import { planetLabel } from '../../lib/i18n/astrology';

type Locale = 'es' | 'pt' | 'fr' | 'it';
interface Props { locale: Locale }

const { locale } = Astro.props;

const PLANET_ORDER = ['Mercury', 'Venus', 'Mars', 'Jupiter', 'Saturn', 'Uranus', 'Neptune', 'Pluto'] as const;
type RetroPlanet = (typeof PLANET_ORDER)[number];

/** Running text with inline links, in the order it is printed. */
type Part = string | { text: string; href: string };

interface Links {
  mercury: string;
  transits: string;
  birthChart: string;
}

interface Copy {
  title: string;
  description: string;
  imageAlt: string;
  schemaName: string;
  schemaDescription: string;
  datasetName: string;
  datasetDescription: string;
  variableMeasured: string[];
  /** `planet` is the localized name; `key` is the English data key. */
  eventName: (planet: string, key: RetroPlanet) => string;
  eventClosed: (planet: string, from: string, to: string, rx: string, direct: string) => string;
  eventOpen: (planet: string, from: string, rx: string) => string;
  notYet: string;
  heroTitle: string;
  heroLede: string;
  asOf: (date: string) => string;
  and: string;
  statusRetro: (planets: string) => string;
  statusDirect: string;
  sunMoon: string;
  mercuryNote: (links: Links) => Part[];
  methodSummary: string;
  methodText: string;
  rhythm: Record<RetroPlanet, string>;
  nowBadge: (key: RetroPlanet) => string;
  thWindow: string;
  thRetrograde: string;
  thDirect: string;
  thStatus: string;
  clampedFrom: string;
  openEnd: string;
  stateNow: string;
  stateAhead: string;
  calmHeading: string;
  calm1: string;
  calm2: (links: Links) => Part[];
  calm3: (links: Links) => Part[];
  faqHeading: string;
  faq: (status: string) => { q: string; a: string }[];
}

