      `${planet} appare in moto retrogrado da ${from} a ${to}; posizioni delle stazioni: ${rx} e ${direct}.`,
    eventOpen: (planet, from, rx) =>
      `${planet} appare in moto retrogrado da ${from}. La data di fine non è ancora disponibile; posizione della stazione retrograda: ${rx}.`,
    notYet: 'non ancora disponibile',
    heroTitle: 'Consulta tutti i periodi retrogradi fino al 2027.',
    heroLede: 'Guarda quali pianeti sono retrogradi adesso e quando ciascuno cambia direzione.',
    asOf: (date) => `Al ${date}`,
    and: 'e',
    statusRetro: (planets) => `In periodo retrogrado adesso: ${planets}. Tutti gli altri pianeti sono in moto diretto.`,
    statusDirect: 'In questo momento tutti i pianeti sono in moto diretto; non dura mai a lungo.',
    sunMoon: 'Il Sole e la Luna non sono mai retrogradi',
    mercuryNote: (links) => ['I periodi di Mercurio hanno ', { text: 'una pagina tutta loro', href: links.mercury }],
    methodSummary: 'Come funziona questo calendario',
    methodText: 'Tutti e otto i pianeti che hanno periodi retrogradi, dal 2026 al 2027: ogni periodo è calcolato da stazione a stazione sul moto reale, con il grado in cui avviene ogni cambio di direzione.',
    rhythm: {
      Mercury: 'tre o quattro volte l’anno, circa tre settimane ogni volta',
      Venus: 'ogni 19 mesi, circa sei settimane: il più raro',
      Mars: 'ogni 26 mesi, da due a tre mesi',
      Jupiter: 'ogni anno, circa quattro mesi',
      Saturn: 'ogni anno, circa quattro mesi e mezzo',
      Uranus: 'ogni anno, circa cinque mesi',
      Neptune: 'ogni anno, circa cinque mesi',
      Pluto: 'ogni anno, da cinque a sei mesi',
    },
    nowBadge: (key) => (key === 'Venus' ? 'retrograda adesso' : 'retrogrado adesso'),
    thWindow: 'Periodo',
    thRetrograde: 'Stazione retrograda',
    thDirect: 'Stazione diretta',
    thStatus: 'Stato',
    clampedFrom: 'già in moto retrogrado all’inizio del 2026',
    openEnd: 'oltre l’orizzonte dei dati',
    stateNow: 'in corso',
    stateAhead: 'in arrivo',
    calmHeading: 'Come leggere tutto questo con calma',
    calm1: 'Il moto retrogrado è prospettiva, non retromarcia: pianeti che si sorpassano su orbite diverse, la stessa illusione di un treno più lento che sembra andare all’indietro. Quello che le tabelle mostrano con chiarezza è quanto sia normale. I pianeti esterni passano da un terzo a metà di ogni anno in moto retrogrado: in un giorno qualsiasi il cielo ne ha di solito uno o due, e oggi non fa eccezione.',
    calm2: (links) => [
      'La tradizione adatta le sue letture al ritmo. I periodi di tre settimane di ',
      { text: 'Mercurio', href: links.mercury },
      ' sono la stagione delle revisioni per progetti e scartoffie. Un periodo retrogrado di Venere — il più raro, ogni 19 mesi — si legge come un riesame di ciò che vuoi e di chi vuoi; quello di Marte, ogni 26 mesi, come una revisione del motore della spinta stessa. I periodi annuali dei pianeti esterni passano per lo più inosservati e si sentono solo dove incrociano qualcosa di esatto nel tuo tema, ed è ciò che controlla lo ',
      { text: 'strumento dei transiti', href: links.transits },
      '.',
    ],
    calm3: (links) => [
      'La tua nascita cade in un periodo retrogrado? È comune e non ha nulla di allarmante: circa una persona su cinque ha Mercurio retrogrado nel tema natale. Il tuo ',
      { text: 'tema natale', href: links.birthChart },
      ' segna con una ℞ ogni pianeta che si muoveva all’indietro al momento della tua nascita.',
    ],
    faqHeading: 'Domande e risposte',
    faq: (status) => [
      {
        q: 'Quali pianeti sono retrogradi adesso?',
        a: `${status} Le tabelle qui sopra elencano tutti i periodi del 2026 e del 2027, da stazione a stazione, con la precisione dell’ora.`,
      },
      {
        q: 'Il Sole o la Luna possono essere retrogradi?',
        a: 'No. Il moto retrogrado è un effetto prospettico tra pianeti che orbitano intorno al Sole a velocità diverse. La Luna orbita direttamente intorno alla Terra e il moto apparente del Sole è il riflesso dell’orbita della Terra stessa, quindi nessuno dei due sembra mai invertire la marcia.',
      },
      {
        q: 'I periodi retrogradi dei pianeti esterni sono importanti?',
        a: 'Per lo più no. Da Giove a Plutone, i pianeti passano da quattro a sei mesi di ogni anno in moto retrogrado: è il loro ritmo normale, e circa metà delle persone in vita ha almeno un pianeta esterno retrogrado nel tema natale. Gli astrologi li leggono come fasi più quiete e interiori di ciò che un pianeta rappresenta, niente a che vedere con il folclore da agenda che circonda Mercurio.',
      },
      {
        q: 'Che cos’è una stazione?',
        a: 'Il cambio di direzione. Un pianeta rallenta, resta per giorni sullo stesso grado, poi inverte la marcia: prima alla stazione retrograda, più tardi alla stazione diretta. Le posizioni nelle tabelle indicano queste soste, e gli astrologi considerano il grado di una stazione il punto sensibile dell’intero periodo.',
      },
      {
        q: 'Perché Mercurio riceve tutta l’attenzione?',
        a: 'Per frequenza e per territorio. Mercurio diventa retrogrado tre o quattro volte l’anno — è l’unico pianeta a farlo più di una volta l’anno — e l’astrologia gli affida la vita di tutti i giorni: messaggi, viaggi, contratti. I periodi retrogradi di Venere e Marte sono più rari e si leggono come revisioni più profonde dell’attaccamento e della spinta. La storia completa di Mercurio ha una pagina tutta sua.',
      },
    ],
  },
};

const c = COPY[locale];
const prefix = `/${locale}`;
const pagePath = `${prefix}/retrogrades/`;
const pageUrl = `https://zodiacs.org${pagePath}`;
const inLanguage = locale === 'pt' ? 'pt-BR' : locale;
const links: Links = {
  mercury: `${prefix}/mercury-retrograde/`,
  transits: `${prefix}/transits/`,
  birthChart: `${prefix}/birth-chart/`,
};

// All computed at build time from the committed sky data — receipts,
// no client ephemeris.
const buildNow = new Date();
const skyFrom = sky.from as string;
const eventHorizon = new Date(buildNow);
eventHorizon.setUTCFullYear(eventHorizon.getUTCFullYear() + 1);

const sources = [
  { label: 'Astronomy Engine', href: 'https://github.com/cosinekitty/astronomy' },
  { label: 'IANA Time Zone Database', href: 'https://www.iana.org/time-zones' },
];

const fmt = (d: Date) => formatShortDate(locale, d);

const windows = (sky.retrogrades as { planet: BodyName; from: string; to: string | null }[]).map((r) => {
  const from = new Date(r.from);
  const to = r.to ? new Date(r.to) : null;
  // A window that opens exactly at the data horizon was clamped, not
  // stationed — no honest station position exists for it.
  const clamped = r.from === skyFrom;
  return {
    planet: r.planet,
    from,
    to,
    clamped,
    label: `${clamped ? c.clampedFrom : fmt(from)} – ${to ? fmt(to) : c.openEnd}`,
    stationRx: clamped ? null : formatLongitude(bodyLongitude(r.planet, from), locale),
    stationDirect: to ? formatLongitude(bodyLongitude(r.planet, to), locale) : null,
    state: to && to < buildNow ? 'past' : from > buildNow ? 'upcoming' : 'active',
  };
});

const byPlanet = PLANET_ORDER.map((planet) => ({
  planet,
  name: planetLabel(locale, planet),
  rhythm: c.rhythm[planet],
  windows: windows.filter((w) => w.planet === planet),
  active: windows.some((w) => w.planet === planet && w.state === 'active'),
}));
const upcomingWindows = windows.filter((window) =>
  window.from <= eventHorizon && (!window.to || window.to >= buildNow));

const retroToday = byPlanet.filter((p) => p.active).map((p) => p.name);
const asOf = formatShortDate(locale, buildNow);

// None of the four languages puts a comma before the final conjunction.
const listJoin = (xs: string[]) =>
  xs.length <= 1 ? xs.join('') : `${xs.slice(0, -1).join(', ')} ${c.and} ${xs.at(-1)}`;

const status = retroToday.length ? c.statusRetro(listJoin(retroToday)) : c.statusDirect;

const faq = c.faq(status);

const eventNodes = upcomingWindows.map((window) => {
  const from = window.from.toISOString();
  const to = window.to?.toISOString();
  // Anchor ids stay on the English planet key so they match across locales.
  const id = `retrograde-${window.planet.toLowerCase()}-${from.slice(0, 10)}`;
  const planetName = planetLabel(locale, window.planet);
  return {
    '@type': 'Event',
    '@id': `${pageUrl}#${id}`,
    name: c.eventName(planetName, window.planet as RetroPlanet),
    description: to
      ? c.eventClosed(planetName, from, to, window.stationRx ?? c.notYet, window.stationDirect ?? c.notYet)
      : c.eventOpen(planetName, from, window.stationRx ?? c.notYet),
    startDate: from,
    ...(to ? { endDate: to } : {}),
    eventStatus: 'https://schema.org/EventScheduled',
    inLanguage,
    url: `${pageUrl}#${id}`,
  };
});

const dataset = {
  '@type': 'Dataset',
  '@id': `${pageUrl}#dataset`,
  name: c.datasetName,
  description: c.datasetDescription,
  url: pageUrl,
  inLanguage,
  creator: { '@id': 'https://zodiacs.org/#org' },
  publisher: { '@id': 'https://zodiacs.org/#org' },
  dateModified: sky.generatedAt,
  temporalCoverage: `${sky.from}/${sky.to}`,
  spatialCoverage: 'Earth',
  variableMeasured: c.variableMeasured,
  citation: sources.map((source) => ({ '@type': 'CreativeWork', name: source.label, url: source.href })),
};

const jsonLd = [
  {
    '@type': 'WebPage',
    name: c.schemaName,
    url: pageUrl,
    description: c.schemaDescription,
    inLanguage,
  },
  {
    '@type': 'FAQPage',
    inLanguage,
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  dataset,
  ...eventNodes,
];
---
<Base
  title={c.title}
  description={c.description}
  path={pagePath}
  locale={locale}
  image="/assets/og/v2/tool/retrogrades.png"
  imageAlt={c.imageAlt}
  jsonLd={jsonLd}
  sources={sources}
>
  <section class="section--tight container container--narrow">
    <div class="tool-hero reveal">
      <h1 class="display">{c.heroTitle}</h1>
      <p>{c.heroLede}</p>
    </div>

    <div class="rx-now shell tinted reveal" style="--sign:var(--sign-gemini)">
      <div class="core tinted rx-now__core">
        <span class="mono--label">{c.asOf(asOf)}</span>
        <strong class="rx-now__line">{status}</strong>
        <span class="rx-now__all mono">
          {c.sunMoon} · {c.mercuryNote(links).map((part) => (
            typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>
          ))}
        </span>
      </div>
    </div>
    <details class="calendar-method"><summary>{c.methodSummary}</summary>
      <p>{c.methodText}</p>
    </details>
  </section>

  <section class="section--tight container container--narrow">
    <div class="planets reveal">
      {byPlanet.map((p) => (
        <div class="planet">
          <div class="planet__head">
            <h2 class="planet__name">
              {p.name}
              {p.active && <span class="planet__now mono">{c.nowBadge(p.planet)}</span>}
            </h2>
            <span class="planet__rhythm">{p.rhythm}</span>
          </div>
          <div class="table-wrap">
            <table class="rx-table">
              <thead>
                <tr><th>{c.thWindow}</th><th>{c.thRetrograde}</th><th>{c.thDirect}</th><th></th></tr>
              </thead>
              <tbody>
                {p.windows.map((w) => (
                  <tr id={`retrograde-${p.planet.toLowerCase()}-${w.from.toISOString().slice(0, 10)}`} class={w.state === 'past' ? 'rx-table__past' : ''}>
                    <td class="planet__window" data-label={c.thWindow}>{w.label}</td>
                    <td class="mono" data-label={c.thRetrograde}>{w.stationRx ?? '—'}</td>
                    <td class="mono" data-label={c.thDirect}>{w.stationDirect ?? '—'}</td>
                    <td class="mono rx-table__state" data-label={c.thStatus}>{w.state === 'active' ? c.stateNow : w.state === 'upcoming' ? c.stateAhead : ''}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <div class="prose reveal">
      <h2>{c.calmHeading}</h2>
      <p>{c.calm1}</p>
      <p>
        {c.calm2(links).map((part) => (
          typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>
        ))}
      </p>
      <p>
        {c.calm3(links).map((part) => (
          typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>
        ))}
      </p>
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <div class="section-head reveal"><h2>{c.faqHeading}</h2></div>
    <div class="faq reveal">
      {faq.map(({ q, a }) => (
        <details class="faq__item">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .tool-hero { max-width: 62ch; margin-bottom: clamp(24px, 4vw, 36px); }
  .tool-hero h1 {
    margin: 0 0 16px;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1.04;
    font-variant-numeric: oldstyle-figures;
    text-wrap: balance;
  }
  .tool-hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }

  .rx-now__core { padding: clamp(20px, 4vw, 28px); display: grid; gap: 10px; }
  .rx-now__line { font-size: var(--text-lg); letter-spacing: -0.01em; max-width: 56ch; }
  .rx-now__all { font-size: 11.5px; color: var(--faint); letter-spacing: 0.05em; }
  .rx-now__all a { color: var(--muted); }
  .rx-now__all a:hover { color: var(--text); }

  .planets { display: grid; gap: clamp(34px, 5vw, 52px); }
  .planet__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 18px; margin-bottom: 6px; }
  .planet__name {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: 0.002em;
  }
  .planet__now {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--hair-2);
    border-radius: 99px;
    padding: 3px 10px;
    vertical-align: middle;
    margin-left: 10px;
  }
  .planet__rhythm { font-size: var(--text-sm); color: var(--faint); }
  .planet__window { white-space: normal; min-width: 210px; }
  @media (max-width: 560px) { .planet__window { min-width: 0; } }

  /* .table-wrap + .rx-table (desktop + mobile stacking) live in
     ../../styles/rx-table.css (shared). */

  .faq { display: grid; gap: 8px; }
  .faq__item {
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: var(--void-1);
    padding: 4px 18px;
  }
  .faq__item summary { cursor: pointer; padding: 12px 0; font-weight: 550; color: var(--text); }
  .faq__item p { margin: 2px 0 16px; color: var(--text-2); font-size: var(--text-sm); line-height: 1.65; }
</style>
