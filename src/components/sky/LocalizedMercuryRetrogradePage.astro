/** A formatted date plus its day of the month, for copy that must agree with it. */
interface DayLabel { text: string; day: number }

interface Copy {
  title: string;
  description: string;
  imageAlt: string;
  h1: string;
  intro: string;
  asOf: (date: DayLabel) => string;
  statusActive: (direct: DayLabel) => string;
  statusNext: (from: DayLabel, to: DayLabel, year: number) => string;
  statusDirect: string;
  retroToday: string;
  none: string;
  allBefore: string;
  allLink: string;
  only2027: string;
  windowsHeading: string;
  windowsLede: string;
  colWindow: string;
  colRetrograde: string;
  colDirect: string;
  colStatus: string;
  now: string;
  ahead: string;
  ongoing: string;
  bodyHeading: string;
  motion: string;
  advice: string;
  /** Text, emphasised possessive, text, birth-chart link label, text. */
  chart: [string, string, string, string, string];
  faqHeading: string;
  faqNext: { q: string; a: (status: string, year: number | string) => string };
  faq: { q: string; a: string }[];
  pageName: string;
  pageDescription: string;
  eventName: string;
  eventDescription: (from: string, to: string, retrograde: string, direct: string | null) => string;
  eventDescriptionOpen: (from: string, retrograde: string) => string;
  datasetName: string;
  datasetDescription: string;
  variableMeasured: string[];
}

// Italian articles and prepositions elide before "otto" and "undici".
const itElides = (date: DayLabel) => date.day === 8 || date.day === 11;
const itOn = (date: DayLabel) => (itElides(date) ? `l’${date.text}` : `il ${date.text}`);
const itFrom = (date: DayLabel) => (itElides(date) ? `dall’${date.text}` : `dal ${date.text}`);
const itTo = (date: DayLabel) => (itElides(date) ? `all’${date.text}` : `al ${date.text}`);

