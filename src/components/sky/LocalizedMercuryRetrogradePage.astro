    faqHeading: 'Domande e risposte',
    faqNext: {
      q: 'Quando è il prossimo Mercurio retrogrado?',
      a: (status, year) => `${status} La tabella completa qui sopra elenca tutti i periodi fino al ${year}, calcolati dal moto reale di Mercurio e con la precisione dell’ora.`,
    },
    faq: [
      {
        q: 'Che cos’è davvero Mercurio retrogrado?',
        a: 'Un effetto ottico. Mercurio gira intorno al Sole più in fretta della Terra e, tre o quattro volte all’anno, ci sorpassa all’interno: dal nostro punto di vista in movimento sembra rallentare, fermarsi e scivolare all’indietro lungo lo zodiaco per circa tre settimane. Nello spazio niente cambia direzione; l’apparenza è abbastanza reale da poterla calcolare con uno scarto di pochi minuti.',
      },
      {
        q: 'Quanto dura Mercurio retrogrado?',
        a: 'Circa tre settimane, tre o quattro volte all’anno. Gli astrologi osservano anche l’“ombra” (una o due settimane prima e dopo, mentre Mercurio attraversa gli stessi gradi a velocità normale), ma i periodi datati di questa pagina sono il periodo retrogrado vero e proprio, da stazione a stazione.',
      },
      {
        q: 'Che cosa significa Mercurio retrogrado in astrologia?',
        a: 'Mercurio è il pianeta che gli astrologi associano alla comunicazione, ai viaggi e alle informazioni; per questo il suo periodo retrogrado si è fatto la fama di messaggi confusi, intoppi di viaggio e tecnologia in rivolta. Il consiglio pratico è più noioso dei meme: lascia margine, conferma i dettagli e tratta il periodo come una stagione di revisione, in cui finire, correggere e ricontrollare più che lanciare.',
      },
      {
        q: 'Anche gli altri pianeti diventano retrogradi?',
        a: 'Tutti, tranne il Sole e la Luna. I pianeti esterni passano mesi in moto retrogrado ogni anno e gli astrologi quasi non ci fanno caso; Mercurio finisce nei titoli perché i suoi periodi retrogradi sono frequenti, brevi e legati alla vita di tutti i giorni.',
      },
    ],
    pageName: 'Date di Mercurio retrogrado, 2026–2027',
    pageDescription: 'Date esatte di Mercurio retrogrado per il 2026 e il 2027, calcolate dal moto reale del pianeta, con le posizioni delle stazioni.',
    eventName: 'Mercurio retrogrado',
    eventDescription: (from, to, retrograde, direct) => `Mercurio appare retrogrado da ${from} a ${to}, con stazioni a ${retrograde} e ${direct ?? 'una stazione diretta non ancora disponibile'}.`,
    eventDescriptionOpen: (from, retrograde) => `Mercurio appare retrogrado da ${from}. La data di fine e la stazione diretta non sono ancora disponibili; la stazione retrograda è a ${retrograde}.`,
    datasetName: 'Periodi di Mercurio retrogrado, 2026–2027',
    datasetDescription: 'Istanti calcolati delle stazioni retrograda e diretta di Mercurio, con le posizioni nello zodiaco tropicale, per il 2026 e il 2027.',
    variableMeasured: ['istante della stazione retrograda', 'istante della stazione diretta', 'longitudine della stazione'],
  },
};

const c = COPY[locale];
const englishOnly = ENGLISH_ONLY_COPY[locale];
const prefix = `/${locale}`;
const pagePath = `${prefix}/mercury-retrograde/`;
const pageUrl = `https://zodiacs.org${pagePath}`;
const inLanguage = locale === 'pt' ? 'pt-BR' : locale;

// Intl writes the first of the month as a bare "1"; French, Portuguese and
// Italian prose want the ordinal ("1er juin", "1º de junho", "1º giugno").
const firstOrdinal = (text: string, day: number) => {
  if (day !== 1) return text;
  if (locale === 'fr') return text.replace(/^1 /, '1er ');
  if (locale === 'pt' || locale === 'it') return text.replace(/^1 /, '1º ');
  return text;
};
const dayLabel = (date: Date, text: string): DayLabel => {
  const day = date.getUTCDate();
  return { text: firstOrdinal(text, day), day };
};

// All computed at build time from the committed sky data — the page
// ships as receipts, no client ephemeris.
const buildNow = new Date();
const eventHorizon = new Date(buildNow);
eventHorizon.setUTCFullYear(eventHorizon.getUTCFullYear() + 1);
const sources = [
  { label: 'Astronomy Engine', href: 'https://github.com/cosinekitty/astronomy' },
  { label: 'IANA Time Zone Database', href: 'https://www.iana.org/time-zones' },
];
const windows = (sky.retrogrades as { planet: string; from: string; to: string | null }[])
  .filter((r) => r.planet === 'Mercury')
  .map((r) => {
    const from = new Date(r.from);
    const to = r.to ? new Date(r.to) : null;
    const fmt = (d: Date) => formatShortDate(locale, d);
    return {
      from,
      to,
      label: `${fmt(from)} – ${to ? fmt(to) : c.ongoing}`,
      stationRx: formatLongitude(bodyLongitude('Mercury', from), locale),
      stationDirect: to ? formatLongitude(bodyLongitude('Mercury', to), locale) : null,
      state: to && to < buildNow ? 'past' : from > buildNow ? 'upcoming' : 'active',
    };
  });
const upcomingWindows = windows.filter((window) =>
  window.from <= eventHorizon && (!window.to || window.to >= buildNow));

const active = windows.find((w) => w.state === 'active');
const next = windows.find((w) => w.state === 'upcoming');
const fmtShort = (d: Date) =>
  dayLabel(d, formatDate(locale, d, { month: 'long', day: 'numeric', timeZone: 'UTC' }));

const status = active
  ? c.statusActive(fmtShort(active.to!))
  : next
    ? c.statusNext(fmtShort(next.from), fmtShort(next.to!), next.to!.getUTCFullYear())
    : c.statusDirect;

const retroToday = (sky.retrogrades as { planet: string; from: string; to: string | null }[])
  .filter((r) => new Date(r.from) <= buildNow && (!r.to || new Date(r.to) >= buildNow))
  .map((r) => planetLabel(locale, r.planet));

const asOf = c.asOf(dayLabel(buildNow, formatShortDate(locale, buildNow)));

const faq = [
  {
    q: c.faqNext.q,
    a: c.faqNext.a(status, windows.at(-1)?.to?.getUTCFullYear() ?? '2027'),
  },
  ...c.faq,
];

const eventNodes = upcomingWindows.map((window) => {
  const from = window.from.toISOString();
  const to = window.to?.toISOString();
  const id = `mercury-retrograde-${from.slice(0, 10)}`;
  return {
    '@type': 'Event',
    '@id': `${pageUrl}#${id}`,
    name: c.eventName,
    description: to
      ? c.eventDescription(from, to, window.stationRx, window.stationDirect)
      : c.eventDescriptionOpen(from, window.stationRx),
    startDate: from,
    ...(to ? { endDate: to } : {}),
    eventStatus: 'https://schema.org/EventScheduled',
    inLanguage,
    url: `${pageUrl}#${id}`,
  };
});

const dataset = {
  '@type': 'Dataset',
  '@id': `${pageUrl}#dataset`,
  name: c.datasetName,
  description: c.datasetDescription,
  url: pageUrl,
  inLanguage,
  creator: { '@id': 'https://zodiacs.org/#org' },
  publisher: { '@id': 'https://zodiacs.org/#org' },
  dateModified: sky.generatedAt,
  temporalCoverage: `${sky.from}/${sky.to}`,
  spatialCoverage: 'Earth',
  variableMeasured: c.variableMeasured,
  citation: sources.map((source) => ({ '@type': 'CreativeWork', name: source.label, url: source.href })),
};

const jsonLd = [
  {
    '@type': 'WebPage',
    name: c.pageName,
    url: pageUrl,
    description: c.pageDescription,
    inLanguage,
  },
  {
    '@type': 'FAQPage',
    inLanguage,
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  dataset,
  ...eventNodes,
];
---
<Base
  title={c.title}
  description={c.description}
  path={pagePath}
  locale={locale}
  image="/assets/og/v2/tool/mercury-retrograde.png"
  imageAlt={c.imageAlt}
  jsonLd={jsonLd}
  sources={sources}
>
  <section class="section--tight container container--narrow">
    <div class="tool-hero reveal">
      <h1 class="display">{c.h1}</h1>
      <p>{c.intro}</p>
    </div>

    <div class="rx-now shell tinted reveal" style="--sign:var(--sign-gemini)">
      <div class="core tinted rx-now__core">
        <span class="mono--label">{asOf}</span>
        <strong class="rx-now__line">{status}</strong>
        <span class="rx-now__all mono">
          {c.retroToday} {retroToday.length ? retroToday.join(', ') : c.none} ·
          {c.allBefore} <a href={`${prefix}/retrogrades/`}>{c.allLink}</a>
          · <a href="/mercury-retrograde/2027/" hreflang="en" title={englishOnly.aria}>{c.only2027}{englishOnly.suffix}</a>
        </span>
      </div>
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <div class="section-head reveal">
      <h2>{c.windowsHeading}</h2>
      <p>{c.windowsLede}</p>
    </div>
    <div class="table-wrap reveal">
      <table class="rx-table">
        <thead>
          <tr><th>{c.colWindow}</th><th>{c.colRetrograde}</th><th>{c.colDirect}</th><th></th></tr>
        </thead>
        <tbody>
          {windows.map((w) => (
            <tr id={`mercury-retrograde-${w.from.toISOString().slice(0, 10)}`} class={w.state === 'past' ? 'rx-table__past' : ''}>
              <td data-label={c.colWindow}>{w.label}</td>
              <td class="mono" data-label={c.colRetrograde}>{w.stationRx}</td>
              <td class="mono" data-label={c.colDirect}>{w.stationDirect ?? '—'}</td>
              <td class="mono rx-table__state" data-label={c.colStatus}>{w.state === 'active' ? c.now : w.state === 'upcoming' ? c.ahead : ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <div class="prose reveal">
      <h2>{c.bodyHeading}</h2>
      <p>{c.motion}</p>
      <p>{c.advice}</p>
      <p>{c.chart[0]}<em>{c.chart[1]}</em>{c.chart[2]}<a href={`${prefix}/birth-chart/`}>{c.chart[3]}</a>{c.chart[4]}</p>
    </div>
  </section>

  <section class="section--tight container container--narrow">
    <div class="section-head reveal"><h2>{c.faqHeading}</h2></div>
    <div class="faq reveal">
      {faq.map(({ q, a }) => (
        <details class="faq__item">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
</Base>

<style>
  .tool-hero { max-width: 62ch; margin-bottom: clamp(24px, 4vw, 36px); }
  .tool-hero h1 {
    margin: 0 0 16px;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1.04;
    font-variant-numeric: oldstyle-figures;
    text-wrap: balance;
  }
  .tool-hero p { margin: 0; color: var(--muted); font-size: var(--text-lg); text-wrap: pretty; }

  .rx-now__core { padding: clamp(20px, 4vw, 28px); display: grid; gap: 10px; }
  .rx-now__line { font-size: var(--text-lg); letter-spacing: -0.01em; max-width: 56ch; }
  .rx-now__all { font-size: 11.5px; color: var(--faint); letter-spacing: 0.05em; }
  .rx-now__all a { color: var(--muted); }
  .rx-now__all a:hover { color: var(--text); }

  /* .table-wrap + .rx-table (desktop + mobile stacking) live in
     ../../styles/rx-table.css (shared with the other sky-calendar pages). */

  .faq { display: grid; gap: 8px; }
  .faq__item {
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: var(--void-1);
    padding: 4px 18px;
  }
  .faq__item summary { cursor: pointer; padding: 12px 0; font-weight: 550; color: var(--text); }
  .faq__item p { margin: 2px 0 16px; color: var(--text-2); font-size: var(--text-sm); line-height: 1.65; }
</style>
