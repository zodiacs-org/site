/**
 * Translated eclipse calendar (es, pt, fr, it). The English page
 * (src/pages/eclipses/index.astro) is the reference: same committed data,
 * same table and markup, with the copy below in the reader's language.
 */
import Base from '../../layouts/Base.astro';
import '../../styles/rx-table.css';
import eclipseData from '../../data/eclipses.json';
import { signBySlug, signName } from '../../lib/signs';
import { formatDate, formatShortDate, formatTime } from '../../lib/i18n/dates';
import { publishedEventById } from '../../lib/events/publication';
import { ENGLISH_ONLY_COPY } from '../../lib/i18n';

type Locale = 'es' | 'pt' | 'fr' | 'it';
interface Props { locale: Locale }

const { locale } = Astro.props;

type EclipseType = 'solar' | 'lunar';
type EclipseKind = 'total' | 'partial' | 'annular' | 'penumbral';

interface Copy {
  title: string;
  description: string;
  imageAlt: string;
  heroHeading: string;
  heroLede: string;
  asOf: (date: string) => string;
  /** A weekday-led date as it reads after a verb: "el sábado, 6 de febrero de 2027". */
  on: (day: string, utcWeekday: number) => string;
  /** The noun, then the type and kind adjectives that follow it. */
  noun: string;
  type: Record<EclipseType, string>;
  kind: Record<EclipseKind, string>;
  percent: (n: number) => string;
  detail: {
    solarTotal: string;
    solarAnnular: (pct: string) => string;
    solarPartial: string;
    lunarTotal: (minutes: number) => string;
    lunarPartial: (pct: string) => string;
    lunarPenumbral: string;
  };
  status: (name: string, when: string, sign: string) => string;
  statusNone: string;
  seasons: string;
  yearLink: string;
  methodSummary: string;
  method: string;
  tableHeading: string;
  tableLede: string;
  th: { peak: string; eclipse: string; sign: string; detail: string };
  proseHeading: string;
  p1: string;
  /** Paragraph two runs: text, date, text, date, text, sign link, text. */
  p2a: string;
  p2b: string;
  p2c: string;
  p2d: string;
  /** Paragraph three runs: text, lunation link, text, chart link, text. */
  p3a: string;
  p3Lunation: string;
  p3b: string;
  p3Chart: string;
  p3c: string;
  /** The closing horoscopes sentence: text, link, text. */
  horoBefore: string;
  horoLink: string;
  horoAfter: string;
  faqHeading: string;
  faq: {
    solarQ: string;
    solarA: (name: string, when: string, sign: string, aug12: string) => string;
    solarNone: string;
    lunarQ: string;
    lunarA: (name: string, when: string, sign: string) => string;
    lunarNone: string;
    differenceQ: string;
    differenceA: string;
    pairsQ: string;
    pairsA: string;
    meaningQ: string;
    meaningA: string;
  };
  ld: {
    pageName: string;
    pageDescription: string;
    datasetName: string;
    datasetDescription: string;
    earth: string;
    variables: string[];
    eventName: (name: string, sign: string) => string;
    eventDescription: (detail: string, peak: string) => string;
  };
}

