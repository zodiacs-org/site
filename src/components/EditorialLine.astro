---
/**
 * The editorial byline — one quiet line above the sources/footer on every
 * article page: who published it, and where the standards live. Rendered
 * by Base whenever a page declares `type="article"`, so templates never wire
 * it individually. The organization link leads to the full disclosure.
 */
import { EDITOR_PATH } from '../lib/editorial';
import { englishOnlyCue, localizePath, t, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
// The editorial standards live on the English /about/ page.
const englishOnly = englishOnlyCue(locale);
// Every catalog locale has its own methodology page; the section locales link the English one.
const methodologyEnglish = Boolean(englishOnly) && localizePath(locale, '/methodology/') === '/methodology/';
---
<aside class="editorial-line container container--narrow">
  <span>
    {t(locale, 'editedBy')}{' '}
    <a href={EDITOR_PATH} hreflang={englishOnly ? 'en' : undefined} title={englishOnly?.aria}>Zodiacs.org</a>
    <span aria-hidden="true"> · </span>
    <a href={localizePath(locale, '/methodology/')} hreflang={methodologyEnglish ? 'en' : undefined} title={methodologyEnglish ? englishOnly?.aria : undefined}>{t(locale, 'editorialHow')}{methodologyEnglish ? englishOnly?.suffix : ''}</a>
  </span>
</aside>

<style>
  .editorial-line {
    margin-top: clamp(36px, 6vw, 60px);
    color: var(--faint);
    font-size: var(--text-xs);
    line-height: 1.6;
  }
  .editorial-line a {
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--hair-2);
  }
  .editorial-line a:hover { color: var(--text); }
</style>
