---
/**
 * The sign guide's quick answers, in one strip under the hero art: each
 * fact a label, a value set in the display serif, and an optional note.
 * The English guide passes six facts with notes; the localized guides pass
 * the three their catalogues already translate (dates, element, ruler).
 */
import { PLANET_GLYPH } from '../lib/glyphs/paths';

export interface SignGuideFact {
  label: string;
  value: string;
  /** Planet name whose glyph follows the value (the ruling planet). */
  glyph?: string;
  note?: string;
  /** A link at the end of the note. */
  link?: { href: string; label: string };
}

interface Props {
  facts: SignGuideFact[];
  /** Accessible name for the list; omit where no translated label exists. */
  label?: string;
}

const { facts, label } = Astro.props;
---
<dl class:list={['sg-facts', facts.length > 4 ? 'sg-facts--wide' : 'sg-facts--short']} aria-label={label}>
  {facts.map((fact) => (
    <div class="sg-fact">
      <dt>{fact.label}</dt>
      <dd>
        <span class="sg-fact__value">
          {fact.value}
          {fact.glyph && PLANET_GLYPH[fact.glyph] && (
            <svg class="sg-fact__glyph" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={PLANET_GLYPH[fact.glyph]} />
          )}
        </span>
        {(fact.note || fact.link) && (
          <small>{fact.note}{fact.note && fact.link && ' '}{fact.link && <a href={fact.link.href}>{fact.link.label}</a>}</small>
        )}
      </dd>
    </div>
  ))}
</dl>

<style>
  .sg-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    margin: 24px 0 0;
    border-top: 1px solid var(--hair-2);
    border-bottom: 1px solid var(--hair-1);
  }
  .sg-facts--wide { grid-template-columns: 1.1fr repeat(5, minmax(0, 1fr)); }
  .sg-facts--short { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .sg-fact { padding: 20px 18px 22px 20px; border-left: 1px solid var(--hair-1); }
  .sg-fact:first-child { padding-left: 0; border-left: 0; }
  .sg-fact dt { font-size: 13px; font-weight: 500; color: var(--faint); }
  .sg-fact dd { margin: 0; }
  .sg-fact__value {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    font-family: var(--font-serif);
    font-size: 1.7rem;
    font-weight: 500;
    line-height: 1.1;
    color: var(--ink-0);
    white-space: nowrap;
    font-variant-numeric: lining-nums;
  }
  .sg-fact__glyph { flex: none; color: var(--sign, var(--ink-1)); }
  .sg-fact small { display: block; margin-top: 6px; font-size: 13px; line-height: 1.4; color: var(--muted); }
  .sg-fact a { color: inherit; text-decoration: underline; text-decoration-color: var(--hair-3); text-underline-offset: 3px; }
  .sg-fact a:hover { color: var(--ink-0); }
  @media (max-width: 1100px) {
    .sg-facts--wide { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .sg-fact:nth-child(4) { padding-left: 0; border-left: 0; }
    .sg-fact:nth-child(n + 4) { border-top: 1px solid var(--hair-1); }
  }
  @media (max-width: 760px) {
    .sg-facts--wide, .sg-facts--short { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 18px; }
    .sg-fact { padding: 16px 0 16px 16px; }
    .sg-fact:nth-child(odd) { padding-left: 0; border-left: 0; }
    .sg-fact:nth-child(even) { padding-left: 16px; border-left: 1px solid var(--hair-1); }
    .sg-fact:nth-child(n + 3) { border-top: 1px solid var(--hair-1); }
    .sg-fact__value { font-size: clamp(1.2rem, 0.8rem + 2vw, 1.42rem); white-space: normal; overflow-wrap: anywhere; }
    .sg-fact small { font-size: 12.5px; }
  }
</style>
