---
/**
 * The R2.1 ramp into The Race. Renders nothing while
 * PUBLIC_ZODIAC_GAMES_ENABLED is off, so flag-off builds (including CI and
 * its committed receipts) are byte-identical with pre-ramp output. Copy is
 * sign-specific where the surface knows the sign; scoring language stays
 * the approved sentence — free participation only.
 */
import { isAstrologyToolPath } from '../lib/trust-boundary';
import { seasonInstanceAt } from '../lib/games/season';
import { normalizeCatalogLocale, t, englishOnlyCue, type CatalogLocale } from '../lib/i18n';

interface Props {
  signName?: string;
  locale?: CatalogLocale;
  /** Extra classes for the band (e.g. `reveal`); applied only when it renders. */
  class?: string;
  /** Space above the band, applied only when it renders (e.g. '28px'). */
  gap?: string;
}

const enabled = (import.meta.env.PUBLIC_ZODIAC_GAMES_ENABLED
  ?? process.env.PUBLIC_ZODIAC_GAMES_ENABLED) === '1';
const { signName, class: className, gap } = Astro.props;
const buildInstant = new Date();
const season = enabled && !isAstrologyToolPath(Astro.url.pathname) ? seasonInstanceAt(buildInstant) : null;
const locale = normalizeCatalogLocale(Astro.props.locale);
const englishCue = englishOnlyCue(locale);
---
{season && (
  <aside
    class:list={['race-ramp', className]}
    style={[
      gap ? `--race-ramp-gap:${gap}` : null,
      signName ? null : `--sign:${season.sign.hue}`,
    ].filter(Boolean).join(';') || undefined}
  >
    <span class="race-ramp__label mono">{t(locale, 'trustGamesTitle')}</span>
    <span class="race-ramp__text">{t(locale, 'trustGamesScore')}</span>
    <a class="race-ramp__link" href="/race/" hreflang={englishCue ? 'en' : undefined} title={englishCue?.aria}>
      {t(locale, 'trustGamesLink')}{englishCue?.suffix ?? ''} →
    </a>
  </aside>
)}

<style>
  .race-ramp {
    margin-block-start: var(--race-ramp-gap, 0);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    padding: 12px 18px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: linear-gradient(90deg, rgba(198, 204, 218, 0.04), transparent 60%);
  }
  .race-ramp__label {
    font-size: 9.5px;
    letter-spacing: 0.22em;
    text-transform: none;
    color: var(--faint);
  }
  .race-ramp__text {
    flex: 1 1 240px;
    font-size: 13px;
    color: var(--muted);
  }
  .race-ramp__link {
    margin-inline-start: auto;
    font-size: 13px;
    font-weight: 550;
    color: var(--text-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .race-ramp__link:hover { color: var(--text); }
  @media (max-width: 560px) {
    .race-ramp__link {
      /* Keep the tap target clear of the fixed 48px Guide launcher. */
      --launcher-clearance: max(36px, calc(24px + env(safe-area-inset-right, 0px)));
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      max-inline-size: calc(100% - var(--launcher-clearance));
      margin-inline-start: 0;
      margin-inline-end: var(--launcher-clearance);
      white-space: normal;
    }
  }
</style>
