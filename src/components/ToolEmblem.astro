---
/**
 * Large line-drawn emblems for the five featured tools on /tools/. Each is a
 * small instrument drawing — a natal wheel, a day arc, two orbits, a month of
 * moons, a horizon — in ink line work with the pastel sign hues as the only
 * colour. They are deliberately not the zodiac sign discs: a tool is an
 * instrument, not a sign.
 */
export type ToolEmblemKind = 'birth' | 'today' | 'compat' | 'horoscopes' | 'moonrise';

interface Props {
  kind: ToolEmblemKind;
}
const { kind } = Astro.props;

const ticks = Array.from({ length: 72 }, (_, i) => {
  const a = (i * 5 * Math.PI) / 180;
  const r1 = i % 6 === 0 ? 50 : 53;
  return `M${(60 + r1 * Math.cos(a)).toFixed(2)} ${(60 + r1 * Math.sin(a)).toFixed(2)}L${(60 + 56 * Math.cos(a)).toFixed(2)} ${(60 + 56 * Math.sin(a)).toFixed(2)}`;
}).join('');
const spokes = Array.from({ length: 12 }, (_, i) => {
  const a = (i * 30 * Math.PI) / 180;
  return `M${(60 + 22 * Math.cos(a)).toFixed(2)} ${(60 + 22 * Math.sin(a)).toFixed(2)}L${(60 + 44 * Math.cos(a)).toFixed(2)} ${(60 + 44 * Math.sin(a)).toFixed(2)}`;
}).join('');
const pt = (deg: number, r: number) => {
  const a = (deg * Math.PI) / 180;
  return [+(60 + r * Math.cos(a)).toFixed(2), +(60 + r * Math.sin(a)).toFixed(2)];
};
const natal = [
  { deg: 200, hue: 'var(--sign-cancer)' },
  { deg: 320, hue: 'var(--sign-libra)' },
  { deg: 80, hue: 'var(--sign-sagittarius)' },
];
const natalPts = natal.map((p) => pt(p.deg, 33));
// A month of moons: phase discs across a gentle arc.
const phases = Array.from({ length: 7 }, (_, i) => {
  const x = 14 + i * 15.33;
  const y = 66 - Math.sin((i / 6) * Math.PI) * 22;
  const lit = i / 6; // 0 new → 1 full
  return { x: +x.toFixed(2), y: +y.toFixed(2), lit };
});
---
<span class={`tool-emblem tool-emblem--${kind}`} aria-hidden="true">
  {kind === 'birth' && (
    <svg viewBox="0 0 120 120">
      <circle class="te-halo" cx="60" cy="60" r="58" />
      <g class="te-spin">
        <path class="te-tick" d={ticks} />
        <circle class="te-ring" cx="60" cy="60" r="44" />
      </g>
      <circle class="te-ring" cx="60" cy="60" r="22" />
      <path class="te-faint" d={spokes} />
      <path class="te-aspect" d={`M${natalPts[0][0]} ${natalPts[0][1]}L${natalPts[1][0]} ${natalPts[1][1]}L${natalPts[2][0]} ${natalPts[2][1]}Z`} />
      {natal.map((p, i) => (
        <circle cx={natalPts[i][0]} cy={natalPts[i][1]} r="4.2" style={`fill:${p.hue}`} />
      ))}
      <path class="te-ink" d="M2 60h14M104 60h14" />
      <circle class="te-dot" cx="60" cy="60" r="1.6" />
    </svg>
  )}
  {kind === 'today' && (
    <svg viewBox="0 0 120 120">
      <circle class="te-halo" cx="60" cy="60" r="58" />
      <path class="te-faint te-dash" d="M14 82a46 46 0 0 1 92 0" />
      <path class="te-ink" d="M8 82h104" />
      <path class="te-faint" d="M22 90h76M36 97h48" />
      <circle cx="78" cy="41.5" r="9" style="fill:var(--sign-sagittarius)" />
      <path class="te-ray" d="M78 25.5v-5M78 62.5v-5M62 41.5h-5M99 41.5h-5M66.7 30.2l-3.5-3.5M92.8 56.3l-3.5-3.5M66.7 52.8l-3.5 3.5M92.8 26.7l-3.5 3.5" />
      <circle class="te-dot" cx="14" cy="82" r="2" />
      <circle class="te-dot" cx="106" cy="82" r="2" />
    </svg>
  )}
  {kind === 'compat' && (
    <svg viewBox="0 0 120 120">
      <circle class="te-halo" cx="60" cy="60" r="58" />
      <ellipse class="te-ring" cx="47" cy="60" rx="31" ry="31" />
      <ellipse class="te-ring" cx="73" cy="60" rx="31" ry="31" />
      <path class="te-lens" d="M60 32.1a31 31 0 0 1 0 55.8 31 31 0 0 1 0-55.8Z" />
      <path class="te-aspect" d="M25 47L95 73" />
      <circle cx="25" cy="47" r="5" style="fill:var(--sign-gemini)" />
      <circle cx="95" cy="73" r="5" style="fill:var(--sign-libra)" />
      <circle class="te-dot" cx="60" cy="60" r="1.6" />
    </svg>
  )}
  {kind === 'horoscopes' && (
    <svg viewBox="0 0 120 120">
      <circle class="te-halo" cx="60" cy="60" r="58" />
      <path class="te-faint te-dash" d={`M${phases.map((p) => `${p.x} ${p.y}`).join('L')}`} />
      {phases.map((p) => (
        <g>
          <circle class="te-moon-dark" cx={p.x} cy={p.y} r="6" />
          {p.lit > 0 && p.lit < 1 && (
            <path
              style="fill:var(--sign-cancer)"
              d={`M${p.x} ${p.y - 6}a6 6 0 0 1 0 12a${(6 * Math.abs(1 - 2 * p.lit)).toFixed(2)} 6 0 0 ${p.lit < 0.5 ? 0 : 1} 0 -12Z`}
            />
          )}
          {p.lit === 1 && <circle cx={p.x} cy={p.y} r="6" style="fill:var(--sign-cancer)" />}
        </g>
      ))}
      <path class="te-ink" d="M14 90h92" />
      <path class="te-tick" d="M14 87v6M29.33 88v4M44.67 88v4M60 87v6M75.33 88v4M90.67 88v4M106 87v6" />
    </svg>
  )}
  {kind === 'moonrise' && (
    <svg viewBox="0 0 120 120">
      <circle class="te-halo" cx="60" cy="60" r="58" />
      <path class="te-faint" d="M16 82a44 44 0 0 1 88 0" />
      <path d="M54 30a16 16 0 1 0 14 24 13 13 0 0 1-14-24Z" style="fill:var(--sign-pisces)" />
      <path class="te-ink" d="M8 82h104" />
      <path class="te-ray" d="M30 96v-8M30 88l-3.5 3.5M30 88l3.5 3.5" />
      <circle cx="90" cy="82" r="4.6" style="fill:var(--sign-gemini)" />
      <path class="te-faint" d="M44 96h32" />
      <text class="te-label" x="90" y="100" text-anchor="middle">ASC</text>
    </svg>
  )}
</span>

<style>
  .tool-emblem {
    display: block;
    width: var(--emblem-size, 96px);
    aspect-ratio: 1;
    color: var(--text);
  }
  .tool-emblem svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .tool-emblem :global(.te-halo) { fill: rgba(198, 204, 218, 0.035); stroke: var(--hair-1); stroke-width: 1; }
  .tool-emblem :global(.te-ring) { fill: none; stroke: var(--ink-1); stroke-width: 1.1; }
  .tool-emblem :global(.te-tick) { fill: none; stroke: var(--ink-2); stroke-width: 0.9; stroke-linecap: round; }
  .tool-emblem :global(.te-faint) { fill: none; stroke: var(--hair-3); stroke-width: 1; stroke-linecap: round; }
  .tool-emblem :global(.te-dash) { stroke-dasharray: 1.5 4; stroke: var(--ink-2); }
  .tool-emblem :global(.te-ink) { fill: none; stroke: var(--ink-0); stroke-width: 1.3; stroke-linecap: round; }
  .tool-emblem :global(.te-ray) { fill: none; stroke: var(--sign-sagittarius); stroke-width: 1.4; stroke-linecap: round; }
  .tool-emblem--moonrise :global(.te-ray) { stroke: var(--ink-1); }
  .tool-emblem :global(.te-aspect) { fill: none; stroke: var(--ink-1); stroke-width: 0.9; stroke-dasharray: 3 3; opacity: 0.8; }
  .tool-emblem :global(.te-lens) { fill: rgba(211, 169, 222, 0.16); stroke: none; }
  .tool-emblem :global(.te-dot) { fill: var(--ink-0); }
  .tool-emblem :global(.te-moon-dark) { fill: var(--void-3); stroke: var(--hair-3); stroke-width: 0.8; }
  .tool-emblem :global(.te-label) { fill: var(--ink-2); font-family: var(--font-mono); font-size: 7px; letter-spacing: 0.08em; }
  .tool-emblem :global(.te-spin) { transform-origin: 60px 60px; transition: transform 1.6s var(--ease-soft, ease); }
  :global(a:hover) > * .tool-emblem :global(.te-spin),
  :global(a:hover) .tool-emblem :global(.te-spin) { transform: rotate(30deg); }
  @media (prefers-reduced-motion: reduce) {
    .tool-emblem :global(.te-spin) { transition: none; }
  }
</style>
