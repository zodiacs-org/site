---
/**
 * Tool-card icon: a crafted celestial glyph on a flat pastel disc, so the
 * calculators sit in the same visual language as the twelve sign icons
 * (pastel disc + dark line-art) rather than a thin mono symbol. The disc hue
 * comes from --sign, set on the enclosing tile. Drawings live in
 * src/lib/glyphs/paths.ts (TOOL_GLYPH), shared with the wider glyph set.
 */
import { TOOL_GLYPH } from '../lib/glyphs/paths';
import type { ToolGlyphKind } from '../lib/nav-tools';

interface Props {
  kind: ToolGlyphKind | 'assistant';
  label?: string;
}
const { kind, label } = Astro.props;
const markup = TOOL_GLYPH[kind] ?? '';
---
<span class="tool-glyph" role="img" aria-label={label ?? undefined} aria-hidden={label ? undefined : 'true'}>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={markup}
  ></svg>
</span>

<style>
  /* Flat pastel disc with a dark line glyph, the same treatment as the sign
     icon discs: no gradient, no glow. */
  .tool-glyph {
    display: inline-grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-bottom: 4px;
    border-radius: 50%;
    background: var(--sign);
    color: var(--void-0, #060709);
    box-shadow: none;
    transition: box-shadow var(--dur-1, 180ms) var(--ease, ease);
  }
  .tool-glyph svg {
    width: 24px;
    height: 24px;
    display: block;
  }
  /* The card's hover answers with a soft ring of the disc's own hue. */
  :global(.tile:hover) .tool-glyph {
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--sign) 22%, transparent);
  }
</style>
