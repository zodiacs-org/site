---
/**
 * The embeddable current-sky card. Fully standalone: no site chrome, no
 * webfonts, no network requests beyond the canonical sign icons from the
 * same origin. Both palettes ship in the page and key on `data-theme`; the
 * one inline script reads the host's `?theme=` / `?accent=` parameters and
 * nothing else. The backlink is the license.
 */
import daily from '../data/daily.json';
import { signBySlug } from '../lib/signs';
import { WIDGET_THEME_SCRIPT } from '../lib/widget-theme';
import {
  WIDGET_EN,
  widgetPhaseName,
  widgetPlanetName,
  widgetSignName,
  widgetText,
} from '../strings/widgets';

interface Props { theme?: 'dark' | 'light' }
const theme = Astro.props.theme ?? 'dark';

const positions = daily.bodies.map((b) => ({
  body: widgetPlanetName(b.body),
  sign: b.sign,
  label: `${Math.floor(b.degree)}° ${widgetSignName(signBySlug(b.sign)?.slug ?? b.sign)}`,
  rx: b.retrograde,
}));
const retro = daily.bodies.filter((b) => b.retrograde).map((b) => widgetPlanetName(b.body)).join(', ');
---
<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{WIDGET_EN.widgetTitleSky}</title>
    <style is:inline>
      :root{--w-bg:#0A0C11;--w-text:#EEF1F7;--w-mut:#8B93A7;--w-hair:rgba(198,204,218,0.14);--w-accent:#C6CCDA;color-scheme:dark}
      :root[data-theme=light]{--w-bg:#FBFAF7;--w-text:#1C1E26;--w-mut:#6B7183;--w-hair:rgba(28,30,38,0.14);--w-accent:#3C4152;color-scheme:light}
    </style>
    <script is:inline data-zodiacs-widget-theme set:html={WIDGET_THEME_SCRIPT}></script>
  </head>
  <body style="margin:0;background:var(--w-bg);color:var(--w-text);font:13px/1.5 system-ui,-apple-system,sans-serif;">
    <div style="padding:14px 16px;display:flex;flex-direction:column;gap:10px;min-height:calc(100vh - 28px);box-sizing:border-box;">
      <div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap;">
        <strong style="font-size:13px;letter-spacing:-0.01em;">{WIDGET_EN.skyTitle}</strong>
        <span style="font-family:ui-monospace,monospace;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:var(--w-mut);">{daily.date} · {widgetPhaseName(daily.moon.phase)}</span>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:4px 14px;">
        {positions.map((p) => (
          <span style="display:inline-flex;align-items:center;gap:5px;font-family:ui-monospace,monospace;font-size:11px;white-space:nowrap;color:var(--w-text);">
            <img src={`/assets/zodiac-icons/48/${p.sign}.webp`} alt="" width="18" height="18" decoding="async" />
            {p.body} {p.label}{p.rx ? ` ${WIDGET_EN.retrogradeAbbreviation}` : ''}
          </span>
        ))}
      </div>
      <div style="margin-top:auto;display:flex;justify-content:space-between;align-items:baseline;gap:10px;border-top:1px solid var(--w-hair);padding-top:8px;">
        <span style="font-size:11px;color:var(--w-mut);">{retro ? widgetText('retrograde', { planets: retro }) : WIDGET_EN.noRetrograde}</span>
        <a href="https://zodiacs.org/?utm_source=embed&amp;utm_medium=widget&amp;utm_campaign=sky" target="_blank" rel="noopener noreferrer" style="font-size:11px;color:var(--w-accent);text-decoration:none;border-bottom:1px solid var(--w-hair);white-space:nowrap;">{WIDGET_EN.poweredBy} →</a>
      </div>
    </div>
  </body>
</html>
