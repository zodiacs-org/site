---
export interface SourceLink {
  label: string;
  href?: string;
}

interface Props {
  sources?: SourceLink[];
  locale?: import('../lib/i18n').PageLocale;
}

const sources = Astro.props.sources ?? [];
const locale = Astro.props.locale ?? 'en';
const LABELS: Partial<Record<NonNullable<Props['locale']>, string>> = {
  ru: 'Источники',
  'zh-hans': '资料来源',
  'zh-hant': '資料來源',
};
const label = LABELS[locale] ?? 'Sources';
---
{sources.length > 0 && (
  <aside class="sources-line container container--narrow" aria-label={label}>
    <strong>{label}</strong>
    <span>
      {sources.map((source, index) => (
        <>
          {index > 0 && <span aria-hidden="true"> · </span>}
          {source.href
            ? <a href={source.href} rel="noopener noreferrer">{source.label}</a>
            : source.label}
        </>
      ))}
    </span>
  </aside>
)}

<style>
  .sources-line {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin-top: clamp(44px, 7vw, 76px);
    color: var(--faint);
    font-size: var(--text-xs);
    line-height: 1.6;
  }
  .sources-line strong {
    color: var(--muted);
    font-weight: 600;
  }
  .sources-line a { color: var(--muted); }
</style>
