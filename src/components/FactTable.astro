---
import type { Sign } from '../lib/signs';
import { ELEMENT_LABEL, MODALITY_LABEL } from '../lib/signs';

interface Props {
  sign: Sign;
  star: { name: string; note: string };
  babylonianRecord: string;
}
const { sign, star, babylonianRecord } = Astro.props;

const rows: [string, string][] = [
  ['Dates', sign.dates],
  ['Element', ELEMENT_LABEL[sign.element]],
  ['Modality', MODALITY_LABEL[sign.modality]],
  ['Ruling planet', sign.classicRuler ? `${sign.ruler} (${sign.classicRuler}, traditional)` : sign.ruler],
  ['Polarity', sign.polarity === 'day' ? 'Day (yang)' : 'Night (yin)'],
  ['Principal star', `${star.name}, ${star.note}`],
  ['Babylonian record', babylonianRecord],
];
---
<dl class="facts" style={`--sign:${sign.hue}`}>
  {rows.map(([k, v]) => (
    <div class="facts__row">
      <dt>{k}</dt>
      <dd>{v}</dd>
    </div>
  ))}
</dl>

<style>
  /* The panel carries the sign's own hue: a firm accent rule at the head and
     a faint tint threaded through each row's hairline — the pastel disc
     language, no decorative dots. */
  .facts {
    margin: 0;
    border-top: 2px solid color-mix(in oklab, var(--sign, var(--accent)) 52%, var(--hair-2));
  }
  .facts__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 18px;
    padding: 11px 0;
    border-bottom: 1px solid color-mix(in oklab, var(--sign, var(--accent)) 10%, var(--hair-1));
  }
  dt {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 12.5px;
    letter-spacing: 0;
    text-transform: none;
    font-variant-numeric: tabular-nums;
    color: var(--faint);
  }
  /* A short hue tick indexing each key — reads as structure, not a status dot. */
  dt::before {
    content: '';
    align-self: center;
    width: 6px;
    height: 2px;
    border-radius: 1px;
    background: color-mix(in oklab, var(--sign, var(--accent)) 60%, transparent);
  }
  dd {
    margin: 0;
    text-align: end;
    font-size: var(--text-sm);
    color: var(--text);
  }
</style>
