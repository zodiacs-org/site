---
/**
 * Where the Sun stands on a birthday, drawn on the server: the zodiac ring
 * turned so the date's sign (or, on a cusp date, the boundary) sits at the
 * top, the sign's decans with the date's decan lit, the span of noon
 * positions across the computed years as an arc on the outer track, and the
 * Sun at its middle. Longitude runs counter-clockwise, as on the site's
 * other wheels. Every number comes from src/data/birthdays.json.
 */
import SignIcon from '../SignIcon.astro';
import { SIGNS, formatLongitude, signIndexForLongitude, type Sign } from '../../lib/signs';
import { decanOrdinal, type CuspSummary, type DecanSpan } from '../../lib/birthdays';

interface Props {
  label: string;
  lonMin: number;
  lonMax: number;
  sign: Sign | null;
  cusp: CuspSummary | null;
  decan: DecanSpan | null;
}

const { label, lonMin, lonMax, sign, cusp, decan } = Astro.props;
const norm = (lon: number) => ((lon % 360) + 360) % 360;
const focus = sign ? [sign] : cusp ? [cusp.a, cusp.b] : [];
const focusIndex = focus.map((s) => SIGNS.findIndex((x) => x.slug === s.slug));
const center = sign ? focusIndex[0] * 30 + 15 : focusIndex[1] * 30;
const delta = (lon: number) => ((norm(lon - center) + 180) % 360) - 180;
const angle = (lon: number) => -90 - delta(lon);
const rad = (deg: number) => (deg * Math.PI) / 180;
const pt = (r: number, lon: number) => [r * Math.cos(rad(angle(lon))), r * Math.sin(rad(angle(lon)))] as const;
const f = (n: number) => n.toFixed(2);

function band(fromLon: number, toLon: number, r1: number, r2: number): string {
  const [x1, y1] = pt(r2, fromLon);
  const [x2, y2] = pt(r2, toLon);
  const [x3, y3] = pt(r1, toLon);
  const [x4, y4] = pt(r1, fromLon);
  const large = toLon - fromLon > 180 ? 1 : 0;
  return `M${f(x1)},${f(y1)} A${r2},${r2} 0 ${large} 0 ${f(x2)},${f(y2)} L${f(x3)},${f(y3)} A${r1},${r1} 0 ${large} 1 ${f(x4)},${f(y4)} Z`;
}

const R_OUT = 150;
const R_IN = 112;
const R_DEC = 100;
const R_TRACK = 163;
const slices = SIGNS.map((s, i) => ({
  sign: s,
  path: band(i * 30, i * 30 + 30, R_IN, R_OUT),
  lit: focusIndex.includes(i),
  icon: (() => {
    const [x, y] = pt(131, i * 30 + 15);
    return { left: ((x + 180) / 360) * 100, top: ((y + 200) / 362) * 100 };
  })(),
}));

// Decans of the focus sign(s); the lit ones are the date's.
const litDecans = new Set<string>();
if (sign && decan) for (let d = decan.lo; d <= decan.hi; d += 1) litDecans.add(`${focusIndex[0]}-${d}`);
if (cusp) {
  litDecans.add(`${focusIndex[0]}-3`);
  litDecans.add(`${focusIndex[1]}-1`);
}
const decans = focusIndex.flatMap((i) => [1, 2, 3].map((d) => {
  const from = i * 30 + (d - 1) * 10;
  const [tx, ty] = pt(106, from + 5);
  return { path: band(from + 0.4, from + 9.6, R_DEC, R_IN), lit: litDecans.has(`${i}-${d}`), label: ['I', 'II', 'III'][d - 1], tx: f(tx), ty: f(ty) };
}));

// Fine degree ticks inside the focus sign(s), coarse ones elsewhere.
const ticks: { x1: string; y1: string; x2: string; y2: string; fine: boolean }[] = [];
for (let lon = 0; lon < 360; lon += 1) {
  const inFocus = focusIndex.includes(Math.floor(lon / 30));
  if (!inFocus && lon % 5 !== 0) continue;
  if (lon % 30 === 0) continue;
  const r1 = inFocus ? R_DEC : R_IN;
  const len = inFocus ? (lon % 5 === 0 ? 5 : 3) : 4;
  const [x1, y1] = pt(r1, lon);
  const [x2, y2] = pt(r1 - len, lon);
  ticks.push({ x1: f(x1), y1: f(y1), x2: f(x2), y2: f(y2), fine: inFocus });
}

const lo = norm(lonMin);
const hi = lo + norm(lonMax - lonMin);
const mid = lo + (hi - lo) / 2;
const beam = (() => {
  const [x1, y1] = pt(R_DEC, lo - 1.5);
  const [x2, y2] = pt(R_DEC, hi + 1.5);
  return `M${f(x2)},${f(y2)} A${R_DEC},${R_DEC} 0 0 1 ${f(x1)},${f(y1)} L0,0 Z`;
})();
const [ax1, ay1] = pt(R_TRACK, lo);
const [ax2, ay2] = pt(R_TRACK, hi);
const [sx, sy] = pt(R_TRACK, mid);
const [lx, ly] = pt(R_TRACK + 21, mid);
const [kx1, ky1] = pt(R_OUT, mid);
const [kx2, ky2] = pt(R_OUT + 2, mid);

// The focus range's two ends, labelled with the table dates.
const MONTH_SHORT = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const ends = [
  { lon: focusIndex[0] * 30, date: focus[0].start, side: 'start' as const },
  { lon: focusIndex[focusIndex.length - 1] * 30 + 30, date: focus[focus.length - 1].end, side: 'end' as const },
].map((end) => {
  const [x1, y1] = pt(R_OUT, end.lon);
  const [x2, y2] = pt(R_TRACK - 2, end.lon);
  const [tx, ty] = pt(R_TRACK + 6, end.lon);
  return {
    x1: f(x1), y1: f(y1), x2: f(x2), y2: f(y2), tx: f(tx), ty: f(ty),
    anchor: end.side === 'start' ? 'start' : 'end',
    text: `${MONTH_SHORT[end.date[0] - 1]} ${end.date[1]}`,
  };
});

const centerName = sign ? sign.name : `${cusp!.a.name} or ${cusp!.b.name}`;
const spanText = `${formatLongitude(lonMin).replace(/ \S+$/u, '')} to ${formatLongitude(lonMax).replace(/ \S+$/u, '')}`;
const signOf = (lon: number) => SIGNS[signIndexForLongitude(lon)].name;
const decanText = sign && decan
  ? decan.lo === decan.hi
    ? `${decanOrdinal(decan.lo).replace(/^./u, (c) => c.toUpperCase())} decan · ${decan.ruler}`
    : `${decanOrdinal(decan.lo).replace(/^./u, (c) => c.toUpperCase())} or ${decanOrdinal(decan.hi)} decan`
  : 'The year decides';
const aria = sign
  ? `The zodiac ring with ${sign.name} at the top. On ${label} the Sun stands between ${formatLongitude(lonMin)} and ${formatLongitude(lonMax)}${decan && decan.lo === decan.hi ? `, in the ${decanOrdinal(decan.lo)} decan` : ''}.`
  : `The zodiac ring with the ${cusp!.a.name} and ${cusp!.b.name} boundary at the top. On ${label} the Sun stands between ${formatLongitude(lonMin)} and ${formatLongitude(lonMax)}, ${signOf(lonMin) === signOf(lonMax) ? '' : 'across the boundary, '}depending on the year.`;
const hue = (sign ?? cusp!.a).hue;
const gradient = `bday-dial-beam-${label.toLowerCase().replace(/\s+/gu, '-')}`;
---
<div class="bday-dial">
  <svg viewBox="-180 -200 360 362" role="img" aria-label={aria}>
    <defs>
      <linearGradient id={gradient} x1="0" y1="0" x2={f(pt(R_DEC, mid)[0])} y2={f(pt(R_DEC, mid)[1])} gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color={hue} stop-opacity="0" />
        <stop offset="1" stop-color={hue} stop-opacity="0.3" />
      </linearGradient>
    </defs>
    <circle r={R_OUT} fill="#0c0e15" stroke="rgba(198,204,218,0.22)" />
    {slices.map(({ sign: s, path, lit }) => (
      <path d={path} fill={s.hue} fill-opacity={lit ? 0.22 : 0.045} stroke="rgba(198,204,218,0.14)" />
    ))}
    {decans.map((d) => (
      <>
        <path d={d.path} fill={hue} fill-opacity={d.lit ? 0.5 : 0.12} />
        <text x={d.tx} y={d.ty} text-anchor="middle" dominant-baseline="central" font-size="7.5" font-weight="600" fill={d.lit ? '#060709' : 'rgba(198,204,218,0.55)'}>{d.label}</text>
      </>
    ))}
    {ticks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke={t.fine ? 'rgba(198,204,218,0.28)' : 'rgba(198,204,218,0.12)'} />)}
    <circle r={R_DEC} fill="none" stroke="rgba(198,204,218,0.12)" />
    <circle r="84" fill="none" stroke="rgba(198,204,218,0.12)" />
    <path d={beam} fill={`url(#${gradient})`} />
    <circle r={R_TRACK} fill="none" stroke="rgba(198,204,218,0.08)" />
    {ends.map((e) => (
      <>
        <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke="rgba(198,204,218,0.3)" />
        <text x={e.tx} y={e.ty} text-anchor={e.anchor} dominant-baseline="central" font-size="10" fill="rgba(198,204,218,0.62)">{e.text}</text>
      </>
    ))}
    <path d={`M${f(ax1)},${f(ay1)} A${R_TRACK},${R_TRACK} 0 0 0 ${f(ax2)},${f(ay2)}`} fill="none" stroke="#EEF1F7" stroke-width="4" stroke-linecap="round" />
    <line x1={f(kx1)} y1={f(ky1)} x2={f(kx2)} y2={f(ky2)} stroke="rgba(238,241,247,0.55)" />
    <circle cx={f(sx)} cy={f(sy)} r="11.5" fill="#EEF1F7" stroke="#060709" stroke-width="3" />
    <circle cx={f(sx)} cy={f(sy)} r="5.2" fill="none" stroke="#060709" stroke-width="1.4" />
    <circle cx={f(sx)} cy={f(sy)} r="1.3" fill="#060709" />
    <text x={f(lx)} y={f(ly)} text-anchor="middle" dominant-baseline="central" font-size="11" font-weight="600" fill="#EEF1F7">{label}</text>
    <text x="0" y="-28" text-anchor="middle" font-size="10" fill="rgba(198,204,218,0.62)">The Sun on {label}</text>
    <text class="bday-dial__name" x="0" y="4" text-anchor="middle" font-size={sign ? 33 : 22} fill="#EEF1F7">{centerName}</text>
    <text x="0" y="24" text-anchor="middle" font-size="10" fill="#C6CCDA">{spanText}</text>
    <text x="0" y="42" text-anchor="middle" font-size="9.5" font-weight="600" fill={hue}>{decanText}</text>
  </svg>
  {slices.map(({ sign: s, icon, lit }) => (
    <span class:list={['bday-dial__disc', lit && 'bday-dial__disc--lit']} style={`left:${icon.left.toFixed(3)}%;top:${icon.top.toFixed(3)}%`}>
      <SignIcon sign={s.slug} size={24} webpOnly />
    </span>
  ))}
</div>

<style>
  .bday-dial { position: relative; width: 100%; aspect-ratio: 360 / 362; }
  .bday-dial svg { display: block; width: 100%; height: 100%; font-family: var(--font-sans); font-variant-numeric: tabular-nums; }
  .bday-dial__name { font-family: var(--font-serif); font-weight: 500; }
  .bday-dial__disc { position: absolute; width: 5.8%; transform: translate(-50%, -50%); line-height: 0; opacity: 0.5; }
  .bday-dial__disc--lit { width: 8.3%; opacity: 1; }
  .bday-dial__disc :global(.sign-icon) { width: 100%; }
</style>
