---
import type { Heritage } from '../lib/legacy/sign-lore';
import { plainDashes } from '../lib/legacy/sign-lore';

interface Props {
  lore: Heritage;
  hue: string;
}
const { lore, hue } = Astro.props;

const beats = [
  ...(lore.provenancePrelude ? [lore.provenancePrelude] : []),
  { era: 'c. 1000 BC', place: 'Babylon', body: lore.provenanceBabylon },
  {
    era: 'c. 450 BC', place: 'Babylon',
    body: 'Fixed as one of twelve equal signs when Babylonian astronomers divide the sun’s path into the first zodiac, the frame still in use today.',
  },
  { era: 'c. 270 BC', place: 'The Hellenistic world', body: lore.provenanceGreece },
  {
    era: 'AD 150', place: 'Alexandria',
    body: 'Canonized in Ptolemy’s Almagest among the forty-eight classical constellations; carried through the Arabic observatories into medieval Europe.',
  },
  {
    era: 'AD 1515', place: 'Nuremberg',
    body: 'Engraved in Albrecht Dürer’s celestial planispheres, the first printed star charts of the Western sky.',
  },
];
---
<ol class="timeline" style={`--sign:${hue};--beats:${beats.length}`}>
  {beats.map((b) => (
    <li class="timeline__item">
      <b class="timeline__era">{b.era}</b>
      <em class="timeline__place">{b.place}</em>
      <p>{plainDashes(b.body)}</p>
    </li>
  ))}
</ol>

<style>
  /* Across the page on wide screens, down the left edge on phones. */
  .timeline {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--beats, 5), minmax(0, 1fr));
    gap: 20px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 6px;
    height: 1px;
    background: linear-gradient(90deg, var(--sign), var(--hair-2) 70%);
    opacity: 0.7;
  }
  .timeline__item { position: relative; padding-top: 28px; }
  .timeline__item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--void-0);
    border: 1.5px solid var(--sign);
  }
  .timeline__era {
    display: block;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.35rem;
    line-height: 1.1;
    color: var(--ink-0);
    font-variant-numeric: lining-nums;
  }
  .timeline__place { display: block; margin-top: 4px; font-style: normal; font-size: 13px; color: var(--sign); }
  .timeline__item p { margin: 10px 0 0; font-size: 0.875rem; line-height: 1.55; color: var(--muted); }
  @media (max-width: 760px) {
    .timeline { grid-template-columns: minmax(0, 1fr); gap: 0; margin-top: 36px; }
    .timeline::before {
      left: 6px;
      right: auto;
      top: 6px;
      bottom: 6px;
      width: 1px;
      height: auto;
      background: linear-gradient(180deg, var(--sign), var(--hair-2) 80%);
    }
    .timeline__item { padding: 0 0 26px 32px; }
    .timeline__item:last-child { padding-bottom: 0; }
    .timeline__era { font-size: 1.2rem; }
    .timeline__item p { margin-top: 6px; }
  }
</style>
