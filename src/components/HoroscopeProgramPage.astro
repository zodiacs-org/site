    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--hair-1);
  }
  .hz-pg {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 50%;
    background: var(--c);
    color: #0b0d12;
  }
  .hz-pg :global(svg) { width: 19px; height: 19px; }
  .hz-sky__row strong { display: block; color: var(--ink-0); font-size: 0.9375rem; font-weight: 600; line-height: 1.3; }
  .hz-sky__m { display: block; margin-top: 3px; color: var(--muted); font-size: 0.8125rem; line-height: 1.45; }
  .hz-sky__row time { padding-top: 2px; color: var(--ink-2); font-size: 0.8125rem; white-space: nowrap; }
  .hz-sky__also { margin: 14px 0 0; color: var(--faint); font-size: 0.8125rem; line-height: 1.5; }
  .hz-sky__link { margin-top: 14px; font-size: 0.875rem; }

  .hz-rail :global(.upcoming-events) { border-color: var(--hair-2); border-radius: 18px; }
  .hz-rail :global(.email-capture) {
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    margin: 0;
    padding: 22px;
    border-radius: 18px;
  }
  .hz-rail :global(.email-capture h2) { margin-top: 0; font-family: var(--font-sans); font-size: 1.06rem; font-weight: 600; line-height: 1.3; }
  .hz-rail :global(.email-capture__email-row) { grid-template-columns: minmax(0, 1fr); }
  .hz-rail :global(.email-capture__submit) { width: 100%; }

  /* DailyForYou (saved charts only) keeps its reserved geometry. */
  .program :global(.dfy) {
    display: grid;
    gap: 12px;
    margin-top: 32px;
    padding: clamp(16px, 3vw, 22px);
    border: 1px solid color-mix(in oklab, var(--sign) 30%, transparent);
    border-radius: var(--r-md);
    background: color-mix(in oklab, var(--sign) 4%, transparent);
  }
  .program :global(.dfy--placeholder) { display: none; visibility: hidden; }
  .program :global(.dfy__placeholder-copy),
  .program :global(.dfy__quiet p) { margin: 0; color: var(--muted); font-size: var(--text-sm); line-height: 1.6; }
  :global(:root[data-dfy-saved-chart]) .program :global(.dfy--placeholder) {
    display: grid;
