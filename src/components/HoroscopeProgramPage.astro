---
import Base from '../layouts/Base.astro';
import AskGuideLine from './AskGuideLine.astro';
import GuideQuickPrompts from './GuideQuickPrompts.astro';
import EmailCapture from './EmailCapture.astro';
import Faq from './Faq.astro';
import RaceRamp from './RaceRamp.astro';
import ShareRow from './ShareRow.astro';
import SignIcon from './SignIcon.astro';
import UpcomingEventLinks from './events/UpcomingEventLinks.astro';
import EditionText from './EditionText.astro';
import { datedEditionText } from '../lib/edition-freshness';
import { EDITOR_AUTHOR } from '../lib/editorial';
import { SIGNS, signBySlug } from '../lib/signs';
import type {
  HoroscopePageSurface as HoroscopeSurface,
  HoroscopeProgramPageReading,
} from '../lib/horoscope-page-data';

interface Props {
  signSlug: string;
  surface: HoroscopeSurface;
  reading: HoroscopeProgramPageReading;
}

const { signSlug, surface, reading } = Astro.props;
const sign = signBySlug(signSlug);

// Ready questions for Guide, one row per surface. The third always points
// back to the visitor's own chart, which is where a horoscope stops being
// general.
const CHART_PROMPT = 'How do I read this against my birth chart?';
const QUICK_PROMPTS: Record<HoroscopeSurface, readonly string[]> = {
  today: [
    `What does today’s sky mean for ${sign.name}?`,
    'Which of today’s transits matters most for me?',
    CHART_PROMPT,
  ],
  tomorrow: [
    `What should ${sign.name} get ready for tomorrow?`,
    'What changes between today and tomorrow?',
    CHART_PROMPT,
  ],
  weekly: [
    `Which days this week matter most for ${sign.name}?`,
    'How should I pace this week?',
    CHART_PROMPT,
  ],
  monthly: [
    `What are the key dates this month for ${sign.name}?`,
    'Which of this month’s transits touches my chart?',
    CHART_PROMPT,
  ],
  love: [
    'How does this apply to my relationship right now?',
    `What does ${sign.name} need in love this week?`,
    CHART_PROMPT,
  ],
  career: [
    'How do I use this at work this week?',
    `Which of these transits affects ${sign.name} at work?`,
    CHART_PROMPT,
  ],
  year: [
    `What are the big themes of 2027 for ${sign.name}?`,
    `Which 2027 transits should ${sign.name} plan around?`,
    CHART_PROMPT,
  ],
};

const SURFACE_META = {
  today: {
    slug: '',
    nav: 'Daily',
    kicker: 'Daily horoscope',
    faq: 'Your daily horoscope highlights the themes most likely to matter today, with one practical way to work with them.',
  },
  tomorrow: {
    slug: 'tomorrow',
    nav: 'Tomorrow',
    kicker: 'Next-day outlook',
    faq: 'It gives you an early look at tomorrow’s emotional tone, priorities, and one useful way to prepare.',
  },
  weekly: {
    slug: 'weekly',
    nav: 'Weekly',
    kicker: 'Seven-day outlook',
    faq: 'A weekly horoscope widens the frame from one day to the choices and themes that can develop across seven days.',
  },
  monthly: {
    slug: 'monthly',
    nav: 'Monthly',
    kicker: 'Monthly outlook',
    faq: 'A monthly horoscope follows the month’s dated lunations, stations, ingresses, and major aspects through the solar houses of your sun sign.',
  },
  love: {
    slug: 'love',
    nav: 'Love',
    kicker: 'Relationships',
    faq: 'A love horoscope narrows the current sky to relating, attraction, boundaries, and repair. Your Venus, Moon, Mars, and seventh house add much more personal detail.',
  },
  career: {
    slug: 'career',
    nav: 'Career',
    kicker: 'Work and direction',
    faq: 'A career horoscope narrows the current sky to work, reputation, money, collaboration, and decision-making. Your full chart can change where those themes land.',
  },
  year: {
    slug: '2027',
    nav: '2027',
    kicker: 'Year ahead',
    faq: 'A year-ahead sun-sign horoscope is a broad map of the year’s major cycles. A birth time allows a personal chart to place those cycles in your actual houses.',
  },
} as const;

const meta = SURFACE_META[surface];
const path = meta.slug
  ? `/horoscopes/${sign.slug}/${meta.slug}/`
  : `/horoscopes/${sign.slug}/`;
const ogImage = `/assets/og/v2/horoscope/${sign.slug}${meta.slug ? `-${meta.slug}` : ''}.png`;
const canonicalUrl = `https://zodiacs.org${path}`;
const hasEditorial = Astro.slots.has('editorial');
const hasEnhancement = Astro.slots.has('enhancement');
// These compact heroes make the sign icon the largest visible element on
// phones. Use the smaller derivative on their first-paint path, as Daily does.
const compactHeroIcon = surface === 'today' || surface === 'love' || surface === 'career';
const editionDate = surface === 'today' ? reading.datePublished.slice(0, 10) : null;
const displayText = (value: string) => editionDate ? datedEditionText(value, editionDate) : value;

const faq = [
  {
    q: `What does this ${sign.name} ${meta.nav.toLowerCase()} horoscope cover?`,
    a: displayText(meta.faq),
  },
  {
    q: `Is this reading only for people with ${sign.name} as their Sun sign?`,
    a: `Start with ${sign.name} as your Sun sign. If you know your rising sign, read that too; your full birth chart gives the most personal picture.`,
  },
  {
    q: `How should ${sign.name} use this reading?`,
    a: `Take the part that feels useful, turn it into one question or action, and let your own judgment lead.`,
  },
];

const jsonLd = [
  {
    '@type': 'Article',
    headline: `${sign.name} ${reading.title} — ${reading.label}`,
    description: displayText(reading.description),
    url: canonicalUrl,
    datePublished: reading.datePublished,
    dateModified: reading.dateModified,
    author: EDITOR_AUTHOR,
    publisher: { '@id': 'https://zodiacs.org/#org' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
    inLanguage: 'en',
    image: `https://zodiacs.org${ogImage}`,
    about: [
      { '@type': 'Thing', name: `${sign.name} (astrology)` },
      { '@type': 'Thing', name: `${meta.nav} horoscope` },
    ],
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Horoscopes', item: 'https://zodiacs.org/horoscopes/' },
      { '@type': 'ListItem', position: 3, name: sign.name, item: `https://zodiacs.org/horoscopes/${sign.slug}/` },
      ...(meta.slug ? [{ '@type': 'ListItem', position: 4, name: meta.nav, item: canonicalUrl }] : []),
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];

const periodLinks = Object.entries(SURFACE_META).map(([key, item]) => ({
  key,
  label: item.nav,
  href: item.slug
    ? `/horoscopes/${sign.slug}/${item.slug}/`
    : `/horoscopes/${sign.slug}/`,
}));
const skyMarkers = reading.skyStrip.markers;
---
<Base
  inlineCriticalCss={compactHeroIcon}
  stableTypography
  title={`${sign.name} ${reading.title} — ${reading.label} | Zodiacs.org`}
  description={displayText(reading.description)}
  path={path}
  image={ogImage}
  imageAlt={`${sign.name} ${meta.nav.toLowerCase()} horoscope — Zodiacs.org`}
  type="article"
  jsonLd={jsonLd}
  editionDate={editionDate ?? undefined}
  rssFeed={{
    href: `/feeds/horoscopes/${sign.slug}.xml`,
    title: `Zodiacs.org — ${sign.name} daily horoscope`,
  }}
>
  {surface === 'today' && (
    <script slot="head" is:inline define:vars={{ dailyEnhancementSign: sign.slug }}>
      /* Route-local first-paint hint for DailyForYou. Only the current sign is
         tested, and no chart data is copied out of local storage. */
      try {
        var syncDailyForYouHint = function () {
          document.documentElement.removeAttribute('data-dfy-saved-chart');
          if (document.documentElement.hasAttribute('data-account-sync-v2')
            && (!window.zodiacsProfileAccess || !window.zodiacsProfileAccess.canRead())) return;
          var rawProfile = localStorage.getItem('zodiacs.profile.v1');
          var profile = rawProfile ? JSON.parse(rawProfile) : null;
          var signNames = ['aries', 'taurus', 'gemini', 'cancer', 'leo', 'virgo', 'libra', 'scorpio', 'sagittarius', 'capricorn', 'aquarius', 'pisces'];
          var matchingChart = profile && profile.version === 1 && Array.isArray(profile.charts)
            && profile.charts.some(function (chart) {
              if (!chart || typeof chart.name !== 'string' || typeof chart.updatedAt !== 'string') return false;
              var bodies = chart && chart.summary && chart.summary.bodies;
              if (!Array.isArray(bodies)) return false;
              var sun = bodies.find(function (body) {
                return body && body.body === 'Sun' && Number.isFinite(body.lon);
              });
              if (!sun) return false;
              var longitude = ((sun.lon % 360) + 360) % 360;
              return signNames[Math.floor(longitude / 30)] === dailyEnhancementSign;
            });
          if (matchingChart) document.documentElement.setAttribute('data-dfy-saved-chart', '');
        };
        syncDailyForYouHint();
        window.addEventListener('zodiacs:profile-access', syncDailyForYouHint);
      } catch (error) {}
    </script>
  )}
  <article
    class="program container container--narrow"
    style={`--sign:${sign.hue}`}
    data-edition-content={editionDate ? 'true' : undefined}
  >
    <nav class="program__crumbs mono" aria-label="Breadcrumb">
      <a href="/horoscopes/">Horoscopes</a><span aria-hidden="true">/</span>
      {meta.slug ? (
        <>
          <a href={`/horoscopes/${sign.slug}/`}>{sign.name}</a><span aria-hidden="true">/</span>
          <span aria-current="page">{meta.nav}</span>
        </>
      ) : <span aria-current="page">{sign.name}</span>}
    </nav>

    <header class="program__hero">
      <SignIcon
        sign={sign.slug}
        size={88}
        loading="eager"
        fetchPriority="high"
        webpOnly={compactHeroIcon}
        decoding={compactHeroIcon ? 'sync' : 'async'}
        class="program__icon"
      />
      <div class="program__hero-copy">
        <em class="kicker">{meta.kicker} · {reading.label}</em>
        <h1 class="display">{sign.name} {reading.title}</h1>
        <p class="program__description">
          {editionDate
            ? <EditionText current={reading.description} editionDate={editionDate} />
            : reading.description}
        </p>
        <span class="program__dates mono">{sign.dates} · {sign.element} · {sign.modality} · ruled by {sign.ruler}</span>
      </div>
    </header>

    <nav class="program__periods" aria-label={`${sign.name} horoscope periods`}>
      {periodLinks.map((item) => (
        <a
          href={item.href}
          aria-current={item.key === surface ? 'page' : undefined}
          class:list={{ program__period: true, 'program__period--active': item.key === surface }}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <section class="program__reading" aria-labelledby="reading-heading">
      <div class="program__reading-head">
        <span class="mono">The reading</span>
        <h2 id="reading-heading">
          {editionDate ? <EditionText current={reading.intro} editionDate={editionDate} /> : reading.intro}
        </h2>
      </div>

      {hasEditorial && (
        <div class="program__editorial prose">
          <slot name="editorial" />
        </div>
      )}

      {hasEnhancement && <slot name="enhancement" />}

      {reading.sections.length > 0 && (
        <div class="program__sections">
          {reading.sections.map((section) => (
            <section class="program__section">
              <h3>
                {editionDate ? <EditionText current={section.heading} editionDate={editionDate} /> : section.heading}
              </h3>
              <p>
                {editionDate ? <EditionText current={section.body} editionDate={editionDate} /> : section.body}
              </p>
            </section>
          ))}
        </div>
      )}

      <AskGuideLine lead="Questions about this reading, or what it means for your chart?" />
      <GuideQuickPrompts prompts={QUICK_PROMPTS[surface]} />

    </section>

    {skyMarkers.length > 0 && (
      <aside class="program__sky" aria-label={displayText(reading.skyStrip.label)}>
        <div class="program__sky-heading">
          <span class="program__sky-dot" aria-hidden="true"></span>
          <span class="mono">
            {editionDate
              ? <EditionText current={reading.skyStrip.label} editionDate={editionDate} />
              : reading.skyStrip.label}
          </span>
        </div>
        <div class="program__sky-markers">
          {skyMarkers.map((marker) => (
            <p class="program__sky-marker">
              <span class="mono">{marker.label}</span>
              {marker.datetime
                ? <time datetime={marker.datetime}>{marker.value}</time>
                : <strong>{marker.value}</strong>}
            </p>
          ))}
        </div>
      </aside>
    )}

    {surface === 'today' && (
      <UpcomingEventLinks date={reading.datePublished.slice(0, 10)} compact />
    )}

    <details class="program__basis">
      <summary>
        <span class="program__basis-summary">
          <strong>Behind this reading</strong>
          <small>Exact sky, dates, and method</small>
        </span>
        <span class="program__basis-open" aria-hidden="true">+</span>
        <span class="program__basis-close" aria-hidden="true">−</span>
      </summary>
      <div class="program__basis-body">
        <p class="program__description">
          {editionDate ? <EditionText current={reading.sourceNote} editionDate={editionDate} /> : reading.sourceNote}
        </p>
        {reading.sections.some((section) => section.receipt) && (
          <ul class="program__basis-receipts">
            {reading.sections.filter((section) => section.receipt).map((section) => (
              <li>
                <strong>{section.heading}</strong>
                <span class="mono">{section.receipt}</span>
              </li>
            ))}
          </ul>
        )}
        <div class="program__basis-links">
          <a href="/methodology/">Read our method and sources →</a>
          <a href={`/feeds/horoscopes/${sign.slug}.xml`} type="application/rss+xml">Follow {sign.name} by RSS →</a>
        </div>
      </div>
    </details>

    <EmailCapture placement="horoscopes" sign={sign.slug} />

    <section class="program__faq" aria-label={`${sign.name} ${meta.nav.toLowerCase()} horoscope questions`}>
      <Faq items={faq} heading={`${sign.name} ${meta.nav.toLowerCase()} horoscope, answered`} />
    </section>

    <ShareRow text={`${sign.name} ${reading.title} — ${reading.label}`} url={canonicalUrl} />

    <a class="program__guide-link" href={`/${sign.slug}/`}>Full {sign.name} guide →</a>

    <RaceRamp signName={sign.name} gap="28px" />

    <nav class="program__signs" aria-label={`Other signs for ${meta.nav.toLowerCase()} horoscopes`}>
      <span class="program__signs-head">The other eleven signs</span>
      <div class="program__sign-grid">
        {SIGNS.filter((other) => other.slug !== sign.slug).map((other) => (
          <a
            href={meta.slug ? `/horoscopes/${other.slug}/${meta.slug}/` : `/horoscopes/${other.slug}/`}
            style={`--other-sign:${other.hue}`}
          >
            <SignIcon sign={other.slug} size={20} />
            <span>{other.name}</span>
          </a>
        ))}
      </div>
    </nav>
  </article>
</Base>

<style>
  .program {
    display: grid;
    gap: clamp(26px, 5vw, 44px);
    padding-block: clamp(22px, 5vw, 52px) clamp(42px, 7vw, 76px);
  }
  .program__guide-link {
    width: fit-content;
    color: var(--text-2);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-style: italic;
    text-decoration-color: color-mix(in srgb, var(--sign) 52%, transparent);
    text-underline-offset: 5px;
  }
  .program__guide-link:hover { color: var(--sign); }
  .program__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    color: var(--faint);
    font-size: 10px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .program__crumbs a { color: inherit; text-decoration: none; }
  .program__crumbs a:hover { color: var(--text); }

  .program__hero { display: flex; align-items: center; gap: clamp(18px, 4vw, 32px); }
  :global(.program__icon) {
    width: clamp(66px, 9vw, 88px);
    height: clamp(66px, 9vw, 88px);
    filter: drop-shadow(0 16px 36px color-mix(in oklab, var(--sign) 28%, transparent));
  }
  .program__hero-copy { min-width: 0; }
  .program__hero h1 {
    margin: 10px 0 12px;
    font-size: clamp(2.25rem, 1.6rem + 3vw, 4rem);
    line-height: 0.98;
    text-wrap: balance;
  }
  .program__hero p {
    max-width: 61ch;
    margin: 0 0 12px;
    color: var(--text-2);
    font-size: var(--text-lg);
    line-height: 1.55;
    text-wrap: pretty;
  }
  @media (max-width: 599px) { .program__description { display: none; } .program__hero h1 { margin-bottom: 8px; } }
  .program__dates { color: var(--faint); font-size: 12px; letter-spacing: 0.03em; text-transform: uppercase; }

  .program__periods {
    display: flex;
    gap: 7px;
    overflow-x: auto;
    padding: 4px 0 8px;
    scrollbar-width: thin;
  }
  .program__period {
    flex: 0 0 auto;
    display: inline-flex; align-items: center; min-height: 44px; padding: 7px 14px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-full);
    color: var(--muted);
    font-size: 12px;
    text-decoration: none;
  }
  .program__period:hover { color: var(--text); border-color: var(--hair-2); }
  .program__period--active {
    color: var(--text);
    border-color: color-mix(in oklab, var(--sign) 48%, transparent);
    background: color-mix(in oklab, var(--sign) 11%, transparent);
  }

  .program__sky {
    position: relative;
    display: grid;
    grid-template-columns: minmax(112px, 0.42fr) minmax(0, 1.58fr);
    align-items: center;
    gap: 14px clamp(20px, 4vw, 38px);
    overflow: hidden;
    padding: 14px clamp(14px, 3vw, 20px);
    border-block: 1px solid var(--hair-1);
    background: color-mix(in oklab, var(--sign) 3%, transparent);
  }
  .program__sky::before {
    position: absolute;
    inset: -1px auto auto 0;
    width: clamp(72px, 18%, 150px);
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in oklab, var(--sign) 72%, white), transparent);
    content: '';
    opacity: 0.72;
    transform: translateX(-110%);
    animation: program-sky-drift 12s linear infinite;
    pointer-events: none;
  }
  .program__sky-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .program__sky-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sign);
    box-shadow: 0 0 12px color-mix(in oklab, var(--sign) 45%, transparent);
  }
  .program__sky-markers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px clamp(16px, 3vw, 28px);
  }
  .program__sky-marker {
    display: grid;
    min-width: 0;
    gap: 3px;
    margin: 0;
  }
  .program__sky-marker > span {
    color: var(--faint);
    font-size: 8px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .program__sky-marker time,
  .program__sky-marker strong {
    overflow-wrap: anywhere;
    color: var(--text-2);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.45;
  }
  @keyframes program-sky-drift {
    0% { opacity: 0; transform: translateX(-110%); }
    12% { opacity: 0.72; }
    76% { opacity: 0.72; }
    100% { opacity: 0; transform: translateX(760%); }
  }

  .program__reading { display: grid; gap: clamp(24px, 4vw, 34px); }
  .program__reading-head { display: grid; gap: 9px; max-width: 66ch; }
  .program__reading-head > span {
    color: var(--faint);
    font-size: 10px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .program__reading-head h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 1.3rem + 1.5vw, 2.45rem);
    font-weight: 500;
    line-height: 1.18;
    text-wrap: balance;
  }
  .program__editorial { max-width: 68ch; }
  .program__sections { display: grid; gap: 12px; }
  .program__section {
    padding: clamp(18px, 3vw, 24px);
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: color-mix(in oklab, var(--sign) 3%, var(--void-1));
  }
  .program__section h3 { margin: 0 0 8px; font-size: var(--text-lg); letter-spacing: -0.01em; }
  .program__section p { margin: 0; color: var(--text-2); line-height: 1.68; text-wrap: pretty; }
  .program__basis {
    border-block: 1px solid var(--hair-1);
  }
  .program__basis summary {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 2px;
    color: var(--muted);
    cursor: pointer;
    list-style: none;
  }
  .program__basis summary::-webkit-details-marker { display: none; }
  .program__basis summary:focus-visible {
    outline: 2px solid color-mix(in oklab, var(--sign) 65%, white);
    outline-offset: 4px;
    border-radius: var(--r-sm);
  }
  .program__basis-summary { display: grid; gap: 2px; }
  .program__basis-summary strong { color: var(--text-2); font-size: var(--text-sm); }
  .program__basis-summary small { color: var(--faint); font-size: 11px; }
  .program__basis-open,
  .program__basis-close { color: var(--faint); font-size: 20px; line-height: 1; }
  .program__basis-close,
  .program__basis[open] .program__basis-open { display: none; }
  .program__basis[open] .program__basis-close { display: inline; }
  .program__basis-body {
    display: grid;
    gap: 16px;
    padding: 4px 2px 20px;
    border-top: 1px solid var(--hair-1);
  }
  .program__basis-body > p { margin: 0; max-width: 68ch; color: var(--muted); font-size: var(--text-sm); line-height: 1.6; }
  .program__basis-receipts {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .program__basis-receipts li {
    color: var(--faint);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.04em;
  }
  .program__basis-receipts li { display: grid; gap: 2px; }
  .program__basis-receipts strong { color: var(--muted); font-family: var(--font-sans); font-size: 11px; letter-spacing: 0; }
  .program__basis-links { display: flex; flex-wrap: wrap; gap: 7px 18px; }
  .program__basis-links a { color: var(--text-2); font-size: var(--text-sm); }
  @media (hover: hover) and (pointer: fine) {
    .program__basis summary:hover { color: var(--text); }
  }

  .program :global(.email-capture) { margin: 0; }
