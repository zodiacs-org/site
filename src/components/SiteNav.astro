---
import { showsCollectionNavigation } from '../lib/trust-boundary';
/**
 * Floating pill navigation. The Signs item opens a 12-icon pastel grid —
 * the icons are the navigation. The profile glyph fills once the visitor
 * has saved something (read from localStorage, progressive).
 */
import { SIGNS, signDates, signName } from '../lib/signs';
import SignIcon from './SignIcon.astro';
import { availableLocalesForPath, englishOnlyCue, localizePath, normalizeCatalogLocale, t, type CatalogLocale as Locale } from '../lib/i18n';
import { ALL_TOOLS_LABEL, NAV_MORE, NAV_MORE_LABEL, NAV_TOOLS, navToolLabelHasEnglishCue, type NavTool } from '../lib/nav-tools';

interface Props { locale?: Locale }
const locale = normalizeCatalogLocale(Astro.props.locale);
const showCollection = showsCollectionNavigation(Astro.url.pathname);
const path = Astro.url.pathname;
const hasDailyReading = availableLocalesForPath('/today/')?.includes(locale) ?? false;
const todayLabel = t(locale, 'today').replace(/^./u, (letter) => letter.toLocaleUpperCase(locale));
const links = [
  ...(hasDailyReading ? [{ href: '/today/', label: todayLabel }] : []),
  { href: '/learn/', label: t(locale, 'navLearn') },
  { href: '/horoscopes/', label: t(locale, 'navHoroscopes') },
] as const;
const developersLabel: Record<Locale, string> = {
  en: 'Developers', es: 'Desarrolladores', pt: 'Desenvolvedores', fr: 'Développeurs', it: 'Sviluppatori', ru: 'Разработчикам',
};
const astrofolioLabel: Record<Locale, string> = {
  en: 'Official Zodiac token collection',
  es: 'Colección oficial de tokens del Zodiaco — en inglés',
  pt: 'Coleção oficial de tokens do Zodíaco — em inglês',
  fr: 'Collection officielle de jetons du Zodiaque — en anglais',
  it: 'Collezione ufficiale di token zodiacali — in inglese',
  ru: 'Официальная коллекция токенов Зодиака — на английском',
};
// Short explanations keep the navigation labels stable while making each destination clear.
const destinationDescription: Record<Locale, { today: string; horoscope: string; saved: string }> = {
  en: { today: 'Your daily reading and personal chart highlights', horoscope: 'Daily readings for your zodiac sign', saved: 'Your birth chart and the people you’ve added' },
  es: { today: 'Notas del cielo de hoy para cada signo', horoscope: 'Lecturas diarias para tu signo', saved: 'Tu carta natal y las personas que has agregado' },
  pt: { today: 'Notas do céu de hoje para cada signo', horoscope: 'Leituras diárias para seu signo', saved: 'Seu mapa astral e as pessoas que você adicionou' },
  fr: { today: 'Le ciel du jour, signe par signe', horoscope: 'Lectures quotidiennes pour ton signe', saved: 'Ton thème astral et les personnes que tu as ajoutées' },
  it: { today: 'Il cielo di oggi, segno per segno', horoscope: 'Letture quotidiane per il tuo segno', saved: 'Il tuo tema natale e le persone che hai aggiunto' },
  ru: { today: 'Небо сегодня для каждого знака', horoscope: 'Ежедневный гороскоп для вашего знака', saved: 'Ваша натальная карта и добавленные люди' },
};
const destination = destinationDescription[locale];
const searchLabel: Record<Locale, string> = {
  en: 'Search the site',
  es: 'Buscar en el sitio',
  pt: 'Pesquisar no site',
  fr: 'Rechercher sur le site',
  it: 'Cerca nel sito',
  ru: 'Поиск по сайту',
};
const openMenuLabel: Record<Locale, string> = {
  en: 'Open menu',
  es: 'Abrir menú',
  pt: 'Abrir menu',
  fr: 'Ouvrir le menu',
  it: 'Apri menu',
  ru: 'Открыть меню',
};
const closeMenuLabel: Record<Locale, string> = {
  en: 'Close menu',
  es: 'Cerrar menú',
  pt: 'Fechar menu',
  fr: 'Fermer le menu',
  it: 'Chiudi menu',
  ru: 'Закрыть меню',
};
const profileLabel: Record<Locale, string> = {
  en: 'Your profile', es: 'Tu perfil', pt: 'Seu perfil', fr: 'Ton profil', it: 'Il tuo profilo', ru: 'Ваш профиль',
};
// Shared English-only courtesy (src/lib/i18n/english-only.ts): hreflang="en"
// plus a visible cue on every link whose destination has no localized route.
const englishOnly = englishOnlyCue(locale);
const englishOnlyAria = englishOnly?.aria;
const englishOnlyBadge = englishOnly?.suffix.replace(/^ /, '');
const visibleNavTools = locale === 'ru'
  ? NAV_TOOLS.filter((tool) => tool.href !== '/birthday/')
  : NAV_TOOLS;
/** True when localizePath falls back to the canonical English route. */
const englishOnlyHref = (href: string): boolean => Boolean(englishOnly) && localizePath(locale, href) === href;
const toolNeedsEnglishCue = (tool: NavTool): boolean => englishOnlyHref(tool.href)
  && !navToolLabelHasEnglishCue(locale, tool.label, t(locale, tool.label));
---
<div class="nav-wrap">
  <nav class:list={['nav', { 'nav--localized': locale !== 'en', 'nav--without-collection': !showCollection, 'nav--without-search': locale === 'ru', 'nav--with-today': links.some((link) => link.href === '/today/') }]} aria-label={t(locale, 'navPrimary')} data-nav>
    <a class="nav__mark" href={localizePath(locale, '/')}>
      <span class="nav__name">Zodiacs<span class="nav__sep">·</span><span class="nav__dim">org</span></span>
    </a>

    <div class="nav__links">
      <button class="nav__link nav__dropdown-btn" type="button" data-tools-toggle aria-expanded="false" aria-controls="tools-menu" aria-haspopup="true">
        {t(locale, 'navTools')}
        <svg width="8" height="5" viewBox="0 0 8 5" fill="none" aria-hidden="true"><path d="M1 1l3 3 3-3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="nav__link nav__dropdown-btn" type="button" data-signs-toggle aria-expanded="false" aria-controls="signs-menu" aria-haspopup="true">
        {t(locale, 'navSigns')}
        <svg width="8" height="5" viewBox="0 0 8 5" fill="none" aria-hidden="true"><path d="M1 1l3 3 3-3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      {links.map((l) => (
        <a
          class:list={['nav__link', { 'nav__link--deferred': englishOnlyHref(l.href) }]}
          href={localizePath(locale, l.href)}
          hreflang={englishOnlyHref(l.href) ? 'en' : undefined}
          aria-current={path.startsWith(localizePath(locale, l.href)) ? 'page' : undefined}
          title={englishOnlyHref(l.href) ? englishOnlyAria : l.href === '/today/' ? destination.today : l.href === '/horoscopes/' ? destination.horoscope : undefined}
          aria-label={englishOnlyHref(l.href) ? `${l.label}. ${englishOnlyAria}` : undefined}
        >
          {englishOnlyHref(l.href) ? (
            <><span>{l.label}</span><small class="nav__deferred">{englishOnlyBadge}</small></>
          ) : l.label}
        </a>
      ))}

    </div>

    <a class="nav__profile-shortcut" data-profile-glyph href={localizePath(locale, '/profile/')} aria-label={profileLabel[locale]} title={profileLabel[locale]} aria-current={path.startsWith(localizePath(locale, '/profile/')) ? 'page' : undefined}>
      <svg class="nav__profile-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8" r="3.2" stroke="currentColor" stroke-width="1.3"/><path d="M5.5 20v-1.5a6.5 6.5 0 0 1 13 0V20" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg><span class="nav__avatar" data-profile-avatar aria-hidden="true" hidden></span>
    </a>
    {locale === 'ru' ? null : locale === 'en' ? (
      <button class="nav__search" type="button" data-search-open aria-label="Search the site" aria-haspopup="dialog">
        <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true"><circle cx="6.5" cy="6.5" r="4.75" stroke="currentColor" stroke-width="1.4"/><path d="M10.5 10.5L13.5 13.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <kbd class="nav__search-kbd" aria-hidden="true">/</kbd>
      </button>
    ) : (
      <a
        class="nav__search"
        href="/?search=1"
        hreflang="en"
        title={englishOnlyAria}
        aria-label={`${searchLabel[locale]}. ${englishOnlyAria}`}
      >
        <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true"><circle cx="6.5" cy="6.5" r="4.75" stroke="currentColor" stroke-width="1.4"/><path d="M10.5 10.5L13.5 13.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </a>
    )}


    {showCollection && (
    <a
      class:list={['nav__chip', { 'nav__chip--deferred': Boolean(englishOnly) }]}
      href="/astrofolio/"
      hreflang={englishOnly ? 'en' : undefined}
      aria-current={path === '/astrofolio/' ? 'page' : undefined}
      title={astrofolioLabel[locale]}
      aria-description={astrofolioLabel[locale]}
      aria-label={englishOnly ? `${t(locale, 'navCollect')}. ${englishOnlyAria}` : undefined}
    >
      {englishOnly ? (
        <><span>{t(locale, 'navCollect')}</span><small class="nav__deferred">{englishOnlyBadge}</small></>
      ) : t(locale, 'navCollect')}
    </a>

    )}

    <button
      class="nav__burger"
      type="button"
      data-menu-toggle
      data-open-label={openMenuLabel[locale]}
      data-close-label={closeMenuLabel[locale]}
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={openMenuLabel[locale]}
    >
      <span class="nav__burger-line"></span>
      <span class="nav__burger-line"></span>
      <span class="nav__burger-line"></span>
    </button>
  </nav>

  <div class="nav-menu tools-menu" id="tools-menu" data-tools-menu hidden>
    <div class="tools-menu__grid">
      {visibleNavTools.map((tool) => (
        <a
          class="tools-menu__item"
          href={localizePath(locale, tool.href)}
          hreflang={englishOnlyHref(tool.href) ? 'en' : undefined}
          title={englishOnlyHref(tool.href) ? englishOnlyAria : undefined}
        >
          <span class="tools-menu__name">{t(locale, tool.label)}{toolNeedsEnglishCue(tool) ? englishOnly?.suffix : ''}</span>
          <span class="tools-menu__desc">{tool.sublabel[locale]}</span>
        </a>
      ))}
      <div class="tools-menu__more" role="group" aria-label={NAV_MORE_LABEL[locale]}>
        <span class="tools-menu__more-label">{NAV_MORE_LABEL[locale]}</span>
        <ul>{NAV_MORE.map((item) => <li><a href={localizePath(locale, item.href)}>{item.label[locale]}</a></li>)}</ul>
      </div>
      <a class="tools-menu__all" href={localizePath(locale, '/tools/')}>
        {ALL_TOOLS_LABEL[locale]} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <div class="nav-menu signs-menu" id="signs-menu" data-signs-menu hidden>
    <div class="signs-menu__grid">
      {SIGNS.map((s) => (
        <a class="signs-menu__item" href={localizePath(locale, `/${s.slug}/`)} style={`--sign:${s.hue}`}>
          <SignIcon sign={s.slug} size={32} deferred />
          <span class="signs-menu__name">{signName(s, locale)}</span>
          <span class="signs-menu__dates">{signDates(s, locale)}</span>
        </a>
      ))}
    </div>
  </div>
</div>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
  <nav aria-label={locale === 'ru' ? 'Мобильная навигация' : 'Mobile'}>
    <div class="mobile-menu__group">
      <span class="mobile-menu__label">{t(locale, 'navSite')}</span>
      {visibleNavTools.filter((tool) => tool.href === '/birth-chart/' || tool.href === '/compatibility/').map((tool) => (
        <a class="mobile-menu__link" href={localizePath(locale, tool.href)} hreflang={englishOnlyHref(tool.href) ? 'en' : undefined} title={englishOnlyHref(tool.href) ? englishOnlyAria : undefined}>{t(locale, tool.label)}{toolNeedsEnglishCue(tool) ? englishOnly?.suffix : ''}</a>
      ))}
      {hasDailyReading && <a class="mobile-menu__link mobile-menu__link--explained" style="--i:0" href={localizePath(locale, '/today/')}><span>{todayLabel}</span><small>{destination.today}</small></a>}
      <a class="mobile-menu__link" style={`--i:${hasDailyReading ? 1 : 0}`} href={localizePath(locale, '/learn/')} hreflang={englishOnlyHref('/learn/') ? 'en' : undefined} title={englishOnlyHref('/learn/') ? englishOnlyAria : undefined}>{t(locale, 'navLearn')}{englishOnlyHref('/learn/') ? englishOnly?.suffix : ''}</a>
      <a class="mobile-menu__link mobile-menu__link--explained" style={`--i:${hasDailyReading ? 2 : 1}`} href={localizePath(locale, '/horoscopes/')} hreflang={englishOnlyHref('/horoscopes/') ? 'en' : undefined} title={englishOnlyHref('/horoscopes/') ? englishOnlyAria : undefined}><span>{t(locale, 'navHoroscopes')}{englishOnlyHref('/horoscopes/') ? englishOnly?.suffix : ''}</span><small>{destination.horoscope}</small></a>
      <a class="mobile-menu__link mobile-menu__link--explained" style={`--i:${hasDailyReading ? 3 : 2}`} href={localizePath(locale, '/profile/')}><span class="nav__avatar" data-profile-avatar aria-hidden="true" hidden></span><span>{t(locale, 'navSavedCharts')}</span><small>{destination.saved}</small></a>
    </div>
    <div class="mobile-menu__group">
      <span class="mobile-menu__label">{t(locale, 'navTools')}</span>
      <div class="mobile-menu__tools">
        {visibleNavTools.filter((tool) => tool.href !== '/birth-chart/' && tool.href !== '/compatibility/').map((tool, i) => (
          <a
            class="mobile-menu__tool"
            style={`--i:${i}`}
            href={localizePath(locale, tool.href)}
            hreflang={englishOnlyHref(tool.href) ? 'en' : undefined}
            title={englishOnlyHref(tool.href) ? englishOnlyAria : undefined}
            aria-label={`${t(locale, tool.label)}. ${tool.sublabel[locale]}${toolNeedsEnglishCue(tool) ? ` ${englishOnlyAria}.` : ''}`}
          >
            <span>{t(locale, tool.label)}{toolNeedsEnglishCue(tool) ? englishOnly?.suffix : ''}</span>
          </a>
        ))}
        <a class="mobile-menu__tool mobile-menu__tool--all" href={localizePath(locale, '/tools/')}>
          {ALL_TOOLS_LABEL[locale]} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <div class="mobile-menu__group">
      <a class="mobile-menu__link" style={`--i:${hasDailyReading ? 4 : 3}`} href="/developers/" hreflang={englishOnly ? 'en' : undefined} title={englishOnlyAria}>{developersLabel[locale]}{englishOnly?.suffix ?? ''}</a>
      {showCollection && (
      <a class="mobile-menu__link mobile-menu__registry" style={`--i:${hasDailyReading ? 5 : 4}`} href="/astrofolio/" hreflang={englishOnly ? 'en' : undefined} title={englishOnlyAria}>
        <span>{t(locale, 'navCollect')}</span>
        <small>{astrofolioLabel[locale]}</small>
      </a>
      )}
    </div>
    <div class="mobile-menu__group">
      <span class="mobile-menu__label">{t(locale, 'navTwelve')}</span>
      <div class="mobile-menu__signs">
        {SIGNS.map((s, i) => (
          <a class="mobile-menu__sign" style={`--i:${i}`} href={localizePath(locale, `/${s.slug}/`)} aria-label={signName(s, locale)}>
            <SignIcon sign={s.slug} size={30} deferred />
            <span>{signName(s, locale)}</span>
          </a>
        ))}
      </div>
    </div>
  </nav>
</div>

<style>
  .nav-wrap {
    position: fixed;
    top: 14px;
    inset-inline: 0;
    z-index: var(--z-nav);
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    padding-top: env(safe-area-inset-top);
    font-family: var(--font-nav-sans);
  }
  .nav {
    pointer-events: auto;
    /* Reserve the pill and control tracks before streamed children or fonts
       arrive. Text is never allowed to determine the centered shell width. */
    display: grid;
    grid-template-areas: 'mark search chip menu';
    grid-template-columns: minmax(0, 1fr) 44px 116px 44px;
    box-sizing: border-box;
    width: 336px;
    max-width: calc(100% - 32px);
    align-items: center;
    gap: 10px;
    height: 52px;
    padding-block: 0;
    padding-inline: 20px 10px;
    border-radius: var(--r-full);
    background: rgba(10, 12, 17, 0.96);
    backdrop-filter: saturate(150%) blur(18px);
    -webkit-backdrop-filter: saturate(150%) blur(18px);
    border: 1px solid var(--hair-2);
    box-shadow:
      inset 0 1px 0 rgba(238, 241, 247, 0.06),
      0 12px 32px -14px rgba(0, 0, 0, 0.7);
  }
  .nav--without-search {
    width: 292px;
    grid-template-areas: 'mark chip menu';
    grid-template-columns: minmax(0, 1fr) 116px 44px;
  }
  /* Shared-chart pages mark the receiver in <head>, before the nav streams.
     Their existing boundary removes the wing link. Reserve only the remaining
     tracks from the first paint, keeping their sizes and the pill centered. */
  :global(html[data-chart-share-receiver]) .nav {
    width: 210px;
    grid-template-areas: 'mark search menu';
    grid-template-columns: minmax(0, 1fr) 44px 44px;
  }
  :global(html[data-chart-share-receiver]) .nav--without-search {
    width: 166px;
    grid-template-areas: 'mark menu';
    grid-template-columns: minmax(0, 1fr) 44px;
  }
  .nav__mark {
    grid-area: mark;
    min-width: 0;
    direction: ltr;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__name {
    font-family: var(--font-nav-serif);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--text);
    white-space: nowrap;
  }
  .nav__sep { color: var(--muted); margin: 0 4px; }
  .nav__dim { color: var(--text-2); font-weight: 500; }
  /* Compact by default; the full lockup appears with the desktop links. */
  .nav__sep,
  .nav__dim { display: none; }

  .nav__links {
    grid-area: links;
    display: none;
    min-width: 0;
    align-items: center;
    gap: 2px;
    grid-template-columns: 74px 74px 64px 62px minmax(0, 1fr);
  }
  .nav__profile-shortcut { grid-area: profile; display: inline-grid; width: 44px; height: 44px; place-items: center; border-radius: 50%; color: var(--text-2); }
  .nav__profile-shortcut[aria-current='page'] { color: var(--text); background: rgba(198,204,218,0.08); }
  .nav--localized .nav__links {
    grid-template-columns: 128px 82px repeat(2, minmax(0, 1fr));
  }
  /* The server knows the full link set before children stream. Never infer
     the sixth track from children arriving later in the document. */
  .nav--localized.nav--with-today .nav__links {
    grid-template-columns: 128px 82px 52px repeat(2, minmax(0, 1fr));
  }
  .nav--without-search .nav__links {
    grid-template-columns: 136px 84px repeat(2, minmax(0, 1fr));
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    padding: 7px 11px;
    border-radius: var(--r-full);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__link:hover { color: var(--text); background: rgba(198, 204, 218, 0.07); }
  .nav__link[aria-current='page'] { color: var(--text); }
  .nav__link--deferred,
  .nav__chip--deferred {
    flex-direction: column;
    justify-content: center;
    gap: 1px;
    line-height: 1.05;
  }
  .nav__deferred {
    display: block;
    font-family: var(--font-nav-sans);
    font-size: 7.5px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1;
    text-transform: none;
    color: var(--faint);
    white-space: nowrap;
  }

  .nav__search {
    grid-area: search;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    gap: 7px;
    padding: 0;
    border: none;
    border-radius: var(--r-full);
    background: none;
    color: var(--text-2);
    cursor: pointer;
    text-decoration: none;
  }
  .nav__search:hover { color: var(--text); background: rgba(198, 204, 218, 0.07); }
  .nav__search-kbd {
    display: none;
    font-family: var(--font-nav-mono);
    font-size: 10px;
    line-height: 1;
    padding: 3px 5px;
    border: 1px solid var(--hair-2);
    border-radius: 4px;
    color: var(--faint);
  }
  .nav__dropdown-btn { justify-content: space-between; }
  .nav__dropdown-btn svg { transition: transform var(--dur-1) var(--ease); }
  .nav__dropdown-btn[aria-expanded='true'] svg { transform: rotate(180deg); }

  /* Saved-charts link tints to accent once this device has saved a chart. */
  .nav__profile-shortcut.has-saves { color: var(--accent); }
  .nav__profile-shortcut.has-saves:hover { color: var(--accent); }

  /* Local photo or initial, with a person icon before either is available.
     Both header variants keep a fixed 44px target as the image loads. */
  .nav__avatar {
    display: inline-grid;
    place-items: center;
    flex: none;
    box-sizing: border-box;
    width: 28px;
    height: 28px;
    overflow: hidden;
    border-radius: 50%;
    background: var(--sign, var(--ink-1));
    color: var(--void-0);
    font-family: var(--font-nav-serif);
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
  }
  .nav__avatar[hidden] { display: none; }
  .nav__avatar :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .has-avatar > .nav__profile-icon { display: none; }
  .mobile-menu__link .nav__avatar { margin-inline-end: 12px; vertical-align: -3px; }

  /* A permanent door into Astrofolio. It stays compact on phones, then gains
     the divider treatment once the desktop link row appears. */
  .nav__chip {
    grid-area: chip;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 0;
    padding-inline: 16px 2px;
    border-inline-start: 1px solid var(--hair-2);
    font-family: var(--font-nav-serif);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__chip:hover { color: var(--text); }
  .nav__chip[aria-current='page'] { color: var(--text); }

  .nav__burger {
    grid-area: menu;
    position: relative;
    display: inline-block;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--hair-2);
    transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .nav__burger:active { transform: scale(0.97); }
  .nav__burger-line {
    display: block;
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--text-2);
    transform-origin: 50% 50%;
