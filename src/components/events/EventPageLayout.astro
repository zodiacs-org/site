---
/**
 * The shared event-page template. Every family route renders through this
 * composition, driven entirely by the typed event contract:
 *
 *   kicker → title → dateline → authored lead → facts band → reading →
 *   sign-by-sign → one next action → related events → keep-following →
 *   visible limitations → closed evidence disclosure.
 *
 * Interpretation comes before machinery throughout; the exact numbers live
 * in the closed disclosure and never lead.
 */
import Base from '../../layouts/Base.astro';
import '../../styles/events.css';
import EventEvidence from './EventEvidence.astro';
import EventFactsBand from './EventFactsBand.astro';
import EventRelated from './EventRelated.astro';
import EventSignNotes from './EventSignNotes.astro';
import { eventsCatalog } from '../../lib/events/catalog';
import { publishedEventById } from '../../lib/events/publication';
import {
  eventClock, eventDay, eventDayLong, metaDescription, metaTitle, moonNameLabel,
} from '../../lib/events/format';
import { signBySlug } from '../../lib/signs';
import type { CatalogEvent } from '../../lib/events/types';
import { eventTransitHref } from '../../lib/events/transit-link';

interface Props {
  event: CatalogEvent;
}

const { event } = Astro.props;
const { facts, interpretation } = event;
const published = publishedEventById.get(facts.id);
const catalog = eventsCatalog();
const resolve = (id: string) => catalog.byId.get(id);

const signName = (slug: string) => signBySlug(slug).name;
const primarySign = facts.signs[0];
const hue = primarySign ? signBySlug(primarySign).hue : undefined;

const capitalize = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);

const heading = (() => {
  switch (facts.family) {
    case 'lunation':
      if (facts.subtype === 'full') {
        if (facts.moonName === 'Blue') return `A blue moon in ${signName(primarySign)}`;
        if (facts.moonName) return `The ${facts.moonName} Moon in ${signName(primarySign)}`;
        return `Full moon in ${signName(primarySign)}`;
      }
      return `New moon in ${signName(primarySign)}`;
    case 'eclipse':
      return `${capitalize(facts.eclipseKind ?? '')} ${facts.subtype} eclipse in ${signName(primarySign)}`;
    case 'retrograde':
      return `${facts.bodies[0]} retrograde`;
    case 'ingress':
      return `${facts.bodies[0]} enters ${signName(primarySign)}`;
    case 'aspect':
      return `${facts.bodies[0]} ${facts.aspectType} ${facts.bodies[1]}`;
    default:
      return facts.title;
  }
})();

const anchorIso = facts.at ?? facts.start!;
const personalTransitHref = eventTransitHref(anchorIso);
const monthLabel = new Date(anchorIso).toLocaleDateString('en-US', {
  month: 'long', year: 'numeric', timeZone: 'UTC',
});

/** A fact-grounded fallback opening for pages without authored copy. */
const factLead = (() => {
  switch (facts.family) {
    case 'lunation':
      return facts.subtype === 'full'
        ? `The Moon stands exactly opposite the Sun on ${eventDay(facts.at!)}, in ${signName(primarySign)}${facts.moonName ? `, ${moonNameLabel(facts.moonName)} of its year` : ''}. The full write-up for this date is still to come; the timing, position, and surrounding events below are already exact.`
        : `Sun and Moon meet in ${signName(primarySign)} on ${eventDay(facts.at!)}, the month's reset point. The full write-up for this date is still to come; the timing, position, and surrounding events below are already exact.`;
    case 'eclipse':
      return `On ${eventDay(facts.at!)} the ${facts.subtype === 'solar' ? 'new moon crosses the Sun\'s face' : 'full moon passes through Earth\'s shadow'} in ${signName(primarySign)}. The full write-up for this date is still to come; the timing and geometry below are already exact.`;
    case 'retrograde':
      return `${facts.bodies[0]} appears to move backward ${facts.clamped ? 'as this catalog opens' : `from ${eventDay(facts.start!)}`}${facts.end ? ` until ${eventDay(facts.end)}` : ''}, through ${facts.signs.map(signName).join(' and ')}. The full write-up for this cycle is still to come; the station dates below are already exact.`;
    case 'ingress':
      return `${facts.bodies[0]} crosses into ${signName(primarySign)} on ${eventDay(facts.at!)}${facts.fromSign ? `, leaving ${signName(facts.fromSign)}` : ''}. The full write-up for this shift is still to come; the timing below is already exact.`;
    case 'aspect':
      return `${facts.bodies[0]} and ${facts.bodies[1]} reach an exact ${facts.aspectType} on ${eventDay(facts.at!)}. The full write-up for this alignment is still to come; the timing and positions below are already exact.`;
    default:
      return facts.title;
  }
})();

const signNoteSubject = facts.family === 'eclipse'
  ? 'this eclipse'
  : facts.subtype === 'full' ? 'this full moon' : 'this new moon';

const glossaryLinks: Record<string, { href: string; label: string }[]> = {
  lunation: [
    { href: `/learn/glossary/#${facts.subtype === 'full' ? 'full-moon' : 'new-moon'}`, label: facts.subtype === 'full' ? 'What a full moon is' : 'What a new moon is' },
    { href: '/learn/glossary/#lunation', label: 'Lunations, defined' },
  ],
  eclipse: [
    { href: '/learn/glossary/#eclipse', label: 'What an eclipse is' },
    { href: '/learn/glossary/#eclipse-season', label: 'Eclipse seasons, defined' },
  ],
  retrograde: [
    { href: '/learn/glossary/#retrograde', label: 'What retrograde means' },
    { href: '/learn/glossary/#station', label: 'Stations, defined' },
  ],
  ingress: [{ href: '/learn/glossary/#ingress', label: 'What an ingress is' }],
  aspect: [
    { href: `/learn/glossary/#${facts.aspectType && ['trine', 'sextile', 'square', 'opposition', 'conjunction'].includes(facts.aspectType) ? facts.aspectType : 'aspect'}`, label: `What a ${facts.aspectType} is` },
    { href: '/learn/glossary/#exact-aspect', label: 'Exact aspects, defined' },
  ],
};

const followLinks: { href: string; label: string }[] = [
  ...(facts.family === 'lunation' ? [
    { href: '/full-moon-calendar/', label: 'Every full moon, dated' },
    { href: '/moon-phase/', label: 'Tonight\'s moon phase' },
  ] : []),
  ...(facts.family === 'eclipse' ? [
    { href: '/eclipses/', label: 'Every eclipse through 2028' },
    { href: '/full-moon-calendar/', label: 'The full moon calendar' },
  ] : []),
  ...(facts.family === 'retrograde' ? [
    { href: '/retrogrades/', label: 'Every retrograde, dated' },
    ...(facts.bodies[0] === 'Mercury' ? [{ href: '/mercury-retrograde/', label: 'Mercury retrograde, explained' }] : []),
    { href: '/transits/', label: 'Track it against your chart' },
  ] : []),
  ...(facts.family === 'ingress' || facts.family === 'aspect' ? [
    ...facts.bodies.map((body) => ({ href: `/learn/planets/${body.toLowerCase()}/`, label: `${body}, the planet` })),
    { href: '/transits/', label: 'Track it against your chart' },
  ] : []),
  ...facts.signs.slice(0, facts.family === 'aspect' ? 2 : 1).map((sign) => ({
    href: `/${sign}/`,
    label: `The ${signName(sign)} guide`,
  })),
  ...(glossaryLinks[facts.family] ?? []),
  { href: '/horoscopes/', label: 'Daily horoscopes' },
  { href: '/today/', label: 'Today\'s sky' },
];

const canonicalUrl = `https://zodiacs.org${facts.path}`;
const articleImage = `https://zodiacs.org${published?.card ?? '/assets/og/v2/share.png'}`;
const modifiedDate = published
  ? `${published.lastModified}T00:00:00.000Z`
  : event.lastModified;
const jsonLd = [
  {
    '@type': 'Article',
    headline: facts.title,
    description: metaDescription(facts),
    inLanguage: 'en',
    url: canonicalUrl,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
    image: articleImage,
    author: { '@id': 'https://zodiacs.org/#org' },
    publisher: { '@id': 'https://zodiacs.org/#org' },
    ...(published?.publishedAt ? { datePublished: published.publishedAt } : {}),
    ...(modifiedDate ? { dateModified: modifiedDate } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: 'https://zodiacs.org/' },
      { '@type': 'ListItem', position: 2, name: 'Sky events', item: 'https://zodiacs.org/events/' },
      { '@type': 'ListItem', position: 3, name: facts.title, item: canonicalUrl },
    ],
  },
];

const sources = [
  { label: 'Astronomy Engine', href: 'https://github.com/cosinekitty/astronomy' },
  { label: 'IANA Time Zone Database', href: 'https://www.iana.org/time-zones' },
];
---
<Base
  stableTypography
  title={metaTitle(facts)}
  description={metaDescription(facts)}
  path={facts.path}
  image={published?.card}
  imageAlt={`${facts.title} | Zodiacs.org`}
  type="article"
  noindex={!event.indexEligible}
  jsonLd={jsonLd}
  sources={sources}
  rssFeed={{ href: '/feeds/events.xml', title: 'Zodiacs.org | sky events' }}
>
  <noscript>
    <style>
      /* Without JavaScript the reveal observer never runs; show everything. */
      .reveal { opacity: 1 !important; transform: none !important; filter: none !important; }
    </style>
  </noscript>

  <article class="section--tight container container--narrow">
    {event.fixture && (
      <p class="event-sample" data-event-sample>
        Sample page for template review. The dates and figures here are
        placeholders, not sky facts.
      </p>
    )}

    <header class="event-hero reveal">
      <a class="crumb" href="/events/"><span class="crumb__arrow" aria-hidden="true">←</span>Sky events</a>
      <h1 class="display">{heading}</h1>
      <p class="event-hero__when">
        {facts.at ? (
          <>
            <time datetime={facts.at}>{eventDayLong(facts.at)}</time>
            <span class="mono">{eventClock(facts.at)}</span>
          </>
        ) : (
          <>
            <time datetime={facts.start!}>{eventDay(facts.start!)}</time>
            <span>to</span>
            {facts.end
              ? <time datetime={facts.end}>{eventDay(facts.end)}</time>
              : <span>past the data horizon</span>}
          </>
        )}
      </p>
      <p class="event-hero__lead" data-event-lead>{interpretation?.lead ?? factLead}</p>
    </header>

    <div class="reveal" data-event-facts>
      <EventFactsBand facts={facts} />
    </div>

    {interpretation?.body && (
      <section class="event-section prose reveal" data-event-reading>
        {interpretation.body.map((paragraph) => <p>{paragraph}</p>)}
      </section>
    )}

    {interpretation?.reflections && interpretation.reflections.length > 0 && (
      <section
        class="event-section reveal"
        aria-labelledby="reflections-head"
        style={hue ? `--sign:${hue}` : undefined}
      >
        <h2 id="reflections-head">Questions to carry</h2>
        <ul class="event-reflect">
          {interpretation.reflections.map((prompt) => <li>{prompt}</li>)}
        </ul>
      </section>
    )}

    {interpretation?.signNotes && interpretation.signNotes.length === 12 && (
      <div class="reveal">
        <EventSignNotes notes={interpretation.signNotes} subject={signNoteSubject} />
      </div>
    )}

    <aside class="next-action shell tinted reveal" style={hue ? `--sign:${hue}` : undefined}>
      <div class="next-action__core core tinted">
        <div class="next-action__copy">
          <h2 class="next-action__title">Compare this sky with your chart</h2>
          <p class="next-action__body">
            Open the transit tool at this event’s exact time. Choose a chart
            already saved in this browser, or enter your birth details there.
            A known birth time adds the houses and angles.
          </p>
        </div>
        <div class="next-action__actions">
          <div class="next-action__primary">
            <a class="btn btn--primary" href={personalTransitHref ?? '/transits/'}>See this event with my chart</a>
          </div>
        </div>
      </div>
    </aside>

    <section class="event-section reveal" aria-labelledby="related-head" data-event-related>
      <h2 id="related-head">Before and after</h2>
      <EventRelated event={event} resolve={resolve} />
    </section>

    <section class="event-section reveal" aria-labelledby="follow-head">
      <h2 id="follow-head">Keep following</h2>
      <ul class="event-follow">
        {followLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </section>

    {interpretation?.limitations && interpretation.limitations.length > 0 && (
      <aside class="event-limits reveal" data-event-limits>
        {interpretation.limitations.map((limit) => <p>{limit}</p>)}
      </aside>
    )}

    <div class="event-section reveal" data-event-evidence>
      <EventEvidence event={event} />
    </div>
  </article>
</Base>
