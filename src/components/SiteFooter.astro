---
import { isAstrologyToolPath, showsCollectionNavigation } from '../lib/trust-boundary';
import { SIGNS, signName } from '../lib/signs';
import BrandMark from './BrandMark.astro';
import EmailCapture from './EmailCapture.astro';
import TerminalMarketVenueNotice from './TerminalMarketVenueNotice.astro';
import { GUIDE_LOADER_MARKER, guideLoaderSource } from '../lib/assistant/guide-loader.mjs';
import { FOOTER_TOOLS } from '../lib/nav-tools';
import {
  LOCALE_META,
  LEGACY_HOME_SELECTOR_LOCALES,
  alternatePathEntries,
  englishOnlyCue,
  renderableAlternatePathEntries,
  localizePath,
  normalizeCatalogLocale,
  stripLocale,
  t,
  type CatalogLocale as Locale,
} from '../lib/i18n';

const year = new Date().getFullYear();
interface Props { locale?: Locale; terminalMarketNotice?: boolean; noAssistant?: boolean }
const locale = normalizeCatalogLocale(Astro.props.locale);
const isTool = isAstrologyToolPath(Astro.url.pathname);
const showCollection = showsCollectionNavigation(Astro.url.pathname);
const routeLanguageLinks = renderableAlternatePathEntries(Astro.url.pathname);
// Preserve the established locale-home fallback on English-only routes while
// deriving the candidate set from actual route availability, never LOCALES.
const availableHomeFallback = alternatePathEntries('/').filter((entry) => (
  LEGACY_HOME_SELECTOR_LOCALES.includes(entry.locale as typeof LEGACY_HOME_SELECTOR_LOCALES[number])
));
const languageLinks = (routeLanguageLinks.length ? routeLanguageLinks : availableHomeFallback).map((entry) => ({
  ...entry,
  meta: LOCALE_META[entry.locale],
}));
const FOOTER_COPY = {
  en: { assistant: 'Guide', language: 'Language', legal: 'Legal', utilities: 'More', licenses: 'Data & licenses', developers: 'Developers' },
  es: { assistant: 'Guide', language: 'Idioma', legal: 'Legal', utilities: 'Más', licenses: 'Datos y licencias', developers: 'Desarrolladores' },
  pt: { assistant: 'Guide', language: 'Idioma', legal: 'Legal', utilities: 'Mais', licenses: 'Dados e licenças', developers: 'Desenvolvedores' },
  fr: { assistant: 'Guide', language: 'Langue', legal: 'Mentions légales', utilities: 'Plus', licenses: 'Données et licences', developers: 'Développeurs' },
  it: { assistant: 'Guide', language: 'Lingua', legal: 'Note legali', utilities: 'Altro', licenses: 'Dati e licenze', developers: 'Sviluppatori' },
  ru: { assistant: 'Guide — пока по-английски', language: 'Язык', legal: 'Правовая информация', utilities: 'Ещё', licenses: 'Данные и лицензии', developers: 'Разработчикам' },
} as const satisfies Record<Locale, {
  assistant: string;
  language: string;
  legal: string;
  utilities: string;
  developers: string;
  licenses: string;
}>;
// The English-only courtesy (hreflang="en" + a visible cue) reads from the
// shared copy in src/lib/i18n/english-only.ts so nav, footer, and page-level
// links stay in step; scripts/check-i18n-english-links.mjs enforces it.
const englishOnly = englishOnlyCue(locale);
const englishSuffix = englishOnly?.suffix ?? '';
const englishOnlyAria = englishOnly?.aria;
const englishHreflang = englishOnly ? ('en' as const) : undefined;
const englishOnlyHref = (href: string): boolean => Boolean(englishOnly) && localizePath(locale, href) === href;
const privacyHref = localizePath(locale, '/privacy/');
const fontLicenseHref = locale === 'ru' ? '/fonts/OFL-golos-text.txt' : '/fonts/OFL-instrument-sans.txt';
const consumerPath = stripLocale(Astro.url.pathname);
const isRegistryWing = /^\/(?:terminal|registry|sdk|thesis|archive|disclosure)(?:\/|$)/.test(consumerPath);
const suppressFooterEmailCapture = /^\/(?:birth-chart|horoscopes|profile)(?:\/|$)/.test(consumerPath);
const terminalMarketNotice = Boolean(Astro.props.terminalMarketNotice);
---
<footer class="zfooter">
  <div class="zfooter__inner">
    {locale !== 'ru' && !isRegistryWing && !suppressFooterEmailCapture && <EmailCapture locale={locale} placement="footer" />}

    <div class="zfooter__lead">
      <div>
        <a class="zfooter__brand" href={localizePath(locale, '/')}>
          <BrandMark size={26} class="zfooter__brand-mark" />
          <span class="zfooter__brand-name">Zodiacs</span><span class="zfooter__brand-tld">.org</span>
        </a>
        <p class="zfooter__tag">{t(locale, 'footerTag')}</p>
        {!isTool && isRegistryWing && <p class="zfooter__tag">{t(locale, 'trustWalletNotice')}</p>}
      </div>
      {!Astro.props.noAssistant && (
        <button
          class="zfooter__guide"
          type="button"
          data-assistant-open
          data-footer-guide
          data-assistant-locale={locale}
          aria-haspopup="dialog"
        >
          <img src="/assets/guide-avatar.webp" width="32" height="32" alt="" loading="lazy" decoding="async" />
          <span>{FOOTER_COPY[locale].assistant}</span>
        </button>
      )}
    </div>

    <div class="zfooter__directory">
      <nav class="zfooter__group" aria-label={t(locale, 'navTools')}>
        <details class="zfooter__fold" open data-footer-essential><summary class="zfooter__fold-label"><span class="zfooter__label">{t(locale, 'navTools')}</span></summary>
        <div class="zfooter__links">
          {FOOTER_TOOLS.map((tool) => (
            <a
              href={tool.localized ? localizePath(locale, tool.href) : tool.href}
              hreflang={englishOnlyHref(tool.href) ? 'en' : undefined}
              title={englishOnlyHref(tool.href) ? englishOnlyAria : undefined}
            >
              {tool.labels?.[locale] ?? t(locale, tool.label)}
              {englishOnlyHref(tool.href) && !tool.labels ? englishSuffix : ''}
            </a>
          ))}
        </div>
      </details></nav>

      <nav class="zfooter__group" aria-label={t(locale, 'navLearn')}>
        <details class="zfooter__fold" open><summary class="zfooter__fold-label"><span class="zfooter__label">{t(locale, 'navLearn')}</span></summary>
        <div class="zfooter__links">
          <a href="/learn/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'footerStartHere')}{englishSuffix}</a>
          <a href={localizePath(locale, '/horoscopes/')} hreflang={englishOnlyHref('/horoscopes/') ? 'en' : undefined} title={englishOnlyHref('/horoscopes/') ? englishOnlyAria : undefined}>{t(locale, 'navHoroscopes')}{englishOnlyHref('/horoscopes/') ? englishSuffix : ''}</a>
          <a href="/learn/planets/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'footerPlanets')}{englishSuffix}</a>
          <a href="/learn/houses/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'footerHouses')}{englishSuffix}</a>
          <a href="/learn/zodiac-dates/" hreflang="en" title={englishOnlyAria}>{t(locale, 'footerZodiacDates')}{englishSuffix}</a>
          <a href="/learn/glossary/" hreflang="en" title={englishOnlyAria}>{t(locale, 'footerGlossary')}{englishSuffix}</a>
          <a href={localizePath(locale, '/methodology/')}>{t(locale, 'footerCompute')}</a>
          <a href={localizePath(locale, '/profile/')}>{t(locale, 'navSavedCharts')}</a>
        </div>
      </details></nav>

      {showCollection && (
      <nav class="zfooter__group zfooter__group--wide" aria-label={t(locale, 'footerRegistry')}>
        <details class="zfooter__fold" open><summary class="zfooter__fold-label"><span class="zfooter__label">{t(locale, 'footerRegistry')}</span></summary>
        <div class="zfooter__links">
          <a href="/astrofolio/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'navCollect')}{englishSuffix}</a>
          <a href="/registry/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'footerRegistry')}{englishSuffix}</a>
          <a href="/sdk/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'footerSdk')}{englishSuffix}</a>
          <a href={localizePath(locale, '/disclosure/')}>{t(locale, 'footerDisclosure')}</a>
        </div>
        <span class="zfooter__note">{t(locale, 'trustFreeAnswer')} <a href={localizePath(locale, '/disclosure/')}>{t(locale, 'trustDisclosure')}</a>.</span>
      </details></nav>

      )}

      <nav class="zfooter__group zfooter__twelve" aria-label={t(locale, 'navSigns')}>
        <span class="zfooter__label">{t(locale, 'navTwelve')}</span>
        <div class="zfooter__signs">
          {SIGNS.map((sign) => (
            <a class="zfooter__sign" href={localizePath(locale, `/${sign.slug}/`)} aria-label={signName(sign, locale)} title={signName(sign, locale)}>
              <img src={`/assets/zodiac-icons/48/${sign.slug}.webp?surface=site-footer`} width="25" height="25" alt="" loading="lazy" decoding="async" />
              <span class="zfooter__visually-hidden">{signName(sign, locale)}</span>
            </a>
          ))}
        </div>
      </nav>
    </div>

    {terminalMarketNotice && <TerminalMarketVenueNotice />}

    <div class="zfooter__language">
      <span class="zfooter__label" id="footer-language-label">{FOOTER_COPY[locale].language}</span>
      <nav class="zfooter__locales" aria-labelledby="footer-language-label">
        {languageLinks.map((entry) => (
          entry.locale === locale
            ? <span class="zfooter__locale" lang={entry.meta.htmlLang} aria-current="page">{entry.meta.languageName}</span>
            : <a class="zfooter__locale" href={entry.href} hreflang={entry.meta.hreflang} lang={entry.meta.htmlLang}>{entry.meta.languageName}</a>
        ))}
      </nav>
    </div>

    <div class="zfooter__colophon">
      <p class="zfooter__copyright">© {year} Zodiacs.org</p>

      <nav class="zfooter__meta" aria-label={FOOTER_COPY[locale].legal}>
        <span class="zfooter__label">{FOOTER_COPY[locale].legal}</span>
        <div class="zfooter__meta-links">
          <a href="/about/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'footerAbout')}{englishSuffix}</a>
          <a href={privacyHref}>{t(locale, 'footerPrivacy')}</a>
          <a href="/terms/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'footerTerms')}{englishSuffix}</a>
        </div>
      </nav>

      <nav class="zfooter__meta" aria-label={FOOTER_COPY[locale].utilities}>
        <span class="zfooter__label">{FOOTER_COPY[locale].utilities}</span>
        <div class="zfooter__meta-links">
          <a href="/developers/" hreflang={englishHreflang} title={englishOnlyAria}>{FOOTER_COPY[locale].developers}{englishSuffix}</a>
          <a href="/widgets/" hreflang={englishHreflang} title={englishOnlyAria}>{t(locale, 'footerWidgets')}{englishSuffix}</a>
          <a href="/feeds/horoscopes.xml" hreflang={englishHreflang} title={englishOnlyAria}>RSS{englishSuffix}</a>
        </div>
      </nav>

      <div class="zfooter__meta zfooter__credits">
        <span class="zfooter__label">{FOOTER_COPY[locale].licenses}</span>
        <p>{t(locale, 'footerPlaceData')}: <a href="https://www.geonames.org/" rel="noopener noreferrer">GeoNames</a> · CC BY 4.0</p>
        <p>{t(locale, 'footerFonts')} <a href={fontLicenseHref}>SIL OFL 1.1</a></p>
      </div>
    </div>
  </div>
</footer>

<!-- Guide stays outside Astro's module graph. Before its post-load mount, the
     inline loader reacts only to a deliberate Guide CTA click. `noAssistant`
     omits it. -->
{!Astro.props.noAssistant && (
  <script is:inline data-guide-loader={GUIDE_LOADER_MARKER} set:html={guideLoaderSource(locale)} />
)}

<script is:inline>
(function () { var mobile = window.matchMedia('(max-width: 620px)'); var groups = document.querySelectorAll('.zfooter__fold:not([data-footer-essential])'); var sync = function () { groups.forEach(function (group) { group.open = !mobile.matches; }); }; sync(); mobile.addEventListener && mobile.addEventListener('change', sync); })();
</script>
