---
interface Props {
  aspectTypes: ReadonlySet<string>;
  labels: { rx: string; easy: string; tense: string; joined: string };
  class?: string;
}

const { aspectTypes, labels, class: className } = Astro.props;
const legendEntries = [
  { key: 'rx', label: labels.rx, shown: true },
  { key: 'easy', label: labels.easy, shown: aspectTypes.has('trine') || aspectTypes.has('sextile') },
  { key: 'tense', label: labels.tense, shown: aspectTypes.has('square') || aspectTypes.has('opposition') },
  { key: 'joined', label: labels.joined, shown: aspectTypes.has('conjunction') },
].filter((entry) => entry.shown);
---

<figcaption class:list={['today-legend', className]}>
  {[true, false].map((reserve) => legendEntries.map(({ key, label }, index) => (
    <span class="today-legend__item" data-label={label} data-key={key}
      data-slot={reserve ? key : undefined} data-entry={reserve ? undefined : key}
      aria-hidden={reserve || undefined} style={`order:${index}`}>
      {!reserve && <>
        <i class={key === 'rx' ? 'today-legend__rx' : `today-legend__line today-legend__line--${key}`}>{key === 'rx' ? 'Rx' : ''}</i><span>{label}</span>
      </>}
    </span>
  )))}
</figcaption>

<style is:global>
  .today-legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 18px; margin-top: 14px; color: var(--ink-2); font-size: 12.5px; }
  /* Size the entire caption before its first visible glyph arrives. A
     reservation occupies the cell until that entry has a glyph to paint. */
  .today-legend__item[data-slot] { display: none; visibility: hidden; }
  @supports selector(:has(> i)) {
    .today-legend__item[data-slot] { display: inline-grid; }
    .today-legend__item[data-entry]:not(:has(> i)),
    .today-legend:has([data-entry="rx"] > i) [data-slot="rx"],
    .today-legend:has([data-entry="easy"] > i) [data-slot="easy"],
    .today-legend:has([data-entry="tense"] > i) [data-slot="tense"],
    .today-legend:has([data-entry="joined"] > i) [data-slot="joined"] { display: none; }
  }
  .today-legend__item { display: inline-grid; grid-template-columns: 18px max-content; align-items: center; column-gap: 7px; }
  .today-legend__item[data-key="rx"] { grid-template-columns: max-content max-content; }
  .today-legend__item[data-key="rx"]::before { content: 'Rx'; visibility: hidden; grid-area: 1 / 1; }
  .today-legend__item::after { content: attr(data-label); visibility: hidden; grid-area: 1 / 2; }
  .today-legend__item > span { grid-area: 1 / 2; }
  .today-legend__item > i { grid-area: 1 / 1; font-style: normal; }
  .today-legend__item[data-key="rx"]::before,
  .today-legend__rx { color: rgba(224, 176, 128, 0.9); font-family: var(--font-mono); font-size: 11px; }
  .today-legend__line { display: inline-block; width: 18px; height: 0; border-top: 1.5px solid; }
  .today-legend__line--easy { color: rgba(182, 212, 228, 0.85); }
  .today-legend__line--tense { color: rgba(222, 142, 121, 0.85); }
  .today-legend__line--joined { color: rgba(238, 241, 247, 0.6); }
  @media (max-width: 760px) {
    .today-legend { gap: 6px 14px; font-size: 12px; }
  }
</style>
