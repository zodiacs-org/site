---
/**
 * One sign's daily horoscope in Spanish or Portuguese. The English sign
 * page (src/components/HoroscopeProgramPage.astro, surface "today") is the
 * reference layout: the sign art hero, the period switch and sign rail, the
 * reading beside the sky it draws on, the chart band with this sky on the
 * sign's wheel, more for the sign, the other signs and three questions.
 * Every visible string comes from LOCALIZED_HOROSCOPE_COPY (./horoscope-copy.ts).
 *
 * The reading is DailyLocaleReading, unchanged: the notes come from
 * dailyReadingForLocale with their receipts. The localized editions publish
 * the daily reading only; the week and month switch to the English edition
 * with hreflang="en" and the English-only cue.
 */
import Base from '../../layouts/Base.astro';
import ArtFrame from '../ArtFrame.astro';
import AskGuideLine from '../AskGuideLine.astro';
import DailyLocaleReading from '../DailyLocaleReading.astro';
import EmailCapture from '../EmailCapture.astro';
import GuideQuickPrompts from '../GuideQuickPrompts.astro';
import ShareRow from '../ShareRow.astro';
import SignIcon from '../SignIcon.astro';
import LocalizedSvgTitles from './LocalizedSvgTitles.astro';
import Wheel from '../../lib/wheel/Wheel';
import dailyData from '../../data/daily.json';
import type { Daily } from '../../lib/daily';
import { PLANET_GLYPH } from '../../lib/glyphs/paths';
import { dailyReadingForLocale } from '../../lib/i18n/daily-reading';
import { formatDate } from '../../lib/i18n/dates';
import { moonPhaseLabel, planetLabel } from '../../lib/i18n/astrology';
import { englishOnlyCue } from '../../lib/i18n/english-only';
import { localizePath, t } from '../../lib/i18n';
import { signArtSrc, signArtSrcset } from '../../lib/sign-art';
import { SIGNS, elementLabel, modalityLabel, signBySlug, signName } from '../../lib/signs';
import { signDateRange } from '../../lib/sign-display';
import { localizedHoroscopeArtCard } from '../../lib/og-art-cards.mjs';
import { degreeMinutes } from '../../lib/today-sky';
import { LOCALIZED_HOROSCOPE_COPY } from './horoscope-copy';

type Locale = 'es' | 'pt';
interface Props {
  locale: Locale;
  signSlug: string;
}

const { locale, signSlug } = Astro.props;
const c = LOCALIZED_HOROSCOPE_COPY[locale];
const cue = englishOnlyCue(locale);
const local = (path: string) => localizePath(locale, path);
const daily = dailyData as Daily;
const sign = signBySlug(signSlug);
const name = signName(sign, locale);
const reading = dailyReadingForLocale(sign.slug, daily, locale);
const cap = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);
const planet = (body: string) => planetLabel(locale, body);
const named = (body: string) => (body === 'Sun'
  ? (locale === 'es' ? 'el Sol' : 'o Sol')
  : body === 'Moon' ? (locale === 'es' ? 'la Luna' : 'a Lua') : planet(body));
const listWords = (items: string[]) => (items.length <= 1
  ? items.join('')
  : `${items.slice(0, -1).join(', ')} ${locale === 'es' ? 'y' : 'e'} ${items.at(-1)}`);

const dateLabel = formatDate(locale, `${daily.date}T12:00:00Z`, {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
// The title drops the year so the longest sign name still fits in 60 characters.
const titleDate = formatDate(locale, `${daily.date}T12:00:00Z`, { day: 'numeric', month: 'long', timeZone: 'UTC' });
const weekdayLabel = cap(formatDate(locale, `${daily.date}T12:00:00Z`, {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
}));
const editionShort = formatDate(locale, `${daily.date}T12:00:00Z`, { day: 'numeric', month: 'short', timeZone: 'UTC' });
const path = `/${locale}/horoscopes/${sign.slug}/`;
const heroArtSizes = '(min-width: 761px) 74vw, calc(100vw - 16px)';
const phase = moonPhaseLabel(locale, daily.moon.phase);
const illumination = Math.round(daily.moon.illumination * 100);

// ── The sky behind the reading: each body a note draws on, once ──
const skyRows = reading.lines
  .filter((line) => line.body && daily.bodies.some((body) => body.body === line.body))
  .filter((line, index, lines) => lines.findIndex((other) => other.body === line.body) === index)
  .map((line) => {
    const body = daily.bodies.find((entry) => entry.body === line.body)!;
    const detail = [
      body.body === 'Moon' ? c.moonLit(phase, illumination) : '',
      body.retrograde ? c.retrograde : '',
      line.house ? c.skyHouse(line.house, name) : '',
    ].filter(Boolean).join(' ');
    return { body: body.body, sign: body.sign, hue: signBySlug(body.sign).hue, degree: degreeMinutes(body.degree), detail };
  });
const sun = daily.bodies.find((body) => body.body === 'Sun');
const alsoSun = sun && !skyRows.some((row) => row.body === 'Sun')
  ? c.alsoSun(`${degreeMinutes(sun.degree)} ${signName(sun.sign, locale)}`)
  : '';

// ── The wheel: the edition's sky at noon UTC, counted from this sign ──
const signIndex = SIGNS.findIndex((entry) => entry.slug === sign.slug);
const signStart = signIndex * 30;
const focus = skyRows.map((row) => row.body);
const focusCss = [
  '.hzl-wheel .wheel > text{display:none}',
  focus.length > 0 ? '.hzl-wheel .wheel__body{opacity:.5}' : '',
  ...skyRows.map((row) => {
    const selector = `.hzl-wheel [data-preview-body="${row.body}"]`;
    return `${selector}{opacity:1}${selector}>circle{fill:${row.hue};stroke:rgba(6,7,9,.5);stroke-opacity:1}${selector}>g{stroke:#0B0D12;color:#0B0D12!important}`;
  }),
].join('');
const moon = daily.bodies.find((body) => body.body === 'Moon');
const moonHouse = moon ? ((SIGNS.findIndex((entry) => entry.slug === moon.sign) - signIndex + 12) % 12) + 1 : null;
const faq = c.faq(name);
---
<Base
  stableTypography
  title={c.title(name, titleDate)}
  description={c.description(name, dateLabel, c.notes(reading.lines.length))}
  path={path}
  locale={locale}
  editionDate={daily.date}
  image={localizedHoroscopeArtCard(sign.slug, locale)}
  imageAlt={c.imageAlt(name)}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={signArtSrc(sign.slug, 1200)}
    imagesrcset={signArtSrcset(sign.slug)}
    imagesizes={heroArtSizes}
    fetchpriority="high"
  />
  <style slot="head" is:inline set:html={focusCss}></style>
  <article class="hzl" style={`--sign:${sign.hue};--hue:${sign.hue}`} data-edition-content="true">
    <header class="hzl-hero">
      <ArtFrame sign={sign.slug} locale={locale} class="hzl-hero__art" sizes={heroArtSizes} focus="50% 60%" spot="55% 56%" eager />
      <nav class="hzl-crumbs" aria-label={c.crumbsAria}>
        <a href={local('/horoscopes/')}>{c.crumbs}</a><span aria-hidden="true">/</span><span aria-current="page">{name}</span>
      </nav>
      <div class="hzl-hero__body">
        <span class="kicker hzl-hero__kicker">{weekdayLabel}</span>
        <h1 class="hzl-hero__title">{c.h1(name)}</h1>
        <p class="hzl-hero__cap">{cap(c.description(name, dateLabel, c.notes(reading.lines.length)).split(': ').slice(1).join(': '))}</p>
        <p class="kfacts hzl-hero__facts">
          <span><SignIcon sign={sign.slug} size={20} webpOnly class="hzl-hero__disc" />{signDateRange(sign, locale)}</span>
          <span>{elementLabel(sign.element, locale)}</span>
          <span>{modalityLabel(sign.modality, locale)}</span>
          <span class="hzl-hero__ruler">{t(locale, 'ruler')}: {planet(sign.ruler)}</span>
        </p>
      </div>
      <span class="hzl-hero__credit" aria-hidden="true">{c.credit(name)}</span>
    </header>

    <div class="kwrap hzl-controls">
      <div class="hzl-periods">
        <nav class="seg hzl-seg" aria-label={c.periodsAria(name)}>
          <a href={path} aria-current="page"><span data-edition-current-only>{c.todayWord}</span><span data-edition-dated-only>{editionShort}</span></a>
          <a href={`/horoscopes/${sign.slug}/weekly/`} hreflang="en" title={cue?.aria} aria-label={`${c.week}. ${cue?.aria}`}>{c.week}</a>
          <a href={`/horoscopes/${sign.slug}/monthly/`} hreflang="en" title={cue?.aria} aria-label={`${c.month}. ${cue?.aria}`}>{c.month}</a>
        </nav>
        <span class="hzl-periods__note">{c.periodsNote}</span>
      </div>
      <nav class="hzl-signrail" aria-label={c.railLabel}>
        <span class="hzl-signrail__label">{c.railLabel}</span>
        {SIGNS.map((other) => (
          <a
            href={local(`/horoscopes/${other.slug}/`)}
            aria-current={other.slug === sign.slug ? 'page' : undefined}
            style={`--other-sign:${other.hue}`}
          >
            <SignIcon sign={other.slug} size={24} webpOnly fetchPriority="low" class="hzl-signrail__disc" />
            <span>{signName(other, locale)}</span>
          </a>
        ))}
      </nav>
      <script is:inline>
        /* On a phone the row scrolls sideways: start it at the current sign. */
        (function () {
          var rail = document.currentScript && document.currentScript.previousElementSibling;
          var current = rail && rail.querySelector('[aria-current="page"]');
          if (!current || rail.scrollWidth <= rail.clientWidth) return;
          var start = current.offsetLeft - rail.offsetLeft;
          if (start + current.offsetWidth > rail.clientWidth) rail.scrollLeft = Math.max(0, start - 8);
        })();
      </script>
    </div>

    <div class="kwrap hzl-reading">
      <section class="hzl-note" aria-labelledby="reading-heading">
        <p class="hzl-note__meta">
          <SignIcon sign={sign.slug} size={24} webpOnly class="hzl-note__disc" />
          <b>{c.metaLabel}</b>
          <i aria-hidden="true">·</i><span>{phase}</span>
          <i class="hzl-hide-m" aria-hidden="true">·</i><span class="hzl-hide-m">{c.noteCount(reading.lines.length)}</span>
        </p>
        <h2 id="reading-heading" class="hzl-note__title">{c.readingTitle(name)}</h2>

        <div class="hzl-note__body">
          <DailyLocaleReading locale={locale} reading={reading} />
        </div>

        <p class="hzl-note__foot">
          {c.foot(name)}{' '}
          <a href={local('/methodology/')}>{c.methodLink}</a>
        </p>

        <ShareRow
          text={c.share(name)}
          url={`https://zodiacs.org${path}`}
          locale={locale}
          label={c.shareLabel}
          variant="pills"
        />

        <AskGuideLine lead={c.askLead} locale={locale} />
        <GuideQuickPrompts prompts={c.prompts(name)} locale={locale} label={c.askLabel} />
      </section>

      <aside class="hzl-rail" aria-label={c.railAria}>
        <section class="hzl-sky" aria-labelledby="reading-sky-heading">
          <div class="hzl-sky__head">
            <h3 id="reading-sky-heading" class="h-4">{c.skyTitle}</h3>
            <span class="mono">{c.skyBasis}</span>
          </div>
          <p class="hzl-sky__sub">{c.skySub}</p>
          <ul class="hzl-sky__rows">
            {skyRows.map((row) => (
              <li class="hzl-sky__row" style={`--c:${row.hue}`}>
                <span class="hzl-pg" aria-hidden="true">
                  {PLANET_GLYPH[row.body]
                    ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={PLANET_GLYPH[row.body]} />
                    : null}
                </span>
                <div>
                  <strong>{c.skyRow(planet(row.body), signName(row.sign, locale))}</strong>
                  <span class="hzl-sky__m">{row.detail}</span>
                </div>
                <span class="mono hzl-sky__deg">{row.degree}</span>
              </li>
            ))}
          </ul>
          {alsoSun && <p class="hzl-sky__also">{alsoSun}</p>}
          <a class="textlink hzl-sky__link" href={local('/today/')}>{c.fullSky} <span class="arr" aria-hidden="true">→</span></a>
        </section>

        <EmailCapture placement="horoscopes" locale={locale} sign={sign.slug} />
      </aside>
    </div>

    <section class="kwrap hzl-section" aria-labelledby="chart-cta-heading">
      <div class="hzl-cta">
        <figure class="hzl-cta__wheel hzl-wheel" data-hzl-wheel>
          <LocalizedSvgTitles locale={locale}>
            <Wheel
              bodies={daily.bodies.map((body) => ({ body: body.body, lon: body.lon, retrograde: body.retrograde }))}
              asc={signStart}
              cusps={Array.from({ length: 12 }, (_, index) => (signStart + index * 30) % 360)}
              preview
              deferIcons
              ariaLabel={c.wheelAria(dateLabel, name)}
            />
          </LocalizedSvgTitles>
          <figcaption>{c.wheelCaption(dateLabel, name, listWords(focus.map(named)), focus.length)}</figcaption>
        </figure>
        <script is:inline>
          /* The wheel's twelve sign discs ship as data-href so they cost
             nothing while the hero paints; lift them as the band nears. */
          (function () {
            var root = document.querySelector('[data-hzl-wheel]');
            if (!root) return;
            var discs = root.querySelectorAll('image[data-href]');
            function lift() {
              for (var i = 0; i < discs.length; i += 1) {
                discs[i].setAttribute('href', discs[i].getAttribute('data-href'));
                discs[i].removeAttribute('data-href');
              }
            }
            if (!('IntersectionObserver' in window)) { lift(); return; }
            var watch = new IntersectionObserver(function (entries) {
              for (var i = 0; i < entries.length; i += 1) {
                if (entries[i].isIntersecting) { watch.disconnect(); lift(); return; }
              }
            }, { rootMargin: '200px 0px' });
            watch.observe(root);
          })();
        </script>
        <div class="hzl-cta__head">
          <span class="kicker">{c.ctaKicker}</span>
          <h2 id="chart-cta-heading" class="h-2">{c.ctaTitle}</h2>
        </div>
        <div class="hzl-cta__body">
          {moon && moonHouse && <p class="klede">{c.ctaLede(name, signName(moon.sign, locale), moonHouse)}</p>}
          <ul class="hzl-ticks">
            {c.ticks.map((tick) => <li>{tick}</li>)}
          </ul>
          <div class="btn-row">
            <a class="btn btn--primary btn--lg" href={local('/birth-chart/')}>{t(locale, 'getBirthChart')} <span class="orb" aria-hidden="true">↗</span></a>
            <span class="reassure">{c.reassure[0]}<br />{c.reassure[1]}</span>
          </div>
          <p class="hzl-cta__saved">{c.saved}<a href={local('/transits/')}>{c.savedLink}</a></p>
        </div>
      </div>
    </section>

    <section class="kwrap hzl-section hzl-more" aria-labelledby="more-heading">
      <div>
        <div class="section-head hzl-head">
          <h2 id="more-heading" class="h-2">{c.moreTitle(name)}</h2>
          <p>{c.moreLede}</p>
        </div>
        <nav class="hzl-more__list" aria-labelledby="more-heading">
          <a href={`/horoscopes/${sign.slug}/`} hreflang="en" title={cue?.aria}>
            <div><b>{c.moreLonger}</b><small>{cue?.aria}</small></div>
            <p>{c.moreLongerText(name)}</p>
            <span class="hzl-go" aria-hidden="true">↗</span>
          </a>
          <a href={local(`/rising-sign/${sign.slug}/`)}>
            <div><b>{c.moreRising(name)}</b><small>{c.moreRisingNote}</small></div>
            <p>{c.moreRisingText(name)}</p>
            <span class="hzl-go" aria-hidden="true">→</span>
          </a>
          <a href={local('/horoscopes/')}>
            <div><b>{c.moreAll}</b><small>{dateLabel}</small></div>
            <p>{c.moreAllText}</p>
            <span class="hzl-go" aria-hidden="true">→</span>
          </a>
        </nav>
      </div>
      <a class="hzl-guide" href={local(`/${sign.slug}/`)}>
        <ArtFrame sign={sign.slug} locale={locale} alt="" fade focus="34% 40%" spot="40% 42%" sizes="(min-width: 1021px) 420px, calc(100vw - 40px)" class="hzl-guide__art" />
        <span class="hzl-guide__cap">
          <span class="kicker">{c.guideKicker}</span>
          <span class="h-3">{c.guideTitle(name)}</span>
          <span class="hzl-guide__copy">{c.guideCopy(name)}</span>
          <span class="textlink">{c.guideLink(name)} <span class="arr">→</span></span>
        </span>
      </a>
    </section>

    <section class="kwrap hzl-section" aria-labelledby="signs-heading">
      <div class="section-head--row hzl-head">
        <div>
          <h2 id="signs-heading" class="h-2">{c.signsTitle}</h2>
          <p>{c.signsLede}</p>
        </div>
        <a class="textlink only-desktop" href={local('/horoscopes/')}>{c.allHoroscopes} <span class="arr">→</span></a>
      </div>
      <nav class="hzl-signs" aria-label={c.signsAria}>
        <ul class="signgrid">
          {SIGNS.map((other) => (
            <li>
              <a
                href={local(`/horoscopes/${other.slug}/`)}
                aria-current={other.slug === sign.slug ? 'page' : undefined}
                style={`--sign:${other.hue}`}
              >
                <SignIcon sign={other.slug} size={44} webpOnly />
                <b>{signName(other, locale)}</b>
                <small>{other.slug === sign.slug ? c.readingNow : signDateRange(other, locale)}</small>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </section>

    <section class="kwrap hzl-section qa hzl-faq" aria-labelledby="faq-heading">
      <div>
        <h2 id="faq-heading" class="h-2">{c.faqTitle(name)}</h2>
        <p>{c.faqMore}<a href={local('/methodology/')}>{c.methodLink.toLowerCase()}</a>.</p>
      </div>
      <div class="kfaq">
        {faq.map(({ q, a }, index) => (
          <details open={index === 0}>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>
  </article>
</Base>

<style is:global>
  .hzl {
    display: block;
    padding-bottom: clamp(48px, 7vw, 96px);
  }

  /* ── Hero: the sign art in the rounded cinematic frame ─────────── */
  .hzl-hero {
    position: relative;
    height: 548px;
    /* The frame sits under the floating nav, as the home hero does. */
    margin: calc(12px - var(--nav-space, 96px)) 12px 0;
    overflow: hidden;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-xl);
    background: var(--void-1);
    isolation: isolate;
  }
  .hzl-hero .hzl-hero__art {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: -2;
    width: 74%;
    border-radius: 0;
  }
  .hzl-hero .hzl-hero__art > img { filter: saturate(0.94) brightness(0.9); }
  .hzl-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(90deg, var(--void-1) 0%, var(--void-1) 25%, rgba(10, 12, 17, 0.86) 33%, rgba(10, 12, 17, 0.28) 45%, rgba(10, 12, 17, 0) 56%),
      linear-gradient(0deg, rgba(6, 7, 9, 0.55) 0%, rgba(6, 7, 9, 0) 32%);
  }
  .hzl-crumbs {
    position: absolute;
    top: 92px;
    left: clamp(28px, 5vw, 72px);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13px;
    color: var(--faint);
  }
  .hzl-crumbs a { color: var(--muted); text-decoration: none; }
  .hzl-crumbs a:hover { color: var(--text); }
  .hzl-crumbs span[aria-hidden] { opacity: 0.6; }
  .hzl-hero__body {
    position: absolute;
    left: clamp(28px, 5vw, 72px);
    bottom: 50px;
    max-width: 620px;
  }
  .hzl-hero__kicker { color: var(--ink-1); }
  .hzl-hero__title {
    margin: 10px 0 0;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2.7rem, 1.5rem + 3.6vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }
  .hzl-hero__cap {
    margin: 20px 0 0;
    max-width: 40ch;
    color: var(--ink-1);
    font-size: var(--text-lg);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .hzl-hero__facts { margin: 22px 0 0; color: var(--muted); }
  .hzl-hero__facts > span { display: inline-flex; align-items: center; }
  .hzl-hero .hzl-hero__disc { margin-right: 8px; }
  .hzl-hero__credit {
    position: absolute;
    right: 22px;
    bottom: 18px;
    color: rgba(198, 204, 218, 0.5);
    font-size: 12px;
  }

  /* ── Period switch and one-tap sign switch ─────────────────────── */
  .hzl-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 18px;
    padding: 12px 0;
    border-block: 1px solid var(--hair-1);
  }
  /* The switch with its English-only note under it, so the sign rail
     beside it keeps the English page's room. */
  .hzl-periods { display: grid; flex: none; justify-items: start; gap: 6px; }
  .hzl-seg { flex: none; }
  .hzl-seg > a { min-height: 38px; padding-inline: 20px; font-size: 0.9375rem; }
  .hzl-periods__note { padding-left: 14px; color: var(--faint); font-size: 12px; }
  .hzl-signrail {
    display: flex;
    flex: none;
    align-items: center;
    gap: 2px;
    min-width: 0;
    margin-left: auto;
  }
  .hzl-signrail__label {
    margin-right: 12px;
    color: var(--muted);
    font-family: var(--font-serif);
    font-size: 1rem;
    font-style: italic;
    white-space: nowrap;
  }
  .hzl-signrail a {
    display: grid;
    flex: none;
    justify-items: center;
    gap: 4px;
    /* At least the English rail's 58px, wider only for a long name. */
    min-width: 58px;
    padding: 6px 3px 4px;
    border-radius: 12px;
    color: var(--faint);
    font-size: 11px;
    line-height: 1.2;
    text-decoration: none;
  }
  .hzl-signrail a > span { white-space: nowrap; }
  /* The 48px derivative keeps twelve first-screen discs light; shown at 30px. */
  .hzl-signrail a .hzl-signrail__disc { width: 30px; opacity: 0.78; }
  .hzl-signrail a[aria-current='page'] {
    background: color-mix(in oklab, var(--other-sign) 10%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--other-sign) 32%, transparent);
    color: var(--ink-0);
    font-weight: 600;
  }
  .hzl-signrail a[aria-current='page'] .hzl-signrail__disc { opacity: 1; }
