  anatomyWheel: string;
  positions: string;
  degree: string;
  retrograde: string;
  more: (count: number) => string;
  notes: readonly [Pair, Pair, Pair, Pair];
  readLink: string;
  depthLink: string;
  artAlt: string;
  compare: string;
  withTime: string;
  withoutTime: string;
  timeUnknown: string;
  moonAllDay: (sign: string) => string;
  moonTwo: string;
