const { locale, faq } = Astro.props;
const c = COPY[locale];
const cue = englishOnlyCue(locale)!;
const href = (path: string) => localizePath(locale, path);
/** Link attributes for a destination this locale does not have yet. */
const englishOnly = (path: string) => href(path) === path;
const linkTo = (path: string) => (englishOnly(path)
  ? { href: path, hreflang: 'en', title: cue.aria }
  : { href: href(path) });
const suffix = (path: string) => (englishOnly(path) ? cue.suffix : '');
const name = (slug: string) => signName(slug, locale);
/** Russian puts the sign in the prepositional case after "в". */
const inSign = (slug: string) => (locale === 'ru' ? signPrepositional(slug) : name(slug));
const cap = (text: string) => text.charAt(0).toLocaleUpperCase(locale) + text.slice(1);
const number = (value: number, digits: number) => new Intl.NumberFormat(intlLocale(locale), {
  minimumFractionDigits: digits,
  maximumFractionDigits: digits,
}).format(value);

const sun = SAMPLE_PLACEMENTS.find((p) => p.body === 'Sun')!;
const moon = SAMPLE_PLACEMENTS.find((p) => p.body === 'Moon')!;
const rising = SAMPLE_RISING;
const houseLabel = (house: number) => `${t(locale, 'house')} ${house}`;

/* The sample birth, in the locale's own date and clock: the stored instant
   read on Chicago's wall clock, as the English page's "Oct 8, 1995, 2:00 PM". */
const sampleDate = formatDate(locale, SAMPLE_BIRTH.utc, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'America/Chicago' });
const sampleTime = formatTime(locale, SAMPLE_BIRTH.utc, { hour: 'numeric', minute: '2-digit', timeZone: 'America/Chicago' });
const coordinates = `${number(Math.abs(SAMPLE_BIRTH.latitude), 2)}° ${c.north}, ${number(Math.abs(SAMPLE_BIRTH.longitude), 2)}° ${c.west}`;

/* The four numbered parts of the anatomy wheel, placed with the Wheel's own
   geometry: its viewBox pads the drawing by 5% on every side, and longitude
   runs counterclockwise from the rising degree at nine o'clock. */
const WHEEL_SIZE = 430;
const PAD = WHEEL_SIZE * 0.05;
const FRAME = WHEEL_SIZE + PAD * 2;
const at = (lon: number, radius: number) => {
  const phi = ((180 + (lon - SAMPLE_WHEEL.asc)) * Math.PI) / 180;
  return {
    x: ((WHEEL_SIZE / 2 + radius * WHEEL_SIZE * Math.cos(phi) + PAD) / FRAME) * 100,
    y: ((WHEEL_SIZE / 2 - radius * WHEEL_SIZE * Math.sin(phi) + PAD) / FRAME) * 100,
  };
};
const boundaryNear = (lon: number) => Math.round(lon / 30) * 30;
const anatomyMarks = [
  { n: 1, ...at(boundaryNear(SAMPLE_WHEEL.asc - 125), 0.435) },
  { n: 2, ...at(boundaryNear(SAMPLE_WHEEL.asc + 185), 0.255) },
  { n: 3, ...at(moon.lon + 9, 0.31) },
  { n: 4, ...at(sun.lon, 0.02) },
];

/* Sign pictures on a chart page are only ever asked for as a whole set of
   twelve in zodiac order (audit finding F-18, tests/sign-icon-requests-drive):
   the sample's discs carry their own query, wait as data attributes, and the
   script at the end of the page asks for the sample wheel's twelve first,
   in order, before any other sample disc. */
const SAMPLE_SET = 'surface=sample-chart';
const sampleDisc = (slug: string) => `/assets/zodiac-icons/128/${slug}.webp?${SAMPLE_SET}`;

const bigThree: { label: string; p: SamplePlacement }[] = [
  { label: t(locale, 'sun'), p: sun },
  { label: t(locale, 'moon'), p: moon },
  { label: t(locale, 'rising'), p: rising },
];
const shownAspects = SAMPLE_ASPECTS.slice(0, 3);
const moreAspects = SAMPLE_ASPECTS.length - shownAspects.length;
const bodyName = (body: string) => (body === 'Rising' ? t(locale, 'rising') : planetLabel(locale, body));
const moonWithoutTime = SAMPLE_MOON_ALL_DAY ? c.moonAllDay(name(moon.sign.slug)) : c.moonTwo;

const bigThreeLabel = NAV_MORE.find((tool) => tool.href === '/big-three/')!.label[locale];
const nextCards = [
  { path: '/profile/', icon: 'today', title: c.save[0], text: c.save[1] },
  { path: '/transits/', icon: 'transits', title: t(locale, 'transits'), text: c.transitsText },
  { path: '/compatibility/', icon: 'compatibility', title: t(locale, 'compatibility'), text: c.compatText },
  { path: '/big-three/', icon: 'big-three', title: bigThreeLabel, text: c.bigThreeText },
] as const;
---
  <!-- 01 · The tool first: the form, and a real calculated chart beside it. -->
  <section class="bc-hero">
    <div class="kwrap bc-grid">
      <div class="bc-head">
        <nav class="bc-crumbs" aria-label={c.crumbs}><a href={href('/tools/')}>{t(locale, 'navTools')}</a><span aria-hidden="true">/</span><span aria-current="page">{t(locale, 'birthChart')}</span></nav>
        <h1 class="bc-title">{c.heading}</h1>
        <p class="bc-lede">{c.lede}</p>
      </div>

      <div class="bc-main" id="bc-form">
        {locale === 'ru'
          ? <ChartCalculator mode="full" locale="ru" client:interaction={{ eagerHash: true }} />
          : <ChartCalculator mode="full" locale={locale} client:idle />}
        <noscript>
          <p>{c.noscript}</p>
        </noscript>
        {c.guideLead && locale !== 'ru' && <div class="bc-guide"><AskGuideLine lead={c.guideLead} locale={locale} /></div>}
      </div>

      <aside class="bc-aside" aria-label={c.sample} data-sample-set>
        <figure class="bc-proof">
          <div class="bc-proof__top">
            <span class="pill">{c.sample}</span>
            <span class="kfacts"><span>{sampleDate}</span><span class="bc-proof__time">{sampleTime}</span><span>{c.place}</span></span>
          </div>
          <div class="bc-proof__wheel bc-wheel">
            <LocalizedSignTitles locale={locale}><Wheel {...SAMPLE_WHEEL} size={WHEEL_SIZE} deferIcons ariaLabel={c.sampleWheel} /></LocalizedSignTitles>
          </div>
          <div class="bc-proof__b3">
            {bigThree.map(({ label, p }) => (
              <div>
                <img class="bc-disc" data-src={sampleDisc(p.sign.slug)} width="34" height="34" alt="" decoding="async" />
                <span><small>{label}</small><b>{name(p.sign.slug)}</b><span class="bc-mono">{p.degree}</span></span>
              </div>
            ))}
          </div>
        </figure>
        <p class="bc-proof__cap">
          <b>{c.proofLead}</b>
          {SAMPLE_HOURS_AFTER_FULL_MOON !== null && ` ${c.fullMoon(SAMPLE_HOURS_AFTER_FULL_MOON)}`}
        </p>
      </aside>
    </div>
  </section>

  {locale !== 'ru' && <div class="kwrap bc-email"><EmailCapture placement="chart" locale={locale} revealOnChart /></div>}

  <!-- 02 · What the result looks like: the sample, laid out like a result page. -->
  <section class="kwrap bc-section bc-what" data-sample-set>
    <div class="section-head">
      <span class="kicker">{c.whatKicker}</span>
      <h2 class="h-2">{c.whatTitle}</h2>
      <p>{c.whatLede}</p>
    </div>

    <div class="bc-b3cards">
      <article class="kcard bc-b3card bc-b3card--sun" style={`--sign:${sun.sign.hue}`}>
        <div class="bc-b3card__top"><img class="bc-disc" data-src={sampleDisc(sun.sign.slug)} width="46" height="46" alt="" decoding="async" /><div><small>{t(locale, 'sun')} · {c.sunRole}</small><b>{name(sun.sign.slug)}</b></div><span class="bc-mono">{houseLabel(sun.house)}</span></div>
        <p>{c.sunText(sun.house)}</p>
        <a class="textlink" href={href(`/${sun.sign.slug}/`)}>{c.signLink(name(sun.sign.slug))} <span class="arr" aria-hidden="true">→</span></a>
      </article>
      <article class="kcard bc-b3card" style={`--sign:${moon.sign.hue}`}>
        <div class="bc-b3card__top"><img class="bc-disc" data-src={sampleDisc(moon.sign.slug)} width="46" height="46" alt="" decoding="async" /><div><small>{t(locale, 'moon')} · {c.moonRole}</small><b>{name(moon.sign.slug)}</b></div><span class="bc-mono">{houseLabel(moon.house)}</span></div>
        <p>{c.moonText(inSign(moon.sign.slug), moon.house)}</p>
        <a class="textlink" href={href(`/${moon.sign.slug}/`)}>{c.signLink(name(moon.sign.slug))} <span class="arr" aria-hidden="true">→</span></a>
      </article>
      <article class="kcard bc-b3card" style={`--sign:${rising.sign.hue}`}>
        <div class="bc-b3card__top"><img class="bc-disc" data-src={sampleDisc(rising.sign.slug)} width="46" height="46" alt="" decoding="async" /><div><small>{t(locale, 'rising')} · {c.risingRole}</small><b>{name(rising.sign.slug)}</b></div><span class="bc-mono">{houseLabel(rising.house)}</span></div>
        <p>{c.risingText(inSign(rising.sign.slug))}</p>
        <a class="textlink" href={href(`/${rising.sign.slug}/`)}>{c.signLink(name(rising.sign.slug))} <span class="arr" aria-hidden="true">→</span></a>
      </article>
    </div>

    <div class="kpanel bc-anat">
      <div class="bc-anat__wheel bc-wheel">
        <LocalizedSignTitles locale={locale}><Wheel {...SAMPLE_WHEEL} size={WHEEL_SIZE} deferIcons ariaLabel={c.anatomyWheel} /></LocalizedSignTitles>
        {anatomyMarks.map((mark) => (
          <span class="bc-anat__mark" style={`left:${mark.x.toFixed(2)}%;top:${mark.y.toFixed(2)}%`} aria-hidden="true">{mark.n}</span>
        ))}
      </div>
      <div>
        <div class="bc-pos-head">
          <h3 class="h-4">{c.positions}</h3>
          <span class="kfacts"><span>{coordinates}</span><span>{cap(t(locale, 'wholeSignHouses'))}</span></span>
        </div>
        <div class="bc-pos-scroll">
          <table class="bc-pos">
            <thead><tr><th scope="col">{t(locale, 'body')}</th><th scope="col">{t(locale, 'sign')}</th><th scope="col">{c.degree}</th><th scope="col">{t(locale, 'house')}</th></tr></thead>
            <tbody>
              {[...SAMPLE_PLACEMENTS, rising].map((p) => (
                <tr class:list={[p.body === 'Sun' && 'is-on', p.body === 'Rising' && 'is-asc']} style={`--sign:${p.sign.hue}`}>
                  <th scope="row">
                    {p.body === 'Rising' ? <span class="bc-pos__ac" aria-hidden="true">{c.asc}</span> : <PlanetGlyph body={p.body} size={15} class="bc-pos__g" />}
                    {bodyName(p.body)}
                  </th>
                  <td><span class="bc-pos__sign"><img class="bc-disc" data-src={sampleDisc(p.sign.slug)} width="20" height="20" alt="" decoding="async" />{name(p.sign.slug)}</span></td>
                  <td class="bc-mono">{p.degree}{p.retrograde && <span class="bc-pos__rx" title={cap(c.retrograde)}> ℞<span class="sr-only"> {c.retrograde}</span></span>}</td>
                  <td class="bc-pos__h">{p.house}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <ul class="bc-asp" role="list">
          {shownAspects.map((aspect) => (
            <li class="pill">
              <PlanetGlyph body={aspect.a} size={14} title={planetLabel(locale, aspect.a)} />
              {aspectLabel(locale, aspect.type)}
              <PlanetGlyph body={aspect.b} size={14} title={planetLabel(locale, aspect.b)} />
              <i>{number(aspect.orb, 1)}°</i>
            </li>
          ))}
          {moreAspects > 0 && <li class="pill">{c.more(moreAspects)}</li>}
        </ul>
      </div>
    </div>

    <ol class="bc-notes" role="list">
      {c.notes.map(([title, text], index) => (
        <li><span class="bc-notes__n" aria-hidden="true">{index + 1}</span><h3 class="h-4">{title}</h3><p>{text}</p></li>
