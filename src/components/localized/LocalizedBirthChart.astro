  proofLead: string;
  fullMoon: (hours: number) => string;
  whatKicker: string;
  whatTitle: string;
  whatLede: string;
  sunRole: string;
  moonRole: string;
  risingRole: string;
  sunText: (house: number) => string;
  moonText: (sign: string, house: number) => string;
