export type BirthChartLocale = 'es' | 'pt' | 'fr' | 'it' | 'ru';

interface FaqItem { q: string; a: string; id?: string }

interface Props {
  locale: BirthChartLocale;
  /** The locale's reviewed answers; the page's FAQPage JSON-LD uses the same list. */
  faq: FaqItem[];
}

type Pair = readonly [string, string];

interface Copy {
  crumbs: string;
  heading: string;
  lede: string;
  noscript: string;
  /** AskGuideLine's lead; Russian pages carry no Guide line. */
  guideLead?: string;
  sample: string;
  sampleWheel: string;
  place: string;
  north: string;
  west: string;
  /** "AC" in the positions table, as the locale abbreviates the rising sign. */
