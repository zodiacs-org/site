const c = COPY[locale];
const colon = locale === 'fr' ? `${NNBSP}:` : ':';
const sentences = (text: string) => text.split(/(?<=[.!?])\s+(?=\p{Lu})/u);

/* The card line and the example reading for each sign, in this language. */
const LINES: Record<string, { card: string; read: string }> = {};
if (locale === 'ru') {
  for (const sign of SIGNS) {
    const body = RU_GUIDES[sign.slug]?.sections.find((section) => section.risingProfile)?.body[0] ?? '';
    const read = sentences(body).find((sentence) => sentence.startsWith('Асцендент в '));
    if (!read) throw new Error(`LocalizedRisingSign: the Russian ${sign.slug} guide no longer has its rising sentence.`);
    LINES[sign.slug] = { card: RU_LINES[sign.slug], read };
  }
} else {
  const entries = await getCollection(
    'learnLocalized',
    (entry) => entry.data.locale === locale && entry.data.kind === 'rising' && !entry.data.draft,
  );
  for (const entry of entries) {
    const [, manner = '', ...rest] = sentences(entry.data.faq[0].a);
    const line = manner.slice(manner.indexOf(':') + 1).trim();
    if (!manner.includes(':') || !line) {
      throw new Error(`LocalizedRisingSign: the first answer of ${entry.id}.mdx no longer gives the manner after a colon in its second sentence.`);
    }
    LINES[entry.data.sign] = { card: cap(line), read: [manner, ...rest].join(' ') };
  }
  const missing = SIGNS.filter((sign) => !LINES[sign.slug]);
  if (missing.length) throw new Error(`LocalizedRisingSign: no ${locale} rising profile for ${missing.map((sign) => sign.slug).join(', ')}.`);
}

/* Links: a destination with no page in this language says so. */
const cue = englishOnlyCue(locale)!;
const href = (path: string) => localizePath(locale, path);
const englishOnly = (path: string) => !href(path).startsWith(`/${locale}/`);
const linkAttrs = (path: string) => (englishOnly(path) ? { hreflang: 'en', title: cue.aria } : {});
const linkCue = (path: string) => (englishOnly(path) ? cue.suffix : '');
const guidePath = (sign: Sign) => `/rising-sign/${sign.slug}/`;

const example = RISING_AT;
const later = RISING_LATER;
const date = formatDate(locale, new Date(RISING_EXAMPLE.dayStartUtc), {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const planet = (body: string) => planetLabel(locale, body);
const rulerLine = (moment: RisingMoment) => `${t(locale, 'chartRuler')}${colon} ${c.inSign(planet(moment.ruler), moment.rulerSign)}.`;

/* The day strip: one band per rising sign, sized by its minutes. The phone
   shows the same day as two half-day strips, so a band that crosses noon
   appears in both, cut at noon. */
const NOON = 720;
const half = (from: number, to: number) => RISING_DAY
  .filter((band) => band.end > from && band.start < to)
  .map((band) => ({ ...band, start: Math.max(band.start, from), end: Math.min(band.end, to) }));
const bandTitle = (band: RisingBand) => `${c.rising(band.sign)}, ${c.range(band.start, band.end)}, ${c.minutes(band.end - band.start)}`;
const isPinned = (slug: string) => slug === example.sign.slug || slug === later.sign.slug;
const pct = (minutes: number, from = 0, span = 1440) => `${(((minutes - from) / span) * 100).toFixed(2)}%`;
const AXIS = [0, 180, 360, 540, 720, 900, 1080, 1260, 1440];
const unevenLine = c.uneven(RISING_LONGEST, RISING_SHORTEST);
const gap = later.minutes - example.minutes;

const moonPromise = NAV_TOOLS.find((tool) => tool.href === '/moon-sign/')?.sublabel[locale] ?? '';
const moreLabel = (path: string) => NAV_MORE.find((item) => item.href === path)?.label[locale] ?? '';
const steering = cap(t(locale, 'planetSteering'));
