const pad = (n: number) => String(n).padStart(2, '0');
/** A minute of the local day as hours and minutes; 1440 stays the end of the day. */
const hm = (minutes: number) => ({ h: Math.floor(minutes / 60) % 24, m: minutes % 60 });
const cap = (text: string) => text.charAt(0).toLocaleUpperCase(locale) + text.slice(1);
const lower = (text: string) => text.charAt(0).toLocaleLowerCase(locale) + text.slice(1);
const joinNames = (names: string[], and: string) => (
  names.length > 1 ? `${names.slice(0, -1).join(', ')} ${and} ${names.at(-1)}` : names[0]
);
/** Two hours or more as hours and minutes, under two hours as minutes alone. */
const longDuration = (n: number, hours: string, and: string, minutes: (n: number) => string) => (
  n < 120 ? minutes(n) : `${Math.floor(n / 60)} ${hours}${n % 60 ? ` ${and} ${minutes(n % 60)}` : ''}`
);
const spanOf = (band: RisingBand) => band.end - band.start;
const NNBSP = ' ';
const NBSP = ' ';

const RU_MINUTES = { one: '{n} минута', few: '{n} минуты', many: '{n} минут', other: '{n} минуты' } as const;
const RU_MINUTES_ACC = { one: '{n} минуту', few: '{n} минуты', many: '{n} минут', other: '{n} минуты' } as const;
const RU_HOURS = { one: '{n} час', few: '{n} часа', many: '{n} часов', other: '{n} часа' } as const;
const ruDuration = (n: number, minuteForms: typeof RU_MINUTES | typeof RU_MINUTES_ACC) => (
  n < 120
    ? pluralText('ru', minuteForms, n)
    : [pluralText('ru', RU_HOURS, Math.floor(n / 60)), n % 60 ? pluralText('ru', minuteForms, n % 60) : '']
      .filter(Boolean)
      .join(' ')
);

const name = (sign: Sign) => signName(sign, locale);
/* French and Italian give a sign its article in running text; Gemini and Pisces are plural. */
const isPlural = (sign: Sign) => sign.slug === 'gemini' || sign.slug === 'pisces';
const FR_ARTICLE: Record<string, string> = { virgo: 'la', libra: 'la', gemini: 'les', pisces: 'les' };
const IT_ARTICLE: Record<string, string> = {
  aries: 'l’', aquarius: 'l’', scorpio: 'lo ', virgo: 'la ', libra: 'la ', gemini: 'i ', pisces: 'i ',
};
const frSign = (sign: Sign) => `${FR_ARTICLE[sign.slug] ?? 'le'} ${signName(sign, 'fr')}`;
const itSign = (sign: Sign) => `${IT_ARTICLE[sign.slug] ?? 'il '}${signName(sign, 'it')}`;

