const retrogradeNow = timeline.rows.filter((row) => row.state === 'now').map((row) => planet(row.planet));
const nextRetrograde = timeline.rows
  .filter((row) => row.state === 'upcoming')
  .sort((a, b) => a.from.localeCompare(b.from))[0];
const justEnded = timeline.rows
  .filter((row) => row.state === 'ended')
  .sort((a, b) => b.to.localeCompare(a.to))[0];
const retrogradeSummary: Part[] = [
  ...(retrogradeNow.length === 0 ? c.rxNone : c.rxNow(listWords(retrogradeNow), retrogradeNow.length)),
  ...(nextRetrograde ? [' ', ...c.rxNext(planet(nextRetrograde.planet), dayMonth(nextRetrograde.from))] : []),
  ...(justEnded
    ? [' ', ...c.rxEnded(planet(justEnded.planet), justEnded.to.slice(0, 10) === daily.date ? null : dayMonth(justEnded.to))]
    : []),
];
const windowEndLabel = shortDate(new Date(Date.parse(timeline.to) - 86_400_000).toISOString(), true);
const periodYear = (iso: string) => iso.slice(0, 4) !== daily.date.slice(0, 4);

// The closest angles in this sky.
const allAspects = aspectsToday(daily);
const aspectCards = allAspects.slice(0, 4);
const wheelAspects = allAspects.map((aspect) => ({ a: aspect.a, b: aspect.b, type: aspect.type }));
const aspectTypes = new Set(allAspects.map((aspect) => aspect.type));
const runningName = (body: string) => named(locale, body);

const goFurther = c.tools.map((tool) => ({ ...tool, href: local(tool.href), icon: toolIconForPath(tool.href) ?? 'transits' }));
