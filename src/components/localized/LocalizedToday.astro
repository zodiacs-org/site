const { locale } = Astro.props;
const c = COPY[locale];
const cue = englishOnlyCue(locale);
const local = (path: string) => localizePath(locale, path);
const daily = dailyData as Daily;

// ── Dates, in the page's language ──
const noonOf = (iso: string) => (iso.length === 10 ? `${iso}T12:00:00.000Z` : iso);
const dateLabel = formatDate(locale, `${daily.date}T12:00:00Z`, {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
const weekdayLabel = cap(formatDate(locale, `${daily.date}T12:00:00Z`, {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
}));
const shortDate = (iso: string, withYear = false) => formatDate(locale, noonOf(iso), {
  day: 'numeric', month: 'short', ...(withYear ? { year: 'numeric' } : {}), timeZone: 'UTC',
});
const dayMonth = (iso: string) => formatDate(locale, noonOf(iso), { day: 'numeric', month: 'long', timeZone: 'UTC' });
const monthShort = (iso: string) => formatDate(locale, noonOf(iso), { month: 'short', timeZone: 'UTC' });
const editionShort = shortDate(daily.date);
const number = (value: number) => new Intl.NumberFormat(intlLocale(locale), { maximumFractionDigits: 1 }).format(value);
const listWords = (items: string[]) => (items.length <= 1
  ? items.join('')
  : `${items.slice(0, -1).join(', ')} ${locale === 'es' ? 'y' : 'e'} ${items.at(-1)}`);
const sign = (slug: string) => signName(slug, locale);
const planet = (body: string) => planetLabel(locale, body);

// ── The edition's sky ──
const catalogs = Object.values(import.meta.glob<{ default: TransitCatalog }>('../../data/transits-*.json', { eager: true }))
  .map((module) => module.default);
const snapshotAt = daily.snapshotAt ?? `${daily.date}T12:00:00.000Z`;
const bodyOf = (name: string) => daily.bodies.find((body) => body.body === name)!;
const sun = bodyOf('Sun');
const moon = bodyOf('Moon');
const sunSign = signBySlug(sun.sign);
const moonSign = signBySlug(moon.sign);
const illumination = Math.round(daily.moon.illumination * 100);
const phase = moonPhaseLabel(locale, daily.moon.phase);
const moonAge = moonAgeDays(daily, skyData.moons);
const rows = planetRows(daily);

// What happens on the edition's own date, as one sentence of facts.
const dayEvents = daily.eventsCoverage === 'unavailable'
  ? []
  : daily.events
    .filter((event) => event.at.slice(0, 10) === daily.date)
    .sort((a, b) => a.at.localeCompare(b.at))
    .map((event) => c.dayEvent(event))
    .filter((phrase): phrase is string => Boolean(phrase))
    .slice(0, 3);
const daySentence = dayEvents.length > 0 ? cap(listWords(dayEvents)) : '';

// The two lights.
const sunIngress = catalogs.flatMap((catalog) => catalog.ingresses)
  .filter((ingress) => ingress.planet === 'Sun' && ingress.at > snapshotAt)
  .sort((a, b) => a.at.localeCompare(b.at))[0];
const sunNote = c.sunNote(
  Math.min(2, Math.floor(sun.degree / 10)),
  sunIngress ? { sign: sign(sunIngress.sign), date: dayMonth(sunIngress.at) } : null,
);
const moonNote = moonAge !== null ? c.moonNote(number(moonAge), moonAge === 1, moon.degree >= 29) : '';

// The lunar cycle, drawn as the Moon looks: lit on the right while waxing.
const cycle = moonCycle(daily, skyData.moons, catalogs);
const waxing = /waxing|first quarter/iu.test(daily.moon.phase);
function moonPath(fraction: number, growing: boolean, r = 20): string {
  if (fraction >= 0.985) return 'full';
  if (fraction <= 0.015) return '';
  const rx = (Math.abs(1 - 2 * fraction) * r).toFixed(2);
  const outer = growing ? 1 : 0;
  const inner = fraction < 0.5 ? (growing ? 0 : 1) : (growing ? 1 : 0);
  return `M0,-${r} A${r},${r} 0 0 ${outer} 0,${r} A${rx},${r} 0 0 ${inner} 0,-${r} Z`;
}
const todayMoonPath = moonPath(daily.moon.illumination, waxing);

// The twelve sign notes, exactly as the localized reading renders them.
const readings = SIGNS.map((entry) => ({ sign: entry, reading: dailyReadingForLocale(entry.slug, daily, locale) }));

// The dates ahead, worded from the catalogs' own fields.
const allIngresses = catalogs.flatMap((catalog) => catalog.ingresses);
const allLunations = catalogs.flatMap((catalog) => catalog.lunations);
const allStations = catalogs.flatMap((catalog) => catalog.stations);
const neighbour = (slug: string, step: number) => SIGNS[(SIGNS.findIndex((entry) => entry.slug === slug) + step + 12) % 12].slug;
const subject = (body: string) => cap(locale === 'es'
  ? (body === 'Sun' ? 'el Sol' : body === 'Moon' ? 'la Luna' : planet(body))
  : (body === 'Sun' ? 'o Sol' : body === 'Moon' ? 'a Lua' : planet(body)));
const eclipseKind = (kind: string) => c.eclipseKind[kind] ?? kind;
const eclipseType = (type: string) => c.eclipseType[type] ?? type;
const coming = comingUp(daily, catalogs, eclipseData.eclipses, eventsData.pages).map((event) => {
  const clock = `${utcClock(event.at)} UTC`;
  if (event.kind === 'eclipse') {
    const record = eclipseData.eclipses.find((eclipse) => eclipse.peak === event.at);
    return {
      ...event,
      title: c.eclipseTitle(eclipseType(record?.type ?? ''), eclipseKind(record?.kind ?? ''), sign(event.sign)),
      detail: record ? `${degreeMinutes(record.degree)} ${sign(record.sign)} · ${clock}` : clock,
      full: record?.type === 'lunar',
    };
  }
  if (event.kind === 'ingress') {
    const record = allIngresses.find((ingress) => ingress.at === event.at && ingress.planet === event.body);
    const retrograde = Boolean(record?.retrograde);
    return {
      ...event,
      title: c.ingressTitle(subject(event.body), sign(event.sign)),
      detail: `${c.ingressDetail(retrograde, sign(neighbour(event.sign, retrograde ? 1 : -1)))} · ${clock}`,
      full: false,
    };
  }
  if (event.kind === 'lunation') {
    const record = allLunations.find((lunation) => lunation.at === event.at);
    return {
      ...event,
      title: c.lunationTitle(record?.type ?? '', sign(event.sign)),
      detail: record ? `${degreeMinutes(record.degree)} ${sign(record.sign)} · ${clock}` : clock,
      full: record?.type === 'full',
    };
  }
  if (event.kind === 'station') {
    const record = allStations.find((station) => station.at === event.at && station.planet === event.body);
    return {
      ...event,
      title: c.stationTitle(planet(event.body), record?.type ?? ''),
      detail: record ? `${degreeMinutes(record.degree)} ${sign(record.sign)} · ${clock}` : clock,
      full: false,
    };
  }
  const aspect = catalogs.flatMap((catalog) => catalog.aspects).find((entry) => entry.at === event.at && entry.a === event.body);
  return {
    ...event,
    title: `${planet(event.body)} ${aspectLabel(locale, aspect?.type ?? '')} ${planet(event.other ?? '')}`,
    detail: aspect ? `${c.aspectDetail(sign(aspect.aSign), sign(aspect.bSign))} · ${clock}` : clock,
    full: false,
  };
});
const eclipseAhead = nextEclipse(daily, eclipseData.eclipses);

// Retrogrades on one time axis.
const timeline = retrogradeTimeline(daily, skyData.retrogrades);
const edition = new Date(`${daily.date}T00:00:00.000Z`);
// retrogradeTimeline opens its window three months before the edition's month.
const monthLabels = timeline.months.map((month, index) => ({
  left: month.left,
  label: monthShort(new Date(Date.UTC(edition.getUTCFullYear(), edition.getUTCMonth() - 3 + index, 1)).toISOString()),
