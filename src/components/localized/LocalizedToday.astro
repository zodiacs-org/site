// Planet names with the article the Sun and the Moon take in running text.
const named = (locale: Locale, body: string) => {
  if (body === 'Sun') return locale === 'es' ? 'el Sol' : 'o Sol';
  if (body === 'Moon') return locale === 'es' ? 'la Luna' : 'a Lua';
  return planetLabel(locale, body);
};
const cap = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);

