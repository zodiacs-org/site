              <span class="tdl-pg" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={PLANET_GLYPH[row.body] ?? ''} /></span>
              <span class="tdl-prow__name"><b>{planet(row.body)}</b><small>{cap(c.topics[row.body] ?? '')}</small></span>
              <span class="tdl-prow__sign"><SignIcon sign={row.sign} size={22} />{sign(row.sign)}</span>
              <span class="tdl-prow__deg">{row.degree}</span>
              {row.stationToday
                ? <span class="tdl-pm is-station">{c.station(row.stationToday.type, utcClock(row.stationToday.at))}</span>
                : row.body === 'Moon'
                  ? <span class="tdl-pm is-moon">{phase}</span>
                  : row.retrograde
                    ? <span class="tdl-pm is-rx">{c.retrograde}</span>
                    : <span class="tdl-pm">{c.direct}</span>}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="h-3">{c.comingTitle}</h2>
        <p class="tdl-sub">{c.comingSub}</p>
        <ol class="tdl-events">
          {coming.map((event) => {
            const tint = event.sign ? signBySlug(event.sign) : null;
            return (
              <li class:list={{ 'is-lunation': event.kind === 'lunation' || event.kind === 'eclipse' }} style={tint ? `--sign:${tint.hue}` : undefined}>
                <time datetime={event.at}><span>{monthShort(event.at)}</span><b>{new Date(event.at).getUTCDate()}</b></time>
                <div>
                  <b>{event.title}</b>
                  <small>{event.detail}</small>
                </div>
                <span class="tdl-events__ic" aria-hidden="true">
                  {event.kind === 'ingress'
                    ? <SignIcon sign={event.sign} size={24} />
                    : event.kind === 'station' || event.kind === 'aspect'
                      ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={PLANET_GLYPH[event.body] ?? ''} />
                      : <svg class="tdl-events__moon" viewBox="-24 -24 48 48"><circle r="20" fill="#1C2130" stroke="rgba(198,204,218,0.3)" stroke-width="1.5" />{event.full ? <circle r="20" fill="#E6E2D6" /> : null}</svg>}
                </span>
              </li>
            );
          })}
        </ol>
        <div class="tdl-events__foot">
          {eclipseAhead && <span>{c.nextEclipse(c.eclipseShort(eclipseType(eclipseAhead.type), eclipseKind(eclipseAhead.kind)), shortDate(eclipseAhead.peak, true))}</span>}
          <a class="textlink" href={local('/sky-calendar/')}>{c.calendarLink} <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- 6. Retrogrades on one time axis, the edition marked. -->
    <section class="kwrap tdl-sec" aria-labelledby="tdl-rx-heading">
      <div class="section-head--row tdl-head">
        <div>
          <h2 id="tdl-rx-heading" class="h-2">{c.rxTitle}</h2>
          <p>{retrogradeSummary.map((part) => (part === TODAY
            ? <><span data-edition-current-only>{c.todayWord}</span><span data-edition-dated-only>{c.onDate(dateLabel)}</span></>
            : part))}</p>
        </div>
        <a class="textlink only-desktop" href={local('/retrogrades/')}>{c.rxLink} <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <div class="tdl-rt" role="table" aria-label={c.rxTableAria(rangeWords(locale, shortDate(timeline.from, true), windowEndLabel))} style={`--tdl-at:${timeline.todayAt}%`}>
        <div class="tdl-rt__row tdl-rt__head" role="row">
          <span class="tdl-rt__name" role="columnheader"><span class="sr-only">{c.rxPlanet}</span></span>
          <div class="tdl-rt__track tdl-rt__months" role="columnheader">
            <span class="sr-only">{c.rxPeriod}</span>
            {monthLabels.map((month, index) => (
              <span
                class:list={['tdl-rt__month', { 'tdl-hide-m': month.left <= timeline.todayAt && (monthLabels[index + 1]?.left ?? 100) > timeline.todayAt }]}
                style={`left:${month.left}%`}
                aria-hidden="true"
              >{month.label}</span>
            ))}
            <b class="tdl-rt__today" aria-hidden="true"><span data-edition-current-only>{c.TodayWord}</span><span data-edition-dated-only>{editionShort}</span></b>
          </div>
        </div>
        {timeline.rows.map((row) => (
          <div class="tdl-rt__row" role="row">
            <div class="tdl-rt__name" role="rowheader">
              <span class="tdl-rt__g" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={PLANET_GLYPH[row.planet] ?? ''} /></span>
              <span>
                <b>{planet(row.planet)}</b>
                <small class:list={{ 'is-on': row.state === 'now' }}>
                  {row.state === 'now' && <span class="tdl-hide-m">{c.rxNowPrefix}</span>}
                  {rangeWords(locale, shortDate(row.from, periodYear(row.from)), shortDate(row.to, periodYear(row.to)))}{row.state === 'ended' && c.rxNowDirect}
                </small>
              </span>
            </div>
            <div class="tdl-rt__track" role="cell">
              <span class="sr-only">{row.state === 'now' ? c.rxStateNow : row.state === 'upcoming' ? c.rxStateUpcoming : c.rxStateEnded}</span>
              <i class:list={['tdl-rt__bar', `is-${row.state}`, { 'is-clip-start': row.clippedStart, 'is-clip-end': row.clippedEnd }]} style={`left:${row.left}%;width:${row.width}%`}></i>
            </div>
          </div>
        ))}
      </div>
      <div class="tdl-rt__key" aria-hidden="true">
        <span><i></i>{c.rxStateNow}</span>
        <span><i class="is-upcoming"></i>{c.rxStateUpcoming}</span>
        <span><i class="is-ended"></i>{c.rxStateEnded}</span>
        <span><i class="is-today"></i><span><span data-edition-current-only>{c.TodayWord}, </span>{editionShort}</span></span>
      </div>
      <div class="tdl-note">
        <span class="kicker">{c.rxMeansKicker}</span>
        <p>{c.rxMeans}</p>
      </div>
    </section>

    <!-- 7. The closest angles in this sky, each with what it has
         traditionally been read as. -->
    {aspectCards.length > 0 && (
      <section class="kwrap tdl-sec" aria-labelledby="tdl-aspects-heading">
        <div class="section-head--row tdl-head">
          <div>
            <h2 id="tdl-aspects-heading" class="h-2">{c.aspectsTitle}</h2>
            <p>{c.aspectsLede(allAspects.length, aspectCards.length)}</p>
          </div>
        </div>
        <div class="tdl-asps">
          {aspectCards.map((aspect) => {
            const a = bodyOf(aspect.a);
            const b = bodyOf(aspect.b);
            return (
              <article class="kcard tdl-asp">
                <div class="tdl-asp__g" aria-hidden="true">
                  <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={PLANET_GLYPH[aspect.a] ?? ''} /></span>
                  <svg class={`tdl-asp__type is-${aspect.type}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={ASPECT_GLYPH[aspect.type] ?? ''} />
                  <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={PLANET_GLYPH[aspect.b] ?? ''} /></span>
                </div>
                <h3 class="h-4">{planet(aspect.a)} {aspectLabel(locale, aspect.type)} {planet(aspect.b)}</h3>
                <p class="tdl-asp__pos">{degreeMinutes(a.degree)} {sign(a.sign)}{a.retrograde ? ' Rx' : ''} · {degreeMinutes(b.degree)} {sign(b.sign)}{b.retrograde ? ' Rx' : ''}</p>
                <p>{c.definitions[aspect.type]} {c.represent(runningName(aspect.a), c.topics[aspect.a] ?? '', runningName(aspect.b), c.topics[aspect.b] ?? '')}</p>
                <span class:list={['tdl-asp__tag', { 'is-exact': aspect.exactAt }]}>
                  {aspect.exactAt ? c.exactAt(utcClock(aspect.exactAt)) : c.fromExact(degreeMinutes(aspect.orb))}
                </span>
              </article>
            );
          })}
        </div>
      </section>
    )}

    <!-- 8. Go further, and questions for Guide. -->
    <section class="kwrap tdl-sec" aria-labelledby="tdl-further-heading">
      <div class="section-head--row tdl-head">
        <div>
          <h2 id="tdl-further-heading" class="h-2">{c.furtherTitle}</h2>
          <p>{c.furtherLede}</p>
        </div>
        <a class="textlink only-desktop" href={local('/tools/')}>{c.allTools} <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <div class="grid-4 tdl-tools">
        {goFurther.map((tool) => (
          <a class="kcard tdl-tool" href={tool.href}>
            <ToolIcon name={tool.icon} size={48} />
            <h3 class="h-4">{tool.title}</h3>
            <p>{tool.promise}</p>
            <span class="kcard__go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <div class="kcard kcard--raised tdl-ask">
        <div>
          <h3 class="h-4">{c.askTitle}</h3>
          <AskGuideLine lead={c.askLead} locale={locale} />
        </div>
        <GuideQuickPrompts prompts={c.prompts} locale={locale} label={c.askLabel} />
      </div>
    </section>

    <!-- 9. How the page is made. -->
    <section class="kwrap tdl-method" aria-labelledby="tdl-method-heading">
      <h2 id="tdl-method-heading" class="h-4">{c.methodTitle}</h2>
      <div>
        <p>{c.methodBody(dateLabel)}</p>
        {daily.eventsCoverage === 'unavailable' && <p class="tdl-coverage-note">{c.coverage}</p>}
        <EvidenceDisclosure
          class="tdl-provenance"
          variant="quiet"
          label={c.provenanceLabel}
          description={c.provenanceDescription}
        >
          <p>{c.provenanceBefore}<time datetime={daily.date}>{daily.date}</time>{c.provenanceAfter}</p>
        </EvidenceDisclosure>
        <p class="tdl-method__links">
          <a class="textlink" href={local('/methodology/')}>{c.methodLink} <span class="arr" aria-hidden="true">→</span></a>
          <a class="textlink" href="/methodology/#daily-publication" hreflang="en" title={cue?.aria}>{c.publicationLink}{cue?.suffix} <span class="arr" aria-hidden="true">→</span></a>
          <a class="textlink" href="/corrections/" hreflang="en" title={cue?.aria}>{c.correctionsLink}{cue?.suffix} <span class="arr" aria-hidden="true">→</span></a>
        </p>
      </div>
    </section>
  </section>
</Base>

<style is:global>
  .tdl-page { padding-bottom: clamp(48px, 7vw, 96px); }
  .tdl-sec { padding-top: clamp(56px, 5.8vw, 84px); }
  .tdl-head { margin-bottom: clamp(24px, 3.4vw, 40px); }
  .tdl-head > div { max-width: 720px; }
  .tdl-head p { max-width: 62ch; }
  .tdl-head > .textlink { flex: none; white-space: nowrap; }
  @media (max-width: 760px) { .tdl-hide-m { display: none; } }

  /* ── 1. Hero: the day, the wheel beside it ────────────────────── */
  .tdl-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 560px);
    align-items: start;
    gap: clamp(32px, 4vw, 72px);
    min-height: 760px;
    /* Rise behind the fixed navigation, as the home page's frame does. */
    margin: calc(12px - var(--nav-space, 96px)) 12px 0;
    padding: 120px clamp(28px, 5vw, 72px) 48px;
    overflow: hidden;
    border-radius: var(--r-xl);
    background: var(--void-1) url('/assets/hero/zodiacs-hero-poster.avif') 50% 18% / cover no-repeat;
    box-shadow: inset 0 0 0 1px rgba(198, 204, 218, 0.08);
    isolation: isolate;
  }
  .tdl-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(42% 62% at 77% 54%, rgba(6, 7, 9, 0.15), rgba(6, 7, 9, 0) 70%),
      linear-gradient(90deg, rgba(6, 7, 9, 0.96) 0%, rgba(6, 7, 9, 0.9) 42%, rgba(6, 7, 9, 0.62) 64%, rgba(6, 7, 9, 0.58) 100%),
      linear-gradient(0deg, rgba(6, 7, 9, 0.9) 0%, rgba(6, 7, 9, 0) 40%);
  }
  .tdl-hero__body { min-width: 0; padding-top: clamp(24px, 4.6vw, 64px); }
  .tdl-crumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 26px; color: var(--faint); font-size: 13px; }
  .tdl-crumbs a { color: var(--muted); text-decoration: none; }
  .tdl-crumbs a:hover { color: var(--ink-0); }
  .tdl-crumbs > span[aria-hidden] { opacity: 0.6; }
  .tdl-hero__kicker { margin: 0 0 10px; color: var(--ink-1); }
  .tdl-hero h1 {
    margin: 0;
    font-size: clamp(3.2rem, 1.6rem + 5vw, 6.2rem);
    line-height: 0.96;
    letter-spacing: -0.02em;
    overflow-wrap: break-word;
  }
  .tdl-hero__lede {
    max-width: 38ch;
    margin: 22px 0 0;
    color: var(--ink-1);
    font-size: var(--text-lg);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .tdl-hero__actions { margin-top: 30px; }
  .tdl-hero__note { margin-top: 18px; color: var(--ink-2); }
  .tdl-hero__wheel { position: relative; align-self: center; min-width: 0; margin: 0; }
  .tdl-wheel { position: relative; }
  /* The wheel's own rings are open; a dark disc behind them keeps the art
     from showing through the sky. */
  .tdl-wheel::before {
    content: '';
    position: absolute;
    inset: 6.8%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%, #151925 0%, #0A0C11 100%);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
  }
  .tdl-wheel .wheel { position: relative; display: block; width: 100%; height: auto; }
  .tdl-wheel__moon {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 15%;
    height: auto;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
  }
  .tdl-legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 18px; margin-top: 14px; color: var(--ink-2); font-size: 12.5px; }
  .tdl-legend span { display: inline-flex; align-items: center; gap: 7px; }
  .tdl-legend i { font-style: normal; }
  .tdl-legend__rx { color: rgba(224, 176, 128, 0.9); font-family: var(--font-mono); font-size: 11px; }
  .tdl-legend__line { display: inline-block; width: 18px; height: 0; border-top: 1.5px solid; }
  .tdl-legend__line--easy { color: rgba(182, 212, 228, 0.85); }
  .tdl-legend__line--tense { color: rgba(222, 142, 121, 0.85); }
  .tdl-legend__line--joined { color: rgba(238, 241, 247, 0.6); }

  /* ── 2. The sky line ──────────────────────────────────────────── */
  .tdl-skyline { margin-top: 18px; }

  /* ── 3. The Sun, the Moon and the lunar cycle ─────────────────── */
  .tdl-lights { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .tdl-light { display: flex; flex-direction: column; min-width: 0; overflow: hidden; border: 1px solid var(--hair-1); border-radius: var(--r-lg); background: rgba(198, 204, 218, 0.02); }
  .tdl-light__art { position: relative; }
  .tdl-light__art .artframe { aspect-ratio: 2 / 1; border-radius: 0; }
  .tdl-light__tag {
    position: absolute;
    z-index: 3;
    top: 16px;
    left: 18px;
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 13px;
    border: 1px solid var(--hair-2);
    border-radius: var(--r-full);
    background: rgba(10, 12, 17, 0.62);
    color: var(--ink-1);
    font-size: 13px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .tdl-light__body { display: grid; gap: 12px; padding: 24px 28px 28px; }
  .tdl-light__head { display: flex; align-items: center; gap: 14px; }
  .tdl-light p { max-width: 56ch; margin: 0; color: var(--text-2); line-height: 1.62; }
  .tdl-light p.kfacts { margin-top: 2px; color: var(--faint); }
  .tdl-cycle {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--nodes, 4), minmax(0, 1fr));
    gap: 8px;
    margin: 20px 0 0;
    padding: 26px 28px 24px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-lg);
    background: rgba(198, 204, 218, 0.015);
    list-style: none;
  }
  .tdl-cycle::before {
    content: '';
    position: absolute;
    top: 49px;
    left: calc(28px + (100% - 56px) / (2 * var(--nodes, 4)));
    right: calc(28px + (100% - 56px) / (2 * var(--nodes, 4)));
    height: 1px;
    background: var(--hair-2);
  }
  .tdl-cycle li { position: relative; display: grid; justify-items: center; gap: 4px; min-width: 0; text-align: center; }
  .tdl-moon { position: relative; z-index: 1; margin-bottom: 10px; border-radius: 50%; background: var(--void-0); box-shadow: 0 0 0 8px var(--void-0); }
  .tdl-cycle b { color: var(--ink-1); font-size: 0.9375rem; font-weight: 600; }
  .tdl-cycle li > span { color: var(--faint); font-size: 12.5px; }
  .tdl-cycle__sign::before { content: ' · '; }
  .tdl-cycle li.is-now b { color: var(--ink-0); }
  .tdl-cycle li.is-now > span { color: var(--sign-sagittarius); }
  .tdl-cycle li.is-now .tdl-moon { box-shadow: 0 0 0 8px var(--void-0), 0 0 0 9px rgba(224, 176, 128, 0.6); }

  /* ── 4. The twelve signs ──────────────────────────────────────── */
  .tdl-picker {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 6px;
    margin-bottom: 22px;
  }
  .tdl-picker a {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 6px;
    min-width: 0;
    padding: 10px 4px 9px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: rgba(198, 204, 218, 0.02);
    color: var(--muted);
    text-decoration: none;
  }
  .tdl-picker a:hover { border-color: color-mix(in oklab, var(--sign) 65%, var(--hair-2)); color: var(--text); }
  .tdl-picker a:focus-visible { outline: 2px solid var(--ink-0); outline-offset: 2px; }
  .tdl-picker__name { max-width: 100%; overflow: hidden; font-size: 12px; font-weight: 650; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
  .tdl-readings {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 16px;
  }
  .tdl-sign {
    min-width: 0;
    padding: clamp(20px, 2.4vw, 26px);
    border: 1px solid var(--hair-1);
    border-radius: var(--r-lg);
    background: rgba(198, 204, 218, 0.02);
    scroll-margin-top: 96px;
  }
  .tdl-sign:target { border-color: color-mix(in oklab, var(--sign) 45%, var(--hair-1)); background: color-mix(in oklab, var(--sign) 6%, var(--void-1)); }
  .tdl-sign__head {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr);
    grid-template-areas: 'icon name' 'icon dates';
    align-items: center;
    column-gap: 14px;
    margin-bottom: 16px;
  }
  .tdl-sign__head .sign-icon { grid-area: icon; }
  .tdl-sign__head h3 { grid-area: name; margin: 0; font-family: var(--font-serif); font-size: var(--text-xl); font-weight: 500; line-height: 1.1; }
  .tdl-sign__head small { grid-area: dates; color: var(--faint); font-size: 12.5px; }
  .tdl-sign .daily-locale__lines li { padding-left: 14px; border-left: 2px solid color-mix(in oklab, var(--sign) 60%, transparent); }
  .tdl-sign__links { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 4px 0 0; font-size: var(--text-sm); }
  .tdl-sign__links a { color: var(--text-2); text-underline-offset: 3px; text-decoration-color: var(--hair-3); }
  .tdl-sign__links a:hover { color: var(--text); }
  .tdl-personal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 22px;
    padding: 24px 28px;
    border: 1px solid var(--hair-2);
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, rgba(198, 204, 218, 0.05), rgba(198, 204, 218, 0.015));
  }
  .tdl-personal strong { color: var(--ink-0); font-size: 1.12rem; font-weight: 600; }
  .tdl-personal p { max-width: 58ch; margin: 4px 0 0; color: var(--muted); font-size: 0.9375rem; line-height: 1.55; }
  .tdl-personal__actions { display: flex; flex: none; flex-wrap: wrap; align-items: center; gap: 12px 20px; }

  /* ── 5. Planets and dates ahead ───────────────────────────────── */
  .tdl-split { display: grid; grid-template-columns: minmax(0, 1.18fr) minmax(0, 1fr); align-items: start; gap: clamp(32px, 5vw, 72px); }
  .tdl-split .h-3 { margin: 0 0 6px; }
  .tdl-sub { margin: 0 0 18px; color: var(--muted); font-size: 0.9375rem; }
  .tdl-ptable { margin: 0; padding: 0; border-top: 1px solid var(--hair-1); list-style: none; }
  .tdl-prow {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) 132px 60px 150px;
    align-items: center;
    column-gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--hair-1);
  }
  .tdl-pg { display: grid; width: 36px; height: 36px; place-items: center; border: 1px solid var(--hair-2); border-radius: 50%; background: var(--void-2); color: var(--ink-0); }
  .tdl-pg svg { width: 18px; height: 18px; }
  .tdl-prow.is-sun .tdl-pg { border-color: var(--ink-0); background: var(--ink-0); color: var(--void-0); }
  .tdl-prow__name { min-width: 0; }
