---
/**
 * Translated compatibility pair page. The article body, title and
 * description come from src/content/pairs-i18n/{locale}/{a}-{b}.mdx; the
 * panel and the three questions are computed from the sign table with
 * wording from src/lib/compat-i18n.ts. The English page
 * (src/pages/compatibility/[pair]/index.astro) is the reference layout.
 */
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SignIcon from '../SignIcon.astro';
import SynastryCalculator from '../../islands/SynastryCalculator';
import { SIGNS, signName, signDates, elementLabel, modalityLabel } from '../../lib/signs';
import { pairSlug } from '../../lib/compat';
import { localizedPairFacts, type PairLocale } from '../../lib/compat-i18n';
import { planetLabel } from '../../lib/i18n/astrology';
import { EDITOR_AUTHOR } from '../../lib/editorial';
import '../../styles/calculator.css';

interface Props { entry: CollectionEntry<'pairsLocalized'> }

const { entry } = Astro.props;
const locale: PairLocale = entry.data.locale;
const facts = localizedPairFacts(locale, entry.data.signs[0], entry.data.signs[1]);
const { a, b, same, nameA, nameB } = facts;
const { Content } = await render(entry);

interface Chrome {
  kicker: string;
  and: string;
  pairName: (a: string, b: string) => string;
  imageAlt: (a: string, b: string) => string;
  about: (sign: string) => string;
  basisTitle: string;
  basisNote: string;
  basisAria: string;
  elements: string;
  modes: string;
  polarity: string;
  faqHeading: string;
  toolHeading: string;
  toolLede: string;
  prefill: (a: string, b: string) => string;
  noscript: string;
  moreAria: string;
  withOthers: (sign: string) => string;
}

const CHROME: Record<PairLocale, Chrome> = {
  es: {
    kicker: 'Compatibilidad',
    and: 'y',
    pairName: (x, y) => `${x} y ${y}`,
    imageAlt: (x, y) => `Compatibilidad entre ${x} y ${y} — Zodiacs.org`,
    about: (s) => `${s} (astrología)`,
    basisTitle: 'Por qué esta combinación se lee así',
    basisNote: 'Elementos, modalidades, polaridad y el patrón básico de cada signo',
    basisAria: 'La astrología detrás de esta combinación',
    elements: 'Elementos',
    modes: 'Modalidades',
    polarity: 'Polaridad',
    faqHeading: 'Preguntas sobre esta combinación',
    toolHeading: 'Compara las dos cartas natales',
    toolLede: 'Los signos solares son el resumen. Si tienes los datos de nacimiento de las dos personas, la calculadora lee todos los aspectos entre sus cartas.',
    prefill: (x, y) => `Abrir la calculadora con ${x} y ${y} ya cargados`,
    noscript: 'Esta calculadora de compatibilidad necesita JavaScript. Activa JavaScript y recarga la página para comparar dos cartas natales en tu navegador.',
    moreAria: 'Más combinaciones',
    withOthers: (s) => `${s} con los demás signos`,
  },
  pt: {
    kicker: 'Compatibilidade',
    and: 'e',
    pairName: (x, y) => `${x} e ${y}`,
    imageAlt: (x, y) => `Compatibilidade entre ${x} e ${y} — Zodiacs.org`,
    about: (s) => `${s} (astrologia)`,
    basisTitle: 'Por que esse par é lido assim',
    basisNote: 'Elementos, modalidades, polaridade e o padrão básico de cada signo',
    basisAria: 'A astrologia por trás desse par',
    elements: 'Elementos',
    modes: 'Modalidades',
    polarity: 'Polaridade',
    faqHeading: 'Perguntas sobre esse par',
    toolHeading: 'Compare os dois mapas astrais',
    toolLede: 'Os signos solares são o resumo. Se você tem os dados de nascimento das duas pessoas, a calculadora lê todos os aspectos entre os mapas.',
    prefill: (x, y) => `Abrir a calculadora com ${x} e ${y} carregados`,
    noscript: 'Esta calculadora de compatibilidade precisa de JavaScript. Ative-o e recarregue a página para comparar dois mapas astrais no seu navegador.',
    moreAria: 'Mais pares',
    withOthers: (s) => `${s} com os outros signos`,
  },
  fr: {
    kicker: 'Compatibilité',
    and: 'et',
    pairName: (x, y) => `${x} et ${y}`,
    imageAlt: (x, y) => `Compatibilité ${x} et ${y} — Zodiacs.org`,
    about: (s) => `${s} (astrologie)`,
    basisTitle: 'Pourquoi ce duo se lit ainsi',
    basisNote: 'Éléments, modalités, polarité et le schéma de base de chaque signe',
    basisAria: 'L’astrologie derrière ce duo',
    elements: 'Éléments',
    modes: 'Modalités',
    polarity: 'Polarité',
    faqHeading: 'Questions sur ce duo',
    toolHeading: 'Compare les deux thèmes astraux',
    toolLede: 'Les signes solaires sont le résumé. Si tu as les données de naissance des deux personnes, le calculateur lit tous les aspects entre leurs thèmes.',
    prefill: (x, y) => `Ouvrir le calculateur avec ${x} et ${y} déjà chargés`,
    noscript: 'Ce calculateur de compatibilité nécessite JavaScript. Active JavaScript et recharge la page pour comparer deux thèmes astraux dans ton navigateur.',
    moreAria: 'Autres duos',
    withOthers: (s) => `${s} avec les autres signes`,
  },
  it: {
    kicker: 'Compatibilità',
    and: 'e',
    pairName: (x, y) => `${x} e ${y}`,
    imageAlt: (x, y) => `Compatibilità tra ${x} e ${y} — Zodiacs.org`,
    about: (s) => `${s} (astrologia)`,
    basisTitle: 'Perché questa coppia si legge così',
    basisNote: 'Elementi, modalità, polarità e lo schema di base di ciascun segno',
    basisAria: 'L’astrologia dietro questa coppia',
    elements: 'Elementi',
    modes: 'Modalità',
    polarity: 'Polarità',
    faqHeading: 'Domande su questa coppia',
    toolHeading: 'Confronta i due temi natali',
    toolLede: 'I segni solari sono il riassunto. Se hai i dati di nascita di entrambe le persone, il calcolatore legge tutti gli aspetti tra i due temi.',
    prefill: (x, y) => `Apri il calcolatore con ${x} e ${y} già caricati`,
    noscript: 'Questo calcolatore di compatibilità richiede JavaScript. Attiva JavaScript e ricarica la pagina per confrontare due temi natali nel tuo browser.',
    moreAria: 'Altre coppie',
    withOthers: (s) => `${s} con gli altri segni`,
  },
};
const c = CHROME[locale];
const prefix = `/${locale}`;
const pagePath = `${prefix}/compatibility/${facts.slug}/`;
const pageUrl = `https://zodiacs.org${pagePath}`;
const inLanguage = locale === 'pt' ? 'pt-BR' : locale;
const name = (slug: string) => signName(slug, locale);

const othersFor = (slug: string) =>
  SIGNS.filter((s) => pairSlug(slug, s.slug) !== facts.slug);

const jsonLd = [
  {
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    url: pageUrl,
    datePublished: entry.data.published.toISOString(),
    dateModified: entry.data.updated.toISOString(),
    author: EDITOR_AUTHOR,
    publisher: { '@id': 'https://zodiacs.org/#org' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
    inLanguage,
    image: `https://zodiacs.org/assets/og/v2/pair/${facts.slug}.png`,
    about: [
      { '@type': 'Thing', name: c.about(nameA) },
      { '@type': 'Thing', name: c.about(nameB) },
    ],
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: `https://zodiacs.org${prefix}/` },
      { '@type': 'ListItem', position: 2, name: c.kicker, item: `https://zodiacs.org${prefix}/compatibility/` },
      { '@type': 'ListItem', position: 3, name: c.pairName(nameA, nameB), item: pageUrl },
    ],
  },
  {
    '@type': 'FAQPage',
    inLanguage,
    mainEntity: entry.data.faq.map(({ q, a: answer }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];
---
<Base
  clientUi
  title={entry.data.title}
  description={entry.data.description}
  path={pagePath}
  locale={locale}
  image={`/assets/og/v2/pair/${facts.slug}.png`}
  imageAlt={c.imageAlt(nameA, nameB)}
  type="article"
  jsonLd={jsonLd}
>
  <article>
    <header class="pair-hero container container--narrow">
      <em class="kicker">{c.kicker}</em>
      <div class="pair-hero__lockup reveal">
        <span class="pair-hero__icons">
          <SignIcon sign={a.slug} size={104} loading="eager" class="pair-hero__icon" />
          {!same && <SignIcon sign={b.slug} size={104} loading="eager" class="pair-hero__icon pair-hero__icon--b" />}
        </span>
        <h1 class="display">{nameA} <span class="pair-hero__amp">{c.and}</span> {nameB}</h1>
      </div>
      <p class="pair-hero__lede">{entry.data.description}</p>
    </header>

    <div class="container container--narrow pair-body">
      <div class="prose reveal">
        <Content />
      </div>

      <details class="pair-basis reveal">
        <summary>
          <span>
            <strong>{c.basisTitle}</strong>
            <small>{c.basisNote}</small>
          </span>
          <span class="pair-basis__mark" aria-hidden="true"></span>
        </summary>
        <section class="pair-panel" aria-label={c.basisAria}>
          <div class="pair-panel__signs">
            {[a, b].map((s, i) => (
              <a class="pair-panel__sign tile" href={`${prefix}/${s.slug}/`} style={`--sign:${s.hue}`}>
                <SignIcon sign={s.slug} size={44} class="pair-panel__sign-icon" />
                <span class="pair-panel__sign-name">{name(s.slug)}{same ? ` ${i === 0 ? 'A' : 'B'}` : ''}</span>
                <span class="pair-panel__sign-meta mono">{signDates(s, locale)}</span>
                <span class="pair-panel__sign-meta mono">
                  {elementLabel(s.element, locale)} · {modalityLabel(s.modality, locale)} · {planetLabel(locale, s.ruler)}
                </span>
              </a>
            ))}
          </div>
          <dl class="pair-panel__rows">
            <div class="pair-panel__row">
              <dt><span class="mono--label">{c.elements}</span> {facts.element.label}</dt>
              <dd>{facts.element.note}</dd>
            </div>
            <div class="pair-panel__row">
              <dt><span class="mono--label">{c.modes}</span> {facts.modality.label}</dt>
              <dd>{facts.modality.note}</dd>
            </div>
            <div class="pair-panel__row">
              <dt><span class="mono--label">{c.polarity}</span></dt>
              <dd>{facts.polarity}</dd>
            </div>
          </dl>
        </section>
      </details>

      <section class="pair-faq reveal">
        <div class="section-head">
          <h2>{c.faqHeading}</h2>
        </div>
        <div class="pair-faq__list">
          {entry.data.faq.map(({ q, a: answer }) => (
            <details class="pair-faq__item">
              <summary>{q}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="pair-tool reveal">
        <div class="section-head">
          <h2>{c.toolHeading}</h2>
          <p>{c.toolLede}</p>
        </div>
        <p>
          <a class="btn btn--glass" href={`${prefix}/compatibility/?sign1=${a.slug}&sign2=${b.slug}#calculator`}>
            <span>{c.prefill(nameA, nameB)}</span><span class="orb">→</span>
          </a>
        </p>
        <SynastryCalculator locale={locale} client:visible />
        <noscript>
          <p>{c.noscript}</p>
        </noscript>
      </section>

      <nav class="pair-more reveal" aria-label={c.moreAria}>
        <div class="pair-more__col">
          <span class="pair-more__head">{c.withOthers(nameA)}</span>
          <div class="pair-more__chips">
            {othersFor(a.slug).map((s) => (
              <a class="pair-more__chip" href={`${prefix}/compatibility/${pairSlug(a.slug, s.slug)}/`}>{name(s.slug)}</a>
            ))}
          </div>
        </div>
        {!same && (
          <div class="pair-more__col">
            <span class="pair-more__head">{c.withOthers(nameB)}</span>
            <div class="pair-more__chips">
              {othersFor(b.slug).map((s) => (
                <a class="pair-more__chip" href={`${prefix}/compatibility/${pairSlug(b.slug, s.slug)}/`}>{name(s.slug)}</a>
              ))}
            </div>
          </div>
        )}
      </nav>
    </div>
  </article>
</Base>

<style>
  .pair-hero { padding-block: clamp(24px, 5vw, 56px) clamp(18px, 3vw, 30px); }
  .pair-hero__lockup {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 14px;
  }
  @media (min-width: 700px) {
    .pair-hero__lockup { flex-direction: row; align-items: center; gap: 30px; }
  }
  .pair-hero__icons { display: inline-flex; }
  .pair-hero :global(.pair-hero__icon) {
    width: clamp(72px, 10vw, 104px);
    border-radius: 50%;
  }
  .pair-hero :global(.pair-hero__icon--b) { margin-left: -18px; }
  .pair-hero h1 {
    margin: 0;
    font-size: clamp(2.1rem, 1.4rem + 3.4vw, 3.6rem);
    line-height: 1.02;
  }
  .pair-hero__amp {
    font-style: italic;
    color: var(--muted);
  }
  .pair-hero__lede {
    margin: 18px 0 0;
    max-width: 60ch;
    color: var(--muted);
    font-size: var(--text-lg);
    text-wrap: pretty;
  }

  .pair-body { display: grid; gap: clamp(30px, 5vw, 52px); padding-bottom: clamp(36px, 6vw, 72px); }

  .pair-basis {
    padding: 3px 18px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: var(--void-1);
  }
  .pair-basis > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 13px 0;
    cursor: pointer;
    list-style: none;
  }
  .pair-basis > summary::-webkit-details-marker { display: none; }
  .pair-basis > summary > span:first-child { display: grid; gap: 2px; }
  .pair-basis > summary strong { color: var(--text); font-size: var(--text-sm); }
  .pair-basis > summary small { color: var(--faint); font-size: var(--text-xs); }
  .pair-basis__mark::before { content: '+'; color: var(--muted); font-family: var(--font-mono); }
  .pair-basis[open] .pair-basis__mark::before { content: '−'; }

  .pair-panel { display: grid; gap: 18px; padding: 2px 0 15px; }
  .pair-panel__signs {
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) { .pair-panel__signs { grid-template-columns: 1fr 1fr; } }
  .pair-panel__sign {
    display: grid;
    justify-items: start;
    gap: 6px;
    padding: 18px;
    text-decoration: none;
    color: var(--text);
  }
  @media (min-width: 560px) {
    .pair-panel__sign {
      grid-template-columns: auto 1fr;
      column-gap: 16px;
      align-content: center;
      align-items: start;
    }
    .pair-panel__sign :global(.pair-panel__sign-icon) { grid-row: 1 / span 3; align-self: center; }
  }
  .pair-panel__sign :global(img) { border-radius: 50%; }
  .pair-panel__sign-name { font-weight: 620; font-size: var(--text-lg); letter-spacing: -0.01em; }
  .pair-panel__sign-meta { font-size: 10.5px; letter-spacing: 0.07em; color: var(--faint); }

  .pair-panel__rows { margin: 0; display: grid; }
  .pair-panel__row {
    display: grid;
    gap: 4px 26px;
    padding: 14px 0;
    border-bottom: 1px solid var(--hair-1);
  }
  .pair-panel__row:first-child { border-top: 1px solid var(--hair-1); }
  @media (min-width: 700px) {
    .pair-panel__row { grid-template-columns: 220px minmax(0, 1fr); }
  }
  .pair-panel__row dt {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--text);
  }
  .pair-panel__row dd { margin: 0; font-size: var(--text-sm); color: var(--text-2); line-height: 1.65; max-width: 58ch; }

  .pair-tool :global(.section-head) { margin-bottom: 22px; }

  .pair-faq__list { display: grid; gap: 8px; }
  .pair-faq__item {
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: var(--void-1);
    padding: 4px 18px;
  }
  .pair-faq__item summary { cursor: pointer; padding: 12px 0; font-weight: 550; color: var(--text); }
  .pair-faq__item p { margin: 2px 0 16px; color: var(--text-2); font-size: var(--text-sm); line-height: 1.65; }

  .pair-more {
    display: grid;
    gap: 24px;
    padding-top: clamp(20px, 4vw, 32px);
    border-top: 1px solid var(--hair-1);
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) { .pair-more { grid-template-columns: 1fr 1fr; } }
  .pair-more__col { display: grid; gap: 10px; align-content: start; }
  .pair-more__head { font-weight: 600; font-size: var(--text-sm); color: var(--text); }
  .pair-more__chips { display: flex; flex-wrap: wrap; gap: 4px 2px; }
  .pair-more__chip {
    padding: 4px 9px;
    border-radius: var(--r-full);
    font-size: 12.5px;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }
  .pair-more__chip:hover { color: var(--text); background: color-mix(in oklab, var(--ink-2) 12%, transparent); }
</style>
