---
/**
 * Translated compatibility pair page. The article body, title and
 * description come from src/content/pairs-i18n/{locale}/{a}-{b}.mdx; the
 * panel and the three questions are computed from the sign table with
 * wording from src/lib/compat-i18n.ts. The English page
 * (src/pages/compatibility/[pair]/index.astro) is the reference layout.
 */
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SignIcon from '../SignIcon.astro';
import ArtFrame from '../ArtFrame.astro';
import SynastryCalculator from '../../islands/SynastryCalculator';
import { SIGNS, signName, elementLabel, modalityLabel, type Sign } from '../../lib/signs';
import { signDateRange } from '../../lib/sign-display';
import { pairSlug } from '../../lib/compat';
import { elementMedallionSrc, elementMedallionSrcset } from '../../lib/art';
import { localizedPairFacts, type PairLocale } from '../../lib/compat-i18n';
import { planetLabel } from '../../lib/i18n/astrology';
import { EDITOR_AUTHOR } from '../../lib/editorial';
import '../../styles/calculator.css';
import '../../styles/pair-page.css';

interface Props { entry: CollectionEntry<'pairsLocalized'> }

const { entry } = Astro.props;
const locale: PairLocale = entry.data.locale;
const facts = localizedPairFacts(locale, entry.data.signs[0], entry.data.signs[1]);
const { a, b, same, nameA, nameB } = facts;
const { Content } = await render(entry);

interface Chrome {
  kicker: string;
  and: string;
  pairName: (a: string, b: string) => string;
  imageAlt: (a: string, b: string) => string;
  about: (sign: string) => string;
  basisTitle: string;
  basisNote: string;
  basisAria: string;
  elements: string;
  modes: string;
  polarity: string;
  faqHeading: string;
  toolHeading: string;
  toolLede: string;
  prefill: (a: string, b: string) => string;
  noscript: string;
  moreAria: string;
  withOthers: (sign: string) => string;
}

const CHROME: Record<PairLocale, Chrome> = {
  es: {
    kicker: 'Compatibilidad',
    and: 'y',
    pairName: (x, y) => `${x} y ${y}`,
    imageAlt: (x, y) => `Compatibilidad entre ${x} y ${y} | Zodiacs.org`,
    about: (s) => `${s} (astrología)`,
    basisTitle: 'Por qué esta combinación se lee así',
    basisNote: 'Elementos, modalidades, polaridad y el patrón básico de cada signo',
    basisAria: 'La astrología detrás de esta combinación',
    elements: 'Elementos',
    modes: 'Modalidades',
    polarity: 'Polaridad',
    faqHeading: 'Preguntas sobre esta combinación',
    toolHeading: 'Compara las dos cartas natales',
    toolLede: 'Los signos solares son el resumen. Si tienes los datos de nacimiento de las dos personas, la calculadora lee todos los aspectos entre sus cartas.',
    prefill: (x, y) => `Abrir la calculadora con ${x} y ${y} ya cargados`,
    noscript: 'Esta calculadora de compatibilidad necesita JavaScript. Activa JavaScript y recarga la página para comparar dos cartas natales en tu navegador.',
    moreAria: 'Más combinaciones',
    withOthers: (s) => `${s} con los demás signos`,
  },
  pt: {
    kicker: 'Compatibilidade',
    and: 'e',
    pairName: (x, y) => `${x} e ${y}`,
    imageAlt: (x, y) => `Compatibilidade entre ${x} e ${y} | Zodiacs.org`,
    about: (s) => `${s} (astrologia)`,
    basisTitle: 'Por que esse par é lido assim',
    basisNote: 'Elementos, modalidades, polaridade e o padrão básico de cada signo',
    basisAria: 'A astrologia por trás desse par',
    elements: 'Elementos',
    modes: 'Modalidades',
    polarity: 'Polaridade',
    faqHeading: 'Perguntas sobre esse par',
    toolHeading: 'Compare os dois mapas astrais',
    toolLede: 'Os signos solares são o resumo. Se você tem os dados de nascimento das duas pessoas, a calculadora lê todos os aspectos entre os mapas.',
    prefill: (x, y) => `Abrir a calculadora com ${x} e ${y} carregados`,
    noscript: 'Esta calculadora de compatibilidade precisa de JavaScript. Ative-o e recarregue a página para comparar dois mapas astrais no seu navegador.',
    moreAria: 'Mais pares',
    withOthers: (s) => `${s} com os outros signos`,
  },
  fr: {
    kicker: 'Compatibilité',
    and: 'et',
    pairName: (x, y) => `${x} et ${y}`,
    imageAlt: (x, y) => `Compatibilité ${x} et ${y} | Zodiacs.org`,
    about: (s) => `${s} (astrologie)`,
    basisTitle: 'Pourquoi ce duo se lit ainsi',
    basisNote: 'Éléments, modalités, polarité et le schéma de base de chaque signe',
    basisAria: 'L’astrologie derrière ce duo',
    elements: 'Éléments',
    modes: 'Modalités',
    polarity: 'Polarité',
    faqHeading: 'Questions sur ce duo',
    toolHeading: 'Compare les deux thèmes astraux',
    toolLede: 'Les signes solaires sont le résumé. Si tu as les données de naissance des deux personnes, le calculateur lit tous les aspects entre leurs thèmes.',
    prefill: (x, y) => `Ouvrir le calculateur avec ${x} et ${y} déjà chargés`,
    noscript: 'Ce calculateur de compatibilité nécessite JavaScript. Active JavaScript et recharge la page pour comparer deux thèmes astraux dans ton navigateur.',
    moreAria: 'Autres duos',
    withOthers: (s) => `${s} avec les autres signes`,
  },
  it: {
    kicker: 'Compatibilità',
    and: 'e',
    pairName: (x, y) => `${x} e ${y}`,
    imageAlt: (x, y) => `Compatibilità tra ${x} e ${y} | Zodiacs.org`,
    about: (s) => `${s} (astrologia)`,
    basisTitle: 'Perché questa coppia si legge così',
    basisNote: 'Elementi, modalità, polarità e lo schema di base di ciascun segno',
    basisAria: 'L’astrologia dietro questa coppia',
    elements: 'Elementi',
    modes: 'Modalità',
    polarity: 'Polarità',
    faqHeading: 'Domande su questa coppia',
    toolHeading: 'Confronta i due temi natali',
    toolLede: 'I segni solari sono il riassunto. Se hai i dati di nascita di entrambe le persone, il calcolatore legge tutti gli aspetti tra i due temi.',
    prefill: (x, y) => `Apri il calcolatore con ${x} e ${y} già caricati`,
    noscript: 'Questo calcolatore di compatibilità richiede JavaScript. Attiva JavaScript e ricarica la pagina per confrontare due temi natali nel tuo browser.',
    moreAria: 'Altre coppie',
    withOthers: (s) => `${s} con gli altri segni`,
  },
};
const c = CHROME[locale];
const prefix = `/${locale}`;
const pagePath = `${prefix}/compatibility/${facts.slug}/`;
const pageUrl = `https://zodiacs.org${pagePath}`;
const inLanguage = locale === 'pt' ? 'pt-BR' : locale;
const name = (slug: string) => signName(slug, locale);

const people = same ? [a] : [a, b];
const lower = (value: string) => value.charAt(0).toLocaleLowerCase(locale) + value.slice(1);
const pairOf = (x: string, y: string) => `${x} ${c.and} ${lower(y)}`;
const otherPairs = (sign: Sign) => SIGNS.map((other) => {
  const slug = pairSlug(sign.slug, other.slug);
  return { other, slug, now: slug === facts.slug };
});
const signFacts = (sign: Sign) => `${signDateRange(sign, locale)} · ${elementLabel(sign.element, locale)} · ${modalityLabel(sign.modality, locale)} · ${planetLabel(locale, sign.ruler)}`;

const jsonLd = [
  {
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    url: pageUrl,
    datePublished: entry.data.published.toISOString(),
    dateModified: entry.data.updated.toISOString(),
    author: EDITOR_AUTHOR,
    publisher: { '@id': 'https://zodiacs.org/#org' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
    inLanguage,
    image: `https://zodiacs.org/assets/og/v2/pair/${facts.slug}.png`,
    about: [
      { '@type': 'Thing', name: c.about(nameA) },
      { '@type': 'Thing', name: c.about(nameB) },
    ],
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Zodiacs.org', item: `https://zodiacs.org${prefix}/` },
      { '@type': 'ListItem', position: 2, name: c.kicker, item: `https://zodiacs.org${prefix}/compatibility/` },
      { '@type': 'ListItem', position: 3, name: c.pairName(nameA, nameB), item: pageUrl },
    ],
  },
  {
    '@type': 'FAQPage',
    inLanguage,
    mainEntity: entry.data.faq.map(({ q, a: answer }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];
---
<Base
  clientUi
  inlineCriticalCss
  title={entry.data.title}
  description={entry.data.description}
  path={pagePath}
  locale={locale}
  image={`/assets/og/v2/pair/${facts.slug}.png`}
  imageAlt={c.imageAlt(nameA, nameB)}
  type="article"
  jsonLd={jsonLd}
>
  <link slot="head" rel="preload" href="/fonts/eb-garamond-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />
  <article class="ph ph--localized" style={`--a:${a.hue};--b:${b.hue}`}>
    <header class="ph-hero">
      <div class="ph-hero__art">
        <ArtFrame sign={a.slug} locale={locale} flip eager avif class="ph-pane ph-pane--a" sizes="(max-width: 760px) 128vw, 66vw" />
        {/* The second painting waits behind the first, the page's largest element. */}
        <ArtFrame sign={b.slug} locale={locale} eager fetchPriority="low" avif alt={same ? '' : undefined} class="ph-pane ph-pane--b" sizes="(max-width: 760px) 128vw, 66vw" />
      </div>
      {/* The discs and the Change pair minis wait behind the first painting too: on a slow link Chrome raises on-screen images to high priority at the first layout unless they ask for low. */}
      <div class="ph-hero__pair" aria-hidden="true">
        {people.map((sign) => <SignIcon sign={sign.slug} size={84} loading="eager" fetchPriority="low" class="ph-hero__disc" />)}
      </div>
      <div class="ph-hero__body">
        <span class="kicker"><a href={`${prefix}/compatibility/`}>{c.kicker}</a></span>
        <h1 class="h-hero">{nameA} <em>{c.and}</em> {nameB}</h1>
        <p class="ph-hero__cap">{entry.data.description}</p>
        <div class="btn-row">
          <a class="btn btn--primary btn--lg" href="#compare"><span>{c.toolHeading}</span><span class="orb" aria-hidden="true">↗</span></a>
          <a class="btn btn--glass btn--lg ph-change" href="#switch">
            <span class="ph-change__minis" aria-hidden="true">
              {people.map((sign) => <SignIcon sign={sign.slug} size={22} loading="eager" fetchPriority="low" />)}
            </span>
            <span>{c.moreAria}</span>
            <svg class="ph-change__swap" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h15M15 4l4 4-4 4M20 16H5M9 12l-4 4 4 4" /></svg>
          </a>
        </div>
      </div>
      <span class="ph-hero__label ph-hero__label--l">{nameA} · {signDateRange(a, locale)}</span>
      {!same && <span class="ph-hero__label ph-hero__label--r">{nameB} · {signDateRange(b, locale)}</span>}
    </header>

    <div class="kwrap ph-pattern">
      <div class:list={['ph-ticker', same && 'ph-ticker--one']} role="group" aria-label={c.basisAria}>
        {people.map((sign) => (
          <span class="ph-ticker__item ph-ticker__item--sign"><SignIcon sign={sign.slug} size={18} /><b>{name(sign.slug)}</b><span>{signDateRange(sign, locale)}</span></span>
        ))}
        <span class="ph-ticker__item">{pairOf(elementLabel(a.element, locale), elementLabel(b.element, locale))}</span>
        <span class="ph-ticker__item">{pairOf(modalityLabel(a.modality, locale), modalityLabel(b.modality, locale))}</span>
        <a class="textlink" href="#basis">{c.basisTitle} <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>

    <section class="ksection ph-readsec ph-readsec--localized">
      <div class="kwrap kwrap--narrow">
        <div class="ph-feature">
          <div class="prose pair-prose"><Content /></div>

          <section class="ph-basis" id="basis" aria-label={c.basisAria}>
            <h2 class="h-3">{c.basisTitle}</h2>
            <p class="ph-basis__sub">{c.basisNote}</p>
            <div class:list={['ph-basis__signs', same && 'ph-basis__signs--one']}>
              {people.map((sign) => (
                <a href={`${prefix}/${sign.slug}/`}>
                  <SignIcon sign={sign.slug} size={40} />
                  <span><b>{name(sign.slug)}</b><small>{signFacts(sign)}</small></span>
                </a>
              ))}
            </div>
            <dl>
              <div><dt>{c.elements}</dt><dd class="ph-basis__v">{facts.element.label}<span class="ph-el" aria-hidden="true">{people.map((sign) => <img src={elementMedallionSrc(sign.element)} srcset={elementMedallionSrcset(sign.element)} sizes="64px" width="128" height="128" alt="" loading="lazy" decoding="async" />)}</span></dd><dd class="ph-basis__m">{facts.element.note}</dd></div>
              <div><dt>{c.modes}</dt><dd class="ph-basis__v">{facts.modality.label}</dd><dd class="ph-basis__m">{facts.modality.note}</dd></div>
              <div><dt>{c.polarity}</dt><dd class="ph-basis__m ph-basis__m--wide">{facts.polarity}</dd></div>
            </dl>
          </section>
        </div>
      </div>
    </section>

    <div class="kwrap"><hr class="ph-rule" /></div>

    <section class="ksection ph-comparesec" id="compare" aria-labelledby="compare-title">
      <div class="kwrap ph-compare">
        <div class="ph-compare__intro">
          <h2 class="h-2" id="compare-title">{c.toolHeading}</h2>
          <p class="klede">{c.toolLede}</p>
        </div>
        <!-- Keep the display: contents layout outside the visibility observer. -->
        <div class="calc"><SynastryCalculator locale={locale} unwrapped client:visible /></div>
        <noscript>
          <p class="ph-compare__noscript">{c.noscript}</p>
        </noscript>
      </div>
    </section>

    <section class="ksection ph-questions" aria-labelledby="questions-title">
      <div class="kwrap qa">
        <div>
          <h2 class="h-2" id="questions-title">{c.faqHeading}</h2>
        </div>
        <div class="kfaq">
          {entry.data.faq.map(({ q, a: answer }, index) => (
            <details open={index === 0}>
              <summary>{q}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="ksection ph-switch" id="switch" aria-labelledby="switch-title">
      <div class="kwrap">
        <div class="section-head ph-switch__head">
          <h2 class="h-2" id="switch-title">{c.moreAria}</h2>
        </div>
        {people.map((sign) => (
          <div class="ph-others">
            <div class="ph-others__head">
              <h3><SignIcon sign={sign.slug} size={26} />{c.withOthers(name(sign.slug))}</h3>
            </div>
            <ul class="ph-pairs" role="list">
              {otherPairs(sign).map(({ other, slug, now }) => (
                <li>
                  <a href={`${prefix}/compatibility/${slug}/`} class:list={[now && 'is-now']} aria-current={now ? 'page' : undefined} style={`--now:${(now && !same ? (sign.slug === a.slug ? b : a) : sign).hue}`}>
                    <SignIcon sign={other.slug} size={38} />
                    <b>{name(other.slug)}</b>
                    <small>{elementLabel(other.element, locale)}</small>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </article>
</Base>
