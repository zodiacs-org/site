---
/**
 * The guide's partner signs as two groups of pastel discs: the frontmatter's
 * easeful and charged shortlists, each pair with the one-line summary its
 * own compatibility page carries (the part of its description after the
 * colon). No scores.
 */
import { getEntry } from 'astro:content';
import SignIcon from '../SignIcon.astro';
import { signBySlug } from '../../lib/signs';
import { pairSlug } from '../../lib/compat';

interface Props {
  sign: string;
}
const { sign: slug } = Astro.props;
const sign = signBySlug(slug);
const guide = await getEntry('guides', slug);
if (!guide) throw new Error(`GuidePartners: no guide for ${slug}`);

async function partner(otherSlug: string) {
  const other = signBySlug(otherSlug);
  const pair = pairSlug(sign.slug, other.slug);
  const entry = await getEntry('pairs', pair);
  if (!entry) throw new Error(`GuidePartners: no pair page for ${pair}`);
  const summary = entry.data.description.split(/:\s+/u).slice(1).join(': ').trim();
  if (!summary) throw new Error(`GuidePartners: ${pair} description has no summary after its colon`);
  return {
    other,
    href: `/compatibility/${pair}/`,
    line: summary.charAt(0).toUpperCase() + summary.slice(1),
  };
}

const groups = [
  {
    title: 'Easy chemistry',
    note: 'Sun-sign pairings that tend to run easily from the start.',
    partners: await Promise.all(guide.data.compat.easeful.map(partner)),
  },
  {
    title: 'Charged, and often durable',
    note: 'Pairings with more friction, which some couples thrive on.',
    partners: await Promise.all(guide.data.compat.charged.map(partner)),
  },
];
---
<div class="guide-partners">
  {groups.map((group) => (
    <div class="guide-partners__group">
      <h3>{group.title}</h3>
      <p class="guide-partners__note">{group.note}</p>
      <ul>
        {group.partners.map(({ other, href, line }) => (
          <li>
            <a href={href} style={`--sign:${other.hue}`}>
              <SignIcon sign={other.slug} size={44} />
              <span class="guide-partners__text">
                <b>{sign.name} and {other.name}</b>
                <span>{line}</span>
              </span>
              <span class="guide-partners__go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

<style>
  .guide-partners { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 34px; }
  .guide-partners__group { border: 1px solid var(--hair-2); border-radius: var(--r-lg); padding: 24px 24px 10px; background: rgba(198, 204, 218, 0.02); }
  .guide-partners h3 { margin: 0; font-family: var(--font-serif); font-weight: 500; font-size: 1.45rem; line-height: 1.15; letter-spacing: 0; color: var(--ink-0); }
  .guide-partners .guide-partners__note { margin: 6px 0 0; max-width: none; font-size: 0.9375rem; line-height: 1.5; color: var(--muted); }
  .guide-partners ul { list-style: none; padding: 0; margin: 16px 0 0; }
  .guide-partners li { margin: 0; }
  .guide-partners a {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 28px;
    gap: 14px;
    align-items: center;
    padding: 14px 0;
    border-top: 1px solid var(--hair-1);
    color: var(--ink-0);
    text-decoration: none;
  }
  .guide-partners__text b { display: block; font-weight: 600; font-size: 1rem; line-height: 1.35; }
  .guide-partners__text span { display: block; margin-top: 1px; font-size: 0.875rem; line-height: 1.45; color: var(--muted); }
  .guide-partners__go {
    display: grid; place-items: center;
    width: 28px; height: 28px;
    border-radius: 50%;
    border: 1px solid var(--hair-2);
    font-size: 12px;
    color: var(--ink-1);
    transition: border-color var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .guide-partners a:hover .guide-partners__go { border-color: color-mix(in oklab, var(--sign) 60%, transparent); transform: translateX(2px); }
    .guide-partners a:hover b { color: #fff; }
  }
  @media (prefers-reduced-motion: reduce) { .guide-partners__go { transition: none; } }
  @media (max-width: 760px) {
    .guide-partners { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .guide-partners__group { padding: 20px 18px 6px; }
  }
</style>
