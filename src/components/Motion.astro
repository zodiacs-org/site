---
/**
 * The site's shared entrance motion (docs/MOTION.md). Put <Motion /> once,
 * near the top of a page's content and before anything marked with
 * data-enter (the attribute is data-enter, not data-motion, which /thesis/
 * figures and the chart explorer already use for other things). It:
 *
 *   1. turns motion on (html[data-entrance="on"]) before the marked elements
 *      are parsed, unless the reader asks for reduced motion, so nothing
 *      flashes visible and then disappears;
 *   2. reveals each marked element once, as it scrolls into view, and never
 *      again (one calm pass, then still);
 *   3. exposes window.zodiacsMotion.scan(root) so islands that render later
 *      (a calculator's result, say) can hand their new nodes over. From an
 *      island, import { motionScan } from '../lib/motion'.
 *
 * Both scripts are inline and small: no extra request, nothing in the way of
 * the first paint. The timings live in src/styles/motion.css.
 */
import '../styles/motion.css';
---
<script is:inline>
  (function () {
    var root = document.documentElement;
    if (root.hasAttribute('data-entrance')) return;
    var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    root.setAttribute('data-entrance', still || !('IntersectionObserver' in window) ? 'off' : 'on');
  })();
</script>
<script is:inline>
  (function () {
    if (window.zodiacsMotion) return;
    var on = document.documentElement.getAttribute('data-entrance') === 'on';
    // Elements that come into view together are staggered in document
    // order, so a grid of cards arrives as a wave however far down it sits.
    // A marked element inside another one (a card's disc) takes no step of
    // its own: it inherits the parent's --motion-i, so the wave counts cards,
    // not parts, even when the two arrive in different batches.
    // Threshold 0, as with .reveal: a block shows as soon as any of it is on
    // screen, however tall it is.
    var io = on && new IntersectionObserver(function (entries) {
      var step = 0;
      for (var i = 0; i < entries.length; i++) {
        var el = entries[i].target;
        if (!entries[i].isIntersecting) continue;
        var nested = el.parentElement && el.parentElement.closest('[data-enter]');
        if (!nested && !el.style.getPropertyValue('--motion-i')) el.style.setProperty('--motion-i', String(Math.min(step++, 8)));
        el.classList.add('is-in');
        io.unobserve(el);
        settle(el);
      }
    }, { threshold: 0 });
    // Once the pass is over the element is left alone (.is-done), so its own
    // transitions, such as a card's hover, run without the entrance delay.
    function settle(el) {
      window.setTimeout(function () { el.classList.add('is-done'); }, 2600);
    }
    // Keyboard readers never wait on an entrance: the first Tab shows
    // everything at once and the page stays still from then on.
    var keyboard = false;
    function showAll() {
      keyboard = true;
      if (io) io.disconnect();
      var marked = document.querySelectorAll('[data-enter]');
      for (var m = 0; m < marked.length; m++) marked[m].classList.add('is-in', 'is-done');
    }
    function scan(scope) {
      var marked = (scope || document).querySelectorAll('[data-enter]:not(.is-in)');
      for (var m = 0; m < marked.length; m++) {
        if (io && !keyboard) io.observe(marked[m]);
        else marked[m].classList.add('is-in', 'is-done');
      }
    }
    if (io) {
      document.addEventListener('keydown', function onKey(event) {
        if (event.key !== 'Tab') return;
        document.removeEventListener('keydown', onKey, true);
        showAll();
      }, true);
    }
    window.zodiacsMotion = { scan: scan };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { scan(); }, { once: true });
    else scan();
  })();
</script>
