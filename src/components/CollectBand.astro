---
/**
 * The one sanctioned cross-link from a guide into the collector's wing.
 * Quiet, museum-toned, near the top so visitors arriving from external
 * listings find the record in one click. No market language here.
 */
import { englishOnlyCue, t, type Locale } from '../lib/i18n';

interface Props {
  signName: string;
  slug: string;
  locale?: Locale;
  surface?: 'sign_guide' | 'birthday';
}
const { signName, slug, locale = 'en', surface = 'sign_guide' } = Astro.props;
const copy = {
  label: t(locale, 'recordLabel'),
  text: `${signName} ${t(locale, 'recordOneOfTwelve')}`,
  link: t(locale, 'recordViewLink'),
};
// The registry record is English; recordViewLink carries the visible cue.
const englishOnly = englishOnlyCue(locale);
---
<aside
  class="collect-band"
  data-registry-bridge
  data-registry-bridge-sign={slug}
  data-registry-bridge-surface={surface}
  data-registry-bridge-locale={locale}
>
  <span class="collect-band__label">{copy.label}</span>
  <span class="collect-band__text">
    {copy.text}
  </span>
  <a
    class="collect-band__link"
    href={`/registry/${slug}/`}
    hreflang={englishOnly ? 'en' : undefined}
    title={englishOnly?.aria}
  >{copy.link}</a>
</aside>

<script is:inline>
  (function () {
    var bridges = document.querySelectorAll(
      '[data-registry-bridge]:not([data-registry-bridge-bound])'
    );
    bridges.forEach(function (bridge) {
      bridge.dataset.registryBridgeBound = '';
      var sign = bridge.dataset.registryBridgeSign;
      var surface = bridge.dataset.registryBridgeSurface;
      var locale = bridge.dataset.registryBridgeLocale;
      if (!sign || !surface || !locale) return;
      var properties = { sign: sign, surface: surface, locale: locale };
      window.zodiacsAnalytics.track('registry_bridge_impression', properties);
      var link = bridge.querySelector('.collect-band__link');
      if (link) link.addEventListener('click', function () {
        window.zodiacsAnalytics.track('registry_bridge_click', properties);
      });
    });
  })();
</script>

<style>
  .collect-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    padding: 12px 18px;
    border: 1px solid var(--hair-1);
    border-radius: var(--r-md);
    background: var(--void-1);
    transition: border-color var(--dur-1) var(--ease), background-color var(--dur-1) var(--ease);
  }
  /* The strip is one link: it answers the pointer and keyboard as a whole. */
  .collect-band:focus-within { border-color: var(--hair-3); }
  @media (hover: hover) and (pointer: fine) {
    .collect-band:hover { border-color: var(--hair-2); background: var(--void-2); }
    .collect-band:hover .collect-band__link { color: var(--text); transform: translateX(2px); }
  }
  .collect-band__label {
    font-family: var(--font-sans);
    font-size: 12.5px;
    letter-spacing: 0;
    text-transform: none;
    font-variant-numeric: tabular-nums;
    color: var(--faint);
  }
  .collect-band__text {
    font-size: 13px;
    color: var(--muted);
  }
  .collect-band__link {
    margin-inline-start: auto;
    font-size: 13px;
    font-weight: 550;
    color: var(--text-2);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
  }
  .collect-band__link:hover { color: var(--text); }
  @media (prefers-reduced-motion: reduce) {
    .collect-band, .collect-band__link { transition: none; }
    .collect-band:hover .collect-band__link { transform: none; }
  }
</style>
