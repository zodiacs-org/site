---
import { ruOgImageForPath } from '../../strings/seo.ru.mjs';
import Base from '../../layouts/Base.astro';
import ReturnPersonal from '../../islands/ReturnPersonal';
import PersonalCalendar from '../../islands/PersonalCalendar';
import ReturnToolLinks from './ReturnToolLinks.astro';
import SkyMonth from './SkyMonth.astro';
import HeroCrop from '../HeroCrop.astro';
import { localizePath, type CatalogLocale } from '../../lib/i18n';
import { headsUpText as h, returnText as s } from '../../lib/return-visits/copy';
import { HEADS_UP_ICS_PATH, HEADS_UP_JSON_PATH, HEADS_UP_ORIGIN } from '../../lib/sky-heads-up';
import { sharingText } from '../../lib/sharing/copy';
import '../../styles/calculator.css';
import '../../styles/sharing-tools.css';
import '../../styles/return-visits.css';
interface Props { kind: 'calendar' | 'kit' | 'wrapped'; locale?: CatalogLocale }
const { kind, locale = 'en' } = Astro.props;
const titleKey = ({ calendar: 'calendarTitle', kit: 'kitTitle', wrapped: 'wrappedTitle' } as const)[kind];
const ledeKey = ({ calendar: 'calendarLede', kit: 'kitLede', wrapped: 'wrappedLede' } as const)[kind];
const path = ({ calendar: '/sky-calendar/', kit: '/astrologer-kit/', wrapped: '/your-sky-wrapped/' })[kind];
const route = localizePath(locale, path);
const feed = `https://zodiacs.org${locale === 'en' ? '' : `/${locale}`}/sky-calendar.ics`;
// The heads-up calendar is English only for now; other locales follow with their own copy.
const headsUp = kind === 'calendar' && locale === 'en' ? `${HEADS_UP_ORIGIN}${HEADS_UP_ICS_PATH}` : null;
const jsonLd = kind === 'calendar' ? [] : [{ '@type': 'WebApplication', name: s(locale, titleKey), url: `https://zodiacs.org${route}`, applicationCategory: 'LifestyleApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } }];
---
<Base accountSurface privateSurface={kind !== 'calendar'} clientUi locale={locale} path={route} title={`${s(locale, titleKey)} | Zodiacs.org`} description={s(locale, ledeKey)} image={locale === 'ru' ? ruOgImageForPath(route) ?? '/assets/og/v2/ru/share.png' : `/assets/og/v2/tool/${({ calendar: 'sky-calendar', kit: 'astrologer-kit', wrapped: 'your-sky-wrapped' })[kind]}.png`} imageAlt={s(locale, titleKey)} jsonLd={jsonLd} glass>
  <section class="section--tight container return-page">
    <header class="tool-hero sharing-hero"><h1 class="display">{s(locale, titleKey)}</h1><p>{s(locale, ledeKey)}</p></header>
    {kind === 'calendar' && <SkyMonth locale={locale} />}
    {kind === 'calendar' ? <div class="return-panel">
      <HeroCrop crop="sun-moon" locale={locale} />
      <p>{s(locale, 'calendarRange')}</p>
      <div class="return-actions"><a class="btn btn--primary" href={feed.replace('https:', 'webcal:')}>{s(locale, 'subscribe')}</a><a class="btn btn--ghost" href={feed} download={`zodiacs-sky-${locale}.ics`}>{s(locale, 'downloadCalendar')}</a></div>
      <h2>{s(locale, 'calendarUrl')}</h2><a class="return-url mono" href={feed}>{feed}</a>
      <p>{s(locale, 'calendarHelp')}</p><p class="sharing-note">{s(locale, 'calendarPrivacy')}</p><p class="sharing-note">{s(locale, 'eclipseNote')}</p>
      <a href={localizePath(locale, '/methodology/')}>{s(locale, 'accuracy')} →</a>
    </div> : <>
      <ReturnPersonal kind={kind} locale={locale} client:load />
      <noscript><p>{sharingText(locale, 'jsRequired')}</p></noscript>
    </>}
    {headsUp && <section class="return-panel heads-up-panel" aria-labelledby="heads-up-title">
      <h2 id="heads-up-title">{h('headsUpTitle')}</h2>
      <p>{h('headsUpLede')}</p>
      <p>{h('headsUpAhead')}</p>
      <p>{h('headsUpSupermoonRule')}</p>
      <div class="return-actions"><a class="btn btn--primary" href={headsUp.replace('https:', 'webcal:')}>{h('headsUpSubscribe')}</a><a class="btn btn--ghost" href={HEADS_UP_ICS_PATH} download="zodiacs-sky-heads-up.ics">{h('headsUpDownload')}</a></div>
      <p>{h('headsUpUrl')}</p><a class="return-url mono" href={headsUp}>{headsUp}</a>
      <p>{h('headsUpRange')}</p><p class="sharing-note">{h('headsUpSeparate')}</p>
      <a href={HEADS_UP_JSON_PATH}>{h('headsUpJson')}</a>
    </section>}
    {kind === 'calendar' && <section class="return-panel personal-calendar-panel" aria-labelledby="personal-calendar-title" data-personal-calendar>
      <h2 id="personal-calendar-title">{s(locale, 'personalTitle')}</h2>
      <p>{s(locale, 'personalLede')}</p>
      <p class="sharing-note">{s(locale, 'personalSeparate')}</p>
      <PersonalCalendar locale={locale} client:visible />
      <noscript><p>{sharingText(locale, 'jsRequired')}</p></noscript>
    </section>}
    <ReturnToolLinks locale={locale} current={path} />
  </section>
</Base>
