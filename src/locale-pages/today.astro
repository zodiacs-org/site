---
import LocalizedToday from '../components/localized/LocalizedToday.astro';
import { enabledExpansionLocales } from '../lib/locale-expansion/policy.mjs';

export function getStaticPaths() {
  return enabledExpansionLocales('today').map((xlocale) => ({ params: { xlocale } }));
}
const { xlocale } = Astro.params as { xlocale: 'fr' | 'it' };
---
<LocalizedToday locale={xlocale} />
