---
// Russian pair articles (src/content/pairs-i18n/ru/), built only when released or previewed.
import { getCollection } from 'astro:content';
import LocalizedPairPage from '../../components/compat/LocalizedPairPage.astro';
import { ALL_PAIRS, pairSlug } from '../../lib/compat';
import { isPathEnabled } from '../../lib/locale-expansion/policy.mjs';

export async function getStaticPaths() {
  const entries = await getCollection('pairsLocalized', (e) => e.data.locale === 'ru' && !e.data.draft);
  for (const entry of entries) {
    const expected = `ru/${pairSlug(entry.data.signs[0], entry.data.signs[1])}`;
    if (entry.id !== expected) throw new Error(`Pair file ${entry.id}.mdx declares signs [${entry.data.signs.join(', ')}]; expected ${expected}.mdx`);
  }
  const seen = new Set(entries.map((entry) => entry.id));
  for (const [a, b] of ALL_PAIRS) if (!seen.has(`ru/${a}-${b}`)) throw new Error(`Missing ru pair article: ${a}-${b}`);
  return entries
    .filter((entry) => isPathEnabled('ru', `/compatibility/${pairSlug(entry.data.signs[0], entry.data.signs[1])}/`))
    .map((entry) => ({ params: { pair: pairSlug(entry.data.signs[0], entry.data.signs[1]) }, props: { entry } }));
}
const { entry } = Astro.props;
---
<LocalizedPairPage entry={entry} />
