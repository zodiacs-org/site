---
import LocalizedHoroscopeHub from '../components/localized/LocalizedHoroscopeHub.astro';
import { enabledExpansionLocales } from '../lib/locale-expansion/policy.mjs';

export function getStaticPaths() {
  return enabledExpansionLocales('horoscope-daily').map((xlocale) => ({ params: { xlocale } }));
}
const { xlocale } = Astro.params as { xlocale: 'fr' | 'it' };
---
<LocalizedHoroscopeHub locale={xlocale} />
