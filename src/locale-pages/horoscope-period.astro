---
import LocalizedHoroscopePeriod, { type PeriodSlug } from '../components/localized/LocalizedHoroscopePeriod.astro';
import { SIGN_SLUGS } from '../lib/signs';
import { HOROSCOPE_PERIODS, enabledExpansionLocales } from '../lib/locale-expansion/policy.mjs';
import type { HoroscopeSign } from '../lib/horoscope-program-types';
import type { ExpansionLocale } from '../lib/locale-expansion/horoscope/types';

export function getStaticPaths() {
  return HOROSCOPE_PERIODS.flatMap((period) => enabledExpansionLocales(`horoscope-${period}`)
    .flatMap((xlocale) => SIGN_SLUGS.map((sign) => ({ params: { xlocale, sign, period } }))));
}
const { xlocale, sign, period } = Astro.params as { xlocale: ExpansionLocale; sign: HoroscopeSign; period: PeriodSlug };
---
<LocalizedHoroscopePeriod locale={xlocale} signSlug={sign} period={period} />
