---
// Generated shape: one thin entry per locale and route (see ../paths.ts).
import LocalizedHoroscopePeriod, { type PeriodSlug } from '../../components/localized/LocalizedHoroscopePeriod.astro';
import { periodPaths } from '../paths';
import type { HoroscopeSign } from '../../lib/horoscope-program-types';
export function getStaticPaths() { return periodPaths('es'); }
const { sign, period } = Astro.params as { sign: HoroscopeSign; period: PeriodSlug };
---
<LocalizedHoroscopePeriod locale="es" signSlug={sign} period={period} />
