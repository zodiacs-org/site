diff --git a/src/lib/compute-api/local-time.ts b/src/lib/compute-api/local-time.ts
index 2a55dc8..31f9108 100644
--- a/src/lib/compute-api/local-time.ts
+++ b/src/lib/compute-api/local-time.ts
@@ -106,2 +106,16 @@ export async function resolveLocal(
  */
+/**
+ * Whether the zone's clock went back across the midnight that begins `date`:
+ * it read 00:00 on `date`, went back to a time on the day before, and read
+ * 00:00 on `date` again later. Compatible with the pinned 1.1.0-rc.2 resolver,
+ * which returns the earlier reading of a fold with its transition.
+ */
+export async function clockWentBackAcrossMidnight(module: LocalTimeModule, date: string, zone: string): Promise<boolean> {
+  await module.prepareLocalTime(date, zone);
+  const first = module.resolveLocalToUtc(date, '00:00', zone);
+  if (first.jump?.kind !== 'fold' || first.transition === null) return false;
+  const wallMs = wallMilliseconds({ date, time: '00:00' });
+  return Date.parse(first.transition.at) + Math.round(first.transition.offsetAfterMinutes * 60_000) < wallMs;
+}
