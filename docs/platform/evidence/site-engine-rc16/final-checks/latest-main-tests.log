+     <div class="section-head reveal">
+       <h2>Start with your chart</h2>
+       <p>Find your birth chart, moon sign, rising sign, compatibility, and what the sky is doing now.</p>
+     </div>
+     <div class="home-tools">
+       {tools.map((t, i) => (
+         <a class="tile reveal" href={t.href} style={`--sign:${t.hue};--reveal-delay:${i * 60}ms`}>
+           <div class="home-tool">
+             <ToolGlyph kind={t.kind} />
+             <h3>{t.title}</h3>
+             <p>{t.promise}</p>
+             <span class="home-tool__go">Open →</span>
+           </div>
+         </a>
+       ))}
+     </div>
+     <div class="tools-upcoming reveal">
+       <em class="kicker">And for the month ahead</em>
+       <ul>
+         <li>
+           <strong>Eclipses.</strong> Every solar and lunar eclipse through
+           2028, with peak times in UTC — <a href="/eclipses/">see the dates</a>.
+         </li>
+       </ul>
+     </div>
+   </section>
+
+   <!-- 05 · The Twelve -->
+   <section class="container pace-tight" id="signs">
+     <div class="section-head reveal">
+       <h2>The twelve signs</h2>
+       <p>A full guide to each: character, relationships, history, and what the sign means across your chart.</p>
+     </div>
+     <div class="twelve">
+       {SIGNS.map((s, i) => (
+         <a class="tile reveal" href={`/${s.slug}/`} style={`--sign:${s.hue};--reveal-delay:${(i % 6) * 45}ms`}>
+           <div class="twelve__card">
+             <SignIcon sign={s.slug} size={64} />
+             <strong>{s.name}</strong>
+             <span class="mono twelve__dates">{s.dates}</span>
+           </div>
+         </a>
+       ))}
+     </div>
+     <RaceRamp class="reveal" gap="28px" />
+   </section>
+
+   <!-- 06 · Three pillars -->
+   <section class="container pace-act pace-act--rule">
+     <div class="section-head reveal">
+       <h2>Learn your signs. Save what matters.</h2>
+       <p>Three parts to the site, and you can start anywhere.</p>
+     </div>
+     <div class="pillars">
+       <div class="pillar reveal">
+         <em class="kicker">Learn</em>
+         <h3>A guide to every sign</h3>
+         <p>Twelve sign guides, the <AstroTerm term="big-three" label="big three" surface="home-pillars" /> explained, and plain-language help for reading your chart.</p>
+         <a href="/learn/">Learn astrology →</a>
+       </div>
+       <div class="pillar reveal" style="--reveal-delay:80ms">
+         <em class="kicker">Calculate</em>
+         <h3>Free astrology tools</h3>
+         <p>Birth chart, moon, rising, compatibility, and <AstroTerm term="transit" label="transits" surface="home-pillars" />, calculated privately in your browser.</p>
+         <a href="/tools/">Astrology tools →</a>
+       </div>
+       <div class="pillar reveal" style="--reveal-delay:160ms">
+         <em class="kicker">Keep</em>
+         <h3>Saved charts</h3>
+         <p>Save a chart, return to it, and keep the people you care about close. Sign in only when you want sync.</p>
+         <a href="/profile/">Saved charts →</a>
+       </div>
+     </div>
+   </section>
+
+   <!-- 07 · FAQ -->
+   <section class="container container--narrow pace-sec">
+     <div class="section-head reveal"><h2>Common questions</h2></div>
+     <div class="faq reveal">
+       {faq.map(({ q, a }) => (
+         <details class="faq__item">
+           <summary>{q}</summary>
+           <p>{a}</p>
+         </details>
+       ))}
+     </div>
+   </section>
+
+   <!-- 08 · Close -->
+   <section class="container close pace-sec pace-end">
+     <h2 class="display reveal">Start with your birth chart.</h2>
+     <div class="reveal" style="--reveal-delay:120ms">
+       <a class="btn btn--primary" href="/birth-chart/"><span>Start your chart</span><span class="orb">↗</span></a>
+       <a class="close__birthday" href="/birthday/">Or look up your exact birthday →</a>
+     </div>
+     <p class="company-note reveal" style="--reveal-delay:180ms">
+       Zodiacs.org is owned and operated by <a href="/about/">Zodiacs LLC</a>, a
+       New Mexico limited liability company.
+     </p>
+   </section>
+ </Base>
+
+ <style>
+   /* ── Vertical rhythm — the page reads as four acts, and the seams carry
+      that structure: one-sided padding in three tiers instead of the global
+      .section's doubled uniform gap. Act breaks may carry a hairline. ── */
+   .pace-act { padding-top: clamp(72px, 9.5vw, 132px); }
+   .pace-act--rule {
+     margin-top: clamp(40px, 5vw, 64px);
+     border-top: 1px solid var(--hair-1);
+     padding-top: clamp(44px, 5.5vw, 72px);
+   }
+   .pace-sec { padding-top: clamp(48px, 6.5vw, 88px); }
+   .pace-tight { padding-top: clamp(36px, 4.5vw, 60px); }
+   .pace-end { padding-bottom: clamp(80px, 10vw, 132px); }
+
+   /* ── Hero — the rounded cinematic frame ── */
+   .hero {
+     /* Cancel main's nav clearance so the frame rises behind the fixed
+        nav pill — the liquid-glass capsule then refracts the footage from
+        the first paint instead of empty void. The headline keeps clear of
+        the nav via the content padding below. */
+     margin-top: calc(-1 * var(--nav-space, 96px));
+     width: min(100% - 32px, 1440px);
+     padding-block: 0 clamp(14px, 2vw, 22px);
+   }
+   .hero__frame {
+     position: relative;
+     overflow: hidden;
+     border-radius: clamp(18px, 2.6vw, 30px);
+     /* Frame now starts at the top of the viewport; fill it, leaving a
+        small peek of the ticker waiting below. */
+     min-height: clamp(600px, calc(100svh - 40px), 900px);
+     background: var(--void-1);
+     /* A hairline ring keeps the frame editorial rather than app-like. */
+     box-shadow:
+       inset 0 0 0 1px rgba(198, 204, 218, 0.10),
+       0 30px 80px -40px rgba(0, 0, 0, 0.8);
+     isolation: isolate;
+   }
+   .hero__poster,
+   .hero__video {
+     position: absolute;
+     inset: 0;
+     width: 100%;
+     height: 100%;
+     object-fit: cover;
+     object-position: center 42%;
+     transform: scale(1.035);
+     transform-origin: center;
+   }
+   .hero__poster { display: block; }
+   .hero__video {
+     opacity: 0;
+     transition: opacity 420ms ease;
+   }
+   .hero__video.is-playing { opacity: 1; }
+   @keyframes hero-poster-drift {
+     0% { transform: scale(1.035) translate3d(0, 0, 0); }
+     100% { transform: scale(1.06) translate3d(-0.55%, 0.4%, 0); }
+   }
+   @media (max-width: 719px) and (prefers-reduced-motion: no-preference) {
+     .hero__poster[data-hero-motion='drift'] {
+       animation: hero-poster-drift 18s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
+       will-change: transform;
+     }
+     .hero__poster[data-hero-visible='false'] { animation-play-state: paused; }
+   }
+   .hero__scrim {
+     position: absolute;
+     inset: 0;
+     z-index: 1;
+     background:
+       linear-gradient(180deg,
+         rgba(6, 7, 9, 0.58) 0%,
+         rgba(6, 7, 9, 0.34) 30%,
+         rgba(6, 7, 9, 0.22) 56%,
+         rgba(6, 7, 9, 0.70) 88%,
+         rgba(6, 7, 9, 0.88) 100%);
+   }
+   .hero__content {
+     position: relative;
+     z-index: 2;
+     height: 100%;
+     min-height: inherit;
+     display: flex;
+     flex-direction: column;
+     align-items: center;
+     justify-content: flex-start;
+     gap: 0;
+     padding: calc(clamp(100px, 13svh, 132px) + env(safe-area-inset-top)) clamp(22px, 4vw, 56px) clamp(28px, 5vw, 64px);
+     text-align: center;
+   }
+   .hero__title {
+     margin: 0 0 clamp(14px, 2vw, 20px);
+     font-family: 'Instrument Sans Hero', 'Instrument Sans Fallback', 'Instrument Sans Fallback Android', system-ui, -apple-system, sans-serif;
+     font-weight: 690;
+     font-size: clamp(2.4rem, 0.95rem + 5.9vw, 6rem);
+     line-height: 0.94;
+     letter-spacing: 0.002em;
+     text-transform: uppercase;
+     max-width: 9.53em;
+     color: var(--ink-0, #EEF1F7);
+     text-wrap: balance;
+     text-shadow: 0 2px 28px rgba(6, 7, 9, 0.55);
+   }
+   .hero__title em {
+     font-style: normal;
+     color: var(--ink-1, #C6CCDA);
+   }
+   .hero__foot {
+     margin-top: auto;
+     display: flex;
+     flex-direction: column;
+     align-items: center;
+     gap: clamp(20px, 3vw, 28px);
+   }
+   .hero__sub {
+     margin: 0;
+     max-width: 31.97em;
+     font-family: 'Instrument Sans Hero', 'Instrument Sans Fallback', 'Instrument Sans Fallback Android', system-ui, -apple-system, sans-serif;
+     color: var(--ink-1, #C6CCDA);
+     font-size: clamp(0.95rem, 0.85rem + 0.5vw, 1.125rem);
+     line-height: 1.6;
+     text-wrap: pretty;
+     text-shadow: 0 1px 18px rgba(6, 7, 9, 0.6);
+   }
+   .hero__ctas {
+     display: flex;
+     flex-wrap: wrap;
+     justify-content: center;
+     gap: 12px;
+     font-family: 'Instrument Sans Hero', 'Instrument Sans Fallback', 'Instrument Sans Fallback Android', system-ui, -apple-system, sans-serif;
+   }
+   .hero__ctas .hero__ghost {
+     background: rgba(10, 12, 17, 0.66);
+     backdrop-filter: saturate(150%) blur(18px);
+     -webkit-backdrop-filter: saturate(150%) blur(18px);
+     border-color: rgba(238, 241, 247, 0.28);
+     color: var(--ink-0, #EEF1F7);
+     box-shadow:
+       inset 0 1px 0 rgba(238, 241, 247, 0.06),
+       0 12px 32px -14px rgba(0, 0, 0, 0.7);
+   }
+   .hero__ctas .hero__ghost:hover {
+     background: rgba(10, 12, 17, 0.76);
+     border-color: rgba(238, 241, 247, 0.34);
+   }
+   .hero__trust {
+     margin: -2px 0 0;
+     font-family: 'JetBrains Mono Hero', ui-monospace, Menlo, Consolas, monospace;
+     font-size: 10.5px;
+     line-height: 1.45;
+     letter-spacing: 0.055em;
+     color: var(--faint);
+     text-shadow: 0 1px 14px rgba(6, 7, 9, 0.72);
+     text-align: center;
+   }
+
+   /* ── Liquid glass (homepage chrome) ──
+      Everyone gets the frosted blur floor above — it renders on Safari/iOS via
+      -webkit-backdrop-filter, so the buttons and nav read as real glass there.
+      Chromium additionally refracts the backdrop through the SVG capsule lens,
+      gated by the .zdx-lens class (added by a tiny inline script only on
+      Chromium): Safari reports support for url() backdrop filters but paints
+      nothing, which would otherwise leave these controls flat and transparent. */
+   .glass-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
+   :global(html.zdx-lens) .hero__ctas .hero__ghost {
+     background: rgba(10, 12, 17, 0.56);
+     backdrop-filter: url(#zdx-lens-nav);
+     -webkit-backdrop-filter: url(#zdx-lens-nav);
+     box-shadow:
+       inset 0 1px 0 rgba(238, 241, 247, 0.10),
+       inset 0 -1px 0 rgba(238, 241, 247, 0.04),
+       0 12px 32px -14px rgba(0, 0, 0, 0.7);
+   }
+   :global(html.zdx-lens) .hero__ctas .hero__ghost:hover { background: rgba(10, 12, 17, 0.66); }
+   :global(html:not(.zdx-lens)) .hero__ctas .hero__ghost {
+     background: rgba(10, 12, 17, 0.58);
+     backdrop-filter: saturate(165%) blur(20px) brightness(1.1);
+     -webkit-backdrop-filter: saturate(165%) blur(20px) brightness(1.1);
+     box-shadow:
+       inset 0 1px 0 rgba(255, 255, 255, 0.24),
+       inset 0 10px 22px -16px rgba(255, 255, 255, 0.10),
+       0 14px 34px -14px rgba(0, 0, 0, 0.72);
+   }
+   :global(html.zdx-lens .nav-wrap .nav) {
+     background: rgba(10, 12, 17, 0.56);
+     backdrop-filter: url(#zdx-lens-nav);
+     -webkit-backdrop-filter: url(#zdx-lens-nav);
+     box-shadow:
+       inset 0 1px 0 rgba(238, 241, 247, 0.10),
+       inset 0 -1px 0 rgba(238, 241, 247, 0.04),
+       0 12px 32px -14px rgba(0, 0, 0, 0.7);
+   }
+   /* Reduced transparency: solid, no blur — applies to the frosted floor and
+      the Chromium lens alike. */
+   @media (prefers-reduced-transparency: reduce) {
+     .hero__ctas .hero__ghost {
+       background: rgba(10, 12, 17, 0.86);
+       backdrop-filter: none;
+       -webkit-backdrop-filter: none;
+     }
+     :global(html .nav-wrap .nav) {
+       background: rgba(10, 12, 17, 0.92);
+       backdrop-filter: none;
+       -webkit-backdrop-filter: none;
+     }
+   }
+
+   @media (max-width: 640px) {
+     .hero { width: min(100% - 20px, 1440px); }
+     .hero__frame { min-height: clamp(540px, calc(100svh - 56px), 760px); }
+     .hero__content { padding: calc(clamp(96px, 15svh, 120px) + env(safe-area-inset-top)) 18px 22px; }
+     .hero__title {
+       max-width: 7.49em;
+       font-size: clamp(2.25rem, 11.5vw, 3.55rem);
