+   <!-- 02b · Interactive proof of the hero promise -->
+   <section class="container chart-preview pace-act" id="chart-preview">
+     <div class="section-head reveal">
+       <em class="kicker">Interactive preview</em>
+       <h2>See how a birth chart becomes a story.</h2>
+       <p>Explore a real chart without entering anything. Select a sign, planet, house, or connection to see what it means.</p>
+     </div>
+     <div class="reveal">
+       <DemoChart />
+       <script is:inline>
+         (function () {
+           var root = document.querySelector('[data-demo-preview]');
+           if (!root) return;
+
+           // The wheel's twelve sign discs ship as data-href (Wheel
+           // deferIcons) so they cost nothing while the hero paints; lift
+           // them to real hrefs as the section approaches. The 200px margin
+           // keeps the swap invisible without pulling the fetches back into
+           // the initial load on tall phone viewports.
+           var discs = root.querySelectorAll('image[data-href]');
+           function liftDiscs() {
+             for (var i = 0; i < discs.length; i += 1) {
+               discs[i].setAttribute('href', discs[i].getAttribute('data-href'));
+               discs[i].removeAttribute('data-href');
+             }
+           }
+           if (discs.length) {
+             if ('IntersectionObserver' in window) {
+               var discWatch = new IntersectionObserver(function (entries) {
+                 for (var i = 0; i < entries.length; i += 1) {
+                   if (entries[i].isIntersecting) {
+                     liftDiscs();
+                     discWatch.disconnect();
+                     return;
+                   }
+                 }
+               }, { rootMargin: '200px 0px' });
+               discWatch.observe(root);
+             } else {
+               liftDiscs();
+             }
+           }
+
+           var caption = root.querySelector('[data-demo-caption]');
+           var title = root.querySelector('[data-demo-title-output]');
+           var kind = root.querySelector('[data-demo-kind-output]');
+           var targets = root.querySelectorAll('[data-demo-target]');
+           var jumps = root.querySelectorAll('[data-demo-jump]');
+           var highlights = root.querySelectorAll('[data-demo-highlight]');
+           var enterFrame = 0;
+           var settleFrame = 0;
+           if (!caption || !title || !kind || !targets.length) return;
+
+           var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
+           var targetFor = function (id) {
+             return Array.prototype.find.call(targets, function (target) {
+               return target.dataset.demoId === id;
+             });
+           };
+
+           var activate = function (target, event) {
+             if (!target) return;
+             window.cancelAnimationFrame(enterFrame);
+             window.cancelAnimationFrame(settleFrame);
+             var instant = !event || event.detail === 0;
+             var reducedMotion = !instant && reduced.matches;
+             var id = target.dataset.demoId;
+             var nextHighlight = null;
+
+             targets.forEach(function (item) {
+               item.setAttribute('aria-pressed', item === target ? 'true' : 'false');
+             });
+             jumps.forEach(function (item) {
+               item.setAttribute('aria-pressed', item.dataset.demoJump === id ? 'true' : 'false');
+             });
+             highlights.forEach(function (item) {
+               item.dataset.active = 'false';
+               if (item.dataset.demoHighlight === id) nextHighlight = item;
+             });
+
+             root.dataset.demoMotion = instant ? 'instant' : reducedMotion ? 'reduced' : 'animated';
+             root.dataset.activeLayer = target.dataset.demoLayer;
+             root.dataset.activeId = id;
+             kind.textContent = target.dataset.demoKind;
+             title.textContent = target.dataset.demoTitle;
+             caption.textContent = target.dataset.demoCopy;
+
+             if (!nextHighlight) return;
+             if (instant || reducedMotion) {
+               nextHighlight.dataset.active = 'true';
+               return;
+             }
+             enterFrame = window.requestAnimationFrame(function () {
+               settleFrame = window.requestAnimationFrame(function () {
+                 nextHighlight.dataset.active = 'true';
+               });
+             });
+           };
+
+           targets.forEach(function (target) {
+             target.addEventListener('click', function (event) { activate(target, event); });
+           });
+           jumps.forEach(function (jump) {
+             jump.addEventListener('click', function (event) {
+               activate(targetFor(jump.dataset.demoJump), event);
+             });
+           });
+         })();
+       </script>
+     </div>
+   </section>
